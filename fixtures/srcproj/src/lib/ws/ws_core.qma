// fixtures/srcproj/src/lib/ws/ws_core.qma —— [src].lib 库示例
// import ws.ws_core 按前缀引用（目录即库，无需逐库声明）
module ws_core

pub fn ws_greet(name: str) -> str {
    return str_alloc_concat("ws:", name)
}

fn str_alloc_concat(a: str, b: str) -> str {
    let s = str_alloc(len(a) + len(b))
    let w = mem_ptr(s, 0)
    mem_copy(w, a, len(a))
    w = mem_ptr(w, len(a))
    mem_copy(w, b, len(b))
    return s
}
