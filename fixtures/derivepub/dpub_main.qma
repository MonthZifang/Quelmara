// fixtures/derivepub/dpub_main.qma：跨模块派生（v1.73）
//
// pub struct 上的 @derive 生成的函数必须**继承 pub**——否则库导出的类型
// 在调用方一用 json()/show()/from_json 就撞"非 pub 跨模块引用"检查。
module main

import dpub_model

fn main() {
    let p = make_point(1, 2)
    assert(p.json() == "{\"x\":1,\"y\":2}", "跨模块 json()")
    assert(p.show() == "Point { x: 1, y: 2 }", "跨模块 show()")
    let q = Point_from_json(p.json())
    assert(p.eq(q), "跨模块 from_json + eq")
    print("derivepub ok")
}
