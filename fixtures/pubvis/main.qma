// t88_pubvis.qma：pub 可见性（v1.43）——多文件正例
// 覆盖：
//   1) pub fn / pub struct / pub enum 跨模块可见可用（import 扁平合并语义，
//      与 std 库消费方式一致——限定语法 lib.fn() 属"命名空间"后续项）
//   2) 库内非 pub 声明（helper/Secret）在库内部自由使用（bake 间接验证）
//   3) 跨模块 pub 声明的调用/构造/match 语义与同模块声明完全一致
// 反向（非 pub 跨模块引用必须编译失败）在 run_win_tests.py 的 bad case 里。
module t88

import pubvis_lib

fn main() {
    // 1) pub fn + pub struct：构造与字段
    let p = make_point(3, 4)
    assert(p.x == 3 and p.y == 4, "pub struct flat use")

    // 2) 库内部用非 pub helper：bake(5) = 5*2+1 = 11
    assert(bake(5) == 11, "internal helper through pub fn")

    // 3) pub enum + match
    match pick_red() {
        Color.Red => { }
        Color.Green => { assert(false, "wrong variant") }
    }

    print("pubvis ok")
}
