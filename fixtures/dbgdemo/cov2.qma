// dbgdemo/cov2.qma：增量合并夹具（v1.83）
// 两个分支由命令行参数决定：不带参数走 else，带 20 走 then。
// `quelmara cov ... -- 20` 用来演示"多次运行的命中累加"。
module dbgdemo_cov2

fn pick(n: int) -> int {
    if n > 10 {
        return 1
    }
    return 2
}

fn main() {
    let a = args()
    let mut n = 3
    if len(a) > 0 {
        n = to_int(a[0])
    }
    print(pick(n).to_str())
}
