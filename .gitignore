# Quelmara 编译产物（测试脚本会重新生成）
build/
*.exe
*.qex

# 增量编译缓存（内容寻址，随时可删；见 docs/05-toolchain.md §1.3）
.qlmcache/

# 夹具目录里的本地产物（fixtures 只提交源码与配置）
fixtures/**/*.exe
fixtures/**/*.qex

# qpm 端到端夹具里临时 git init 出来的仓库（演示时重建）
fixtures/qpm-demo/.git/

# Python
__pycache__/
*.pyc

# 开发期 scratch / 历史调试目录
.openclaw/

# 基准基线（需要时再用 --update-baseline 生成并单独提交）
bench_baseline.json

# AI 会话缓存（本地记忆，不入库）
.workbuddy-ai/

# bench/speed 各语言编译产生的本地产物（run.py / verify_lang.py 会重新生成）
bench/speed/**/*.o
bench/speed/**/*.ali
bench/speed/**/*.mod
bench/speed/**/*.class
bench/speed/**/*.bin/
# fortran/ada 等编译器把产物写在 cwd（仓库根），统一忽略
/*.o
/*.ali
/*.mod
/*.class
# zig 临时编译目录
.zig-cache/
zig-cache/
bench/speed/zig/.*.tmpdir/
