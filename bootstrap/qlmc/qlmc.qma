// bootstrap/qlmc/qlmc.qma —— Quelmara 写的 Quelmara 编译器（stage-1，v2.14）
//
// ## 它是什么
//
// 一个**能出 exe** 的原生编译器：`.qma` -> PE32+，全程用 Quelmara 写，不经过
// Python、不依赖 CRT、不链接任何东西。跑起来是一个 ~50 KB 的独立 exe。
//
// ## 它不是什么（重要，别当成"自举完成"）
//
// 只覆盖**子集 S1**（下面的清单），离编译整个仓库还差得远。设计上刻意把
// "能跑通一条完整链路"排在"覆盖全部语法"前面：链路通了，后面是加法。
//
//   支持：fn（int/bool 形参、int/bool 返回）、let / mut、赋值、if/else、while、
//         return、exit(code)、print(int) / print("字面量")、递归与互调用、
//         算术 + - * / %、比较 == != < <= > >=、逻辑 && || !（短路）、一元负号、
//         数字分隔符（200_000_000）、单行注释、module 声明（忽略）
//   不支持：str 变量与形参、struct/enum/match、泛型、闭包、vec/map、f64、
//         import、多文件、全局常量、宏/反射、@ffi、错误信息带列号
//
// ## 分层（与 stage-0 的对应关系）
//
//   lexer   qlm_lex.qma（stage-1，已对拍）-> 这里重写了一个只认 S1 的紧凑版
//   parser  递归下降 -> **平坦 AST**（节点表 + 索引，不走 enum 载荷）
//   IR      三地址线性 IR（vreg + 标签 + 跳转），见 `Ir` 注释
//   alloc   **全溢出**：每个 vreg 一个帧槽；表达式求值用 RAX/RCX 当累加器
//           （线性扫描留给下一版，见 docs/07-gaps.md）
//   emit    x86-64 编码 + PE32+ 写出（照 `qlm_pe.py` 的布局，两节：.text/.rdata）
//
// ## 为什么全溢出也够快
//
// 小程序的瓶颈是**进程启动与解析**，不是指令选择。本机实测：Python 引导层
// 编一个 hello 要 2136 ms（其中 1740 ms 是 import 34k 行 Python），而本编译器
// 自带 lexer+parser+codegen+PE，全部工作在进程内几毫秒量级（见 06-status §3.25）。
// 寄存器分配、窥孔、常量折叠是**下一步**的收益点，不是这一步的。
//
// ## 用法
//
//   qlmc build <src.qma> [-o out.exe]     编译成 PE
//   qlmc dump <src.qma>                  只跑词法+语法，打印统计（调试用）
//   qlmc version
import std.core
import std.mem

// ---------------------------------------------------------------------------
// 写文件（产出 exe）
// ---------------------------------------------------------------------------

@ffi("kernel32.dll", "CreateFileA")
fn _CreateFileA(name: int, access: int, share: int, sec: int, disp: int,
                flags: int, tmpl: int) -> int

@ffi("kernel32.dll", "WriteFile")
fn _WriteFile(h: int, buf: int, n: int, got: int, ov: int) -> bool

@ffi("kernel32.dll", "CloseHandle")
fn _CloseHandle(h: int) -> bool

const GEN_WRITE = 1073741824        // 0x40000000
const CREATE_ALWAYS = 2
const ATTR_NORMAL = 128

// ---------------------------------------------------------------------------
// 记号
// ---------------------------------------------------------------------------

const T_EOF = 0
const T_NUM = 1
const T_NAME = 2
const T_STR = 3
const T_PUNCT = 4
const T_KW = 5

// 关键字 id
const K_FN = 1
const K_LET = 2
const K_MUT = 3
const K_IF = 4
const K_ELSE = 5
const K_WHILE = 6
const K_RETURN = 7
const K_TRUE = 8
const K_FALSE = 9
const K_PRINT = 10
const K_EXIT = 11
const K_MODULE = 12
const K_IMPORT = 13
const K_CONST = 14

// 标点 id（多字符的按"最长匹配"先行）
const P_LPAREN = 1
const P_RPAREN = 2
const P_LBRACE = 3
const P_RBRACE = 4
const P_COMMA = 5
const P_COLON = 6
const P_SEMI = 7
const P_ASSIGN = 8
const P_PLUS = 9
const P_MINUS = 10
const P_STAR = 11
const P_SLASH = 12
const P_PERCENT = 13
const P_LT = 14
const P_GT = 15
const P_EQ = 16
const P_NE = 17
const P_LE = 18
const P_GE = 19
const P_AND = 20
const P_OR = 21
const P_NOT = 22
const P_ARROW = 23
const P_DOT = 24

struct Tok {
    k: int          // T_*
    n: int          // 数值 / 关键字 id / 标点 id
    s: str          // 标识符名 / 字符串内容
    line: int
}

// ---------------------------------------------------------------------------
// AST：平坦节点表
//
// 节点用 int 索引（-1 = 无）。块用 (start, count) 表示**连续区间**——
// 解析是顺序追加的，所以嵌套块的成员天然连续，不需要链表。
// ---------------------------------------------------------------------------

// 表达式
const E_NUM = 1
const E_VAR = 2
const E_BIN = 3      // a = 运算符(P_*)，b/c = 子节点
const E_UN = 4       // a = P_MINUS / P_NOT，b = 子节点
const E_CALL = 5     // a = 名字 id，b/c = 实参节点（-1 = 无）
const E_STR = 6      // a = 字符串表 id

// 语句
const S_LET = 10     // a = 名字 id，b = 初值，n = mut(0/1)，slot = 帧槽号
const S_ASSIGN = 11  // a = 名字 id，b = 值
const S_IF = 12      // a = 条件，b = then(start)，c = then(count)，n = else(start)，slot = else(count)
const S_WHILE = 13   // a = 条件，b = start，c = count
const S_RETURN = 14  // a = 值（-1 = 无）
const S_PRINT = 15   // a = 值
const S_EXIT = 16    // a = 值
const S_EXPR = 17    // a = 值

struct Node {
    op: int
    a: int
    b: int
    c: int
    n: int      // 附加（mut 标志 / else 头）
    slot: int   // 附加（局部槽号）
    ty: int     // 附加（表达式类型 TY_*）
    nx: int     // 同块下一条语句（-1 = 块尾）——块用链而不是区间：
                // 子块节点在父块区间里也占位置，按区间走会把子块当同级语句重发
}

// 类型（S2：int / bool / str / void）。Quelmara 的 str 是
// `[len:8][bytes][NUL]`，**值 = 数据指针**（长度在 ptr-8）。
const TY_INT = 0
const TY_BOOL = 1
const TY_STR = 2
const TY_VOID = 3

struct Fn {
    name: int       // 名字 id
    np: int         // 形参数
    p0: int
    p1: int
    p2: int
    p3: int
    p0t: int        // 形参类型（TY_*）
    p1t: int
    p2t: int
    p3t: int
    ret_t: int      // 返回类型
    body: int       // 语句块链头
    nbody: int
    nlocals: int
}

// ---------------------------------------------------------------------------
// 词法
// ---------------------------------------------------------------------------

fn _is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn _is_alpha(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn _ty_id(w: str) -> int {
    if w == "bool" {
        return TY_BOOL
    }
    if w == "str" {
        return TY_STR
    }
    if w == "void" {
        return TY_VOID
    }
    return TY_INT
}

fn _kw_id(w: str) -> int {
    if w == "fn" { return K_FN }
    if w == "let" { return K_LET }
    if w == "mut" { return K_MUT }
    if w == "if" { return K_IF }
    if w == "else" { return K_ELSE }
    if w == "while" { return K_WHILE }
    if w == "return" { return K_RETURN }
    if w == "true" { return K_TRUE }
    if w == "false" { return K_FALSE }
    if w == "print" { return K_PRINT }
    if w == "exit" { return K_EXIT }
    if w == "module" { return K_MODULE }
    if w == "import" { return K_IMPORT }
    if w == "const" { return K_CONST }
    return 0
}

fn _tok(toks: vec[Tok], k: int, n: int, s: str, line: int) {
    toks.push(Tok { k: k, n: n, s: s, line: line })
}

/// 词法：把源码切成记号表。只认 S1 的记号集；不认识的字符直接 fail-fast
/// （静默跳过 = 后面报一堆莫名其妙的语法错）。
fn lex(src: str, toks: vec[Tok]) -> int {
    let n = len(src)
    let mut i = 0
    let mut line = 1
    while i < n {
        let c = src[i]
        // 换行 / 空白
        if c == 10 {
            line = line + 1
            i = i + 1
            continue
        }
        if c == 13 || c == 32 || c == 9 {
            i = i + 1
            continue
        }
        // 注释
        if c == 47 && i + 1 < n && src[i + 1] == 47 {
            while i < n && src[i] != 10 {
                i = i + 1
            }
            continue
        }
        // 数字（支持下划线分隔）
        if _is_digit(c) {
            let mut v = 0
            while i < n {
                let d = src[i]
                if d == 95 {
                    i = i + 1
                    continue
                }
                if !_is_digit(d) {
                    break
                }
                v = v * 10 + (d - 48)
                i = i + 1
            }
            _tok(toks, T_NUM, v, "", line)
            continue
        }
        // 标识符 / 关键字
        if _is_alpha(c) {
            let mut j = i
            while j < n && (_is_alpha(src[j]) || _is_digit(src[j])) {
                j = j + 1
            }
            let w = substr(src, i, j - i)
            let kw = _kw_id(w)
            if kw != 0 {
                _tok(toks, T_KW, kw, w, line)
            } else {
                _tok(toks, T_NAME, 0, w, line)
            }
            i = j
            continue
        }
        // 字符串字面量（只支持 \" \\ \n \t 四个转义）
        if c == 34 {
            let mut j = i + 1
            let mut out = ""
            while j < n && src[j] != 34 {
                if src[j] == 92 && j + 1 < n {
                    let e = src[j + 1]
                    if e == 110 {
                        out = out + chr(10)
                    } else if e == 116 {
                        out = out + chr(9)
                    } else if e == 34 {
                        out = out + chr(34)
                    } else if e == 92 {
                        out = out + chr(92)
                    } else {
                        out = out + chr(e)
                    }
                    j = j + 2
                    continue
                }
                out = out + chr(src[j])
                j = j + 1
            }
            if j >= n {
                eprint("qlmc: 字符串未闭合 @ line " + line.to_str())
                exit(2)
            }
            _tok(toks, T_STR, 0, out, line)
            i = j + 1
            continue
        }
        // 标点：两字符优先
        if i + 1 < n {
            let two = substr(src, i, 2)
            let mut pid = 0
            if two == "==" { pid = P_EQ }
            else if two == "!=" { pid = P_NE }
            else if two == "<=" { pid = P_LE }
            else if two == ">=" { pid = P_GE }
            else if two == "&&" { pid = P_AND }
            else if two == "||" { pid = P_OR }
            else if two == "->" { pid = P_ARROW }
            if pid != 0 {
                _tok(toks, T_PUNCT, pid, "", line)
                i = i + 2
                continue
            }
        }
        let mut p1 = 0
        if c == 40 { p1 = P_LPAREN }
        else if c == 41 { p1 = P_RPAREN }
        else if c == 123 { p1 = P_LBRACE }
        else if c == 125 { p1 = P_RBRACE }
        else if c == 44 { p1 = P_COMMA }
        else if c == 58 { p1 = P_COLON }
        else if c == 59 { p1 = P_SEMI }
        else if c == 61 { p1 = P_ASSIGN }
        else if c == 43 { p1 = P_PLUS }
        else if c == 45 { p1 = P_MINUS }
        else if c == 42 { p1 = P_STAR }
        else if c == 47 { p1 = P_SLASH }
        else if c == 37 { p1 = P_PERCENT }
        else if c == 60 { p1 = P_LT }
        else if c == 62 { p1 = P_GT }
        else if c == 33 { p1 = P_NOT }
        else if c == 46 { p1 = P_DOT }
        if p1 == 0 {
            eprint("qlmc: 不认识的字符 '" + chr(c) + "' @ line " + line.to_str())
            exit(2)
        }
        _tok(toks, T_PUNCT, p1, "", line)
        i = i + 1
    }
    _tok(toks, T_EOF, 0, "", line)
    return 0
}

// ---------------------------------------------------------------------------
// 语法（递归下降）
// ---------------------------------------------------------------------------

// 解析器状态：**vec 元素不能当可变单元格**（`ps[0].pos = x` 写进的是临时副本，
// 实测静默不生效 —— 第一次编译时表现成"fn 之后期望函数名"死循环）。
// 所以位置单独放一个 `vec[int]` 单元素 cell（`.set` 是写句柄，能看见），
// 其余只读的表打包成 P 按值传（vec 句柄是共享的，push 仍然可见）。
struct P {
    toks: vec[Tok]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    cname: vec[int]     // const 名字 id
    cval: vec[int]      // const 值（本版只支持整型字面量）
}

fn _adv(pos: vec[int]) {
    pos.set(0, pos[0] + 1)
}

fn _t(p: P, i: int) -> Tok {
    if i >= len(p.toks) {
        return Tok { k: T_EOF, n: 0, s: "", line: 0 }
    }
    return p.toks[i]
}

fn _cur(p: P, pos: vec[int]) -> Tok {
    return _t(p, pos[0])
}

fn _fail(p: P, pos: vec[int], msg: str) {
    eprint("qlmc: line " + _cur(p, pos).line.to_str() + ": " + msg)
    exit(2)
}

fn _is_p(p: P, pos: vec[int], pid: int) -> bool {
    let t = _cur(p, pos)
    return t.k == T_PUNCT && t.n == pid
}

fn _eat_p(p: P, pos: vec[int], pid: int) {
    if !_is_p(p, pos, pid) {
        _fail(p, pos, "期望标点 #" + pid.to_str())
    }
    _adv(pos)
}

fn _name_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.names) {
        if p.names[i] == s {
            return i
        }
        i = i + 1
    }
    p.names.push(s)
    return len(p.names) - 1
}

/// 查 const 表；没有返回 -1
fn _const_of(p: P, nid: int) -> int {
    let mut i = 0
    while i < len(p.cname) {
        if p.cname[i] == nid {
            return p.cval[i]
        }
        i = i + 1
    }
    return -1
}

fn _str_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.strs) {
        if p.strs[i] == s {
            return i
        }
        i = i + 1
    }
    p.strs.push(s)
    return len(p.strs) - 1
}

fn _node(p: P, op: int, a: int, b: int, c: int) -> int {
    // n 默认 -1：S_IF 用它存 else 链头，0 会被当成"有 else"并去发节点 0
    p.nodes.push(Node { op: op, a: a, b: b, c: c, n: -1, slot: 0,
                       ty: TY_INT, nx: -1 })
    return len(p.nodes) - 1
}

// 表达式：优先级爬升。|| -> && -> 相等 -> 关系 -> 加减 -> 乘除模 -> 一元 -> 基本
fn _expr(p: P, pos: vec[int]) -> int {
    return _or_e(p, pos)
}

fn _or_e(p: P, pos: vec[int]) -> int {
    let mut l = _and_e(p, pos)
    while _is_p(p, pos, P_OR) {
        _adv(pos)
        let r = _and_e(p, pos)
        l = _node(p, E_BIN, P_OR, l, r)
    }
    return l
}

fn _and_e(p: P, pos: vec[int]) -> int {
    let mut l = _eq_e(p, pos)
    while _is_p(p, pos, P_AND) {
        _adv(pos)
        let r = _eq_e(p, pos)
        l = _node(p, E_BIN, P_AND, l, r)
    }
    return l
}

fn _eq_e(p: P, pos: vec[int]) -> int {
    let mut l = _rel_e(p, pos)
    while _is_p(p, pos, P_EQ) || _is_p(p, pos, P_NE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _rel_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _rel_e(p: P, pos: vec[int]) -> int {
    let mut l = _add_e(p, pos)
    while _is_p(p, pos, P_LT) || _is_p(p, pos, P_GT) ||
          _is_p(p, pos, P_LE) || _is_p(p, pos, P_GE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _add_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _add_e(p: P, pos: vec[int]) -> int {
    let mut l = _mul_e(p, pos)
    while _is_p(p, pos, P_PLUS) || _is_p(p, pos, P_MINUS) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _mul_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _mul_e(p: P, pos: vec[int]) -> int {
    let mut l = _unary(p, pos)
    while _is_p(p, pos, P_STAR) || _is_p(p, pos, P_SLASH) ||
          _is_p(p, pos, P_PERCENT) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _unary(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _unary(p: P, pos: vec[int]) -> int {
    if _is_p(p, pos, P_MINUS) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_MINUS, v, -1)
    }
    if _is_p(p, pos, P_NOT) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_NOT, v, -1)
    }
    return _primary(p, pos)
}

fn _primary(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_NUM {
        _adv(pos)
        return _node(p, E_NUM, t.n, -1, -1)
    }
    if t.k == T_STR {
        _adv(pos)
        return _node(p, E_STR, _str_id(p, t.s), -1, -1)
    }
    if t.k == T_KW && (t.n == K_TRUE || t.n == K_FALSE) {
        _adv(pos)
        let mut v = 0
        if t.n == K_TRUE {
            v = 1
        }
        return _node(p, E_NUM, v, -1, -1)
    }
    if t.k == T_PUNCT && t.n == P_LPAREN {
        _adv(pos)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return v
    }
    if t.k == T_NAME {
        _adv(pos)
        let nid = _name_id(p, t.s)
        if !_is_p(p, pos, P_LPAREN) {
            let cv = _const_of(p, nid)
            if cv >= 0 {
                return _node(p, E_NUM, cv, -1, -1)
            }
        }
        if _is_p(p, pos, P_LPAREN) {
            _adv(pos)
            let mut a0 = -1
            let mut a1 = -1
            if !_is_p(p, pos, P_RPAREN) {
                a0 = _expr(p, pos)
                if _is_p(p, pos, P_COMMA) {
                    _adv(pos)
                    a1 = _expr(p, pos)
                }
            }
            _eat_p(p, pos, P_RPAREN)
            return _node(p, E_CALL, nid, a0, a1)
        }
        return _node(p, E_VAR, nid, -1, -1)
    }
    _fail(p, pos, "期望表达式")
    return -1
}

fn _stmt(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_KW && t.n == K_LET {
        _adv(pos)
        let mut m = 0
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_MUT {
            m = 1
            _adv(pos)
        }
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "let 后期望变量名")
        }
        _adv(pos)
        let nid = _name_id(p, nm.s)
        if _is_p(p, pos, P_COLON) {          // 类型标注：S1 只有 64 位整数，跳过
            _adv(pos)
            if _cur(p, pos).k != T_NAME {
                _fail(p, pos, "类型标注期望类型名")
            }
            _adv(pos)
        }
        _eat_p(p, pos, P_ASSIGN)
        let v = _expr(p, pos)
        let id = _node(p, S_LET, nid, v, -1)
        p.nodes.set(id, Node { op: S_LET, a: nid, b: v, c: -1, n: m,
                               slot: 0, ty: TY_INT, nx: -1 })
        return id
    }
    if t.k == T_KW && t.n == K_IF {
        _adv(pos)
        let cond = _expr(p, pos)
        let th = _block(p, pos)
        let id = _node(p, S_IF, cond, th, -1)
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_ELSE {
            _adv(pos)
            let eh = _block(p, pos)
            p.nodes.set(id, Node { op: S_IF, a: cond, b: th, c: -1,
                                   n: eh, slot: 0, ty: TY_INT, nx: -1 })
        }
        return id
    }
    if t.k == T_KW && t.n == K_WHILE {
        _adv(pos)
        let cond = _expr(p, pos)
        let bh = _block(p, pos)
        return _node(p, S_WHILE, cond, bh, -1)
    }
    if t.k == T_KW && t.n == K_RETURN {
        _adv(pos)
        let mut v = -1
        if !_is_p(p, pos, P_RBRACE) {
            v = _expr(p, pos)
        }
        return _node(p, S_RETURN, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_PRINT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_PRINT, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_EXIT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_EXIT, v, -1, -1)
    }
    // 赋值（NAME = expr）或表达式语句
    if t.k == T_NAME && _t(p, pos[0] + 1).k == T_PUNCT &&
       _t(p, pos[0] + 1).n == P_ASSIGN {
        let nid = _name_id(p, t.s)
        pos.set(0, pos[0] + 2)
        let v = _expr(p, pos)
        return _node(p, S_ASSIGN, nid, v, -1)
    }
    let v = _expr(p, pos)
    return _node(p, S_EXPR, v, -1, -1)
}

/// 块：解析成一条 nx 链，返回链头（空块返回 -1）
fn _block(p: P, pos: vec[int]) -> int {
    _eat_p(p, pos, P_LBRACE)
    let mut head = -1
    let mut prev = -1
    while !_is_p(p, pos, P_RBRACE) {
        if _cur(p, pos).k == T_EOF {
            _fail(p, pos, "块未闭合")
        }
        let id = _stmt(p, pos)
        if head < 0 {
            head = id
        } else {
            let pn = p.nodes[prev]
            p.nodes.set(prev, Node { op: pn.op, a: pn.a, b: pn.b, c: pn.c,
                                     n: pn.n, slot: pn.slot, ty: pn.ty, nx: id })
        }
        prev = id
    }
    _eat_p(p, pos, P_RBRACE)
    return head
}

fn _fn(p: P, pos: vec[int]) {
    _adv(pos)                                // fn
    let nm = _cur(p, pos)
    if nm.k != T_NAME {
        _fail(p, pos, "fn 后期望函数名")
    }
    _adv(pos)
    let nid = _name_id(p, nm.s)
    _eat_p(p, pos, P_LPAREN)
    let mut q0 = -1
    let mut q1 = -1
    let mut q2 = -1
    let mut q3 = -1
    let mut t0 = TY_INT
    let mut t1 = TY_INT
    let mut t2 = TY_INT
    let mut t3 = TY_INT
    let mut np = 0
    while !_is_p(p, pos, P_RPAREN) {
        let pn = _cur(p, pos)
        if pn.k != T_NAME {
            _fail(p, pos, "形参期望名字")
        }
        _adv(pos)
        let mut pt = TY_INT
        if _is_p(p, pos, P_COLON) {
            _adv(pos)
            if _cur(p, pos).k != T_NAME {
                _fail(p, pos, "形参类型期望类型名")
            }
            pt = _ty_id(_cur(p, pos).s)
            _adv(pos)
        }
        let pid = _name_id(p, pn.s)
        if np == 0 { q0 = pid }
        else if np == 1 { q1 = pid }
        else if np == 2 { q2 = pid }
        else if np == 3 { q3 = pid }
        else { _fail(p, pos, "本版最多 4 个形参") }
        if np == 0 { t0 = pt }
        else if np == 1 { t1 = pt }
        else if np == 2 { t2 = pt }
        else { t3 = pt }
        np = np + 1
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RPAREN)
    let mut rt = TY_VOID
    if _is_p(p, pos, P_ARROW) {
        _adv(pos)
        if _cur(p, pos).k != T_NAME {
            _fail(p, pos, "返回类型期望类型名")
        }
        rt = _ty_id(_cur(p, pos).s)
        _adv(pos)
    }
    let body = _block(p, pos)
    p.fns.push(Fn { name: nid, np: np, p0: q0, p1: q1, p2: q2, p3: q3,
                    p0t: t0, p1t: t1, p2t: t2, p3t: t3, ret_t: rt,
                    body: body, nbody: 0, nlocals: np })
}

/// 顶层：`module x` 忽略；`import` 本版不支持；`fn` 逐个解析。
fn parse(toks: vec[Tok], nodes: vec[Node], names: vec[str], strs: vec[str],
         fns: vec[Fn], cname: vec[int], cval: vec[int]) -> int {
    let p = P { toks: toks, nodes: nodes, names: names, strs: strs, fns: fns,
                cname: cname, cval: cval }
    let pos = vec[int].new(1)
    pos.push(0)
    while _cur(p, pos).k != T_EOF {
        let t = _cur(p, pos)
        if t.k == T_KW && t.n == K_MODULE {
            while _cur(p, pos).k != T_EOF && _cur(p, pos).line == t.line {
                _adv(pos)
            }
            continue
        }
        if t.k == T_KW && t.n == K_IMPORT {
            _fail(p, pos, "import 本版不支持（单文件编译）")
        }
        if t.k == T_KW && t.n == K_FN {
            _fn(p, pos)
            continue
        }
        if t.k == T_KW && t.n == K_CONST {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "const 后期望名字")
            }
            _adv(pos)
            if _is_p(p, pos, P_COLON) {
                _adv(pos)
                _adv(pos)                    // 类型标注（只允许整型）
            }
            _eat_p(p, pos, P_ASSIGN)
            let v = _cur(p, pos)
            if v.k != T_NUM {
                _fail(p, pos, "const 只支持整型字面量（S2 口径）")
            }
            _adv(pos)
            p.cname.push(_name_id(p, nm.s))
            p.cval.push(v.n)
            continue
        }
        _fail(p, pos, "顶层期望 fn / const")
    }
    return len(p.fns)
}

// ---------------------------------------------------------------------------
// IR
//
// 本版不落显式 IR 表：`gen_*` 直接从 AST 发字节。为什么——S1 的表达式没有
// 需要重排的优化（没有 CSE/调度/内联），三地址 IR 只是多一层搬运；等做
// 常量折叠与寄存器分配时再引入（`07-gaps.md` §3 记了这条）。
// **等价于 IR 的抽象在这里**：每个表达式的值在 RAX，二元运算的右操作数先
// 落帧槽（`scratch`），左操作数算完再 `mov rcx, [scratch]` —— 这就是
// "全溢出 + RAX/RCX 双累加器"的分配策略。
// ---------------------------------------------------------------------------

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

// PE 常量（与 qlm_pe.py 同源，改一处必须改另一处）
const IMAGE_BASE = 0x140000000
const TEXT_RVA = 0x1000
const SECT_ALIGN = 0x1000
const FILE_ALIGN = 0x200
const HDR_DOS = 0x80
const OPT_SIZE = 240
const SCN_CODE = 0x60000020
const SCN_RDATA = 0xC0000040

// 导入符号（顺序 = IAT 槽顺序，别乱动）
const I_GETSTD = 0
const I_WRITE = 1
const I_EXIT = 2
const I_WSPRINTF = 3

// ---------------------------------------------------------------------------
// 字节发射
// ---------------------------------------------------------------------------

fn _b(code: vec[int], v: int) {
    code.push(v & 0xFF)
}

fn _w32(code: vec[int], v: int) {
    _b(code, v)
    _b(code, v >> 8)
    _b(code, v >> 16)
    _b(code, v >> 24)
}

fn _w64(code: vec[int], v: int) {
    _w32(code, v)
    _w32(code, v >> 32)
}

fn _rex(code: vec[int], w: int, r: int, b: int) {
    _b(code, 0x40 | (w << 3) | (r << 2) | b)
}

// REX.W + REX.R(reg) + REX.B(rm) 组合：reg/rm 是 0-15
fn _rex2(code: vec[int], w: int, reg: int, rm: int) {
    let r = 0
    if reg >= 8 {
        r = 1
    }
    let b = 0
    if rm >= 8 {
        b = 1
    }
    _rex(code, w, r, b)
}

fn _modrm(code: vec[int], mod: int, reg: int, rm: int) {
    _b(code, (mod << 6) | ((reg & 7) << 3) | (rm & 7))
}

// mov dst, imm64
fn _mov_imm(code: vec[int], dst: int, v: int) {
    _rex2(code, 1, 0, dst)
    _b(code, 0xB8 + (dst & 7))
    _w64(code, v)
}

// mov dst, src（寄存器到寄存器）
fn _mov_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, 0x89)
    _modrm(code, 3, src, dst)
}

// mov dst, [base+disp32]
fn _mov_load(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm(code, 2, dst, base)
    _w32(code, disp)
}

// mov [base+disp32], src
fn _mov_store(code: vec[int], base: int, disp: int, src: int) {
    _rex2(code, 1, src, base)
    _b(code, 0x89)
    _modrm(code, 2, src, base)
    _w32(code, disp)
}

// [rsp+disp32] 的 modrm 带 SIB
fn _modrm_sib(code: vec[int], mod: int, reg: int) {
    _modrm(code, mod, reg, 4)
    _b(code, 0x24)
}

fn _mov_rsp_store(code: vec[int], disp: int, src: int) {
    _rex2(code, 1, src, 4)
    _b(code, 0x89)
    _modrm_sib(code, 2, src)
    _w32(code, disp)
}

fn _mov_rsp_load(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8B)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

fn _mov_rsp_imm32(code: vec[int], disp: int, v: int) {
    _rex2(code, 1, 0, 4)
    _b(code, 0xC7)
    _modrm_sib(code, 2, 0)
    _w32(code, disp)
    _w32(code, v)
}

fn _lea_rsp(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8D)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

// lea dst, [rip+disp32]：disp 稍后回填
fn _lea_rip(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 0)
    _b(code, 0x8D)
    _modrm(code, 0, dst, 5)
    _w32(code, disp)
}

// alu dst, src：opcode 见 add=01 sub=29 and=21 or=09 xor=31 cmp=39
fn _alu_rr(code: vec[int], op: int, dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, op)
    _modrm(code, 3, src, dst)
}

fn _imul_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, dst, src)
    _b(code, 0x0F)
    _b(code, 0xAF)
    _modrm(code, 3, dst, src)
}

fn _neg(code: vec[int], dst: int) {
    _rex2(code, 1, 0, dst)
    _b(code, 0xF7)
    _modrm(code, 3, 3, dst)
}

fn _cqo(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x99)
}

fn _idiv(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0xF7)
    _modrm(code, 3, 7, reg)
}

fn _test_rr(code: vec[int], a: int, b: int) {
    _rex2(code, 1, b, a)
    _b(code, 0x85)
    _modrm(code, 3, b, a)
}

fn _cmp_imm0(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0x83)
    _modrm(code, 3, 7, reg)
    _b(code, 0)
}

// setcc al：cc 见 e=94 ne=95 l=9C ge=9D le=9E g=9F
fn _setcc_al(code: vec[int], cc: int) {
    _b(code, 0x0F)
    _b(code, cc)
    _b(code, 0xC0)
}

fn _movzx_rax_al(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0xC0)
}

fn _push_rbp(code: vec[int]) {
    _b(code, 0x55)
}

fn _pop_rbp(code: vec[int]) {
    _b(code, 0x5D)
}

fn _mov_rbp_rsp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
}

fn _mov_rsp_rbp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xEC)
}

fn _sub_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xEC)
    _w32(code, n)
}

fn _add_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xC4)
    _w32(code, n)
}

fn _ret(code: vec[int]) {
    _b(code, 0xC3)
}

fn _jmp(code: vec[int]) -> int {
    _b(code, 0xE9)
    let p = len(code)
    _w32(code, 0)
    return p
}

// cc：e=84 ne=85 l=8C ge=8D le=8E g=8F
fn _jcc(code: vec[int], cc: int) -> int {
    _b(code, 0x0F)
    _b(code, cc)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _call_rel(code: vec[int]) -> int {
    _b(code, 0xE8)
    let p = len(code)
    _w32(code, 0)
    return p
}

// call [rip+disp32]
fn _call_rip(code: vec[int]) -> int {
    _b(code, 0xFF)
    _b(code, 0x15)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _patch32(code: vec[int], at: int, v: int) {
    code.set(at, v & 0xFF)
    code.set(at + 1, (v >> 8) & 0xFF)
    code.set(at + 2, (v >> 16) & 0xFF)
    code.set(at + 3, (v >> 24) & 0xFF)
}

fn _align_up(v: int, a: int) -> int {
    return (v + a - 1) / a * a
}

// ---------------------------------------------------------------------------
// 代码生成
//
// 类型：本版带一层**最小类型跟踪**（int/bool/str/void）。它不是为了类型检查，
// 而是为了让 `+` 知道该发 `add` 还是发 `__str_cat`、`print` 知道该走整数还是
// 字符串通道。类型从 `_emit_expr` 的返回值里带出来（emit 的同时算，不做单独
// 的标注 pass）——S2 的表达式没有需要"先知道类型才能发指令"的情形。
// ---------------------------------------------------------------------------

struct Fix {
    pos: int        // 待回填的 disp32 位置
    id: int         // 目标 id（函数 / 标签 / 字符串 / 导入符号 / bss）
    kind: int       // 0=函数 1=标签 2=字符串 3=IAT 4=bss
}

struct Ctx {
    code: vec[int]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    fnpos: vec[int]
    labs: vec[int]
    fixes: vec[Fix]
    vname: vec[int]
    vslot: vec[int]
    vtype: vec[int]     // 与 vname/vslot 平行的变量类型
    rdata: vec[int]
    strpos: vec[int]
    str_true: int
    str_false: int
    nl: vec[int]        // 1 元素 cell：rdata 里那个单独的换行字节偏移
                        // （结构体是按值传的，标量字段赋值不会回传）
    rt_pos: vec[int]    // [print_i64, print_str, str_cat, str_eq, memcpy, alloc]
}

const MAX_SLOT = 96
const FRAME = 1024

// 运行库例程在 rt_pos 里的槽号
const RT_PINT = 0
const RT_PSTR = 1
const RT_MEMCPY = 2
const RT_ALLOC = 3
const RT_CAT = 4
const RT_EQ = 5
const RT_DIE = 6

fn _scratch(d: int) -> int {
    return -8 * (MAX_SLOT / 2 + d + 1)
}

fn _slot_disp(slot: int) -> int {
    return -8 * (slot + 1)
}

fn _newlab(labs: vec[int]) -> int {
    labs.push(0)
    return len(labs) - 1
}

fn _setlab(labs: vec[int], code: vec[int], id: int) {
    labs.set(id, len(code))
}

fn _addfix(fixes: vec[Fix], pos: int, id: int, kind: int) {
    fixes.push(Fix { pos: pos, id: id, kind: kind })
}

fn _var_slot(ctx: Ctx, nid: int) -> int {
    let mut i = 0
    while i < len(ctx.vname) {
        if ctx.vname[i] == nid {
            return ctx.vslot[i]
        }
        i = i + 1
    }
    eprint("qlmc: 未定义变量 " + ctx.names[nid])
    exit(2)
    return -1
}

fn _var_type(ctx: Ctx, nid: int) -> int {
    let mut i = 0
    while i < len(ctx.vname) {
        if ctx.vname[i] == nid {
            return ctx.vtype[i]
        }
        i = i + 1
    }
    return TY_INT
}

fn _fn_index(ctx: Ctx, nid: int) -> int {
    let mut i = 0
    while i < len(ctx.fns) {
        if ctx.fns[i].name == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

/// mov dst, [base-8]（读 str 的长度前缀）
fn _len_of(code: vec[int], dst: int, base: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm(code, 1, dst, base)
    _b(code, 0xF8)
}

/// 调一个运行库例程（rel32 回填到 rt_pos[k]）
fn _call_rt(ctx: Ctx, k: int) {
    let p = _call_rel(ctx.code)
    _addfix(ctx.fixes, p, k, 5)
}

/// 表达式求值：值进 RAX，**返回类型 TY_***
fn _emit_expr(ctx: Ctx, nid: int, depth: int) -> int {
    let code: vec[int] = ctx.code
    let nodes: vec[Node] = ctx.nodes
    let nd = nodes[nid]
    if nd.op == E_NUM {
        _mov_imm(code, RAX, nd.a)
        if nd.ty == TY_BOOL {
            return TY_BOOL
        }
        return TY_INT
    }
    if nd.op == E_VAR {
        _mov_load(code, RAX, RBP, _slot_disp(_var_slot(ctx, nd.a)))
        return _var_type(ctx, nd.a)
    }
    if nd.op == E_STR {
        let at = len(code) + 3
        _lea_rip(code, RAX, 0)
        _addfix(ctx.fixes, at, nd.a, 2)
        return TY_STR
    }
    if nd.op == E_UN {
        let t = _emit_expr(ctx, nd.b, depth)
        if nd.a == P_MINUS {
            _neg(code, RAX)
            return TY_INT
        }
        _cmp_imm0(code, RAX)
        _setcc_al(code, 0x94)
        _movzx_rax_al(code)
        // `!` 在 stage-0 里是 int（打印 1/0），只有 && / || 与 str 比较是 bool
        return TY_INT
    }
    if nd.op == E_CALL {
        // 内建 assert(cond, msg)：失败写 stderr 后 exit(1)（与 stage-0 同退出码）
        if ctx.names[nd.a] == "assert" && nd.b >= 0 {
            let labs: vec[int] = ctx.labs
            let lfail = _newlab(labs)
            let lok = _newlab(labs)
            _emit_expr(ctx, nd.b, depth)
            _cmp_imm0(code, RAX)
            let p1 = _jcc(code, 0x84)
            _addfix(ctx.fixes, p1, lfail, 1)
            let p2 = _jmp(code)
            _addfix(ctx.fixes, p2, lok, 1)
            _setlab(labs, code, lfail)
            if nd.c >= 0 {
                let t = _emit_expr(ctx, nd.c, depth)
                if t == TY_STR {
                    _mov_rr(code, RCX, RAX)
                } else {
                    _mov_imm(code, RCX, 0)
                }
            } else {
                _mov_imm(code, RCX, 0)
            }
            _call_rt(ctx, RT_DIE)
            _setlab(labs, code, lok)
            _mov_imm(code, RAX, 0)
            return TY_INT
        }
        // 内建 len(s)：长度在 ptr-8
        if ctx.names[nd.a] == "len" && nd.b >= 0 {
            let t = _emit_expr(ctx, nd.b, depth)
            if t != TY_STR {
                eprint("qlmc: len() 目前只支持 str")
                exit(2)
            }
            _len_of(code, RAX, RAX)
            return TY_INT
        }
        let d0 = depth
        let mut has1 = 0
        let mut t0 = TY_INT
        let mut t1 = TY_INT
        if nd.b >= 0 {
            t0 = _emit_expr(ctx, nd.b, d0 + 1)
            _mov_store(code, RBP, _scratch(d0), RAX)
        }
        if nd.c >= 0 {
            has1 = 1
            t1 = _emit_expr(ctx, nd.c, d0 + 1)
            _mov_store(code, RBP, _scratch(d0 + 1), RAX)
        }
        if nd.b >= 0 {
            _mov_load(code, RCX, RBP, _scratch(d0))
        }
        if has1 != 0 {
            _mov_load(code, RDX, RBP, _scratch(d0 + 1))
        }
        let fi = _fn_index(ctx, nd.a)
        if fi < 0 {
            eprint("qlmc: 未定义函数 " + ctx.names[nd.a])
            exit(2)
        }
        let p = _call_rel(code)
        _addfix(ctx.fixes, p, fi, 0)
        return ctx.fns[fi].ret_t
    }
    if nd.op == E_BIN {
        if nd.a == P_AND || nd.a == P_OR {
            let labs: vec[int] = ctx.labs
            let lshort = _newlab(labs)
            let lend = _newlab(labs)
            _emit_expr(ctx, nd.b, depth)
            _cmp_imm0(code, RAX)
            if nd.a == P_AND {
                let p = _jcc(code, 0x84)
                _addfix(ctx.fixes, p, lshort, 1)
            } else {
                let p = _jcc(code, 0x85)
                _addfix(ctx.fixes, p, lshort, 1)
            }
            _emit_expr(ctx, nd.c, depth)
            _cmp_imm0(code, RAX)
            _setcc_al(code, 0x95)
            _movzx_rax_al(code)
            let p2 = _jmp(code)
            _addfix(ctx.fixes, p2, lend, 1)
            _setlab(labs, code, lshort)
            _mov_imm(code, RAX, 0)
            if nd.a == P_OR {
                _mov_imm(code, RAX, 1)
            }
            _setlab(labs, code, lend)
            return TY_BOOL
        }
        // 右操作数先落 scratch，再算左操作数（RAX 只有一个）
        let d = depth
        let tr = _emit_expr(ctx, nd.c, d + 1)
        _mov_store(code, RBP, _scratch(d), RAX)
        let tl = _emit_expr(ctx, nd.b, d + 1)
        _mov_load(code, RCX, RBP, _scratch(d))
        // 字符串：+ 走拼接、== / != 走内容比较。
        // 此刻 RAX = 左、RCX = 右，而运行库要 (rcx = a, rdx = b)：
        // 先搬右到 rdx，再搬左到 rcx（顺序反了会把左覆盖掉）。
        if tl == TY_STR || tr == TY_STR {
            if nd.a == P_PLUS {
                _mov_rr(code, RDX, RCX)
                _mov_rr(code, RCX, RAX)
                _call_rt(ctx, RT_CAT)
                return TY_STR
            }
            if nd.a == P_EQ || nd.a == P_NE {
                _mov_rr(code, RDX, RCX)
                _mov_rr(code, RCX, RAX)
                _call_rt(ctx, RT_EQ)
                if nd.a == P_NE {
                    _cmp_imm0(code, RAX)
                    _setcc_al(code, 0x94)
                    _movzx_rax_al(code)
                }
                // stage-0 的口径：**str 比较产生 bool**（打印 true/false），
                // 而 int 比较产生 int（打印 1/0）——差分要求一致，别"统一"。
                return TY_BOOL
            }
            eprint("qlmc: 字符串只支持 + 与 == / !=")
            exit(2)
        }
        if nd.a == P_PLUS {
            _alu_rr(code, 0x01, RAX, RCX)
            return TY_INT
        }
        if nd.a == P_MINUS {
            _alu_rr(code, 0x29, RAX, RCX)
            return TY_INT
        }
        if nd.a == P_STAR {
            _imul_rr(code, RAX, RCX)
            return TY_INT
        }
        if nd.a == P_SLASH {
            _cqo(code)
            _idiv(code, RCX)
            return TY_INT
        }
        if nd.a == P_PERCENT {
            _cqo(code)
            _idiv(code, RCX)
            _mov_rr(code, RAX, RDX)
            return TY_INT
        }
        _alu_rr(code, 0x39, RAX, RCX)
        let mut cc = 0x94
        if nd.a == P_EQ { cc = 0x94 }
        else if nd.a == P_NE { cc = 0x95 }
        else if nd.a == P_LT { cc = 0x9C }
        else if nd.a == P_LE { cc = 0x9E }
        else if nd.a == P_GT { cc = 0x9F }
        else if nd.a == P_GE { cc = 0x9D }
        else {
            eprint("qlmc: 不支持的运算符 " + nd.a.to_str())
            exit(2)
        }
        _setcc_al(code, cc)
        _movzx_rax_al(code)
        return TY_INT
    }
    eprint("qlmc: 不支持的表达式节点 " + nd.op.to_str())
    exit(2)
    return TY_INT
}

fn _emit_block(ctx: Ctx, head: int, depth: int, ep: int) {
    let mut cur = head
    while cur >= 0 {
        _emit_stmt(ctx, cur, depth, ep)
        cur = ctx.nodes[cur].nx
    }
}

fn _emit_stmt(ctx: Ctx, id: int, depth: int, ep: int) {
    let code: vec[int] = ctx.code
    let nodes: vec[Node] = ctx.nodes
    let labs: vec[int] = ctx.labs
    let nd = nodes[id]
    if nd.op == S_LET || nd.op == S_ASSIGN {
        let t = _emit_expr(ctx, nd.b, depth)
        if nd.op == S_LET {
            if len(ctx.vslot) >= MAX_SLOT / 2 {
                eprint("qlmc: 局部变量超过 " + (MAX_SLOT / 2).to_str() + " 个")
                exit(2)
            }
            ctx.vname.push(nd.a)
            ctx.vslot.push(len(ctx.vslot))
            ctx.vtype.push(t)
            _mov_store(code, RBP, _slot_disp(len(ctx.vslot) - 1), RAX)
        } else {
            _mov_store(code, RBP, _slot_disp(_var_slot(ctx, nd.a)), RAX)
        }
        return
    }
    if nd.op == S_IF {
        let lelse = _newlab(labs)
        let lend = _newlab(labs)
        _emit_expr(ctx, nd.a, depth)
        _cmp_imm0(code, RAX)
        let p = _jcc(code, 0x84)
        _addfix(ctx.fixes, p, lelse, 1)
        _emit_block(ctx, nd.b, depth, ep)
        let p2 = _jmp(code)
        _addfix(ctx.fixes, p2, lend, 1)
        _setlab(labs, code, lelse)
        _emit_block(ctx, nd.n, depth, ep)
        _setlab(labs, code, lend)
        return
    }
    if nd.op == S_WHILE {
        let ltop = _newlab(labs)
        let lend = _newlab(labs)
        _setlab(labs, code, ltop)
        _emit_expr(ctx, nd.a, depth)
        _cmp_imm0(code, RAX)
        let p = _jcc(code, 0x84)
        _addfix(ctx.fixes, p, lend, 1)
        _emit_block(ctx, nd.b, depth, ep)
        let p2 = _jmp(code)
        _addfix(ctx.fixes, p2, ltop, 1)
        _setlab(labs, code, lend)
        return
    }
    if nd.op == S_RETURN {
        if nd.a >= 0 {
            _emit_expr(ctx, nd.a, depth)
        } else {
            _mov_imm(code, RAX, 0)
        }
        let p = _jmp(code)
        _addfix(ctx.fixes, p, ep, 1)
        return
    }
    if nd.op == S_PRINT {
        // 类型决定通道：str 走 WriteFile，bool 走 true/false，其余走整数
        let t = _emit_expr(ctx, nd.a, depth)
        if t == TY_STR {
            _mov_rr(code, RCX, RAX)
            _call_rt(ctx, RT_PSTR)
            return
        }
        if t == TY_BOOL {
            let lf = _newlab(labs)
            let le = _newlab(labs)
            _cmp_imm0(code, RAX)
            let pj = _jcc(code, 0x84)
            _addfix(ctx.fixes, pj, lf, 1)
            _mov_imm(code, RCX, 0)
            let at = len(code) + 3
            _lea_rip(code, RCX, 0)
            _addfix(ctx.fixes, at, ctx.str_true, 2)
            _call_rt(ctx, RT_PSTR)
            let pj2 = _jmp(code)
            _addfix(ctx.fixes, pj2, le, 1)
            _setlab(labs, code, lf)
            let at2 = len(code) + 3
            _lea_rip(code, RCX, 0)
            _addfix(ctx.fixes, at2, ctx.str_false, 2)
            _call_rt(ctx, RT_PSTR)
            _setlab(labs, code, le)
            return
        }
        _call_rt(ctx, RT_PINT)
        return
    }
    if nd.op == S_EXIT {
        _emit_expr(ctx, nd.a, depth)
        _mov_rr(code, RCX, RAX)
        let p = _call_rip(code)
        _addfix(ctx.fixes, p, I_EXIT, 3)
        return
    }
    if nd.op == S_EXPR {
        _emit_expr(ctx, nd.a, depth)
        return
    }
    eprint("qlmc: 不支持的语句节点 " + nd.op.to_str())
    exit(2)
}

fn _param_name(f: Fn, k: int) -> int {
    if k == 0 { return f.p0 }
    if k == 1 { return f.p1 }
    if k == 2 { return f.p2 }
    return f.p3
}

fn _param_type(f: Fn, k: int) -> int {
    if k == 0 { return f.p0t }
    if k == 1 { return f.p1t }
    if k == 2 { return f.p2t }
    return f.p3t
}

/// 一个函数：序言 + 形参落槽 + 体 + 收尾（默认返回 0）
fn _gen_fn(ctx: Ctx, fi: int) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    let f = ctx.fns[fi]
    ctx.fnpos.set(fi, len(code))
    ctx.vname.clear()
    ctx.vslot.clear()
    ctx.vtype.clear()
    _push_rbp(code)
    _mov_rbp_rsp(code)
    _sub_rsp(code, FRAME)
    let mut k = 0
    while k < f.np {
        let mut reg = RCX
        if k == 1 { reg = RDX }
        else if k == 2 { reg = R8 }
        else if k == 3 { reg = R9 }
        ctx.vname.push(_param_name(f, k))
        ctx.vslot.push(k)
        ctx.vtype.push(_param_type(f, k))
        _mov_store(code, RBP, _slot_disp(k), reg)
        k = k + 1
    }
    let ep = _newlab(labs)
    _emit_block(ctx, f.body, 0, ep)
    _mov_imm(code, RAX, 0)
    _setlab(labs, code, ep)
    _mov_rsp_rbp(code)
    _pop_rbp(code)
    _ret(code)
}

// ---------------------------------------------------------------------------
// 运行库（机器码手写）
//
// 约定：入口 rsp ≡ 8 (mod 16)；先 `sub rsp, 0x58`（88 → 8+88 ≡ 0）再调 Win32，
// 这样每次 call 前 rsp 都是 16 对齐的。跨调用要用的值一律落 [rsp+0x20..]。
// ---------------------------------------------------------------------------

/// __print_i64(rax = 值)：wsprintfA("%I64d\n") + WriteFile
fn _gen_print_i64(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PINT, len(code))
    _sub_rsp(code, 0x68)
    _lea_rsp(code, RCX, 0x30)
    let f1 = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, f1, -2, 2)          // id -2 = 格式串
    _mov_rr(code, R8, RAX)
    _b(code, 0x31)                         // xor eax, eax（varargs: AL=0）
    _b(code, 0xC0)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_WSPRINTF, 3)
    _mov_rsp_store(code, 0x28, RAX)        // 长度
    _mov_imm(code, RCX, -11)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _lea_rsp(code, RDX, 0x30)
    _mov_rsp_load(code, R8, 0x28)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __print_str(rcx = str)：写 len 字节 + 一个换行
fn _gen_print_str(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PSTR, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // 保存 str
    _mov_imm(code, RCX, -11)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rsp_store(code, 0x30, RAX)        // 句柄
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    // 换行
    _mov_rsp_load(code, RCX, 0x30)
    let at = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, at, -3, 2)          // id -3 = 换行字节
    _mov_imm(code, R8, 1)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __die(rcx = 消息 str)：写 stderr（handle -12）后 exit(1)
fn _gen_die(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_DIE, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)
    _mov_imm(code, RCX, -12)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    _mov_imm(code, RCX, 1)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_EXIT, 3)
    _ret(code)
}

/// __memcpy(rdi = dst, rsi = src, rcx = n)
fn _gen_memcpy(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMCPY, len(code))
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x48)                         // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)
    _addfix(ctx.fixes, p0, ldone, 1)
    _setlab(labs, code, ltop)
    _b(code, 0x8A)                         // mov al, [rsi]
    _b(code, 0x06)
    _b(code, 0x88)                         // mov [rdi], al
    _b(code, 0x07)
    _b(code, 0x48)                         // inc rsi
    _b(code, 0xFF)
    _b(code, 0xC6)
    _b(code, 0x48)                         // inc rdi
    _b(code, 0xFF)
    _b(code, 0xC7)
    _b(code, 0x48)                         // dec rcx
    _b(code, 0xFF)
    _b(code, 0xC9)
    let p1 = _jcc(code, 0x85)              // jnz .loop
    _addfix(ctx.fixes, p1, ltop, 1)
    _setlab(labs, code, ldone)
    _ret(code)
}

/// __str_cat(rcx = a, rdx = b) -> rax：新分配 [len][bytes][NUL]
fn _gen_str_cat(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_CAT, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // a
    _mov_rsp_store(code, 0x30, RDX)        // b
    _len_of(code, R8, RCX)                 // la
    _mov_rsp_store(code, 0x38, R8)
    _len_of(code, R9, RDX)                 // lb
    _mov_rsp_store(code, 0x40, R9)
    _mov_rr(code, RCX, R8)                 // n = la + lb + 9
    _alu_rr(code, 0x01, RCX, R9)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC1)
    _b(code, 9)
    _call_rt(ctx, RT_ALLOC)
    _mov_rsp_store(code, 0x48, RAX)        // 块首
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _mov_rr(code, R10, R8)                 // total = la + lb
    _alu_rr(code, 0x01, R10, R9)
    _mov_store(code, RAX, 0, R10)          // [块首] = total
    _lea_rsp(code, RDI, 0x50)              // 复用不了：直接算 data = 块首 + 8
    _mov_rsp_load(code, RDI, 0x48)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC7)
    _b(code, 8)                            // add rdi, 8
    _mov_rsp_store(code, 0x50, RDI)        // data
    // 拷 a
    _mov_rsp_load(code, RSI, 0x28)
    _mov_rsp_load(code, RCX, 0x38)
    _call_rt(ctx, RT_MEMCPY)
    // 拷 b：dst = data + la
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _alu_rr(code, 0x01, RDI, R8)
    _mov_rsp_load(code, RSI, 0x30)
    _mov_rsp_load(code, RCX, 0x40)
    _call_rt(ctx, RT_MEMCPY)
    // NUL
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _alu_rr(code, 0x01, RDI, R8)
    _alu_rr(code, 0x01, RDI, R9)
    _b(code, 0xC6)                         // mov byte [rdi], 0
    _b(code, 0x07)
    _b(code, 0)
    _mov_rsp_load(code, RAX, 0x50)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __str_eq(rcx = a, rdx = b) -> rax (1/0)
fn _gen_str_eq(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_EQ, len(code))
    let ltop = _newlab(labs)
    let lne = _newlab(labs)
    let leq = _newlab(labs)
    _len_of(code, R8, RCX)
    _len_of(code, R9, RDX)
    _alu_rr(code, 0x39, R8, R9)            // cmp r8, r9
    let p0 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p0, lne, 1)
    _setlab(labs, code, ltop)
    _b(code, 0x4D)                         // test r8, r8（REX.W|R|B —— 漏了 REX 就成 test rax）
    _b(code, 0x85)
    _b(code, 0xC0)
    let p1 = _jcc(code, 0x84)              // jz .eq
    _addfix(ctx.fixes, p1, leq, 1)
    _b(code, 0x8A)                         // mov al, [rcx]
    _b(code, 0x01)
    _b(code, 0x3A)                         // cmp al, [rdx]
    _b(code, 0x02)
    let p2 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p2, lne, 1)
    _b(code, 0x48)                         // inc rcx
    _b(code, 0xFF)
    _b(code, 0xC1)
    _b(code, 0x48)                         // inc rdx
    _b(code, 0xFF)
    _b(code, 0xC2)
    _b(code, 0x49)                         // dec r8
    _b(code, 0xFF)
    _b(code, 0xC8)
    let p3 = _jmp(code)
    _addfix(ctx.fixes, p3, ltop, 1)
    _setlab(labs, code, leq)
    _mov_imm(code, RAX, 1)
    _ret(code)
    _setlab(labs, code, lne)
    _mov_imm(code, RAX, 0)
    _ret(code)
}

/// __alloc(rcx = 字节数) -> rax：.bss 里的 bump 分配器（8 字节对齐）
fn _gen_alloc(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_ALLOC, len(code))
    let lhave = _newlab(labs)
    _b(code, 0x48)                         // mov rax, [rip+HEAP]
    _b(code, 0x8B)
    _b(code, 0x05)
    let f1 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f1, 0, 4)           // bss 偏移 0 = heap 游标
    _b(code, 0x48)                         // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
    let p0 = _jcc(code, 0x85)              // jnz .have
    _addfix(ctx.fixes, p0, lhave, 1)
    _b(code, 0x48)                         // lea rax, [rip+bss+16]（堆起点）
    _b(code, 0x8D)
    _b(code, 0x05)
    let f2 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f2, 16, 4)          // bss 偏移 16 = 堆起点
    _setlab(labs, code, lhave)
    _b(code, 0x4C)                         // lea r8, [rax+rcx+7]
    _b(code, 0x8D)
    _b(code, 0x44)
    _b(code, 0x08)
    _b(code, 7)
    _b(code, 0x49)                         // and r8, -8
    _b(code, 0x83)
    _b(code, 0xE0)
    _b(code, 0xF8)
    _b(code, 0x4C)                         // mov [rip+HEAP], r8
    _b(code, 0x89)
    _b(code, 0x05)
    let f3 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f3, 0, 4)
    _ret(code)
}

/// 入口：sub rsp,0x28 -> call main -> ExitProcess(rax)
fn _gen_entry(ctx: Ctx) {
    let code: vec[int] = ctx.code
    _sub_rsp(code, 0x28)
    let p = _call_rel(code)
    _addfix(ctx.fixes, p, -1, 0)           // id -1 = main
    _mov_rr(code, RCX, RAX)
    let p2 = _call_rip(code)
    _addfix(ctx.fixes, p2, I_EXIT, 3)
}

// ---------------------------------------------------------------------------
// rdata：导入表 + 字符串（每个是 `[len:8][bytes][NUL]`，值 = 数据指针）
// ---------------------------------------------------------------------------

fn _w16(buf: vec[int], v: int) {
    _b(buf, v)
    _b(buf, v >> 8)
}

fn _bytes(buf: vec[int], s: str) {
    let mut i = 0
    while i < len(s) {
        _b(buf, s[i])
        i = i + 1
    }
}

fn _zero(buf: vec[int], n: int) {
    let mut i = 0
    while i < n {
        _b(buf, 0)
        i = i + 1
    }
}

fn _pad_to(buf: vec[int], n: int) {
    while len(buf) < n {
        _b(buf, 0)
    }
}

fn build_rdata(ctx: Ctx, rdata_rva: int, iat: vec[int]) {
    let rd: vec[int] = ctx.rdata
    let g = "GetStdHandle"
    let w = "WriteFile"
    let e = "ExitProcess"
    let sp = "wsprintfA"
    let dk = "kernel32.dll"
    let du = "user32.dll"
    let ilt_k = 64
    let iat_k = ilt_k + 8 * 4
    let ilt_u = iat_k + 8 * 4
    let iat_u = ilt_u + 8 * 2
    let mut cur = iat_u + 8 * 2
    let hn_g = cur
    cur = cur + 2 + len(g) + 1
    if cur % 2 != 0 {
        cur = cur + 1
    }
    let hn_w = cur
    cur = cur + 2 + len(w) + 1
    if cur % 2 != 0 {
        cur = cur + 1
    }
    let hn_e = cur
    cur = cur + 2 + len(e) + 1
    if cur % 2 != 0 {
        cur = cur + 1
    }
    let hn_s = cur
    cur = cur + 2 + len(sp) + 1
    if cur % 2 != 0 {
        cur = cur + 1
    }
    let dn_k = cur
    cur = cur + len(dk) + 1
    let dn_u = cur
    cur = cur + len(du) + 1
    if cur % 2 != 0 {
        cur = cur + 1
    }
    _w32(rd, rdata_rva + ilt_k)
    _w32(rd, 0)
    _w32(rd, 0)
    _w32(rd, rdata_rva + dn_k)
    _w32(rd, rdata_rva + iat_k)
    _w32(rd, rdata_rva + ilt_u)
    _w32(rd, 0)
    _w32(rd, 0)
    _w32(rd, rdata_rva + dn_u)
    _w32(rd, rdata_rva + iat_u)
    _zero(rd, 20)
    _pad_to(rd, 64)
    _w64(rd, rdata_rva + hn_g)
    _w64(rd, rdata_rva + hn_w)
    _w64(rd, rdata_rva + hn_e)
    _w64(rd, 0)
    _w64(rd, rdata_rva + hn_g)
    _w64(rd, rdata_rva + hn_w)
    _w64(rd, rdata_rva + hn_e)
    _w64(rd, 0)
    _w64(rd, rdata_rva + hn_s)
    _w64(rd, 0)
    _w64(rd, rdata_rva + hn_s)
    _w64(rd, 0)
    _w16(rd, 0)
    _bytes(rd, g)
    _b(rd, 0)
    _pad_to(rd, hn_w)
    _w16(rd, 0)
    _bytes(rd, w)
    _b(rd, 0)
    _pad_to(rd, hn_e)
    _w16(rd, 0)
    _bytes(rd, e)
    _b(rd, 0)
    _pad_to(rd, hn_s)
    _w16(rd, 0)
    _bytes(rd, sp)
    _b(rd, 0)
    _pad_to(rd, dn_k)
    _bytes(rd, dk)
    _b(rd, 0)
    _pad_to(rd, dn_u)
    _bytes(rd, du)
    _b(rd, 0)
    // 字符串表：每个 `[len:8][bytes][NUL]`，strpos = 数据指针的偏移
    let mut i = 0
    while i < len(ctx.strs) {
        _pad_to(rd, _align_up(len(rd), 8))
        let s = ctx.strs[i]
        _w64(rd, len(s))
        ctx.strpos.set(i, len(rd))
        _bytes(rd, s)
        _b(rd, 0)
        i = i + 1
    }
    // 换行字节（print 的语义是"输出 + 换行"，str 通道要单独写一个字节）
    ctx.nl.set(0, len(rd))
    _b(rd, 10)
    // 格式串（普通 C 字符串，给 wsprintfA）
    _pad_to(rd, _align_up(len(rd), 2))
    ctx.strpos.set(len(ctx.strpos) - 1, len(rd))
    _bytes(rd, "%I64d\n")
    _b(rd, 0)
    iat.set(I_GETSTD, rdata_rva + iat_k)
    iat.set(I_WRITE, rdata_rva + iat_k + 8)
    iat.set(I_EXIT, rdata_rva + iat_k + 16)
    iat.set(I_WSPRINTF, rdata_rva + iat_u)
}

// ---------------------------------------------------------------------------
// 回填
// ---------------------------------------------------------------------------

fn resolve_fixes(ctx: Ctx, rdata_rva: int, bss_rva: int, iat: vec[int]) {
    let code: vec[int] = ctx.code
    let fixes: vec[Fix] = ctx.fixes
    let mut i = 0
    while i < len(fixes) {
        let fx = fixes[i]
        let mut target = 0
        if fx.kind == 0 {
            if fx.id == -1 {
                let mi = _name_id_ro(ctx, "main")
                if mi < 0 {
                    eprint("qlmc: 没有 main")
                    exit(2)
                }
                target = ctx.fnpos[_fn_index(ctx, mi)]
            } else {
                target = ctx.fnpos[fx.id]
            }
        } else if fx.kind == 1 {
            target = ctx.labs[fx.id]
        } else if fx.kind == 2 {
            if fx.id == -2 {
                target = rdata_rva + ctx.strpos[len(ctx.strpos) - 1] - TEXT_RVA
            } else if fx.id == -3 {
                target = rdata_rva + ctx.nl[0] - TEXT_RVA
            } else {
                target = rdata_rva + ctx.strpos[fx.id] - TEXT_RVA
            }
        } else if fx.kind == 3 {
            target = iat[fx.id] - TEXT_RVA
        } else if fx.kind == 4 {
            target = bss_rva + fx.id - TEXT_RVA
        } else {
            target = ctx.rt_pos[fx.id]
        }
        _patch32(code, fx.pos, target - (fx.pos + 4))
        i = i + 1
    }
}

fn _name_id_ro(ctx: Ctx, s: str) -> int {
    let mut i = 0
    while i < len(ctx.names) {
        if ctx.names[i] == s {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// PE32+ 写出（三节：.text / .rdata / .bss）
// ---------------------------------------------------------------------------

const BSS_SIZE = 0x100000        // 1 MB 堆（.bss：不占文件体积，加载器零填）

fn build_pe(code: vec[int], rdata: vec[int], blob: vec[int]) -> int {
    let text_len = len(code)
    let rdata_len = len(rdata)
    let rdata_rva = TEXT_RVA + _align_up(text_len, SECT_ALIGN)
    let bss_rva = rdata_rva + _align_up(rdata_len, SECT_ALIGN)
    let nsec = 3
    let headers = _align_up(HDR_DOS + 4 + 20 + OPT_SIZE + 40 * nsec, FILE_ALIGN)
    let text_raw_size = _align_up(text_len, FILE_ALIGN)
    let rdata_raw = headers + text_raw_size
    let rdata_raw_size = _align_up(rdata_len, FILE_ALIGN)
    let image = _align_up(bss_rva + BSS_SIZE, SECT_ALIGN)
    _b(blob, 77)
    _b(blob, 90)
    _zero(blob, 58)
    _w32(blob, HDR_DOS)
    _pad_to(blob, HDR_DOS)
    _b(blob, 80)
    _b(blob, 69)
    _b(blob, 0)
    _b(blob, 0)
    _w16(blob, 0x8664)
    _w16(blob, nsec)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, OPT_SIZE)
    _w16(blob, 0x0022)
    let opt_at = len(blob)
    _w16(blob, 0x20B)
    _b(blob, 14)
    _b(blob, 0)
    _w32(blob, text_raw_size)
    _w32(blob, rdata_raw_size)
    _w32(blob, BSS_SIZE)                // SizeOfUninitializedData
    _w32(blob, TEXT_RVA)
    _w32(blob, TEXT_RVA)
    _w64(blob, IMAGE_BASE)
    _w32(blob, SECT_ALIGN)
    _w32(blob, FILE_ALIGN)
    // OS 版本 6.0 / 映像版本 0.0 / 子系统版本 6.0 —— 六个 u16 一个都不能少
    _w16(blob, 6)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 6)
    _w16(blob, 0)
    _w32(blob, 0)
    _w32(blob, image)
    _w32(blob, headers)
    _w32(blob, 0)
    _w16(blob, 3)
    _w16(blob, 0x0100)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w32(blob, 0)
    _w32(blob, 16)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, rdata_rva)
    _w32(blob, 60)
    let mut k = 2
    while k < 16 {
        _w32(blob, 0)
        _w32(blob, 0)
        k = k + 1
    }
    _pad_to(blob, opt_at + OPT_SIZE)
    _bytes(blob, ".text")
    _zero(blob, 3)
    _w32(blob, text_len)
    _w32(blob, TEXT_RVA)
    _w32(blob, text_raw_size)
    _w32(blob, headers)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_CODE)
    _bytes(blob, ".rdata")
    _zero(blob, 2)
    _w32(blob, rdata_len)
    _w32(blob, rdata_rva)
    _w32(blob, rdata_raw_size)
    _w32(blob, rdata_raw)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_RDATA)
    _bytes(blob, ".bss")
    _zero(blob, 4)
    _w32(blob, BSS_SIZE)                // VirtualSize
    _w32(blob, bss_rva)
    _w32(blob, 0)                       // SizeOfRawData = 0：不占文件
    _w32(blob, 0)                       // PointerToRawData = 0
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, 0xC0000080)              // RW, 未初始化数据
    _pad_to(blob, headers)
    let mut i = 0
    while i < text_len {
        _b(blob, code[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw)
    i = 0
    while i < rdata_len {
        _b(blob, rdata[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw + rdata_raw_size)
    return bss_rva
}

fn write_file(path: str, buf: vec[int]) -> int {
    let h = _CreateFileA(cstr(path), GEN_WRITE, 0, 0, CREATE_ALWAYS,
                         ATTR_NORMAL, 0)
    if h == -1 {
        eprint("qlmc: 打不开输出文件 " + path)
        exit(2)
    }
    let n = len(buf)
    let p = mem_alloc(n + 8)
    let mut i = 0
    while i < n {
        mem_store8(p, i, buf[i])
        i = i + 1
    }
    let got = mem_alloc(8)
    if !_WriteFile(h, p, n, got, 0) {
        eprint("qlmc: 写文件失败 " + path)
        exit(2)
    }
    _CloseHandle(h)
    return 0
}

// ---------------------------------------------------------------------------
// 主流程
// ---------------------------------------------------------------------------

fn _usage() {
    eprint("用法: qlmc build <src.qma> [-o out.exe] | qlmc dump <src.qma> | qlmc version")
}

fn main() {
    let t0 = now_ns()
    let a = args()
    if len(a) < 1 {
        _usage()
        exit(2)
    }
    if a[0] == "version" {
        print("qlmc 0.2（Quelmara 写的 stage-1 编译器，子集 S2：int/bool/str）")
        return
    }
    if len(a) < 2 {
        _usage()
        exit(2)
    }
    let cmd = a[0]
    let src = a[1]
    let mut out = "build/qlmc_out.exe"
    let mut i = 2
    while i < len(a) {
        if a[i] == "-o" && i + 1 < len(a) {
            out = a[i + 1]
        }
        i = i + 1
    }
    if !file_exists(src) {
        eprint("qlmc: 找不到 " + src)
        exit(2)
    }
    let text = read_text(src)

    let toks = vec[Tok].new(256)
    lex(text, toks)
    let nodes = vec[Node].new(256)
    let names = vec[str].new(32)
    let strs = vec[str].new(16)
    let fns = vec[Fn].new(8)
    let cname = vec[int].new(8)
    let cval = vec[int].new(8)
    parse(toks, nodes, names, strs, fns, cname, cval)

    if cmd == "dump" {
        print("tokens   : " + len(toks).to_str())
        print("nodes    : " + len(nodes).to_str())
        print("fns      : " + len(fns).to_str())
        print("names    : " + len(names).to_str())
        print("strs     : " + len(strs).to_str())
        return
    }

    // true/false 先占位（S_PRINT 的 bool 通道要用）
    strs.push("true")
    let s_true = len(strs) - 1
    strs.push("false")
    let s_false = len(strs) - 1

    let code = vec[int].new(4096)
    let fnpos = vec[int].new(len(fns))
    let mut fi = 0
    while fi < len(fns) {
        fnpos.push(0)
        fi = fi + 1
    }
    let labs = vec[int].new(64)
    let fixes = vec[Fix].new(64)
    let vname = vec[int].new(32)
    let vslot = vec[int].new(32)
    let vtype = vec[int].new(32)
    let rdata = vec[int].new(2048)
    let strpos = vec[int].new(len(strs) + 1)
    let mut si = 0
    while si < len(strs) + 1 {
        strpos.push(-1)
        si = si + 1
    }
    let iat = vec[int].new(4)
    iat.push(0)
    iat.push(0)
    iat.push(0)
    iat.push(0)
    let nl = vec[int].new(1)
    nl.push(0)
    let rt_pos = vec[int].new(7)
    si = 0
    while si < 7 {
        rt_pos.push(0)
        si = si + 1
    }

    let ctx = Ctx { code: code, nodes: nodes, names: names, strs: strs,
                    fns: fns, fnpos: fnpos, labs: labs, fixes: fixes,
                    vname: vname, vslot: vslot, vtype: vtype, rdata: rdata,
                    strpos: strpos, str_true: s_true, str_false: s_false,
                    nl: nl, rt_pos: rt_pos }

    // **入口必须落在 .text 偏移 0**（AddressOfEntryPoint 恒等于 TEXT_RVA），
    // 所以先发入口，再发运行库与函数。fixup 与顺序无关。
    _gen_entry(ctx)
    _gen_print_i64(ctx)
    _gen_print_str(ctx)
    _gen_memcpy(ctx)
    _gen_alloc(ctx)
    _gen_str_cat(ctx)
    _gen_str_eq(ctx)
    _gen_die(ctx)
    fi = 0
    while fi < len(fns) {
        _gen_fn(ctx, fi)
        fi = fi + 1
    }

    let rdata_rva = TEXT_RVA + _align_up(len(code), SECT_ALIGN)
    let bss_rva = rdata_rva + _align_up(4096, SECT_ALIGN)   // 占位，build_pe 会算准
    build_rdata(ctx, rdata_rva, iat)
    let real_bss = rdata_rva + _align_up(len(rdata), SECT_ALIGN)
    resolve_fixes(ctx, rdata_rva, real_bss, iat)

    let blob = vec[int].new(8192)
    let pe_bss = build_pe(code, rdata, blob)
    if pe_bss != real_bss {
        eprint("qlmc: 内部错误：bss RVA 不一致 " + pe_bss.to_str() +
               " vs " + real_bss.to_str())
        exit(2)
    }
    write_file(out, blob)
    print("[qlmc] " + src + " -> " + out + "  (" + len(blob).to_str() + " 字节, 子集 S2)" +
          "  编译 " + ((now_ns() - t0) / 1000).to_str() + " us（进程内）")
}
