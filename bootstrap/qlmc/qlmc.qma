// bootstrap/qlmc/qlmc.qma —— Quelmara 写的 Quelmara 编译器（stage-1，v2.16）
//
// ## 它是什么
//
// 一个**能出 exe** 的原生编译器：`.qma` -> PE32+，全程用 Quelmara 写，不经过
// Python、不依赖 CRT、不链接任何东西。跑起来是一个独立 exe。
//
// ## 它不是什么（重要，别当成"自举完成"）
//
// 只覆盖**子集 S12**（见 docs/05-toolchain.md §1.11 的覆盖表）。设计上刻意把
// "链路通 + 后端真"排在"语法全覆盖"前面：后端是自举的承重墙，语法是加法。
//
//   支持：fn（int/bool/str 形参与返回，≤4 参）、let/mut（可带类型标注）、赋值、
//         if/else、while、**for 区间**、**break/continue**、return、exit、print、
//         assert、len(str)、const（解析期内联）、算术 + - * / %、比较、
//         && || !（短路）、str 拼接与内容比较、递归、**struct（声明/字面量/
//         字段读写/值语义拷贝）**、**定长数组 [N]T（字面量/下标读写）**、
//         **enum（声明/构造/载荷）与 match（表达式/语句/`_`/载荷绑定）**、
//         **vec[T]（new/push/get/len/下标读写，容量固定不扩容）**、
//         **聚合（struct/enum）作形参与返回值（按值传 + sret）**、
//         **map[K]V（固定容量线性扫描）**、**切片 []T（视图）**、**defer**、
//         **≤4 个实参**、**import（同目录多文件）**、**@ffi（任意 DLL）**、
//         **闭包（无捕获）**
//   不支持：f64、泛型、宏/反射、接口、rc/Drop、闭包的捕获、
//         pub 可见性与限定调用、嵌套聚合字段、聚合 print
//
// ## 分层（v2.16 重写了后端，前端沿用）
//
//   lexer   `lex`            —— 只认 S2 记号集，不认识的字符 fail-fast
//   parser  递归下降 + 优先级爬升 —— **平坦 AST**（节点表 + `nx` 链）
//   IR      三地址线性 IR    —— `Ir`（op/dst/a/b/imm）+ 标签，与 AST 解耦
//   alloc   **线性扫描**     —— 变量固定 callee-saved（RBX/R12-R15），
//                              临时值走活跃区间 + R8-R11；跨调用的临时值落帧槽
//   emit    x86-64 手写编码  —— 按位置（寄存器/帧槽）发射，`cmp+jcc` 融合
//   par     **按函数并行**   —— 每个线程编一段，写 arena 自己那段，主线程拼装
//   file    PE32+ 三节       —— .text / .rdata / .bss（1 MB 堆），导入 kernel32
//
// ## 三个必须守住的性质
//
// 1. **差分**：同一份源码，stage-0 与 qlmc 的产物 stdout/退出码逐字节相同
//    （`tests/qlmc_test.py`）。这是唯一的正确性判据。
// 2. **确定性**：`-j1` 与 `-jN` 的 exe 逐字节相同（拼装顺序固定、每线程只写
//    自己的区间，所以并行不需要锁也不改变产物）。
// 3. **fail-fast**：不支持的语法/形态一律编译期报错并退 2，绝不静默生成错码。
//
// ## 用法
//
//   qlmc build <src.qma> [-o out.exe] [-j N]   编译成 PE（-j 0/省略 = 自动）
//   qlmc dump <src.qma>                        只跑词法+语法，打印统计
//   qlmc version
import std.core
import std.mem

// ---------------------------------------------------------------------------
// 写文件（产出 exe）
// ---------------------------------------------------------------------------

@ffi("kernel32.dll", "CreateFileA")
fn _CreateFileA(name: int, access: int, share: int, sec: int, disp: int,
                flags: int, tmpl: int) -> int

@ffi("kernel32.dll", "WriteFile")
fn _WriteFile(h: int, buf: int, n: int, got: int, ov: int) -> bool

@ffi("kernel32.dll", "CloseHandle")
fn _CloseHandle(h: int) -> bool

const GEN_WRITE = 1073741824        // 0x40000000
const CREATE_ALWAYS = 2
const ATTR_NORMAL = 128

// ---------------------------------------------------------------------------
// 记号
// ---------------------------------------------------------------------------

const T_EOF = 0
const T_NUM = 1
const T_NAME = 2
const T_STR = 3
const T_PUNCT = 4
const T_KW = 5

// 关键字 id
const K_FN = 1
const K_LET = 2
const K_MUT = 3
const K_IF = 4
const K_ELSE = 5
const K_WHILE = 6
const K_RETURN = 7
const K_TRUE = 8
const K_FALSE = 9
const K_PRINT = 10
const K_EXIT = 11
const K_MODULE = 12
const K_IMPORT = 13
const K_CONST = 14
const K_FOR = 15
const K_IN = 16
const K_BREAK = 17
const K_CONTINUE = 18
const K_STRUCT = 19
const K_ENUM = 20
const K_MATCH = 21
const K_DEFER = 22
const K_SPAWN = 23

// 标点 id（多字符的按"最长匹配"先行）
const P_LPAREN = 1
const P_RPAREN = 2
const P_LBRACE = 3
const P_RBRACE = 4
const P_COMMA = 5
const P_COLON = 6
const P_SEMI = 7
const P_ASSIGN = 8
const P_PLUS = 9
const P_MINUS = 10
const P_STAR = 11
const P_SLASH = 12
const P_PERCENT = 13
const P_LT = 14
const P_GT = 15
const P_EQ = 16
const P_NE = 17
const P_LE = 18
const P_GE = 19
const P_AND = 20
const P_OR = 21
const P_NOT = 22
const P_ARROW = 23
const P_DOT = 24
const P_DOTDOT = 25
const P_LBRACK = 26
const P_RBRACK = 27
const P_FATARROW = 28
const P_AT = 29
// 位运算与移位（v2.28）。优先级照 stage-0（Quelmara 自己的定义，见 SPEC §2.4）：
//   ||  <  &&  <  |  <  ^  <  &  <  == !=  <  < <= > >=  <  << >> >>>  <  + -  <  * / %
// 注意这**不是** C 的层次（C 把 & ^ | 放在 == 之下、<< 放在 +- 之上）。
const P_AMP = 30       // &
const P_PIPE = 31      // |
const P_CARET = 32     // ^
const P_SHL = 33       // <<
const P_SHR = 34       // >>（算术右移，对应 sar）
const P_USHR = 35      // >>>（逻辑右移，对应 shr）
const P_TILDE = 36     // ~（一元按位取反）

struct Tok {
    k: int          // T_*
    n: int          // 数值 / 关键字 id / 标点 id
    s: str          // 标识符名 / 字符串内容
    line: int
}

// ---------------------------------------------------------------------------
// AST：平坦节点表
//
// 节点用 int 索引（-1 = 无）。块用 (start, count) 表示**连续区间**——
// 解析是顺序追加的，所以嵌套块的成员天然连续，不需要链表。
// ---------------------------------------------------------------------------

// 表达式
const E_NUM = 40
const E_VAR = 41
const E_BIN = 42      // a = 运算符(P_*)，b/c = 子节点
const E_UN = 43       // a = P_MINUS / P_NOT，b = 子节点
const E_CALL = 44     // a = 名字 id，b/c = 实参节点（-1 = 无）
const E_STR = 45
const E_FIELD = 46      // a = 基址表达式，b = 字段名 id
const E_INDEX = 47      // a = 基址表达式，b = 下标表达式
const E_STRUCTLIT = 48  // a = struct 序号，b = 首个 E_FINIT（nx 链）
const E_ARRLIT = 49    // a = 首个 E_AINIT（nx 链），b = 元素个数
const E_FINIT = 50     // a = 字段序号，b = 值
const E_AINIT = 51     // a = 值
const E_ENUMCTOR = 52  // a = enum 序号，b = 变体序号，c = 载荷表达式（-1 = 无）
const E_MATCH = 53     // a = 被匹配表达式，b = 首个 E_ARM（nx 链），c = 结果类型
const E_METHOD = 55    // a = 接收者，b = 方法名 id，c = 实参（-1 = 无）
const E_VECNEW = 56    // a = 元素类型，b = 容量表达式
const E_MAPNEW = 57    // a = 键类型，b = 容量表达式，c = 值类型
const E_SLICE = 58     // a = 基址表达式，b = lo，c = hi（`a[lo..hi]`）
const E_CLOSURE = 59   // a = 合成函数的序号
// 形参记录（v2.29）：只出现在 nodes 的"形参表"区段里，不是真正的表达式。
// a = 名字 id，b = 类型 TY_*。Fn.pbase 指向这一段的起点。
const E_FPARAM = 60
// spawn f(args)（v2.32）：a = 函数名字 id，b/c/n/slot + nx 链 = 实参（同 E_CALL）
const E_SPAWN = 61
const E_ARM = 54       // a = 变体序号（-1 = 通配），b = 绑定名 id（-1 = 不绑定），c = 体      // a = 字符串表 id

// 语句
const S_LET = 10     // a = 名字 id，b = 初值，n = mut(0/1)，slot = 帧槽号
const S_ASSIGN = 11  // a = 名字 id，b = 值
const S_IF = 12      // a = 条件，b = then(start)，c = then(count)，n = else(start)，slot = else(count)
const S_WHILE = 13   // a = 条件，b = start，c = count
const S_RETURN = 14  // a = 值（-1 = 无）
const S_PRINT = 15   // a = 值
const S_EXIT = 16    // a = 值
const S_EXPR = 17
const S_FOR = 18       // a = 循环变量名，b = lo，c = hi，n = 体
const S_BREAK = 19
const S_CONTINUE = 20
const S_ASG_FIELD = 21   // a = 基址，b = 字段名 id，c = 值
const S_ASG_INDEX = 22   // a = 基址，b = 下标，c = 值
const S_MATCH = 23
const S_DEFER = 24        // a = 被延迟的语句节点（S_EXPR / S_ASSIGN）       // 同 E_MATCH，但按语句降级    // a = 值

struct Node {
    op: int
    a: int
    b: int
    c: int
    n: int      // 附加（mut 标志 / else 头）
    slot: int   // 附加（局部槽号）
    ty: int     // 附加（表达式类型 TY_*）
    nx: int     // 同块下一条语句（-1 = 块尾）——块用链而不是区间：
                // 子块节点在父块区间里也占位置，按区间走会把子块当同级语句重发
}

// 类型（S2：int / bool / str / void）。Quelmara 的 str 是
// `[len:8][bytes][NUL]`，**值 = 数据指针**（长度在 ptr-8）。
const TY_INT = 0
const TY_BOOL = 1
const TY_STR = 2
const TY_VOID = 3
// 聚合类型编码（v2.17）：0x1000+si = struct；0x100000+(count<<8)+elem = 数组
const TY_STRUCT = 0x1000
const TY_ENUM = 0x2000
const TY_VEC = 0x8000        // 0x8000+elem：vec 句柄是标量（8 字节）
const TY_MAP = 0x10000       // 0x10000+(K<<8)+V：map 句柄也是标量
const TY_SLICE = 0x20000     // 0x20000+elem：切片 = (ptr, len) 两字聚合
const TY_FN = 0x30000        // 闭包 = {code, env} 两字聚合（本版 env 恒为 0）
const TY_ARRAY = 0x100000
const MAX_FIELD = 24         // v2.31：8 → 24（qlmc 自己的 FnCtx 有 22 个字段）
const ST_STRIDE = 2 + MAX_FIELD * 2   // 每个 struct 在 stt 里占 name, nf, MAX_FIELD*(fname, fty)
const MAX_STRUCT = 64
const EN_HDR = 1200          // stt[EN_HDR] = enum 个数，enum 区从 EN_HDR+1 起
const EN_STRIDE = 26         // name, nvar, 8×(变体名, 载荷名, 载荷类型)
const MAX_VARIANT = 8
const TBL_SIZE = EN_HDR + 1 + 64 * EN_STRIDE

struct Fn {
    name: int       // 名字 id
    np: int         // 形参数（v2.29 起不限 4；第 5 个起走栈）
    pbase: int      // 形参表基址：nodes 里连续 np 条 E_FPARAM（a=名字 id, b=类型）
    ret_t: int      // 返回类型
    body: int       // 语句块链头
    nbody: int
    nlocals: int
}

// ---------------------------------------------------------------------------
// 词法
// ---------------------------------------------------------------------------

fn _is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

/// 字符 → 数字值（0..15），不是数字返回 -1
fn _digval(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }      // a..f
    if c >= 65 && c <= 70 { return c - 55 }       // A..F
    return -1
}

fn _is_alpha(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn _ty_id(w: str) -> int {
    if w == "bool" {
        return TY_BOOL
    }
    if w == "str" {
        return TY_STR
    }
    if w == "void" {
        return TY_VOID
    }
    return TY_INT
}

fn _kw_id(w: str) -> int {
    if w == "fn" { return K_FN }
    if w == "let" { return K_LET }
    if w == "mut" { return K_MUT }
    if w == "if" { return K_IF }
    if w == "else" { return K_ELSE }
    if w == "while" { return K_WHILE }
    if w == "return" { return K_RETURN }
    if w == "true" { return K_TRUE }
    if w == "false" { return K_FALSE }
    if w == "print" { return K_PRINT }
    if w == "exit" { return K_EXIT }
    if w == "module" { return K_MODULE }
    if w == "import" { return K_IMPORT }
    if w == "const" { return K_CONST }
    if w == "for" { return K_FOR }
    if w == "in" { return K_IN }
    if w == "break" { return K_BREAK }
    if w == "continue" { return K_CONTINUE }
    if w == "struct" { return K_STRUCT }
    if w == "enum" { return K_ENUM }
    if w == "match" { return K_MATCH }
    if w == "defer" { return K_DEFER }
    if w == "spawn" { return K_SPAWN }
    return 0
}

fn _tok(toks: vec[Tok], k: int, n: int, s: str, line: int) {
    toks.push(Tok { k: k, n: n, s: s, line: line })
}

/// 词法：把源码切成记号表。只认 S1 的记号集；不认识的字符直接 fail-fast
/// （静默跳过 = 后面报一堆莫名其妙的语法错）。
fn lex(src: str, toks: vec[Tok]) -> int {
    let n = len(src)
    let mut i = 0
    let mut line = 1
    while i < n {
        let c = src[i]
        // 换行 / 空白
        if c == 10 {
            line = line + 1
            i = i + 1
            continue
        }
        if c == 13 || c == 32 || c == 9 {
            i = i + 1
            continue
        }
        // 注释
        if c == 47 && i + 1 < n && src[i + 1] == 47 {
            while i < n && src[i] != 10 {
                i = i + 1
            }
            continue
        }
        // 进制字面量：0x / 0b / 0o（v2.28）。写机器码编码必须要有十六进制——
        // qlmc 自己的源码里到处是 0xFF / 0x8000 / 0b1010，自举的前提。
        if c == 48 && i + 1 < n {
            let b = src[i + 1]
            let mut base = 0
            if b == 120 || b == 88 { base = 16 }
            else if b == 98 || b == 66 { base = 2 }
            else if b == 111 || b == 79 { base = 8 }
            if base != 0 {
                let mut j = i + 2
                let mut v = 0
                let mut cnt = 0
                while j < n {
                    let d = src[j]
                    if d == 95 {
                        j = j + 1
                        continue
                    }
                    let dv = _digval(d)
                    if dv < 0 || dv >= base {
                        break
                    }
                    v = v * base + dv
                    cnt = cnt + 1
                    j = j + 1
                }
                if cnt == 0 {
                    eprint("qlmc: " + substr(src, i, 2) + " 后面缺少数字 @ line " + line.to_str())
                    exit(2)
                }
                _tok(toks, T_NUM, v, "", line)
                i = j
                continue
            }
        }
        // 数字（支持下划线分隔）
        if _is_digit(c) {
            let mut v = 0
            while i < n {
                let d = src[i]
                if d == 95 {
                    i = i + 1
                    continue
                }
                if !_is_digit(d) {
                    break
                }
                v = v * 10 + (d - 48)
                i = i + 1
            }
            _tok(toks, T_NUM, v, "", line)
            continue
        }
        // 标识符 / 关键字
        if _is_alpha(c) {
            let mut j = i
            while j < n && (_is_alpha(src[j]) || _is_digit(src[j])) {
                j = j + 1
            }
            let w = substr(src, i, j - i)
            let kw = _kw_id(w)
            if kw != 0 {
                _tok(toks, T_KW, kw, w, line)
            } else {
                _tok(toks, T_NAME, 0, w, line)
            }
            i = j
            continue
        }
        // 字符串字面量（只支持 \" \\ \n \t 四个转义）
        if c == 34 {
            let mut j = i + 1
            let mut out = ""
            while j < n && src[j] != 34 {
                if src[j] == 92 && j + 1 < n {
                    let e = src[j + 1]
                    if e == 110 {
                        out = out + chr(10)
                    } else if e == 116 {
                        out = out + chr(9)
                    } else if e == 34 {
                        out = out + chr(34)
                    } else if e == 92 {
                        out = out + chr(92)
                    } else {
                        out = out + chr(e)
                    }
                    j = j + 2
                    continue
                }
                out = out + chr(src[j])
                j = j + 1
            }
            if j >= n {
                eprint("qlmc: 字符串未闭合 @ line " + line.to_str())
                exit(2)
            }
            _tok(toks, T_STR, 0, out, line)
            i = j + 1
            continue
        }
        // 标点：三字符优先，然后两字符。
        // **一律直接比字节，不要用 substr**：substr 会分配一个新串，而这段代码
        // 对**每个字符**都跑一次——v2.28 实测，每字符一次 substr 让 96 KB 的输入
        // 从 16 ms 涨到 54 ms（3.3×），还白吃掉一堆堆。
        if c == 62 && i + 2 < n && src[i + 1] == 62 && src[i + 2] == 62 {
            _tok(toks, T_PUNCT, P_USHR, "", line)
            i = i + 3
            continue
        }
        if i + 1 < n {
            let d2 = src[i + 1]
            let mut pid = 0
            if c == 61 && d2 == 61 { pid = P_EQ }
            else if c == 33 && d2 == 61 { pid = P_NE }
            else if c == 60 && d2 == 61 { pid = P_LE }
            else if c == 62 && d2 == 61 { pid = P_GE }
            else if c == 38 && d2 == 38 { pid = P_AND }
            else if c == 124 && d2 == 124 { pid = P_OR }
            else if c == 45 && d2 == 62 { pid = P_ARROW }
            else if c == 46 && d2 == 46 { pid = P_DOTDOT }
            else if c == 61 && d2 == 62 { pid = P_FATARROW }
            else if c == 60 && d2 == 60 { pid = P_SHL }
            else if c == 62 && d2 == 62 { pid = P_SHR }
            if pid != 0 {
                _tok(toks, T_PUNCT, pid, "", line)
                i = i + 2
                continue
            }
        }
        let mut p1 = 0
        if c == 40 { p1 = P_LPAREN }
        else if c == 41 { p1 = P_RPAREN }
        else if c == 123 { p1 = P_LBRACE }
        else if c == 125 { p1 = P_RBRACE }
        else if c == 44 { p1 = P_COMMA }
        else if c == 58 { p1 = P_COLON }
        else if c == 59 { p1 = P_SEMI }
        else if c == 61 { p1 = P_ASSIGN }
        else if c == 43 { p1 = P_PLUS }
        else if c == 45 { p1 = P_MINUS }
        else if c == 42 { p1 = P_STAR }
        else if c == 47 { p1 = P_SLASH }
        else if c == 37 { p1 = P_PERCENT }
        else if c == 60 { p1 = P_LT }
        else if c == 62 { p1 = P_GT }
        else if c == 33 { p1 = P_NOT }
        else if c == 38 { p1 = P_AMP }
        else if c == 124 { p1 = P_PIPE }
        else if c == 94 { p1 = P_CARET }
        else if c == 126 { p1 = P_TILDE }
        else if c == 46 { p1 = P_DOT }
        else if c == 64 { p1 = P_AT }
        else if c == 91 { p1 = P_LBRACK }
        else if c == 93 { p1 = P_RBRACK }
        if p1 == 0 {
            eprint("qlmc: 不认识的字符 '" + chr(c) + "' @ line " + line.to_str())
            exit(2)
        }
        _tok(toks, T_PUNCT, p1, "", line)
        i = i + 1
    }
    _tok(toks, T_EOF, 0, "", line)
    return 0
}

// ---------------------------------------------------------------------------
// 语法（递归下降）
// ---------------------------------------------------------------------------

// 解析器状态：**vec 元素不能当可变单元格**（`ps[0].pos = x` 写进的是临时副本，
// 实测静默不生效 —— 第一次编译时表现成"fn 之后期望函数名"死循环）。
// 所以位置单独放一个 `vec[int]` 单元素 cell（`.set` 是写句柄，能看见），
// 其余只读的表打包成 P 按值传（vec 句柄是共享的，push 仍然可见）。
struct P {
    toks: vec[Tok]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    cname: vec[int]     // const 名字 id
    cval: vec[int]      // const 值（本版只支持整型字面量）
    stt: vec[int]       // struct 表：stt[0]=个数，每个 struct 占 ST_STRIDE 字
    fdll: vec[str]      // @ffi 的 DLL 名（与 fsym 平行）
    fsym: vec[str]      // @ffi 的符号名
}

fn _st_base(si: int) -> int {
    return 1 + si * ST_STRIDE
}

fn _struct_index(p: P, nid: int) -> int {
    let n = p.stt.get(0)
    let mut i = 0
    while i < n {
        if p.stt.get(_st_base(i)) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _pnf(p: P, si: int) -> int {
    return p.stt.get(_st_base(si) + 1)
}

fn _st_field(p: P, si: int, nid: int) -> int {
    let nf = _pnf(p, si)
    let mut i = 0
    while i < nf {
        if p.stt.get(_st_base(si) + 2 + i * 2) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_base(ei: int) -> int {
    return EN_HDR + 1 + ei * EN_STRIDE
}

fn _enum_index(p: P, nid: int) -> int {
    let n = p.stt.get(EN_HDR)
    let mut i = 0
    while i < n {
        if p.stt.get(_en_base(i)) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_nvar(p: P, ei: int) -> int {
    return p.stt.get(_en_base(ei) + 1)
}

/// 变体名 → 序号（-1 = 没有）
fn _en_variant(p: P, ei: int, nid: int) -> int {
    let n = _en_nvar(p, ei)
    let mut i = 0
    while i < n {
        if p.stt.get(_en_base(ei) + 2 + i * 3) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_vname(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3)
}

fn _en_pname(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3 + 1)
}

fn _en_ptype(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3 + 2)
}

/// 类型：`int|bool|str|StructName|[N]T`
fn _type(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_PUNCT && t.n == P_LBRACK {
        _adv(pos)
        if _is_p(p, pos, P_RBRACK) {
            // []T = 切片（视图）
            _adv(pos)
            let e = _type(p, pos)
            if e >= TY_STRUCT {
                _fail(p, pos, "本版切片元素只支持 int/bool/str")
            }
            return TY_SLICE + e
        }
        let n = _cur(p, pos)
        if n.k != T_NUM {
            _fail(p, pos, "数组长度期望整数常量")
        }
        _adv(pos)
        _eat_p(p, pos, P_RBRACK)
        let e = _type(p, pos)
        if e >= TY_STRUCT {
            _fail(p, pos, "本版数组元素只支持 int/bool/str")
        }
        return TY_ARRAY + (n.n << 8) + e
    }
    if t.k == T_NAME && t.s == "map" {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let kt = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        let vt = _type(p, pos)
        if kt >= TY_STRUCT || vt >= TY_STRUCT {
            _fail(p, pos, "本版 map 的键/值只支持 int/bool/str")
        }
        return TY_MAP + (kt << 8) + vt
    }
    if t.k == T_NAME && t.s == "vec" {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let e = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        // 聚合元素（v2.31）：struct / enum / 定长数组都行。
        // 嵌套 vec/map/切片/闭包仍然拒绝——它们的类型码会和区间撞
        // （0x8000+0x8000 = TY_MAP，见 07-gaps §7.18）。
        if e >= TY_VEC && e < TY_ARRAY {
            _fail(p, pos, "本版 vec 元素不支持嵌套 vec/map/切片/闭包（类型码撞区间，见 07-gaps §7.18）")
        }
        return TY_VEC + e
    }
    if t.k == T_NAME {
        _adv(pos)
        if t.s == "int" { return TY_INT }
        if t.s == "bool" { return TY_BOOL }
        if t.s == "str" { return TY_STR }
        let nid = _name_id(p, t.s)
        let si = _struct_index(p, nid)
        if si >= 0 {
            return TY_STRUCT + si
        }
        let ei = _enum_index(p, nid)
        if ei >= 0 {
            return TY_ENUM + ei
        }
        _fail(p, pos, "未知类型 " + t.s)
    }
    _fail(p, pos, "期望类型")
    return TY_INT
}

fn _adv(pos: vec[int]) {
    pos.set(0, pos[0] + 1)
}

fn _t(p: P, i: int) -> Tok {
    if i >= len(p.toks) {
        return Tok { k: T_EOF, n: 0, s: "", line: 0 }
    }
    return p.toks[i]
}

fn _cur(p: P, pos: vec[int]) -> Tok {
    return _t(p, pos[0])
}

fn _fail(p: P, pos: vec[int], msg: str) {
    eprint("qlmc: line " + _cur(p, pos).line.to_str() + ": " + msg)
    exit(2)
}

fn _is_p(p: P, pos: vec[int], pid: int) -> bool {
    let t = _cur(p, pos)
    return t.k == T_PUNCT && t.n == pid
}

fn _eat_p(p: P, pos: vec[int], pid: int) {
    if !_is_p(p, pos, pid) {
        _fail(p, pos, "期望标点 #" + pid.to_str())
    }
    _adv(pos)
}

fn _name_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.names) {
        if p.names[i] == s {
            return i
        }
        i = i + 1
    }
    p.names.push(s)
    return len(p.names) - 1
}

/// 查 const 表；没有返回 -1
/// 查常量在表里的**下标**（-1 = 没定义）。
/// 不要用"值 == -1"当哨兵——`const A = -1` 是合法的，那样会把 A 当成未定义。
fn _const_idx(p: P, nid: int) -> int {
    let mut i = 0
    while i < len(p.cname) {
        if p.cname[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

/// 解析期常量求值（v2.30）：把 const 初值的 AST 折成一个整数。
///
/// 认：整型字面量、**已定义**的 const、一元 `-` `~`、二元 `+ - * / % & | ^ << >> >>>`。
/// 其余一律 fail-fast——绝不"折不动就当 0"，那是静默错编。
///
/// 口径对齐 stage-0：它的 const 右值只支持 `+ - * / %`（`parse_const_value`），
/// 所以位运算这里是**超集**（qlmc 更宽松，只多不少，不影响逐字节差分）；
/// 除法/取模用 C 截断语义（与语言里的 `/` `%` 一致）。
fn _fold(p: P, pos: vec[int], nid: int) -> int {
    let nd = p.nodes.get(nid)
    if nd.op == E_NUM {
        return nd.a
    }
    if nd.op == E_VAR {
        let ci = _const_idx(p, nd.a)
        if ci < 0 {
            _fail(p, pos, "const 初值只能引用**已定义**的常量（按声明序求值）")
        }
        return p.cval.get(ci)
    }
    if nd.op == E_UN {
        let v = _fold(p, pos, nd.b)
        if nd.a == P_MINUS {
            return 0 - v
        }
        if nd.a == P_TILDE {
            return 0 - v - 1              // ~v = -v-1（64 位补码）
        }
        _fail(p, pos, "const 初值里的一元运算只支持 - 和 ~")
        return 0
    }
    if nd.op == E_BIN {
        let a = _fold(p, pos, nd.b)
        let b = _fold(p, pos, nd.c)
        if nd.a == P_PLUS { return a + b }
        if nd.a == P_MINUS { return a - b }
        if nd.a == P_STAR { return a * b }
        if nd.a == P_SLASH {
            if b == 0 {
                _fail(p, pos, "const 初值编译期除零")
            }
            return a / b
        }
        if nd.a == P_PERCENT {
            if b == 0 {
                _fail(p, pos, "const 初值编译期除零")
            }
            return a % b
        }
        if nd.a == P_AMP { return a & b }
        if nd.a == P_PIPE { return a | b }
        if nd.a == P_CARET { return a ^ b }
        if nd.a == P_SHL { return a << b }
        if nd.a == P_SHR { return a >> b }
        if nd.a == P_USHR { return a >>> b }
        _fail(p, pos, "const 初值里的二元运算只支持 + - * / % & | ^ << >> >>>")
        return 0
    }
    _fail(p, pos, "const 初值必须是编译期可求值的整型表达式")
    return 0
}

fn _str_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.strs) {
        if p.strs[i] == s {
            return i
        }
        i = i + 1
    }
    p.strs.push(s)
    return len(p.strs) - 1
}

fn _node(p: P, op: int, a: int, b: int, c: int) -> int {
    // n 默认 -1：S_IF 用它存 else 链头，0 会被当成"有 else"并去发节点 0
    p.nodes.push(Node { op: op, a: a, b: b, c: c, n: -1, slot: 0,
                       ty: TY_INT, nx: -1 })
    return len(p.nodes) - 1
}

// 表达式：优先级爬升。|| -> && -> 相等 -> 关系 -> 加减 -> 乘除模 -> 一元 -> 基本
fn _set_nx(p: P, id: int, nx: int) {
    let nd = p.nodes.get(id)
    p.nodes.set(id, Node { op: nd.op, a: nd.a, b: nd.b, c: nd.c, n: nd.n,
                           slot: nd.slot, ty: nd.ty, nx: nx })
}

/// 后缀：`.字段` 与 `[下标]`，可链式
fn _postfix(p: P, pos: vec[int], base: int) -> int {
    let mut e = base
    while true {
        if _is_p(p, pos, P_DOT) {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, ". 后期望字段名")
            }
            _adv(pos)
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                let mut arg = -1
                let mut arg2 = -1
                if !_is_p(p, pos, P_RPAREN) {
                    arg = _expr(p, pos)
                    if _is_p(p, pos, P_COMMA) {
                        _adv(pos)
                        arg2 = _expr(p, pos)
                    }
                }
                _eat_p(p, pos, P_RPAREN)
                let mid = _node(p, E_METHOD, e, _name_id(p, nm.s), arg)
                p.nodes.set(mid, Node { op: E_METHOD, a: e, b: _name_id(p, nm.s),
                                        c: arg, n: arg2, slot: 0, ty: 0, nx: -1 })
                e = mid
                continue
            }
            e = _node(p, E_FIELD, e, _name_id(p, nm.s), -1)
            continue
        }
        if _is_p(p, pos, P_LBRACK) {
            _adv(pos)
            let ix = _expr(p, pos)
            if _is_p(p, pos, P_DOTDOT) {
                _adv(pos)
                let hi = _expr(p, pos)
                _eat_p(p, pos, P_RBRACK)
                e = _node(p, E_SLICE, e, ix, hi)
                continue
            }
            _eat_p(p, pos, P_RBRACK)
            e = _node(p, E_INDEX, e, ix, -1)
            continue
        }
        break
    }
    return e
}

/// struct 字面量：`Name { f: e, g: e2 }`（字段名必须存在）
fn _struct_lit(p: P, pos: vec[int], si: int) -> int {
    _eat_p(p, pos, P_LBRACE)
    let mut first = -1
    let mut last = -1
    while !_is_p(p, pos, P_RBRACE) {
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "struct 字面量期望字段名")
        }
        _adv(pos)
        _eat_p(p, pos, P_COLON)
        let v = _expr(p, pos)
        let fi = _st_field(p, si, _name_id(p, nm.s))
        if fi < 0 {
            _fail(p, pos, "struct 没有字段 " + nm.s)
        }
        let id = _node(p, E_FINIT, fi, v, -1)
        if first < 0 {
            first = id
        } else {
            _set_nx(p, last, id)
        }
        last = id
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RBRACE)
    return _node(p, E_STRUCTLIT, si, first, -1)
}

/// match：`match e { Pat => expr ... }`；`block_mode=1` 时臂体是 `{ ... }` 块
fn _match(p: P, pos: vec[int], block_mode: int) -> int {
    _adv(pos)                       // 吃掉 match
    let scrut = _expr(p, pos)
    _eat_p(p, pos, P_LBRACE)
    let mut first = -1
    let mut last = -1
    while !_is_p(p, pos, P_RBRACE) {
        // 模式
        let mut vi = -1
        let mut bind = -1
        let t = _cur(p, pos)
        if t.k == T_NAME && t.s == "_" {
            _adv(pos)
        } else {
            let en = _cur(p, pos)
            if en.k != T_NAME {
                _fail(p, pos, "match 模式期望 枚举名.变体 或 _")
            }
            _adv(pos)
            let ei = _enum_index(p, _name_id(p, en.s))
            if ei < 0 {
                _fail(p, pos, "match 模式里的 " + en.s + " 不是 enum")
            }
            _eat_p(p, pos, P_DOT)
            let vn = _cur(p, pos)
            if vn.k != T_NAME {
                _fail(p, pos, "match 模式期望变体名")
            }
            _adv(pos)
            vi = _en_variant(p, ei, _name_id(p, vn.s))
            if vi < 0 {
                _fail(p, pos, "enum 没有变体 " + vn.s)
            }
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                let bn = _cur(p, pos)
                if bn.k == T_NAME {
                    bind = _name_id(p, bn.s)
                    _adv(pos)
                }
                _eat_p(p, pos, P_RPAREN)
            }
        }
        _eat_p(p, pos, P_FATARROW)
        let mut body = -1
        if block_mode == 1 && _is_p(p, pos, P_LBRACE) {
            body = _block(p, pos)
        } else {
            body = _expr(p, pos)
        }
        let id = _node(p, E_ARM, vi, bind, body)
        if first < 0 {
            first = id
        } else {
            _set_nx(p, last, id)
        }
        last = id
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RBRACE)
    return _node(p, E_MATCH, scrut, first, 0)
}

fn _expr(p: P, pos: vec[int]) -> int {
    return _or_e(p, pos)
}

fn _or_e(p: P, pos: vec[int]) -> int {
    let mut l = _and_e(p, pos)
    while _is_p(p, pos, P_OR) {
        _adv(pos)
        let r = _and_e(p, pos)
        l = _node(p, E_BIN, P_OR, l, r)
    }
    return l
}

fn _and_e(p: P, pos: vec[int]) -> int {
    let mut l = _bor_e(p, pos)
    while _is_p(p, pos, P_AND) {
        _adv(pos)
        let r = _bor_e(p, pos)
        l = _node(p, E_BIN, P_AND, l, r)
    }
    return l
}

// 位运算三层：| 最松，^ 居中，& 最紧（在比较之上）。照 stage-0 的定义，
// 不是 C 的顺序——`a & b == c` 在 Quelmara 里是 `a & (b == c)` 吗？不是：
// & 的右操作数是 `_eq_e`，所以 `a & b == c` 解析成 `a & (b == c)`。
fn _bor_e(p: P, pos: vec[int]) -> int {
    let mut l = _bxor_e(p, pos)
    while _is_p(p, pos, P_PIPE) {
        _adv(pos)
        let r = _bxor_e(p, pos)
        l = _node(p, E_BIN, P_PIPE, l, r)
    }
    return l
}

fn _bxor_e(p: P, pos: vec[int]) -> int {
    let mut l = _band_e(p, pos)
    while _is_p(p, pos, P_CARET) {
        _adv(pos)
        let r = _band_e(p, pos)
        l = _node(p, E_BIN, P_CARET, l, r)
    }
    return l
}

fn _band_e(p: P, pos: vec[int]) -> int {
    let mut l = _eq_e(p, pos)
    while _is_p(p, pos, P_AMP) {
        _adv(pos)
        let r = _eq_e(p, pos)
        l = _node(p, E_BIN, P_AMP, l, r)
    }
    return l
}

fn _eq_e(p: P, pos: vec[int]) -> int {
    let mut l = _rel_e(p, pos)
    while _is_p(p, pos, P_EQ) || _is_p(p, pos, P_NE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _rel_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _rel_e(p: P, pos: vec[int]) -> int {
    let mut l = _shift_e(p, pos)
    while _is_p(p, pos, P_LT) || _is_p(p, pos, P_GT) ||
          _is_p(p, pos, P_LE) || _is_p(p, pos, P_GE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _shift_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

// 移位在比较之下、加减之上（C 也是这个位置）
fn _shift_e(p: P, pos: vec[int]) -> int {
    let mut l = _add_e(p, pos)
    while _is_p(p, pos, P_SHL) || _is_p(p, pos, P_SHR) || _is_p(p, pos, P_USHR) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _add_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _add_e(p: P, pos: vec[int]) -> int {
    let mut l = _mul_e(p, pos)
    while _is_p(p, pos, P_PLUS) || _is_p(p, pos, P_MINUS) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _mul_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _mul_e(p: P, pos: vec[int]) -> int {
    let mut l = _unary(p, pos)
    while _is_p(p, pos, P_STAR) || _is_p(p, pos, P_SLASH) ||
          _is_p(p, pos, P_PERCENT) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _unary(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _unary(p: P, pos: vec[int]) -> int {
    if _is_p(p, pos, P_MINUS) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_MINUS, v, -1)
    }
    if _is_p(p, pos, P_NOT) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_NOT, v, -1)
    }
    if _is_p(p, pos, P_TILDE) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_TILDE, v, -1)
    }
    return _primary(p, pos)
}

/// 解析 `(实参列表)` 并造一个调用形状的节点（E_CALL / E_SPAWN 共用）。
/// 实参：前 4 个放 b/c/n/slot，第 5 个起挂 nx 链（v2.29 放开个数）。
fn _call_node(p: P, pos: vec[int], op: int, nid: int) -> int {
    _eat_p(p, pos, P_LPAREN)
    let args = vec[int].new(4)
    while !_is_p(p, pos, P_RPAREN) {
        args.push(_expr(p, pos))
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RPAREN)
    let mut a0 = -1
    let mut a1 = -1
    let mut a2 = -1
    let mut a3 = -1
    if len(args) > 0 { a0 = args.get(0) }
    if len(args) > 1 { a1 = args.get(1) }
    if len(args) > 2 { a2 = args.get(2) }
    if len(args) > 3 { a3 = args.get(3) }
    let cid = _node(p, op, nid, a0, a1)
    p.nodes.set(cid, Node { op: op, a: nid, b: a0, c: a1, n: a2,
                            slot: a3, ty: 0, nx: -1 })
    if len(args) > 4 {
        let mut first = -1
        let mut last = -1
        let mut i = 4
        while i < len(args) {
            let id = _node(p, E_AINIT, args.get(i), -1, -1)
            if first < 0 {
                first = id
            } else {
                _set_nx(p, last, id)
            }
            last = id
            i = i + 1
        }
        _set_nx(p, cid, first)
    }
    return cid
}

fn _primary(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_NUM {
        _adv(pos)
        return _postfix(p, pos, _node(p, E_NUM, t.n, -1, -1))
    }
    if t.k == T_STR {
        _adv(pos)
        return _postfix(p, pos, _node(p, E_STR, _str_id(p, t.s), -1, -1))
    }
    if t.k == T_KW && (t.n == K_TRUE || t.n == K_FALSE) {
        _adv(pos)
        let mut v = 0
        if t.n == K_TRUE {
            v = 1
        }
        return _postfix(p, pos, _node(p, E_NUM, v, -1, -1))
    }
    if t.k == T_KW && t.n == K_SPAWN {
        // spawn f(args) -> 任务句柄（v2.32）。只认"函数名 + 实参列表"，
        // 不做 stage-0 那个 `spawn f(x).join()` 脱糖（用 join(spawn f(x)) 即可）。
        _adv(pos)
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "spawn 后面必须是函数调用")
        }
        _adv(pos)
        if !_is_p(p, pos, P_LPAREN) {
            _fail(p, pos, "spawn 后面必须是函数调用")
        }
        let sid = _call_node(p, pos, E_SPAWN, _name_id(p, nm.s))
        return _postfix(p, pos, sid)
    }
    if t.k == T_KW && t.n == K_FN {
        // 闭包字面量：合成一个顶层函数，表达式值 = {code, 0}
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let pbase = len(p.nodes)
        let mut np = 0
        while !_is_p(p, pos, P_RPAREN) {
            let pn = _cur(p, pos)
            if pn.k != T_NAME {
                _fail(p, pos, "闭包形参期望名字")
            }
            _adv(pos)
            let mut pt = TY_INT
            if _is_p(p, pos, P_COLON) {
                _adv(pos)
                pt = _type(p, pos)
            }
            if pt >= TY_STRUCT {
                _fail(p, pos, "闭包形参只支持 int/bool/str")
            }
            _node(p, E_FPARAM, _name_id(p, pn.s), pt, -1)
            np = np + 1
            if _is_p(p, pos, P_COMMA) {
                _adv(pos)
            }
        }
        _eat_p(p, pos, P_RPAREN)
        let mut rt = TY_VOID
        if _is_p(p, pos, P_ARROW) {
            _adv(pos)
            rt = _type(p, pos)
        }
        let lname = _name_id(p, "__lambda_" + len(p.fns).to_str())
        let body = _block(p, pos)
        let fi = len(p.fns)
        p.fns.push(Fn { name: lname, np: np, pbase: pbase,
                        ret_t: rt, body: body, nbody: 0, nlocals: -1 })
        return _postfix(p, pos, _node(p, E_CLOSURE, fi, -1, -1))
    }
    if t.k == T_KW && t.n == K_MATCH {
        return _postfix(p, pos, _match(p, pos, 0))
    }
    if t.k == T_PUNCT && t.n == P_LBRACK {
        // 数组字面量 [e1, e2, ...]
        _adv(pos)
        let mut first = -1
        let mut last = -1
        let mut cnt = 0
        while !_is_p(p, pos, P_RBRACK) {
            let v = _expr(p, pos)
            let id = _node(p, E_AINIT, v, -1, -1)
            if first < 0 {
                first = id
            } else {
                _set_nx(p, last, id)
            }
            last = id
            cnt = cnt + 1
            if _is_p(p, pos, P_COMMA) {
                _adv(pos)
            }
        }
        _eat_p(p, pos, P_RBRACK)
        return _postfix(p, pos, _node(p, E_ARRLIT, first, cnt, -1))
    }
    if t.k == T_PUNCT && t.n == P_LPAREN {
        _adv(pos)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _postfix(p, pos, v)
    }
    if t.k == T_NAME && t.s == "map" && _t(p, pos[0] + 1).k == T_PUNCT &&
       _t(p, pos[0] + 1).n == P_LBRACK {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let kt = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        let vt = _type(p, pos)
        _eat_p(p, pos, P_DOT)
        let nm = _cur(p, pos)
        if nm.k != T_NAME || nm.s != "new" {
            _fail(p, pos, "map[K]V 之后只支持 .new(n)")
        }
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let cnt = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        let id = _node(p, E_MAPNEW, kt, cnt, vt)
        return _postfix(p, pos, id)
    }
    if t.k == T_NAME && t.s == "vec" && _t(p, pos[0] + 1).k == T_PUNCT &&
       _t(p, pos[0] + 1).n == P_LBRACK {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let et = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        _eat_p(p, pos, P_DOT)
        let nm = _cur(p, pos)
        if nm.k != T_NAME || nm.s != "new" {
            _fail(p, pos, "vec[T] 之后只支持 .new(n)")
        }
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let cnt = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _postfix(p, pos, _node(p, E_VECNEW, et, cnt, -1))
    }
    if t.k == T_NAME {
        _adv(pos)
        let nid = _name_id(p, t.s)
        let ei = _enum_index(p, nid)
        if ei >= 0 && _is_p(p, pos, P_DOT) {
            _adv(pos)
            let vn = _cur(p, pos)
            if vn.k != T_NAME {
                _fail(p, pos, "枚举变体名期望标识符")
            }
            _adv(pos)
            let vi = _en_variant(p, ei, _name_id(p, vn.s))
            if vi < 0 {
                _fail(p, pos, "enum 没有变体 " + vn.s)
            }
            let mut pl = -1
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                // 载荷可写 `变体(值)` 或 `变体(名: 值)`
                if _cur(p, pos).k == T_NAME && _t(p, pos[0] + 1).k == T_PUNCT &&
                   _t(p, pos[0] + 1).n == P_COLON {
                    _adv(pos)
                    _adv(pos)
                }
                pl = _expr(p, pos)
                _eat_p(p, pos, P_RPAREN)
            }
            return _postfix(p, pos, _node(p, E_ENUMCTOR, ei, vi, pl))
        }
        if _is_p(p, pos, P_LBRACE) {
            let si = _struct_index(p, nid)
            if si >= 0 {
                return _postfix(p, pos, _struct_lit(p, pos, si))
            }
        }
        if !_is_p(p, pos, P_LPAREN) {
            let ci = _const_idx(p, nid)
            if ci >= 0 {
                return _postfix(p, pos, _node(p, E_NUM, p.cval.get(ci), -1, -1))
            }
        }
        if _is_p(p, pos, P_LPAREN) {
            return _postfix(p, pos, _call_node(p, pos, E_CALL, nid))
        }
        return _postfix(p, pos, _node(p, E_VAR, nid, -1, -1))
    }
    _fail(p, pos, "期望表达式")
    return -1
}

fn _stmt(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_KW && t.n == K_LET {
        _adv(pos)
        let mut m = 0
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_MUT {
            m = 1
            _adv(pos)
        }
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "let 后期望变量名")
        }
        _adv(pos)
        let nid = _name_id(p, nm.s)
        let mut ty = TY_INT
        let mut has = 0
        if _is_p(p, pos, P_COLON) {
            _adv(pos)
            ty = _type(p, pos)
            has = 1
        }
        let mut init = -1
        if _is_p(p, pos, P_ASSIGN) {
            _adv(pos)
            init = _expr(p, pos)
        }
        let id = _node(p, S_LET, nid, init, -1)
        p.nodes.set(id, Node { op: S_LET, a: nid, b: init, c: -1, n: m,
                               slot: has, ty: ty, nx: -1 })
        return id
    }
    if t.k == T_KW && t.n == K_IF {
        _adv(pos)
        let cond = _expr(p, pos)
        let th = _block(p, pos)
        let id = _node(p, S_IF, cond, th, -1)
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_ELSE {
            _adv(pos)
            let mut eh = -1
            if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_IF {
                // `else if`（v2.31）：else 体就是那一条 if 语句（单节点链）。
                // 之前只认 `else {`，而 qlmc 自己的源码里全是 `else if`——
                // 自举时第一个撞上的语法就是它。
                eh = _stmt(p, pos)
            } else {
                eh = _block(p, pos)
            }
            p.nodes.set(id, Node { op: S_IF, a: cond, b: th, c: -1,
                                   n: eh, slot: 0, ty: TY_INT, nx: -1 })
        }
        return id
    }
    if t.k == T_KW && t.n == K_DEFER {
        _adv(pos)
        let inner = _stmt(p, pos)
        let inz = p.nodes.get(inner)
        if inz.op != S_EXPR && inz.op != S_ASSIGN && inz.op != S_ASG_FIELD &&
           inz.op != S_ASG_INDEX && inz.op != S_PRINT {
            _fail(p, pos, "defer 只支持表达式语句或赋值")
        }
        return _node(p, S_DEFER, inner, -1, -1)
    }
    if t.k == T_KW && t.n == K_MATCH {
        let m = _match(p, pos, 1)
        let nd = p.nodes.get(m)
        p.nodes.set(m, Node { op: S_MATCH, a: nd.a, b: nd.b, c: 0, n: 0,
                              slot: 0, ty: TY_INT, nx: -1 })
        return m
    }
    if t.k == T_KW && t.n == K_FOR {
        _adv(pos)
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "for 后期望循环变量名")
        }
        _adv(pos)
        if !(_cur(p, pos).k == T_KW && _cur(p, pos).n == K_IN) {
            _fail(p, pos, "for 变量后期望 in")
        }
        _adv(pos)
        let lo = _expr(p, pos)
        _eat_p(p, pos, P_DOTDOT)
        let hi = _expr(p, pos)
        let body = _block(p, pos)
        let id = _node(p, S_FOR, _name_id(p, nm.s), lo, hi)
        p.nodes.set(id, Node { op: S_FOR, a: _name_id(p, nm.s), b: lo, c: hi,
                               n: body, slot: 0, ty: TY_INT, nx: -1 })
        return id
    }
    if t.k == T_KW && t.n == K_BREAK {
        _adv(pos)
        return _node(p, S_BREAK, -1, -1, -1)
    }
    if t.k == T_KW && t.n == K_CONTINUE {
        _adv(pos)
        return _node(p, S_CONTINUE, -1, -1, -1)
    }
    if t.k == T_KW && t.n == K_WHILE {
        _adv(pos)
        let cond = _expr(p, pos)
        let bh = _block(p, pos)
        return _node(p, S_WHILE, cond, bh, -1)
    }
    if t.k == T_KW && t.n == K_RETURN {
        _adv(pos)
        let mut v = -1
        if !_is_p(p, pos, P_RBRACE) {
            v = _expr(p, pos)
        }
        return _node(p, S_RETURN, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_PRINT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_PRINT, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_EXIT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_EXIT, v, -1, -1)
    }
    // 表达式语句，或 `左值 = 表达式`（左值可以是 变量 / 字段 / 下标）
    let v = _expr(p, pos)
    if _is_p(p, pos, P_ASSIGN) {
        _adv(pos)
        let rhs = _expr(p, pos)
        let lv = p.nodes.get(v)
        if lv.op == E_VAR {
            return _node(p, S_ASSIGN, lv.a, rhs, -1)
        }
        if lv.op == E_FIELD {
            return _node(p, S_ASG_FIELD, lv.a, lv.b, rhs)
        }
        if lv.op == E_INDEX {
            return _node(p, S_ASG_INDEX, lv.a, lv.b, rhs)
        }
        _fail(p, pos, "赋值左边不是变量 / 字段 / 下标")
    }
    return _node(p, S_EXPR, v, -1, -1)
}

/// 块：解析成一条 nx 链，返回链头（空块返回 -1）
fn _block(p: P, pos: vec[int]) -> int {
    _eat_p(p, pos, P_LBRACE)
    let mut head = -1
    let mut prev = -1
    while !_is_p(p, pos, P_RBRACE) {
        if _cur(p, pos).k == T_EOF {
            _fail(p, pos, "块未闭合")
        }
        let id = _stmt(p, pos)
        if head < 0 {
            head = id
        } else {
            let pn = p.nodes[prev]
            p.nodes.set(prev, Node { op: pn.op, a: pn.a, b: pn.b, c: pn.c,
                                     n: pn.n, slot: pn.slot, ty: pn.ty, nx: id })
        }
        prev = id
    }
    _eat_p(p, pos, P_RBRACE)
    return head
}

fn _fn(p: P, pos: vec[int], ffi_idx: int) {
    _adv(pos)                                // fn
    let nm = _cur(p, pos)
    if nm.k != T_NAME {
        _fail(p, pos, "fn 后期望函数名")
    }
    _adv(pos)
    let nid = _name_id(p, nm.s)
    _eat_p(p, pos, P_LPAREN)
    // 形参表：每条形参追加一条 E_FPARAM 记录（a=名字 id，b=类型），
    // Fn.pbase 记住基址。**不再限 4 个**——第 5 个起走栈（v2.29）。
    let pbase = len(p.nodes)
    let mut np = 0
    while !_is_p(p, pos, P_RPAREN) {
        let pn = _cur(p, pos)
        if pn.k != T_NAME {
            _fail(p, pos, "形参期望名字")
        }
        _adv(pos)
        let mut pt = TY_INT
        if _is_p(p, pos, P_COLON) {
            _adv(pos)
            pt = _type(p, pos)          // 支持 int/bool/str/struct/enum/[N]T
        }
        _node(p, E_FPARAM, _name_id(p, pn.s), pt, -1)
        np = np + 1
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RPAREN)
    let mut rt = TY_VOID
    if _is_p(p, pos, P_ARROW) {
        _adv(pos)
        rt = _type(p, pos)
    }
    let mut fi = 0
    while fi < len(p.fns) {
        if p.fns.get(fi).name == nid {
            _fail(p, pos, "函数重复定义 " + nm.s)
        }
        fi = fi + 1
    }
    let mut body = -1
    let mut nbody = 0
    if ffi_idx < 0 {
        body = _block(p, pos)
        nbody = 0
    }
    p.fns.push(Fn { name: nid, np: np, pbase: pbase, ret_t: rt,
                    body: body, nbody: 0, nlocals: ffi_idx })
}

/// 顶层：`module x` 忽略；`import` 本版不支持；`fn` 逐个解析。
fn parse(toks: vec[Tok], nodes: vec[Node], names: vec[str], strs: vec[str],
         fns: vec[Fn], cname: vec[int], cval: vec[int], stt: vec[int],
         imports: vec[str], fdll: vec[str], fsym: vec[str]) -> int {
    let p = P { toks: toks, nodes: nodes, names: names, strs: strs, fns: fns,
                cname: cname, cval: cval, stt: stt, fdll: fdll, fsym: fsym }
    let pos = vec[int].new(1)
    pos.push(0)
    while _cur(p, pos).k != T_EOF {
        let t = _cur(p, pos)
        if t.k == T_NAME && t.s == "pub" {
            _adv(pos)          // 本版不做可见性检查，pub 当无操作
            continue
        }
        if t.k == T_KW && t.n == K_MODULE {
            while _cur(p, pos).k != T_EOF && _cur(p, pos).line == t.line {
                _adv(pos)
            }
            continue
        }
        if t.k == T_KW && t.n == K_IMPORT {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "import 后期望模块名")
            }
            _adv(pos)
            let mut path = nm.s
            while _is_p(p, pos, P_DOT) {
                _adv(pos)
                let seg = _cur(p, pos)
                if seg.k != T_NAME {
                    _fail(p, pos, "import 路径期望标识符")
                }
                _adv(pos)
                path = path + "/" + seg.s
            }
            // 版本要求（`import foo ">=1.2"`）暂不校验，跳过
            if _cur(p, pos).k == T_STR {
                _adv(pos)
            }
            imports.push(path)
            continue
        }
        if t.k == T_KW && t.n == K_STRUCT {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "struct 后期望名字")
            }
            _adv(pos)
            let nid = _name_id(p, nm.s)
            if _struct_index(p, nid) >= 0 {
                _fail(p, pos, "struct 重复声明 " + nm.s)
            }
            let nst = p.stt.get(0)
            // 先把表扩到 nst+1 个槽位
            let mut k = 0
            while k < ST_STRIDE {
                p.stt.push(0)
                k = k + 1
            }
            p.stt.set(0, nst + 1)
            p.stt.set(_st_base(nst), nid)
            _eat_p(p, pos, P_LBRACE)
            let mut nf = 0
            while !_is_p(p, pos, P_RBRACE) {
                let fnm = _cur(p, pos)
                if fnm.k != T_NAME {
                    _fail(p, pos, "struct 字段名期望标识符")
                }
                _adv(pos)
                _eat_p(p, pos, P_COLON)
                let fty = _type(p, pos)
                // 字段必须是**标量**（8 字节）：int/bool/str + vec/map 句柄都行，
                // 聚合字段（struct/enum/数组/切片/闭包）还没有递归布局。
                // 之前按 `fty >= TY_STRUCT` 拦，把 vec 句柄也误伤了——
                // 而 qlmc 自己的 `struct P { toks: vec[Tok] ... }` 正是这个形状（v2.31）。
                if _ty_is_agg(fty) {
                    _fail(p, pos, "本版 struct 字段不支持聚合类型（struct/enum/数组/切片/闭包）")
                }
                if nf >= MAX_FIELD {
                    _fail(p, pos, "struct 字段超过上限（MAX_FIELD）")
                }
                p.stt.set(_st_base(nst) + 2 + nf * 2, _name_id(p, fnm.s))
                p.stt.set(_st_base(nst) + 2 + nf * 2 + 1, fty)
                nf = nf + 1
                if _is_p(p, pos, P_COMMA) {
                    _adv(pos)
                }
            }
            _eat_p(p, pos, P_RBRACE)
            p.stt.set(_st_base(nst) + 1, nf)
            continue
        }
        if t.k == T_KW && t.n == K_ENUM {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "enum 后期望名字")
            }
            _adv(pos)
            let nid = _name_id(p, nm.s)
            if _enum_index(p, nid) >= 0 {
                _fail(p, pos, "enum 重复声明 " + nm.s)
            }
            if p.stt.get(EN_HDR) >= 64 {
                _fail(p, pos, "enum 超过 64 个")
            }
            let ei = p.stt.get(EN_HDR)
            p.stt.set(EN_HDR, ei + 1)
            let base = _en_base(ei)
            p.stt.set(base, nid)
            _eat_p(p, pos, P_LBRACE)
            let mut nv = 0
            while !_is_p(p, pos, P_RBRACE) {
                let vn = _cur(p, pos)
                if vn.k != T_NAME {
                    _fail(p, pos, "enum 变体名期望标识符")
                }
                _adv(pos)
                if nv >= MAX_VARIANT {
                    _fail(p, pos, "enum 变体超过 8 个")
                }
                let vbase = base + 2 + nv * 3
                p.stt.set(vbase, _name_id(p, vn.s))
                p.stt.set(vbase + 1, -1)
                p.stt.set(vbase + 2, -1)
                if _is_p(p, pos, P_LPAREN) {
                    _adv(pos)
                    let pn = _cur(p, pos)
                    if pn.k != T_NAME {
                        _fail(p, pos, "载荷字段名期望标识符")
                    }
                    _adv(pos)
                    _eat_p(p, pos, P_COLON)
                    let pt = _type(p, pos)
                    if pt >= TY_STRUCT {
                        _fail(p, pos, "本版 enum 载荷只支持 int/bool/str")
                    }
                    p.stt.set(vbase + 1, _name_id(p, pn.s))
                    p.stt.set(vbase + 2, pt)
                    _eat_p(p, pos, P_RPAREN)
                }
                nv = nv + 1
                if _is_p(p, pos, P_COMMA) {
                    _adv(pos)
                }
            }
            _eat_p(p, pos, P_RBRACE)
            p.stt.set(base + 1, nv)
            continue
        }
        if t.k == T_KW && t.n == K_FN {
            _fn(p, pos, -1)
            continue
        }
        if t.k == T_PUNCT && t.n == P_AT {
            _adv(pos)
            let kw = _cur(p, pos)
            if kw.k != T_NAME || kw.s != "ffi" {
                _fail(p, pos, "只支持 @ffi(\"dll\", \"Sym\")")
            }
            _adv(pos)
            _eat_p(p, pos, P_LPAREN)
            let ds = _cur(p, pos)
            if ds.k != T_STR {
                _fail(p, pos, "@ffi 第一个实参是 DLL 名字符串")
            }
            _adv(pos)
            _eat_p(p, pos, P_COMMA)
            let ss = _cur(p, pos)
            if ss.k != T_STR {
                _fail(p, pos, "@ffi 第二个实参是符号名字符串")
            }
            _adv(pos)
            _eat_p(p, pos, P_RPAREN)
            if !(_cur(p, pos).k == T_KW && _cur(p, pos).n == K_FN) {
                _fail(p, pos, "@ffi 后面必须紧跟 fn 声明")
            }
            let idx = len(p.fdll)
            p.fdll.push(ds.s)
            p.fsym.push(ss.s)
            _fn(p, pos, idx)
            continue
        }
        if t.k == T_KW && t.n == K_CONST {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "const 后期望名字")
            }
            _adv(pos)
            if _is_p(p, pos, P_COLON) {
                _adv(pos)
                _adv(pos)                    // 类型标注（只允许整型）
            }
            _eat_p(p, pos, P_ASSIGN)
            // 初值可以是**常量表达式**（v2.30）：先用正常表达式解析（优先级自然
            // 与语言一致），再用 `_fold` 在解析期折成一个整数；折不动的 fail-fast。
            let e = _expr(p, pos)
            let cv = _fold(p, pos, e)
            if _is_p(p, pos, P_SEMI) {
                _adv(pos)
            }
            p.cname.push(_name_id(p, nm.s))
            p.cval.push(cv)
            continue
        }
        _fail(p, pos, "顶层期望 fn / const / struct")
    }
    return len(p.fns)
}

// ---------------------------------------------------------------------------
// IR
//
// 本版不落显式 IR 表：`gen_*` 直接从 AST 发字节。为什么——S1 的表达式没有
// 需要重排的优化（没有 CSE/调度/内联），三地址 IR 只是多一层搬运；等做
// 常量折叠与寄存器分配时再引入（`07-gaps.md` §3 记了这条）。
// **等价于 IR 的抽象在这里**：每个表达式的值在 RAX，二元运算的右操作数先
// 落帧槽（`scratch`），左操作数算完再 `mov rcx, [scratch]` —— 这就是
// "全溢出 + RAX/RCX 双累加器"的分配策略。
// ---------------------------------------------------------------------------

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

// PE 常量（与 qlm_pe.py 同源，改一处必须改另一处）
const IMAGE_BASE = 0x140000000
const TEXT_RVA = 0x1000
const SECT_ALIGN = 0x1000
const FILE_ALIGN = 0x200
const HDR_DOS = 0x80
const OPT_SIZE = 240
const SCN_CODE = 0x60000020
const SCN_RDATA = 0xC0000040

// 导入符号（顺序 = IAT 槽顺序，别乱动）
const I_GETSTD = 0
const I_WRITE = 1
const I_EXIT = 2
const I_WSPRINTF = 3
// v2.32 spawn/join 要用的三个 kernel32 符号（线程）
const I_CREATE = 4
const I_WAIT = 5
const I_CLOSE = 6
const I_USER = 7        // 用户 @ffi 符号从第 7 个 IAT 槽开始

// ---------------------------------------------------------------------------
// 字节发射
// ---------------------------------------------------------------------------

fn _b(code: vec[int], v: int) {
    code.push(v & 0xFF)
}

fn _w32(code: vec[int], v: int) {
    _b(code, v)
    _b(code, v >> 8)
    _b(code, v >> 16)
    _b(code, v >> 24)
}

fn _w64(code: vec[int], v: int) {
    _w32(code, v)
    _w32(code, v >> 32)
}

fn _rex(code: vec[int], w: int, r: int, b: int) {
    _b(code, 0x40 | (w << 3) | (r << 2) | b)
}

// REX.W + REX.R(reg) + REX.B(rm) 组合：reg/rm 是 0-15
fn _rex2(code: vec[int], w: int, reg: int, rm: int) {
    let r = 0
    if reg >= 8 {
        r = 1
    }
    let b = 0
    if rm >= 8 {
        b = 1
    }
    _rex(code, w, r, b)
}

fn _modrm(code: vec[int], mod: int, reg: int, rm: int) {
    _b(code, (mod << 6) | ((reg & 7) << 3) | (rm & 7))
}

// mov dst, imm64
fn _mov_imm(code: vec[int], dst: int, v: int) {
    _rex2(code, 1, 0, dst)
    _b(code, 0xB8 + (dst & 7))
    _w64(code, v)
}

// mov dst, src（寄存器到寄存器）
fn _mov_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, 0x89)
    _modrm(code, 3, src, dst)
}

// mov dst, [base+disp32]
fn _mov_load(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm_mem(code, 2, dst, base)
    _w32(code, disp)
}

// mov [base+disp32], src
fn _mov_store(code: vec[int], base: int, disp: int, src: int) {
    _rex2(code, 1, src, base)
    _b(code, 0x89)
    _modrm_mem(code, 2, src, base)
    _w32(code, disp)
}

/// `mov [rsp + disp], src`——RSP 作基址必须带 SIB 字节（不能用 _mov_store）
fn _mov_store_rsp(code: vec[int], disp: int, src: int) {
    _rex2(code, 1, src, RSP)
    _b(code, 0x89)
    _modrm_sib(code, 2, src)
    _w32(code, disp)
}

// [rsp+disp32] 的 modrm 带 SIB
fn _modrm_sib(code: vec[int], mod: int, reg: int) {
    _modrm(code, mod, reg, 4)
    _b(code, 0x24)
}

fn _mov_rsp_store(code: vec[int], disp: int, src: int) {
    _rex2(code, 1, src, 4)
    _b(code, 0x89)
    _modrm_sib(code, 2, src)
    _w32(code, disp)
}

fn _mov_rsp_load(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8B)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

fn _mov_rsp_imm32(code: vec[int], disp: int, v: int) {
    _rex2(code, 1, 0, 4)
    _b(code, 0xC7)
    _modrm_sib(code, 2, 0)
    _w32(code, disp)
    _w32(code, v)
}

fn _lea_rsp(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8D)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

// lea dst, [rip+disp32]：disp 稍后回填
fn _lea_rip(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 0)
    _b(code, 0x8D)
    _modrm(code, 0, dst, 5)
    _w32(code, disp)
}

// alu dst, src：opcode 见 add=01 sub=29 and=21 or=09 xor=31 cmp=39
fn _alu_rr(code: vec[int], op: int, dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, op)
    _modrm(code, 3, src, dst)
}

fn _imul_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, dst, src)
    _b(code, 0x0F)
    _b(code, 0xAF)
    _modrm(code, 3, dst, src)
}

fn _neg(code: vec[int], dst: int) {
    _rex2(code, 1, 0, dst)
    _b(code, 0xF7)
    _modrm(code, 3, 3, dst)
}

fn _cqo(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x99)
}

fn _idiv(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0xF7)
    _modrm(code, 3, 7, reg)
}

fn _test_rr(code: vec[int], a: int, b: int) {
    _rex2(code, 1, b, a)
    _b(code, 0x85)
    _modrm(code, 3, b, a)
}

fn _cmp_imm0(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0x83)
    _modrm(code, 3, 7, reg)
    _b(code, 0)
}

// setcc al：cc 见 e=94 ne=95 l=9C ge=9D le=9E g=9F
fn _setcc_al(code: vec[int], cc: int) {
    _b(code, 0x0F)
    _b(code, cc)
    _b(code, 0xC0)
}

fn _movzx_rax_al(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0xC0)
}

fn _push_rbp(code: vec[int]) {
    _b(code, 0x55)
}

fn _pop_rbp(code: vec[int]) {
    _b(code, 0x5D)
}

fn _mov_rbp_rsp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
}

fn _mov_rsp_rbp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xEC)
}

fn _sub_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xEC)
    _w32(code, n)
}

fn _add_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xC4)
    _w32(code, n)
}

fn _ret(code: vec[int]) {
    _b(code, 0xC3)
}

fn _jmp(code: vec[int]) -> int {
    _b(code, 0xE9)
    let p = len(code)
    _w32(code, 0)
    return p
}

// cc：e=84 ne=85 l=8C ge=8D le=8E g=8F
fn _jcc(code: vec[int], cc: int) -> int {
    _b(code, 0x0F)
    _b(code, cc)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _call_rel(code: vec[int]) -> int {
    _b(code, 0xE8)
    let p = len(code)
    _w32(code, 0)
    return p
}

// call [rip+disp32]
fn _call_rip(code: vec[int]) -> int {
    _b(code, 0xFF)
    _b(code, 0x15)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _patch32(code: vec[int], at: int, v: int) {
    code.set(at, v & 0xFF)
    code.set(at + 1, (v >> 8) & 0xFF)
    code.set(at + 2, (v >> 16) & 0xFF)
    code.set(at + 3, (v >> 24) & 0xFF)
}

fn _align_up(v: int, a: int) -> int {
    return (v + a - 1) / a * a
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 后端（v2.16 重写）
//
// 流水线（与 v2.15 的"直接从 AST 发字节"完全不同）：
//
//   AST ──lower──▶ IR ──线性扫描──▶ 带位置的 IR ──emit──▶ 机器码
//
// 三条设计决定，改之前先读：
//
// 1) **有真 IR**。三地址指令（`Ir`），值用虚拟寄存器编号，标签用 id。
//    好处不是"更漂亮"，而是分配与发射解耦：分配只看活跃区间，发射只看位置，
//    谁也不认识 AST。v2.15 里"右操作数先落帧槽"这种形状是被 RAX/RCX 双累加器
//    逼出来的，现在没有了。
//
// 2) **两段式寄存器分配**（不是全溢出）：
//      · 变量（`let` / 形参）：函数内**固定**一个 callee-saved 寄存器
//        （RBX / R12-R15），满了落帧槽。固定分配天然跨循环、跨调用成立，
//        不需要 SSA 与 phi。
//      · 临时值（表达式中间结果）：按活跃区间做**线性扫描**，池是
//        R8/R9/R10/R11（都是 caller-saved）。区间**跨调用**的临时值直接落
//        帧槽——因为调用会清 caller-saved，这样就不必在调用点插溢出代码。
//    发射序列自己只用 RAX/RCX/RDX 当暂存，永不被分配，所以不存在"分配器
//    挑了一个发射器要用的寄存器"这类隐蔽冲突。
//
// 3) **按函数并行**（`_compile_range`）。每个工作线程拿到 arb 里自己那段，
//    把函数编成字节写进去，主线程按函数序拼装 + 统一回填。函数之间没有共享
//    可变状态，所以不需要任何锁；拼装顺序固定，所以**线程数不影响产物字节**
//    （`-j1` 与 `-j4` 的 exe 逐字节相同，测试钉住这条）。
// ---------------------------------------------------------------------------

// IR 操作码
const OP_CONST = 1     // dst = imm
const OP_MOV = 2       // dst = a
const OP_ADD = 3       // dst = a + b
const OP_SUB = 4
const OP_MUL = 5
const OP_DIV = 6
const OP_MOD = 7
const OP_NEG = 8       // dst = -a
const OP_NOT = 9       // dst = (a == 0) ? 1 : 0（int 口径）
const OP_NZ = 10       // dst = (a != 0) ? 1 : 0
const OP_CMP = 11      // dst = a <cc> b ? 1 : 0；imm = cc（setcc 机器码）
const OP_LAB = 12      // imm = 标签
const OP_JMP = 13      // goto imm
const OP_JZ = 14       // if a == 0 goto imm
const OP_JNZ = 15      // if a != 0 goto imm
const OP_ARG = 16      // 把 a 搬到第 imm 个实参寄存器（0=RCX 1=RDX）
const OP_CALL = 17     // dst = call 函数 imm
const OP_CALLRT = 18   // dst = call 运行库例程 imm
const OP_RET = 19      // return a（a == 0 → return 0）
const OP_PRINT = 20    // print a；imm = TY_*
const OP_EXIT = 21     // exit(a)
const OP_LEA = 22      // dst = 字符串 imm 的地址（rip 相对）
const OP_LEN = 23      // dst = [a - 8]（str 长度前缀）
const OP_PARAM = 24    // dst = 第 imm 个入参寄存器（0=RCX 1=RDX 2=R8 3=R9）
const OP_JCMP = 25     // cmp a, b；按 dst(=cc) 跳到 imm
const OP_ADDRV = 26    // dst = &帧槽 imm（聚合变量的区域基址）
const OP_ADDRF = 27    // dst = a + imm（字段地址）
const OP_ADDRX = 28    // dst = a + b*8（数组元素地址）
const OP_LOAD = 29     // dst = [a]
const OP_STORE = 30    // [a] = b
const OP_COPY = 31     // memcpy(a, b, imm)
const OP_ZERO = 32     // zero(a, imm)
const OP_RETAGG = 33   // 聚合返回：memcpy([sret], a, imm)；rax = sret
const OP_RETSRET = 34  // 兜底返回：只把 rax = sret
const OP_ZERON = 35    // zero(a, b)：按 b 给的**字节数**清零（动态长度）
const OP_CALLIAT = 36  // dst = call [rip+iat[imm]]（@ffi）
const OP_LEAFN = 37    // dst = &函数 imm（取函数地址，给闭包用）
const OP_CALLR = 38    // dst = call [a]（a = 闭包值地址，间接调用）
// memcpy(a, b, dst)：**运行时**字节数版本。Ir 只有 4 个操作数槽，只好把
// 字节数塞进 dst（dst 这个字段对 memcpy 没有别的含义）。vec 扩容要用。
const OP_MEMCPYN = 39
// 位运算与移位（v2.28）
const OP_AND = 40      // dst = a & b
const OP_OR = 41       // dst = a | b
const OP_XOR = 42      // dst = a ^ b
const OP_SHL = 43      // dst = a << b
const OP_SAR = 44      // dst = a >> b（算术右移，符号位扩展）
const OP_SHR = 45      // dst = a >>> b（逻辑右移，高位补 0）
const OP_BNOT = 46     // dst = ~a
// 栈参数（v2.29）：第 5 个起走栈
const OP_PARAMSTK = 47 // dst = [rbp + imm]（被调方取栈上的形参）
const OP_STKALLOC = 48 // sub rsp, imm（调用点开 shadow space + 栈实参）
const OP_STKARG = 49   // [rsp + imm] = a（写栈实参）
const OP_STKFREE = 50  // add rsp, imm
// dst = a + b*imm（imm = 元素字节步长）。vec 元素是聚合时步长不是 8，
// OP_ADDRX 的 `shl 3` 就不够用了（v2.31）。
const OP_ADDRXN = 51
// dst = &运行库例程 imm（FK_RT）。spawn 要把线程入口地址交给 CreateThread
const OP_RTADDR = 52

struct Ir {
    op: int
    dst: int
    a: int
    b: int
    imm: int
}

struct Fix {
    pos: int        // 待回填的 disp32 位置（函数内相对偏移）
    id: int         // 目标 id（函数 / 标签 / 字符串 / 导入符号 / bss / 运行库）
    kind: int
}

const FK_FN = 0
const FK_LAB = 1
const FK_STR = 2
const FK_IAT = 3
const FK_BSS = 4
const FK_RT = 5

// 顺序段（入口 + 运行库 + 字符串表）用的上下文。
// 函数体不走这里——它由工作线程各自的 `FnCtx` 承担。
struct Ctx {
    code: vec[int]
    labs: vec[int]
    fixes: vec[Fix]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    fnpos: vec[int]
    rdata: vec[int]
    strpos: vec[int]
    str_true: int
    str_false: int
    nl: vec[int]
    rt_pos: vec[int]
    fdll: vec[str]      // @ffi 的 DLL 名（与 fsym 平行）
    fsym: vec[str]      // @ffi 的符号名
}

// 单个函数的编译状态。结构体按值传，**标量字段改了不会回传**，
// 所以计数器一律放单元素 vec（`st` / `nv` / `ep`）。
struct FnCtx {
    code: vec[int]
    labs: vec[int]
    fixes: vec[Fix]
    ir: vec[Ir]
    nodes: vec[Node]
    names: vec[str]
    fns: vec[Fn]
    vloc: vec[int]      // vreg → 位置：>0 = 寄存器+1，<0 = -(槽号+1)，0 = 未分配
    vty: vec[int]       // vreg → TY_*
    vstart: vec[int]    // vreg → 起始 IR 下标
    vend: vec[int]      // vreg → 最后使用 IR 下标
    vpin: vec[int]      // 1 = 变量（位置固定），0 = 临时值
    vmap: vec[int]      // 名字 id（与 vval 平行）
    vval: vec[int]      // 名字 → vreg
    cells: vec[int]     // 计数器组：C_ST / C_NV / C_EP / C_LD / C_BD / C_ADDRTY
    rt: vec[int]        // 运行库例程位置（顺序段填好后共享）
    stt: vec[int]       // struct 表（只读，跨线程共享）
    df: vec[int]        // defer 栈：登记的被延迟语句节点
    bind: vec[int]      // 臂内绑定栈：(名字 id, vreg) 成对
    loops: vec[int]     // 循环栈：(continue 标签, break 标签) 成对
    cp: vec[int]        // 复用缓冲：调用前缀和
    rend: vec[int]      // 复用缓冲：寄存器占用到的指令
    send: vec[int]      // 复用缓冲：临时槽占用到的指令
}

const C_ST = 0
const C_NV = 1
const C_EP = 2
const C_LD = 3
const C_BD = 4
const C_ADDRTY = 5
const C_SRET = 6        // 聚合返回的隐藏指针（vreg）
const C_DEF = 7         // defer 栈深度
// v2.29：本函数 push 了几个 callee-saved（发射期才知道）。栈形参的偏移要用它：
// 序言是「先 push callee-saved，最后 push rbp」，所以返回地址在
// [rbp + 8 + 8*nsaved]，而不是 [rbp+8]——这个坑让第一版栈形参全读成垃圾。
const C_NSAVED = 8
const FRAME = 4096          // 帧大小（512 个 8 字节槽）
const MAX_VAR = 64          // 变量最多占 64 个寄存器位（其余落槽）
const SLOT_TEMP = 256       // 0..255 给变量与聚合区域；256..511 给临时值溢出
const MAX_SLOT = 512

// 运行库例程在 rt 里的槽号
const RT_PINT = 0
const RT_PSTR = 1
const RT_MEMCPY = 2
const RT_ALLOC = 3
const RT_CAT = 4
const RT_EQ = 5
const RT_DIE = 6
const RT_PBOOL = 7
const RT_ZERO = 8
const RT_JOIN = 9
const RT_SPAWN = 10

fn _slot_disp(slot: int) -> int {
    return -8 * (slot + 1)
}

fn _newlab(labs: vec[int]) -> int {
    labs.push(0)
    return len(labs) - 1
}

fn _setlab(labs: vec[int], code: vec[int], id: int) {
    labs.set(id, len(code))
}

fn _addfix(fixes: vec[Fix], pos: int, id: int, kind: int) {
    fixes.push(Fix { pos: pos, id: id, kind: kind })
}

/// 顺序段调运行库例程（rel32 回填到 rt_pos[k]）
fn _call_rt(ctx: Ctx, k: int) {
    let p = _call_rel(ctx.code)
    _addfix(ctx.fixes, p, k, FK_RT)
}

fn _name_id_ro(ctx: Ctx, s: str) -> int {
    let mut i = 0
    while i < len(ctx.names) {
        if ctx.names.get(i) == s {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _param_name(fc: FnCtx, f: Fn, k: int) -> int {
    return fc.nodes.get(f.pbase + k).a
}

fn _param_type(fc: FnCtx, f: Fn, k: int) -> int {
    return fc.nodes.get(f.pbase + k).b
}

/// 第 k 个入参落在哪个寄存器（Win64：RCX/RDX/R8/R9）
fn _arg_reg_of(k: int) -> int {
    if k == 0 { return RCX }
    if k == 1 { return RDX }
    if k == 2 { return R8 }
    return R9
}

/// 第 k 个实参寄存器（我们自己的 ABI：RCX/RDX）
fn _out_arg_reg(k: int) -> int {
    if k == 0 { return RCX }
    if k == 1 { return RDX }
    if k == 2 { return R8 }
    return R9
}

/// 变量池：callee-saved，调用不会清（RDI/RSI 不用——运行库例程会踩它们）
fn _cs_reg(i: int) -> int {
    if i == 0 { return RBX }
    if i == 1 { return 12 }
    if i == 2 { return 13 }
    if i == 3 { return 14 }
    return 15
}

fn _cs_index(r: int) -> int {
    if r == RBX { return 0 }
    if r == 12 { return 1 }
    if r == 13 { return 2 }
    if r == 14 { return 3 }
    if r == 15 { return 4 }
    return -1
}

/// 临时值池：caller-saved（区间跨调用的临时值不会进这里）
fn _tmp_reg(i: int) -> int {
    if i == 0 { return R8 }
    if i == 1 { return R9 }
    if i == 2 { return R10 }
    return R11
}

// ---------------------------------------------------------------------------
// 编码补充（v2.15 的发射器只有 reg-reg 形态）
// ---------------------------------------------------------------------------

/// op dst, [base+disp32]：03=add 2B=sub 23=and 0B=or 33=xor 3B=cmp
fn _alu_rm(code: vec[int], op: int, dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, op)
    _modrm(code, 2, dst, base)
    _w32(code, disp)
}

/// imul dst, [base+disp32]
fn _imul_rm(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x0F)
    _b(code, 0xAF)
    _modrm(code, 2, dst, base)
    _w32(code, disp)
}

/// idiv [base+disp32]
fn _idiv_rm(code: vec[int], base: int, disp: int) {
    _rex2(code, 1, 0, base)
    _b(code, 0xF7)
    _modrm(code, 2, 7, base)
    _w32(code, disp)
}

/// neg [base+disp32]
fn _neg_rm(code: vec[int], base: int, disp: int) {
    _rex2(code, 1, 0, base)
    _b(code, 0xF7)
    _modrm(code, 2, 3, base)
    _w32(code, disp)
}

/// mov dst, [base-8]（读 str 的长度前缀）
fn _len_of(code: vec[int], dst: int, base: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm(code, 1, dst, base)
    _b(code, 0xF8)
}

/// lea dst, [rbp + disp32]
fn _lea_rbp(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, RBP)
    _b(code, 0x8D)
    _modrm(code, 2, dst, RBP)
    _w32(code, disp)
}

/// lea dst, [base + disp32]
/// `[base + disp]` 的 ModRM。**base 是 RSP/R12 时必须带 SIB 字节**——
/// rm=100 是"SIB 跟在后面"的标记，不发 SIB 的话 disp32 的第一个字节会被
/// 当成 SIB 解析，整条指令连同后面全部错位（v2.32 踩：4 个 pin 让某个基址
/// 落到 R12，编出来的 lea 直接是垃圾）。
fn _modrm_mem(code: vec[int], mod: int, reg: int, base: int) {
    if (base & 7) == 4 {
        _modrm_sib(code, mod, reg)
    } else {
        _modrm(code, mod, reg, base)
    }
}

fn _lea_rm(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8D)
    _modrm_mem(code, 2, dst, base)
    _w32(code, disp)
}

fn _push_r(code: vec[int], r: int) {
    if r >= 8 {
        _b(code, 0x41)
    }
    _b(code, 0x50 + (r & 7))
}

fn _pop_r(code: vec[int], r: int) {
    if r >= 8 {
        _b(code, 0x41)
    }
    _b(code, 0x58 + (r & 7))
}

// ---------------------------------------------------------------------------
// IR 构造
// ---------------------------------------------------------------------------

fn _fc_reset(fc: FnCtx) {
    fc.code.clear()
    fc.labs.clear()
    fc.fixes.clear()
    fc.ir.clear()
    fc.vloc.clear()
    fc.vty.clear()
    fc.vstart.clear()
    fc.vend.clear()
    fc.vpin.clear()
    fc.vmap.clear()
    fc.vval.clear()
    fc.loops.clear()
    fc.cp.clear()
    fc.rend.clear()
    fc.send.clear()
    // vreg 0 = "无"
    fc.vloc.push(0)
    fc.vty.push(TY_INT)
    fc.vstart.push(0)
    fc.vend.push(0)
    fc.vpin.push(0)
    fc.cells.set(C_ST, 0)
    fc.cells.set(C_NV, 0)
    fc.cells.set(C_EP, 0)
    fc.cells.set(C_LD, 0)
    fc.cells.set(C_BD, 0)
    fc.cells.set(C_ADDRTY, 0)
    fc.df.clear()
    fc.bind.clear()
    fc.cells.set(C_BD, 0)
}

/// 一个线程建一次，之后每个函数 `_fc_reset` 复用——并行时堆分配是争用点
fn _new_fc(nodes: vec[Node], names: vec[str], fns: vec[Fn], rt: vec[int],
           stt: vec[int]) -> FnCtx {
    // 9 个计数器/状态单元：C_ST..C_NSAVED（加新索引时这里和 C_* 常量要一起改）
    let cells = vec[int].new(9)
    let mut ci = 0
    while ci < 9 {
        cells.push(0)
        ci = ci + 1
    }
    let fc = FnCtx { code: vec[int].new(256), labs: vec[int].new(16),
                     fixes: vec[Fix].new(16), ir: vec[Ir].new(64),
                     nodes: nodes, names: names, fns: fns,
                     vloc: vec[int].new(32), vty: vec[int].new(32),
                     vstart: vec[int].new(32), vend: vec[int].new(32),
                     vpin: vec[int].new(32), vmap: vec[int].new(16),
                     vval: vec[int].new(16), cells: cells,
                     rt: rt, stt: stt,
                     df: vec[int].new(16),
                     bind: vec[int].new(16), loops: vec[int].new(16),
                     cp: vec[int].new(64), rend: vec[int].new(4),
                     send: vec[int].new(64) }
    _fc_reset(fc)
    return fc
}

fn _vnew(fc: FnCtx) -> int {
    fc.vloc.push(0)
    fc.vty.push(TY_INT)
    fc.vstart.push(len(fc.ir))
    fc.vend.push(0)
    fc.vpin.push(0)
    return len(fc.vloc) - 1
}

fn _ir_emit(fc: FnCtx, op: int, dst: int, a: int, b: int, imm: int) -> int {
    let i = len(fc.ir)
    fc.ir.push(Ir { op: op, dst: dst, a: a, b: b, imm: imm })
    if a > 0 {
        fc.vend.set(a, i)
    }
    if b > 0 {
        fc.vend.set(b, i)
    }
    // OP_MEMCPYN 把字节数放在 dst 槽里——它是**被读**的，必须算一次使用，
    // 否则分配器会认为它的活跃区间在这条指令之前就结束，把寄存器复用掉。
    if op == OP_MEMCPYN && dst > 0 {
        fc.vend.set(dst, i)
    }
    return i
}

fn _ty_is_agg(ty: int) -> bool {
    // 标量：int/bool/str(0..3)、vec 句柄、map 句柄；其余（struct/enum/array/slice/闭包）都是聚合
    if ty < TY_STRUCT {
        return false
    }
    if ty >= TY_VEC && ty < TY_MAP {
        return false
    }
    if ty >= TY_MAP && ty < TY_SLICE {
        return false
    }
    return true
}

fn _st_nf(fc: FnCtx, si: int) -> int {
    return fc.stt.get(1 + si * ST_STRIDE + 1)
}

fn _st_field_type(fc: FnCtx, si: int, fi: int) -> int {
    return fc.stt.get(1 + si * ST_STRIDE + 2 + fi * 2 + 1)
}

fn _st_field_idx(fc: FnCtx, si: int, nid: int) -> int {
    let nf = _st_nf(fc, si)
    let mut i = 0
    while i < nf {
        if fc.stt.get(1 + si * ST_STRIDE + 2 + i * 2) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _ent_base(ei: int) -> int {
    return EN_HDR + 1 + ei * EN_STRIDE
}

fn _ent_nvar(fc: FnCtx, ei: int) -> int {
    return fc.stt.get(_ent_base(ei) + 1)
}

fn _ent_ptype(fc: FnCtx, ei: int, vi: int) -> int {
    return fc.stt.get(_ent_base(ei) + 2 + vi * 3 + 2)
}

fn _ty_size(fc: FnCtx, ty: int) -> int {
    if ty >= TY_ARRAY {
        return ((ty - TY_ARRAY) >> 8) * 8
    }
    if ty >= TY_SLICE && ty < TY_ARRAY {
        return 16                       // (ptr, len)
    }
    if ty >= TY_ENUM {
        return 16
    }
    if ty >= TY_STRUCT {
        return _st_nf(fc, ty - TY_STRUCT) * 8
    }
    return 8
}

fn _ty_elem(ty: int) -> int {
    return (ty - TY_ARRAY) & 0xFF
}

fn _st_units(fc: FnCtx, n: int) -> int {
    let s = fc.cells.get(C_ST)
    if s + n > SLOT_TEMP {
        eprint("qlmc: 局部变量/聚合超出帧（" + (SLOT_TEMP).to_str() + " 个 8 字节槽）")
        exit(2)
    }
    fc.cells.set(C_ST, s + n)
    return s
}

fn _st_slot(fc: FnCtx) -> int {
    return _st_units(fc, 1)
}

fn _new_var(fc: FnCtx, nid: int, ty: int) -> int {
    let v = _vnew(fc)
    fc.vpin.set(v, 1)
    fc.vty.set(v, ty)
    let isagg = _ty_is_agg(ty)
    if isagg {
        let units = _ty_size(fc, ty) / 8
        let u = _st_units(fc, units)
        fc.vloc.set(v, -(u + units))
        fc.vmap.push(nid)
        fc.vval.push(v)
        return v
    }
    let n = fc.cells.get(C_NV)
    if n < 5 {
        fc.vloc.set(v, _cs_reg(n) + 1)
        fc.cells.set(C_NV, n + 1)
    } else {
        fc.vloc.set(v, -(_st_slot(fc)) - 1)
    }
    fc.vmap.push(nid)
    fc.vval.push(v)
    return v
}

fn _bind_push(fc: FnCtx, nid: int, v: int) {
    let d = fc.cells.get(C_BD)
    if len(fc.bind) > d * 2 {
        fc.bind.set(d * 2, nid)
        fc.bind.set(d * 2 + 1, v)
    } else {
        fc.bind.push(nid)
        fc.bind.push(v)
    }
    fc.cells.set(C_BD, d + 1)
}

fn _bind_pop(fc: FnCtx) {
    fc.cells.set(C_BD, fc.cells.get(C_BD) - 1)
}

/// 找变量，找不到返回 -1（`_var_id` 是 fail-fast 版）
fn _try_var(fc: FnCtx, nid: int) -> int {
    let mut b = fc.cells.get(C_BD) - 1
    while b >= 0 {
        if fc.bind.get(b * 2) == nid {
            return fc.bind.get(b * 2 + 1)
        }
        b = b - 1
    }
    let mut i = len(fc.vmap) - 1
    while i >= 0 {
        if fc.vmap.get(i) == nid {
            return fc.vval.get(i)
        }
        i = i - 1
    }
    return -1
}

fn _var_id(fc: FnCtx, nid: int) -> int {
    let mut b = fc.cells.get(C_BD) - 1
    while b >= 0 {
        if fc.bind.get(b * 2) == nid {
            return fc.bind.get(b * 2 + 1)
        }
        b = b - 1
    }
    let mut i = len(fc.vmap) - 1
    while i >= 0 {
        if fc.vmap.get(i) == nid {
            return fc.vval.get(i)
        }
        i = i - 1
    }
    eprint("qlmc: 未定义变量 " + fc.names.get(nid))
    exit(2)
    return -1
}

fn _fn_index(fc: FnCtx, nid: int) -> int {
    let mut i = 0
    while i < len(fc.fns) {
        if fc.fns.get(i).name == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// 降级：AST → IR
//
// 两个「发射到位」的入口，是寄存器分配真正兑现的地方：
//   `_lower_into` —— 赋值 / let 直接把结果算进目标变量，省掉 temp + mov
//                    （`a = a + b` 从 mov/add/mov 三条变成 add 一条）
//   `_lower_cond` —— 条件位置直接发 `cmp + jcc`，不再 setcc/movzx/test/jz
// 其余位置走 `_lower_expr`：值落临时值，交给线性扫描决定寄存器还是帧槽。
// ---------------------------------------------------------------------------

/// 比较运算符 → jcc 机器码（不是比较运算符返回 0）
fn _cmp_cc(op: int) -> int {
    if op == P_EQ { return 0x84 }
    if op == P_NE { return 0x85 }
    if op == P_LT { return 0x8C }
    if op == P_LE { return 0x8E }
    if op == P_GT { return 0x8F }
    if op == P_GE { return 0x8D }
    return 0
}

/// jcc ↔ 取反（setcc 是 jcc + 0x10，见 `_emit_bin`）
fn _cc_inv(cc: int) -> int {
    if cc == 0x84 { return 0x85 }
    if cc == 0x85 { return 0x84 }
    if cc == 0x8C { return 0x8D }
    if cc == 0x8D { return 0x8C }
    if cc == 0x8E { return 0x8F }
    return 0x8E
}

/// 收集一个 E_CALL 的实参节点 id：前 4 个在 b/c/n/slot，第 5 个起挂在 nx 链上
fn _call_args(fc: FnCtx, nd: Node) -> vec[int] {
    let av = vec[int].new(4)
    if nd.b >= 0 { av.push(nd.b) }
    if nd.c >= 0 { av.push(nd.c) }
    if nd.n >= 0 { av.push(nd.n) }
    if nd.slot >= 0 { av.push(nd.slot) }
    let mut x = nd.nx
    while x >= 0 {
        av.push(fc.nodes.get(x).a)
        x = fc.nodes.get(x).nx
    }
    return av
}

/// 摆实参：寄存器部分走 OP_ARG，超出 nreg 的走栈（v2.29）。
/// `argbase` = 1 表示聚合返回占了第 0 个实参寄存器（sret）。
/// 返回为栈实参预留的字节数（0 = 没开栈），调用方在 call 之后要用
/// `_emit_call_free` 收回去。
fn _emit_call_args(fc: FnCtx, vals: vec[int], argbase: int) -> int {
    let nreg = 4 - argbase
    let mut nstk = len(vals) - nreg
    if nstk < 0 {
        nstk = 0
    }
    let mut stk = 0
    if nstk > 0 {
        // shadow space 32 + 每个栈实参 8；再补到 16 的倍数——
        // Win64 要求 `call` 那一刻 rsp ≡ 0 (mod 16)，不然被调方里
        // 用对齐 SSE 存取的 Win32 API 会直接 AV。
        stk = 32 + 8 * nstk
        if stk % 16 != 0 {
            stk = stk + 8
        }
        _ir_emit(fc, OP_STKALLOC, 0, 0, 0, stk)
    }
    let mut ai = 0
    let mut k = 0
    while ai < len(vals) {
        if ai < nreg {
            _ir_emit(fc, OP_ARG, 0, vals.get(ai), 0, argbase + ai)
        } else {
            _ir_emit(fc, OP_STKARG, 0, vals.get(ai), 0, 32 + 8 * k)
            k = k + 1
        }
        ai = ai + 1
    }
    return stk
}

fn _emit_call_free(fc: FnCtx, stk: int) {
    if stk > 0 {
        _ir_emit(fc, OP_STKFREE, 0, 0, 0, stk)
    }
}

/// 两个操作数已经求好，把 `l <op> r` 发进 dst，返回结果类型
fn _emit_bin(fc: FnCtx, op: int, dst: int, l: int, r: int) -> int {
    let tl = fc.vty.get(l)
    let tr = fc.vty.get(r)
    if tl == TY_STR || tr == TY_STR {
        if op == P_PLUS {
            _ir_emit(fc, OP_ARG, 0, l, 0, 0)
            _ir_emit(fc, OP_ARG, 0, r, 0, 1)
            _ir_emit(fc, OP_CALLRT, dst, 0, 0, RT_CAT)
            return TY_STR
        }
        if op == P_EQ || op == P_NE {
            // stage-0 的口径：str 比较产生 bool（打印 true/false）
            _ir_emit(fc, OP_ARG, 0, l, 0, 0)
            _ir_emit(fc, OP_ARG, 0, r, 0, 1)
            _ir_emit(fc, OP_CALLRT, dst, 0, 0, RT_EQ)
            if op == P_NE {
                _ir_emit(fc, OP_NOT, dst, dst, 0, 0)
            }
            return TY_BOOL
        }
        eprint("qlmc: 字符串只支持 + 与 == / !=")
        exit(2)
    }
    if op == P_PLUS {
        _ir_emit(fc, OP_ADD, dst, l, r, 0)
        return TY_INT
    }
    if op == P_MINUS {
        _ir_emit(fc, OP_SUB, dst, l, r, 0)
        return TY_INT
    }
    if op == P_STAR {
        _ir_emit(fc, OP_MUL, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SLASH {
        _ir_emit(fc, OP_DIV, dst, l, r, 0)
        return TY_INT
    }
    if op == P_PERCENT {
        _ir_emit(fc, OP_MOD, dst, l, r, 0)
        return TY_INT
    }
    // 位运算与移位（v2.28）：只对 int 成立，结果 int。
    // `>>` 是**算术**右移（sar），`>>>` 才是逻辑右移（shr）——与 stage-0 一致。
    if op == P_AMP {
        _ir_emit(fc, OP_AND, dst, l, r, 0)
        return TY_INT
    }
    if op == P_PIPE {
        _ir_emit(fc, OP_OR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_CARET {
        _ir_emit(fc, OP_XOR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SHL {
        _ir_emit(fc, OP_SHL, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SHR {
        _ir_emit(fc, OP_SAR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_USHR {
        _ir_emit(fc, OP_SHR, dst, l, r, 0)
        return TY_INT
    }
    let cc = _cmp_cc(op)
    if cc == 0 {
        eprint("qlmc: 不支持的运算符 " + op.to_str())
        exit(2)
    }
    _ir_emit(fc, OP_CMP, dst, l, r, cc + 0x10)
    return TY_INT
}
















/// 左值取地址：变量（聚合）/ 字段 / 下标。结果 vreg 存地址，类型放 fc.addrty
fn _addr_of(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_VAR {
        let v = _var_id(fc, nd.a)
        let loc = fc.vloc.get(v)
        if loc >= 0 {
            eprint("qlmc: 只有聚合变量能取地址：" + fc.names.get(nd.a))
            exit(2)
        }
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADDRV, d, 0, 0, -loc - 1)
        fc.cells.set(C_ADDRTY, fc.vty.get(v))
        return d
    }
    if nd.op == E_FIELD {
        return _addr_field(fc, nd.a, nd.b)
    }
    if nd.op == E_INDEX {
        return _addr_index(fc, nd.a, nd.b)
    }

    eprint("qlmc: 这个表达式不能取地址")
    exit(2)
    return 0
}

fn _addr_field(fc: FnCtx, base_nid: int, fname: int) -> int {
    let base = _addr_of(fc, base_nid)
    let bty = fc.cells.get(C_ADDRTY)
    if bty < TY_STRUCT || bty >= TY_ARRAY {
        eprint("qlmc: 只有 struct 有字段：" + fc.names.get(fname))
        exit(2)
    }
    let si = bty - TY_STRUCT
    let fi = _st_field_idx(fc, si, fname)
    if fi < 0 {
        eprint("qlmc: struct 没有字段 " + fc.names.get(fname))
        exit(2)
    }
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_ADDRF, d, base, 0, fi * 8)
    fc.cells.set(C_ADDRTY, _st_field_type(fc, si, fi))
    return d
}

fn _addr_index(fc: FnCtx, base_nid: int, ix_nid: int) -> int {
    // vec：句柄是头块，数据指针在 [h+0]；数组：区域地址直接当下标基址
    let bty0 = _ty_of_expr(fc, base_nid)
    if bty0 >= TY_VEC && bty0 < TY_MAP {
        let h = _lower_expr(fc, base_nid)
        let i = _lower_expr(fc, ix_nid)
        _vec_check(fc, h, i)
        let et0 = bty0 - TY_VEC
        fc.cells.set(C_ADDRTY, et0)
        let data = _vec_field(fc, h, 0)
        return _vec_elem_addr(fc, data, i, _ty_size(fc, et0))
    }
    if bty0 >= TY_SLICE && bty0 < TY_ARRAY {
        // 切片：(ptr, len)，先查边界再用 ptr 当下标基址
        let sv = _lower_expr(fc, base_nid)
        let ptr = _vnew(fc)
        fc.vty.set(ptr, TY_INT)
        _ir_emit(fc, OP_LOAD, ptr, sv, 0, 8)
        let len = _vnew(fc)
        fc.vty.set(len, TY_INT)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
        _ir_emit(fc, OP_LOAD, len, la, 0, 8)
        let i = _lower_expr(fc, ix_nid)
        _slice_check(fc, i, len)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADDRX, d, ptr, i, 8)
        fc.cells.set(C_ADDRTY, bty0 - TY_SLICE)
        return d
    }
    let base = _addr_of(fc, base_nid)
    let bty = fc.cells.get(C_ADDRTY)
    if bty < TY_ARRAY {
        eprint("qlmc: 只有定长数组能切片下标")
        exit(2)
    }
    let ix = _lower_expr(fc, ix_nid)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_ADDRX, d, base, ix, 8)
    fc.cells.set(C_ADDRTY, _ty_elem(bty))
    return d
}

fn _lower_expr(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_NUM {
        let d = _vnew(fc)
        fc.vty.set(d, nd.ty)
        _ir_emit(fc, OP_CONST, d, 0, 0, nd.a)
        return d
    }
    if nd.op == E_VAR {
        let v = _var_id(fc, nd.a)
        let ty = fc.vty.get(v)
        if _ty_is_agg(ty) {
            // 聚合变量的"值"是它区域的地址
            let d = _vnew(fc)
            fc.vty.set(d, ty)
            _ir_emit(fc, OP_ADDRV, d, 0, 0, -fc.vloc.get(v) - 1)
            return d
        }
        return v
    }
    if nd.op == E_STR {
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
        _ir_emit(fc, OP_LEA, d, 0, 0, nd.a)
        return d
    }
    if nd.op == E_UN {
        let a = _lower_expr(fc, nd.b)
        let d = _vnew(fc)
        // `!` 在 stage-0 里是 int（打印 1/0）
        fc.vty.set(d, TY_INT)
        if nd.a == P_MINUS {
            _ir_emit(fc, OP_NEG, d, a, 0, 0)
        } else if nd.a == P_TILDE {
            _ir_emit(fc, OP_BNOT, d, a, 0, 0)
        } else {
            _ir_emit(fc, OP_NOT, d, a, 0, 0)
        }
        return d
    }
    if nd.op == E_CALL {
        // 内建 assert(cond, msg)
        if fc.names.get(nd.a) == "assert" && nd.b >= 0 {
            let lfail = _newlab(fc.labs)
            let lok = _newlab(fc.labs)
            _lower_cond(fc, nd.b, lok, 0)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
            let mut m = 0
            if nd.c >= 0 {
                m = _lower_expr(fc, nd.c)
            }
            if m > 0 && fc.vty.get(m) == TY_STR {
                _ir_emit(fc, OP_ARG, 0, m, 0, 0)
                _ir_emit(fc, OP_CALLRT, 0, 0, 0, RT_DIE)
            } else {
                // 没有消息就只退 1（与 stage-0 的退出码一致，不去碰空指针）
                let one = _vnew(fc)
                _ir_emit(fc, OP_CONST, one, 0, 0, 1)
                _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
            }
            _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_CONST, d, 0, 0, 0)
            return d
        }
        // 内建 len(s)
        if fc.names.get(nd.a) == "len" && nd.b >= 0 {
            let aty = _ty_of_expr(fc, nd.b)
            if aty >= TY_SLICE && aty < TY_ARRAY {
                let sv = _lower_expr(fc, nd.b)
                let la = _vnew(fc)
                fc.vty.set(la, TY_INT)
                _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_LOAD, d, la, 0, 8)
                return d
            }
            if aty >= TY_MAP && aty < TY_ARRAY {
                let h = _lower_expr(fc, nd.b)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
                return d
            }
            if aty >= TY_VEC && aty < TY_ARRAY {
                let h = _lower_expr(fc, nd.b)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
                return d
            }
            let a = _lower_expr(fc, nd.b)
            if fc.vty.get(a) != TY_STR {
                eprint("qlmc: len() 只支持 str 与 vec")
                exit(2)
            }
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_LEN, d, a, 0, 0)
            return d
        }
        // 内建 join(handle)（v2.32）：等线程结束并取返回值。
        // 用户自己定义了 join 就以用户函数为准（与 stage-0 一致）。
        if fc.names.get(nd.a) == "join" && _fn_index(fc, nd.a) < 0 {
            if nd.b < 0 || nd.c >= 0 {
                eprint("qlmc: join(handle) 需要且只需要一个实参")
                exit(2)
            }
            let hv = _lower_expr(fc, nd.b)
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_ARG, 0, hv, 0, 0)
            _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_JOIN)
            return d
        }
        // 普通调用：实参求值后逐个搬到实参寄存器——实参值不跨调用活
        let fi = _fn_index(fc, nd.a)
        if fi < 0 {
            // 不是顶层函数：可能是闭包变量
            let cv = _try_var(fc, nd.a)
            if cv >= 0 && fc.vty.get(cv) == TY_FN {
                let av = _call_args(fc, nd)
                let vals = vec[int].new(2)
                let mut ai = 0
                while ai < len(av) {
                    vals.push(_lower_expr(fc, av.get(ai)))
                    ai = ai + 1
                }
                // 闭包变量的区域地址：先算，再摆实参（见下面的 pin 说明）
                let cl0 = _vnew(fc)
                fc.vty.set(cl0, TY_INT)
                _ir_emit(fc, OP_ADDRV, cl0, 0, 0, -fc.vloc.get(cv) - 1)
                let stk = _emit_call_args(fc, vals, 0)
                // nd.a 是**名字 id**，不是节点 id：直接取闭包变量的区域地址。
                // 必须在摆实参**之前**算好并 pin——OP_ARG 会写 R8/R9，
                // 而闭包地址的临时值很可能就落在那里。
                let cl = _pin(fc, cl0)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_CALLR, d, cl, 0, 0)
                _emit_call_free(fc, stk)
                return d
            }
            eprint("qlmc: 未定义函数 " + fc.names.get(nd.a))
            exit(2)
        }
        let fret = fc.fns.get(fi).ret_t
        let mut argbase = 0
        let mut sret = 0
        if _ty_is_agg(fret) {
            // 聚合返回：先给结果开一块区域，地址留到最后再搬进 RCX。
            // **必须 pin**：实参求值里可能还有调用（会把 RCX 冲掉），
            // 而 OP_ARG 本身又写 R8/R9，临时值放寄存器里活不到 call 那一刻。
            let tmp = _new_var(fc, -1, fret)
            let sa = _vnew(fc)
            fc.vty.set(sa, TY_INT)
            _ir_emit(fc, OP_ADDRV, sa, 0, 0, -fc.vloc.get(tmp) - 1)
            sret = _pin(fc, sa)
            argbase = 1
        }
        let av = _call_args(fc, nd)
        let vals = vec[int].new(4)
        let mut ai = 0
        while ai < len(av) {
            vals.push(_lower_expr(fc, av.get(ai)))
            ai = ai + 1
        }
        let stk = _emit_call_args(fc, vals, argbase)
        if sret != 0 {
            // 最后才设 sret：放在这里就不会被实参求值里的任何调用冲掉
            _ir_emit(fc, OP_ARG, 0, sret, 0, 0)
        }
        let d = _vnew(fc)
        fc.vty.set(d, fret)
        if fc.fns.get(fi).body < 0 {
            // @ffi：`call [rip+IAT]`，槽号 = 内置 4 个之后
            _ir_emit(fc, OP_CALLIAT, d, 0, 0, I_USER + fc.fns.get(fi).nlocals)
        } else {
            _ir_emit(fc, OP_CALL, d, 0, 0, fi)
        }
        _emit_call_free(fc, stk)
        if _ty_is_agg(fret) {
            fc.vty.set(sret, fret)   // 聚合结果就是那块区域的地址
            return sret
        }
        return d
    }
    if nd.op == E_SPAWN {
        return _lower_spawn(fc, nd)
    }
    if nd.op == E_BIN {
        if nd.a == P_AND || nd.a == P_OR {
            let lshort = _newlab(fc.labs)
            let lend = _newlab(fc.labs)
            let d = _vnew(fc)
            fc.vty.set(d, TY_BOOL)
            let mut jf = 0
            if nd.a == P_AND {
                jf = 1
            }
            _lower_cond(fc, nd.b, lshort, jf)
            let r = _lower_expr(fc, nd.c)
            let nz = _vnew(fc)
            fc.vty.set(nz, TY_BOOL)
            _ir_emit(fc, OP_NZ, nz, r, 0, 0)
            _ir_emit(fc, OP_MOV, d, nz, 0, 0)
            _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lshort)
            let k = _vnew(fc)
            fc.vty.set(k, TY_BOOL)
            _ir_emit(fc, OP_CONST, k, 0, 0, 0)
            if nd.a == P_OR {
                _ir_emit(fc, OP_CONST, k, 0, 0, 1)
            }
            _ir_emit(fc, OP_MOV, d, k, 0, 0)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
            return d
        }
        // 求值序：先右后左（v2.15 的差分口径，别改）
        let d = _vnew(fc)
        let r = _lower_expr(fc, nd.c)
        let l = _lower_expr(fc, nd.b)
        let t = _emit_bin(fc, nd.a, d, l, r)
        fc.vty.set(d, t)
        return d
    }
    if nd.op == E_VECNEW {
        return _lower_vecnew(fc, nd)
    }
    if nd.op == E_METHOD {
        return _lower_method(fc, nd)
    }
    if nd.op == E_MAPNEW {
        return _map_new(fc, nd)
    }
    if nd.op == E_SLICE {
        return _lower_slice(fc, nd)
    }
    if nd.op == E_CLOSURE {
        // 值 = {code, env}；本版没有捕获，env 恒为 0
        let v = _new_var(fc, -1, TY_FN)
        let va = _vnew(fc)
        fc.vty.set(va, TY_INT)
        _ir_emit(fc, OP_ADDRV, va, 0, 0, -fc.vloc.get(v) - 1)
        let code = _vnew(fc)
        fc.vty.set(code, TY_INT)
        _ir_emit(fc, OP_LEAFN, code, 0, 0, nd.a)
        _ir_emit(fc, OP_STORE, 0, va, code, 8)
        let z = _map_const(fc, 0)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, va, 0, 8)
        _ir_emit(fc, OP_STORE, 0, la, z, 8)
        fc.vty.set(va, TY_FN)
        return va
    }
    if nd.op == E_ENUMCTOR {
        // 枚举值 = 一个 16 字节区域的地址：[tag][载荷]
        let v = _new_var(fc, -1, TY_ENUM + nd.a)
        let loc = fc.vloc.get(v)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_ENUM + nd.a)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, -loc - 1)
        let t = _vnew(fc)
        fc.vty.set(t, TY_INT)
        _ir_emit(fc, OP_CONST, t, 0, 0, nd.b)
        _ir_emit(fc, OP_STORE, 0, a0, t, 8)
        if nd.c >= 0 {
            let pv = _lower_expr(fc, nd.c)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, 8)
            _ir_emit(fc, OP_STORE, 0, a1, pv, 8)
        }
        return a0
    }
    if nd.op == E_MATCH {
        let ty = _ty_of_expr(fc, fc.nodes.get(nd.b).c)
        let d = _new_var(fc, -1, ty)
        _lower_match(fc, nid, d, fc.cells.get(C_EP))
        return d
    }
    if nd.op == E_FIELD || nd.op == E_INDEX {
        let a = _addr_of(fc, nid)
        let ty = fc.cells.get(C_ADDRTY)
        if _ty_is_agg(ty) {
            // 聚合值 = 它的地址（只用于赋值/初始化拷贝）
            fc.vty.set(a, ty)
            return a
        }
        let d = _vnew(fc)
        fc.vty.set(d, ty)
        _ir_emit(fc, OP_LOAD, d, a, 0, 8)
        return d
    }
    if nd.op == E_STRUCTLIT {
        // 结构体字面量当**值**用（v2.31）：开一块临时区域逐字段写进去，
        // 值 = 区域地址（与 E_ENUMCTOR / 字段读同一约定）。push / set /
        // 函数实参都靠这条——qlmc 自己的源码里 `nodes.push(Node{...})`
        // 就是这个形状。
        let ty = TY_STRUCT + nd.a
        let d = _new_var(fc, -1, ty)
        _lower_into_agg(fc, nid, d, ty)
        let a = _vnew(fc)
        fc.vty.set(a, ty)
        _ir_emit(fc, OP_ADDRV, a, 0, 0, -fc.vloc.get(d) - 1)
        return a
    }
    if nd.op == E_ARRLIT {
        eprint("qlmc: 数组字面量只能出现在 let / 赋值 / 字段初始化里")
        exit(2)
    }
    eprint("qlmc: 不支持的表达式节点 " + nd.op.to_str())
    exit(2)
    return 0
}

/// match 降级：读 tag → 逐臂比较 → 命中就执行体。
/// `dst > 0` 是表达式模式（体写进 dst），否则是语句模式（体是块）。
fn _lower_match(fc: FnCtx, nid: int, dst: int, ep: int) {
    let nd = fc.nodes.get(nid)
    let scrut = _lower_expr(fc, nd.a)
    let sty = fc.vty.get(scrut)
    if sty < TY_ENUM || sty >= TY_ARRAY {
        eprint("qlmc: match 的被匹配值必须是 enum（实际 " + sty.to_str() + "）")
        exit(2)
    }
    let ei = sty - TY_ENUM
    let lend = _newlab(fc.labs)
    let mut arm = nd.b
    while arm >= 0 {
        let a = fc.nodes.get(arm)
        let lnext = _newlab(fc.labs)
        if a.a >= 0 {
            let addr = _vnew(fc)
            fc.vty.set(addr, TY_INT)
            _ir_emit(fc, OP_ADDRF, addr, scrut, 0, 0)
            let tag = _vnew(fc)
            fc.vty.set(tag, TY_INT)
            _ir_emit(fc, OP_LOAD, tag, addr, 0, 8)
            let k = _vnew(fc)
            fc.vty.set(k, TY_INT)
            _ir_emit(fc, OP_CONST, k, 0, 0, a.a)
            _ir_emit(fc, OP_JCMP, 0x85, tag, k, lnext)   // jne → 下一臂
        }
        if a.b >= 0 {
            let paddr = _vnew(fc)
            fc.vty.set(paddr, TY_INT)
            _ir_emit(fc, OP_ADDRF, paddr, scrut, 0, 8)
            let pv = _vnew(fc)
            fc.vty.set(pv, TY_INT)
            _ir_emit(fc, OP_LOAD, pv, paddr, 0, 8)
            let bv = _new_var(fc, -1, _ent_ptype(fc, ei, a.a))
            _ir_emit(fc, OP_MOV, bv, pv, 0, 0)
            _bind_push(fc, a.b, bv)          // 只在臂体内可见
        }
        if dst > 0 {
            _lower_into(fc, a.c, dst)
        } else {
            _lower_block(fc, a.c, ep)
        }
        if a.b >= 0 {
            _bind_pop(fc)
        }
        _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lnext)
        arm = a.nx
    }
    _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
}

/// 聚合目标：字面量逐字段写，其余按地址整块拷贝
fn _lower_into_agg(fc: FnCtx, nid: int, dst: int, dty: int) {
    let nd = fc.nodes.get(nid)
    let loc = fc.vloc.get(dst)
    let base_imm = -loc - 1
    if nd.op == E_STRUCTLIT {
        let si = dty - TY_STRUCT
        let mut f = nd.b
        while f >= 0 {
            let fd = fc.nodes.get(f)
            let fi = fd.a
            let fty = _st_field_type(fc, si, fi)
            if _ty_is_agg(fty) {
                eprint("qlmc: 嵌套聚合字段本版不支持")
                exit(2)
            }
            let v = _lower_expr(fc, fd.b)
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, fi * 8)
            _ir_emit(fc, OP_STORE, 0, a1, v, 8)
            f = fd.nx
        }
        return
    }
    if nd.op == E_ENUMCTOR {
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
        let t = _vnew(fc)
        fc.vty.set(t, TY_INT)
        _ir_emit(fc, OP_CONST, t, 0, 0, nd.b)
        _ir_emit(fc, OP_STORE, 0, a0, t, 8)
        if nd.c >= 0 {
            let pv = _lower_expr(fc, nd.c)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, 8)
            _ir_emit(fc, OP_STORE, 0, a1, pv, 8)
        }
        return
    }
    if nd.op == E_ARRLIT {
        let mut e = nd.a
        let mut i = 0
        while e >= 0 {
            let en = fc.nodes.get(e)
            let v = _lower_expr(fc, en.a)
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, i * 8)
            _ir_emit(fc, OP_STORE, 0, a1, v, 8)
            i = i + 1
            e = en.nx
        }
        return
    }
    // 其余（变量 / 字段 / 下标）：整块拷贝
    let src = _lower_expr(fc, nid)
    let sty = fc.vty.get(src)
    if sty != dty {
        eprint("qlmc: 聚合赋值两侧类型不一致")
        exit(2)
    }
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
    _ir_emit(fc, OP_COPY, 0, a0, src, _ty_size(fc, dty))
}

/// 把表达式算进一个已存在的位置（变量）。顶层是二元/一元运算时直接发射到位。
/// 只做类型推导（不发指令）：`let q = p` 要按 p 的类型决定 q 是标量还是聚合
fn _ty_of_expr(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_VAR {
        return fc.vty.get(_var_id(fc, nd.a))
    }
    if nd.op == E_FIELD {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_STRUCT && bty < TY_ARRAY {
            let si = bty - TY_STRUCT
            let fi = _st_field_idx(fc, si, nd.b)
            if fi >= 0 {
                return _st_field_type(fc, si, fi)
            }
        }
        return TY_INT
    }
    if nd.op == E_INDEX {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_VEC && bty < TY_ARRAY {
            return bty - TY_VEC
        }
        if bty >= TY_ARRAY {
            return _ty_elem(bty)
        }
        return TY_INT
    }
    if nd.op == E_STRUCTLIT {
        return TY_STRUCT + nd.a
    }
    if nd.op == E_ENUMCTOR {
        return TY_ENUM + nd.a
    }
    if nd.op == E_VECNEW {
        return TY_VEC + nd.a
    }
    if nd.op == E_MAPNEW {
        return TY_MAP + (nd.a << 8) + nd.c
    }
    if nd.op == E_CLOSURE {
        return TY_FN
    }
    if nd.op == E_SLICE {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_SLICE && bty < TY_ARRAY {
            return bty
        }
        if bty >= TY_VEC && bty < TY_MAP {
            return TY_SLICE + (bty - TY_VEC)
        }
        if bty >= TY_ARRAY {
            return TY_SLICE + _ty_elem(bty)
        }
        return TY_SLICE + TY_INT
    }
    if nd.op == E_METHOD {
        let rty = _ty_of_expr(fc, nd.a)
        let m = fc.names.get(nd.b)
        if rty >= TY_MAP && rty < TY_ARRAY {
            if m == "get" {
                return (rty - TY_MAP) & 0xFF
            }
            if m == "has" {
                return TY_BOOL
            }
            return TY_INT
        }
        if rty >= TY_VEC && rty < TY_ARRAY {
            if m == "get" {
                return rty - TY_VEC
            }
        }
        return TY_INT
    }
    if nd.op == E_MATCH {
        return _ty_of_expr(fc, fc.nodes.get(nd.b).c)
    }
    if nd.op == E_ARRLIT {
        return TY_ARRAY + (nd.b << 8) + TY_INT
    }
    if nd.op == E_STR {
        return TY_STR
    }
    if nd.op == E_CALL {
        let fi = _fn_index(fc, nd.a)
        if fi >= 0 {
            return fc.fns.get(fi).ret_t
        }
    }
    return TY_INT
}

fn _lower_into(fc: FnCtx, nid: int, dst: int) {
    let dty = fc.vty.get(dst)
    if _ty_is_agg(dty) {
        _lower_into_agg(fc, nid, dst, dty)
        return
    }
    let nd = fc.nodes.get(nid)
    if nd.op == E_BIN && nd.a != P_AND && nd.a != P_OR {
        let r = _lower_expr(fc, nd.c)
        let l = _lower_expr(fc, nd.b)
        let t = _emit_bin(fc, nd.a, dst, l, r)
        fc.vty.set(dst, t)
        return
    }
    if nd.op == E_UN {
        let a = _lower_expr(fc, nd.b)
        fc.vty.set(dst, TY_INT)
        if nd.a == P_MINUS {
            _ir_emit(fc, OP_NEG, dst, a, 0, 0)
        } else if nd.a == P_TILDE {
            _ir_emit(fc, OP_BNOT, dst, a, 0, 0)
        } else {
            _ir_emit(fc, OP_NOT, dst, a, 0, 0)
        }
        return
    }
    let t = _lower_expr(fc, nid)
    fc.vty.set(dst, fc.vty.get(t))
    _ir_emit(fc, OP_MOV, dst, t, 0, 0)
}

/// 条件跳转：`if_false = 1` 表示"条件不成立时跳到 lab"。
/// 顶层是比较时直接 `cmp + jcc`，否则求值后 `jz/jnz`。
fn _lower_cond(fc: FnCtx, nid: int, lab: int, if_false: int) {
    let nd = fc.nodes.get(nid)
    if nd.op == E_BIN {
        let cc0 = _cmp_cc(nd.a)
        if cc0 != 0 {
            let r = _lower_expr(fc, nd.c)
            let l = _lower_expr(fc, nd.b)
            if fc.vty.get(l) != TY_STR && fc.vty.get(r) != TY_STR {
                let mut cc = cc0
                if if_false == 1 {
                    cc = _cc_inv(cc)
                }
                _ir_emit(fc, OP_JCMP, cc, l, r, lab)
                return
            }
            let d = _vnew(fc)
            let t = _emit_bin(fc, nd.a, d, l, r)
            fc.vty.set(d, t)
            if if_false == 1 {
                _ir_emit(fc, OP_JZ, 0, d, 0, lab)
            } else {
                _ir_emit(fc, OP_JNZ, 0, d, 0, lab)
            }
            return
        }
    }
    let v = _lower_expr(fc, nid)
    if if_false == 1 {
        _ir_emit(fc, OP_JZ, 0, v, 0, lab)
    } else {
        _ir_emit(fc, OP_JNZ, 0, v, 0, lab)
    }
}

fn _loop_push(fc: FnCtx, cont: int, brk: int) {
    let d = fc.cells.get(C_LD)
    if len(fc.loops) > d * 2 {
        fc.loops.set(d * 2, cont)
        fc.loops.set(d * 2 + 1, brk)
    } else {
        fc.loops.push(cont)
        fc.loops.push(brk)
    }
    fc.cells.set(C_LD, d + 1)
}

fn _loop_pop(fc: FnCtx) {
    fc.cells.set(C_LD, fc.cells.get(C_LD) - 1)
}

/// 逆序执行 [base, C_DEF) 里登记的 defer（块退出 / return / break / continue）
fn _emit_defers(fc: FnCtx, base: int, ep: int) {
    let mut i = fc.cells.get(C_DEF) - 1
    while i >= base {
        let inner = fc.df.get(i)
        fc.cells.set(C_DEF, i)          // 防递归重复登记
        _lower_stmt(fc, inner, ep)
        i = i - 1
    }
    fc.cells.set(C_DEF, base)
}

fn _lower_block(fc: FnCtx, head: int, ep: int) {
    let base = fc.cells.get(C_DEF)
    let mut cur = head
    while cur >= 0 {
        _lower_stmt(fc, cur, ep)
        cur = fc.nodes.get(cur).nx
    }
    // 块退出：本块登记的 defer 逆序执行（LIFO）
    _emit_defers(fc, base, ep)
}

fn _lower_stmt(fc: FnCtx, id: int, ep: int) {
    let nd = fc.nodes.get(id)
    if nd.op == S_LET {
        let mut ty = nd.ty
        if nd.b >= 0 && nd.slot == 0 {
            // 无类型标注：按初值推类型（聚合要据此决定"区域"还是"寄存器"）
            ty = _ty_of_expr(fc, nd.b)
        }
        let d = _new_var(fc, nd.a, ty)
        if nd.b >= 0 {
            _lower_into(fc, nd.b, d)
        } else if _ty_is_agg(ty) {
            // 无初始化：整块清零
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, -fc.vloc.get(d) - 1)
            _ir_emit(fc, OP_ZERO, 0, a0, 0, _ty_size(fc, ty))
        } else {
            let z = _vnew(fc)
            fc.vty.set(z, TY_INT)
            _ir_emit(fc, OP_CONST, z, 0, 0, 0)
            _ir_emit(fc, OP_MOV, d, z, 0, 0)
        }
        return
    }
    if nd.op == S_ASG_FIELD {
        let a = _addr_field(fc, nd.a, nd.b)
        let fty = fc.cells.get(C_ADDRTY)
        let v = _lower_expr(fc, nd.c)
        if _ty_is_agg(fty) {
            _ir_emit(fc, OP_COPY, 0, a, v, _ty_size(fc, fty))
        } else {
            _ir_emit(fc, OP_STORE, 0, a, v, 8)
        }
        return
    }
    if nd.op == S_ASG_INDEX {
        let a = _addr_index(fc, nd.a, nd.b)
        let ety = fc.cells.get(C_ADDRTY)      // 先取走：_lower_expr 会覆盖它
        let v = _lower_expr(fc, nd.c)
        if _ty_is_agg(ety) {
            _ir_emit(fc, OP_COPY, 0, a, v, _ty_size(fc, ety))
        } else {
            _ir_emit(fc, OP_STORE, 0, a, v, 8)
        }
        return
    }
    if nd.op == S_ASSIGN {
        let d = _var_id(fc, nd.a)
        _lower_into(fc, nd.b, d)
        return
    }
    if nd.op == S_IF {
        let lelse = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _lower_cond(fc, nd.a, lelse, 1)
        _lower_block(fc, nd.b, ep)
        _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lelse)
        _lower_block(fc, nd.n, ep)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_WHILE {
        let ltop = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
        _lower_cond(fc, nd.a, lend, 1)
        _loop_push(fc, ltop, lend)
        _lower_block(fc, nd.b, ep)
        _loop_pop(fc)
        _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_DEFER {
        let d = fc.cells.get(C_DEF)
        if len(fc.df) > d {
            fc.df.set(d, nd.a)
        } else {
            fc.df.push(nd.a)
        }
        fc.cells.set(C_DEF, d + 1)
        return
    }
    if nd.op == S_MATCH {
        _lower_match(fc, id, 0, ep)
        return
    }
    if nd.op == S_FOR {
        // 与 stage-0 同口径：上下界各求值**一次**，循环变量是隐藏的 int 变量
        let lo = _lower_expr(fc, nd.b)
        let hi = _lower_expr(fc, nd.c)
        // **上界必须钉进变量**：临时值的活跃区间不跨循环回边，下一轮比较会读到
        // 被别的临时值覆盖的寄存器（v2.17 实测：`for k in 0..3` 死循环）。
        let hiv = _new_var(fc, -1, TY_INT)
        _ir_emit(fc, OP_MOV, hiv, hi, 0, 0)
        let iv = _new_var(fc, nd.a, TY_INT)
        _ir_emit(fc, OP_MOV, iv, lo, 0, 0)
        let ltop = _newlab(fc.labs)
        let lcont = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
        _ir_emit(fc, OP_JCMP, 0x8D, iv, hiv, lend)    // jge：i >= hi 就退出
        _loop_push(fc, lcont, lend)
        _lower_block(fc, nd.n, ep)
        _loop_pop(fc)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lcont)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_ADD, iv, iv, one, 0)
        _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_BREAK || nd.op == S_CONTINUE {
        let d = fc.cells.get(C_LD)
        if d < 1 {
            eprint("qlmc: break / continue 不在循环里")
            exit(2)
        }
        let mut l = fc.loops.get((d - 1) * 2 + 1)
        if nd.op == S_CONTINUE {
            l = fc.loops.get((d - 1) * 2)
        }
        _ir_emit(fc, OP_JMP, 0, 0, 0, l)
        return
    }
    if nd.op == S_RETURN {
        // 口径：**先定下返回值，再跑 defer**（stage-0 就是这么做的）。
        // 所以先求值并钉进变量，再 _emit_defers，最后才 RET。
        let mut v = 0
        let mut vty = TY_INT
        if nd.a >= 0 {
            let inz = fc.nodes.get(nd.a)
            if inz.op == E_STRUCTLIT || inz.op == E_ARRLIT {
                let ty = _ty_of_expr(fc, nd.a)
                let tmp = _new_var(fc, -1, ty)
                _lower_into(fc, nd.a, tmp)
                let av0 = _vnew(fc)
                fc.vty.set(av0, TY_INT)
                _ir_emit(fc, OP_ADDRV, av0, 0, 0, -fc.vloc.get(tmp) - 1)
                let av = _pin(fc, av0)
                fc.vty.set(av, ty)
                v = av
                vty = ty
            } else {
                let t = _lower_expr(fc, nd.a)
                vty = fc.vty.get(t)
                v = _pin(fc, t)
                fc.vty.set(v, vty)
            }
        }
        _emit_defers(fc, 0, ep)
        if v > 0 && _ty_is_agg(vty) {
            _ir_emit(fc, OP_RETAGG, 0, v, 0, _ty_size(fc, vty))
            return
        }
        _ir_emit(fc, OP_RET, 0, v, 0, 0)
        return
    }
    if nd.op == S_PRINT {
        let v = _lower_expr(fc, nd.a)
        if _ty_is_agg(fc.vty.get(v)) {
            eprint("qlmc: print 只支持 int / bool / str")
            exit(2)
        }
        _ir_emit(fc, OP_PRINT, 0, v, 0, fc.vty.get(v))
        return
    }
    if nd.op == S_EXIT {
        let v = _lower_expr(fc, nd.a)
        _ir_emit(fc, OP_EXIT, 0, v, 0, 0)
        return
    }
    if nd.op == S_EXPR {
        _lower_expr(fc, nd.a)
        return
    }
    eprint("qlmc: 不支持的语句节点 " + nd.op.to_str())
    exit(2)
}

fn _lower_fn(fc: FnCtx, fi: int) {
    let f = fc.fns.get(fi)
    if f.body < 0 {
        return                  // @ffi 声明：没有函数体，只占一个 IAT 槽
    }
    let ep = _newlab(fc.labs)
    fc.cells.set(C_EP, ep)
    // 聚合返回走隐藏的 sret 指针（占第 0 个实参寄存器），其余实参顺延
    let mut argbase = 0
    if _ty_is_agg(f.ret_t) {
        let sv = _new_var(fc, -1, TY_INT)
        _ir_emit(fc, OP_PARAM, sv, 0, 0, 0)
        fc.cells.set(C_SRET, sv)
        argbase = 1
    }
    // 第一遍：把**所有**入参寄存器先落到变量里。这一步必须在任何拷贝之前——
    // 按值拷贝要用 ADDRV/COPY，而 ADDRV 的临时值会落在 R8-R11，正好是第 3/4 个
    // 实参寄存器；先拷贝就会把还没读的实参覆盖掉（v2.20 实测：两个聚合形参
    // 加 sret 时，第二个形参读成了第一个）。
    let pvs = vec[int].new(12)
    let mut k = 0
    while k < f.np {
        let pty = _param_type(fc, f, k)
        let ai = k + argbase
        if ai > 3 {
            // 第 5 个起走栈（v2.29）。imm 只记"第几个栈实参"，真正的
            // 字节偏移由发射器算（要加 8*nsaved，发射期才知道）。
            let si = ai - 4
            if _ty_is_agg(pty) {
                let p = _new_var(fc, -1, TY_INT)
                _ir_emit(fc, OP_PARAMSTK, p, 0, 0, si)
                pvs.push(k)
                pvs.push(p)
                pvs.push(pty)
            } else {
                let v = _new_var(fc, _param_name(fc, f, k), pty)
                _ir_emit(fc, OP_PARAMSTK, v, 0, 0, si)
            }
            k = k + 1
            continue
        }
        if _ty_is_agg(pty) {
            let p = _new_var(fc, -1, TY_INT)
            _ir_emit(fc, OP_PARAM, p, 0, 0, ai)
            pvs.push(k)
            pvs.push(p)
            pvs.push(pty)
        } else {
            let v = _new_var(fc, _param_name(fc, f, k), pty)
            _ir_emit(fc, OP_PARAM, v, 0, 0, ai)
        }
        k = k + 1
    }
    // 第二遍：聚合形参按值拷进自己的帧区域
    let mut pi = 0
    while pi < len(pvs) {
        let pk = pvs.get(pi)
        let pp = pvs.get(pi + 1)
        let pty = pvs.get(pi + 2)
        let v = _new_var(fc, _param_name(fc, f, pk), pty)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, -fc.vloc.get(v) - 1)
        _ir_emit(fc, OP_COPY, 0, a0, pp, _ty_size(fc, pty))
        pi = pi + 3
    }
    _lower_block(fc, f.body, ep)
    if _ty_is_agg(f.ret_t) {
        _ir_emit(fc, OP_RETSRET, 0, 0, 0, 0)
    } else {
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_RET, 0, z, 0, 0)
    }
    _ir_emit(fc, OP_LAB, 0, 0, 0, ep)
}

// ---------------------------------------------------------------------------
// 线性扫描分配（只分配临时值；变量在 `_new_var` 里已固定）
// ---------------------------------------------------------------------------

fn _alloc(fc: FnCtx) {
    let n = len(fc.ir)
    // cp[i] = 下标 < i 的调用指令条数（用来判断区间是否跨调用）
    let cp = fc.cp
    let mut i = 0
    let mut c = 0
    while i <= n {
        cp.push(c)
        if i < n {
            let ins = fc.ir.get(i)
            if ins.op == OP_CALL || ins.op == OP_CALLRT || ins.op == OP_CALLIAT ||
               ins.op == OP_CALLR {
                c = c + 1          // 三类调用都会清 caller-saved
            }
        }
        i = i + 1
    }
    // 每个寄存器的"占用到哪条指令为止"
    let rend = fc.rend
    i = 0
    while i < 4 {
        rend.push(-1)
        i = i + 1
    }
    // 临时槽池（从 SLOT_TEMP 起）
    let send = fc.send
    i = 0
    while i < MAX_SLOT - SLOT_TEMP {
        send.push(-1)
        i = i + 1
    }
    let mut v = 1
    while v < len(fc.vloc) {
        if fc.vpin.get(v) == 0 && fc.vloc.get(v) == 0 {
            let st = fc.vstart.get(v)
            let mut en = fc.vend.get(v)
            if en < st {
                en = st
            }
            // 区间 (st, en] 里有调用 → caller-saved 寄存器不能用
            let crosses = cp.get(en + 1) - cp.get(st + 1)
            let mut placed = 0
            if crosses == 0 {
                let mut r = 0
                while r < 4 {
                    if rend.get(r) < st {
                        fc.vloc.set(v, _tmp_reg(r) + 1)
                        rend.set(r, en)
                        placed = 1
                        r = 4
                    } else {
                        r = r + 1
                    }
                }
            }
            if placed == 0 {
                let mut s = 0
                while s < MAX_SLOT - SLOT_TEMP {
                    if send.get(s) < st {
                        fc.vloc.set(v, -(SLOT_TEMP + s + 1))
                        send.set(s, en)
                        placed = 1
                        s = MAX_SLOT - SLOT_TEMP
                    } else {
                        s = s + 1
                    }
                }
            }
            if placed == 0 {
                eprint("qlmc: 活跃临时值超过 " + (MAX_SLOT - SLOT_TEMP).to_str() + " 个")
                exit(2)
            }
        }
        v = v + 1
    }
}

// ---------------------------------------------------------------------------
// 发射：IR → 机器码
// ---------------------------------------------------------------------------

/// 把 v 搬进寄存器 r（r 不能是 v 自己已经待着的寄存器之外的分配结果）
fn _to_reg(fc: FnCtx, r: int, v: int) {
    let loc = fc.vloc.get(v)
    if loc > 0 {
        if loc - 1 != r {
            _mov_rr(fc.code, r, loc - 1)
        }
    } else if loc < 0 {
        _mov_load(fc.code, r, RBP, _slot_disp(-loc - 1))
    } else {
        eprint("qlmc: 内部错误：值 " + v.to_str() + " 未分配位置")
        exit(2)
    }
}

/// 把寄存器 src_reg 的值搬到位置 dloc（用于 OP_PARAM）
fn _from_reg(fc: FnCtx, dloc: int, src_reg: int) {
    if dloc > 0 {
        if dloc - 1 != src_reg {
            _mov_rr(fc.code, dloc - 1, src_reg)
        }
    } else {
        _mov_store(fc.code, RBP, _slot_disp(-dloc - 1), src_reg)
    }
}

/// d = d <op> v（d 是寄存器，v 可以是寄存器或帧槽）
fn _bin_into(fc: FnCtx, d: int, v: int, op_rr: int, op_rm: int) {
    let loc = fc.vloc.get(v)
    if loc > 0 {
        _alu_rr(fc.code, op_rr, d, loc - 1)
    } else {
        _alu_rm(fc.code, op_rm, d, RBP, _slot_disp(-loc - 1))
    }
}

fn _store_rax(fc: FnCtx, dloc: int) {
    if dloc > 0 {
        if dloc - 1 != RAX {
            _mov_rr(fc.code, dloc - 1, RAX)
        }
    } else {
        _mov_store(fc.code, RBP, _slot_disp(-dloc - 1), RAX)
    }
}

fn _emit_ir(fc: FnCtx, i: int) {
    let ins = fc.ir.get(i)
    let code = fc.code
    let op = ins.op
    if op == OP_CONST {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _mov_imm(code, dloc - 1, ins.imm)
        } else {
            _mov_imm(code, RAX, ins.imm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_MOV {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _to_reg(fc, dloc - 1, ins.a)
        } else {
            _to_reg(fc, RAX, ins.a)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_ADD || op == OP_SUB || op == OP_MUL {
        let mut rr = 0x01
        let mut rm = 0x03
        if op == OP_SUB {
            rr = 0x29
            rm = 0x2B
        }
        if op == OP_MUL {
            rr = 0
            rm = 0
        }
        let dloc = fc.vloc.get(ins.dst)
        if op == OP_MUL {
            if dloc > 0 {
                let d = dloc - 1
                _to_reg(fc, d, ins.a)
                let bloc = fc.vloc.get(ins.b)
                if bloc > 0 {
                    _imul_rr(code, d, bloc - 1)
                } else {
                    _imul_rm(code, d, RBP, _slot_disp(-bloc - 1))
                }
            } else {
                _to_reg(fc, RAX, ins.a)
                let bloc = fc.vloc.get(ins.b)
                if bloc > 0 {
                    _imul_rr(code, RAX, bloc - 1)
                } else {
                    _imul_rm(code, RAX, RBP, _slot_disp(-bloc - 1))
                }
                _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
            }
            return
        }
        if dloc > 0 {
            let d = dloc - 1
            _to_reg(fc, d, ins.a)
            _bin_into(fc, d, ins.b, rr, rm)
        } else {
            _to_reg(fc, RAX, ins.a)
            _bin_into(fc, RAX, ins.b, rr, rm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_DIV || op == OP_MOD {
        _to_reg(fc, RAX, ins.a)
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            if bloc - 1 != RCX {
                _mov_rr(code, RCX, bloc - 1)
            }
            _cqo(code)
            _idiv(code, RCX)
        } else {
            _cqo(code)
            _idiv_rm(code, RBP, _slot_disp(-bloc - 1))
        }
        if op == OP_MOD {
            _mov_rr(code, RAX, RDX)
        }
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_NEG {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _to_reg(fc, dloc - 1, ins.a)
            _neg(code, dloc - 1)
        } else {
            _to_reg(fc, RAX, ins.a)
            _neg(code, RAX)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    // ---- 位运算（v2.28）：and/or/xor 与 add/sub 同形，只是 ALU 操作码不同 ----
    if op == OP_AND || op == OP_OR || op == OP_XOR {
        let mut rr = 0x21            // and
        let mut rm = 0x23
        if op == OP_OR {
            rr = 0x09
            rm = 0x0B
        }
        if op == OP_XOR {
            rr = 0x31
            rm = 0x33
        }
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let d = dloc - 1
            _to_reg(fc, d, ins.a)
            _bin_into(fc, d, ins.b, rr, rm)
        } else {
            _to_reg(fc, RAX, ins.a)
            _bin_into(fc, RAX, ins.b, rr, rm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    // 移位：计数必须在 CL（`D3 /ext`）。x86 的 64 位移位会把 CL 自动掩成 6 位，
    // 所以 `x << 64` 等于 `x << 0`——stage-0 也是这个行为（运行时不做越界检查），
    // 这里保持一致，不要自作聪明加检查。
    if op == OP_SHL || op == OP_SAR || op == OP_SHR {
        let mut ext = 4              // shl
        if op == OP_SHR {
            ext = 5                  // shr（逻辑）
        }
        if op == OP_SAR {
            ext = 7                  // sar（算术）
        }
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        _to_reg(fc, d, ins.a)
        _to_reg(fc, RCX, ins.b)
        _rex2(code, 1, 0, d)
        _b(code, 0xD3)
        _modrm(code, 3, ext, d)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_BNOT {
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        _to_reg(fc, d, ins.a)
        _rex2(code, 1, 0, d)         // F7 /2 = not r64
        _b(code, 0xF7)
        _modrm(code, 3, 2, d)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_NOT || op == OP_NZ {
        _to_reg(fc, RAX, ins.a)
        _cmp_imm0(code, RAX)
        if op == OP_NOT {
            _setcc_al(code, 0x94)
        } else {
            _setcc_al(code, 0x95)
        }
        _movzx_rax_al(code)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_CMP {
        // imm 必须是 setcc 码（0x90..0x9F）。写成 jcc 码（0x8x）会发成
        // `0F 1C` 这种**非法字节**，CPU 当多字节 NOP 执行——不报错，只是
        // 比较结果变成"上一次的 AL"。v2.27 踩过一次，这里必须拦下。
        if ins.imm < 0x90 || ins.imm > 0x9F {
            eprint("qlmc: 内部错误：OP_CMP 的条件码必须是 setcc（0x90..0x9F），拿到 " + ins.imm.to_str())
            exit(2)
        }
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            _alu_rr(code, 0x39, ar, bloc - 1)
        } else {
            _alu_rm(code, 0x3B, ar, RBP, _slot_disp(-bloc - 1))
        }
        _setcc_al(code, ins.imm)
        _movzx_rax_al(code)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_LAB {
        _setlab(fc.labs, code, ins.imm)
        return
    }
    if op == OP_JMP {
        let p = _jmp(code)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JCMP {
        // 同理：dst 必须是 jcc 码（0x80..0x8F）
        if ins.dst < 0x80 || ins.dst > 0x8F {
            eprint("qlmc: 内部错误：OP_JCMP 的条件码必须是 jcc（0x80..0x8F），拿到 " + ins.dst.to_str())
            exit(2)
        }
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            _alu_rr(code, 0x39, ar, bloc - 1)
        } else {
            _alu_rm(code, 0x3B, ar, RBP, _slot_disp(-bloc - 1))
        }
        let p = _jcc(code, ins.dst)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JZ || op == OP_JNZ {
        _to_reg(fc, RAX, ins.a)
        _cmp_imm0(code, RAX)
        let mut p = 0
        if op == OP_JZ {
            p = _jcc(code, 0x84)
        } else {
            p = _jcc(code, 0x85)
        }
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_ARG {
        _to_reg(fc, _out_arg_reg(ins.imm), ins.a)
        return
    }
    if op == OP_CALL || op == OP_CALLRT {
        let p = _call_rel(code)
        if op == OP_CALL {
            _addfix(fc.fixes, p, ins.imm, FK_FN)
        } else {
            _addfix(fc.fixes, p, ins.imm, FK_RT)
        }
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_RET {
        if ins.a > 0 {
            _to_reg(fc, RAX, ins.a)
        } else {
            _mov_imm(code, RAX, 0)
        }
        let p = _jmp(code)
        _addfix(fc.fixes, p, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_PRINT {
        if ins.imm == TY_STR {
            _to_reg(fc, RCX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PSTR, FK_RT)
        } else if ins.imm == TY_BOOL {
            _to_reg(fc, RCX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PBOOL, FK_RT)
        } else {
            _to_reg(fc, RAX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PINT, FK_RT)
        }
        return
    }
    if op == OP_EXIT {
        _to_reg(fc, RCX, ins.a)
        let p = _call_rip(code)
        _addfix(fc.fixes, p, I_EXIT, FK_IAT)
        return
    }
    if op == OP_LEA {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_STR)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_STR)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_LEN {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let d = dloc - 1
            _to_reg(fc, d, ins.a)
            _len_of(code, d, d)
        } else {
            _to_reg(fc, RAX, ins.a)
            _len_of(code, RAX, RAX)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_PARAM {
        _from_reg(fc, fc.vloc.get(ins.dst), _arg_reg_of(ins.imm))
        return
    }
    if op == OP_PARAMSTK {
        // 栈上的形参：dst = [rbp + 48 + 8*nsaved + 8*imm]
        //   返回地址在 [rbp + 8 + 8*nsaved]（序言先 push callee-saved 再 push rbp）
        //   之后是 32 字节 shadow space，再之后才是第 5 个实参
        let off = 48 + 8 * fc.cells.get(C_NSAVED) + 8 * ins.imm
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _mov_load(code, dloc - 1, RBP, off)
        } else {
            _mov_load(code, RAX, RBP, off)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_STKALLOC {
        _sub_rsp(code, ins.imm)
        return
    }
    if op == OP_STKFREE {
        _add_rsp(code, ins.imm)
        return
    }
    if op == OP_STKARG {
        // [rsp + imm] = a。RSP 当基址时 ModRM 的 rm=100 是"SIB 跟在后面"的
        // 标记，必须补一个 SIB 字节（0x24 = 无 index + base=rsp），
        // 否则 disp32 会被当成 SIB 解析，整条指令编码就错位了。
        let aloc = fc.vloc.get(ins.a)
        if aloc > 0 {
            _mov_store_rsp(code, ins.imm, aloc - 1)
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
            _mov_store_rsp(code, ins.imm, RAX)
        }
        return
    }
    if op == OP_LEAFN {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_FN)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_FN)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_RTADDR {
        // dst = &运行库例程（lea rip 相对 + FK_RT 回填）
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_RT)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_RT)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_CALLR {
        _to_reg(fc, RAX, ins.a)
        _mov_load(code, R11, RAX, 0)       // r11 = [闭包] = code
        _b(code, 0x41)                     // call r11
        _b(code, 0xFF)
        _b(code, 0xD3)
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_CALLIAT {
        let p = _call_rip(code)
        _addfix(fc.fixes, p, ins.imm, FK_IAT)
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_RETAGG {
        let sv = fc.cells.get(C_SRET)
        _to_reg(fc, RDI, sv)
        _to_reg(fc, RSI, ins.a)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        _to_reg(fc, RAX, sv)
        let p2 = _jmp(code)
        _addfix(fc.fixes, p2, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_RETSRET {
        _to_reg(fc, RAX, fc.cells.get(C_SRET))
        let p2 = _jmp(code)
        _addfix(fc.fixes, p2, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_ADDRV {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _lea_rbp(code, dloc - 1, _slot_disp(ins.imm))
        } else {
            _lea_rbp(code, RAX, _slot_disp(ins.imm))
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_ADDRF {
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _lea_rm(code, dloc - 1, ar, ins.imm)
        } else {
            _lea_rm(code, RAX, ar, ins.imm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_ADDRXN {
        // dst = a + b*imm（imul rcx, rcx, imm32）
        _to_reg(fc, RCX, ins.b)
        _b(code, 0x48)
        _b(code, 0x69)
        _b(code, 0xC9)
        _w32(code, ins.imm)
        _to_reg(fc, RAX, ins.a)
        _alu_rr(code, 0x01, RAX, RCX)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_ADDRX {
        _to_reg(fc, RCX, ins.b)
        _b(code, 0x48)                      // shl rcx, 3
        _b(code, 0xC1)
        _modrm(code, 3, 4, RCX)
        _b(code, 3)
        _to_reg(fc, RAX, ins.a)
        _alu_rr(code, 0x01, RAX, RCX)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_LOAD {
        _to_reg(fc, RAX, ins.a)
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _mov_load(code, dloc - 1, RAX, 0)
        } else {
            _mov_load(code, RAX, RAX, 0)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_STORE {
        _to_reg(fc, RAX, ins.a)
        _to_reg(fc, RCX, ins.b)
        _mov_store(code, RAX, 0, RCX)
        return
    }
    if op == OP_COPY {
        _to_reg(fc, RDI, ins.a)
        _to_reg(fc, RSI, ins.b)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        return
    }
    if op == OP_MEMCPYN {
        _to_reg(fc, RDI, ins.a)
        _to_reg(fc, RSI, ins.b)
        _to_reg(fc, RCX, ins.dst)          // 字节数（运行时）
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        return
    }
    if op == OP_ZERON {
        _to_reg(fc, RDI, ins.a)
        _to_reg(fc, RCX, ins.b)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_ZERO, FK_RT)
        return
    }
    if op == OP_ZERO {
        _to_reg(fc, RDI, ins.a)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_ZERO, FK_RT)
        return
    }
    eprint("qlmc: 内部错误：未知 IR 操作 " + op.to_str())
    exit(2)
}

/// 一个函数：序言（保存用到的 callee-saved）+ 体 + 尾声
fn _emit_fn(fc: FnCtx) {
    let code = fc.code
    let used = vec[int].new(5)
    let mut i = 0
    while i < 5 {
        used.push(0)
        i = i + 1
    }
    // 哪些 callee-saved 被变量占了（位置里出现过的）
    i = 1
    while i < len(fc.vloc) {
        let loc = fc.vloc.get(i)
        if loc > 0 {
            let k = _cs_index(loc - 1)
            if k >= 0 {
                used.set(k, 1)
            }
        }
        i = i + 1
    }
    let mut nsaved = 0
    i = 0
    while i < 5 {
        if used.get(i) == 1 {
            _push_r(code, _cs_reg(i))
            nsaved = nsaved + 1
        }
        i = i + 1
    }
    _push_rbp(code)
    _mov_rbp_rsp(code)
    // 16 字节对齐：入口 rsp ≡ 8 (mod 16)，已 push (nsaved+1) 次
    let mut frame = FRAME
    if (nsaved + 1) % 2 == 0 {
        frame = FRAME + 8
    }
    // 栈形参的偏移要加 8*nsaved（见 C_NSAVED 的注释）
    fc.cells.set(C_NSAVED, nsaved)
    _sub_rsp(code, frame)
    i = 0
    while i < len(fc.ir) {
        _emit_ir(fc, i)
        i = i + 1
    }
    _mov_rsp_rbp(code)
    _pop_rbp(code)
    i = 4
    while i >= 0 {
        if used.get(i) == 1 {
            _pop_r(code, _cs_reg(i))
        }
        i = i - 1
    }
    _ret(code)
}

/// __zero(rdi = 地址, rcx = 字节数)：逐字节清零
fn _gen_zero(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_ZERO, len(code))
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x48)                         // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)
    _addfix(ctx.fixes, p0, ldone, FK_LAB)
    _setlab(labs, code, ltop)
    _b(code, 0xC6)                         // mov byte [rdi], 0
    _b(code, 0x07)
    _b(code, 0)
    _b(code, 0x48)                         // inc rdi
    _b(code, 0xFF)
    _b(code, 0xC7)
    _b(code, 0x48)                         // dec rcx
    _b(code, 0xFF)
    _b(code, 0xC9)
    let p1 = _jcc(code, 0x85)
    _addfix(ctx.fixes, p1, ltop, FK_LAB)
    _setlab(labs, code, ldone)
    _ret(code)
}

/// __join(h)：等线程结束并取返回值（v2.32）。h = 0 直接返回 0。
///   rcx = 句柄记录：[0]=线程句柄 [1]=参数块；参数块 [0]=返回值
fn _gen_join(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_JOIN, len(code))
    let lzero = _newlab(labs)
    _b(code, 0x48)                             // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)                  // jz .zero
    _addfix(ctx.fixes, p0, lzero, FK_LAB)
    _b(code, 0x53)                             // push rbx（入口 rsp≡8，压完 ≡0）
    _b(code, 0x48)                             // mov rbx, rcx
    _b(code, 0x89)
    _b(code, 0xCB)
    _b(code, 0x48)                             // mov rcx, [rbx]（线程句柄）
    _b(code, 0x8B)
    _b(code, 0x0B)
    _b(code, 0x48)                             // mov rdx, -1（INFINITE）
    _b(code, 0xC7)
    _b(code, 0xC2)
    _w32(code, -1)
    let p1 = _call_rip(code)                   // WaitForSingleObject
    _addfix(ctx.fixes, p1, I_WAIT, FK_IAT)
    _b(code, 0x48)                             // mov rcx, [rbx]
    _b(code, 0x8B)
    _b(code, 0x0B)
    let p2 = _call_rip(code)                   // CloseHandle
    _addfix(ctx.fixes, p2, I_CLOSE, FK_IAT)
    _b(code, 0x48)                             // mov rax, [rbx+8]（参数块）
    _b(code, 0x8B)
    _b(code, 0x43)
    _b(code, 0x08)
    _b(code, 0x48)                             // mov rax, [rax]（返回值）
    _b(code, 0x8B)
    _b(code, 0x00)
    _b(code, 0x5B)                             // pop rbx
    _ret(code)
    _setlab(labs, code, lzero)
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

/// __spawn_entry(rcx = 参数块)：线程入口（ThreadProc）。
/// 块布局：[0]=返回值 [1]=目标函数地址 [2]=实参个数 [3+i]=第 i 个实参。
/// 一个入口吃所有形状——理由见 _lower_spawn 的注释（站点在发射期才知道）。
///
/// 要点：
///   ① 入口没有序言，rsp 进来是 ≡8(mod 16)；先 push rbp 把它抬成 ≡0，
///      后面 `sub rsp, stk`（stk 是 16 的倍数）才能保持对齐。
///   ② 栈实参放 `[rsp + 8*i]`：调用方约定是 `[rsp+32+8*(i-4)]`，两者相等。
///   ③ 用 rbx 存块指针（callee-saved，跨 `call [rbx+8]` 安全），
///      r12 只用来记 stk，收尾直接 `mov rsp, rbp` 更省事。
fn _gen_spawn(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_SPAWN, len(code))
    let lreg = _newlab(labs)
    let lal = _newlab(labs)
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x55)                             // push rbp
    _b(code, 0x48)                             // mov rbp, rsp
    _b(code, 0x89)
    _b(code, 0xE5)
    _b(code, 0x48)                             // mov rbx, rcx
    _b(code, 0x89)
    _b(code, 0xCB)
    _b(code, 0x4C)                             // mov r10, [rbx+16]（实参个数）
    _b(code, 0x8B)
    _b(code, 0x53)
    _b(code, 0x10)
    _b(code, 0x45)                             // xor r12d, r12d
    _b(code, 0x31)
    _b(code, 0xE4)
    _b(code, 0x49)                             // cmp r10, 4
    _b(code, 0x83)
    _b(code, 0xFA)
    _b(code, 0x04)
    let p0 = _jcc(code, 0x86)                  // jbe .noreg
    _addfix(ctx.fixes, p0, lreg, FK_LAB)
    _b(code, 0x4D)                             // mov r12, r10
    _b(code, 0x89)
    _b(code, 0xD4)
    _b(code, 0x49)                             // sub r12, 4
    _b(code, 0x83)
    _b(code, 0xEC)
    _b(code, 0x04)
    _b(code, 0x49)                             // shl r12, 3
    _b(code, 0xC1)
    _b(code, 0xE4)
    _b(code, 0x03)
    _b(code, 0x49)                             // add r12, 32（shadow space）
    _b(code, 0x83)
    _b(code, 0xC4)
    _b(code, 0x20)
    _b(code, 0x41)                             // test r12b, 8
    _b(code, 0xF6)
    _b(code, 0xC4)
    _b(code, 0x08)
    let p1 = _jcc(code, 0x84)                  // jz .aligned
    _addfix(ctx.fixes, p1, lal, FK_LAB)
    _b(code, 0x49)                             // add r12, 8
    _b(code, 0x83)
    _b(code, 0xC4)
    _b(code, 0x08)
    _setlab(labs, code, lal)
    _b(code, 0x4C)                             // sub rsp, r12
    _b(code, 0x29)
    _b(code, 0xE4)
    _b(code, 0x48)                             // mov rcx, 4（从第 5 个实参开始拷）
    _b(code, 0xC7)
    _b(code, 0xC1)
    _w32(code, 4)
    _setlab(labs, code, ltop)
    _b(code, 0x4C)                             // cmp rcx, r10
    _b(code, 0x39)
    _b(code, 0xD1)
    let p2 = _jcc(code, 0x83)                  // jae .done
    _addfix(ctx.fixes, p2, ldone, FK_LAB)
    _b(code, 0x48)                             // mov rax, [rbx+rcx*8+24]
    _b(code, 0x8B)
    _b(code, 0x44)
    _b(code, 0xCB)
    _b(code, 24)
    _b(code, 0x48)                             // mov [rsp+rcx*8], rax
    _b(code, 0x89)
    _b(code, 0x04)
    _b(code, 0xCC)
    _b(code, 0x48)                             // inc rcx
    _b(code, 0xFF)
    _b(code, 0xC1)
    let p3 = _jmp(code)
    _addfix(ctx.fixes, p3, ltop, FK_LAB)
    _setlab(labs, code, ldone)
    _setlab(labs, code, lreg)
    _b(code, 0x48)                             // mov rcx, [rbx+24]
    _b(code, 0x8B)
    _b(code, 0x4B)
    _b(code, 24)
    _b(code, 0x48)                             // mov rdx, [rbx+32]
    _b(code, 0x8B)
    _b(code, 0x53)
    _b(code, 32)
    _b(code, 0x4C)                             // mov r8, [rbx+40]
    _b(code, 0x8B)
    _b(code, 0x43)
    _b(code, 40)
    _b(code, 0x4C)                             // mov r9, [rbx+48]
    _b(code, 0x8B)
    _b(code, 0x4B)
    _b(code, 48)
    _b(code, 0xFF)                             // call [rbx+8]
    _b(code, 0x53)
    _b(code, 0x08)
    _b(code, 0x48)                             // mov [rbx], rax（写回返回值）
    _b(code, 0x89)
    _b(code, 0x03)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x5D)                             // pop rbp
    _b(code, 0x31)                             // xor eax, eax（ThreadProc 返回 0）
    _b(code, 0xC0)
    _ret(code)
}

// ---------------------------------------------------------------------------
// 并行：一个工作线程编译 [lo, hi) 区间的函数
//
// arb 布局（主线程按 8 字节字索引读写）：
//   [0 .. 63]        工作线程表，每线程 8 字：lo, hi, base, cap
//   [HDR_BASE .. ]   函数表，每函数 6 字：code_off, code_len, lab_off,
//                    lab_cnt, fix_off, fix_cnt
// 每个线程在自己那段里**顺序 bump**，所以不需要任何锁；每个函数写自己那 6 字，
// 也没有竞争。
// ---------------------------------------------------------------------------

const HDR_BASE = 64
const FN_HDR = 7
const MAX_THREADS = 8
const ARENA_CAP = 16 * 1024 * 1024

fn _compile_range(hdr: int, wid: int, nodes: vec[Node], names: vec[str],
                  strs: vec[str], fns: vec[Fn], rt: vec[int], stt: vec[int]) -> int {
    let lo = mem_load64(hdr, wid * 8)
    let hi = mem_load64(hdr, wid * 8 + 1)
    let base = mem_load64(hdr, wid * 8 + 2)
    let cap = mem_load64(hdr, wid * 8 + 3)
    let fc = _new_fc(nodes, names, fns, rt, stt)
    let mut off = 0
    let mut fi = lo
    while fi < hi {
        _fc_reset(fc)
        _lower_fn(fc, fi)
        _alloc(fc)
        _emit_fn(fc)
        let code = fc.code
        let labs = fc.labs
        let fixes = fc.fixes
        if off + len(code) + len(labs) * 8 + len(fixes) * 24 + 64 > cap {
            eprint("qlmc: 编译缓冲不够（线程 " + wid.to_str() + "）")
            exit(2)
        }
        let coff = off
        let mut i = 0
        while i < len(code) {
            mem_store8(base, off, code.get(i))
            off = off + 1
            i = i + 1
        }
        while off % 8 != 0 {
            mem_store8(base, off, 0)
            off = off + 1
        }
        let loff = off
        i = 0
        while i < len(labs) {
            mem_store64(base, off / 8, labs.get(i))
            off = off + 8
            i = i + 1
        }
        let foff = off
        i = 0
        while i < len(fixes) {
            let fx = fixes.get(i)
            mem_store64(base, off / 8, fx.pos)
            mem_store64(base, off / 8 + 1, fx.id)
            mem_store64(base, off / 8 + 2, fx.kind)
            off = off + 24
            i = i + 1
        }
        let h = HDR_BASE + fi * FN_HDR
        mem_store64(hdr, h, coff)
        mem_store64(hdr, h + 1, len(code))
        mem_store64(hdr, h + 2, loff)
        mem_store64(hdr, h + 3, len(labs))
        mem_store64(hdr, h + 4, foff)
        mem_store64(hdr, h + 5, len(fixes))
        mem_store64(hdr, h + 6, base)
        fi = fi + 1
    }
    return off
}

// ---------------------------------------------------------------------------
// 运行库：bool 打印（v2.16 从发射器里的分支序列提成例程）
// ---------------------------------------------------------------------------

/// __print_bool(rcx = 0/1)：true/false + 换行
fn _gen_print_bool(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_PBOOL, len(code))
    let lf = _newlab(labs)
    let le = _newlab(labs)
    _cmp_imm0(code, RCX)
    let p = _jcc(code, 0x84)
    _addfix(ctx.fixes, p, lf, FK_LAB)
    let at = len(code) + 3
    _lea_rip(code, RCX, 0)
    _addfix(ctx.fixes, at, ctx.str_true, FK_STR)
    _call_rt(ctx, RT_PSTR)
    let p2 = _jmp(code)
    _addfix(ctx.fixes, p2, le, FK_LAB)
    _setlab(labs, code, lf)
    let at2 = len(code) + 3
    _lea_rip(code, RCX, 0)
    _addfix(ctx.fixes, at2, ctx.str_false, FK_STR)
    _call_rt(ctx, RT_PSTR)
    _setlab(labs, code, le)
    _ret(code)
}

// ---- 切片（v2.22）：视图 = (ptr, len) 两字聚合 ----

/// i >= len 就 exit(1)（无符号比较，负数也拦）
fn _slice_check(fc: FnCtx, i: int, n: int) {
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x83, i, n, lfail)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

/// `a[lo..hi]`：数组 / vec / 切片都能切，结果是一个 (ptr, len) 视图
fn _lower_slice(fc: FnCtx, nd: Node) -> int {
    let bty = _ty_of_expr(fc, nd.a)
    let mut elem = TY_INT
    let mut base = 0
    let mut blen = 0
    if bty >= TY_SLICE && bty < TY_ARRAY {
        let sv = _lower_expr(fc, nd.a)
        elem = bty - TY_SLICE
        base = _vnew(fc)
        fc.vty.set(base, TY_INT)
        _ir_emit(fc, OP_LOAD, base, sv, 0, 8)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
        blen = _vnew(fc)
        fc.vty.set(blen, TY_INT)
        _ir_emit(fc, OP_LOAD, blen, la, 0, 8)
    } else if bty >= TY_VEC && bty < TY_MAP {
        let h = _lower_expr(fc, nd.a)
        elem = bty - TY_VEC
        base = _pin(fc, _vec_field(fc, h, 0))     // 数据块基址
        blen = _vec_field(fc, h, 8)
    } else if bty >= TY_ARRAY {
        elem = _ty_elem(bty)
        base = _addr_of(fc, nd.a)
        blen = _map_const(fc, _ty_size(fc, bty) / 8)
    } else {
        eprint("qlmc: 只有数组 / vec / 切片能切片")
        exit(2)
    }
    let lo = _pin(fc, _lower_expr(fc, nd.b))
    let hi = _pin(fc, _lower_expr(fc, nd.c))
    // lo <= hi 且 hi <= blen
    let l1 = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x87, lo, hi, l1)      // ja：lo > hi → 越界
    let l2 = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x87, hi, blen, l2)    // hi > blen → 越界
    let lok = _newlab(fc.labs)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, l1)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, l2)
    let one2 = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one2, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
    // 视图落进隐藏聚合变量
    let ty = TY_SLICE + elem
    let v = _new_var(fc, -1, ty)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRV, va, 0, 0, -fc.vloc.get(v) - 1)
    let eight = _map_const(fc, 8)
    let off8 = _vnew(fc)
    fc.vty.set(off8, TY_INT)
    _ir_emit(fc, OP_MUL, off8, lo, eight, 0)
    let ptr = _vnew(fc)
    fc.vty.set(ptr, TY_INT)
    _ir_emit(fc, OP_ADD, ptr, base, off8, 0)
    _ir_emit(fc, OP_STORE, 0, va, ptr, 8)
    let la2 = _vnew(fc)
    fc.vty.set(la2, TY_INT)
    _ir_emit(fc, OP_ADDRF, la2, va, 0, 8)
    let n = _vnew(fc)
    fc.vty.set(n, TY_INT)
    _ir_emit(fc, OP_SUB, n, hi, lo, 0)
    _ir_emit(fc, OP_STORE, 0, la2, n, 8)
    fc.vty.set(va, ty)
    return va
}

// ---- map（v2.21）：固定容量 + 线性扫描；布局 [cap][count] + cap*(key,val) ----
// 约定：键槽为 0 表示空位（所以 int 键不能用 0，str 键的 null 天然表示空）。

/// 把值钉进变量。**跨循环回边存活的值必须 pin**：临时值的活跃区间不覆盖回边，
/// 分配器会把它的槽位复用掉（v2.21 实测：map 的 cap16 被复用成 slot 地址）。
fn _pin(fc: FnCtx, v: int) -> int {
    let d = _new_var(fc, -1, TY_INT)
    _ir_emit(fc, OP_MOV, d, v, 0, 0)
    return d
}

fn _map_base(fc: FnCtx, h: int) -> int {
    let b = _vnew(fc)
    fc.vty.set(b, TY_INT)
    _ir_emit(fc, OP_ADDRF, b, h, 0, 16)
    return b
}

fn _map_const(fc: FnCtx, v: int) -> int {
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_CONST, d, 0, 0, v)
    return d
}

/// 线性扫描，返回**命中的槽地址**或**第一个空槽地址**（满了就 exit(1)）。
/// 调用方自己再读一次键就能区分"命中"还是"空位"。
fn _map_slot_of(fc: FnCtx, h: int, k0: int) -> int {
    let cap = _vec_field(fc, h, 0)
    let sixteen = _pin(fc, _map_const(fc, 16))
    let c16 = _vnew(fc)
    fc.vty.set(c16, TY_INT)
    _ir_emit(fc, OP_MUL, c16, cap, sixteen, 0)
    let cap16 = _pin(fc, c16)
    let base = _pin(fc, _map_base(fc, h))
    let off = _pin(fc, _map_const(fc, 0))
    let zero = _pin(fc, _map_const(fc, 0))
    let k = _pin(fc, k0)
    let ltop = _newlab(fc.labs)
    let lfull = _newlab(fc.labs)
    let ldone = _newlab(fc.labs)
    let slot = _pin(fc, _map_const(fc, 0))
    _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
    _ir_emit(fc, OP_JCMP, 0x83, off, cap16, lfull)
    let sa = _vnew(fc)
    fc.vty.set(sa, TY_INT)
    _ir_emit(fc, OP_ADD, sa, base, off, 0)
    _ir_emit(fc, OP_MOV, slot, sa, 0, 0)
    let key = _vnew(fc)
    fc.vty.set(key, TY_INT)
    _ir_emit(fc, OP_LOAD, key, slot, 0, 8)
    _ir_emit(fc, OP_JCMP, 0x84, key, zero, ldone)     // 空位 → 就用它
    _ir_emit(fc, OP_JCMP, 0x84, key, k, ldone)        // 键相同 → 命中
    let nx = _vnew(fc)
    fc.vty.set(nx, TY_INT)
    _ir_emit(fc, OP_ADD, nx, off, sixteen, 0)
    _ir_emit(fc, OP_MOV, off, nx, 0, 0)
    _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfull)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, ldone)
    return slot
}

fn _map_new(fc: FnCtx, nd: Node) -> int {
    let n = _pin(fc, _lower_expr(fc, nd.b))
    let sixteen = _map_const(fc, 16)
    let per0 = _vnew(fc)
    fc.vty.set(per0, TY_INT)
    _ir_emit(fc, OP_MUL, per0, n, sixteen, 0)
    let per = _pin(fc, per0)
    let total = _vnew(fc)
    fc.vty.set(total, TY_INT)
    _ir_emit(fc, OP_ADD, total, per, sixteen, 0)
    _ir_emit(fc, OP_ARG, 0, total, 0, 0)
    let h = _vnew(fc)
    fc.vty.set(h, TY_MAP + (nd.a << 8) + nd.c)
    _ir_emit(fc, OP_CALLRT, h, 0, 0, RT_ALLOC)
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, h, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, n, 8)
    let z = _map_const(fc, 0)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, z, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, h, 0, 16)
    _ir_emit(fc, OP_ZERON, 0, a2, per, 0)
    return h
}

/// m.set(k, v)：空位就插入并 count++，已有就覆盖
fn _map_set(fc: FnCtx, nd: Node, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let v = _lower_expr(fc, nd.n)
    let slot = _map_slot_of(fc, h, k)
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let lskip = _newlab(fc.labs)
    let ldone = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x85, old, zero, lskip)     // 非空 → 只覆盖值
    _ir_emit(fc, OP_STORE, 0, slot, k, 8)
    let cnt = _vec_field(fc, h, 8)
    let one = _map_const(fc, 1)
    let nc = _vnew(fc)
    fc.vty.set(nc, TY_INT)
    _ir_emit(fc, OP_ADD, nc, cnt, one, 0)
    let ca = _vnew(fc)
    fc.vty.set(ca, TY_INT)
    _ir_emit(fc, OP_ADDRF, ca, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, ca, nc, 8)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lskip)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRF, va, slot, 0, 8)
    _ir_emit(fc, OP_STORE, 0, va, v, 8)
    _ir_emit(fc, OP_LAB, 0, 0, 0, ldone)
    let d = _map_const(fc, 0)
    return d
}

/// m.get(k)：命中读值，空位返回 0
fn _map_get(fc: FnCtx, nd: Node, vty: int, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let slot = _map_slot_of(fc, h, k)
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let d = _vnew(fc)
    fc.vty.set(d, vty)
    _ir_emit(fc, OP_CONST, d, 0, 0, 0)
    let lmiss = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x84, old, zero, lmiss)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRF, va, slot, 0, 8)
    _ir_emit(fc, OP_LOAD, d, va, 0, 8)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lmiss)
    return d
}

/// m.has(k) → 1/0
fn _map_has(fc: FnCtx, nd: Node, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let slot = _map_slot_of(fc, h, k)
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let d = _map_const(fc, 0)
    fc.vty.set(d, TY_BOOL)
    let lmiss = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x84, old, zero, lmiss)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_MOV, d, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lmiss)
    return d
}

// ---- vec 运行时辅助（v2.19；放在文件末尾，避免扰动既有函数的代码布局）----
//
// v2.27：布局改成和 stage-0 一致的「头块 + 独立数据块」：
//   [h+0]=data 指针  [h+8]=len  [h+16]=cap
// 旧布局是 [len][cap][data...] 单块，数据紧跟在头后面，一旦扩容就必须换整块，
// 句柄随之变化——任何别名变量（`let w = v`、vec[vec[T]] 的元素）立刻悬垂。
// 头块独立后，扩容只改 [h+0]/[h+16]，句柄恒定，别名问题从根上消失。

/// 读头字段：[h + off]（off = 0 数据指针 / 8 长度 / 16 容量）
fn _vec_field(fc: FnCtx, h: int, off: int) -> int {
    let a = _vnew(fc)
    fc.vty.set(a, TY_INT)
    _ir_emit(fc, OP_ADDRF, a, h, 0, off)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_LOAD, d, a, 0, 8)
    return d
}

/// 越界就 exit(1)：`jb` 是**无符号**比较，负数下标也会被拦下
fn _vec_check(fc: FnCtx, h: int, i: int) {
    let n = _vec_field(fc, h, 8)
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x83, i, n, lfail)   // jae：i >= len 就越界
    _ir_emit(fc, OP_JMP, 0, 0, 0, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let one = _vnew(fc)
    fc.vty.set(one, TY_INT)
    _ir_emit(fc, OP_CONST, one, 0, 0, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

/// 元素地址 = data + i*stride（data 是**数据块**基址，不是句柄）。
/// stride = 8 走 `shl 3` 的快路径；聚合元素用 `OP_ADDRXN`（imul）——vec[Struct]
/// 的元素步长是结构体字节数，v2.31 起才存在这种情况。
fn _vec_elem_addr(fc: FnCtx, data: int, i: int, stride: int) -> int {
    let a = _vnew(fc)
    fc.vty.set(a, TY_INT)
    if stride == 8 {
        _ir_emit(fc, OP_ADDRX, a, data, i, 8)
    } else {
        _ir_emit(fc, OP_ADDRXN, a, data, i, stride)
    }
    return a
}

/// **冷路径**：容量翻倍、分配新数据块、搬旧数据、更新头。只改 [h+0] 与 [h+16]。
///
/// 这里刻意**不接收也不返回** len/cap/data——全部自己重新读一遍。原因：
/// push 的常见路径是"还有空间"，那条路上不应该为扩容付出任何代价（v2.27 第一版
/// 把 len/cap/data 提前钉进帧槽，push 的机器码从 26 条涨到 ~40 条）。把读+钉
/// 全塞进冷路径后，常见路径只剩 `cmp+jl` 加一次重新读 len。
///
/// ncp = max(cap*2, 4)：new(0) 的容量是 0，翻倍还是 0，必须兜底成 4，
/// 否则 push 会往 0 字节的块里写，踩下一块堆。
fn _vec_grow_body(fc: FnCtx, h: int, stride: int) {
    let hp = _pin(fc, h)
    let len = _pin(fc, _vec_field(fc, hp, 8))
    let cap = _pin(fc, _vec_field(fc, hp, 16))
    let old = _pin(fc, _vec_field(fc, hp, 0))
    // ncp = cap*2，下限 4
    let two = _vnew(fc)
    fc.vty.set(two, TY_INT)
    _ir_emit(fc, OP_CONST, two, 0, 0, 2)
    let d2 = _vnew(fc)
    fc.vty.set(d2, TY_INT)
    _ir_emit(fc, OP_MUL, d2, cap, two, 0)
    let ncp = _new_var(fc, -1, TY_INT)
    _ir_emit(fc, OP_MOV, ncp, d2, 0, 0)
    let four = _vnew(fc)
    fc.vty.set(four, TY_INT)
    _ir_emit(fc, OP_CONST, four, 0, 0, 4)
    let lt = _vnew(fc)
    fc.vty.set(lt, TY_INT)
    _ir_emit(fc, OP_CMP, lt, d2, four, 0x9C)       // setl（imm 是 setcc 码，不是 jcc 码）
    let lge = _newlab(fc.labs)
    _ir_emit(fc, OP_JZ, 0, lt, 0, lge)
    _ir_emit(fc, OP_MOV, ncp, four, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lge)
    // 分配 ncp*stride 字节
    let eight = _vnew(fc)
    fc.vty.set(eight, TY_INT)
    _ir_emit(fc, OP_CONST, eight, 0, 0, stride)
    let nb = _vnew(fc)
    fc.vty.set(nb, TY_INT)
    _ir_emit(fc, OP_MUL, nb, ncp, eight, 0)
    _ir_emit(fc, OP_ARG, 0, nb, 0, 0)
    let nd = _vnew(fc)
    fc.vty.set(nd, TY_INT)
    _ir_emit(fc, OP_CALLRT, nd, 0, 0, RT_ALLOC)
    let dp = _pin(fc, nd)
    // 搬 len*stride 字节（运行时长度 → OP_MEMCPYN）
    let eight2 = _vnew(fc)
    fc.vty.set(eight2, TY_INT)
    _ir_emit(fc, OP_CONST, eight2, 0, 0, stride)
    let cb = _vnew(fc)
    fc.vty.set(cb, TY_INT)
    _ir_emit(fc, OP_MUL, cb, len, eight2, 0)
    _ir_emit(fc, OP_MEMCPYN, cb, dp, old, 0)
    // 更新头
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, hp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, dp, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, hp, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, ncp, 8)
}

/// vec[T].new(n)：头块 24 字节 [data][len][cap] + 独立数据块 n*8
fn _lower_vecnew(fc: FnCtx, nd: Node) -> int {
    let n = _pin(fc, _lower_expr(fc, nd.b))
    let h = _vnew(fc)
    fc.vty.set(h, TY_VEC + nd.a)
    let hdr = _vnew(fc)
    fc.vty.set(hdr, TY_INT)
    _ir_emit(fc, OP_CONST, hdr, 0, 0, 24)
    _ir_emit(fc, OP_ARG, 0, hdr, 0, 0)
    _ir_emit(fc, OP_CALLRT, h, 0, 0, RT_ALLOC)
    // 数据块 = cap * 元素步长（聚合元素时步长是结构体字节数，v2.31）
    let stride = _ty_size(fc, nd.a)
    let stv = _vnew(fc)
    fc.vty.set(stv, TY_INT)
    _ir_emit(fc, OP_CONST, stv, 0, 0, stride)
    let bytes = _vnew(fc)
    fc.vty.set(bytes, TY_INT)
    _ir_emit(fc, OP_MUL, bytes, n, stv, 0)
    _ir_emit(fc, OP_ARG, 0, bytes, 0, 0)
    let data = _vnew(fc)
    fc.vty.set(data, TY_INT)
    _ir_emit(fc, OP_CALLRT, data, 0, 0, RT_ALLOC)
    // 这里之后没有调用了，h / data 不用 pin（跨调用的活跃由分配器的 cp[] 兜住）
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, h, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, data, 8)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, z, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, h, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, n, 8)
    return h
}

/// 方法分发：vec 与 map 共用（按接收者类型分派）
/// spawn f(args) -> 任务句柄（v2.32）。
///
/// 参数块布局（24 + 8n 字节，多给 8 字节余量给入口读 4 个寄存器实参）：
///   [0]  返回值（worker 写回）
///   [1]  目标函数地址
///   [2]  实参个数
///   [3+i] 第 i 个实参
/// 为什么把"函数地址 + 实参个数"塞进块里：函数体是**并行编译**的，spawn 站点
/// 在发射期才知道，没法往顺序段里追加"每个站点一个入口例程"。所以做成一个
/// 通用入口 `__spawn_entry`（见 _gen_spawn），所有形状共用一个。
fn _lower_spawn(fc: FnCtx, nd: Node) -> int {
    let fi = _fn_index(fc, nd.a)
    if fi < 0 {
        // 注意：这里**故意**不拼字符串。v2.32 实测，只要 _lower_spawn 里出现
        // `eprint("..." + expr)` 这种拼接，s3_manyfns 的编译就从 19 ms 涨到 33 ms
        // （这段代码从不执行，纯 stage-0 代码生成的敏感性，见坑表 #35）。
        eprint("qlmc: spawn 的目标必须是用户函数")
        exit(2)
    }
    let f = fc.fns.get(fi)
    if f.body < 0 {
        eprint("qlmc: spawn 的目标不能是 @ffi 声明")
        exit(2)
    }
    if _ty_is_agg(f.ret_t) {
        eprint("qlmc: spawn 暂不支持聚合返回值")
        exit(2)
    }
    if f.ret_t == TY_STR {
        eprint("qlmc: spawn 暂不支持 str 返回值")
        exit(2)
    }
    let av = _call_args(fc, nd)
    if len(av) != f.np {
        eprint("qlmc: spawn 的实参个数与目标函数形参不符")
        exit(2)
    }
    let vals = vec[int].new(4)
    let mut ai = 0
    while ai < len(av) {
        let v = _lower_expr(fc, av.get(ai))
        if _ty_is_agg(fc.vty.get(v)) {
            eprint("qlmc: spawn 的实参暂不支持聚合")
            exit(2)
        }
        vals.push(v)
        ai = ai + 1
    }
    let n = len(vals)
    let sz = _vnew(fc)
    fc.vty.set(sz, TY_INT)
    _ir_emit(fc, OP_CONST, sz, 0, 0, 32 + 8 * n)
    _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
    let blk = _vnew(fc)
    fc.vty.set(blk, TY_INT)
    _ir_emit(fc, OP_CALLRT, blk, 0, 0, RT_ALLOC)
    let bp = _pin(fc, blk)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, bp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, z, 8)
    let fa = _vnew(fc)
    fc.vty.set(fa, TY_INT)
    _ir_emit(fc, OP_LEAFN, fa, 0, 0, fi)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, bp, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, fa, 8)
    let nn = _vnew(fc)
    fc.vty.set(nn, TY_INT)
    _ir_emit(fc, OP_CONST, nn, 0, 0, n)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, bp, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, nn, 8)
    let mut i = 0
    while i < n {
        let ax = _vnew(fc)
        fc.vty.set(ax, TY_INT)
        _ir_emit(fc, OP_ADDRF, ax, bp, 0, 24 + 8 * i)
        _ir_emit(fc, OP_STORE, 0, ax, vals.get(i), 8)
        i = i + 1
    }
    // CreateThread(0, 0, &__spawn_entry, blk, 0, 0)：6 个实参，后两个走栈
    let entry = _vnew(fc)
    fc.vty.set(entry, TY_INT)
    _ir_emit(fc, OP_RTADDR, entry, 0, 0, RT_SPAWN)
    let ep = _pin(fc, entry)
    let cargs = vec[int].new(6)
    let z1 = _vnew(fc)
    fc.vty.set(z1, TY_INT)
    _ir_emit(fc, OP_CONST, z1, 0, 0, 0)
    let z2 = _vnew(fc)
    fc.vty.set(z2, TY_INT)
    _ir_emit(fc, OP_CONST, z2, 0, 0, 0)
    let z3 = _vnew(fc)
    fc.vty.set(z3, TY_INT)
    _ir_emit(fc, OP_CONST, z3, 0, 0, 0)
    let z4 = _vnew(fc)
    fc.vty.set(z4, TY_INT)
    _ir_emit(fc, OP_CONST, z4, 0, 0, 0)
    cargs.push(z1)
    cargs.push(z2)
    cargs.push(ep)
    cargs.push(bp)
    cargs.push(z3)
    cargs.push(z4)
    let stk = _emit_call_args(fc, cargs, 0)
    let h = _vnew(fc)
    fc.vty.set(h, TY_INT)
    _ir_emit(fc, OP_CALLIAT, h, 0, 0, I_CREATE)
    _emit_call_free(fc, stk)
    // 句柄记录：[0]=线程句柄 [1]=参数块（join 用它取返回值）
    let hp = _pin(fc, h)
    let r16 = _vnew(fc)
    fc.vty.set(r16, TY_INT)
    _ir_emit(fc, OP_CONST, r16, 0, 0, 16)
    _ir_emit(fc, OP_ARG, 0, r16, 0, 0)
    let rec = _vnew(fc)
    fc.vty.set(rec, TY_INT)
    _ir_emit(fc, OP_CALLRT, rec, 0, 0, RT_ALLOC)
    let rp = _pin(fc, rec)
    let b0 = _vnew(fc)
    fc.vty.set(b0, TY_INT)
    _ir_emit(fc, OP_ADDRF, b0, rp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, b0, hp, 8)
    let b1 = _vnew(fc)
    fc.vty.set(b1, TY_INT)
    _ir_emit(fc, OP_ADDRF, b1, rp, 0, 8)
    _ir_emit(fc, OP_STORE, 0, b1, bp, 8)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_MOV, d, rp, 0, 0)
    return d
}

fn _lower_method(fc: FnCtx, nd: Node) -> int {
    let h = _lower_expr(fc, nd.a)
    let hty = fc.vty.get(h)
    if hty >= TY_MAP && hty < TY_ARRAY {
        let hp = _pin(fc, h)      // 句柄要跨循环存活
        let m = fc.names.get(nd.b)
        let vt = (hty - TY_MAP) & 0xFF
        if m == "set" {
            return _map_set(fc, nd, hp)
        }
        if m == "get" {
            return _map_get(fc, nd, vt, hp)
        }
        if m == "has" {
            return _map_has(fc, nd, hp)
        }
        if m == "len" {
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_MOV, d, _vec_field(fc, hp, 8), 0, 0)
            return d
        }
        eprint("qlmc: map 只支持 .set(k,v) / .get(k) / .has(k) / .len()")
        exit(2)
    }
    if hty < TY_VEC || hty >= TY_ARRAY {
        eprint("qlmc: 只有 vec 有 .push/.get/.len 方法")
        exit(2)
    }
    let et = hty - TY_VEC
    let stride = _ty_size(fc, et)
    let eagg = _ty_is_agg(et)
    let m = fc.names.get(nd.b)
    if m == "len" {
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
        return d
    }
    if m == "push" {
        if nd.c < 0 {
            eprint("qlmc: push 需要一个实参")
            exit(2)
        }
        let x = _pin(fc, _lower_expr(fc, nd.c))
        let hp = _pin(fc, h)
        // 常见路径只要"比较一次"：满了才进冷路径（_vec_grow_body 自己重读头字段）
        let len0 = _vec_field(fc, hp, 8)
        let cap0 = _vec_field(fc, hp, 16)
        let lpush = _newlab(fc.labs)
        _ir_emit(fc, OP_JCMP, 0x8C, len0, cap0, lpush)   // jl：还有空间
        _vec_grow_body(fc, hp, stride)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lpush)
        // 扩容会换数据块，所以 len/data 在汇合点之后重新读（顺带保证不跨调用）
        let len = _vec_field(fc, hp, 8)
        let data = _vec_field(fc, hp, 0)
        let addr = _vec_elem_addr(fc, data, len, stride)
        if eagg {
            // 聚合元素：槽里存的是**值**，不是指针 → 整块拷进去
            _ir_emit(fc, OP_COPY, 0, addr, x, stride)
        } else {
            _ir_emit(fc, OP_STORE, 0, addr, x, 8)
        }
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        let nl = _vnew(fc)
        fc.vty.set(nl, TY_INT)
        _ir_emit(fc, OP_ADD, nl, len, one, 0)
        let ah = _vnew(fc)
        fc.vty.set(ah, TY_INT)
        _ir_emit(fc, OP_ADDRF, ah, hp, 0, 8)
        _ir_emit(fc, OP_STORE, 0, ah, nl, 8)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if m == "get" {
        if nd.c < 0 {
            eprint("qlmc: get 需要一个实参")
            exit(2)
        }
        let i = _lower_expr(fc, nd.c)
        _vec_check(fc, h, i)
        let data = _vec_field(fc, h, 0)
        let addr = _vec_elem_addr(fc, data, i, stride)
        let d = _vnew(fc)
        fc.vty.set(d, et)
        if eagg {
            // 聚合值 = 区域地址（与字段/下标读同一约定）。
            // 数据块是 bump 分配的、扩容也不回收旧块，所以这个地址稳定。
            _ir_emit(fc, OP_MOV, d, addr, 0, 0)
        } else {
            _ir_emit(fc, OP_LOAD, d, addr, 0, 8)
        }
        return d
    }
    if m == "set" {
        if nd.n < 0 {
            eprint("qlmc: set 需要两个实参")
            exit(2)
        }
        let i = _lower_expr(fc, nd.c)
        let x = _lower_expr(fc, nd.n)
        _vec_check(fc, h, i)
        let data = _vec_field(fc, h, 0)
        let addr = _vec_elem_addr(fc, data, i, stride)
        if eagg {
            _ir_emit(fc, OP_COPY, 0, addr, x, stride)
        } else {
            _ir_emit(fc, OP_STORE, 0, addr, x, 8)
        }
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    eprint("qlmc: vec 只支持 .push(x) / .get(i) / .set(i,x) / .len()")
    exit(2)
    return 0
}




// 运行库（机器码手写）
//
// 约定：入口 rsp ≡ 8 (mod 16)；先 `sub rsp, 0x58`（88 → 8+88 ≡ 0）再调 Win32，
// 这样每次 call 前 rsp 都是 16 对齐的。跨调用要用的值一律落 [rsp+0x20..]。
// ---------------------------------------------------------------------------

/// __print_i64(rax = 值)：wsprintfA("%I64d\n") + WriteFile
fn _gen_print_i64(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PINT, len(code))
    _sub_rsp(code, 0x68)
    _lea_rsp(code, RCX, 0x30)
    let f1 = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, f1, -2, 2)          // id -2 = 格式串
    _mov_rr(code, R8, RAX)
    _b(code, 0x31)                         // xor eax, eax（varargs: AL=0）
    _b(code, 0xC0)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_WSPRINTF, 3)
    _mov_rsp_store(code, 0x28, RAX)        // 长度
    _mov_imm(code, RCX, -11)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _lea_rsp(code, RDX, 0x30)
    _mov_rsp_load(code, R8, 0x28)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __print_str(rcx = str)：写 len 字节 + 一个换行
fn _gen_print_str(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PSTR, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // 保存 str
    _mov_imm(code, RCX, -11)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rsp_store(code, 0x30, RAX)        // 句柄
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    // 换行
    _mov_rsp_load(code, RCX, 0x30)
    let at = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, at, -3, 2)          // id -3 = 换行字节
    _mov_imm(code, R8, 1)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __die(rcx = 消息 str)：写 stderr（handle -12）后 exit(1)
fn _gen_die(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_DIE, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)
    _mov_imm(code, RCX, -12)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    _mov_imm(code, RCX, 1)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_EXIT, 3)
    _ret(code)
}

/// __memcpy(rdi = dst, rsi = src, rcx = n)
fn _gen_memcpy(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMCPY, len(code))
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x48)                         // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)
    _addfix(ctx.fixes, p0, ldone, 1)
    _setlab(labs, code, ltop)
    _b(code, 0x8A)                         // mov al, [rsi]
    _b(code, 0x06)
    _b(code, 0x88)                         // mov [rdi], al
    _b(code, 0x07)
    _b(code, 0x48)                         // inc rsi
    _b(code, 0xFF)
    _b(code, 0xC6)
    _b(code, 0x48)                         // inc rdi
    _b(code, 0xFF)
    _b(code, 0xC7)
    _b(code, 0x48)                         // dec rcx
    _b(code, 0xFF)
    _b(code, 0xC9)
    let p1 = _jcc(code, 0x85)              // jnz .loop
    _addfix(ctx.fixes, p1, ltop, 1)
    _setlab(labs, code, ldone)
    _ret(code)
}

/// __str_cat(rcx = a, rdx = b) -> rax：新分配 [len][bytes][NUL]
fn _gen_str_cat(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_CAT, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // a
    _mov_rsp_store(code, 0x30, RDX)        // b
    _len_of(code, R8, RCX)                 // la
    _mov_rsp_store(code, 0x38, R8)
    _len_of(code, R9, RDX)                 // lb
    _mov_rsp_store(code, 0x40, R9)
    _mov_rr(code, RCX, R8)                 // n = la + lb + 9
    _alu_rr(code, 0x01, RCX, R9)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC1)
    _b(code, 9)
    _call_rt(ctx, RT_ALLOC)
    _mov_rsp_store(code, 0x48, RAX)        // 块首
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _mov_rr(code, R10, R8)                 // total = la + lb
    _alu_rr(code, 0x01, R10, R9)
    _mov_store(code, RAX, 0, R10)          // [块首] = total
    _lea_rsp(code, RDI, 0x50)              // 复用不了：直接算 data = 块首 + 8
    _mov_rsp_load(code, RDI, 0x48)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC7)
    _b(code, 8)                            // add rdi, 8
    _mov_rsp_store(code, 0x50, RDI)        // data
    // 拷 a
    _mov_rsp_load(code, RSI, 0x28)
    _mov_rsp_load(code, RCX, 0x38)
    _call_rt(ctx, RT_MEMCPY)
    // 拷 b：dst = data + la
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _alu_rr(code, 0x01, RDI, R8)
    _mov_rsp_load(code, RSI, 0x30)
    _mov_rsp_load(code, RCX, 0x40)
    _call_rt(ctx, RT_MEMCPY)
    // NUL
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _alu_rr(code, 0x01, RDI, R8)
    _alu_rr(code, 0x01, RDI, R9)
    _b(code, 0xC6)                         // mov byte [rdi], 0
    _b(code, 0x07)
    _b(code, 0)
    _mov_rsp_load(code, RAX, 0x50)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __str_eq(rcx = a, rdx = b) -> rax (1/0)
fn _gen_str_eq(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_EQ, len(code))
    let ltop = _newlab(labs)
    let lne = _newlab(labs)
    let leq = _newlab(labs)
    _len_of(code, R8, RCX)
    _len_of(code, R9, RDX)
    _alu_rr(code, 0x39, R8, R9)            // cmp r8, r9
    let p0 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p0, lne, 1)
    _setlab(labs, code, ltop)
    _b(code, 0x4D)                         // test r8, r8（REX.W|R|B —— 漏了 REX 就成 test rax）
    _b(code, 0x85)
    _b(code, 0xC0)
    let p1 = _jcc(code, 0x84)              // jz .eq
    _addfix(ctx.fixes, p1, leq, 1)
    _b(code, 0x8A)                         // mov al, [rcx]
    _b(code, 0x01)
    _b(code, 0x3A)                         // cmp al, [rdx]
    _b(code, 0x02)
    let p2 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p2, lne, 1)
    _b(code, 0x48)                         // inc rcx
    _b(code, 0xFF)
    _b(code, 0xC1)
    _b(code, 0x48)                         // inc rdx
    _b(code, 0xFF)
    _b(code, 0xC2)
    _b(code, 0x49)                         // dec r8
    _b(code, 0xFF)
    _b(code, 0xC8)
    let p3 = _jmp(code)
    _addfix(ctx.fixes, p3, ltop, 1)
    _setlab(labs, code, leq)
    _mov_imm(code, RAX, 1)
    _ret(code)
    _setlab(labs, code, lne)
    _mov_imm(code, RAX, 0)
    _ret(code)
}

/// __alloc(rcx = 字节数) -> rax：.bss 里的 bump 分配器（8 字节对齐）
fn _gen_alloc(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_ALLOC, len(code))
    let lhave = _newlab(labs)
    _b(code, 0x48)                         // mov rax, [rip+HEAP]
    _b(code, 0x8B)
    _b(code, 0x05)
    let f1 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f1, 0, 4)           // bss 偏移 0 = heap 游标
    _b(code, 0x48)                         // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
    let p0 = _jcc(code, 0x85)              // jnz .have
    _addfix(ctx.fixes, p0, lhave, 1)
    _b(code, 0x48)                         // lea rax, [rip+bss+16]（堆起点）
    _b(code, 0x8D)
    _b(code, 0x05)
    let f2 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f2, 16, 4)          // bss 偏移 16 = 堆起点
    _setlab(labs, code, lhave)
    _b(code, 0x4C)                         // lea r8, [rax+rcx+7]
    _b(code, 0x8D)
    _b(code, 0x44)
    _b(code, 0x08)
    _b(code, 7)
    _b(code, 0x49)                         // and r8, -8
    _b(code, 0x83)
    _b(code, 0xE0)
    _b(code, 0xF8)
    _b(code, 0x4C)                         // mov [rip+HEAP], r8
    _b(code, 0x89)
    _b(code, 0x05)
    let f3 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f3, 0, 4)
    _ret(code)
}

/// 入口：sub rsp,0x28 -> call main -> ExitProcess(rax)
fn _gen_entry(ctx: Ctx) {
    let code: vec[int] = ctx.code
    _sub_rsp(code, 0x28)
    let p = _call_rel(code)
    _addfix(ctx.fixes, p, -1, 0)           // id -1 = main
    _mov_rr(code, RCX, RAX)
    let p2 = _call_rip(code)
    _addfix(ctx.fixes, p2, I_EXIT, 3)
}

// ---------------------------------------------------------------------------
// rdata：导入表 + 字符串（每个是 `[len:8][bytes][NUL]`，值 = 数据指针）
// ---------------------------------------------------------------------------

fn _w16(buf: vec[int], v: int) {
    _b(buf, v)
    _b(buf, v >> 8)
}

fn _bytes(buf: vec[int], s: str) {
    let mut i = 0
    while i < len(s) {
        _b(buf, s[i])
        i = i + 1
    }
}

fn _zero(buf: vec[int], n: int) {
    let mut i = 0
    while i < n {
        _b(buf, 0)
        i = i + 1
    }
}

fn _pad_to(buf: vec[int], n: int) {
    while len(buf) < n {
        _b(buf, 0)
    }
}

fn build_rdata(ctx: Ctx, rdata_rva: int, iat: vec[int]) {
    let rd: vec[int] = ctx.rdata

    // ---- 汇总导入：内置 4 个 + 用户 @ffi（DLL 按首次出现排序）----
    let dnames = vec[str].new(4)
    dnames.push("kernel32.dll")
    dnames.push("user32.dll")
    let dsym = vec[str].new(8)
    let ddll = vec[int].new(8)
    dsym.push("GetStdHandle")
    ddll.push(0)
    dsym.push("WriteFile")
    ddll.push(0)
    dsym.push("ExitProcess")
    ddll.push(0)
    // v2.32：线程三件套（spawn / join）
    dsym.push("CreateThread")
    ddll.push(0)
    dsym.push("WaitForSingleObject")
    ddll.push(0)
    dsym.push("CloseHandle")
    ddll.push(0)
    dsym.push("wsprintfA")
    ddll.push(1)
    let mut k = 0
    while k < len(ctx.fsym) {
        let dn = ctx.fdll.get(k)
        let mut di = -1
        let mut t = 0
        while t < len(dnames) {
            if dnames.get(t) == dn {
                di = t
            }
            t = t + 1
        }
        if di < 0 {
            dnames.push(dn)
            di = len(dnames) - 1
        }
        dsym.push(ctx.fsym.get(k))
        ddll.push(di)
        k = k + 1
    }
    let ndll = len(dnames)
    let nsym = len(dsym)

    // ---- 布局（先算偏移，再写字节）----
    let mut p = _align_up((ndll + 1) * 20, 8)
    let ilt = vec[int].new(8)
    let iatb = vec[int].new(8)
    let mut d = 0
    while d < ndll {
        let mut n = 0
        let mut s = 0
        while s < nsym {
            if ddll.get(s) == d {
                n = n + 1
            }
            s = s + 1
        }
        ilt.push(p)
        p = p + (n + 1) * 8
        iatb.push(p)
        p = p + (n + 1) * 8
        d = d + 1
    }
    let hn = vec[int].new(8)
    let mut s2 = 0
    while s2 < nsym {
        hn.push(p)
        p = p + 2 + len(dsym.get(s2)) + 1
        if p % 2 != 0 {
            p = p + 1
        }
        s2 = s2 + 1
    }
    let dn = vec[int].new(4)
    d = 0
    while d < ndll {
        dn.push(p)
        p = p + len(dnames.get(d)) + 1
        if p % 2 != 0 {
            p = p + 1
        }
        d = d + 1
    }

    // ---- 描述符（每 DLL 20 字节 + 一个全零结尾）----
    d = 0
    while d < ndll {
        _w32(rd, rdata_rva + ilt.get(d))
        _w32(rd, 0)
        _w32(rd, 0)
        _w32(rd, rdata_rva + dn.get(d))
        _w32(rd, rdata_rva + iatb.get(d))
        d = d + 1
    }
    _zero(rd, 20)

    // ---- 每 DLL 一组 ILT + IAT ----
    d = 0
    while d < ndll {
        _pad_to(rd, ilt.get(d))
        let mut s3 = 0
        while s3 < nsym {
            if ddll.get(s3) == d {
                _w64(rd, rdata_rva + hn.get(s3))
            }
            s3 = s3 + 1
        }
        _w64(rd, 0)
        _pad_to(rd, iatb.get(d))
        s3 = 0
        while s3 < nsym {
            if ddll.get(s3) == d {
                _w64(rd, rdata_rva + hn.get(s3))
            }
            s3 = s3 + 1
        }
        _w64(rd, 0)
        d = d + 1
    }

    // ---- hint/name 与 DLL 名 ----
    s2 = 0
    while s2 < nsym {
        _pad_to(rd, hn.get(s2))
        _w16(rd, 0)
        _bytes(rd, dsym.get(s2))
        _b(rd, 0)
        s2 = s2 + 1
    }
    d = 0
    while d < ndll {
        _pad_to(rd, dn.get(d))
        _bytes(rd, dnames.get(d))
        _b(rd, 0)
        d = d + 1
    }

    // ---- 记 IAT 槽位：内置 4 个 + 用户符号 ----
    iat.set(I_GETSTD, rdata_rva + iatb.get(0))
    iat.set(I_WRITE, rdata_rva + iatb.get(0) + 8)
    iat.set(I_EXIT, rdata_rva + iatb.get(0) + 16)
    iat.set(I_CREATE, rdata_rva + iatb.get(0) + 24)
    iat.set(I_WAIT, rdata_rva + iatb.get(0) + 32)
    iat.set(I_CLOSE, rdata_rva + iatb.get(0) + 40)
    iat.set(I_WSPRINTF, rdata_rva + iatb.get(1))
    k = 0
    while k < len(ctx.fsym) {
        let g = I_USER + k
        let di = ddll.get(g)
        let mut idx = 0
        let mut t2 = 0
        while t2 < g {
            if ddll.get(t2) == di {
                idx = idx + 1
            }
            t2 = t2 + 1
        }
        iat.set(g, rdata_rva + iatb.get(di) + idx * 8)
        k = k + 1
    }

    // ---- 字符串表：每个 `[len:8][bytes][NUL]`，strpos = 数据指针的偏移 ----
    let mut i = 0
    while i < len(ctx.strs) {
        _pad_to(rd, _align_up(len(rd), 8))
        let st = ctx.strs[i]
        _w64(rd, len(st))
        ctx.strpos.set(i, len(rd))
        _bytes(rd, st)
        _b(rd, 0)
        i = i + 1
    }
    // 换行字节（print 的语义是"输出 + 换行"，str 通道要单独写一个字节）
    ctx.nl.set(0, len(rd))
    _b(rd, 10)
    // 格式串（普通 C 字符串，给 wsprintfA）
    _pad_to(rd, _align_up(len(rd), 2))
    ctx.strpos.set(len(ctx.strpos) - 1, len(rd))
    _bytes(rd, "%I64d\n")
    _b(rd, 0)
}
// ---------------------------------------------------------------------------
// 回填（v2.16）
//
// 顺序段（入口 + 运行库）的 fixup 位置是 `.text` 绝对偏移；函数段的 fixup 位置
// 是**函数内相对偏移**，回填时加上函数基址。两类共用一个 `_target_of`，
// 只有标签的解析不同（顺序段用 ctx.labs，函数段用该函数自己的标签表）。
// ---------------------------------------------------------------------------

fn _fn_index_ctx(ctx: Ctx, nid: int) -> int {
    let mut i = 0
    while i < len(ctx.fns) {
        if ctx.fns.get(i).name == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _target_of(ctx: Ctx, id: int, kind: int, rdata_rva: int, bss_rva: int,
              iat: vec[int]) -> int {
    if kind == FK_FN {
        if id == -1 {
            let mi = _name_id_ro(ctx, "main")
            if mi < 0 {
                eprint("qlmc: 没有 main")
                exit(2)
            }
            let fi = _fn_index_ctx(ctx, mi)
            if fi < 0 {
                eprint("qlmc: 没有 main")
                exit(2)
            }
            return ctx.fnpos.get(fi)
        }
        return ctx.fnpos.get(id)
    }
    if kind == FK_LAB {
        return ctx.labs.get(id)
    }
    if kind == FK_STR {
        if id == -2 {
            return rdata_rva + ctx.strpos.get(len(ctx.strpos) - 1) - TEXT_RVA
        }
        if id == -3 {
            return rdata_rva + ctx.nl.get(0) - TEXT_RVA
        }
        return rdata_rva + ctx.strpos.get(id) - TEXT_RVA
    }
    if kind == FK_IAT {
        return iat.get(id) - TEXT_RVA
    }
    if kind == FK_BSS {
        return bss_rva + id - TEXT_RVA
    }
    return ctx.rt_pos.get(id)
}

fn resolve_seq(ctx: Ctx, rdata_rva: int, bss_rva: int, iat: vec[int]) {
    let mut i = 0
    while i < len(ctx.fixes) {
        let fx = ctx.fixes.get(i)
        let target = _target_of(ctx, fx.id, fx.kind, rdata_rva, bss_rva, iat)
        _patch32(ctx.code, fx.pos, target - (fx.pos + 4))
        i = i + 1
    }
}

fn resolve_fn(ctx: Ctx, arb: int, fi: int, base: int, rdata_rva: int,
              bss_rva: int, iat: vec[int]) {
    let h = HDR_BASE + fi * FN_HDR
    let rbase = mem_load64(arb, h + 6)
    let loff = mem_load64(arb, h + 2)
    let lcnt = mem_load64(arb, h + 3)
    let foff = mem_load64(arb, h + 4)
    let fcnt = mem_load64(arb, h + 5)
    let mut k = 0
    while k < fcnt {
        let p = mem_load64(rbase, foff / 8 + k * 3)
        let id = mem_load64(rbase, foff / 8 + k * 3 + 1)
        let kind = mem_load64(rbase, foff / 8 + k * 3 + 2)
        let mut target = 0
        if kind == FK_LAB {
            if id < 0 || id >= lcnt {
                eprint("qlmc: 内部错误：标签越界 " + id.to_str())
                exit(2)
            }
            target = base + mem_load64(rbase, loff / 8 + id)
        } else {
            target = _target_of(ctx, id, kind, rdata_rva, bss_rva, iat)
        }
        let pos = base + p
        _patch32(ctx.code, pos, target - (pos + 4))
        k = k + 1
    }
}
// ---------------------------------------------------------------------------
// PE32+ 写出（三节：.text / .rdata / .bss）
// ---------------------------------------------------------------------------

const BSS_SIZE = 0x100000        // 1 MB 堆（.bss：不占文件体积，加载器零填）

fn build_pe(code: vec[int], rdata: vec[int], blob: vec[int]) -> int {
    let text_len = len(code)
    let rdata_len = len(rdata)
    let rdata_rva = TEXT_RVA + _align_up(text_len, SECT_ALIGN)
    let bss_rva = rdata_rva + _align_up(rdata_len, SECT_ALIGN)
    let nsec = 3
    let headers = _align_up(HDR_DOS + 4 + 20 + OPT_SIZE + 40 * nsec, FILE_ALIGN)
    let text_raw_size = _align_up(text_len, FILE_ALIGN)
    let rdata_raw = headers + text_raw_size
    let rdata_raw_size = _align_up(rdata_len, FILE_ALIGN)
    let image = _align_up(bss_rva + BSS_SIZE, SECT_ALIGN)
    _b(blob, 77)
    _b(blob, 90)
    _zero(blob, 58)
    _w32(blob, HDR_DOS)
    _pad_to(blob, HDR_DOS)
    _b(blob, 80)
    _b(blob, 69)
    _b(blob, 0)
    _b(blob, 0)
    _w16(blob, 0x8664)
    _w16(blob, nsec)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, OPT_SIZE)
    _w16(blob, 0x0022)
    let opt_at = len(blob)
    _w16(blob, 0x20B)
    _b(blob, 14)
    _b(blob, 0)
    _w32(blob, text_raw_size)
    _w32(blob, rdata_raw_size)
    _w32(blob, BSS_SIZE)                // SizeOfUninitializedData
    _w32(blob, TEXT_RVA)
    _w32(blob, TEXT_RVA)
    _w64(blob, IMAGE_BASE)
    _w32(blob, SECT_ALIGN)
    _w32(blob, FILE_ALIGN)
    // OS 版本 6.0 / 映像版本 0.0 / 子系统版本 6.0 —— 六个 u16 一个都不能少
    _w16(blob, 6)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 6)
    _w16(blob, 0)
    _w32(blob, 0)
    _w32(blob, image)
    _w32(blob, headers)
    _w32(blob, 0)
    _w16(blob, 3)
    _w16(blob, 0x0100)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w32(blob, 0)
    _w32(blob, 16)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, rdata_rva)
    _w32(blob, 60)
    let mut k = 2
    while k < 16 {
        _w32(blob, 0)
        _w32(blob, 0)
        k = k + 1
    }
    _pad_to(blob, opt_at + OPT_SIZE)
    _bytes(blob, ".text")
    _zero(blob, 3)
    _w32(blob, text_len)
    _w32(blob, TEXT_RVA)
    _w32(blob, text_raw_size)
    _w32(blob, headers)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_CODE)
    _bytes(blob, ".rdata")
    _zero(blob, 2)
    _w32(blob, rdata_len)
    _w32(blob, rdata_rva)
    _w32(blob, rdata_raw_size)
    _w32(blob, rdata_raw)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_RDATA)
    _bytes(blob, ".bss")
    _zero(blob, 4)
    _w32(blob, BSS_SIZE)                // VirtualSize
    _w32(blob, bss_rva)
    _w32(blob, 0)                       // SizeOfRawData = 0：不占文件
    _w32(blob, 0)                       // PointerToRawData = 0
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, 0xC0000080)              // RW, 未初始化数据
    _pad_to(blob, headers)
    let mut i = 0
    while i < text_len {
        _b(blob, code[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw)
    i = 0
    while i < rdata_len {
        _b(blob, rdata[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw + rdata_raw_size)
    return bss_rva
}

fn write_file(path: str, buf: vec[int]) -> int {
    let h = _CreateFileA(cstr(path), GEN_WRITE, 0, 0, CREATE_ALWAYS,
                         ATTR_NORMAL, 0)
    if h == -1 {
        eprint("qlmc: 打不开输出文件 " + path)
        exit(2)
    }
    let n = len(buf)
    let p = mem_alloc(n + 8)
    let mut i = 0
    while i < n {
        mem_store8(p, i, buf[i])
        i = i + 1
    }
    let got = mem_alloc(8)
    if !_WriteFile(h, p, n, got, 0) {
        eprint("qlmc: 写文件失败 " + path)
        exit(2)
    }
    _CloseHandle(h)
    return 0
}

// ---------------------------------------------------------------------------
// 主流程
// ---------------------------------------------------------------------------

/// 取路径的目录部分（含结尾分隔符）
fn _dir_of(path: str) -> str {
    let mut i = len(path) - 1
    while i >= 0 {
        let c = path[i]
        if c == 47 || c == 92 {
            return substr(path, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

fn _usage() {
    eprint("用法: qlmc build <src.qma> [-o out.exe] [-j N] | qlmc dump <src.qma> | qlmc version")
}

/// 线程数：函数太少时并行只付线程创建成本。`want` = 0 表示自动。
fn _pick_threads(nfunc: int, want: int) -> int {
    let mut cores = net_config(2)
    if cores < 1 {
        cores = 1
    }
    if cores > MAX_THREADS {
        cores = MAX_THREADS
    }
    let mut nt = cores
    if want > 0 {
        nt = want
    } else if nfunc < 16 {
        nt = 1
    } else {
        // 自动：每线程约 50 个函数才值得开线程。实测 200 函数时 j1=2.67 ms、
        // j4=1.63 ms、j8=1.97 ms（线程创建 ~200 us/个，超过物理并行度反而更慢），
        // 所以按工作量给，不无脑开满。
        nt = nfunc / 50
        if nt > cores {
            nt = cores
        }
        if nt < 1 {
            nt = 1
        }
    }
    if nt > nfunc {
        nt = nfunc
    }
    if nt < 1 {
        nt = 1
    }
    return nt
}

fn main() {
    let t0 = now_ns()
    let a = args()
    if len(a) < 1 {
        _usage()
        exit(2)
    }
    if a[0] == "version" {
        print("qlmc 0.5（Quelmara 写的 stage-1 编译器，子集 S18：int/bool/str + struct/数组/enum/vec（可扩容、元素可为聚合）/map/切片 + 位运算/移位 + 进制字面量 + const 常量表达式 + else if + spawn/join + defer + import + @ffi + 闭包 + 聚合形参返回 + 形参实参不限个数 + for；IR + 线性扫描 + 并行）")
        return
    }
    if len(a) < 2 {
        _usage()
        exit(2)
    }
    let cmd = a[0]
    let src = a[1]
    let mut out = "build/qlmc_out.exe"
    let mut want = 0
    let mut i = 2
    while i < len(a) {
        if a[i] == "-o" && i + 1 < len(a) {
            out = a[i + 1]
        }
        if a[i] == "-j" && i + 1 < len(a) {
            want = a[i + 1].to_int()
        }
        i = i + 1
    }
    if !file_exists(src) {
        eprint("qlmc: 找不到 " + src)
        exit(2)
    }
    let text = read_text(src)

    let toks = vec[Tok].new(256)
    lex(text, toks)
    let nodes = vec[Node].new(256)
    let names = vec[str].new(32)
    let strs = vec[str].new(16)
    let fns = vec[Fn].new(8)
    let cname = vec[int].new(8)
    let cval = vec[int].new(8)
    let stt = vec[int].new(TBL_SIZE)
    let mut ti = 0
    while ti < TBL_SIZE {
        stt.push(0)
        ti = ti + 1
    }
    let imports = vec[str].new(4)
    let fdll = vec[str].new(4)
    let fsym = vec[str].new(4)
    parse(toks, nodes, names, strs, fns, cname, cval, stt, imports, fdll, fsym)

    // 装载 import 的模块：同一个模块只装一次，装的过程中可能又收集到新的 import
    let loaded = vec[str].new(4)
    let dir = _dir_of(src)
    let mut ii = 0
    while ii < len(imports) {
        let mod = imports.get(ii)
        let mut seen = 0
        let mut kk = 0
        while kk < len(loaded) {
            if loaded.get(kk) == mod {
                seen = 1
            }
            kk = kk + 1
        }
        if seen == 0 {
            loaded.push(mod)
            let mpath = dir + mod + ".qma"
            if !file_exists(mpath) {
                eprint("qlmc: 找不到模块 " + mpath)
                exit(2)
            }
            let mt = read_text(mpath)
            let mtk = vec[Tok].new(256)
            lex(mt, mtk)
            parse(mtk, nodes, names, strs, fns, cname, cval, stt, imports, fdll, fsym)
        }
        ii = ii + 1
    }

    if cmd == "dump" {
        print("tokens   : " + len(toks).to_str())
        print("nodes    : " + len(nodes).to_str())
        print("fns      : " + len(fns).to_str())
        print("names    : " + len(names).to_str())
        print("strs     : " + len(strs).to_str())
        print("structs  : " + stt.get(0).to_str())
        print("enums    : " + stt.get(EN_HDR).to_str())
        return
    }
    if len(fns) < 1 {
        eprint("qlmc: 源文件里没有函数")
        exit(2)
    }

    // true/false 先占位（bool 打印通道要用）
    strs.push("true")
    let s_true = len(strs) - 1
    strs.push("false")
    let s_false = len(strs) - 1

    let code = vec[int].new(4096)
    let labs = vec[int].new(64)
    let fixes = vec[Fix].new(64)
    let rdata = vec[int].new(2048)
    let strpos = vec[int].new(len(strs) + 1)
    let mut si = 0
    while si < len(strs) + 1 {
        strpos.push(-1)
        si = si + 1
    }
    // IAT 槽表：内置 I_USER 个 + 用户 @ffi 符号。**用 I_USER 推，别再写死 4**——
    // 加内置符号时忘了改这里，表现是编译期 "vec index out of bounds"。
    let iat = vec[int].new(I_USER)
    si = 0
    while si < I_USER + len(fsym) {
        iat.push(0)
        si = si + 1
    }
    let nl = vec[int].new(1)
    nl.push(0)
    // 运行库例程位置表：RT_PINT..RT_SPAWN 共 11 个（加例程时这里要一起改）
    let rt_pos = vec[int].new(11)
    si = 0
    while si < 11 {
        rt_pos.push(0)
        si = si + 1
    }
    let nfunc = len(fns)
    let fnpos = vec[int].new(nfunc)
    si = 0
    while si < nfunc {
        fnpos.push(0)
        si = si + 1
    }

    let ctx = Ctx { code: code, labs: labs, fixes: fixes, nodes: nodes,
                    names: names, strs: strs, fns: fns, fnpos: fnpos,
                    rdata: rdata, strpos: strpos, str_true: s_true, str_false: s_false,
                    nl: nl, rt_pos: rt_pos, fdll: fdll, fsym: fsym }

    // **入口必须落在 .text 偏移 0**（AddressOfEntryPoint 恒等于 TEXT_RVA）
    _gen_entry(ctx)
    _gen_print_i64(ctx)
    _gen_print_str(ctx)
    _gen_print_bool(ctx)
    _gen_memcpy(ctx)
    _gen_alloc(ctx)
    _gen_str_cat(ctx)
    _gen_str_eq(ctx)
    _gen_die(ctx)
    _gen_zero(ctx)
    _gen_join(ctx)
    _gen_spawn(ctx)
    let rt_end = now_ns()

    // ---- 并行编译函数体 -------------------------------------------------
    let nt = _pick_threads(nfunc, want)
    let hdrbytes = (HDR_BASE + nfunc * FN_HDR) * 8
    let arb = mem_alloc(ARENA_CAP)
    let per = (ARENA_CAP - hdrbytes) / nt
    let mut w = 0
    while w < nt {
        let lo = w * nfunc / nt
        let hi = (w + 1) * nfunc / nt
        mem_store64(arb, w * 8, lo)
        mem_store64(arb, w * 8 + 1, hi)
        mem_store64(arb, w * 8 + 2, arb + hdrbytes + w * per)
        mem_store64(arb, w * 8 + 3, per)
        w = w + 1
    }
    if nt == 1 {
        _compile_range(arb, 0, nodes, names, strs, fns, rt_pos, stt)
    } else {
        let hs = vec[int].new(nt)
        w = 0
        while w < nt {
            hs.push(spawn _compile_range(arb, w, nodes, names, strs, fns, rt_pos, stt))
            w = w + 1
        }
        w = 0
        while w < nt {
            join(hs.get(w))
            w = w + 1
        }
    }
    let fn_end = now_ns()

    // ---- 拼装（顺序固定 → 线程数不影响产物） ---------------------------
    // 函数体接在「入口 + 运行库」之后，所以起始偏移是当前 .text 长度
    let mut off = len(code)
    let mut fi = 0
    while fi < nfunc {
        fnpos.set(fi, off)
        let h = HDR_BASE + fi * FN_HDR
        let rbase = mem_load64(arb, h + 6)
        let coff = mem_load64(arb, h)
        let clen = mem_load64(arb, h + 1)
        let mut k = 0
        while k < clen {
            code.push(mem_load8(rbase, coff + k))
            k = k + 1
        }
        off = off + clen
        fi = fi + 1
    }

    let rdata_rva = TEXT_RVA + _align_up(len(code), SECT_ALIGN)
    build_rdata(ctx, rdata_rva, iat)
    let real_bss = rdata_rva + _align_up(len(rdata), SECT_ALIGN)
    resolve_seq(ctx, rdata_rva, real_bss, iat)
    fi = 0
    while fi < nfunc {
        resolve_fn(ctx, arb, fi, fnpos.get(fi), rdata_rva, real_bss, iat)
        fi = fi + 1
    }

    let blob = vec[int].new(8192)
    let pe_bss = build_pe(code, rdata, blob)
    if pe_bss != real_bss {
        eprint("qlmc: 内部错误：bss RVA 不一致 " + pe_bss.to_str() +
               " vs " + real_bss.to_str())
        exit(2)
    }
    write_file(out, blob)
    let t_all = (now_ns() - t0) / 1000
    print("[qlmc] " + src + " -> " + out + "  (" + len(blob).to_str() + " 字节, 子集 S12)" +
          "  编译 " + t_all.to_str() + " us（进程内）  后端 " +
          ((fn_end - rt_end) / 1000).to_str() + " us  -j" + nt.to_str())
}
