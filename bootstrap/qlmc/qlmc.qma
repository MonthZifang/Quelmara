    _b(code, 48)
    _b(code, 0xB8)                             // mov eax, 1
    _w32(code, 1)
    let jmp8 = _jmp(code)
    _addfix(ctx.fixes, jmp8, ldone, FK_LAB)
    _setlab(labs, code, lnan)
    _b(code, 0x48)                             // mov rcx, [rsp+0x40]
    _b(code, 0x8B)
    _b(code, 0x4C)
    _b(code, 0x24)
    _b(code, 0x40)
    _b(code, 0xC7)                             // mov dword [rcx], "nan"
    _b(code, 0x01)
    _w32(code, 0x006E616E)
    _b(code, 0xB8)                             // mov eax, 3
    _w32(code, 3)
    let jmp9 = _jmp(code)
    _addfix(ctx.fixes, jmp9, ldone, FK_LAB)
    _setlab(labs, code, linf)
    _b(code, 0x48)                             // mov rcx, [rsp+0x40]
    _b(code, 0x8B)
    _b(code, 0x4C)
    _b(code, 0x24)
    _b(code, 0x40)
    _b(code, 0x66)                             // movq rax, xmm0
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0x7E)
    _b(code, 0xC0)
    _b(code, 0x48)                             // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
    let jns4 = _jcc(code, 0x89)                // jns .infp
    _addfix(ctx.fixes, jns4, linfp, FK_LAB)
    _b(code, 0xC6)                             // mov byte [rcx], 45 ('-')
    _b(code, 0x01)
    _b(code, 45)
    _b(code, 0xC7)                             // mov dword [rcx+1], "inf"
    _b(code, 0x41)
    _b(code, 0x01)
    _w32(code, 0x00666E69)
    _b(code, 0xB8)                             // mov eax, 4
    _w32(code, 4)
    let jmpA = _jmp(code)
    _addfix(ctx.fixes, jmpA, ldone, FK_LAB)
    _setlab(labs, code, linfp)
    _b(code, 0xC7)                             // mov dword [rcx], "inf"
    _b(code, 0x01)
    _w32(code, 0x00666E69)
    _b(code, 0xB8)                             // mov eax, 3
    _w32(code, 3)
    _setlab(labs, code, ldone)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x5D)                             // pop rbp
    _ret(code)
}

/// __fparse(rcx = 字面量 str, rdx = 目标槽)：十进制文本 -> f64，写进槽。
///
/// **为什么不在编译期解析**：qlmc 是 Quelmara 写的，只会整数算术 —— 要自己把
/// "1.5" 算成 IEEE 位就得实现正确舍入的十进制→二进制转换（那是 std/f64 的
/// `f64_parse` 的活，几百行）。交给 msvcrt 的 `strtod`：既正确，又和 stage-0
/// （用 Python float 解析）**逐位一致**，差分才对得上。
/// 代价：每个字面量在运行时解析一次（不是常量折叠），f64 密集的代码会慢。
fn _gen_fparse(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_FPARSE, len(code))
    _b(code, 0x55)                             // push rbp
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
    _sub_rsp(code, 0x30)                       // 影子空间 + 存 dst（保持 16 对齐）
    _b(code, 0x48)                             // mov [rsp+0x20], rdx
    _b(code, 0x89)
    _b(code, 0x54)
    _b(code, 0x24)
    _b(code, 0x20)
    _b(code, 0x31)                             // xor edx, edx（endptr = NULL）
    _b(code, 0xD2)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_STRTOD, 3)
    _b(code, 0x48)                             // mov rdx, [rsp+0x20]
    _b(code, 0x8B)
    _b(code, 0x54)
    _b(code, 0x24)
    _b(code, 0x20)
    _b(code, 0xF2)                             // movsd [rdx], xmm0
    _b(code, 0x0F)
    _b(code, 0x11)
    _b(code, 0x02)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x5D)                             // pop rbp
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

/// __fop(rcx = 目标槽, rdx = 左槽, r8 = 右槽)：dst = 左 <op> 右。
/// SSE2 标量双精度：movsd 两个操作数进 xmm0、对右操作数直接带内存操作数算。
/// `opc` 是 opcode 的第二字节（addsd 0x58 / subsd 0x5C / mulsd 0x59 / divsd 0x5E）。
/// 叶子函数（不调用任何东西），所以不需要序言、也不用碰栈。
fn _gen_fop(ctx: Ctx, rtid: int, opc: int) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(rtid, len(code))
    _b(code, 0xF2)                             // movsd xmm0, [rdx]
    _b(code, 0x0F)
    _b(code, 0x10)
    _b(code, 0x02)
    _b(code, 0xF2)                             // <op>sd xmm0, [r8]
    _b(code, 0x41)                             // REX.B（rm = r8）
    _b(code, 0x0F)
    _b(code, opc)
    _b(code, 0x00)
    _b(code, 0xF2)                             // movsd [rcx], xmm0
    _b(code, 0x0F)
    _b(code, 0x11)
    _b(code, 0x01)
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

/// __itof(rcx = 目标槽, rdx = 整数值)：dst = (double)v
fn _gen_itof(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_ITOF, len(code))
    _b(code, 0xF2)                             // cvtsi2sd xmm0, rdx（REX.W：64 位）
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0x2A)
    _b(code, 0xC2)
    _b(code, 0xF2)                             // movsd [rcx], xmm0
    _b(code, 0x0F)
    _b(code, 0x11)
    _b(code, 0x01)
    _b(code, 0x31)
    _b(code, 0xC0)
    _ret(code)
}

/// __ftoi(rcx = 槽) -> rax：向零截断（cvttsd2si），与 stage-0 的 to_int 同口径
fn _gen_ftoi(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_FTOI, len(code))
    _b(code, 0xF2)                             // movsd xmm0, [rcx]
    _b(code, 0x0F)
    _b(code, 0x10)
    _b(code, 0x01)
    _b(code, 0xF2)                             // cvttsd2si rax, xmm0
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0x2C)
    _b(code, 0xC0)
    _ret(code)
}

/// __str_to_int(rcx = str) -> rax = 值。十进制解析，语义对齐 stage-0：
/// 可选 '+'/'-' 号、随后必须全是数字、遇 NUL 结束；非法字符或溢出直接 exit(1)。
/// 溢出用**前置检查**（acc > INT64_MAX/10 就必溢），不去算溢出后的值。
fn _gen_str_to_int(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_STR2INT, len(code))
    let lplus = _newlab(labs)
    let lloop = _newlab(labs)
    let ldone = _newlab(labs)
    let lret = _newlab(labs)
    let lfail = _newlab(labs)
    _b(code, 0x55)                             // push rbp
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
    _b(code, 0x45)                             // xor r8d, r8d（i）
    _b(code, 0x31)
    _b(code, 0xC0)
    _b(code, 0x45)                             // xor r9d, r9d（neg）
    _b(code, 0x31)
    _b(code, 0xC9)
    _b(code, 0x45)                             // xor r10d, r10d（acc）
    _b(code, 0x31)
    _b(code, 0xD2)
    _b(code, 0x0F)                             // movzx eax, byte [rcx]
    _b(code, 0xB6)
    _b(code, 0x01)
    _b(code, 0x83)                             // cmp eax, 45 ('-')
    _b(code, 0xF8)
    _b(code, 0x2D)
    let p0 = _jcc(code, 0x85)                  // jne .plus
    _addfix(ctx.fixes, p0, lplus, FK_LAB)
    _b(code, 0x41)                             // mov r9d, 1
    _b(code, 0xB9)
    _w32(code, 1)
    _b(code, 0x41)                             // mov r8d, 1
    _b(code, 0xB8)
    _w32(code, 1)
    let p1 = _jmp(code)
    _addfix(ctx.fixes, p1, lloop, FK_LAB)
    _setlab(labs, code, lplus)
    _b(code, 0x83)                             // cmp eax, 43 ('+')
    _b(code, 0xF8)
    _b(code, 0x2B)
    let p2 = _jcc(code, 0x85)                  // jne .loop
    _addfix(ctx.fixes, p2, lloop, FK_LAB)
    _b(code, 0x41)                             // mov r8d, 1
    _b(code, 0xB8)
    _w32(code, 1)
    _setlab(labs, code, lloop)
    _b(code, 0x42)                             // movzx eax, byte [rcx + r8]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x04)
    _b(code, 0x01)
    _b(code, 0x85)                             // test eax, eax
    _b(code, 0xC0)
    let p3 = _jcc(code, 0x84)                  // jz .done
    _addfix(ctx.fixes, p3, ldone, FK_LAB)
    _b(code, 0x83)                             // cmp eax, 48 ('0')
    _b(code, 0xF8)
    _b(code, 0x30)
    let p4 = _jcc(code, 0x8C)                  // jl .fail
    _addfix(ctx.fixes, p4, lfail, FK_LAB)
    _b(code, 0x83)                             // cmp eax, 57 ('9')
    _b(code, 0xF8)
    _b(code, 0x39)
    let p5 = _jcc(code, 0x8F)                  // jg .fail
    _addfix(ctx.fixes, p5, lfail, FK_LAB)
    _b(code, 0x49)                             // movabs r11, 922337203685477580
    _b(code, 0xBB)
    _w64(code, 922337203685477580)
    _b(code, 0x4D)                             // cmp r10, r11
    _b(code, 0x39)
    _b(code, 0xDA)
    let p6 = _jcc(code, 0x8F)                  // jg .fail（再乘 10 必溢出）
    _addfix(ctx.fixes, p6, lfail, FK_LAB)
    _b(code, 0x4D)                             // imul r10, r10, 10
    _b(code, 0x6B)
    _b(code, 0xD2)
    _b(code, 0x0A)
    _b(code, 0x83)                             // sub eax, 48
    _b(code, 0xE8)
    _b(code, 0x30)
    _b(code, 0x49)                             // add r10, rax
    _b(code, 0x01)
    _b(code, 0xC2)
    _b(code, 0x49)                             // inc r8
    _b(code, 0xFF)
    _b(code, 0xC0)
    let p7 = _jmp(code)
    _addfix(ctx.fixes, p7, lloop, FK_LAB)
    _setlab(labs, code, ldone)
    _b(code, 0x4C)                             // mov rax, r10
    _b(code, 0x89)
    _b(code, 0xD0)
    _b(code, 0x4D)                             // test r9, r9
    _b(code, 0x85)
    _b(code, 0xC9)
    let p8 = _jcc(code, 0x84)                  // jz .ret
    _addfix(ctx.fixes, p8, lret, FK_LAB)
    _b(code, 0x48)                             // neg rax
    _b(code, 0xF7)
    _b(code, 0xD8)
    _setlab(labs, code, lret)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x5D)                             // pop rbp
    _ret(code)
    _setlab(labs, code, lfail)
    _b(code, 0xB9)                             // mov ecx, 1
    _w32(code, 1)
    let p9 = _call_rip(code)                   // ExitProcess(1)
    _addfix(ctx.fixes, p9, I_EXIT, 3)
    _ret(code)
}

/// __i64_fmt(rcx = buf, rdx = v) -> rax = 写入的字节数。
/// 用 wsprintfA("%I64d") 而不是自己写除法循环：INT64_MIN 取绝对值会溢出
/// （§7.19 那个 bug 的根源），交给 CRT 省心。
fn _gen_i64_fmt(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_I64FMT, len(code))
    _b(code, 0x55)                             // push rbp
    _b(code, 0x48)                             // mov rbp, rsp
    _b(code, 0x89)
    _b(code, 0xE5)
    _sub_rsp(code, 0x30)
    _b(code, 0x49)                             // mov r8, rdx（值 → 第 3 个实参）
    _b(code, 0x89)
    _b(code, 0xD0)
    let at = len(code) + 3                     // lea rdx, [rip+fmt]
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, at, -4, 2)              // id -4 = "%I64d"（无换行）
    _b(code, 0x31)                             // xor eax, eax（varargs：AL = 0）
    _b(code, 0xC0)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_WSPRINTF, 3)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x5D)                             // pop rbp
    _ret(code)
}

/// __memcmp(rcx = a, rdx = b, r8 = n) -> 首个不同字节的差值（全等返回 0）。
/// 口径与 stage-0 一致：返回 `a[i] - b[i]`（不是 -1/0/1），全等返回 0。
/// stage-0 那边是 8 字节字比较 + 差异字逐字节定位（快但等价），这里就用
/// 朴素字节循环——语义完全相同，自举阶段优先要"对"，性能留给之后。
/// __memchr(rcx = p, rdx = n, r8 = byte) -> 首个等于 byte 的下标，找不到 -1
///
/// v3.37：std/ 有 5 个模块用它（http 头解析、str_find、csv…）。
/// 朴素字节循环，语义与 stage-0 的 __memchr 一致（返回下标，不是指针）。
/// __memdiff(rcx = a, rdx = b, r8 = n) -> 首个不同字节的下标，全等返回 n
///
/// v3.38：gzip deflate 的 LZ77 匹配长度用它（返回公共前缀长度）。
/// 朴素字节循环，语义与 stage-0 的 __memdiff 一致。
fn _gen_memdiff(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMDIFF, len(code))
    let ltop = _newlab(labs)
    let ldiff = _newlab(labs)
    _b(code, 0x45)                             // xor r9d, r9d（i = 0）
    _b(code, 0x31)
    _b(code, 0xC9)
    _setlab(labs, code, ltop)
    // cmp r9, r8（i >= n -> 全等，返回 n）
    _b(code, 0x4D)                             // REX.W|B：rm=r9 需要 B
    _b(code, 0x39)
    _b(code, 0xC1)                             // cmp r9, r8
    let p0 = _jcc(code, 0x83)                  // jae .diff（此时 r9 == n）
    _addfix(ctx.fixes, p0, ldiff, FK_LAB)
    _b(code, 0x42)                             // movzx eax, byte [rcx + r9]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x04)
    _b(code, 0x09)                             // SIB: base=rcx, index=r9
    _b(code, 0x46)                             // movzx r10d, byte [rdx + r9]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x14)
    _b(code, 0x0A)                             // SIB: base=rdx, index=r9
    _b(code, 0x44)                             // cmp eax, r10d
    _b(code, 0x39)
    _b(code, 0xD0)
    let p1 = _jcc(code, 0x85)                  // jne .diff
    _addfix(ctx.fixes, p1, ldiff, FK_LAB)
    _b(code, 0x49)                             // inc r9
    _b(code, 0xFF)
    _b(code, 0xC1)
    let p2 = _jmp(code)
    _addfix(ctx.fixes, p2, ltop, FK_LAB)
    _setlab(labs, code, ldiff)
    _b(code, 0x4C)                             // mov rax, r9（r9 就是答案：n 或首个不同处）
    _b(code, 0x89)
    _b(code, 0xC8)
    _ret(code)
}

/// __memxchg(rcx = addr, rdx = val) -> old
///
/// v3.38：原子交换。x86-64 的 xchg [mem], reg **隐含 LOCK**，
/// 不需要额外的 lock 前缀。std/net 的多 io 线程自旋锁靠它。
fn _gen_memxchg(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_MEMXCHG, len(code))
    // mov rax, rdx   （待换入的值）
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xD0)
    // xchg [rcx], rax  => 48 87 01（REX.W | 87 /r，ModRM=00 000 001 = [rcx], rax）
    _b(code, 0x48)
    _b(code, 0x87)
    _b(code, 0x01)
    _ret(code)
}

fn _gen_memchr(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMCHR, len(code))
    let ltop = _newlab(labs)
    let lfound = _newlab(labs)
    let lnone = _newlab(labs)
    _b(code, 0x45)                             // xor r9d, r9d（i = 0）
    _b(code, 0x31)
    _b(code, 0xC9)
    _setlab(labs, code, ltop)
    // cmp r9, rdx：39 /r 是 cmp r/m, r，所以 reg=rdx(010)、rm=r9(001)
    // => ModRM = 11 010 001 = 0xD1；REX.W|R（0x4C，R 扩展 reg 到 rdx 不需要，
    //    但 rm=r9 需要 REX.B）—— 实际需要的是 0x49（W|B）。
    _b(code, 0x49)                             // cmp r9, rdx
    _b(code, 0x39)
    _b(code, 0xD1)
    let p0 = _jcc(code, 0x83)                  // jae .none
    _addfix(ctx.fixes, p0, lnone, FK_LAB)
    _b(code, 0x42)                             // movzx eax, byte [rcx + r9]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x04)
    _b(code, 0x09)                             // SIB: scale=1, index=r9, base=rcx
    _b(code, 0x44)                             // cmp eax, r8d
    _b(code, 0x39)
    _b(code, 0xC0)
    let p1 = _jcc(code, 0x84)                  // je .found
    _addfix(ctx.fixes, p1, lfound, FK_LAB)
    _b(code, 0x49)                             // inc r9
    _b(code, 0xFF)
    _b(code, 0xC1)
    let p2 = _jmp(code)
    _addfix(ctx.fixes, p2, ltop, FK_LAB)
    _setlab(labs, code, lfound)
    _b(code, 0x4C)                             // mov rax, r9
    _b(code, 0x89)
    _b(code, 0xC8)
    _ret(code)
    _setlab(labs, code, lnone)
    _b(code, 0x48)                             // mov rax, -1
    _b(code, 0xC7)
    _b(code, 0xC0)
    _w32(code, -1)
    _ret(code)
}

fn _gen_memcmp(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMCMP, len(code))
    let ltop = _newlab(labs)
    let ldiff = _newlab(labs)
    let leq = _newlab(labs)
    _b(code, 0x45)                             // xor r9d, r9d（i = 0）
    _b(code, 0x31)
    _b(code, 0xC9)
    _setlab(labs, code, ltop)
    _b(code, 0x4D)                             // cmp r9, r8
    _b(code, 0x39)
    _b(code, 0xC1)
    let p0 = _jcc(code, 0x83)                  // jae .eq
    _addfix(ctx.fixes, p0, leq, FK_LAB)
    _b(code, 0x42)                             // movzx eax, byte [rcx + r9]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x04)
    _b(code, 0x09)                             // SIB: scale=1, index=r9, base=rcx
    _b(code, 0x46)                             // movzx r10d, byte [rdx + r9]
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0x14)
    _b(code, 0x0A)
    _b(code, 0x44)                             // cmp eax, r10d
    _b(code, 0x39)
    _b(code, 0xD0)
    let p1 = _jcc(code, 0x85)                  // jne .diff
    _addfix(ctx.fixes, p1, ldiff, FK_LAB)
    _b(code, 0x49)                             // inc r9
    _b(code, 0xFF)
    _b(code, 0xC1)
    let p2 = _jmp(code)
    _addfix(ctx.fixes, p2, ltop, FK_LAB)
    _setlab(labs, code, ldiff)
    _b(code, 0x4C)                             // sub rax, r10（64 位：负数才不会被当大正数）
    _b(code, 0x29)
    _b(code, 0xD0)
    _ret(code)
    _setlab(labs, code, leq)
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

// ---------------------------------------------------------------------------
// 并行：一个工作线程编译 [lo, hi) 区间的函数
//
// arb 布局（主线程按 8 字节字索引读写）：
//   [0 .. 63]        工作线程表，每线程 8 字：lo, hi, base, cap
//   [HDR_BASE .. ]   函数表，每函数 6 字：code_off, code_len, lab_off,
//                    lab_cnt, fix_off, fix_cnt
// 每个线程在自己那段里**顺序 bump**，所以不需要任何锁；每个函数写自己那 6 字，
// 也没有竞争。
// ---------------------------------------------------------------------------

const HDR_BASE = 64
const FN_HDR = 7
const MAX_THREADS = 8
// 并行编译的工作区大小（每个线程 per = (ARENA_CAP - 头)/nt 字节）。
// **别开太大**：它是从堆里 mem_alloc 的，而堆是 BSS_SIZE。v2.35 实测：
// 16 MB 的 arena 让 stage-2 编自己时堆游标冲到 31.7 MB / 32 MB（耗尽 → AV）。
// qlmc 自己产物的 .text 只有 440 KB，fixup/label 加起来约 1 MB，4 MB 足够。
const ARENA_CAP = 4 * 1024 * 1024
// 堆大小：**必须大于 ARENA_CAP（4 MB）**，否则 `mem_alloc(ARENA_CAP)` 会静默
// 越过堆末尾，之后所有分配都落在未映射页上（v2.34 实测：stage-2 崩在
// 基址 +17.3 MB 处）。v2.38 起 f64 让 qlmc 自己变大，32 MB 不够，给 64 MB。
// v2.76：这块内存改用 VirtualAlloc 拿（私有页首次触碰比 .bss 映像节快 5 倍），
// BSS_SIZE 因此缩到 32 字节 —— .bss 只剩游标/锁/基址/上限四个槽。
const HEAP_SIZE = 0x4000000      // 64 MB，VirtualAlloc(MEM_COMMIT|MEM_RESERVE)
// v3.36：静态字区（static_word(i)）也放在 .bss，紧跟原来 32 字节之后。
// 为什么放 bss 而不是堆：静态字是**进程级**状态，std/ 的模块在初始化时
// 拿它的地址、之后长期持有；放堆里要惰性分配 + 一个已分配标志槽，
// 多两条分支还多一次间接。bss 本来就是零初始化，正好。
const STATIC_SLOTS = 64          // 与 stage-0 的 STATIC_SLOTS 一致
const STATICW_BSS_OFF = 32       // 静态字区在 .bss 里的偏移
const BSS_SIZE = 32 + STATIC_SLOTS * 8   // 游标/锁/基址/上限 + 静态字区

fn _compile_range(hdr: int, wid: int, nodes: vec[Node], names: vec[str],
                  strs: vec[str], fns: vec[Fn], rt: vec[int], stt: vec[int]) -> int {
    let lo = mem_load64(hdr, wid * 8)
    let hi = mem_load64(hdr, wid * 8 + 1)
    let base = mem_load64(hdr, wid * 8 + 2)
    let cap = mem_load64(hdr, wid * 8 + 3)
    let fc = _new_fc(nodes, names, fns, rt, stt)
    // 优化层的复用缓冲（每线程一份，跨函数复用）
    // 分配器 / 优化层的复用缓冲（每线程一份，跨函数复用）
    let ucnt = vec[int].new(512)
    let baked = vec[int].new(512)
    let csb = vec[int].new(16)
    let lpm = vec[int].new(512)
    let cok = vec[int].new(512)
    let cval = vec[int].new(512)
    let use = vec[int].new(512)
    let ndef = vec[int].new(512)
    let out = vec[int].new(2)
    out.push(0)
    out.push(0)
    let mut off = 0
    let mut fi = lo
    while fi < hi {
        _fc_reset(fc)
        _lower_fn(fc, fi)
        _opt(fc, cok, cval, use, ndef, out)
        _alloc(fc, ucnt, baked, csb, lpm)
        _emit_fn(fc)
        let code = fc.code
        let labs = fc.labs
        let fixes = fc.fixes
        if off + len(code) + len(labs) * 8 + len(fixes) * 24 + 64 > cap {
            eprint("qlmc: 编译缓冲不够（线程 " + wid.to_str() + "）")
            exit(2)
        }
        let coff = off
        let mut i = 0
        while i < len(code) {
            mem_store8(base, off, code.get(i))
            off = off + 1
            i = i + 1
        }
        while off % 8 != 0 {
            mem_store8(base, off, 0)
            off = off + 1
        }
        let loff = off
        i = 0
        while i < len(labs) {
            mem_store64(base, off / 8, labs.get(i))
            off = off + 8
            i = i + 1
        }
        let foff = off
        i = 0
        while i < len(fixes) {
            let fx = fixes.get(i)
            mem_store64(base, off / 8, fx.pos)
            mem_store64(base, off / 8 + 1, fx.id)
            mem_store64(base, off / 8 + 2, fx.kind)
            off = off + 24
            i = i + 1
        }
        let h = HDR_BASE + fi * FN_HDR
        mem_store64(hdr, h, coff)
        mem_store64(hdr, h + 1, len(code))
        mem_store64(hdr, h + 2, loff)
        mem_store64(hdr, h + 3, len(labs))
        mem_store64(hdr, h + 4, foff)
        mem_store64(hdr, h + 5, len(fixes))
        mem_store64(hdr, h + 6, base)
        fi = fi + 1
    }
    return off
}

// ---------------------------------------------------------------------------
// 运行库：bool 打印（v2.16 从发射器里的分支序列提成例程）
// ---------------------------------------------------------------------------

/// __print_bool(rcx = 0/1)：true/false + 换行
fn _gen_print_bool(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_PBOOL, len(code))
    let lf = _newlab(labs)
    let le = _newlab(labs)
    _cmp_imm0(code, RCX)
    let p = _jcc(code, 0x84)
    _addfix(ctx.fixes, p, lf, FK_LAB)
    let at = len(code) + 3
    _lea_rip(code, RCX, 0)
    _addfix(ctx.fixes, at, ctx.str_true, FK_STR)
    _call_rt(ctx, RT_PSTR)
    let p2 = _jmp(code)
    _addfix(ctx.fixes, p2, le, FK_LAB)
    _setlab(labs, code, lf)
    let at2 = len(code) + 3
    _lea_rip(code, RCX, 0)
    _addfix(ctx.fixes, at2, ctx.str_false, FK_STR)
    _call_rt(ctx, RT_PSTR)
    _setlab(labs, code, le)
    _ret(code)
}

// ---- 切片（v2.22）：视图 = (ptr, len) 两字聚合 ----

/// i >= len 就 exit(1)（无符号比较，负数也拦）
fn _slice_check(fc: FnCtx, i: int, n: int) {
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    // 条件反过来写：`jb lok` 直接跳过死路（v2.46）
    _ir_emit(fc, OP_JCMP, 0x82, i, n, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

/// `a[lo..hi]`：数组 / vec / 切片都能切，结果是一个 (ptr, len) 视图
fn _lower_slice(fc: FnCtx, nd: Node) -> int {
    let bty = _ty_of_expr(fc, nd.a)
    let mut elem = TY_INT
    let mut base = 0
    let mut blen = 0
    if bty >= TY_SLICE && bty < TY_ARRAY {
        let sv = _lower_expr(fc, nd.a)
        elem = bty - TY_SLICE
        base = _vnew(fc)
        fc.vty.set(base, TY_INT)
        _ir_emit(fc, OP_LOAD, base, sv, 0, 8)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
        blen = _vnew(fc)
        fc.vty.set(blen, TY_INT)
        _ir_emit(fc, OP_LOAD, blen, la, 0, 8)
    } else if bty >= TY_VEC && bty < TY_MAP {
        let h = _lower_expr(fc, nd.a)
        elem = bty - TY_VEC
        base = _pin(fc, _vec_field(fc, h, 0))     // 数据块基址
        blen = _vec_field(fc, h, 8)
    } else if bty >= TY_ARRAY {
        elem = _ty_elem(bty)
        base = _addr_of(fc, nd.a)
        blen = _map_const(fc, _ty_size(fc, bty) / 8)
    } else {
        eprint("qlmc: 只有数组 / vec / 切片能切片")
        exit(2)
    }
    let lo = _pin(fc, _lower_expr(fc, nd.b))
    let hi = _pin(fc, _lower_expr(fc, nd.c))
    // lo <= hi 且 hi <= blen
    let l1 = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x87, lo, hi, l1)      // ja：lo > hi → 越界
    let l2 = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x87, hi, blen, l2)    // hi > blen → 越界
    let lok = _newlab(fc.labs)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, l1)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, l2)
    let one2 = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one2, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
    // 视图落进隐藏聚合变量
    let ty = TY_SLICE + elem
    let v = _new_var(fc, -1, ty)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRV, va, 0, 0, -fc.vloc.get(v) - 1)
    let eight = _map_const(fc, 8)
    let off8 = _vnew(fc)
    fc.vty.set(off8, TY_INT)
    _ir_emit(fc, OP_MUL, off8, lo, eight, 0)
    let ptr = _vnew(fc)
    fc.vty.set(ptr, TY_INT)
    _ir_emit(fc, OP_ADD, ptr, base, off8, 0)
    _ir_emit(fc, OP_STORE, 0, va, ptr, 8)
    let la2 = _vnew(fc)
    fc.vty.set(la2, TY_INT)
    _ir_emit(fc, OP_ADDRF, la2, va, 0, 8)
    let n = _vnew(fc)
    fc.vty.set(n, TY_INT)
    _ir_emit(fc, OP_SUB, n, hi, lo, 0)
    _ir_emit(fc, OP_STORE, 0, la2, n, 8)
    fc.vty.set(va, ty)
    return va
}

// ---- map（v2.21）：固定容量 + 线性扫描；布局 [cap][count] + cap*(key,val) ----
// 约定：键槽为 0 表示空位（所以 int 键不能用 0，str 键的 null 天然表示空）。

/// 把值钉进变量。**跨循环回边存活的值必须 pin**：临时值的活跃区间不覆盖回边，
/// 分配器会把它的槽位复用掉（v2.21 实测：map 的 cap16 被复用成 slot 地址）。
fn _pin(fc: FnCtx, v: int) -> int {
    let d = _new_var(fc, -1, TY_INT)
    _ir_emit(fc, OP_MOV, d, v, 0, 0)
    return d
}

/// map 扩容：容量翻倍 + 拷旧数据 + **清零新槽位**（键 0 表示空槽，不清零会被当成命中）。
fn _map_grow(fc: FnCtx, h: int) {
    let hp = _pin(fc, h)
    let cap = _pin(fc, _vec_field(fc, hp, 0))
    let two = _map_const(fc, 2)
    let ncap = _vnew(fc)
    fc.vty.set(ncap, TY_INT)
    _ir_emit(fc, OP_MUL, ncap, cap, two, 0)
    let sixteen = _pin(fc, _map_const(fc, 16))
    let nb = _vnew(fc)
    fc.vty.set(nb, TY_INT)
    _ir_emit(fc, OP_MUL, nb, ncap, sixteen, 0)
    _ir_emit(fc, OP_ARG, 0, nb, 0, 0)
    let nd = _vnew(fc)
    fc.vty.set(nd, TY_INT)
    _ir_emit(fc, OP_CALLRT, nd, 0, 0, RT_ALLOC)
    let ob = _vnew(fc)
    fc.vty.set(ob, TY_INT)
    _ir_emit(fc, OP_MUL, ob, cap, sixteen, 0)
    let op = _map_base(fc, hp)
    _ir_emit(fc, OP_MEMCPYN, ob, nd, op, 0)
    let tail = _vnew(fc)
    fc.vty.set(tail, TY_INT)
    _ir_emit(fc, OP_ADD, tail, nd, ob, 0)
    _ir_emit(fc, OP_ZERON, 0, tail, ob, 0)
    let ca = _vnew(fc)
    fc.vty.set(ca, TY_INT)
    _ir_emit(fc, OP_ADDRF, ca, hp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, ca, ncap, 8)
    let da = _vnew(fc)
    fc.vty.set(da, TY_INT)
    _ir_emit(fc, OP_ADDRF, da, hp, 0, 16)
    _ir_emit(fc, OP_STORE, 0, da, nd, 8)
}

/// map 的数据块地址（v2.43：布局 `[cap][len][data]`，数据在**独立块**里，
/// 扩容时只换指针，调用方手里的句柄不用动）。
fn _map_base(fc: FnCtx, h: int) -> int {
    let a = _vnew(fc)
    fc.vty.set(a, TY_INT)
    _ir_emit(fc, OP_ADDRF, a, h, 0, 16)
    let b = _vnew(fc)
    fc.vty.set(b, TY_INT)
    _ir_emit(fc, OP_LOAD, b, a, 0, 8)
    return b
}

fn _map_const(fc: FnCtx, v: int) -> int {
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_CONST, d, 0, 0, v)
    return d
}

/// 线性扫描，返回**命中的槽地址**或**第一个空槽地址**（满了就 exit(1)）。
/// 调用方自己再读一次键就能区分"命中"还是"空位"。
fn _map_slot_of(fc: FnCtx, h: int, k0: int) -> int {
    let cap = _vec_field(fc, h, 0)
    let sixteen = _pin(fc, _map_const(fc, 16))
    let c16 = _vnew(fc)
    fc.vty.set(c16, TY_INT)
    _ir_emit(fc, OP_MUL, c16, cap, sixteen, 0)
    let cap16 = _pin(fc, c16)
    let base = _pin(fc, _map_base(fc, h))
    let off = _pin(fc, _map_const(fc, 0))
    let zero = _pin(fc, _map_const(fc, 0))
    let k = _pin(fc, k0)
    let ltop = _newlab(fc.labs)
    let lfull = _newlab(fc.labs)
    let ldone = _newlab(fc.labs)
    let slot = _pin(fc, _map_const(fc, 0))
    _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
    _ir_emit(fc, OP_JCMP, 0x83, off, cap16, lfull)
    let sa = _vnew(fc)
    fc.vty.set(sa, TY_INT)
    _ir_emit(fc, OP_ADD, sa, base, off, 0)
    _ir_emit(fc, OP_MOV, slot, sa, 0, 0)
    let key = _vnew(fc)
    fc.vty.set(key, TY_INT)
    _ir_emit(fc, OP_LOAD, key, slot, 0, 8)
    _ir_emit(fc, OP_JCMP, 0x84, key, zero, ldone)     // 空位 → 就用它
    _ir_emit(fc, OP_JCMP, 0x84, key, k, ldone)        // 键相同 → 命中
    let nx = _vnew(fc)
    fc.vty.set(nx, TY_INT)
    _ir_emit(fc, OP_ADD, nx, off, sixteen, 0)
    _ir_emit(fc, OP_MOV, off, nx, 0, 0)
    _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfull)
    // 满了且没有这个键 → 返回 0，由调用方决定怎么办（v2.41）。
    // **不能在这里 exit**：`has` / `get` 在满表上查不存在的键也会走到这儿，
    // 一次读操作把进程干掉是不合理的。
    let zz = _map_const(fc, 0)
    _ir_emit(fc, OP_MOV, slot, zz, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, ldone)
    return slot
}

fn _map_new(fc: FnCtx, nd: Node) -> int {
    let n = _pin(fc, _lower_expr(fc, nd.b))
    let sixteen = _map_const(fc, 16)
    let per0 = _vnew(fc)
    fc.vty.set(per0, TY_INT)
    _ir_emit(fc, OP_MUL, per0, n, sixteen, 0)
    let per = _pin(fc, per0)
    let hsz = _map_const(fc, 24)
    _ir_emit(fc, OP_ARG, 0, hsz, 0, 0)
    let h = _vnew(fc)
    fc.vty.set(h, TY_MAP + (nd.a << 8) + nd.c)
    _ir_emit(fc, OP_CALLRT, h, 0, 0, RT_ALLOC)
    _ir_emit(fc, OP_ARG, 0, per, 0, 0)
    let data = _vnew(fc)
    fc.vty.set(data, TY_INT)
    _ir_emit(fc, OP_CALLRT, data, 0, 0, RT_ALLOC)
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, h, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, n, 8)
    let z = _map_const(fc, 0)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, z, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, h, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, data, 8)
    _ir_emit(fc, OP_ZERON, 0, data, per, 0)
    return h
}

/// 把 kp/vp 写进 `slot`（slot 必须来自 `_map_slot_of`）：空槽就先落键并 count++，
/// 非空就只覆盖值。
///
/// 单独抽成函数是**故意的**：`_map_set` 里不能写"先 `let slot = f()`、在 if 里
/// `slot = g()`、出来再用 slot"——qlmc 的分配器会把这两次定义合并成同一个变量的
/// 前后两个定义，跳过 if 的那条路上读到的是**未初始化的帧槽**（v2.43 实测：反汇编
/// 里 `jne lhave` 直接跳到读 `[rbp-0x98]`，那里还是 0，于是 `[0]` 段错误）。
/// 用"两个只定义一次的变量 + 两条路各插一次"就没有 join。
fn _map_put(fc: FnCtx, slot: int, kp: int, vp: int, h: int) {
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let lskip = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x85, old, zero, lskip)     // 非空 → 只覆盖值
    _ir_emit(fc, OP_STORE, 0, slot, kp, 8)
    let cnt = _vec_field(fc, h, 8)
    let one = _map_const(fc, 1)
    let nc = _vnew(fc)
    fc.vty.set(nc, TY_INT)
    _ir_emit(fc, OP_ADD, nc, cnt, one, 0)
    let ca = _vnew(fc)
    fc.vty.set(ca, TY_INT)
    _ir_emit(fc, OP_ADDRF, ca, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, ca, nc, 8)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lskip)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRF, va, slot, 0, 8)
    _ir_emit(fc, OP_STORE, 0, va, vp, 8)
}

/// m.set(k, v)：空位就插入并 count++，已有就覆盖；表满且键不存在就先扩容
/// （v2.43，对齐 stage-0 的自动扩容）。
fn _map_set(fc: FnCtx, nd: Node, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let v = _lower_expr(fc, nd.n)
    let hp = _pin(fc, h)
    let kp = _pin(fc, k)
    let vp = _pin(fc, v)
    let s1 = _map_slot_of(fc, hp, kp)
    let z0 = _map_const(fc, 0)
    let lgo = _newlab(fc.labs)
    let lend = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x85, s1, z0, lgo)          // s1 != 0 → 直接插入
    // 满表：扩容后重找，插入；然后跳过另一条路
    _map_grow(fc, hp)
    let s2 = _map_slot_of(fc, hp, kp)
    _map_put(fc, s2, kp, vp, hp)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lgo)
    _map_put(fc, s1, kp, vp, hp)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
    let d = _map_const(fc, 0)
    return d
}

/// m.get(k)：命中读值，空位返回 0
fn _map_get(fc: FnCtx, nd: Node, vty: int, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let slot = _map_slot_of(fc, h, k)
    // slot == 0：满表 + 键不存在 → 退 1（stage-0 那边是 fail-fast 退 1，口径一致）
    let z1 = _map_const(fc, 0)
    let lhit = _newlab(fc.labs)
    let lout = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x85, slot, z1, lhit)
    let one1 = _map_const(fc, 1)
    _ir_emit(fc, OP_EXIT, 0, one1, 0, 0)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lout)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lhit)
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let d = _vnew(fc)
    fc.vty.set(d, vty)
    _ir_emit(fc, OP_CONST, d, 0, 0, 0)
    let lmiss = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x84, old, zero, lmiss)
    let va = _vnew(fc)
    fc.vty.set(va, TY_INT)
    _ir_emit(fc, OP_ADDRF, va, slot, 0, 8)
    _ir_emit(fc, OP_LOAD, d, va, 0, 8)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lmiss)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lout)
    return d
}

/// m.has(k) → 1/0
fn _map_has(fc: FnCtx, nd: Node, h: int) -> int {
    let k = _lower_expr(fc, nd.c)
    let slot = _map_slot_of(fc, h, k)
    let d0 = _map_const(fc, 0)
    fc.vty.set(d0, TY_BOOL)
    let z2 = _map_const(fc, 0)
    let lhit2 = _newlab(fc.labs)
    let lout2 = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x85, slot, z2, lhit2)
    _ir_emit(fc, OP_JMP, 0, 0, 0, lout2)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lhit2)
    let old = _vnew(fc)
    fc.vty.set(old, TY_INT)
    _ir_emit(fc, OP_LOAD, old, slot, 0, 8)
    let zero = _map_const(fc, 0)
    let d = _map_const(fc, 0)
    fc.vty.set(d, TY_BOOL)
    let lmiss = _newlab(fc.labs)
    _ir_emit(fc, OP_JCMP, 0x84, old, zero, lmiss)
    let one = _map_const(fc, 1)
    _ir_emit(fc, OP_MOV, d, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lmiss)
    _ir_emit(fc, OP_MOV, d0, d, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lout2)
    return d0
}

// ---- vec 运行时辅助（v2.19；放在文件末尾，避免扰动既有函数的代码布局）----
//
// v2.27：布局改成和 stage-0 一致的「头块 + 独立数据块」：
//   [h+0]=data 指针  [h+8]=len  [h+16]=cap
// 旧布局是 [len][cap][data...] 单块，数据紧跟在头后面，一旦扩容就必须换整块，
// 句柄随之变化——任何别名变量（`let w = v`、vec[vec[T]] 的元素）立刻悬垂。
// 头块独立后，扩容只改 [h+0]/[h+16]，句柄恒定，别名问题从根上消失。

/// 读头字段：[h + off]（off = 0 数据指针 / 8 长度 / 16 容量）
fn _vec_field(fc: FnCtx, h: int, off: int) -> int {
    let a = _vnew(fc)
    fc.vty.set(a, TY_INT)
    _ir_emit(fc, OP_ADDRF, a, h, 0, off)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_LOAD, d, a, 0, 8)
    return d
}

/// 越界就 exit(1)：`jb` 是**无符号**比较，负数下标也会被拦下
fn _vec_check(fc: FnCtx, h: int, i: int) {
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    // 条件反过来写：`jb lok` 直接跳过死路（同 _addr_index，v2.46）
    // v2.53：长度装载与比较合成一条 `cmp i, [h+8]`（以前是 mov + cmp 两条）
    _ir_emit(fc, OP_JCMPVLEN, 0x82, i, h, lok)  // cmp i, [h+8]; jb → 跳过
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let one = _vnew(fc)
    fc.vty.set(one, TY_INT)
    _ir_emit(fc, OP_CONST, one, 0, 0, 1)
    _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

/// 元素地址 = data + i*stride（data 是**数据块**基址，不是句柄）。
/// stride = 8 走 `shl 3` 的快路径；聚合元素用 `OP_ADDRXN`（imul）——vec[Struct]
/// 的元素步长是结构体字节数，v2.31 起才存在这种情况。
fn _vec_elem_addr(fc: FnCtx, data: int, i: int, stride: int) -> int {
    let a = _vnew(fc)
    fc.vty.set(a, TY_INT)
    if stride == 8 {
        _ir_emit(fc, OP_ADDRX, a, data, i, 8)
    } else {
        _ir_emit(fc, OP_ADDRXN, a, data, i, stride)
    }
    return a
}

/// **冷路径**：容量翻倍、分配新数据块、搬旧数据、更新头。只改 [h+0] 与 [h+16]。
///
/// 这里刻意**不接收也不返回** len/cap/data——全部自己重新读一遍。原因：
/// push 的常见路径是"还有空间"，那条路上不应该为扩容付出任何代价（v2.27 第一版
/// 把 len/cap/data 提前钉进帧槽，push 的机器码从 26 条涨到 ~40 条）。把读+钉
/// 全塞进冷路径后，常见路径只剩 `cmp+jl` 加一次重新读 len。
///
/// ncp = max(cap*2, 4)：new(0) 的容量是 0，翻倍还是 0，必须兜底成 4，
/// 否则 push 会往 0 字节的块里写，踩下一块堆。
fn _vec_grow_body(fc: FnCtx, h: int, stride: int) {
    let hp = _pin(fc, h)
    let len = _pin(fc, _vec_field(fc, hp, 8))
    let cap = _pin(fc, _vec_field(fc, hp, 16))
    let old = _pin(fc, _vec_field(fc, hp, 0))
    // ncp = cap*2，下限 4
    let two = _vnew(fc)
    fc.vty.set(two, TY_INT)
    _ir_emit(fc, OP_CONST, two, 0, 0, 2)
    let d2 = _vnew(fc)
    fc.vty.set(d2, TY_INT)
    _ir_emit(fc, OP_MUL, d2, cap, two, 0)
    let ncp = _new_var(fc, -1, TY_INT)
    _ir_emit(fc, OP_MOV, ncp, d2, 0, 0)
    let four = _vnew(fc)
    fc.vty.set(four, TY_INT)
    _ir_emit(fc, OP_CONST, four, 0, 0, 4)
    let lt = _vnew(fc)
    fc.vty.set(lt, TY_INT)
    _ir_emit(fc, OP_CMP, lt, d2, four, 0x9C)       // setl（imm 是 setcc 码，不是 jcc 码）
    let lge = _newlab(fc.labs)
    _ir_emit(fc, OP_JZ, 0, lt, 0, lge)
    _ir_emit(fc, OP_MOV, ncp, four, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lge)
    // 分配 ncp*stride 字节
    let eight = _vnew(fc)
    fc.vty.set(eight, TY_INT)
    _ir_emit(fc, OP_CONST, eight, 0, 0, stride)
    let nb = _vnew(fc)
    fc.vty.set(nb, TY_INT)
    _ir_emit(fc, OP_MUL, nb, ncp, eight, 0)
    _ir_emit(fc, OP_ARG, 0, nb, 0, 0)
    let nd = _vnew(fc)
    fc.vty.set(nd, TY_INT)
    _ir_emit(fc, OP_CALLRT, nd, 0, 0, RT_ALLOC)
    let dp = _pin(fc, nd)
    // 搬 len*stride 字节（运行时长度 → OP_MEMCPYN）
    let eight2 = _vnew(fc)
    fc.vty.set(eight2, TY_INT)
    _ir_emit(fc, OP_CONST, eight2, 0, 0, stride)
    let cb = _vnew(fc)
    fc.vty.set(cb, TY_INT)
    _ir_emit(fc, OP_MUL, cb, len, eight2, 0)
    _ir_emit(fc, OP_MEMCPYN, cb, dp, old, 0)
    // 更新头
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, hp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, dp, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, hp, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, ncp, 8)
}

/// vec[T].new(n)：头块 24 字节 [data][len][cap] + 独立数据块 n*8
fn _lower_vecnew(fc: FnCtx, nd: Node) -> int {
    let n = _pin(fc, _lower_expr(fc, nd.b))
    let h = _vnew(fc)
    fc.vty.set(h, TY_VEC + nd.a)
    let hdr = _vnew(fc)
    fc.vty.set(hdr, TY_INT)
    _ir_emit(fc, OP_CONST, hdr, 0, 0, 24)
    _ir_emit(fc, OP_ARG, 0, hdr, 0, 0)
    _ir_emit(fc, OP_CALLRT, h, 0, 0, RT_ALLOC)
    // 数据块 = cap * 元素步长（聚合元素时步长是结构体字节数，v2.31）
    let stride = _ty_size(fc, nd.a)
    let stv = _vnew(fc)
    fc.vty.set(stv, TY_INT)
    _ir_emit(fc, OP_CONST, stv, 0, 0, stride)
    let bytes = _vnew(fc)
    fc.vty.set(bytes, TY_INT)
    _ir_emit(fc, OP_MUL, bytes, n, stv, 0)
    _ir_emit(fc, OP_ARG, 0, bytes, 0, 0)
    let data = _vnew(fc)
    fc.vty.set(data, TY_INT)
    _ir_emit(fc, OP_CALLRT, data, 0, 0, RT_ALLOC)
    // 这里之后没有调用了，h / data 不用 pin（跨调用的活跃由分配器的 cp[] 兜住）
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, h, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, data, 8)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, h, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, z, 8)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, h, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, n, 8)
    return h
}

/// 方法分发：vec 与 map 共用（按接收者类型分派）
/// spawn f(args) -> 任务句柄（v2.32）。
///
/// 参数块布局（24 + 8n 字节，多给 8 字节余量给入口读 4 个寄存器实参）：
///   [0]  返回值（worker 写回）
///   [1]  目标函数地址
///   [2]  实参个数
///   [3+i] 第 i 个实参
/// 为什么把"函数地址 + 实参个数"塞进块里：函数体是**并行编译**的，spawn 站点
/// 在发射期才知道，没法往顺序段里追加"每个站点一个入口例程"。所以做成一个
/// 通用入口 `__spawn_entry`（见 _gen_spawn），所有形状共用一个。
fn _lower_spawn(fc: FnCtx, nd: Node) -> int {
    let fi = _fn_index(fc, nd.a)
    if fi < 0 {
        // 注意：这里**故意**不拼字符串。v2.32 实测，只要 _lower_spawn 里出现
        // `eprint("..." + expr)` 这种拼接，s3_manyfns 的编译就从 19 ms 涨到 33 ms
        // （这段代码从不执行，纯 stage-0 代码生成的敏感性，见坑表 #35）。
        eprint("qlmc: spawn 的目标必须是用户函数")
        exit(2)
    }
    let f = fc.fns.get(fi)
    if f.body < 0 {
        eprint("qlmc: spawn 的目标不能是 @ffi 声明")
        exit(2)
    }
    if _ty_is_agg(f.ret_t) {
        eprint("qlmc: spawn 暂不支持聚合返回值")
        exit(2)
    }
    if f.ret_t == TY_STR {
        eprint("qlmc: spawn 暂不支持 str 返回值")
        exit(2)
    }
    let av = _call_args(fc, nd)
    if len(av) != f.np {
        eprint("qlmc: spawn 的实参个数与目标函数形参不符")
        exit(2)
    }
    let vals = vec[int].new(4)
    let mut ai = 0
    while ai < len(av) {
        let v = _lower_expr(fc, av.get(ai))
        if _ty_is_agg(fc.vty.get(v)) {
            eprint("qlmc: spawn 的实参暂不支持聚合")
            exit(2)
        }
        vals.push(v)
        ai = ai + 1
    }
    let n = len(vals)
    let sz = _vnew(fc)
    fc.vty.set(sz, TY_INT)
    _ir_emit(fc, OP_CONST, sz, 0, 0, 32 + 8 * n)
    _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
    let blk = _vnew(fc)
    fc.vty.set(blk, TY_INT)
    _ir_emit(fc, OP_CALLRT, blk, 0, 0, RT_ALLOC)
    let bp = _pin(fc, blk)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRF, a0, bp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, a0, z, 8)
    let fa = _vnew(fc)
    fc.vty.set(fa, TY_INT)
    _ir_emit(fc, OP_LEAFN, fa, 0, 0, fi)
    let a1 = _vnew(fc)
    fc.vty.set(a1, TY_INT)
    _ir_emit(fc, OP_ADDRF, a1, bp, 0, 8)
    _ir_emit(fc, OP_STORE, 0, a1, fa, 8)
    let nn = _vnew(fc)
    fc.vty.set(nn, TY_INT)
    _ir_emit(fc, OP_CONST, nn, 0, 0, n)
    let a2 = _vnew(fc)
    fc.vty.set(a2, TY_INT)
    _ir_emit(fc, OP_ADDRF, a2, bp, 0, 16)
    _ir_emit(fc, OP_STORE, 0, a2, nn, 8)
    let mut i = 0
    while i < n {
        let ax = _vnew(fc)
        fc.vty.set(ax, TY_INT)
        _ir_emit(fc, OP_ADDRF, ax, bp, 0, 24 + 8 * i)
        _ir_emit(fc, OP_STORE, 0, ax, vals.get(i), 8)
        i = i + 1
    }
    // CreateThread(0, 0, &__spawn_entry, blk, 0, 0)：6 个实参，后两个走栈
    let entry = _vnew(fc)
    fc.vty.set(entry, TY_INT)
    _ir_emit(fc, OP_RTADDR, entry, 0, 0, RT_SPAWN)
    let ep = _pin(fc, entry)
    let cargs = vec[int].new(6)
    let z1 = _vnew(fc)
    fc.vty.set(z1, TY_INT)
    _ir_emit(fc, OP_CONST, z1, 0, 0, 0)
    let z2 = _vnew(fc)
    fc.vty.set(z2, TY_INT)
    _ir_emit(fc, OP_CONST, z2, 0, 0, 0)
    let z3 = _vnew(fc)
    fc.vty.set(z3, TY_INT)
    _ir_emit(fc, OP_CONST, z3, 0, 0, 0)
    let z4 = _vnew(fc)
    fc.vty.set(z4, TY_INT)
    _ir_emit(fc, OP_CONST, z4, 0, 0, 0)
    cargs.push(z1)
    cargs.push(z2)
    cargs.push(ep)
    cargs.push(bp)
    cargs.push(z3)
    cargs.push(z4)
    let stk = _emit_call_args(fc, cargs, 0)
    let h = _vnew(fc)
    fc.vty.set(h, TY_INT)
    _ir_emit(fc, OP_CALLIAT, h, 0, 0, I_CREATE)
    _emit_call_free(fc, stk)
    // 句柄记录：[0]=线程句柄 [1]=参数块（join 用它取返回值）
    let hp = _pin(fc, h)
    let r16 = _vnew(fc)
    fc.vty.set(r16, TY_INT)
    _ir_emit(fc, OP_CONST, r16, 0, 0, 16)
    _ir_emit(fc, OP_ARG, 0, r16, 0, 0)
    let rec = _vnew(fc)
    fc.vty.set(rec, TY_INT)
    _ir_emit(fc, OP_CALLRT, rec, 0, 0, RT_ALLOC)
    let rp = _pin(fc, rec)
    let b0 = _vnew(fc)
    fc.vty.set(b0, TY_INT)
    _ir_emit(fc, OP_ADDRF, b0, rp, 0, 0)
    _ir_emit(fc, OP_STORE, 0, b0, hp, 8)
    let b1 = _vnew(fc)
    fc.vty.set(b1, TY_INT)
    _ir_emit(fc, OP_ADDRF, b1, rp, 0, 8)
    _ir_emit(fc, OP_STORE, 0, b1, bp, 8)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_MOV, d, rp, 0, 0)
    return d
}

/// 内建分派（v2.33）：内存原语 + 诊断/串原语。返回 -1 表示不是内建。
///
/// 为什么要内建而不是写进 std：这些是"语言层原语"（stage-0 也是内建），
/// 而 qlmc 自己的源码与 std/mem.qma 都靠它们。语义一律对齐 stage-0：
///   mem_load8(p,i)  读第 i 个**字节**（零扩展）
///   mem_load64(p,w) 读第 w 个 **8 字节字**（不是字节！）
///   mem_free(p,n)   本版分配器是 bump，**不回收**（语义差异，见 §7.20）
///   cstr(s)         qlmc 的 str 布局本来就是 [len][bytes][NUL]，值即指针 → 恒等
fn _lower_builtin(fc: FnCtx, nd: Node) -> int {
    let bn = fc.names.get(nd.a)
    // ---- 诊断 ----
    if bn == "eprint" {
        let a = _lower_expr(fc, nd.b)
        _ir_emit(fc, OP_ARG, 0, a, 0, 0)
        _ir_emit(fc, OP_CALLRT, 0, 0, 0, RT_EPRINT)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    // ---- 内存 ----
    if bn == "mem_alloc" {
        let n = _lower_expr(fc, nd.b)
        _ir_emit(fc, OP_ARG, 0, n, 0, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_ALLOC)
        return d
    }
    if bn == "mem_free" {
        // bump 分配器：不回收。实参照求值（保持副作用次序），返回 0。
        _lower_expr(fc, nd.b)
        if nd.c >= 0 {
            _lower_expr(fc, nd.c)
        }
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if bn == "mem_load64" {
        let p = _lower_expr(fc, nd.b)
        let w = _lower_expr(fc, nd.c)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADDRX, a, p, w, 8)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_LOAD, d, a, 0, 8)
        return d
    }
    if bn == "mem_store64" {
        let p = _lower_expr(fc, nd.b)
        let w = _lower_expr(fc, nd.c)
        let v = _lower_expr(fc, nd.n)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADDRX, a, p, w, 8)
        _ir_emit(fc, OP_STORE, 0, a, v, 8)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if bn == "mem_load8" {
        let p = _lower_expr(fc, nd.b)
        let i = _lower_expr(fc, nd.c)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADD, a, p, i, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_LOAD8, d, a, 0, 0)
        return d
    }
    if bn == "mem_store8" {
        let p = _lower_expr(fc, nd.b)
        let i = _lower_expr(fc, nd.c)
        let v = _lower_expr(fc, nd.n)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADD, a, p, i, 0)
        _ir_emit(fc, OP_STORE8, 0, a, v, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if bn == "mem_copy" {
        let dp = _lower_expr(fc, nd.b)
        let sp = _lower_expr(fc, nd.c)
        let n = _lower_expr(fc, nd.n)
        _ir_emit(fc, OP_MEMCPYN, n, dp, sp, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if bn == "mem_zero" {
        let p = _lower_expr(fc, nd.b)
        let n = _lower_expr(fc, nd.c)
        _ir_emit(fc, OP_ZERON, 0, p, n, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if bn == "mem_cmp" {
        let a = _lower_expr(fc, nd.b)
        let b = _lower_expr(fc, nd.c)
        let n = _lower_expr(fc, nd.n)
        _ir_emit(fc, OP_ARG, 0, a, 0, 0)
        _ir_emit(fc, OP_ARG, 0, b, 0, 1)
        _ir_emit(fc, OP_ARG, 0, n, 0, 2)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_MEMCMP)
        return d
    }
    // ---- 串 ----
    if bn == "cstr" {
        // qlmc 的 str = [len][bytes][NUL]，值就是数据指针 → 恒等。
        // （stage-0 那边会新分配一份，语义等价：调用方只读。）
        let a = _lower_expr(fc, nd.b)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_MOV, d, a, 0, 0)
        return d
    }
    if bn == "chr" {
        // chr(n) -> 1 字节的 str
        let n = _lower_expr(fc, nd.b)
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        _ir_emit(fc, OP_CONST, sz, 0, 0, 10)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let q = _vnew(fc)
        fc.vty.set(q, TY_INT)
        _ir_emit(fc, OP_CALLRT, q, 0, 0, RT_ALLOC)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRF, a0, q, 0, 0)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_STORE, 0, a0, one, 8)
        let a1 = _vnew(fc)
        fc.vty.set(a1, TY_INT)
        _ir_emit(fc, OP_ADDRF, a1, q, 0, 8)
        _ir_emit(fc, OP_STORE8, 0, a1, n, 0)
        let a2 = _vnew(fc)
        fc.vty.set(a2, TY_INT)
        _ir_emit(fc, OP_ADDRF, a2, a1, 0, 1)
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_STORE8, 0, a2, z, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
        _ir_emit(fc, OP_MOV, d, a1, 0, 0)
        return d
    }
    if bn == "substr" {
        // substr(s, lo, n) -> 新串（第三个数是**长度**，与 stage-0 一致）
        let sv = _lower_expr(fc, nd.b)
        let lo = _lower_expr(fc, nd.c)
        let n = _lower_expr(fc, nd.n)
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        let nine = _vnew(fc)
        fc.vty.set(nine, TY_INT)
        _ir_emit(fc, OP_CONST, nine, 0, 0, 9)
        _ir_emit(fc, OP_ADD, sz, n, nine, 0)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let q = _vnew(fc)
        fc.vty.set(q, TY_INT)
        _ir_emit(fc, OP_CALLRT, q, 0, 0, RT_ALLOC)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRF, a0, q, 0, 0)
        _ir_emit(fc, OP_STORE, 0, a0, n, 8)
        let dstp = _vnew(fc)
        fc.vty.set(dstp, TY_INT)
        _ir_emit(fc, OP_ADDRF, dstp, q, 0, 8)
        let srcp = _vnew(fc)
        fc.vty.set(srcp, TY_INT)
        _ir_emit(fc, OP_ADD, srcp, sv, lo, 0)
        _ir_emit(fc, OP_MEMCPYN, n, dstp, srcp, 0)
        let endp = _vnew(fc)
        fc.vty.set(endp, TY_INT)
        _ir_emit(fc, OP_ADD, endp, dstp, n, 0)
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_STORE8, 0, endp, z, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
        _ir_emit(fc, OP_MOV, d, dstp, 0, 0)
        return d
    }
    // ---- 数值转换（v2.38）：与 stage-0 一致，用**函数**形式 to_float(x) / to_int(x) ----
    if bn == "to_float" || bn == "to_f64" {
        let v = _lower_expr(fc, nd.b)
        if fc.vty.get(v) == TY_F64 {
            return v
        }
        return _to_f64(fc, v)
    }
    if bn == "to_int" {
        let v = _lower_expr(fc, nd.b)
        let vt = fc.vty.get(v)
        if vt == TY_F64 {
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_FTOI, d, v, 0, 0)  // v2.47：内联 cvttsd2si
            return d
        }
        if vt == TY_STR {
            _ir_emit(fc, OP_ARG, 0, v, 0, 0)
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_STR2INT)
            return d
        }
        return v
    }
    // ---- 文件 / 时钟 ----
    if bn == "file_exists" {
        // GetFileAttributesA 返回 DWORD，INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF。
        // 64 位比较前先掩到 32 位，免得高 32 位的"未定义"把判断带偏。
        let pv = _lower_expr(fc, nd.b)
        _ir_emit(fc, OP_ARG, 0, pv, 0, 0)
        let r = _vnew(fc)
        fc.vty.set(r, TY_INT)
        _ir_emit(fc, OP_CALLIAT, r, 0, 0, I_FILEATTR)
        let mask = _vnew(fc)
        fc.vty.set(mask, TY_INT)
        _ir_emit(fc, OP_CONST, mask, 0, 0, 4294967295)
        let m = _vnew(fc)
        fc.vty.set(m, TY_INT)
        _ir_emit(fc, OP_AND, m, r, mask, 0)
        let bad = _vnew(fc)
        fc.vty.set(bad, TY_INT)
        _ir_emit(fc, OP_CONST, bad, 0, 0, 4294967295)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CMP, d, m, bad, 0x95)      // setne
        return d
    }
    if bn == "now_ns" {
        // QPC 纳秒：ns = (c/f)*1e9 + ((c%f)*1e9)/f
        // 先除后乘再补余数——直接 c*1e9 在开机几小时后就会溢出 int64。
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        _ir_emit(fc, OP_CONST, sz, 0, 0, 16)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let buf = _vnew(fc)
        fc.vty.set(buf, TY_INT)
        _ir_emit(fc, OP_CALLRT, buf, 0, 0, RT_ALLOC)
        _ir_emit(fc, OP_ARG, 0, buf, 0, 0)
        let r1 = _vnew(fc)
        fc.vty.set(r1, TY_INT)
        _ir_emit(fc, OP_CALLIAT, r1, 0, 0, I_QPC)
        let fp = _vnew(fc)
        fc.vty.set(fp, TY_INT)
        _ir_emit(fc, OP_ADDRF, fp, buf, 0, 8)
        _ir_emit(fc, OP_ARG, 0, fp, 0, 0)
        let r2 = _vnew(fc)
        fc.vty.set(r2, TY_INT)
        _ir_emit(fc, OP_CALLIAT, r2, 0, 0, I_QPF)
        let ap = _vnew(fc)
        fc.vty.set(ap, TY_INT)
        _ir_emit(fc, OP_ADDRF, ap, buf, 0, 0)
        let c = _vnew(fc)
        fc.vty.set(c, TY_INT)
        _ir_emit(fc, OP_LOAD, c, ap, 0, 8)
        let f = _vnew(fc)
        fc.vty.set(f, TY_INT)
        _ir_emit(fc, OP_LOAD, f, fp, 0, 8)
        let big = _vnew(fc)
        fc.vty.set(big, TY_INT)
        _ir_emit(fc, OP_CONST, big, 0, 0, 1000000000)
        let secs = _vnew(fc)
        fc.vty.set(secs, TY_INT)
        _ir_emit(fc, OP_DIV, secs, c, f, 0)
        let whole = _vnew(fc)
        fc.vty.set(whole, TY_INT)
        _ir_emit(fc, OP_MUL, whole, secs, big, 0)
        let rem = _vnew(fc)
        fc.vty.set(rem, TY_INT)
        _ir_emit(fc, OP_MOD, rem, c, f, 0)
        let remns = _vnew(fc)
        fc.vty.set(remns, TY_INT)
        _ir_emit(fc, OP_MUL, remns, rem, big, 0)
        let frac = _vnew(fc)
        fc.vty.set(frac, TY_INT)
        _ir_emit(fc, OP_DIV, frac, remns, f, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADD, d, whole, frac, 0)
        return d
    }
    if bn == "mem_str" {
        // mem_str(p, n) -> 拷 n 字节并补 NUL 的 str
        let p = _lower_expr(fc, nd.b)
        let n = _lower_expr(fc, nd.c)
        return _bi_mem_str(fc, p, n)
    }
    // v3.42：tcp_listen(port) -> fd
    //
    // 与 stage-0 的 __tcp_listen 对齐：绑定 0.0.0.0:port 并监听，
    // 失败一律 **fail-fast**（不是返回 -1）。
    //
    // 实现顺序：WSAStartup -> socket -> 构造 sockaddr_in -> bind -> listen。
    // 注意 Win64 的 int 返回值**只写 eax**（高 32 位 0 扩展），
    // 所以 SOCKET_ERROR 在 rax 里是 0x00000000FFFFFFFF 而不是 64 位 -1。
    // 判失败要用「shl 32 / sar 32 符号扩展后与 -1 比较」，不能直接比 -1。
    if bn == "tcp_listen" {
        return _bi_tcp_listen(fc, _lower_expr(fc, nd.b))
    }
    // v3.42：tcp_close(fd) -> 0
    if bn == "tcp_close" {
        return _bi_tcp_close(fc, _lower_expr(fc, nd.b))
    }
    // v3.42：tcp_accept(fd) -> conn（阻塞等待；失败 fail-fast）
    if bn == "tcp_accept" {
        return _bi_tcp_accept(fc, _lower_expr(fc, nd.b))
    }
    // v3.42：tcp_send(fd, str) -> 发送字节数
    if bn == "tcp_send" {
        return _bi_tcp_send(fc, _lower_expr(fc, nd.b), _lower_expr(fc, nd.c))
    }
    // v3.42：tcp_send_n(fd, ptr, n) -> 发送字节数（零拷贝，协议库缓冲池用）
    if bn == "tcp_send_n" {
        return _bi_tcp_send_n(fc, _lower_expr(fc, nd.b), _lower_expr(fc, nd.c), _lower_expr(fc, nd.n))
    }
    // v3.42：tcp_recv(fd, cap) -> str（对端关闭返回**空串**，不是错误）
    if bn == "tcp_recv" {
        return _bi_tcp_recv(fc, _lower_expr(fc, nd.b), _lower_expr(fc, nd.c))
    }
    // v3.39：str_ptr(s) -> int（str 的数据指针）
    // Quelmara 的 str 值**本身就是数据指针**（长度在 p-8），所以零成本：
    // 直接返回操作数。用途是把 str 喂给 tcp_send_n 这类零拷贝内建。
    if bn == "str_ptr" {
        let v = _lower_expr(fc, nd.b)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_MOV, d, v, 0, 0)
        return d
    }
    // v3.39：target_arch() -> int（编译期常量：1 = x86_64 / 2 = aarch64）
    // qlmc 只产 x86-64 PE，所以恒为 1。语言没有条件编译，这个内建的作用
    // 是让库层选对常量（syscall 编号同时取决于 OS 与架构）。
    if bn == "target_arch" {
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 1)
        return d
    }
    // v3.38：mem_diff(p1, p2, n) -> int（首个不同字节的下标，全等返回 n）
    if bn == "mem_diff" {
        let p1 = _lower_expr(fc, nd.b)
        let p2 = _lower_expr(fc, nd.c)
        let nv = _lower_expr(fc, nd.n)
        _ir_emit(fc, OP_ARG, 0, p1, 0, 0)
        _ir_emit(fc, OP_ARG, 0, p2, 0, 1)
        _ir_emit(fc, OP_ARG, 0, nv, 0, 2)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_MEMDIFF)
        return d
    }
    // v3.38：mem_xchg(addr, val) -> int（原子交换，返回旧值）
    if bn == "mem_xchg" {
        let a = _lower_expr(fc, nd.b)
        let v = _lower_expr(fc, nd.c)
        _ir_emit(fc, OP_ARG, 0, a, 0, 0)
        _ir_emit(fc, OP_ARG, 0, v, 0, 1)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_MEMXCHG)
        return d
    }
    // v3.37：mem_chr(p, n, byte) -> int（首个匹配字节的下标，找不到 -1）
    if bn == "mem_chr" {
        let p = _lower_expr(fc, nd.b)
        let n = _lower_expr(fc, nd.c)
        let bv = _lower_expr(fc, nd.n)
        _ir_emit(fc, OP_ARG, 0, p, 0, 0)
        _ir_emit(fc, OP_ARG, 0, n, 0, 1)
        _ir_emit(fc, OP_ARG, 0, bv, 0, 2)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_MEMCHR)
        return d
    }
    // v3.37：str_from_mem(data, n) -> str
    // 与 mem_str(p, n) 语义完全相同（从内存区间拷 n 字节、补 NUL、
    // 带长度头）。stage-0 里两者是分开的内建，std/ 用 str_from_mem 更多。
    if bn == "str_from_mem" {
        let p = _lower_expr(fc, nd.b)
        let n = _lower_expr(fc, nd.c)
        return _bi_mem_str(fc, p, n)
    }
    // v3.36：mem_load32(p, i) -> int（读第 i 个 4 字节，零扩展）
    // 与 mem_load64 同构，只是宽度 4。std/crc32 / crc64 用它。
    if bn == "mem_load32" {
        // **第 2 个参数是字节偏移，不是 4 字节下标**（与 mem_load64 的
        // "第 w 个字"不同！）。实测 stage-0：mem_load32(q,1) 读的是
        // 从偏移 1 开始的 4 字节。这里必须与它一致，否则差分对不上。
        let p = _lower_expr(fc, nd.b)
        let o = _lower_expr(fc, nd.c)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADD, a, p, o, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_LOAD, d, a, 0, 4)
        return d
    }
    // v3.36：str_alloc(n) -> str（分配长度 n 的可写空串，len 头写 0，末尾 NUL）
    //
    // 返回**数据指针**（str 值约定）。std/ 里 join / split / gzip 用它
    // 批量构造：先 alloc 再 mem_store8 填充，比逐字节 vec push 快得多。
    if bn == "str_alloc" {
        let n = _lower_expr(fc, nd.b)
        let nine = _vnew(fc)
        fc.vty.set(nine, TY_INT)
        _ir_emit(fc, OP_CONST, nine, 0, 0, 9)
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        _ir_emit(fc, OP_ADD, sz, n, nine, 0)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let q = _vnew(fc)
        fc.vty.set(q, TY_INT)
        _ir_emit(fc, OP_CALLRT, q, 0, 0, RT_ALLOC)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRF, a0, q, 0, 0)
        _ir_emit(fc, OP_STORE, 0, a0, n, 8)          // 长度头 = n（不是 0）
        let dstp = _vnew(fc)
        fc.vty.set(dstp, TY_INT)
        _ir_emit(fc, OP_ADDRF, dstp, q, 0, 8)
        let endp = _vnew(fc)
        fc.vty.set(endp, TY_INT)
        _ir_emit(fc, OP_ADD, endp, dstp, n, 0)
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_STORE8, 0, endp, z, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
        _ir_emit(fc, OP_MOV, d, dstp, 0, 0)
        return d
    }
    // v3.36：mem_ptr(p, off) -> int（纯指针算术，返回值不带任何标记）
    // std/ 里 4 个模块用它做指针偏移。stage-0 的语义就是 p + off。
    if bn == "mem_ptr" {
        let p = _lower_expr(fc, nd.b)
        let o = _lower_expr(fc, nd.c)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADD, d, p, o, 0)
        return d
    }
    // v3.36：static_word(i) -> int（进程级静态字区第 i 个槽的地址）
    //
    // std/ 有 11 个模块用它（log / timer / reactor / sync …），把状态
    // 放在回调能读到的进程级位置。qlmc 产物的 .bss 现在带一块
    // STATIC_SLOTS 个 8 字节槽的区域（见 STATICW_BSS_OFF），零初始化。
    //
    // 地址 = &bss[STATICW_BSS_OFF] + i*8。用 LEA rip 相对 + FK_BSS 重定位。
    if bn == "static_word" {
        let i = _lower_expr(fc, nd.b)
        let base = _vnew(fc)
        fc.vty.set(base, TY_INT)
        _ir_emit(fc, OP_BSSADDR, base, 0, 0, STATICW_BSS_OFF)
        let eight = _vnew(fc)
        fc.vty.set(eight, TY_INT)
        _ir_emit(fc, OP_CONST, eight, 0, 0, 8)
        let off = _vnew(fc)
        fc.vty.set(off, TY_INT)
        _ir_emit(fc, OP_MUL, off, i, eight, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADD, d, base, off, 0)
        return d
    }
    // v3.36：str_from_bytes(v: vec[int]) -> str
    //
    // **注意签名**：stage-0 收的是**一个 vec[int]**（不是 (p, n)），
    // 每个元素占 8 字节槽、只取**低字节**拼成串（见
    // qlm_native.py 的 __str_from_bytes）。std/ 里有 17 个模块用它，
    // 是 qlmc 编 std/ 失败的第一大原因。
    //
    // 实现：n = v.len()，alloc(n+9)，写长度头，逐元素取低字节写入，
    // 末尾补 NUL。与 _bi_mem_str 的布局一致（[len][bytes][NUL]），
    // 但数据源是 vec 槽而不是连续字节，所以不能直接复用。
    if bn == "str_from_bytes" {
        // v3.36：str_from_bytes(v: vec[int]) -> str
        //
        // **签名**：收的是**一个 vec[int]**（不是 (p, n)），每个元素占
        // 8 字节槽、只取**低字节**拼成串（见 qlm_native.py 的
        // __str_from_bytes）。std/ 里有 17 个模块用它，是 qlmc 编 std/
        // 失败的第一大原因。
        //
        // 布局与 _bi_mem_str 一致：[len][bytes][NUL]，返回数据指针。
        let v = _lower_expr(fc, nd.b)
        let vn = _vec_field(fc, v, 8)                 // vec 长度在 +8
        let vp = _vec_field(fc, v, 0)                 // 数据指针在 +0
        let nine = _vnew(fc)
        fc.vty.set(nine, TY_INT)
        _ir_emit(fc, OP_CONST, nine, 0, 0, 9)
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        _ir_emit(fc, OP_ADD, sz, vn, nine, 0)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let q = _vnew(fc)
        fc.vty.set(q, TY_INT)
        _ir_emit(fc, OP_CALLRT, q, 0, 0, RT_ALLOC)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRF, a0, q, 0, 0)
        _ir_emit(fc, OP_STORE, 0, a0, vn, 8)
        let dstp = _vnew(fc)
        fc.vty.set(dstp, TY_INT)
        _ir_emit(fc, OP_ADDRF, dstp, q, 0, 8)
        // 逐元素：i < n；取槽的低字节写进 dstp+i
        let i = _vnew(fc)
        fc.vty.set(i, TY_INT)
        _ir_emit(fc, OP_CONST, i, 0, 0, 0)
        let ltop = _newlab(fc.labs)
        let ldone = _newlab(fc.labs)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
        _ir_emit(fc, OP_JCMP, 0x8D, i, vn, ldone)     // jge .done
        let bv = _vnew(fc)
        fc.vty.set(bv, TY_INT)
        _ir_emit(fc, OP_LOAD8X, bv, vp, i, 0)         // [vp + i*8] 的低字节
        let da = _vnew(fc)
        fc.vty.set(da, TY_INT)
        _ir_emit(fc, OP_ADD, da, dstp, i, 0)
        _ir_emit(fc, OP_STORE8, 0, da, bv, 0)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_ADD, i, i, one, 0)
        _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ldone)
        // 末尾 NUL
        let endp = _vnew(fc)
        fc.vty.set(endp, TY_INT)
        _ir_emit(fc, OP_ADD, endp, dstp, vn, 0)
        let zz = _vnew(fc)
        fc.vty.set(zz, TY_INT)
        _ir_emit(fc, OP_CONST, zz, 0, 0, 0)
        _ir_emit(fc, OP_STORE8, 0, endp, zz, 0)
        let dd = _vnew(fc)
        fc.vty.set(dd, TY_STR)
        _ir_emit(fc, OP_MOV, dd, dstp, 0, 0)
        return dd
    }
    return -1
}

/// 把 (指针, 长度) 包成一个 Quelmara 串：alloc(n+9) + [len] + 拷贝 + NUL。
/// mem_str 内建与 int.to_str 共用。
fn _bi_mem_str(fc: FnCtx, p: int, n: int) -> int {
    // 长度必须是"看起来合理"的非负数：上游 wsprintfA / GetFileSize 失败时会返回
    // -1 / 0xFFFFFFFF，直接拿去 alloc(n+9) + memcpy 会变成一次巨大的拷贝（AV）。
    // 这里 fail-fast，把静默崩溃换成能定位的报错（v2.35）。
    let lneg = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    _ir_emit(fc, OP_JCMP, 0x8C, n, z, lneg)      // jl：n < 0
    let lim = _vnew(fc)
    fc.vty.set(lim, TY_INT)
    _ir_emit(fc, OP_CONST, lim, 0, 0, 67108864)  // 64 MB 上限
    _ir_emit(fc, OP_JCMP, 0x8F, n, lim, lneg)    // jg
    _ir_emit(fc, OP_JMP, 0, 0, 0, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lneg)
    // 退 7 是这条检查的指纹（降级期拿不到字符串常量：`_str_id` 要解析期的 P，
    // 而且会改共享的 strs 表——并行编译下不安全）
    let seven = _vnew(fc)
    fc.vty.set(seven, TY_INT)
    _ir_emit(fc, OP_CONST, seven, 0, 0, 7)
    _ir_emit(fc, OP_EXIT, 0, seven, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
    let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        let nine = _vnew(fc)
        fc.vty.set(nine, TY_INT)
        _ir_emit(fc, OP_CONST, nine, 0, 0, 9)
        _ir_emit(fc, OP_ADD, sz, n, nine, 0)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let q = _vnew(fc)
        fc.vty.set(q, TY_INT)
        _ir_emit(fc, OP_CALLRT, q, 0, 0, RT_ALLOC)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRF, a0, q, 0, 0)
        _ir_emit(fc, OP_STORE, 0, a0, n, 8)
        let dstp = _vnew(fc)
        fc.vty.set(dstp, TY_INT)
        _ir_emit(fc, OP_ADDRF, dstp, q, 0, 8)
        _ir_emit(fc, OP_MEMCPYN, n, dstp, p, 0)
        let endp = _vnew(fc)
        fc.vty.set(endp, TY_INT)
        _ir_emit(fc, OP_ADD, endp, dstp, n, 0)
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_STORE8, 0, endp, z, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
    _ir_emit(fc, OP_MOV, d, dstp, 0, 0)
    return d
}

/// 网络内建的失败检查（v3.42）。
///
/// tcp_listen
/// 绑定 0.0.0.0:port 并监听，失败 fail-fast。
/// 实现顺序：WSAStartup -> socket -> 构造 sockaddr_in -> bind -> listen。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_listen(fc: FnCtx, port: int) -> int {
    // WSAStartup(0x202, &wsa)：wsa 是 64 字节缓冲，内容不读
    let wsa = _vnew(fc)
    fc.vty.set(wsa, TY_INT)
    _ir_emit(fc, OP_CONST, wsa, 0, 0, 64)
    _ir_emit(fc, OP_ARG, 0, wsa, 0, 0)
    let wh = _vnew(fc)
    fc.vty.set(wh, TY_INT)
    _ir_emit(fc, OP_CALLRT, wh, 0, 0, RT_ALLOC)
    let ver = _vnew(fc)
    fc.vty.set(ver, TY_INT)
    _ir_emit(fc, OP_CONST, ver, 0, 0, 514)      // 0x0202
    _ir_emit(fc, OP_ARG, 0, ver, 0, 0)
    _ir_emit(fc, OP_ARG, 0, wh, 0, 1)
    let wr = _vnew(fc)
    fc.vty.set(wr, TY_INT)
    _ir_emit(fc, OP_CALLIAT, wr, 0, 0, I_WSASTART)
    // WSAStartup 失败：fail-fast
    _net_fail_if_nonzero(fc, wr, 1)
    // socket(AF_INET=2, SOCK_STREAM=1, 0)
    let af = _vnew(fc)
    fc.vty.set(af, TY_INT)
    _ir_emit(fc, OP_CONST, af, 0, 0, 2)
    _ir_emit(fc, OP_ARG, 0, af, 0, 0)
    let typ = _vnew(fc)
    fc.vty.set(typ, TY_INT)
    _ir_emit(fc, OP_CONST, typ, 0, 0, 1)
    _ir_emit(fc, OP_ARG, 0, typ, 0, 1)
    let zero = _vnew(fc)
    fc.vty.set(zero, TY_INT)
    _ir_emit(fc, OP_CONST, zero, 0, 0, 0)
    _ir_emit(fc, OP_ARG, 0, zero, 0, 2)
    let s = _vnew(fc)
    fc.vty.set(s, TY_INT)
    _ir_emit(fc, OP_CALLIAT, s, 0, 0, I_SOCKET)
    // socket 失败（符号扩展后 == -1）
    _net_fail_if_neg1(fc, s, 2)
    // sockaddr_in(16B)：family(2) | htons(port)<<16
    let sin = _vnew(fc)
    fc.vty.set(sin, TY_INT)
    _ir_emit(fc, OP_CONST, sin, 0, 0, 16)
    _ir_emit(fc, OP_ARG, 0, sin, 0, 0)
    let sinb = _vnew(fc)
    fc.vty.set(sinb, TY_INT)
    _ir_emit(fc, OP_CALLRT, sinb, 0, 0, RT_ALLOC)
    // htons：低字节与高字节交换
    let lo = _vnew(fc)
    fc.vty.set(lo, TY_INT)
    let m255 = _vnew(fc)
    fc.vty.set(m255, TY_INT)
    _ir_emit(fc, OP_CONST, m255, 0, 0, 255)
    _ir_emit(fc, OP_AND, lo, port, m255, 0)
    let eight = _vnew(fc)
    fc.vty.set(eight, TY_INT)
    _ir_emit(fc, OP_CONST, eight, 0, 0, 8)
    let lo8 = _vnew(fc)
    fc.vty.set(lo8, TY_INT)
    _ir_emit(fc, OP_SHL, lo8, lo, eight, 0)
    let hi = _vnew(fc)
    fc.vty.set(hi, TY_INT)
    _ir_emit(fc, OP_SHR, hi, port, eight, 0)
    let hi2 = _vnew(fc)
    fc.vty.set(hi2, TY_INT)
    _ir_emit(fc, OP_AND, hi2, hi, m255, 0)
    let hbe = _vnew(fc)
    fc.vty.set(hbe, TY_INT)
    _ir_emit(fc, OP_OR, hbe, lo8, hi2, 0)
    // w0 = family(2) | htons(port)<<16
    let six16 = _vnew(fc)
    fc.vty.set(six16, TY_INT)
    _ir_emit(fc, OP_CONST, six16, 0, 0, 16)
    let sh16 = _vnew(fc)
    fc.vty.set(sh16, TY_INT)
    _ir_emit(fc, OP_SHL, sh16, hbe, six16, 0)
    let two = _vnew(fc)
    fc.vty.set(two, TY_INT)
    _ir_emit(fc, OP_CONST, two, 0, 0, 2)
    let w0 = _vnew(fc)
    fc.vty.set(w0, TY_INT)
    _ir_emit(fc, OP_OR, w0, sh16, two, 0)
    let p0 = _vnew(fc)
    fc.vty.set(p0, TY_INT)
    _ir_emit(fc, OP_ADDRF, p0, sinb, 0, 0)
    _ir_emit(fc, OP_STORE, 0, p0, w0, 8)
    let p8 = _vnew(fc)
    fc.vty.set(p8, TY_INT)
    _ir_emit(fc, OP_ADDRF, p8, sinb, 0, 8)
    _ir_emit(fc, OP_STORE, 0, p8, zero, 8)
    // bind(s, sin, 16)
    _ir_emit(fc, OP_ARG, 0, s, 0, 0)
    _ir_emit(fc, OP_ARG, 0, sinb, 0, 1)
    let n16 = _vnew(fc)
    fc.vty.set(n16, TY_INT)
    _ir_emit(fc, OP_CONST, n16, 0, 0, 16)
    _ir_emit(fc, OP_ARG, 0, n16, 0, 2)
    let br = _vnew(fc)
    fc.vty.set(br, TY_INT)
    _ir_emit(fc, OP_CALLIAT, br, 0, 0, I_BIND)
    _net_fail_if_neg1(fc, br, 3)
    // listen(s, 128)
    _ir_emit(fc, OP_ARG, 0, s, 0, 0)
    let bl = _vnew(fc)
    fc.vty.set(bl, TY_INT)
    _ir_emit(fc, OP_CONST, bl, 0, 0, 128)
    _ir_emit(fc, OP_ARG, 0, bl, 0, 1)
    let lr = _vnew(fc)
    fc.vty.set(lr, TY_INT)
    _ir_emit(fc, OP_CALLIAT, lr, 0, 0, I_LISTEN)
    _net_fail_if_neg1(fc, lr, 4)
    return s
}

/// tcp_close
/// closesocket 的薄封装，恒返回 0。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_close(fc: FnCtx, fd: int) -> int {
    _ir_emit(fc, OP_ARG, 0, fd, 0, 0)
    let r = _vnew(fc)
    fc.vty.set(r, TY_INT)
    _ir_emit(fc, OP_CALLIAT, r, 0, 0, I_CLOSESOCK)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_CONST, d, 0, 0, 0)
    return d
}

/// tcp_accept
/// 阻塞等到一个连接；失败 fail-fast。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_accept(fc: FnCtx, fd: int) -> int {
    _ir_emit(fc, OP_ARG, 0, fd, 0, 0)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    _ir_emit(fc, OP_ARG, 0, z, 0, 1)     // addr = NULL
    _ir_emit(fc, OP_ARG, 0, z, 0, 2)     // addrlen = NULL
    let c = _vnew(fc)
    fc.vty.set(c, TY_INT)
    _ir_emit(fc, OP_CALLIAT, c, 0, 0, I_ACCEPT)
    _net_fail_if_neg1(fc, c, 5)
    return c
}

/// tcp_send
/// 发一个 str（长度取 [s-8] 头）；SOCKET_ERROR 一律 fail-fast。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_send(fc: FnCtx, fd: int, sv: int) -> int {
    // 长度 = [s-8]
    let lp = _vnew(fc)
    fc.vty.set(lp, TY_INT)
    let eight = _vnew(fc)
    fc.vty.set(eight, TY_INT)
    _ir_emit(fc, OP_CONST, eight, 0, 0, 8)
    _ir_emit(fc, OP_SUB, lp, sv, eight, 0)
    let n = _vnew(fc)
    fc.vty.set(n, TY_INT)
    _ir_emit(fc, OP_LOAD, n, lp, 0, 8)
    _ir_emit(fc, OP_ARG, 0, fd, 0, 0)
    _ir_emit(fc, OP_ARG, 0, sv, 0, 1)
    _ir_emit(fc, OP_ARG, 0, n, 0, 2)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    _ir_emit(fc, OP_ARG, 0, z, 0, 3)     // flags = 0
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_CALLIAT, d, 0, 0, I_SEND)
    // 与 stage-0 的 __tcp_send 对齐：SOCKET_ERROR 一律 fail-fast。
    // 不检查的话错误码会被当成"发出去 4294967295 字节"，上层 send_all
    // 的循环条件 n <= 0 永远不成立 → 死循环。
    _net_fail_if_neg1(fc, d, 7)
    return d
}

/// tcp_send_n
/// 零拷贝发送（协议库缓冲池用）。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_send_n(fc: FnCtx, fd: int, ptr: int, n: int) -> int {
    // **顺序故意保持"先发 ARG、后建 0"** —— 这是分配器 ARG 屏障的回归
    // 探针。分配器把 `OP_ARG imm>=2` 当跨调用屏障之后，这个 0 会被
    // 溢出到帧槽而不是复用 R8，实参不会再被覆盖。
    // 要是哪天有人把 `_opt_alloc` 里那段屏障删了，t186 会立刻退回
    // `send(fd, p, 0, 0)` → 回显空 → net_e2e_test 红。
    _ir_emit(fc, OP_ARG, 0, fd, 0, 0)
    _ir_emit(fc, OP_ARG, 0, ptr, 0, 1)
    _ir_emit(fc, OP_ARG, 0, n, 0, 2)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    _ir_emit(fc, OP_ARG, 0, z, 0, 3)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_CALLIAT, d, 0, 0, I_SEND)
    _net_fail_if_neg1(fc, d, 8)
    return d
}

/// tcp_recv
/// 收一段，返回 [len][bytes][NUL] 的 str；出错 fail-fast，对端关闭返回空串。
///
/// **单独成函数是为了压 `_lower_builtin` 的帧槽**：这些 IR 序列
/// 要几十个临时值，内联会把 `_lower_builtin` 顶过 416 格上限，
/// 自举 stage-2 就编不过自己。与 `_bi_mem_str` 同一个处理方式。
fn _bi_tcp_recv(fc: FnCtx, fd: int, cap: int) -> int {
    // 分配 cap+9：长度头 + 数据 + NUL
    let nine = _vnew(fc)
    fc.vty.set(nine, TY_INT)
    _ir_emit(fc, OP_CONST, nine, 0, 0, 9)
    let sz = _vnew(fc)
    fc.vty.set(sz, TY_INT)
    _ir_emit(fc, OP_ADD, sz, cap, nine, 0)
    _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
    let buf = _vnew(fc)
    fc.vty.set(buf, TY_INT)
    _ir_emit(fc, OP_CALLRT, buf, 0, 0, RT_ALLOC)
    let dp = _vnew(fc)
    fc.vty.set(dp, TY_INT)
    let eight = _vnew(fc)
    fc.vty.set(eight, TY_INT)
    _ir_emit(fc, OP_CONST, eight, 0, 0, 8)
    _ir_emit(fc, OP_ADD, dp, buf, eight, 0)
    _ir_emit(fc, OP_ARG, 0, fd, 0, 0)
    _ir_emit(fc, OP_ARG, 0, dp, 0, 1)
    _ir_emit(fc, OP_ARG, 0, cap, 0, 2)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    _ir_emit(fc, OP_ARG, 0, z, 0, 3)
    let got = _vnew(fc)
    fc.vty.set(got, TY_INT)
    _ir_emit(fc, OP_CALLIAT, got, 0, 0, I_RECV)
    // 失败（SOCKET_ERROR）→ **fail-fast**，与 stage-0 的 __tcp_recv 一致
    // （那边 recv 出错就 net_fail，不静默归零）。
    //
    // 判失败必须先符号扩展：Win64 的 int 返回值只写 eax，-1 落在 rax 里
    // 是 0x00000000FFFFFFFF（= +4294967295）。直接 `cmp rax, -1` 永远不等，
    // 于是错误码被当成"收到 4294967295 字节"，长度头写脏、后面 str 全乱。
    _net_fail_if_neg1(fc, got, 6)
    // 写长度头
    let hp = _vnew(fc)
    fc.vty.set(hp, TY_INT)
    _ir_emit(fc, OP_ADDRF, hp, buf, 0, 0)
    _ir_emit(fc, OP_STORE, 0, hp, got, 8)
    // 末尾 NUL
    let ep = _vnew(fc)
    fc.vty.set(ep, TY_INT)
    _ir_emit(fc, OP_ADD, ep, dp, got, 0)
    _ir_emit(fc, OP_STORE8, 0, ep, z, 0)
    let d = _vnew(fc)
    fc.vty.set(d, TY_STR)
    _ir_emit(fc, OP_MOV, d, dp, 0, 0)
    return d
}

/// Win64 的 int 返回值**只写 eax**（高 32 位 0 扩展），所以
/// `SOCKET_ERROR` 落在 rax 里是 `0x00000000FFFFFFFF` 而不是 64 位 -1。
/// 直接与 -1 比较会漏检（stage-0 的注释里记着这个坑：bind/listen 失败
/// 被放过，accept 才炸）。
///
/// 所以先 `shl 32 / sar 32` 做符号扩展，再与 -1 比较。
fn _net_fail_if_neg1(fc: FnCtx, v: int, code: int) {
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    let sh = _vnew(fc)
    fc.vty.set(sh, TY_INT)
    let n32 = _vnew(fc)
    fc.vty.set(n32, TY_INT)
    _ir_emit(fc, OP_CONST, n32, 0, 0, 32)
    _ir_emit(fc, OP_SHL, sh, v, n32, 0)
    let se = _vnew(fc)
    fc.vty.set(se, TY_INT)
    _ir_emit(fc, OP_SAR, se, sh, n32, 0)
    let m1 = _vnew(fc)
    fc.vty.set(m1, TY_INT)
    _ir_emit(fc, OP_CONST, m1, 0, 0, -1)
    // 不等于 -1 就跳过死路
    _ir_emit(fc, OP_JCMP, 0x85, se, m1, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let cd = _vnew(fc)
    fc.vty.set(cd, TY_INT)
    _ir_emit(fc, OP_CONST, cd, 0, 0, code)
    _ir_emit(fc, OP_EXIT, 0, cd, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

/// 非 0 即失败（WSAStartup 用：它返回错误码而不是 -1）。
fn _net_fail_if_nonzero(fc: FnCtx, v: int, code: int) {
    let lfail = _newlab(fc.labs)
    let lok = _newlab(fc.labs)
    let z = _vnew(fc)
    fc.vty.set(z, TY_INT)
    _ir_emit(fc, OP_CONST, z, 0, 0, 0)
    // 等于 0 就跳过死路
    _ir_emit(fc, OP_JCMP, 0x84, v, z, lok)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
    let cd = _vnew(fc)
    fc.vty.set(cd, TY_INT)
    _ir_emit(fc, OP_CONST, cd, 0, 0, code)
    _ir_emit(fc, OP_EXIT, 0, cd, 0, 0)
    _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
}

fn _lower_method(fc: FnCtx, nd: Node) -> int {
    let h = _lower_expr(fc, nd.a)
    let hty = fc.vty.get(h)
    // int/bool 的 .to_str()（v2.33）：诊断消息里到处用。
    // 走 __i64_fmt（wsprintfA "%I64d"）再包成 str —— 自己写除法循环会在
    // INT64_MIN 上取绝对值溢出（§7.19 的坑），交给 CRT 省心。
    if fc.names.get(nd.b) == "to_f64" {
        if nd.c >= 0 {
            eprint("qlmc: to_f64() 不接受实参")
            exit(2)
        }
        let ad = _to_f64(fc, h)
        return ad
    }
    if fc.names.get(nd.b) == "to_int" {
        if hty == TY_F64 {
            // f64 -> int：向零截断（cvttsd2si），与 stage-0 同口径
            if nd.c >= 0 {
                eprint("qlmc: to_int() 不接受实参")
                exit(2)
            }
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_FTOI, d, h, 0, 0)  // v2.47：内联 cvttsd2si
            return d
        }
        if hty != TY_STR {
            eprint("qlmc: to_int() 只用于 str / f64")
            exit(2)
        }
        if nd.c >= 0 {
            eprint("qlmc: to_int() 不接受实参")
            exit(2)
        }
        _ir_emit(fc, OP_ARG, 0, h, 0, 0)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_STR2INT)
        return d
    }
    if fc.names.get(nd.b) == "to_str" {
        if nd.c >= 0 {
            eprint("qlmc: to_str() 不接受实参")
            exit(2)
        }
        let sz = _vnew(fc)
        fc.vty.set(sz, TY_INT)
        _ir_emit(fc, OP_CONST, sz, 0, 0, 32)
        _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
        let buf = _vnew(fc)
        fc.vty.set(buf, TY_INT)
        _ir_emit(fc, OP_CALLRT, buf, 0, 0, RT_ALLOC)
        _ir_emit(fc, OP_ARG, 0, buf, 0, 0)
        _ir_emit(fc, OP_ARG, 0, h, 0, 1)
        let n = _vnew(fc)
        fc.vty.set(n, TY_INT)
        _ir_emit(fc, OP_CALLRT, n, 0, 0, RT_I64FMT)
        return _bi_mem_str(fc, buf, n)
    }
    if hty >= TY_MAP && hty < TY_ARRAY {
        let hp = _pin(fc, h)      // 句柄要跨循环存活
        let m = fc.names.get(nd.b)
        let vt = (hty - TY_MAP) & 0xFF
        if m == "set" {
            return _map_set(fc, nd, hp)
        }
        if m == "get" {
            return _map_get(fc, nd, vt, hp)
        }
        if m == "has" {
            return _map_has(fc, nd, hp)
        }
        if m == "len" {
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_MOV, d, _vec_field(fc, hp, 8), 0, 0)
            return d
        }
        eprint("qlmc: map 只支持 .set(k,v) / .get(k) / .has(k) / .len()")
        exit(2)
    }
    if hty < TY_VEC || hty >= TY_ARRAY {
        eprint("qlmc: 只有 vec 有 .push/.get/.len 方法")
        exit(2)
    }
    let et = hty - TY_VEC
    let stride = _ty_size(fc, et)
    let eagg = _ty_is_agg(et)
    let m = fc.names.get(nd.b)
    if m == "len" {
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
        return d
    }
    if m == "push" {
        if nd.c < 0 {
            eprint("qlmc: push 需要一个实参")
            exit(2)
        }
        let x = _pin(fc, _lower_expr(fc, nd.c))
        let hp = _pin(fc, h)
        // 常见路径只要"比较一次"：满了才进冷路径（_vec_grow_body 自己重读头字段）
        let len0 = _vec_field(fc, hp, 8)
        let cap0 = _vec_field(fc, hp, 16)
        let lpush = _newlab(fc.labs)
        _ir_emit(fc, OP_JCMP, 0x8C, len0, cap0, lpush)   // jl：还有空间
        _vec_grow_body(fc, hp, stride)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lpush)
        // 扩容会换数据块，所以 len/data 在汇合点之后重新读（顺带保证不跨调用）
        let len = _vec_field(fc, hp, 8)
        let data = _vec_field(fc, hp, 0)
        let addr = _vec_elem_addr(fc, data, len, stride)
        if eagg {
            // 聚合元素：槽里存的是**值**，不是指针 → 整块拷进去
            _ir_emit(fc, OP_COPY, 0, addr, x, stride)
        } else {
            _ir_emit(fc, OP_STORE, 0, addr, x, 8)
        }
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        let nl = _vnew(fc)
        fc.vty.set(nl, TY_INT)
        _ir_emit(fc, OP_ADD, nl, len, one, 0)
        let ah = _vnew(fc)
        fc.vty.set(ah, TY_INT)
        _ir_emit(fc, OP_ADDRF, ah, hp, 0, 8)
        _ir_emit(fc, OP_STORE, 0, ah, nl, 8)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if m == "get" {
        if nd.c < 0 {
            eprint("qlmc: get 需要一个实参")
            exit(2)
        }
        let i = _lower_expr(fc, nd.c)
        _vec_check(fc, h, i)
        let data = _vec_field(fc, h, 0)
        let addr = _vec_elem_addr(fc, data, i, stride)
        let d = _vnew(fc)
        fc.vty.set(d, et)
        if eagg {
            // 聚合值 = 区域地址（与字段/下标读同一约定）。
            // 数据块是 bump 分配的、扩容也不回收旧块，所以这个地址稳定。
            _ir_emit(fc, OP_MOV, d, addr, 0, 0)
        } else {
            _ir_emit(fc, OP_LOAD, d, addr, 0, 8)
        }
        return d
    }
    if m == "clear" {
        // 长度归零，数据块与容量保留（与 stage-0 的 __vec_clear 一致：h[1] = 0）
        let lp = _vnew(fc)
        fc.vty.set(lp, TY_INT)
        _ir_emit(fc, OP_ADDRF, lp, h, 0, 8)
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_STORE, 0, lp, z, 8)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    if m == "pop" {
        // v3.39：vec.pop() -> 末元素（长度减 1）。与 stage-0 的 __vec_pop 一致：
        //   if (len <= 0) fail-fast;
        //   len--; return buf[len];
        // std/ 的 ds / json / path / regex 四个模块都用到它。
        if nd.c >= 0 {
            eprint("qlmc: pop() 不接受实参")
            exit(2)
        }
        let len = _vec_field(fc, h, 8)
        // 空 vec：len <= 0 必须 fail-fast（与 stage-0 一致，不能静默读越界）
        let lfail = _newlab(fc.labs)
        let lok = _newlab(fc.labs)
        let zero = _vnew(fc)
        fc.vty.set(zero, TY_INT)
        _ir_emit(fc, OP_CONST, zero, 0, 0, 0)
        // 条件是 len > 0 才继续；否则走死路
        _ir_emit(fc, OP_JCMP, 0x8F, len, zero, lok)   // jg → 继续
        _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
        let onex = _vnew(fc)
        fc.vty.set(onex, TY_INT)
        _ir_emit(fc, OP_CONST, onex, 0, 0, 1)
        _ir_emit(fc, OP_EXIT, 0, onex, 0, 0)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
        // 新长度 = len - 1
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        let nl = _vnew(fc)
        fc.vty.set(nl, TY_INT)
        _ir_emit(fc, OP_SUB, nl, len, one, 0)
        let lp = _vnew(fc)
        fc.vty.set(lp, TY_INT)
        _ir_emit(fc, OP_ADDRF, lp, h, 0, 8)
        _ir_emit(fc, OP_STORE, 0, lp, nl, 8)
        // 读 buf[len-1]
        let data = _vec_field(fc, h, 0)
        let addr = _vec_elem_addr(fc, data, nl, stride)
        let d = _vnew(fc)
        fc.vty.set(d, et)
        if eagg {
            _ir_emit(fc, OP_MOV, d, addr, 0, 0)
        } else {
            _ir_emit(fc, OP_LOAD, d, addr, 0, 8)
        }
        return d
    }
    if m == "set" {
        if nd.n < 0 {
            eprint("qlmc: set 需要两个实参")
            exit(2)
        }
        let i = _lower_expr(fc, nd.c)
        let x = _lower_expr(fc, nd.n)
        _vec_check(fc, h, i)
        let data = _vec_field(fc, h, 0)
        let addr = _vec_elem_addr(fc, data, i, stride)
        if eagg {
            _ir_emit(fc, OP_COPY, 0, addr, x, stride)
        } else {
            _ir_emit(fc, OP_STORE, 0, addr, x, 8)
        }
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_CONST, d, 0, 0, 0)
        return d
    }
    eprint("qlmc: vec 只支持 .push(x) / .get(i) / .set(i,x) / .len() / .clear() / .pop()")
    exit(2)
    return 0
}




// 运行库（机器码手写）
//
// 约定：入口 rsp ≡ 8 (mod 16)；先 `sub rsp, 0x58`（88 → 8+88 ≡ 0）再调 Win32，
// 这样每次 call 前 rsp 都是 16 对齐的。跨调用要用的值一律落 [rsp+0x20..]。
// ---------------------------------------------------------------------------

/// __print_i64(rax = 值)：wsprintfA("%I64d\n") + WriteFile
fn _gen_print_i64(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PINT, len(code))
    _sub_rsp(code, 0x68)
    _lea_rsp(code, RCX, 0x30)
    let f1 = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, f1, -2, 2)          // id -2 = 格式串
    _mov_rr(code, R8, RAX)
    _b(code, 0x31)                         // xor eax, eax（varargs: AL=0）
    _b(code, 0xC0)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_WSPRINTF, 3)
    _mov_rsp_store(code, 0x28, RAX)        // 长度
    _mov_imm(code, RCX, -11)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _lea_rsp(code, RDX, 0x30)
    _mov_rsp_load(code, R8, 0x28)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __print_str(rcx = str)：写 len 字节 + 一个换行
fn _gen_print_str(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_PSTR, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // 保存 str
    _mov_imm(code, RCX, -11)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rsp_store(code, 0x30, RAX)        // 句柄
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    // 换行
    _mov_rsp_load(code, RCX, 0x30)
    let at = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, at, -3, 2)          // id -3 = 换行字节
    _mov_imm(code, R8, 1)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __die(rcx = 消息 str)：写 stderr（handle -12）后 exit(1)
fn _gen_die(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_DIE, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)
    _mov_imm(code, RCX, -12)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    _mov_imm(code, RCX, 1)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_EXIT, 3)
    _ret(code)
}

/// __memcpy(rdi = dst, rsi = src, rcx = n)
fn _gen_memcpy(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_MEMCPY, len(code))
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x48)                         // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)
    _addfix(ctx.fixes, p0, ldone, 1)
    _setlab(labs, code, ltop)
    // v2.51：源/目的从 rsi/rdi 换成 **r9/r8** —— 因为 rsi/rdi 在 Win64 里是
    // callee-saved，v2.51 起拿它们当第 6/7 个变量寄存器。运行库例程**绝不能**
    // 碰这两个寄存器（除非自己 push/pop）。
    _b(code, 0x41)                         // mov al, [r9]
    _b(code, 0x8A)
    _b(code, 0x01)
    _b(code, 0x41)                         // mov [r8], al
    _b(code, 0x88)
    _b(code, 0x00)
    _b(code, 0x49)                         // inc r9
    _b(code, 0xFF)
    _b(code, 0xC1)
    _b(code, 0x49)                         // inc r8
    _b(code, 0xFF)
    _b(code, 0xC0)
    _b(code, 0x48)                         // dec rcx
    _b(code, 0xFF)
    _b(code, 0xC9)
    let p1 = _jcc(code, 0x85)              // jnz .loop
    _addfix(ctx.fixes, p1, ltop, 1)
    _setlab(labs, code, ldone)
    _ret(code)
}

/// __str_cat(rcx = a, rdx = b) -> rax：新分配 [len][bytes][NUL]
fn _gen_str_cat(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_CAT, len(code))
    // v2.51：rsi/rdi 现在是变量寄存器（callee-saved），本例程内部拿它们当临时
    // 寄存器用，必须自己保存。**两个 push 是 16 字节，`sub rsp,0x68` 之后 rsp
    // 仍 ≡ 0 (mod 16)**，后面调 __alloc/__memcpy 的对齐不受影响。
    _b(code, 0x57)                         // push rdi
    _b(code, 0x56)                         // push rsi
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)        // a
    _mov_rsp_store(code, 0x30, RDX)        // b
    _len_of(code, R8, RCX)                 // la
    _mov_rsp_store(code, 0x38, R8)
    _len_of(code, R9, RDX)                 // lb
    _mov_rsp_store(code, 0x40, R9)
    _mov_rr(code, RCX, R8)                 // n = la + lb + 9
    _alu_rr(code, 0x01, RCX, R9)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC1)
    _b(code, 9)
    _call_rt(ctx, RT_ALLOC)
    _mov_rsp_store(code, 0x48, RAX)        // 块首
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _mov_rr(code, R10, R8)                 // total = la + lb
    _alu_rr(code, 0x01, R10, R9)
    _mov_store(code, RAX, 0, R10)          // [块首] = total
    _lea_rsp(code, RDI, 0x50)              // 复用不了：直接算 data = 块首 + 8
    _mov_rsp_load(code, RDI, 0x48)
    _b(code, 0x48)
    _b(code, 0x83)
    _b(code, 0xC7)
    _b(code, 8)                            // add rdi, 8
    _mov_rsp_store(code, 0x50, RDI)        // data
    // 拷 a
    _mov_rsp_load(code, RSI, 0x28)
    _mov_rsp_load(code, RCX, 0x38)
    _mov_rr(code, R8, RDI)                 // __memcpy 的实参改成 r8/r9
    _mov_rr(code, R9, RSI)
    _call_rt(ctx, RT_MEMCPY)
    // 拷 b：dst = data + la
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _alu_rr(code, 0x01, RDI, R8)
    _mov_rsp_load(code, RSI, 0x30)
    _mov_rsp_load(code, RCX, 0x40)
    _mov_rr(code, R8, RDI)
    _mov_rr(code, R9, RSI)
    _call_rt(ctx, RT_MEMCPY)
    // NUL
    _mov_rsp_load(code, RDI, 0x50)
    _mov_rsp_load(code, R8, 0x38)
    _mov_rsp_load(code, R9, 0x40)
    _alu_rr(code, 0x01, RDI, R8)
    _alu_rr(code, 0x01, RDI, R9)
    _b(code, 0xC6)                         // mov byte [rdi], 0
    _b(code, 0x07)
    _b(code, 0)
    _mov_rsp_load(code, RAX, 0x50)
    _add_rsp(code, 0x68)
    _b(code, 0x5E)                         // pop rsi（后 push 的先 pop）
    _b(code, 0x5F)                         // pop rdi
    _ret(code)
}

/// __str_eq(rcx = a, rdx = b) -> rax (1/0)
fn _gen_str_eq(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_EQ, len(code))
    let ltop = _newlab(labs)
    let lne = _newlab(labs)
    let leq = _newlab(labs)
    _len_of(code, R8, RCX)
    _len_of(code, R9, RDX)
    _alu_rr(code, 0x39, R8, R9)            // cmp r8, r9
    let p0 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p0, lne, 1)
    _setlab(labs, code, ltop)
    _b(code, 0x4D)                         // test r8, r8（REX.W|R|B —— 漏了 REX 就成 test rax）
    _b(code, 0x85)
    _b(code, 0xC0)
    let p1 = _jcc(code, 0x84)              // jz .eq
    _addfix(ctx.fixes, p1, leq, 1)
    _b(code, 0x8A)                         // mov al, [rcx]
    _b(code, 0x01)
    _b(code, 0x3A)                         // cmp al, [rdx]
    _b(code, 0x02)
    let p2 = _jcc(code, 0x85)              // jne .ne
    _addfix(ctx.fixes, p2, lne, 1)
    _b(code, 0x48)                         // inc rcx
    _b(code, 0xFF)
    _b(code, 0xC1)
    _b(code, 0x48)                         // inc rdx
    _b(code, 0xFF)
    _b(code, 0xC2)
    _b(code, 0x49)                         // dec r8
    _b(code, 0xFF)
    _b(code, 0xC8)
    let p3 = _jmp(code)
    _addfix(ctx.fixes, p3, ltop, 1)
    _setlab(labs, code, leq)
    _mov_imm(code, RAX, 1)
    _ret(code)
    _setlab(labs, code, lne)
    _mov_imm(code, RAX, 0)
    _ret(code)
}

/// __alloc(rcx = 字节数) -> rax：bump 分配器（8 字节对齐）
///
/// **堆内存用 VirtualAlloc 拿，不再放在 .bss 里**（v2.76）。同样是 64 MB 的
/// 需求，两种来源的**首次触碰**成本差 5 倍：`.bss`（映像节、pagefile 后备、
/// 写时复制）每页约 5.5 µs，`VirtualAlloc(MEM_COMMIT)` 的私有页每页约 1 µs。
/// 本机实测 16 MB 顺序写：`.bss` 21~29 ms，`VirtualAlloc` 4.0 ms。
/// b4_array 的 push 循环 2 M 次里有 16 ms 花在这上面（23.3 → 7.3 ms）。
/// 副作用：产物不再带 64 MB 的 .bss 节（5.6 KB 的 exe 里 64 MB 是虚的）。
fn _gen_alloc(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_ALLOC, len(code))
    let lhave = _newlab(labs)
    let llock = _newlab(labs)
    let linit = _newlab(labs)
    let loom = _newlab(labs)
    // **自旋锁**（bss 偏移 8）：bump 游标是全局的，而函数体是**多线程并行编译**的，
    // 每个线程开头都要 `_new_fc`（十几个 vec）。不加锁就是"读游标 → 加长度 → 写回"
    // 的丢更新，两个线程拿到同一块内存。v2.34 实测：-j4 编自己时报
    // `未定义变量 pos` / `不支持的表达式节点 60`（两种错随机出现 = 竞态指纹）。
    // xchg 带内存操作数时隐含 lock，够用。
    _setlab(labs, code, llock)
    _b(code, 0x4C)                         // mov r8, 1
    _b(code, 0xC7)
    _b(code, 0xC0)
    _w32(code, 1)
    _b(code, 0x4C)                         // xchg [rip+bss+8], r8
    _b(code, 0x87)
    _b(code, 0x05)
    let f0 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f0, 8, 4)
    _b(code, 0x4D)                         // test r8, r8
    _b(code, 0x85)
    _b(code, 0xC0)
    let pz = _jcc(code, 0x85)              // jnz .lock（没抢到就自旋）
    _addfix(ctx.fixes, pz, llock, 1)
    _b(code, 0x48)                         // mov rax, [rip+bss+0]（游标，0 = 未初始化）
    _b(code, 0x8B)
    _b(code, 0x05)
    let f1 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f1, 0, 4)           // bss 偏移 0 = heap 游标
    _b(code, 0x48)                         // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
    let p0 = _jcc(code, 0x84)              // jz .init（首次分配才去拿堆）
    _addfix(ctx.fixes, p0, linit, 1)
    _setlab(labs, code, lhave)
    _b(code, 0x4C)                         // lea r8, [rax+rcx+7]
    _b(code, 0x8D)
    _b(code, 0x44)
    _b(code, 0x08)
    _b(code, 7)
    _b(code, 0x49)                         // and r8, -8
    _b(code, 0x83)
    _b(code, 0xE0)
    _b(code, 0xF8)
    // 越界 fail-fast：新游标 > 堆上限就退 3，绝不静默写到未映射页。
    // 上限在首次分配时算好存在 bss+24（= 基址 + HEAP_SIZE），这里只比一次。
    let lok = _newlab(labs)
    _b(code, 0x4C)                         // cmp r8, [rip+bss+24]
    _b(code, 0x3B)
    _b(code, 0x05)
    let f4 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f4, 24, 4)
    let p9 = _jcc(code, 0x86)              // jbe .ok
    _addfix(ctx.fixes, p9, lok, 1)
    _setlab(labs, code, loom)
    _b(code, 0xB9)                         // mov ecx, 3
    _w32(code, 3)
    let c9 = _call_rip(code)               // ExitProcess(3)
    _addfix(ctx.fixes, c9, I_EXIT, 3)
    _setlab(labs, code, lok)
    _b(code, 0x4C)                         // mov [rip+HEAP], r8
    _b(code, 0x89)
    _b(code, 0x05)
    let f3 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f3, 0, 4)
    // 释放锁：**必须用 `mov ecx,0; mov [rip+disp], rcx`，不能用 `mov [rip+disp],imm32`**
    // —— RIP 相对位移是相对**整条指令末尾**算的，而后者在 disp32 后面还跟 4 字节
    // imm32，`_addfix` 按 `pos+4` 算就会偏 4 字节（v2.34 踩：释放写到 bss+12，
    // 锁永不释放，第二次分配直接自旋死锁）。
    _b(code, 0xB9)                         // mov ecx, 0
    _w32(code, 0)
    _b(code, 0x48)                         // mov [rip+bss+8], rcx
    _b(code, 0x89)
    _b(code, 0x0D)
    let f5 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f5, 8, 4)
    _ret(code)

    // ---- 冷路径：首次分配才走一次，向内核要 64 MB 私有页 ----
    // 只在 rcx 上做文章是不够的：VirtualAlloc 会破坏 rdx/r9/r10/r11，
    // 而 `__str_cat` 这类手写例程按"__alloc 只破坏 rax/r8/rcx"的约定写。
    // 5 个 push = 40 字节 + 32 字节影子空间 → call 时 rsp ≡ 0 (mod 16)。
    _setlab(labs, code, linit)
    _b(code, 0x51)                         // push rcx（字节数）
    _b(code, 0x52)                         // push rdx
    _b(code, 0x41)
    _b(code, 0x51)                         // push r9
    _b(code, 0x41)
    _b(code, 0x52)                         // push r10
    _b(code, 0x41)
    _b(code, 0x53)                         // push r11
    _sub_rsp(code, 32)
    _b(code, 0x31)                         // xor ecx, ecx（lpAddress = 0）
    _b(code, 0xC9)
    _b(code, 0xBA)                         // mov edx, HEAP_SIZE
    _w32(code, HEAP_SIZE)
    _b(code, 0x41)                         // mov r8d, 0x3000（MEM_COMMIT|MEM_RESERVE）
    _b(code, 0xB8)
    _w32(code, 0x3000)
    _b(code, 0x41)                         // mov r9d, 4（PAGE_READWRITE）
    _b(code, 0xB9)
    _w32(code, 4)
    let c0 = _call_rip(code)               // VirtualAlloc
    _addfix(ctx.fixes, c0, I_VALLOC, 3)
    _b(code, 0x48)                         // add rsp, 32
    _b(code, 0x83)
    _b(code, 0xC4)
    _b(code, 32)
    _b(code, 0x41)                         // pop r11
    _b(code, 0x5B)
    _b(code, 0x41)                         // pop r10
    _b(code, 0x5A)
    _b(code, 0x41)                         // pop r9
    _b(code, 0x59)
    _b(code, 0x5A)                         // pop rdx
    _b(code, 0x59)                         // pop rcx
    _b(code, 0x48)                         // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
    let p8 = _jcc(code, 0x84)              // jz .oom（拿不到堆就退 3）
    _addfix(ctx.fixes, p8, loom, 1)
    _b(code, 0x48)                         // mov [rip+bss+16], rax（堆基址）
    _b(code, 0x89)
    _b(code, 0x05)
    let f6 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f6, 16, 4)
    _b(code, 0x48)                         // mov [rip+bss+0], rax（游标 = 基址）
    _b(code, 0x89)
    _b(code, 0x05)
    let f7 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f7, 0, 4)
    _b(code, 0x4C)                         // lea r8, [rax+HEAP_SIZE]
    _b(code, 0x8D)
    _b(code, 0x80)
    _w32(code, HEAP_SIZE)
    _b(code, 0x4C)                         // mov [rip+bss+24], r8（上限）
    _b(code, 0x89)
    _b(code, 0x05)
    let f8 = len(code)
    _w32(code, 0)
    _addfix(ctx.fixes, f8, 24, 4)
    let p7 = _jmp(code)                    // jmp .have
    _addfix(ctx.fixes, p7, lhave, 1)
}

/// 入口：sub rsp,0x28 -> call main -> ExitProcess(rax)
///
/// v3.37：**lib 模式**（ctx.is_lib）下不发真正的入口，只放一条 `ret`。
/// 为什么仍要放点什么：PE 的 AddressOfEntryPoint 必须指向 .text 内的
/// 合法位置（不能是 0 / 越界），否则某些加载器会拒绝映像。一条 `ret`
/// 既满足这个约束，又保证"即使真被执行也立刻返回"（不会跑飞）。
///
/// 库的真实用途是被别的产物链接 —— qlmc 目前没有链接器，所以 lib 模式的
/// 现实价值是**验证 std/ 的模块能编译**（把"没有 main"这一类阻塞消掉），
/// 为后续的链接支持铺路。
fn _gen_entry(ctx: Ctx) {
    let code: vec[int] = ctx.code
    if ctx.is_lib == 1 {
        _ret(code)                          // 0xC3
        return
    }
    _sub_rsp(code, 0x28)
    let p = _call_rel(code)
    _addfix(ctx.fixes, p, -1, 0)           // id -1 = main
    _mov_rr(code, RCX, RAX)
    let p2 = _call_rip(code)
    _addfix(ctx.fixes, p2, I_EXIT, 3)
}

// ---------------------------------------------------------------------------
// rdata：导入表 + 字符串（每个是 `[len:8][bytes][NUL]`，值 = 数据指针）
// ---------------------------------------------------------------------------

fn _w16(buf: vec[int], v: int) {
    _b(buf, v)
    _b(buf, v >> 8)
}

fn _bytes(buf: vec[int], s: str) {
    let mut i = 0
    while i < len(s) {
        _b(buf, s[i])
        i = i + 1
    }
}

fn _zero(buf: vec[int], n: int) {
    let mut i = 0
    while i < n {
        _b(buf, 0)
        i = i + 1
    }
}

fn _pad_to(buf: vec[int], n: int) {
    while len(buf) < n {
        _b(buf, 0)
    }
}

/// v3.42：登记 ws2_32 的 8 个导入符号（DLL 索引 3）。
///
/// **顺序必须与 `I_WSASTART..I_CLOSESOCK` 一致** —— `build_rdata` 末尾按
/// `I_WSASTART + wi` 算 IAT 槽位，错一个就是调错 API（表现为 0xC0000005）。
///
/// 单独成函数是为了压 `build_rdata` 的局部变量表：那边已经贴着 416 格上限，
/// 8 个 `let`/`push` 摊开写会把自举 stage-2 顶爆。函数调用不占调用方的槽。
fn _reg_ws2(dsym: vec[str], ddll: vec[int]) {
    dsym.push("WSAStartup")
    ddll.push(3)
    dsym.push("socket")
    ddll.push(3)
    dsym.push("bind")
    ddll.push(3)
    dsym.push("listen")
    ddll.push(3)
    dsym.push("accept")
    ddll.push(3)
    dsym.push("send")
    ddll.push(3)
    dsym.push("recv")
    ddll.push(3)
    dsym.push("closesocket")
    ddll.push(3)
}

fn build_rdata(ctx: Ctx, rdata_rva: int, iat: vec[int]) {
    let rd: vec[int] = ctx.rdata

    // ---- 汇总导入：内置 4 个 + 用户 @ffi（DLL 按首次出现排序）----
    let dnames = vec[str].new(4)
    dnames.push("kernel32.dll")
    dnames.push("user32.dll")
    dnames.push("msvcrt.dll")
    dnames.push("ws2_32.dll")   // v3.42：索引 3，网络内建用
    let dsym = vec[str].new(24)
    let ddll = vec[int].new(24)
    dsym.push("GetStdHandle")
    ddll.push(0)
    dsym.push("WriteFile")
    ddll.push(0)
    dsym.push("ExitProcess")
    ddll.push(0)
    // v2.32：线程三件套（spawn / join）
    dsym.push("CreateThread")
    ddll.push(0)
    dsym.push("WaitForSingleObject")
    ddll.push(0)
    dsym.push("CloseHandle")
    ddll.push(0)
    // v2.33：file_exists / now_ns
    dsym.push("GetFileAttributesA")
    ddll.push(0)
    dsym.push("QueryPerformanceCounter")
    ddll.push(0)
    dsym.push("QueryPerformanceFrequency")
    ddll.push(0)
    // v2.76：堆内存来源（私有页，首次触碰比 .bss 快 5 倍）
    dsym.push("VirtualAlloc")
    ddll.push(0)
    // v2.38：f64 字面量解析
    dsym.push("strtod")
    ddll.push(2)
    dsym.push("wsprintfA")
    ddll.push(1)
    // v3.42：ws2_32 的 8 个符号（DLL 索引 3）。
    //
    // **搬到独立函数 `_reg_ws2` 里**，不在这儿摊开写：`build_rdata` 的局部
    // 变量表已经到 416 格上限，每多一个 `let` 就多占一格 —— 8 个符号摊开
    // 写正好把自举 stage-2 顶爆（"需要 425 个槽"）。函数调用不占调用方的槽。
    _reg_ws2(dsym, ddll)
    let mut k = 0
    while k < len(ctx.fsym) {
        let dn = ctx.fdll.get(k)
        let mut di = -1
        let mut t = 0
        while t < len(dnames) {
            if dnames.get(t) == dn {
                di = t
            }
            t = t + 1
        }
        if di < 0 {
            dnames.push(dn)
            di = len(dnames) - 1
        }
        dsym.push(ctx.fsym.get(k))
        ddll.push(di)
        k = k + 1
    }
    let ndll = len(dnames)
    let nsym = len(dsym)

    // ---- 布局（先算偏移，再写字节）----
    let mut p = _align_up((ndll + 1) * 20, 8)
    let ilt = vec[int].new(8)
    let iatb = vec[int].new(8)
    let mut d = 0
    while d < ndll {
        let mut n = 0
        let mut s = 0
        while s < nsym {
            if ddll.get(s) == d {
                n = n + 1
            }
            s = s + 1
        }
        ilt.push(p)
        p = p + (n + 1) * 8
        iatb.push(p)
        p = p + (n + 1) * 8
        d = d + 1
    }
    let hn = vec[int].new(8)
    let mut s2 = 0
    while s2 < nsym {
        hn.push(p)
        p = p + 2 + len(dsym.get(s2)) + 1
        if p % 2 != 0 {
            p = p + 1
        }
        s2 = s2 + 1
    }
    let dn = vec[int].new(4)
    d = 0
    while d < ndll {
        dn.push(p)
        p = p + len(dnames.get(d)) + 1
        if p % 2 != 0 {
            p = p + 1
        }
        d = d + 1
    }

    // ---- 描述符（每 DLL 20 字节 + 一个全零结尾）----
    d = 0
    while d < ndll {
        _w32(rd, rdata_rva + ilt.get(d))
        _w32(rd, 0)
        _w32(rd, 0)
        _w32(rd, rdata_rva + dn.get(d))
        _w32(rd, rdata_rva + iatb.get(d))
        d = d + 1
    }
    _zero(rd, 20)

    // ---- 每 DLL 一组 ILT + IAT ----
    d = 0
    while d < ndll {
        _pad_to(rd, ilt.get(d))
        let mut s3 = 0
        while s3 < nsym {
            if ddll.get(s3) == d {
                _w64(rd, rdata_rva + hn.get(s3))
            }
            s3 = s3 + 1
        }
        _w64(rd, 0)
        _pad_to(rd, iatb.get(d))
        s3 = 0
        while s3 < nsym {
            if ddll.get(s3) == d {
                _w64(rd, rdata_rva + hn.get(s3))
            }
            s3 = s3 + 1
        }
        _w64(rd, 0)
        d = d + 1
    }

    // ---- hint/name 与 DLL 名 ----
    s2 = 0
    while s2 < nsym {
        _pad_to(rd, hn.get(s2))
        _w16(rd, 0)
        _bytes(rd, dsym.get(s2))
        _b(rd, 0)
        s2 = s2 + 1
    }
    d = 0
    while d < ndll {
        _pad_to(rd, dn.get(d))
        _bytes(rd, dnames.get(d))
        _b(rd, 0)
        d = d + 1
    }

    // ---- 记 IAT 槽位：内置 4 个 + 用户符号 ----
    iat.set(I_GETSTD, rdata_rva + iatb.get(0))
    iat.set(I_WRITE, rdata_rva + iatb.get(0) + 8)
    iat.set(I_EXIT, rdata_rva + iatb.get(0) + 16)
    iat.set(I_CREATE, rdata_rva + iatb.get(0) + 24)
    iat.set(I_WAIT, rdata_rva + iatb.get(0) + 32)
    iat.set(I_CLOSE, rdata_rva + iatb.get(0) + 40)
    iat.set(I_FILEATTR, rdata_rva + iatb.get(0) + 48)
    iat.set(I_QPC, rdata_rva + iatb.get(0) + 56)
    iat.set(I_QPF, rdata_rva + iatb.get(0) + 64)
    iat.set(I_VALLOC, rdata_rva + iatb.get(0) + 72)
    iat.set(I_STRTOD, rdata_rva + iatb.get(2))
    iat.set(I_WSPRINTF, rdata_rva + iatb.get(1))
    // v3.42：ws2_32 的 8 个槽位（DLL 索引 3，组内顺序与上面 dsym.push 一致）。
    // **漏了这 8 行 = 槽位留 0 = CALLIAT 跳到地址 0**，表现是进程直接
    // 0xC0000005 崩掉、连第一条 print 之后都活不过去（tcp_listen 踩过）。
    //
    // 写成循环而不是 8 条 `iat.set(I_XXX, rdata_rva + iatb.get(3) + N)`：
    // `build_rdata` 的帧槽**正好卡在 416 格上限**，摊开写会多要一格，
    // 自举 stage-2 立刻编不过自己（v3.42 实测）。循环只多两个变量。
    let mut wi = 0
    while wi < 8 {
        iat.set(I_WSASTART + wi, rdata_rva + iatb.get(3) + wi * 8)
        wi = wi + 1
    }
    k = 0
    while k < len(ctx.fsym) {
        let g = I_USER + k
        let di = ddll.get(g)
        let mut idx = 0
        let mut t2 = 0
        while t2 < g {
            if ddll.get(t2) == di {
                idx = idx + 1
            }
            t2 = t2 + 1
        }
        iat.set(g, rdata_rva + iatb.get(di) + idx * 8)
        k = k + 1
    }

    // ---- 字符串表：每个 `[len:8][bytes][NUL]`，strpos = 数据指针的偏移 ----
    let mut i = 0
    while i < len(ctx.strs) {
        _pad_to(rd, _align_up(len(rd), 8))
        let st = ctx.strs[i]
        _w64(rd, len(st))
        ctx.strpos.set(i, len(rd))
        _bytes(rd, st)
        _b(rd, 0)
        i = i + 1
    }
    // 换行字节（print 的语义是"输出 + 换行"，str 通道要单独写一个字节）
    ctx.nl.set(0, len(rd))
    _b(rd, 10)
    // 不带换行的整数格式串（v2.33：int.to_str 用）。偏移存 nl[1]，
    // 用 FK_STR 的 -4 哨兵引用——这样不用给 Ctx 加字段。
    _pad_to(rd, _align_up(len(rd), 2))
    ctx.nl.push(len(rd))
    _bytes(rd, "%I64d")
    _b(rd, 0)
    // 格式串（普通 C 字符串，给 wsprintfA）
    _pad_to(rd, _align_up(len(rd), 2))
    ctx.strpos.set(len(ctx.strpos) - 1, len(rd))
    _bytes(rd, "%I64d\n")
    _b(rd, 0)
}
// ---------------------------------------------------------------------------
// 回填（v2.16）
//
// 顺序段（入口 + 运行库）的 fixup 位置是 `.text` 绝对偏移；函数段的 fixup 位置
// 是**函数内相对偏移**，回填时加上函数基址。两类共用一个 `_target_of`，
// 只有标签的解析不同（顺序段用 ctx.labs，函数段用该函数自己的标签表）。
// ---------------------------------------------------------------------------

fn _fn_index_ctx(ctx: Ctx, nid: int) -> int {
    let mut i = 0
    while i < len(ctx.fns) {
        if ctx.fns.get(i).name == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _target_of(ctx: Ctx, id: int, kind: int, rdata_rva: int, bss_rva: int,
              iat: vec[int]) -> int {
    if kind == FK_FN {
        if id == -1 {
            // v3.37：lib 模式不发入口（_gen_entry 已提前 return），
            // 所以这里不该被问到 -1。真问到了说明有别的路径依赖 main，
            // 给一个明确的诊断而不是去查 main 然后报"没有 main"。
            if ctx.is_lib == 1 {
                eprint("qlmc: lib 模式下仍有代码引用入口点（内部错误）")
                exit(2)
            }
            let mi = _name_id_ro(ctx, "main")
            if mi < 0 {
                eprint("qlmc: 没有 main（编库请加 -lib）")
                exit(2)
            }
            let fi = _fn_index_ctx(ctx, mi)
            if fi < 0 {
                eprint("qlmc: 没有 main（编库请加 -lib）")
                exit(2)
            }
            return ctx.fnpos.get(fi)
        }
        return ctx.fnpos.get(id)
    }
    if kind == FK_LAB {
        return ctx.labs.get(id)
    }
    if kind == FK_STR {
        if id == -2 {
            return rdata_rva + ctx.strpos.get(len(ctx.strpos) - 1) - TEXT_RVA
        }
        if id == -3 {
            return rdata_rva + ctx.nl.get(0) - TEXT_RVA
        }
        if id == -4 {
            return rdata_rva + ctx.nl.get(1) - TEXT_RVA   // "%I64d"（无换行）
        }
        return rdata_rva + ctx.strpos.get(id) - TEXT_RVA
    }
    if kind == FK_IAT {
        return iat.get(id) - TEXT_RVA
    }
    if kind == FK_BSS {
        return bss_rva + id - TEXT_RVA
    }
    return ctx.rt_pos.get(id)
}

fn resolve_seq(ctx: Ctx, rdata_rva: int, bss_rva: int, iat: vec[int]) {
    let mut i = 0
    while i < len(ctx.fixes) {
        let fx = ctx.fixes.get(i)
        let target = _target_of(ctx, fx.id, fx.kind, rdata_rva, bss_rva, iat)
        _patch32(ctx.code, fx.pos, target - (fx.pos + 4))
        i = i + 1
    }
}

fn resolve_fn(ctx: Ctx, arb: int, fi: int, base: int, rdata_rva: int,
              bss_rva: int, iat: vec[int]) {
    let h = HDR_BASE + fi * FN_HDR
    let rbase = mem_load64(arb, h + 6)
    let loff = mem_load64(arb, h + 2)
    let lcnt = mem_load64(arb, h + 3)
    let foff = mem_load64(arb, h + 4)
    let fcnt = mem_load64(arb, h + 5)
    let mut k = 0
    while k < fcnt {
        let p = mem_load64(rbase, foff / 8 + k * 3)
        let id = mem_load64(rbase, foff / 8 + k * 3 + 1)
        let kind = mem_load64(rbase, foff / 8 + k * 3 + 2)
        let mut target = 0
        if kind == FK_LAB {
            if id < 0 || id >= lcnt {
                eprint("qlmc: 内部错误：标签越界 " + id.to_str())
                exit(2)
            }
            target = base + mem_load64(rbase, loff / 8 + id)
        } else {
            target = _target_of(ctx, id, kind, rdata_rva, bss_rva, iat)
        }
        let pos = base + p
        _patch32(ctx.code, pos, target - (pos + 4))
        k = k + 1
    }
}
// ---------------------------------------------------------------------------
// PE32+ 写出（三节：.text / .rdata / .bss）
// ---------------------------------------------------------------------------


fn build_pe(code: vec[int], rdata: vec[int], blob: vec[int]) -> int {
    let text_len = len(code)
    let rdata_len = len(rdata)
    let rdata_rva = TEXT_RVA + _align_up(text_len, SECT_ALIGN)
    let bss_rva = rdata_rva + _align_up(rdata_len, SECT_ALIGN)
    let nsec = 3
    let headers = _align_up(HDR_DOS + 4 + 20 + OPT_SIZE + 40 * nsec, FILE_ALIGN)
    let text_raw_size = _align_up(text_len, FILE_ALIGN)
    let rdata_raw = headers + text_raw_size
    let rdata_raw_size = _align_up(rdata_len, FILE_ALIGN)
    let image = _align_up(bss_rva + BSS_SIZE, SECT_ALIGN)
    _b(blob, 77)
    _b(blob, 90)
    _zero(blob, 58)
    _w32(blob, HDR_DOS)
    _pad_to(blob, HDR_DOS)
    _b(blob, 80)
    _b(blob, 69)
    _b(blob, 0)
    _b(blob, 0)
    _w16(blob, 0x8664)
    _w16(blob, nsec)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, OPT_SIZE)
    _w16(blob, 0x0022)
    let opt_at = len(blob)
    _w16(blob, 0x20B)
    _b(blob, 14)
    _b(blob, 0)
    _w32(blob, text_raw_size)
    _w32(blob, rdata_raw_size)
    _w32(blob, BSS_SIZE)                // SizeOfUninitializedData
    _w32(blob, TEXT_RVA)
    _w32(blob, TEXT_RVA)
    _w64(blob, IMAGE_BASE)
    _w32(blob, SECT_ALIGN)
    _w32(blob, FILE_ALIGN)
    // OS 版本 6.0 / 映像版本 0.0 / 子系统版本 6.0 —— 六个 u16 一个都不能少
    _w16(blob, 6)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w16(blob, 6)
    _w16(blob, 0)
    _w32(blob, 0)
    _w32(blob, image)
    _w32(blob, headers)
    _w32(blob, 0)
    _w16(blob, 3)
    _w16(blob, 0x0100)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w64(blob, 0x100000)
    _w64(blob, 0x1000)
    _w32(blob, 0)
    _w32(blob, 16)
    _w32(blob, 0)
    _w32(blob, 0)
    _w32(blob, rdata_rva)
    _w32(blob, 60)
    let mut k = 2
    while k < 16 {
        _w32(blob, 0)
        _w32(blob, 0)
        k = k + 1
    }
    _pad_to(blob, opt_at + OPT_SIZE)
    _bytes(blob, ".text")
    _zero(blob, 3)
    _w32(blob, text_len)
    _w32(blob, TEXT_RVA)
    _w32(blob, text_raw_size)
    _w32(blob, headers)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_CODE)
    _bytes(blob, ".rdata")
    _zero(blob, 2)
    _w32(blob, rdata_len)
    _w32(blob, rdata_rva)
    _w32(blob, rdata_raw_size)
    _w32(blob, rdata_raw)
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, SCN_RDATA)
    _bytes(blob, ".bss")
    _zero(blob, 4)
    _w32(blob, BSS_SIZE)                // VirtualSize
    _w32(blob, bss_rva)
    _w32(blob, 0)                       // SizeOfRawData = 0：不占文件
    _w32(blob, 0)                       // PointerToRawData = 0
    _w32(blob, 0)
    _w32(blob, 0)
    _w16(blob, 0)
    _w16(blob, 0)
    _w32(blob, 0xC0000080)              // RW, 未初始化数据
    _pad_to(blob, headers)
    let mut i = 0
    while i < text_len {
        _b(blob, code[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw)
    i = 0
    while i < rdata_len {
        _b(blob, rdata[i])
        i = i + 1
    }
    _pad_to(blob, rdata_raw + rdata_raw_size)
    return bss_rva
}

/// read_text(path) -> str：整文件读成串。
/// 做成源码函数而不是内建：qlmc 已经声明了 CreateFileA/ReadFile 的 @ffi，
/// 十几行 Quelmara 就够；做成内建要另写机器码，没必要。
/// 名字带下划线是为了**不撞 stage-0 的同名内建**（那边有 read_text 内建，
/// 用户定义虽然优先，但同名容易让人误读）。
fn _read_text(path: str) -> str {
    let h = _CreateFileA(cstr(path), GEN_READ, 1, 0, OPEN_EXISTING, ATTR_NORMAL, 0)
    if h == -1 {
        eprint("qlmc: 打不开源文件 " + path)
        exit(2)
    }
    let sz = _GetFileSize(h, 0)
    let buf = mem_alloc(sz + 1)
    let got = mem_alloc(8)
    if !_ReadFile(h, buf, sz, got, 0) {
        eprint("qlmc: 读文件失败 " + path)
        exit(2)
    }
    _CloseHandle(h)
    mem_store8(buf, sz, 0)
    return mem_str(buf, sz)
}

fn write_file(path: str, buf: vec[int]) -> int {
    let h = _CreateFileA(cstr(path), GEN_WRITE, 0, 0, CREATE_ALWAYS,
                         ATTR_NORMAL, 0)
    if h == -1 {
        eprint("qlmc: 打不开输出文件 " + path)
        exit(2)
    }
    let n = len(buf)
    let p = mem_alloc(n + 8)
    let mut i = 0
    while i < n {
        mem_store8(p, i, buf[i])
        i = i + 1
    }
    let got = mem_alloc(8)
    if !_WriteFile(h, p, n, got, 0) {
        eprint("qlmc: 写文件失败 " + path)
        exit(2)
    }
    _CloseHandle(h)
    return 0
}

// ---------------------------------------------------------------------------
// 主流程
// ---------------------------------------------------------------------------

/// 取路径的目录部分（含结尾分隔符）
/// 去掉路径末尾一级（`a/b/` → `a/`）；没有上一级时返回空串
fn _dir_up(d: str) -> str {
    let n = len(d)
    if n == 0 {
        return ""
    }
    let mut i = n - 1
    // 先跳过末尾的分隔符
    while i >= 0 {
        let c = d[i]
        if c == 47 || c == 92 {
            i = i - 1
        } else {
            break
        }
    }
    // 再退到上一个分隔符
    while i >= 0 {
        let c = d[i]
        if c == 47 || c == 92 {
            return substr(d, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

/// 找模块文件：从源文件目录**逐级向上**试 `<d>/<mod>.qma`（v2.33）。
/// 为什么向上：stage-0 的 import 解析除了源目录，还会去**仓库根**的 `std/` 找
/// （`_import_candidates` 把 `std.*` 剥掉首段映射到 `<repo>/std/`）。qlmc 只看
/// 源文件同目录，于是编自己的源码时 `import std.core` 直接找不到——而 `std/`
/// 恰好在仓库根（不在 `src/lib`，Quelmara.toml 里连 `[src]` 段都没有）。
/// 逐级向上找 `<d>/std/core.qma` 正好命中，且不需要读配置文件。
fn _find_module(dir: str, mod: str) -> str {
    let rel = mod + ".qma"
    let mut d = dir
    let mut guard = 0
    while guard < 32 {
        let cand = d + rel
        if file_exists(cand) {
            return cand
        }
        // 空目录也要试一次（`std/core.qma` 相对 cwd —— 源码用相对路径传进来时
        // 就靠这一下命中仓库根），试完再收工
        if len(d) == 0 {
            return ""
        }
        d = _dir_up(d)
        guard = guard + 1
    }
    return ""
}

fn _dir_of(path: str) -> str {
    let mut i = len(path) - 1
    while i >= 0 {
        let c = path[i]
        if c == 47 || c == 92 {
            return substr(path, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

fn _usage() {
    eprint("用法: qlmc build <src.qma> [-o out.exe] [-j N] | qlmc dump <src.qma> | qlmc version")
}

/// 线程数：函数太少时并行只付线程创建成本。`want` = 0 表示自动。
///
/// 这里**不读 Quelmara.toml**（qlmc 没有配置解析器，`net_config` 是 stage-0 的
/// 编译期内建）。用固定的 4 条上限，`-j N` 仍然能覆盖。差异只出现在
/// "没显式给 -j 且配置里改了 io_threads" 这一种情况，而**线程数不影响产物字节**
/// （`-j1 == -jN` 由 tests/qlmc_test.py 钉住），所以只影响构建耗时、不影响正确性。
fn _pick_threads(nfunc: int, want: int) -> int {
    let mut cores = 4
    if cores < 1 {
        cores = 1
    }
    if cores > MAX_THREADS {
        cores = MAX_THREADS
    }
    let mut nt = cores
    if want > 0 {
        nt = want
    } else if nfunc < 16 {
        nt = 1
    } else {
        // 自动：每线程约 50 个函数才值得开线程。实测 200 函数时 j1=2.67 ms、
        // j4=1.63 ms、j8=1.97 ms（线程创建 ~200 us/个，超过物理并行度反而更慢），
        // 所以按工作量给，不无脑开满。
        nt = nfunc / 50
        if nt > cores {
            nt = cores
        }
        if nt < 1 {
            nt = 1
        }
    }
    if nt > nfunc {
        nt = nfunc
    }
    if nt < 1 {
        nt = 1
    }
    return nt
}

@ffi("kernel32.dll", "GetCommandLineA")
fn _cmdline() -> int

fn _is_blank(c: int) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    return false
}

/// C 串长度（GetCommandLineA 的返回值没有长度前缀）
fn _strlen_c(p: int) -> int {
    let mut i = 0
    while mem_load8(p, i) != 0 {
        i = i + 1
    }
    return i
}

/// args() -> vec[str]：把命令行切成参数表，**跳过 argv[0]**（程序名）。
/// 规则：空格/Tab 分隔；双引号内的空白不分隔，引号本身不保留。
///
/// 为什么写在源码里而不是做成内建：需要按字符扫描 + 建 vec[str]，用 Quelmara
/// 写三十行就够，用机器码写要上百条指令，还得自己调 __alloc/__vec_push。
/// 这正是"自举目标要落在自己支持的子集里"该有的样子。
fn _args() -> vec[str] {
    let p = _cmdline()
    let n = _strlen_c(p)
    let out = vec[str].new(8)
    let buf = mem_alloc(n + 1)
    let mut i = 0
    // 跳过 argv[0]：走到第一个空白
    while i < n {
        if _is_blank(mem_load8(p, i)) {
            break
        }
        i = i + 1
    }
    while i < n {
        // 跳过分隔符
        while i < n {
            if !_is_blank(mem_load8(p, i)) {
                break
            }
            i = i + 1
        }
        if i >= n {
            break
        }
        // 收一个参数（引号内的空白不算分隔，引号本身丢掉）
        let mut blen = 0
        let mut q = 0
        while i < n {
            let c = mem_load8(p, i)
            if c == 34 {
                q = 1 - q
                i = i + 1
                continue
            }
            if q == 0 && _is_blank(c) {
                break
            }
            mem_store8(buf, blen, c)
            blen = blen + 1
            i = i + 1
        }
        out.push(mem_str(buf, blen))
    }
    return out
}

fn main() {
    let t0 = now_ns()
    let a = _args()
    if len(a) < 1 {
        _usage()
        exit(2)
    }
    if a[0] == "version" {
        print("qlmc 0.5（Quelmara 写的 stage-1 编译器，子集 S20：int/bool/str/f64 + struct/数组/enum/vec（可扩容、元素可为聚合）/map/切片 + 位运算/移位 + 进制字面量 + const 常量表达式 + else if + spawn/join + 内存/串/诊断内建 + str 下标 + defer + import + @ffi + 闭包 + 聚合形参返回 + 形参实参不限个数 + for；IR + 线性扫描 + 并行）")
        return
    }
    if len(a) < 2 {
        _usage()
        exit(2)
    }
    let cmd = a[0]
    let src = a[1]
    let mut out = "build/qlmc_out.exe"
    let mut want = 0
    // v3.37：-lib —— 编库（不要求 main、不发入口）。
    // std/ 有 30 个模块只是"没有 main"，加上这个模式它们立刻从
    // "失败"变成"能编"。产物仍是 PE，只是 AddressOfEntryPoint 指向
    // 一段 ret 桩（Windows 不会执行它，因为它是 DLL/被链接用）。
    let mut is_lib = 0
    let mut i = 2
    while i < len(a) {
        if a[i] == "-o" && i + 1 < len(a) {
            out = a[i + 1]
        }
        if a[i] == "-j" && i + 1 < len(a) {
            want = a[i + 1].to_int()
        }
        if a[i] == "-lib" {
            is_lib = 1
        }
        i = i + 1
    }
    if !file_exists(src) {
        eprint("qlmc: 找不到 " + src)
        exit(2)
    }
    let text = _read_text(src)

    let toks = vec[Tok].new(256)
    lex(text, toks)
    let nodes = vec[Node].new(256)
    let names = vec[str].new(32)
    let strs = vec[str].new(16)
    let fns = vec[Fn].new(8)
    let cname = vec[int].new(8)
    let cval = vec[int].new(8)
    let stt = vec[int].new(TBL_SIZE)
    let mut ti = 0
    while ti < TBL_SIZE {
        stt.push(0)
        ti = ti + 1
    }
    let imports = vec[str].new(4)
    let fdll = vec[str].new(4)
    let fsym = vec[str].new(4)
    parse(toks, nodes, names, strs, fns, cname, cval, stt, imports, fdll, fsym)

    // 装载 import 的模块：同一个模块只装一次，装的过程中可能又收集到新的 import
    let loaded = vec[str].new(4)
    let dir = _dir_of(src)
    let mut ii = 0
    while ii < len(imports) {
        let mod = imports.get(ii)
        let mut seen = 0
        let mut kk = 0
        while kk < len(loaded) {
            if loaded.get(kk) == mod {
                seen = 1
            }
            kk = kk + 1
        }
        if seen == 0 {
            loaded.push(mod)
            let mpath = _find_module(dir, mod)
            if len(mpath) == 0 {
                eprint("qlmc: 找不到模块 " + dir + mod + ".qma")
                exit(2)
            }
            let mt = _read_text(mpath)
            let mtk = vec[Tok].new(256)
            lex(mt, mtk)
            parse(mtk, nodes, names, strs, fns, cname, cval, stt, imports, fdll, fsym)
        }
        ii = ii + 1
    }

    if cmd == "dump" {
        print("tokens   : " + len(toks).to_str())
        print("nodes    : " + len(nodes).to_str())
        print("fns      : " + len(fns).to_str())
        print("names    : " + len(names).to_str())
        print("strs     : " + len(strs).to_str())
        print("structs  : " + stt.get(0).to_str())
        print("enums    : " + stt.get(EN_HDR).to_str())
        return
    }
    if len(fns) < 1 {
        eprint("qlmc: 源文件里没有函数")
        exit(2)
    }

    // true/false 先占位（bool 打印通道要用）
    strs.push("true")
    let s_true = len(strs) - 1
    strs.push("false")
    let s_false = len(strs) - 1

    let code = vec[int].new(4096)
    let labs = vec[int].new(64)
    let fixes = vec[Fix].new(64)
    let rdata = vec[int].new(2048)
    let strpos = vec[int].new(len(strs) + 1)
    let mut si = 0
    while si < len(strs) + 1 {
        strpos.push(-1)
        si = si + 1
    }
    // IAT 槽表：内置 I_USER 个 + 用户 @ffi 符号。**用 I_USER 推，别再写死 4**——
    // 加内置符号时忘了改这里，表现是编译期 "vec index out of bounds"。
    //
    // v3.42：初值容量写 0（不是 I_USER）。`build_rdata` 已经贴着 416 格的
    // 帧上限，`vec[int].new(I_USER)` 在 I_USER 从 12 涨到 20 之后多要了一格，
    // 直接把自举 stage-2 顶爆。容量只是预分配提示，push 会自己长。
    let iat = vec[int].new(0)
    si = 0
    while si < I_USER + len(fsym) {
        iat.push(0)
        si = si + 1
    }
    let nl = vec[int].new(1)
    nl.push(0)
    // 运行库例程位置表：RT_PINT..RT_COUNT-1（加例程时改 RT_COUNT 即可）
    let rt_pos = vec[int].new(RT_COUNT)
    si = 0
    while si < RT_COUNT {
        rt_pos.push(0)
        si = si + 1
    }
    let nfunc = len(fns)
    let fnpos = vec[int].new(nfunc)
    si = 0
    while si < nfunc {
        fnpos.push(0)
        si = si + 1
    }

    let ctx = Ctx { code: code, labs: labs, fixes: fixes, nodes: nodes,
                    names: names, strs: strs, fns: fns, fnpos: fnpos,
                    rdata: rdata, strpos: strpos, str_true: s_true, str_false: s_false,
                    nl: nl, rt_pos: rt_pos, fdll: fdll, fsym: fsym,
                    is_lib: is_lib }

    // **入口必须落在 .text 偏移 0**（AddressOfEntryPoint 恒等于 TEXT_RVA）
    _gen_entry(ctx)
    _gen_print_i64(ctx)
    _gen_print_str(ctx)
    _gen_print_bool(ctx)
    _gen_memcpy(ctx)
    _gen_alloc(ctx)
    _gen_str_cat(ctx)
    _gen_str_eq(ctx)
    _gen_die(ctx)
    _gen_zero(ctx)
    _gen_join(ctx)
    _gen_spawn(ctx)
    _gen_eprint_str(ctx)
    _gen_memchr(ctx)
_gen_memdiff(ctx)
_gen_memxchg(ctx)
_gen_memcmp(ctx)
    _gen_i64_fmt(ctx)
    _gen_str_to_int(ctx)
    _gen_fparse(ctx)
    _gen_fop(ctx, RT_FADD, 0x58)     // addsd
    _gen_fop(ctx, RT_FSUB, 0x5C)     // subsd
    _gen_fop(ctx, RT_FMUL, 0x59)     // mulsd
    _gen_fop(ctx, RT_FDIV, 0x5E)     // divsd
    _gen_itof(ctx)
    _gen_ftoi(ctx)
    _gen_fneg(ctx)
    _gen_f64_fmt(ctx)
    let rt_end = now_ns()

    // ---- 并行编译函数体 -------------------------------------------------
    let nt = _pick_threads(nfunc, want)
    let hdrbytes = (HDR_BASE + nfunc * FN_HDR) * 8
    let arb = mem_alloc(ARENA_CAP)
    let per = (ARENA_CAP - hdrbytes) / nt
    let mut w = 0
    while w < nt {
        let lo = w * nfunc / nt
        let hi = (w + 1) * nfunc / nt
        mem_store64(arb, w * 8, lo)
        mem_store64(arb, w * 8 + 1, hi)
        mem_store64(arb, w * 8 + 2, arb + hdrbytes + w * per)
        mem_store64(arb, w * 8 + 3, per)
        w = w + 1
    }
    if nt == 1 {
        _compile_range(arb, 0, nodes, names, strs, fns, rt_pos, stt)
    } else {
        let hs = vec[int].new(nt)
        w = 0
        while w < nt {
            hs.push(spawn _compile_range(arb, w, nodes, names, strs, fns, rt_pos, stt))
            w = w + 1
        }
        w = 0
        while w < nt {
            join(hs.get(w))
            w = w + 1
        }
    }
    let fn_end = now_ns()

    // ---- 拼装（顺序固定 → 线程数不影响产物） ---------------------------
    // 函数体接在「入口 + 运行库」之后，所以起始偏移是当前 .text 长度
    let mut off = len(code)
    let mut fi = 0
    while fi < nfunc {
        fnpos.set(fi, off)
        let h = HDR_BASE + fi * FN_HDR
        let rbase = mem_load64(arb, h + 6)
        let coff = mem_load64(arb, h)
        let clen = mem_load64(arb, h + 1)
        let mut k = 0
        while k < clen {
            code.push(mem_load8(rbase, coff + k))
            k = k + 1
        }
        off = off + clen
        fi = fi + 1
    }

    let rdata_rva = TEXT_RVA + _align_up(len(code), SECT_ALIGN)
    build_rdata(ctx, rdata_rva, iat)
    let real_bss = rdata_rva + _align_up(len(rdata), SECT_ALIGN)
    resolve_seq(ctx, rdata_rva, real_bss, iat)
    fi = 0
    while fi < nfunc {
        resolve_fn(ctx, arb, fi, fnpos.get(fi), rdata_rva, real_bss, iat)
        fi = fi + 1
    }

    let blob = vec[int].new(8192)
    let pe_bss = build_pe(code, rdata, blob)
    if pe_bss != real_bss {
        eprint("qlmc: 内部错误：bss RVA 不一致 " + pe_bss.to_str() +
               " vs " + real_bss.to_str())
        exit(2)
    }
    write_file(out, blob)
    let t_all = (now_ns() - t0) / 1000
    print("[qlmc] " + src + " -> " + out + "  (" + len(blob).to_str() + " 字节, 子集 S12)" +
          "  编译 " + t_all.to_str() + " us（进程内）  后端 " +
          ((fn_end - rt_end) / 1000).to_str() + " us  -j" + nt.to_str())
}
