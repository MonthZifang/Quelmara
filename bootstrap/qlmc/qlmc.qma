// bootstrap/qlmc/qlmc.qma —— Quelmara 写的 Quelmara 编译器（stage-1，v2.16）
//
// ## 它是什么
//
// 一个**能出 exe** 的原生编译器：`.qma` -> PE32+，全程用 Quelmara 写，不经过
// Python、不依赖 CRT、不链接任何东西。跑起来是一个独立 exe。
//
// ## 它不是什么（重要，别当成"自举完成"）
//
// 只覆盖**子集 S12**（见 docs/05-toolchain.md §1.11 的覆盖表）。设计上刻意把
// "链路通 + 后端真"排在"语法全覆盖"前面：后端是自举的承重墙，语法是加法。
//
//   支持：fn（int/bool/str 形参与返回，≤4 参）、let/mut（可带类型标注）、赋值、
//         if/else、while、**for 区间**、**break/continue**、return、exit、print、
//         assert、len(str)、const（解析期内联）、算术 + - * / %、比较、
//         && || !（短路）、str 拼接与内容比较、递归、**struct（声明/字面量/
//         字段读写/值语义拷贝）**、**定长数组 [N]T（字面量/下标读写）**、
//         **enum（声明/构造/载荷）与 match（表达式/语句/`_`/载荷绑定）**、
//         **vec[T]（new/push/get/len/下标读写，容量固定不扩容）**、
//         **聚合（struct/enum）作形参与返回值（按值传 + sret）**、
//         **map[K]V（固定容量线性扫描）**、**切片 []T（视图）**、**defer**、
//         **≤4 个实参**、**import（同目录多文件）**、**@ffi（任意 DLL）**、
//         **闭包（无捕获）**
//   不支持：f64、泛型、宏/反射、接口、rc/Drop、闭包的捕获、
//         pub 可见性与限定调用、嵌套聚合字段、聚合 print
//
// ## 分层（v2.16 重写了后端，前端沿用）
//
//   lexer   `lex`            —— 只认 S2 记号集，不认识的字符 fail-fast
//   parser  递归下降 + 优先级爬升 —— **平坦 AST**（节点表 + `nx` 链）
//   IR      三地址线性 IR    —— `Ir`（op/dst/a/b/imm）+ 标签，与 AST 解耦
//   alloc   **线性扫描**     —— 变量固定 callee-saved（RBX/R12-R15），
//                              临时值走活跃区间 + R8-R11；跨调用的临时值落帧槽
//   emit    x86-64 手写编码  —— 按位置（寄存器/帧槽）发射，`cmp+jcc` 融合
//   par     **按函数并行**   —— 每个线程编一段，写 arena 自己那段，主线程拼装
//   file    PE32+ 三节       —— .text / .rdata / .bss（1 MB 堆），导入 kernel32
//
// ## 三个必须守住的性质
//
// 1. **差分**：同一份源码，stage-0 与 qlmc 的产物 stdout/退出码逐字节相同
//    （`tests/qlmc_test.py`）。这是唯一的正确性判据。
// 2. **确定性**：`-j1` 与 `-jN` 的 exe 逐字节相同（拼装顺序固定、每线程只写
//    自己的区间，所以并行不需要锁也不改变产物）。
// 3. **fail-fast**：不支持的语法/形态一律编译期报错并退 2，绝不静默生成错码。
//
// ## 用法
//
//   qlmc build <src.qma> [-o out.exe] [-j N]   编译成 PE（-j 0/省略 = 自动）
//   qlmc dump <src.qma>                        只跑词法+语法，打印统计
//   qlmc version
import std.core
import std.mem

// ---------------------------------------------------------------------------
// 写文件（产出 exe）
// ---------------------------------------------------------------------------

@ffi("kernel32.dll", "CreateFileA")
fn _CreateFileA(name: int, access: int, share: int, sec: int, disp: int,
                flags: int, tmpl: int) -> int

@ffi("kernel32.dll", "WriteFile")
fn _WriteFile(h: int, buf: int, n: int, got: int, ov: int) -> bool

@ffi("kernel32.dll", "CloseHandle")
fn _CloseHandle(h: int) -> bool

@ffi("kernel32.dll", "GetFileSize")
fn _GetFileSize(h: int, hi: int) -> int

@ffi("kernel32.dll", "ReadFile")
fn _ReadFile(h: int, buf: int, n: int, got: int, ov: int) -> bool

const GEN_READ = 2147483648         // 0x80000000
const OPEN_EXISTING = 3

const GEN_WRITE = 1073741824        // 0x40000000
const CREATE_ALWAYS = 2
const ATTR_NORMAL = 128

// ---------------------------------------------------------------------------
// 记号
// ---------------------------------------------------------------------------

const T_EOF = 0
const T_NUM = 1
const T_NAME = 2
const T_STR = 3
const T_PUNCT = 4
const T_KW = 5
// 浮点字面量（v2.38）：token 的 `s` 存**原文**，编译期不解析成 IEEE 位
// （qlmc 没有浮点运算能力），改由运行时 `strtod` 解析 —— 见 _gen_fparse 的注释。
const T_FNUM = 6

// 关键字 id
const K_FN = 1
const K_LET = 2
const K_MUT = 3
const K_IF = 4
const K_ELSE = 5
const K_WHILE = 6
const K_RETURN = 7
const K_TRUE = 8
const K_FALSE = 9
const K_PRINT = 10
const K_EXIT = 11
const K_MODULE = 12
const K_IMPORT = 13
const K_CONST = 14
const K_FOR = 15
const K_IN = 16
const K_BREAK = 17
const K_CONTINUE = 18
const K_STRUCT = 19
const K_ENUM = 20
const K_MATCH = 21
const K_DEFER = 22
const K_SPAWN = 23

// 标点 id（多字符的按"最长匹配"先行）
const P_LPAREN = 1
const P_RPAREN = 2
const P_LBRACE = 3
const P_RBRACE = 4
const P_COMMA = 5
const P_COLON = 6
const P_SEMI = 7
const P_ASSIGN = 8
const P_PLUS = 9
const P_MINUS = 10
const P_STAR = 11
const P_SLASH = 12
const P_PERCENT = 13
const P_LT = 14
const P_GT = 15
const P_EQ = 16
const P_NE = 17
const P_LE = 18
const P_GE = 19
const P_AND = 20
const P_OR = 21
const P_NOT = 22
const P_ARROW = 23
const P_DOT = 24
const P_DOTDOT = 25
const P_LBRACK = 26
const P_RBRACK = 27
const P_FATARROW = 28
// v2.86：复合赋值。**必须排在单字符 `+ - * / %` 之后判**（两字符优先），
// 否则 `x += 1` 会被切成 `+` 和 `=`。
// **id 从 37 起**：30..36 已经被 `& | ^ << >> >>> ~` 占了（那张表不连续，
// 只看前 28 个会以为 29 之后是空的 —— 第一版就是这么撞的：`-=` 被当成
// 位与 `&` 吃掉，语句变成 `z & 3` 的表达式语句，赋值静默消失）。
const P_PLUSEQ = 37
const P_MINUSEQ = 38
const P_STAREQ = 39
const P_SLASHEQ = 40
const P_PERCENTEQ = 41
const P_AT = 29
// 位运算与移位（v2.28）。优先级照 stage-0（Quelmara 自己的定义，见 SPEC §2.4）：
//   ||  <  &&  <  |  <  ^  <  &  <  == !=  <  < <= > >=  <  << >> >>>  <  + -  <  * / %
// 注意这**不是** C 的层次（C 把 & ^ | 放在 == 之下、<< 放在 +- 之上）。
const P_AMP = 30       // &
const P_PIPE = 31      // |
const P_CARET = 32     // ^
const P_SHL = 33       // <<
const P_SHR = 34       // >>（算术右移，对应 sar）
const P_USHR = 35      // >>>（逻辑右移，对应 shr）
const P_TILDE = 36     // ~（一元按位取反）

struct Tok {
    k: int          // T_*
    n: int          // 数值 / 关键字 id / 标点 id
    s: str          // 标识符名 / 字符串内容
    line: int
}

// ---------------------------------------------------------------------------
// AST：平坦节点表
//
// 节点用 int 索引（-1 = 无）。块用 (start, count) 表示**连续区间**——
// 解析是顺序追加的，所以嵌套块的成员天然连续，不需要链表。
// ---------------------------------------------------------------------------

// 表达式
const E_NUM = 40
const E_VAR = 41
const E_BIN = 42      // a = 运算符(P_*)，b/c = 子节点
const E_UN = 43       // a = P_MINUS / P_NOT，b = 子节点
const E_CALL = 44     // a = 名字 id，b/c = 实参节点（-1 = 无）
const E_STR = 45
const E_FIELD = 46      // a = 基址表达式，b = 字段名 id
const E_INDEX = 47      // a = 基址表达式，b = 下标表达式
const E_STRUCTLIT = 48  // a = struct 序号，b = 首个 E_FINIT（nx 链）
const E_ARRLIT = 49    // a = 首个 E_AINIT（nx 链），b = 元素个数
const E_FINIT = 50     // a = 字段序号，b = 值
const E_AINIT = 51     // a = 值
const E_ENUMCTOR = 52  // a = enum 序号，b = 变体序号，c = 载荷表达式（-1 = 无）
const E_MATCH = 53     // a = 被匹配表达式，b = 首个 E_ARM（nx 链），c = 结果类型
const E_METHOD = 55    // a = 接收者，b = 方法名 id，c = 实参（-1 = 无）
const E_VECNEW = 56    // a = 元素类型，b = 容量表达式
const E_MAPNEW = 57    // a = 键类型，b = 容量表达式，c = 值类型
const E_SLICE = 58     // a = 基址表达式，b = lo，c = hi（`a[lo..hi]`）
const E_CLOSURE = 59   // a = 合成函数的序号
// 形参记录（v2.29）：只出现在 nodes 的"形参表"区段里，不是真正的表达式。
// a = 名字 id，b = 类型 TY_*。Fn.pbase 指向这一段的起点。
const E_FPARAM = 60
// spawn f(args)（v2.32）：a = 函数名字 id，b/c/n/slot + nx 链 = 实参（同 E_CALL）
const E_SPAWN = 61
// 浮点字面量（v2.38）：a = 字符串表 id（字面量原文）
const E_FNUM = 62
const E_ARM = 54       // a = 变体序号（-1 = 通配），b = 绑定名 id（-1 = 不绑定），c = 体      // a = 字符串表 id

// 语句
const S_LET = 10     // a = 名字 id，b = 初值，n = mut(0/1)，slot = 帧槽号
const S_ASSIGN = 11  // a = 名字 id，b = 值
const S_IF = 12      // a = 条件，b = then(start)，c = then(count)，n = else(start)，slot = else(count)
const S_WHILE = 13   // a = 条件，b = start，c = count
const S_RETURN = 14  // a = 值（-1 = 无）
const S_PRINT = 15   // a = 值
const S_EXIT = 16    // a = 值
const S_EXPR = 17
const S_FOR = 18       // a = 循环变量名，b = lo，c = hi，n = 体
const S_BREAK = 19
const S_CONTINUE = 20
const S_ASG_FIELD = 21   // a = 基址，b = 字段名 id，c = 值
const S_ASG_INDEX = 22   // a = 基址，b = 下标，c = 值
const S_MATCH = 23
const S_DEFER = 24        // a = 被延迟的语句节点（S_EXPR / S_ASSIGN）       // 同 E_MATCH，但按语句降级    // a = 值

struct Node {
    op: int
    a: int
    b: int
    c: int
    n: int      // 附加（mut 标志 / else 头）
    slot: int   // 附加（局部槽号）
    ty: int     // 附加（表达式类型 TY_*）
    nx: int     // 同块下一条语句（-1 = 块尾）——块用链而不是区间：
                // 子块节点在父块区间里也占位置，按区间走会把子块当同级语句重发
}

// 类型（S2：int / bool / str / void）。Quelmara 的 str 是
// `[len:8][bytes][NUL]`，**值 = 数据指针**（长度在 ptr-8）。
const TY_INT = 0
const TY_BOOL = 1
const TY_STR = 2
const TY_VOID = 3
// 字节（v2.33）：只作 C_ADDRTY 的标记，表示"这个地址指向 1 字节"，
// 让下标读写走 LOAD8/STORE8 而不是 8 字节。仍是标量（< TY_STRUCT）。
const TY_BYTE = 4
// f64（v2.38）：**值一律住在 8 字节帧槽里**，按"地址"传递（当聚合对待）。
// 为什么不进寄存器：qlmc 的分配器只管通用寄存器，f64 要用 XMM —— 那套
// 双寄存器文件 + 调用约定是另一个量级的改动。这里先要"对"，性能留给之后：
// 每次运算把两个操作数从槽里 movsd 进 xmm0/xmm1，算完再存回槽。
const TY_F64 = 5
// 聚合类型编码（v2.17）：0x1000+si = struct；0x100000+(count<<8)+elem = 数组
const TY_STRUCT = 0x1000
const TY_ENUM = 0x2000
const TY_VEC = 0x8000        // 0x8000+elem：vec 句柄是标量（8 字节）
const TY_MAP = 0x10000       // 0x10000+(K<<8)+V：map 句柄也是标量
const TY_SLICE = 0x20000     // 0x20000+elem：切片 = (ptr, len) 两字聚合
const TY_FN = 0x30000        // 闭包 = {code, env} 两字聚合（本版 env 恒为 0）
const TY_ARRAY = 0x100000
// v2.31：8 → 24（qlmc 自己的 FnCtx 有 22 个字段）
// v2.82：24 → 32 —— 解释器 `qlm_interp.qma` 的 `St` 有 26 个字段，撞到了上限。
// 这个上限是**自举约束**：qlmc 必须能编译它自己的源码，所以字段数上限只能往上抬。
const MAX_FIELD = 32
const ST_STRIDE = 2 + MAX_FIELD * 2   // 每个 struct 在 stt 里占 name, nf, MAX_FIELD*(fname, fty)
const MAX_STRUCT = 64
const EN_HDR = 1200          // stt[EN_HDR] = enum 个数，enum 区从 EN_HDR+1 起
const EN_STRIDE = 26         // name, nvar, 8×(变体名, 载荷名, 载荷类型)
const MAX_VARIANT = 8
const TBL_SIZE = EN_HDR + 1 + 64 * EN_STRIDE

struct Fn {
    name: int       // 名字 id
    np: int         // 形参数（v2.29 起不限 4；第 5 个起走栈）
    pbase: int      // 形参表基址：nodes 里连续 np 条 E_FPARAM（a=名字 id, b=类型）
    ret_t: int      // 返回类型
    body: int       // 语句块链头
    nbody: int
    nlocals: int
}

// ---------------------------------------------------------------------------
// 词法
// ---------------------------------------------------------------------------

fn _is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

/// 字符 → 数字值（0..15），不是数字返回 -1
fn _digval(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }      // a..f
    if c >= 65 && c <= 70 { return c - 55 }       // A..F
    return -1
}

fn _is_alpha(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn _ty_id(w: str) -> int {
    if w == "bool" {
        return TY_BOOL
    }
    if w == "str" {
        return TY_STR
    }
    if w == "void" {
        return TY_VOID
    }
    if w == "f64" {
        return TY_F64
    }
    return TY_INT
}

fn _kw_id(w: str) -> int {
    if w == "fn" { return K_FN }
    if w == "let" { return K_LET }
    if w == "mut" { return K_MUT }
    if w == "if" { return K_IF }
    if w == "else" { return K_ELSE }
    if w == "while" { return K_WHILE }
    if w == "return" { return K_RETURN }
    if w == "true" { return K_TRUE }
    if w == "false" { return K_FALSE }
    if w == "print" { return K_PRINT }
    if w == "exit" { return K_EXIT }
    if w == "module" { return K_MODULE }
    if w == "import" { return K_IMPORT }
    if w == "const" { return K_CONST }
    if w == "for" { return K_FOR }
    if w == "in" { return K_IN }
    if w == "break" { return K_BREAK }
    if w == "continue" { return K_CONTINUE }
    if w == "struct" { return K_STRUCT }
    if w == "enum" { return K_ENUM }
    if w == "match" { return K_MATCH }
    if w == "defer" { return K_DEFER }
    if w == "spawn" { return K_SPAWN }
    return 0
}

fn _tok(toks: vec[Tok], k: int, n: int, s: str, line: int) {
    toks.push(Tok { k: k, n: n, s: s, line: line })
}

/// 词法：把源码切成记号表。只认 S1 的记号集；不认识的字符直接 fail-fast
/// （静默跳过 = 后面报一堆莫名其妙的语法错）。
fn lex(src: str, toks: vec[Tok]) -> int {
    let n = len(src)
    let mut i = 0
    let mut line = 1
    while i < n {
        let c = src[i]
        // 换行 / 空白
        if c == 10 {
            line = line + 1
            i = i + 1
            continue
        }
        if c == 13 || c == 32 || c == 9 {
            i = i + 1
            continue
        }
        // 注释
        if c == 47 && i + 1 < n && src[i + 1] == 47 {
            while i < n && src[i] != 10 {
                i = i + 1
            }
            continue
        }
        // 进制字面量：0x / 0b / 0o（v2.28）。写机器码编码必须要有十六进制——
        // qlmc 自己的源码里到处是 0xFF / 0x8000 / 0b1010，自举的前提。
        if c == 48 && i + 1 < n {
            let b = src[i + 1]
            let mut base = 0
            if b == 120 || b == 88 { base = 16 }
            else if b == 98 || b == 66 { base = 2 }
            else if b == 111 || b == 79 { base = 8 }
            if base != 0 {
                let mut j = i + 2
                let mut v = 0
                let mut cnt = 0
                while j < n {
                    let d = src[j]
                    if d == 95 {
                        j = j + 1
                        continue
                    }
                    let dv = _digval(d)
                    if dv < 0 || dv >= base {
                        break
                    }
                    v = v * base + dv
                    cnt = cnt + 1
                    j = j + 1
                }
                if cnt == 0 {
                    eprint("qlmc: " + substr(src, i, 2) + " 后面缺少数字 @ line " + line.to_str())
                    exit(2)
                }
                _tok(toks, T_NUM, v, "", line)
                i = j
                continue
            }
        }
        // 数字（支持下划线分隔）；v2.38 起也认浮点字面量
        if _is_digit(c) {
            let st = i
            while i < n {
                let d = src[i]
                if d == 95 {
                    i = i + 1
                    continue
                }
                if !_is_digit(d) {
                    break
                }
                i = i + 1
            }
            // 浮点的判定：`.` 后面必须跟数字（`1.foo` 是字段访问，不是浮点），
            // 或者直接跟指数 `e/E`。
            let mut isf = 0
            if i + 1 < n {
                if src[i] == 46 && _is_digit(src[i + 1]) {
                    isf = 1
                }
            }
            if i < n && (src[i] == 101 || src[i] == 69) {
                isf = 1
            }
            if isf == 1 {
                while i < n {
                    let d = src[i]
                    if _is_digit(d) || d == 46 || d == 95 {
                        i = i + 1
                        continue
                    }
                    if d == 101 || d == 69 {
                        i = i + 1
                        if i < n && (src[i] == 43 || src[i] == 45) {
                            i = i + 1
                        }
                        continue
                    }
                    break
                }
                _tok(toks, T_FNUM, 0, substr(src, st, i - st), line)
                continue
            }
            let mut v = 0
            let mut q = st
            while q < i {
                let d = src[q]
                if d != 95 {
                    v = v * 10 + (d - 48)
                }
                q = q + 1
            }
            _tok(toks, T_NUM, v, "", line)
            continue
        }
        // 标识符 / 关键字
        if _is_alpha(c) {
            let mut j = i
            while j < n && (_is_alpha(src[j]) || _is_digit(src[j])) {
                j = j + 1
            }
            let w = substr(src, i, j - i)
            let kw = _kw_id(w)
            if kw != 0 {
                _tok(toks, T_KW, kw, w, line)
            } else {
                _tok(toks, T_NAME, 0, w, line)
            }
            i = j
            continue
        }
        // 字符串字面量（只支持 \" \\ \n \t 四个转义）
        if c == 34 {
            let mut j = i + 1
            let mut out = ""
            while j < n && src[j] != 34 {
                if src[j] == 92 && j + 1 < n {
                    let e = src[j + 1]
                    if e == 110 {
                        out = out + chr(10)
                    } else if e == 116 {
                        out = out + chr(9)
                    } else if e == 34 {
                        out = out + chr(34)
                    } else if e == 92 {
                        out = out + chr(92)
                    } else {
                        out = out + chr(e)
                    }
                    j = j + 2
                    continue
                }
                out = out + chr(src[j])
                j = j + 1
            }
            if j >= n {
                eprint("qlmc: 字符串未闭合 @ line " + line.to_str())
                exit(2)
            }
            _tok(toks, T_STR, 0, out, line)
            i = j + 1
            continue
        }
        // 标点：三字符优先，然后两字符。
        // **一律直接比字节，不要用 substr**：substr 会分配一个新串，而这段代码
        // 对**每个字符**都跑一次——v2.28 实测，每字符一次 substr 让 96 KB 的输入
        // 从 16 ms 涨到 54 ms（3.3×），还白吃掉一堆堆。
        if c == 62 && i + 2 < n && src[i + 1] == 62 && src[i + 2] == 62 {
            _tok(toks, T_PUNCT, P_USHR, "", line)
            i = i + 3
            continue
        }
        if i + 1 < n {
            let d2 = src[i + 1]
            let mut pid = 0
            if c == 61 && d2 == 61 { pid = P_EQ }
            else if c == 33 && d2 == 61 { pid = P_NE }
            else if c == 60 && d2 == 61 { pid = P_LE }
            else if c == 62 && d2 == 61 { pid = P_GE }
            else if c == 38 && d2 == 38 { pid = P_AND }
            else if c == 124 && d2 == 124 { pid = P_OR }
            else if c == 45 && d2 == 62 { pid = P_ARROW }
            else if c == 46 && d2 == 46 { pid = P_DOTDOT }
            else if c == 61 && d2 == 62 { pid = P_FATARROW }
            else if c == 43 && d2 == 61 { pid = P_PLUSEQ }
            else if c == 45 && d2 == 61 { pid = P_MINUSEQ }
            else if c == 42 && d2 == 61 { pid = P_STAREQ }
            else if c == 47 && d2 == 61 { pid = P_SLASHEQ }
            else if c == 37 && d2 == 61 { pid = P_PERCENTEQ }
            else if c == 60 && d2 == 60 { pid = P_SHL }
            else if c == 62 && d2 == 62 { pid = P_SHR }
            if pid != 0 {
                _tok(toks, T_PUNCT, pid, "", line)
                i = i + 2
                continue
            }
        }
        let mut p1 = 0
        if c == 40 { p1 = P_LPAREN }
        else if c == 41 { p1 = P_RPAREN }
        else if c == 123 { p1 = P_LBRACE }
        else if c == 125 { p1 = P_RBRACE }
        else if c == 44 { p1 = P_COMMA }
        else if c == 58 { p1 = P_COLON }
        else if c == 59 { p1 = P_SEMI }
        else if c == 61 { p1 = P_ASSIGN }
        else if c == 43 { p1 = P_PLUS }
        else if c == 45 { p1 = P_MINUS }
        else if c == 42 { p1 = P_STAR }
        else if c == 47 { p1 = P_SLASH }
        else if c == 37 { p1 = P_PERCENT }
        else if c == 60 { p1 = P_LT }
        else if c == 62 { p1 = P_GT }
        else if c == 33 { p1 = P_NOT }
        else if c == 38 { p1 = P_AMP }
        else if c == 124 { p1 = P_PIPE }
        else if c == 94 { p1 = P_CARET }
        else if c == 126 { p1 = P_TILDE }
        else if c == 46 { p1 = P_DOT }
        else if c == 64 { p1 = P_AT }
        else if c == 91 { p1 = P_LBRACK }
        else if c == 93 { p1 = P_RBRACK }
        if p1 == 0 {
            eprint("qlmc: 不认识的字符 '" + chr(c) + "' @ line " + line.to_str())
            exit(2)
        }
        _tok(toks, T_PUNCT, p1, "", line)
        i = i + 1
    }
    _tok(toks, T_EOF, 0, "", line)
    return 0
}

// ---------------------------------------------------------------------------
// 语法（递归下降）
// ---------------------------------------------------------------------------

// 解析器状态：**vec 元素不能当可变单元格**（`ps[0].pos = x` 写进的是临时副本，
// 实测静默不生效 —— 第一次编译时表现成"fn 之后期望函数名"死循环）。
// 所以位置单独放一个 `vec[int]` 单元素 cell（`.set` 是写句柄，能看见），
// 其余只读的表打包成 P 按值传（vec 句柄是共享的，push 仍然可见）。
struct P {
    toks: vec[Tok]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    cname: vec[int]     // const 名字 id
    cval: vec[int]      // const 值（本版只支持整型字面量）
    stt: vec[int]       // struct 表：stt[0]=个数，每个 struct 占 ST_STRIDE 字
    fdll: vec[str]      // @ffi 的 DLL 名（与 fsym 平行）
    fsym: vec[str]      // @ffi 的符号名
    is_lib: int         // v3.37：1 = 编库（不要求 main、不发入口）
}

fn _st_base(si: int) -> int {
    return 1 + si * ST_STRIDE
}

fn _struct_index(p: P, nid: int) -> int {
    let n = p.stt.get(0)
    let mut i = 0
    while i < n {
        if p.stt.get(_st_base(i)) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _pnf(p: P, si: int) -> int {
    return p.stt.get(_st_base(si) + 1)
}

fn _st_field(p: P, si: int, nid: int) -> int {
    let nf = _pnf(p, si)
    let mut i = 0
    while i < nf {
        if p.stt.get(_st_base(si) + 2 + i * 2) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_base(ei: int) -> int {
    return EN_HDR + 1 + ei * EN_STRIDE
}

fn _enum_index(p: P, nid: int) -> int {
    let n = p.stt.get(EN_HDR)
    let mut i = 0
    while i < n {
        if p.stt.get(_en_base(i)) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_nvar(p: P, ei: int) -> int {
    return p.stt.get(_en_base(ei) + 1)
}

/// 变体名 → 序号（-1 = 没有）
fn _en_variant(p: P, ei: int, nid: int) -> int {
    let n = _en_nvar(p, ei)
    let mut i = 0
    while i < n {
        if p.stt.get(_en_base(ei) + 2 + i * 3) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _en_vname(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3)
}

fn _en_pname(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3 + 1)
}

fn _en_ptype(p: P, ei: int, vi: int) -> int {
    return p.stt.get(_en_base(ei) + 2 + vi * 3 + 2)
}

/// 类型：`int|bool|str|StructName|[N]T`
fn _type(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_PUNCT && t.n == P_LBRACK {
        _adv(pos)
        if _is_p(p, pos, P_RBRACK) {
            // []T = 切片（视图）
            _adv(pos)
            let e = _type(p, pos)
            if e >= TY_STRUCT {
                _fail(p, pos, "本版切片元素只支持 int/bool/str")
            }
            return TY_SLICE + e
        }
        let n = _cur(p, pos)
        if n.k != T_NUM {
            _fail(p, pos, "数组长度期望整数常量")
        }
        _adv(pos)
        _eat_p(p, pos, P_RBRACK)
        let e = _type(p, pos)
        if e >= TY_STRUCT {
            _fail(p, pos, "本版数组元素只支持 int/bool/str")
        }
        return TY_ARRAY + (n.n << 8) + e
    }
    if t.k == T_NAME && t.s == "map" {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let kt = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        let vt = _type(p, pos)
        if kt >= TY_STRUCT || vt >= TY_STRUCT {
            _fail(p, pos, "本版 map 的键/值只支持 int/bool/str")
        }
        return TY_MAP + (kt << 8) + vt
    }
    if t.k == T_NAME && t.s == "vec" {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let e = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        // 聚合元素（v2.31）：struct / enum / 定长数组都行。
        // 嵌套 vec/map/切片/闭包仍然拒绝——它们的类型码会和区间撞
        // （0x8000+0x8000 = TY_MAP，见 07-gaps §7.18）。
        if e >= TY_VEC && e < TY_ARRAY {
            _fail(p, pos, "本版 vec 元素不支持嵌套 vec/map/切片/闭包（类型码撞区间，见 07-gaps §7.18）")
        }
        return TY_VEC + e
    }
    if t.k == T_NAME {
        _adv(pos)
        if t.s == "int" { return TY_INT }
        if t.s == "bool" { return TY_BOOL }
        if t.s == "str" { return TY_STR }
        if t.s == "f64" { return TY_F64 }
        let nid = _name_id(p, t.s)
        let si = _struct_index(p, nid)
        if si >= 0 {
            return TY_STRUCT + si
        }
        let ei = _enum_index(p, nid)
        if ei >= 0 {
            return TY_ENUM + ei
        }
        _fail(p, pos, "未知类型 " + t.s)
    }
    _fail(p, pos, "期望类型")
    return TY_INT
}

fn _adv(pos: vec[int]) {
    pos.set(0, pos[0] + 1)
}

fn _t(p: P, i: int) -> Tok {
    if i >= len(p.toks) {
        return Tok { k: T_EOF, n: 0, s: "", line: 0 }
    }
    return p.toks[i]
}

fn _cur(p: P, pos: vec[int]) -> Tok {
    return _t(p, pos[0])
}

@ffi("kernel32.dll", "GetCurrentProcess")
fn _GetCurrentProcess() -> int

@ffi("kernel32.dll", "TerminateProcess")
fn _TerminateProcess(h: int, code: int) -> bool

/// 出错退出：**不用 ExitProcess，用 TerminateProcess**（v2.85）。
///
/// ExitProcess 会走 loader 的进程关闭流程（LdrShutdownProcess 遍历模块表、
/// 逐个调 DLL 的 DETACH），而 qlmc 在**深层解析函数**里调它时那个流程会 AV
/// （§7.34：先正确打印诊断，再 0xC0000005）。TerminateProcess 不做这些，
/// 直接结束进程。编译器没有需要 flush 的缓冲（print/eprint 都是 WriteFile），
/// 所以硬退出没有副作用。
fn _die(code: int) {
    _TerminateProcess(_GetCurrentProcess(), code)
    exit(code)                       // 万一 TerminateProcess 失败
}

fn _fail(p: P, pos: vec[int], msg: str) {
    eprint("qlmc: line " + _cur(p, pos).line.to_str() + ": " + msg)
    _die(2)
}

fn _is_p(p: P, pos: vec[int], pid: int) -> bool {
    let t = _cur(p, pos)
    return t.k == T_PUNCT && t.n == pid
}

fn _eat_p(p: P, pos: vec[int], pid: int) {
    if !_is_p(p, pos, pid) {
        _fail(p, pos, "期望标点 #" + pid.to_str())
    }
    _adv(pos)
}

fn _name_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.names) {
        if p.names[i] == s {
            return i
        }
        i = i + 1
    }
    p.names.push(s)
    return len(p.names) - 1
}

/// 查 const 表；没有返回 -1
/// 查常量在表里的**下标**（-1 = 没定义）。
/// 不要用"值 == -1"当哨兵——`const A = -1` 是合法的，那样会把 A 当成未定义。
fn _const_idx(p: P, nid: int) -> int {
    let mut i = 0
    while i < len(p.cname) {
        if p.cname[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

/// 解析期常量求值（v2.30）：把 const 初值的 AST 折成一个整数。
///
/// 认：整型字面量、**已定义**的 const、一元 `-` `~`、二元 `+ - * / % & | ^ << >> >>>`。
/// 其余一律 fail-fast——绝不"折不动就当 0"，那是静默错编。
///
/// 口径对齐 stage-0：它的 const 右值只支持 `+ - * / %`（`parse_const_value`），
/// 所以位运算这里是**超集**（qlmc 更宽松，只多不少，不影响逐字节差分）；
/// 除法/取模用 C 截断语义（与语言里的 `/` `%` 一致）。
fn _fold(p: P, pos: vec[int], nid: int) -> int {
    let nd = p.nodes.get(nid)
    if nd.op == E_NUM {
        return nd.a
    }
    if nd.op == E_VAR {
        let ci = _const_idx(p, nd.a)
        if ci < 0 {
            _fail(p, pos, "const 初值只能引用**已定义**的常量（按声明序求值）")
        }
        return p.cval.get(ci)
    }
    if nd.op == E_UN {
        let v = _fold(p, pos, nd.b)
        if nd.a == P_MINUS {
            return 0 - v
        }
        if nd.a == P_TILDE {
            return 0 - v - 1              // ~v = -v-1（64 位补码）
        }
        _fail(p, pos, "const 初值里的一元运算只支持 - 和 ~")
        return 0
    }
    if nd.op == E_BIN {
        let a = _fold(p, pos, nd.b)
        let b = _fold(p, pos, nd.c)
        if nd.a == P_PLUS { return a + b }
        if nd.a == P_MINUS { return a - b }
        if nd.a == P_STAR { return a * b }
        if nd.a == P_SLASH {
            if b == 0 {
                _fail(p, pos, "const 初值编译期除零")
            }
            return a / b
        }
        if nd.a == P_PERCENT {
            if b == 0 {
                _fail(p, pos, "const 初值编译期除零")
            }
            return a % b
        }
        if nd.a == P_AMP { return a & b }
        if nd.a == P_PIPE { return a | b }
        if nd.a == P_CARET { return a ^ b }
        if nd.a == P_SHL { return a << b }
        if nd.a == P_SHR { return a >> b }
        if nd.a == P_USHR { return a >>> b }
        _fail(p, pos, "const 初值里的二元运算只支持 + - * / % & | ^ << >> >>>")
        return 0
    }
    _fail(p, pos, "const 初值必须是编译期可求值的整型表达式")
    return 0
}

fn _str_id(p: P, s: str) -> int {
    let mut i = 0
    while i < len(p.strs) {
        if p.strs[i] == s {
            return i
        }
        i = i + 1
    }
    p.strs.push(s)
    return len(p.strs) - 1
}

fn _node(p: P, op: int, a: int, b: int, c: int) -> int {
    // n 默认 -1：S_IF 用它存 else 链头，0 会被当成"有 else"并去发节点 0
    p.nodes.push(Node { op: op, a: a, b: b, c: c, n: -1, slot: 0,
                       ty: TY_INT, nx: -1 })
    return len(p.nodes) - 1
}

// 表达式：优先级爬升。|| -> && -> 相等 -> 关系 -> 加减 -> 乘除模 -> 一元 -> 基本
fn _set_nx(p: P, id: int, nx: int) {
    let nd = p.nodes.get(id)
    p.nodes.set(id, Node { op: nd.op, a: nd.a, b: nd.b, c: nd.c, n: nd.n,
                           slot: nd.slot, ty: nd.ty, nx: nx })
}

/// 后缀：`.字段` 与 `[下标]`，可链式
fn _postfix(p: P, pos: vec[int], base: int) -> int {
    let mut e = base
    while true {
        if _is_p(p, pos, P_DOT) {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, ". 后期望字段名")
            }
            _adv(pos)
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                let mut arg = -1
                let mut arg2 = -1
                if !_is_p(p, pos, P_RPAREN) {
                    arg = _expr(p, pos)
                    if _is_p(p, pos, P_COMMA) {
                        _adv(pos)
                        arg2 = _expr(p, pos)
                    }
                }
                _eat_p(p, pos, P_RPAREN)
                let mid = _node(p, E_METHOD, e, _name_id(p, nm.s), arg)
                p.nodes.set(mid, Node { op: E_METHOD, a: e, b: _name_id(p, nm.s),
                                        c: arg, n: arg2, slot: 0, ty: 0, nx: -1 })
                e = mid
                continue
            }
            e = _node(p, E_FIELD, e, _name_id(p, nm.s), -1)
            continue
        }
        if _is_p(p, pos, P_LBRACK) {
            _adv(pos)
            let ix = _expr(p, pos)
            if _is_p(p, pos, P_DOTDOT) {
                _adv(pos)
                let hi = _expr(p, pos)
                _eat_p(p, pos, P_RBRACK)
                e = _node(p, E_SLICE, e, ix, hi)
                continue
            }
            _eat_p(p, pos, P_RBRACK)
            e = _node(p, E_INDEX, e, ix, -1)
            continue
        }
        break
    }
    return e
}

/// struct 字面量：`Name { f: e, g: e2 }`（字段名必须存在）
fn _struct_lit(p: P, pos: vec[int], si: int) -> int {
    _eat_p(p, pos, P_LBRACE)
    let mut first = -1
    let mut last = -1
    while !_is_p(p, pos, P_RBRACE) {
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "struct 字面量期望字段名")
        }
        _adv(pos)
        _eat_p(p, pos, P_COLON)
        let v = _expr(p, pos)
        let fi = _st_field(p, si, _name_id(p, nm.s))
        if fi < 0 {
            _fail(p, pos, "struct 没有字段 " + nm.s)
        }
        let id = _node(p, E_FINIT, fi, v, -1)
        if first < 0 {
            first = id
        } else {
            _set_nx(p, last, id)
        }
        last = id
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RBRACE)
    return _node(p, E_STRUCTLIT, si, first, -1)
}

/// match：`match e { Pat => expr ... }`；`block_mode=1` 时臂体是 `{ ... }` 块
fn _match(p: P, pos: vec[int], block_mode: int) -> int {
    _adv(pos)                       // 吃掉 match
    let scrut = _expr(p, pos)
    _eat_p(p, pos, P_LBRACE)
    let mut first = -1
    let mut last = -1
    while !_is_p(p, pos, P_RBRACE) {
        // 模式
        let mut vi = -1
        let mut bind = -1
        let t = _cur(p, pos)
        if t.k == T_NAME && t.s == "_" {
            _adv(pos)
        } else {
            let en = _cur(p, pos)
            if en.k != T_NAME {
                _fail(p, pos, "match 模式期望 枚举名.变体 或 _")
            }
            _adv(pos)
            let ei = _enum_index(p, _name_id(p, en.s))
            if ei < 0 {
                _fail(p, pos, "match 模式里的 " + en.s + " 不是 enum")
            }
            _eat_p(p, pos, P_DOT)
            let vn = _cur(p, pos)
            if vn.k != T_NAME {
                _fail(p, pos, "match 模式期望变体名")
            }
            _adv(pos)
            vi = _en_variant(p, ei, _name_id(p, vn.s))
            if vi < 0 {
                _fail(p, pos, "enum 没有变体 " + vn.s)
            }
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                let bn = _cur(p, pos)
                if bn.k == T_NAME {
                    bind = _name_id(p, bn.s)
                    _adv(pos)
                }
                _eat_p(p, pos, P_RPAREN)
            }
        }
        _eat_p(p, pos, P_FATARROW)
        let mut body = -1
        if block_mode == 1 && _is_p(p, pos, P_LBRACE) {
            body = _block(p, pos)
        } else {
            body = _expr(p, pos)
        }
        let id = _node(p, E_ARM, vi, bind, body)
        if first < 0 {
            first = id
        } else {
            _set_nx(p, last, id)
        }
        last = id
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RBRACE)
    return _node(p, E_MATCH, scrut, first, 0)
}

fn _expr(p: P, pos: vec[int]) -> int {
    return _or_e(p, pos)
}

fn _or_e(p: P, pos: vec[int]) -> int {
    let mut l = _and_e(p, pos)
    while _is_p(p, pos, P_OR) {
        _adv(pos)
        let r = _and_e(p, pos)
        l = _node(p, E_BIN, P_OR, l, r)
    }
    return l
}

fn _and_e(p: P, pos: vec[int]) -> int {
    let mut l = _bor_e(p, pos)
    while _is_p(p, pos, P_AND) {
        _adv(pos)
        let r = _bor_e(p, pos)
        l = _node(p, E_BIN, P_AND, l, r)
    }
    return l
}

// 位运算三层：| 最松，^ 居中，& 最紧（在比较之上）。照 stage-0 的定义，
// 不是 C 的顺序——`a & b == c` 在 Quelmara 里是 `a & (b == c)` 吗？不是：
// & 的右操作数是 `_eq_e`，所以 `a & b == c` 解析成 `a & (b == c)`。
fn _bor_e(p: P, pos: vec[int]) -> int {
    let mut l = _bxor_e(p, pos)
    while _is_p(p, pos, P_PIPE) {
        _adv(pos)
        let r = _bxor_e(p, pos)
        l = _node(p, E_BIN, P_PIPE, l, r)
    }
    return l
}

fn _bxor_e(p: P, pos: vec[int]) -> int {
    let mut l = _band_e(p, pos)
    while _is_p(p, pos, P_CARET) {
        _adv(pos)
        let r = _band_e(p, pos)
        l = _node(p, E_BIN, P_CARET, l, r)
    }
    return l
}

fn _band_e(p: P, pos: vec[int]) -> int {
    let mut l = _eq_e(p, pos)
    while _is_p(p, pos, P_AMP) {
        _adv(pos)
        let r = _eq_e(p, pos)
        l = _node(p, E_BIN, P_AMP, l, r)
    }
    return l
}

fn _eq_e(p: P, pos: vec[int]) -> int {
    let mut l = _rel_e(p, pos)
    while _is_p(p, pos, P_EQ) || _is_p(p, pos, P_NE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _rel_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _rel_e(p: P, pos: vec[int]) -> int {
    let mut l = _shift_e(p, pos)
    while _is_p(p, pos, P_LT) || _is_p(p, pos, P_GT) ||
          _is_p(p, pos, P_LE) || _is_p(p, pos, P_GE) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _shift_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

// 移位在比较之下、加减之上（C 也是这个位置）
fn _shift_e(p: P, pos: vec[int]) -> int {
    let mut l = _add_e(p, pos)
    while _is_p(p, pos, P_SHL) || _is_p(p, pos, P_SHR) || _is_p(p, pos, P_USHR) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _add_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _add_e(p: P, pos: vec[int]) -> int {
    let mut l = _mul_e(p, pos)
    while _is_p(p, pos, P_PLUS) || _is_p(p, pos, P_MINUS) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _mul_e(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _mul_e(p: P, pos: vec[int]) -> int {
    let mut l = _unary(p, pos)
    while _is_p(p, pos, P_STAR) || _is_p(p, pos, P_SLASH) ||
          _is_p(p, pos, P_PERCENT) {
        let op = _cur(p, pos).n
        _adv(pos)
        let r = _unary(p, pos)
        l = _node(p, E_BIN, op, l, r)
    }
    return l
}

fn _unary(p: P, pos: vec[int]) -> int {
    if _is_p(p, pos, P_MINUS) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_MINUS, v, -1)
    }
    if _is_p(p, pos, P_NOT) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_NOT, v, -1)
    }
    if _is_p(p, pos, P_TILDE) {
        _adv(pos)
        let v = _unary(p, pos)
        return _node(p, E_UN, P_TILDE, v, -1)
    }
    return _primary(p, pos)
}

/// 解析 `(实参列表)` 并造一个调用形状的节点（E_CALL / E_SPAWN 共用）。
/// 实参：前 4 个放 b/c/n/slot，第 5 个起挂 nx 链（v2.29 放开个数）。
fn _call_node(p: P, pos: vec[int], op: int, nid: int) -> int {
    _eat_p(p, pos, P_LPAREN)
    let args = vec[int].new(4)
    while !_is_p(p, pos, P_RPAREN) {
        args.push(_expr(p, pos))
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RPAREN)
    let mut a0 = -1
    let mut a1 = -1
    let mut a2 = -1
    let mut a3 = -1
    if len(args) > 0 { a0 = args.get(0) }
    if len(args) > 1 { a1 = args.get(1) }
    if len(args) > 2 { a2 = args.get(2) }
    if len(args) > 3 { a3 = args.get(3) }
    let cid = _node(p, op, nid, a0, a1)
    p.nodes.set(cid, Node { op: op, a: nid, b: a0, c: a1, n: a2,
                            slot: a3, ty: 0, nx: -1 })
    if len(args) > 4 {
        let mut first = -1
        let mut last = -1
        let mut i = 4
        while i < len(args) {
            let id = _node(p, E_AINIT, args.get(i), -1, -1)
            if first < 0 {
                first = id
            } else {
                _set_nx(p, last, id)
            }
            last = id
            i = i + 1
        }
        _set_nx(p, cid, first)
    }
    return cid
}

/// 把十进制浮点字面量算成 IEEE-754 double 的**位模式**（编译期）。
///
/// 只在"能被 double 精确表示"时返回位模式，否则返回 -1，降级期退回运行时
/// `strtod`（正确性优先）。覆盖范围：
///   · 正指数：mantissa * 10^k 且乘积 < 2^53；
///   · 负指数：mantissa 能被 5^k 除尽（k = 小数位数），此时
///     m/10^k = (m/5^k) * 2^(-k)，分子分母都精确 → 结果精确。
/// 也就是 `1.0` / `0.5` / `2.5` / `100.0` / `1e3` 这些"整齐"的字面量。
/// `3.14` / `0.1` 这种不精确的仍然走 strtod —— 宁可慢，也不能错。
fn _f64_bits(s: str) -> int {
    let n = len(s)
    let mut i = 0
    let mut neg = 0
    if i < n && s[i] == 45 {                // '-'
        neg = 1
        i = i + 1
    }
    let mut m = 0
    let mut frac = 0
    let mut dot = 0
    let mut any = 0
    let mut e10 = 0
    let mut eseen = 0
    let mut eneg = 0
    while i < n {
        let c = s[i]
        if c == 46 {                        // '.'
            dot = 1
            i = i + 1
        } else if c == 101 || c == 69 {     // 'e' / 'E'
            eseen = 1
            i = i + 1
            if i < n && s[i] == 45 {
                eneg = 1
                i = i + 1
            } else if i < n && s[i] == 43 {
                i = i + 1
            }
            while i < n {
                let d = s[i]
                if d < 48 || d > 57 {
                    return -1
                }
                e10 = e10 * 10 + (d - 48)
                if e10 > 400 {
                    return -1
                }
                i = i + 1
            }
        } else {
            if c < 48 || c > 57 {
                return -1
            }
            if eseen == 1 {
                return -1
            }
            if m > 900719925474099 {        // 2^53/10：再乘就会丢精度
                return -1
            }
            m = m * 10 + (c - 48)
            if dot == 1 {
                frac = frac + 1
            }
            any = 1
            i = i + 1
        }
    }
    if any == 0 {
        return -1
    }
    if eneg == 1 {
        e10 = 0 - e10
    }
    let mut k = frac - e10                  // 要除以 10^k（k<0 就是乘）
    // 去掉尾随零（顺便把 k 减小）
    while k > 0 && m > 0 && m % 10 == 0 {
        m = m / 10
        k = k - 1
    }
    if m == 0 {
        return 0
    }
    let mut be = 0                          // 二进制指数：值 = m * 2^be
    if k > 0 {
        let mut j = 0
        while j < k {
            if m % 5 != 0 {
                return -1                   // 除不尽 → 不精确，退回 strtod
            }
            m = m / 5
            j = j + 1
        }
        be = 0 - k
    } else if k < 0 {
        let mut j = k
        while j < 0 {
            if m > 900719925474099 {
                return -1
            }
            m = m * 10
            j = j + 1
        }
    }
    if m <= 0 || m > 9007199254740992 {     // 2^53
        return -1
    }
    // 找最高位 h（m ∈ [2^h, 2^(h+1))）
    let mut h = 0
    let mut t = m
    while t > 1 {
        t = t >> 1
        h = h + 1
    }
    let e = h + be + 1023
    if e < 1 || e > 2046 {
        return -1
    }
    let mant = (m << (52 - h)) & 4503599627370495
    let mut bits = (e << 52) | mant
    if neg == 1 {
        bits = bits | (0 - 9223372036854775807 - 1)   // 符号位
    }
    return bits
}

fn _primary(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_NUM || t.k == T_FNUM {
        _adv(pos)
        if t.k == T_FNUM {
            // 字面量原文入串表（运行时 strtod 兜底用），同时**在编译期算出
            // 精确可表示时的位模式**（v2.56）—— 存进节点的 b，c=1 表示可用。
            // 这样 `1.0` 这类字面量在循环体里只剩 `movabs + movq` 两条指令，
            // 不再是"标志位 + 分支 + 每轮一次 strtod 守卫"的 14 条。
            let sid = _str_id(p, t.s)
            let bits = _f64_bits(t.s)
            let mut ok = 0
            if bits >= 0 {
                ok = 1
            }
            return _postfix(p, pos, _node(p, E_FNUM, sid, bits, ok))
        }
        return _postfix(p, pos, _node(p, E_NUM, t.n, -1, -1))
    }
    if t.k == T_STR {
        _adv(pos)
        return _postfix(p, pos, _node(p, E_STR, _str_id(p, t.s), -1, -1))
    }
    if t.k == T_KW && (t.n == K_TRUE || t.n == K_FALSE) {
        _adv(pos)
        let mut v = 0
        if t.n == K_TRUE {
            v = 1
        }
        return _postfix(p, pos, _node(p, E_NUM, v, -1, -1))
    }
    if t.k == T_KW && t.n == K_SPAWN {
        // spawn f(args) -> 任务句柄（v2.32）。只认"函数名 + 实参列表"，
        // 不做 stage-0 那个 `spawn f(x).join()` 脱糖（用 join(spawn f(x)) 即可）。
        _adv(pos)
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "spawn 后面必须是函数调用")
        }
        _adv(pos)
        if !_is_p(p, pos, P_LPAREN) {
            _fail(p, pos, "spawn 后面必须是函数调用")
        }
        let sid = _call_node(p, pos, E_SPAWN, _name_id(p, nm.s))
        return _postfix(p, pos, sid)
    }
    if t.k == T_KW && t.n == K_FN {
        // 闭包字面量：合成一个顶层函数，表达式值 = {code, 0}
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let pbase = len(p.nodes)
        let mut np = 0
        while !_is_p(p, pos, P_RPAREN) {
            let pn = _cur(p, pos)
            if pn.k != T_NAME {
                _fail(p, pos, "闭包形参期望名字")
            }
            _adv(pos)
            let mut pt = TY_INT
            if _is_p(p, pos, P_COLON) {
                _adv(pos)
                pt = _type(p, pos)
            }
            if pt >= TY_STRUCT {
                _fail(p, pos, "闭包形参只支持 int/bool/str")
            }
            _node(p, E_FPARAM, _name_id(p, pn.s), pt, -1)
            np = np + 1
            if _is_p(p, pos, P_COMMA) {
                _adv(pos)
            }
        }
        _eat_p(p, pos, P_RPAREN)
        let mut rt = TY_VOID
        if _is_p(p, pos, P_ARROW) {
            _adv(pos)
            rt = _type(p, pos)
        }
        let lname = _name_id(p, "__lambda_" + len(p.fns).to_str())
        let body = _block(p, pos)
        let fi = len(p.fns)
        p.fns.push(Fn { name: lname, np: np, pbase: pbase,
                        ret_t: rt, body: body, nbody: 0, nlocals: -1 })
        return _postfix(p, pos, _node(p, E_CLOSURE, fi, -1, -1))
    }
    if t.k == T_KW && t.n == K_MATCH {
        return _postfix(p, pos, _match(p, pos, 0))
    }
    if t.k == T_PUNCT && t.n == P_LBRACK {
        // 数组字面量 [e1, e2, ...]
        _adv(pos)
        let mut first = -1
        let mut last = -1
        let mut cnt = 0
        while !_is_p(p, pos, P_RBRACK) {
            let v = _expr(p, pos)
            let id = _node(p, E_AINIT, v, -1, -1)
            if first < 0 {
                first = id
            } else {
                _set_nx(p, last, id)
            }
            last = id
            cnt = cnt + 1
            if _is_p(p, pos, P_COMMA) {
                _adv(pos)
            }
        }
        _eat_p(p, pos, P_RBRACK)
        return _postfix(p, pos, _node(p, E_ARRLIT, first, cnt, -1))
    }
    if t.k == T_PUNCT && t.n == P_LPAREN {
        _adv(pos)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _postfix(p, pos, v)
    }
    if t.k == T_NAME && t.s == "map" && _t(p, pos[0] + 1).k == T_PUNCT &&
       _t(p, pos[0] + 1).n == P_LBRACK {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let kt = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        let vt = _type(p, pos)
        _eat_p(p, pos, P_DOT)
        let nm = _cur(p, pos)
        if nm.k != T_NAME || nm.s != "new" {
            _fail(p, pos, "map[K]V 之后只支持 .new(n)")
        }
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let cnt = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        let id = _node(p, E_MAPNEW, kt, cnt, vt)
        return _postfix(p, pos, id)
    }
    if t.k == T_NAME && t.s == "vec" && _t(p, pos[0] + 1).k == T_PUNCT &&
       _t(p, pos[0] + 1).n == P_LBRACK {
        _adv(pos)
        _eat_p(p, pos, P_LBRACK)
        let et = _type(p, pos)
        _eat_p(p, pos, P_RBRACK)
        _eat_p(p, pos, P_DOT)
        let nm = _cur(p, pos)
        if nm.k != T_NAME || nm.s != "new" {
            _fail(p, pos, "vec[T] 之后只支持 .new(n)")
        }
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let cnt = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _postfix(p, pos, _node(p, E_VECNEW, et, cnt, -1))
    }
    if t.k == T_NAME {
        _adv(pos)
        let nid = _name_id(p, t.s)
        let ei = _enum_index(p, nid)
        if ei >= 0 && _is_p(p, pos, P_DOT) {
            _adv(pos)
            let vn = _cur(p, pos)
            if vn.k != T_NAME {
                _fail(p, pos, "枚举变体名期望标识符")
            }
            _adv(pos)
            let vi = _en_variant(p, ei, _name_id(p, vn.s))
            if vi < 0 {
                _fail(p, pos, "enum 没有变体 " + vn.s)
            }
            let mut pl = -1
            if _is_p(p, pos, P_LPAREN) {
                _adv(pos)
                // 载荷可写 `变体(值)` 或 `变体(名: 值)`
                if _cur(p, pos).k == T_NAME && _t(p, pos[0] + 1).k == T_PUNCT &&
                   _t(p, pos[0] + 1).n == P_COLON {
                    _adv(pos)
                    _adv(pos)
                }
                pl = _expr(p, pos)
                _eat_p(p, pos, P_RPAREN)
            }
            return _postfix(p, pos, _node(p, E_ENUMCTOR, ei, vi, pl))
        }
        if _is_p(p, pos, P_LBRACE) {
            let si = _struct_index(p, nid)
            if si >= 0 {
                return _postfix(p, pos, _struct_lit(p, pos, si))
            }
        }
        if !_is_p(p, pos, P_LPAREN) {
            let ci = _const_idx(p, nid)
            if ci >= 0 {
                return _postfix(p, pos, _node(p, E_NUM, p.cval.get(ci), -1, -1))
            }
        }
        if _is_p(p, pos, P_LPAREN) {
            return _postfix(p, pos, _call_node(p, pos, E_CALL, nid))
        }
        return _postfix(p, pos, _node(p, E_VAR, nid, -1, -1))
    }
    _fail(p, pos, "期望表达式")
    return -1
}

fn _stmt(p: P, pos: vec[int]) -> int {
    let t = _cur(p, pos)
    if t.k == T_KW && t.n == K_LET {
        _adv(pos)
        let mut m = 0
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_MUT {
            m = 1
            _adv(pos)
        }
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "let 后期望变量名")
        }
        _adv(pos)
        let nid = _name_id(p, nm.s)
        let mut ty = TY_INT
        let mut has = 0
        if _is_p(p, pos, P_COLON) {
            _adv(pos)
            ty = _type(p, pos)
            has = 1
        }
        let mut init = -1
        if _is_p(p, pos, P_ASSIGN) {
            _adv(pos)
            init = _expr(p, pos)
        }
        let id = _node(p, S_LET, nid, init, -1)
        p.nodes.set(id, Node { op: S_LET, a: nid, b: init, c: -1, n: m,
                               slot: has, ty: ty, nx: -1 })
        return id
    }
    if t.k == T_KW && t.n == K_IF {
        _adv(pos)
        let cond = _expr(p, pos)
        let th = _block(p, pos)
        let id = _node(p, S_IF, cond, th, -1)
        if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_ELSE {
            _adv(pos)
            let mut eh = -1
            if _cur(p, pos).k == T_KW && _cur(p, pos).n == K_IF {
                // `else if`（v2.31）：else 体就是那一条 if 语句（单节点链）。
                // 之前只认 `else {`，而 qlmc 自己的源码里全是 `else if`——
                // 自举时第一个撞上的语法就是它。
                eh = _stmt(p, pos)
            } else {
                eh = _block(p, pos)
            }
            p.nodes.set(id, Node { op: S_IF, a: cond, b: th, c: -1,
                                   n: eh, slot: 0, ty: TY_INT, nx: -1 })
        }
        return id
    }
    if t.k == T_KW && t.n == K_DEFER {
        _adv(pos)
        let inner = _stmt(p, pos)
        let inz = p.nodes.get(inner)
        if inz.op != S_EXPR && inz.op != S_ASSIGN && inz.op != S_ASG_FIELD &&
           inz.op != S_ASG_INDEX && inz.op != S_PRINT {
            _fail(p, pos, "defer 只支持表达式语句或赋值")
        }
        return _node(p, S_DEFER, inner, -1, -1)
    }
    if t.k == T_KW && t.n == K_MATCH {
        let m = _match(p, pos, 1)
        let nd = p.nodes.get(m)
        p.nodes.set(m, Node { op: S_MATCH, a: nd.a, b: nd.b, c: 0, n: 0,
                              slot: 0, ty: TY_INT, nx: -1 })
        return m
    }
    if t.k == T_KW && t.n == K_FOR {
        _adv(pos)
        let nm = _cur(p, pos)
        if nm.k != T_NAME {
            _fail(p, pos, "for 后期望循环变量名")
        }
        _adv(pos)
        if !(_cur(p, pos).k == T_KW && _cur(p, pos).n == K_IN) {
            _fail(p, pos, "for 变量后期望 in")
        }
        _adv(pos)
        let lo = _expr(p, pos)
        _eat_p(p, pos, P_DOTDOT)
        let hi = _expr(p, pos)
        let body = _block(p, pos)
        let id = _node(p, S_FOR, _name_id(p, nm.s), lo, hi)
        p.nodes.set(id, Node { op: S_FOR, a: _name_id(p, nm.s), b: lo, c: hi,
                               n: body, slot: 0, ty: TY_INT, nx: -1 })
        return id
    }
    if t.k == T_KW && t.n == K_BREAK {
        _adv(pos)
        return _node(p, S_BREAK, -1, -1, -1)
    }
    if t.k == T_KW && t.n == K_CONTINUE {
        _adv(pos)
        return _node(p, S_CONTINUE, -1, -1, -1)
    }
    if t.k == T_KW && t.n == K_WHILE {
        _adv(pos)
        let cond = _expr(p, pos)
        let bh = _block(p, pos)
        return _node(p, S_WHILE, cond, bh, -1)
    }
    if t.k == T_KW && t.n == K_RETURN {
        _adv(pos)
        let mut v = -1
        if !_is_p(p, pos, P_RBRACE) {
            v = _expr(p, pos)
        }
        return _node(p, S_RETURN, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_PRINT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_PRINT, v, -1, -1)
    }
    if t.k == T_KW && t.n == K_EXIT {
        _adv(pos)
        _eat_p(p, pos, P_LPAREN)
        let v = _expr(p, pos)
        _eat_p(p, pos, P_RPAREN)
        return _node(p, S_EXIT, v, -1, -1)
    }
    // 表达式语句，或 `左值 = 表达式`（左值可以是 变量 / 字段 / 下标）
    let v = _expr(p, pos)
    // 复合赋值 `+= -= *= /= %=`：展开成 `lv = lv <op> rhs`。
    // 左值会求值两次（`v[f()] += 1` 里 f 调两次）—— 变量/下标是幂等的，
    // 这种写法在实际代码里几乎不出现，先按简单来（与解释器同一口径）。
    let ct = _cur(p, pos)
    if ct.k == T_PUNCT && (ct.n == P_PLUSEQ || ct.n == P_MINUSEQ ||
                           ct.n == P_STAREQ || ct.n == P_SLASHEQ ||
                           ct.n == P_PERCENTEQ) {
        let cop = ct.n
        _adv(pos)
        let rhs0 = _expr(p, pos)
        let mut bop = P_PLUS
        if cop == P_MINUSEQ { bop = P_MINUS }
        if cop == P_STAREQ { bop = P_STAR }
        if cop == P_SLASHEQ { bop = P_SLASH }
        if cop == P_PERCENTEQ { bop = P_PERCENT }
        let bin = _node(p, E_BIN, bop, v, rhs0)
        let lv0 = p.nodes.get(v)
        if lv0.op == E_VAR {
            return _node(p, S_ASSIGN, lv0.a, bin, -1)
        }
        if lv0.op == E_FIELD {
            return _node(p, S_ASG_FIELD, lv0.a, lv0.b, bin)
        }
        if lv0.op == E_INDEX {
            return _node(p, S_ASG_INDEX, lv0.a, lv0.b, bin)
        }
        _fail(p, pos, "复合赋值的左边不是变量 / 字段 / 下标")
    }
    if _is_p(p, pos, P_ASSIGN) {
        _adv(pos)
        let rhs = _expr(p, pos)
        let lv = p.nodes.get(v)
        if lv.op == E_VAR {
            return _node(p, S_ASSIGN, lv.a, rhs, -1)
        }
        if lv.op == E_FIELD {
            return _node(p, S_ASG_FIELD, lv.a, lv.b, rhs)
        }
        if lv.op == E_INDEX {
            return _node(p, S_ASG_INDEX, lv.a, lv.b, rhs)
        }
        _fail(p, pos, "赋值左边不是变量 / 字段 / 下标")
    }
    return _node(p, S_EXPR, v, -1, -1)
}

/// 块：解析成一条 nx 链，返回链头（空块返回 -1）
fn _block(p: P, pos: vec[int]) -> int {
    _eat_p(p, pos, P_LBRACE)
    let mut head = -1
    let mut prev = -1
    while !_is_p(p, pos, P_RBRACE) {
        if _cur(p, pos).k == T_EOF {
            _fail(p, pos, "块未闭合")
        }
        let id = _stmt(p, pos)
        if head < 0 {
            head = id
        } else {
            let pn = p.nodes[prev]
            p.nodes.set(prev, Node { op: pn.op, a: pn.a, b: pn.b, c: pn.c,
                                     n: pn.n, slot: pn.slot, ty: pn.ty, nx: id })
        }
        prev = id
    }
    _eat_p(p, pos, P_RBRACE)
    return head
}

fn _fn(p: P, pos: vec[int], ffi_idx: int) {
    _adv(pos)                                // fn
    let nm = _cur(p, pos)
    if nm.k != T_NAME {
        _fail(p, pos, "fn 后期望函数名")
    }
    _adv(pos)
    let nid = _name_id(p, nm.s)
    _eat_p(p, pos, P_LPAREN)
    // 形参表：每条形参追加一条 E_FPARAM 记录（a=名字 id，b=类型），
    // Fn.pbase 记住基址。**不再限 4 个**——第 5 个起走栈（v2.29）。
    let pbase = len(p.nodes)
    let mut np = 0
    while !_is_p(p, pos, P_RPAREN) {
        let pn = _cur(p, pos)
        if pn.k != T_NAME {
            _fail(p, pos, "形参期望名字")
        }
        _adv(pos)
        let mut pt = TY_INT
        if _is_p(p, pos, P_COLON) {
            _adv(pos)
            pt = _type(p, pos)          // 支持 int/bool/str/struct/enum/[N]T
        }
        _node(p, E_FPARAM, _name_id(p, pn.s), pt, -1)
        np = np + 1
        if _is_p(p, pos, P_COMMA) {
            _adv(pos)
        }
    }
    _eat_p(p, pos, P_RPAREN)
    let mut rt = TY_VOID
    if _is_p(p, pos, P_ARROW) {
        _adv(pos)
        rt = _type(p, pos)
    }
    let mut fi = 0
    while fi < len(p.fns) {
        if p.fns.get(fi).name == nid {
            _fail(p, pos, "函数重复定义 " + nm.s)
        }
        fi = fi + 1
    }
    let mut body = -1
    let mut nbody = 0
    if ffi_idx < 0 {
        body = _block(p, pos)
        nbody = 0
    }
    p.fns.push(Fn { name: nid, np: np, pbase: pbase, ret_t: rt,
                    body: body, nbody: 0, nlocals: ffi_idx })
}

/// 顶层：`module x` 忽略；`import` 本版不支持；`fn` 逐个解析。
fn parse(toks: vec[Tok], nodes: vec[Node], names: vec[str], strs: vec[str],
         fns: vec[Fn], cname: vec[int], cval: vec[int], stt: vec[int],
         imports: vec[str], fdll: vec[str], fsym: vec[str]) -> int {
    let p = P { toks: toks, nodes: nodes, names: names, strs: strs, fns: fns,
                cname: cname, cval: cval, stt: stt, fdll: fdll, fsym: fsym }
    let pos = vec[int].new(1)
    pos.push(0)
    while _cur(p, pos).k != T_EOF {
        let t = _cur(p, pos)
        if t.k == T_NAME && t.s == "pub" {
            _adv(pos)          // 本版不做可见性检查，pub 当无操作
            continue
        }
        if t.k == T_KW && t.n == K_MODULE {
            while _cur(p, pos).k != T_EOF && _cur(p, pos).line == t.line {
                _adv(pos)
            }
            continue
        }
        if t.k == T_KW && t.n == K_IMPORT {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "import 后期望模块名")
            }
            _adv(pos)
            let mut path = nm.s
            while _is_p(p, pos, P_DOT) {
                _adv(pos)
                let seg = _cur(p, pos)
                if seg.k != T_NAME {
                    _fail(p, pos, "import 路径期望标识符")
                }
                _adv(pos)
                path = path + "/" + seg.s
            }
            // 版本要求（`import foo ">=1.2"`）暂不校验，跳过
            if _cur(p, pos).k == T_STR {
                _adv(pos)
            }
            imports.push(path)
            continue
        }
        if t.k == T_KW && t.n == K_STRUCT {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "struct 后期望名字")
            }
            _adv(pos)
            let nid = _name_id(p, nm.s)
            if _struct_index(p, nid) >= 0 {
                _fail(p, pos, "struct 重复声明 " + nm.s)
            }
            let nst = p.stt.get(0)
            // 先把表扩到 nst+1 个槽位
            let mut k = 0
            while k < ST_STRIDE {
                p.stt.push(0)
                k = k + 1
            }
            p.stt.set(0, nst + 1)
            p.stt.set(_st_base(nst), nid)
            _eat_p(p, pos, P_LBRACE)
            let mut nf = 0
            while !_is_p(p, pos, P_RBRACE) {
                let fnm = _cur(p, pos)
                if fnm.k != T_NAME {
                    _fail(p, pos, "struct 字段名期望标识符")
                }
                _adv(pos)
                _eat_p(p, pos, P_COLON)
                let fty = _type(p, pos)
                // 字段必须是**标量**（8 字节）：int/bool/str + vec/map 句柄都行，
                // 聚合字段（struct/enum/数组/切片/闭包）还没有递归布局。
                // 之前按 `fty >= TY_STRUCT` 拦，把 vec 句柄也误伤了——
                // 而 qlmc 自己的 `struct P { toks: vec[Tok] ... }` 正是这个形状（v2.31）。
                // f64 例外：它按"聚合"传值（住在槽里），但布局就是一个 8 字节字，
                // 当字段完全没问题（v2.38）。
                if _ty_is_agg(fty) && fty != TY_F64 {
                    _fail(p, pos, "本版 struct 字段不支持聚合类型（struct/enum/数组/切片/闭包）")
                }
                if nf >= MAX_FIELD {
                    _fail(p, pos, "struct 字段超过上限（MAX_FIELD）")
                }
                p.stt.set(_st_base(nst) + 2 + nf * 2, _name_id(p, fnm.s))
                p.stt.set(_st_base(nst) + 2 + nf * 2 + 1, fty)
                nf = nf + 1
                if _is_p(p, pos, P_COMMA) {
                    _adv(pos)
                }
            }
            _eat_p(p, pos, P_RBRACE)
            p.stt.set(_st_base(nst) + 1, nf)
            continue
        }
        if t.k == T_KW && t.n == K_ENUM {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "enum 后期望名字")
            }
            _adv(pos)
            let nid = _name_id(p, nm.s)
            if _enum_index(p, nid) >= 0 {
                _fail(p, pos, "enum 重复声明 " + nm.s)
            }
            if p.stt.get(EN_HDR) >= 64 {
                _fail(p, pos, "enum 超过 64 个")
            }
            let ei = p.stt.get(EN_HDR)
            p.stt.set(EN_HDR, ei + 1)
            let base = _en_base(ei)
            p.stt.set(base, nid)
            _eat_p(p, pos, P_LBRACE)
            let mut nv = 0
            while !_is_p(p, pos, P_RBRACE) {
                let vn = _cur(p, pos)
                if vn.k != T_NAME {
                    _fail(p, pos, "enum 变体名期望标识符")
                }
                _adv(pos)
                if nv >= MAX_VARIANT {
                    _fail(p, pos, "enum 变体超过 8 个")
                }
                let vbase = base + 2 + nv * 3
                p.stt.set(vbase, _name_id(p, vn.s))
                p.stt.set(vbase + 1, -1)
                p.stt.set(vbase + 2, -1)
                if _is_p(p, pos, P_LPAREN) {
                    _adv(pos)
                    let pn = _cur(p, pos)
                    if pn.k != T_NAME {
                        _fail(p, pos, "载荷字段名期望标识符")
                    }
                    _adv(pos)
                    _eat_p(p, pos, P_COLON)
                    let pt = _type(p, pos)
                    if pt >= TY_STRUCT {
                        _fail(p, pos, "本版 enum 载荷只支持 int/bool/str")
                    }
                    p.stt.set(vbase + 1, _name_id(p, pn.s))
                    p.stt.set(vbase + 2, pt)
                    _eat_p(p, pos, P_RPAREN)
                }
                nv = nv + 1
                if _is_p(p, pos, P_COMMA) {
                    _adv(pos)
                }
            }
            _eat_p(p, pos, P_RBRACE)
            p.stt.set(base + 1, nv)
            continue
        }
        if t.k == T_KW && t.n == K_FN {
            _fn(p, pos, -1)
            continue
        }
        if t.k == T_PUNCT && t.n == P_AT {
            _adv(pos)
            let kw = _cur(p, pos)
            if kw.k != T_NAME || kw.s != "ffi" {
                _fail(p, pos, "只支持 @ffi(\"dll\", \"Sym\")")
            }
            _adv(pos)
            _eat_p(p, pos, P_LPAREN)
            let ds = _cur(p, pos)
            if ds.k != T_STR {
                _fail(p, pos, "@ffi 第一个实参是 DLL 名字符串")
            }
            _adv(pos)
            _eat_p(p, pos, P_COMMA)
            let ss = _cur(p, pos)
            if ss.k != T_STR {
                _fail(p, pos, "@ffi 第二个实参是符号名字符串")
            }
            _adv(pos)
            _eat_p(p, pos, P_RPAREN)
            if !(_cur(p, pos).k == T_KW && _cur(p, pos).n == K_FN) {
                _fail(p, pos, "@ffi 后面必须紧跟 fn 声明")
            }
            let idx = len(p.fdll)
            p.fdll.push(ds.s)
            p.fsym.push(ss.s)
            _fn(p, pos, idx)
            continue
        }
        if t.k == T_KW && t.n == K_CONST {
            _adv(pos)
            let nm = _cur(p, pos)
            if nm.k != T_NAME {
                _fail(p, pos, "const 后期望名字")
            }
            _adv(pos)
            if _is_p(p, pos, P_COLON) {
                _adv(pos)
                _adv(pos)                    // 类型标注（只允许整型）
            }
            _eat_p(p, pos, P_ASSIGN)
            // 初值可以是**常量表达式**（v2.30）：先用正常表达式解析（优先级自然
            // 与语言一致），再用 `_fold` 在解析期折成一个整数；折不动的 fail-fast。
            let e = _expr(p, pos)
            let cv = _fold(p, pos, e)
            if _is_p(p, pos, P_SEMI) {
                _adv(pos)
            }
            p.cname.push(_name_id(p, nm.s))
            p.cval.push(cv)
            continue
        }
        _fail(p, pos, "顶层期望 fn / const / struct")
    }
    return len(p.fns)
}

// ---------------------------------------------------------------------------
// IR
//
// 本版不落显式 IR 表：`gen_*` 直接从 AST 发字节。为什么——S1 的表达式没有
// 需要重排的优化（没有 CSE/调度/内联），三地址 IR 只是多一层搬运；等做
// 常量折叠与寄存器分配时再引入（`07-gaps.md` §3 记了这条）。
// **等价于 IR 的抽象在这里**：每个表达式的值在 RAX，二元运算的右操作数先
// 落帧槽（`scratch`），左操作数算完再 `mov rcx, [scratch]` —— 这就是
// "全溢出 + RAX/RCX 双累加器"的分配策略。
// ---------------------------------------------------------------------------

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
// v2.55：XMM 寄存器编号（SSE 指令的 modrm/REX 用同一套 0..15）
const XMM0 = 0
const XMM1 = 1
const XMM2 = 2
const XMM3 = 3
// XMM4/XMM5 既不在临时池（XMM0-3）也不在变量池（XMM6-15）→ **恒空闲**，
// 用来当"不会与任何值撞车"的专用临时（别名处理、比较的左操作数）。
const XMM_SCR = 4

// PE 常量（与 qlm_pe.py 同源，改一处必须改另一处）
const IMAGE_BASE = 0x140000000
const TEXT_RVA = 0x1000
const SECT_ALIGN = 0x1000
const FILE_ALIGN = 0x200
const HDR_DOS = 0x80
const OPT_SIZE = 240
const SCN_CODE = 0x60000020
const SCN_RDATA = 0xC0000040

// 导入符号（顺序 = IAT 槽顺序，别乱动）
const I_GETSTD = 0
const I_WRITE = 1
const I_EXIT = 2
const I_WSPRINTF = 3
// v2.32 spawn/join 要用的三个 kernel32 符号（线程）
const I_CREATE = 4
const I_WAIT = 5
const I_CLOSE = 6
// v2.33：file_exists / now_ns 要用的三个
const I_FILEATTR = 7
const I_QPC = 8
const I_QPF = 9
// v2.38：f64 字面量解析用 msvcrt 的 strtod（正确舍入，与 stage-0 的 Python 解析一致）
const I_STRTOD = 10
// v2.76：堆从 .bss 改成 VirtualAlloc 私有页（首次触碰 5.5 µs/页 → 1 µs/页）
const I_VALLOC = 11
// v3.42：网络内建要用的 ws2_32 符号（8 个）。
// 为什么不走用户 @ffi 通道：内建是**编译器发射**的，没有对应的 fn 记录
// 可以承载 nlocals 槽号；直接给它们固定的内置槽更简单，也让
// 哪些网络符号被内建依赖一目了然。
const I_WSASTART = 12
const I_SOCKET = 13
const I_BIND = 14
const I_LISTEN = 15
const I_ACCEPT = 16
const I_SEND = 17
const I_RECV = 18
const I_CLOSESOCK = 19
const I_USER = 20       // 用户 @ffi 符号从第 20 个 IAT 槽开始

// ---------------------------------------------------------------------------
// 字节发射
// ---------------------------------------------------------------------------

fn _b(code: vec[int], v: int) {
    code.push(v & 0xFF)
}

fn _w32(code: vec[int], v: int) {
    _b(code, v)
    _b(code, v >> 8)
    _b(code, v >> 16)
    _b(code, v >> 24)
}

fn _w64(code: vec[int], v: int) {
    _w32(code, v)
    _w32(code, v >> 32)
}

fn _rex(code: vec[int], w: int, r: int, b: int) {
    _b(code, 0x40 | (w << 3) | (r << 2) | b)
}

// REX.W + REX.R(reg) + REX.B(rm) 组合：reg/rm 是 0-15
fn _rex2(code: vec[int], w: int, reg: int, rm: int) {
    let r = 0
    if reg >= 8 {
        r = 1
    }
    let b = 0
    if rm >= 8 {
        b = 1
    }
    _rex(code, w, r, b)
}

fn _modrm(code: vec[int], mod: int, reg: int, rm: int) {
    _b(code, (mod << 6) | ((reg & 7) << 3) | (rm & 7))
}

// ---- v2.55：SSE 指令编码（f64 值住 XMM 之后要用） ----
//
// 前缀顺序是 **强制前缀(66/F2) → REX → 0F → opcode → modrm**。REX 放在 0F 前面，
// 放后面就是另一条指令（坑表 #49 的同类）。
//
// `pf`：0 = 66（ucomisd 这类），1 = F2（标量 double 的 movsd/addsd/...）。

/// reg-reg 形式：`<pf> REX 0F opc /r`（mod=11）
fn _sse_rr(code: vec[int], pf: int, opc: int, x: int, y: int) {
    if pf == 0 {
        _b(code, 0x66)
    } else {
        _b(code, 0xF2)
    }
    _rex2(code, 0, x, y)
    _b(code, 0x0F)
    _b(code, opc)
    _modrm(code, 3, x, y)
}

/// `[base+disp32]` 形式（base 必须是 RBP 这类"必须带 disp"的寄存器）
fn _sse_mem(code: vec[int], pf: int, opc: int, x: int, base: int, disp: int) {
    if pf == 0 {
        _b(code, 0x66)
    } else {
        _b(code, 0xF2)
    }
    _rex2(code, 0, x, base)
    _b(code, 0x0F)
    _b(code, opc)
    _modrm(code, 2, x, base)
    _w32(code, disp)
}

/// `[base]` 形式（mod=00，base 不能是 RBP/R13，我们用 RAX/RCX）
fn _sse_mem0(code: vec[int], pf: int, opc: int, x: int, base: int) {
    if pf == 0 {
        _b(code, 0x66)
    } else {
        _b(code, 0xF2)
    }
    _rex2(code, 0, x, base)
    _b(code, 0x0F)
    _b(code, opc)
    _modrm(code, 0, x, base)
}

/// `movaps xmm, xmm`（0F 28 /r）—— **整 128 位搬，不用 `movsd`**。
///
/// 这是 v2.55 在 CI 上踩到的性能坑：`movsd xmm0, xmm2` 只写低 64 位，
/// **对目标寄存器的旧值有假依赖**（部分寄存器写）。于是
/// `movsd xmm0,xmm2; divsd xmm0,xmm1` 里的 `divsd` 必须等**上一轮**的
/// `divsd` 写完 xmm0 才能开始 —— 除法被串行化，实测 15 周期/轮（C 只要 4）。
/// `movaps` 写整个寄存器，重命名器可以直接断掉这条链。
/// 上 64 位我们从来不读，搬过去无所谓。
fn _sse_mov_reg(code: vec[int], d: int, s: int) {
    if d == s {
        return
    }
    _rex2(code, 0, d, s)
    _b(code, 0x0F)
    _b(code, 0x28)
    _modrm(code, 3, d, s)
}

/// `movq xmm, r64`（66 REX.W 0F 6E /r）
fn _movq_x_from_r(code: vec[int], x: int, r: int) {
    _b(code, 0x66)
    _rex2(code, 1, x, r)
    _b(code, 0x0F)
    _b(code, 0x6E)
    _modrm(code, 3, x, r)
}

/// `movq r64, xmm`（66 REX.W 0F 7E /r）
fn _movq_r_from_x(code: vec[int], r: int, x: int) {
    _b(code, 0x66)
    _rex2(code, 1, x, r)
    _b(code, 0x0F)
    _b(code, 0x7E)
    _modrm(code, 3, x, r)
}

// mov dst, imm64
/// `mov dst, imm`（v2.44：按值选最短编码）。
///
/// 原来恒定发 `movabs reg, imm64`（10 字节）。实测 qlmc 编自己时 9 317 个
/// movabs 里 **3 159 个是 0、6 117 个在 imm32 内、只有 41 个真需要 64 位** ——
/// 也就是 99.6% 的立即数白付了 4~7 个字节。现在三档：
///   [0, 2^32)        → `mov r32, imm32`（5 字节，r8-r15 多一个 REX.B）
///   [-2^31, 0)       → `REX.W C7 /0 imm32` 符号扩展（7 字节）
///   其余             → `movabs`（10 字节）
fn _mov_imm(code: vec[int], dst: int, v: int) {
    if v >= 0 && v <= 4294967295 {
        if dst >= 8 {
            _b(code, 0x41)                     // REX.B
        }
        _b(code, 0xB8 + (dst & 7))
        _w32(code, v)
        return
    }
    if v < 0 && v >= -2147483648 {
        _rex2(code, 1, 0, dst)                 // REX.W
        _b(code, 0xC7)
        _modrm(code, 3, 0, dst)
        _w32(code, v)
        return
    }
    _rex2(code, 1, 0, dst)
    _b(code, 0xB8 + (dst & 7))
    _w64(code, v)
}

/// `mov qword [base+disp], imm`（v2.44：能直接写内存就别先搬进 rax）。
/// imm32 符号扩展的一档是 8 字节；超出就退回"先 movabs 到 rax 再存"。
fn _mov_imm_mem(code: vec[int], base: int, disp: int, v: int) {
    if v >= -2147483648 && v <= 2147483647 {
        _rex2(code, 1, 0, base)                // REX.W，扩展位在 rm
        _b(code, 0xC7)
        _modrm_mem(code, 2, 0, base)
        _w32(code, disp)
        _w32(code, v)
        return
    }
    _mov_imm(code, RAX, v)
    _mov_store(code, base, disp, RAX)
}

// mov dst, src（寄存器到寄存器）
fn _mov_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, 0x89)
    _modrm(code, 3, src, dst)
}

// mov dst, [base+disp32]
fn _mov_load(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm_mem(code, 2, dst, base)
    _w32(code, disp)
}

// mov r32, [base+disp32]（v3.36：32 位加载，写入 32 位寄存器即**零扩展**）
// 与 _mov_load 的区别只有 REX.W：不带 W 时 mov eax, [mem] 会把高 32 位清零。
fn _mov_load32(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 0, dst, base)
    _b(code, 0x8B)
    _modrm_mem(code, 2, dst, base)
    _w32(code, disp)
}

// mov [base+disp32], src
fn _mov_store(code: vec[int], base: int, disp: int, src: int) {
    _rex2(code, 1, src, base)
    _b(code, 0x89)
    _modrm_mem(code, 2, src, base)
    _w32(code, disp)
}

/// `mov [rsp + disp], src`——RSP 作基址必须带 SIB 字节（不能用 _mov_store）
fn _mov_store_rsp(code: vec[int], disp: int, src: int) {
    _rex2(code, 1, src, RSP)
    _b(code, 0x89)
    _modrm_sib(code, 2, src)
    _w32(code, disp)
}

// [rsp+disp32] 的 modrm 带 SIB
fn _modrm_sib(code: vec[int], mod: int, reg: int) {
    _modrm(code, mod, reg, 4)
    _b(code, 0x24)
}

fn _mov_rsp_store(code: vec[int], disp: int, src: int) {
    _rex2(code, 1, src, 4)
    _b(code, 0x89)
    _modrm_sib(code, 2, src)
    _w32(code, disp)
}

fn _mov_rsp_load(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8B)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

fn _mov_rsp_imm32(code: vec[int], disp: int, v: int) {
    _rex2(code, 1, 0, 4)
    _b(code, 0xC7)
    _modrm_sib(code, 2, 0)
    _w32(code, disp)
    _w32(code, v)
}

fn _lea_rsp(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 4)
    _b(code, 0x8D)
    _modrm_sib(code, 2, dst)
    _w32(code, disp)
}

// lea dst, [rip+disp32]：disp 稍后回填
fn _lea_rip(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, 0)
    _b(code, 0x8D)
    _modrm(code, 0, dst, 5)
    _w32(code, disp)
}

// alu dst, src：opcode 见 add=01 sub=29 and=21 or=09 xor=31 cmp=39
fn _alu_rr(code: vec[int], op: int, dst: int, src: int) {
    _rex2(code, 1, src, dst)
    _b(code, op)
    _modrm(code, 3, src, dst)
}

fn _imul_rr(code: vec[int], dst: int, src: int) {
    _rex2(code, 1, dst, src)
    _b(code, 0x0F)
    _b(code, 0xAF)
    _modrm(code, 3, dst, src)
}

fn _neg(code: vec[int], dst: int) {
    _rex2(code, 1, 0, dst)
    _b(code, 0xF7)
    _modrm(code, 3, 3, dst)
}

fn _cqo(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x99)
}

fn _idiv(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0xF7)
    _modrm(code, 3, 7, reg)
}

fn _test_rr(code: vec[int], a: int, b: int) {
    _rex2(code, 1, b, a)
    _b(code, 0x85)
    _modrm(code, 3, b, a)
}

fn _cmp_imm0(code: vec[int], reg: int) {
    _rex2(code, 1, 0, reg)
    _b(code, 0x83)
    _modrm(code, 3, 7, reg)
    _b(code, 0)
}

// setcc al：cc 见 e=94 ne=95 l=9C ge=9D le=9E g=9F
fn _setcc_al(code: vec[int], cc: int) {
    _b(code, 0x0F)
    _b(code, cc)
    _b(code, 0xC0)
}

fn _movzx_rax_al(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0xB6)
    _b(code, 0xC0)
}

fn _push_rbp(code: vec[int]) {
    _b(code, 0x55)
}

fn _pop_rbp(code: vec[int]) {
    _b(code, 0x5D)
}

fn _mov_rbp_rsp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
}

fn _mov_rsp_rbp(code: vec[int]) {
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xEC)
}

fn _sub_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xEC)
    _w32(code, n)
}

fn _add_rsp(code: vec[int], n: int) {
    _b(code, 0x48)
    _b(code, 0x81)
    _b(code, 0xC4)
    _w32(code, n)
}

fn _ret(code: vec[int]) {
    _b(code, 0xC3)
}

fn _jmp(code: vec[int]) -> int {
    _b(code, 0xE9)
    let p = len(code)
    _w32(code, 0)
    return p
}

// cc：e=84 ne=85 l=8C ge=8D le=8E g=8F
fn _jcc(code: vec[int], cc: int) -> int {
    _b(code, 0x0F)
    _b(code, cc)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _call_rel(code: vec[int]) -> int {
    _b(code, 0xE8)
    let p = len(code)
    _w32(code, 0)
    return p
}

// call [rip+disp32]
fn _call_rip(code: vec[int]) -> int {
    _b(code, 0xFF)
    _b(code, 0x15)
    let p = len(code)
    _w32(code, 0)
    return p
}

fn _patch32(code: vec[int], at: int, v: int) {
    code.set(at, v & 0xFF)
    code.set(at + 1, (v >> 8) & 0xFF)
    code.set(at + 2, (v >> 16) & 0xFF)
    code.set(at + 3, (v >> 24) & 0xFF)
}

fn _align_up(v: int, a: int) -> int {
    return (v + a - 1) / a * a
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 后端（v2.16 重写）
//
// 流水线（与 v2.15 的"直接从 AST 发字节"完全不同）：
//
//   AST ──lower──▶ IR ──线性扫描──▶ 带位置的 IR ──emit──▶ 机器码
//
// 三条设计决定，改之前先读：
//
// 1) **有真 IR**。三地址指令（`Ir`），值用虚拟寄存器编号，标签用 id。
//    好处不是"更漂亮"，而是分配与发射解耦：分配只看活跃区间，发射只看位置，
//    谁也不认识 AST。v2.15 里"右操作数先落帧槽"这种形状是被 RAX/RCX 双累加器
//    逼出来的，现在没有了。
//
// 2) **两段式寄存器分配**（不是全溢出）：
//      · 变量（`let` / 形参）：函数内**固定**一个 callee-saved 寄存器
//        （RBX / R12-R15），满了落帧槽。固定分配天然跨循环、跨调用成立，
//        不需要 SSA 与 phi。
//      · 临时值（表达式中间结果）：按活跃区间做**线性扫描**，池是
//        R8/R9/R10/R11（都是 caller-saved）。区间**跨调用**的临时值直接落
//        帧槽——因为调用会清 caller-saved，这样就不必在调用点插溢出代码。
//    发射序列自己只用 RAX/RCX/RDX 当暂存，永不被分配，所以不存在"分配器
//    挑了一个发射器要用的寄存器"这类隐蔽冲突。
//
// 3) **按函数并行**（`_compile_range`）。每个工作线程拿到 arb 里自己那段，
//    把函数编成字节写进去，主线程按函数序拼装 + 统一回填。函数之间没有共享
//    可变状态，所以不需要任何锁；拼装顺序固定，所以**线程数不影响产物字节**
//    （`-j1` 与 `-j4` 的 exe 逐字节相同，测试钉住这条）。
// ---------------------------------------------------------------------------

// IR 操作码
const OP_CONST = 1     // dst = imm
const OP_MOV = 2       // dst = a
const OP_ADD = 3       // dst = a + b
const OP_SUB = 4
const OP_MUL = 5
const OP_DIV = 6
const OP_MOD = 7
const OP_NEG = 8       // dst = -a
const OP_NOT = 9       // dst = (a == 0) ? 1 : 0（int 口径）
const OP_NZ = 10       // dst = (a != 0) ? 1 : 0
const OP_CMP = 11      // dst = a <cc> b ? 1 : 0；imm = cc（setcc 机器码）
const DBG_MODIND = 0
const OP_LAB = 12      // imm = 标签
const OP_JMP = 13      // goto imm
const OP_JZ = 14       // if a == 0 goto imm
const OP_JNZ = 15      // if a != 0 goto imm
const OP_ARG = 16      // 把 a 搬到第 imm 个实参寄存器（0=RCX 1=RDX）
const OP_CALL = 17     // dst = call 函数 imm
const OP_CALLRT = 18   // dst = call 运行库例程 imm
const OP_RET = 19      // return a（a == 0 → return 0）
const OP_PRINT = 20    // print a；imm = TY_*
const OP_EXIT = 21     // exit(a)
const OP_LEA = 22      // dst = 字符串 imm 的地址（rip 相对）
const OP_LEN = 23      // dst = [a - 8]（str 长度前缀）
const OP_PARAM = 24    // dst = 第 imm 个入参寄存器（0=RCX 1=RDX 2=R8 3=R9）
const OP_JCMP = 25     // cmp a, b；按 dst(=cc) 跳到 imm
const OP_ADDRV = 26    // dst = &帧槽 imm（聚合变量的区域基址）
const OP_ADDRF = 27    // dst = a + imm（字段地址）
const OP_ADDRX = 28    // dst = a + b*8（数组元素地址）
const OP_LOAD = 29     // dst = [a]
const OP_STORE = 30    // [a] = b
const OP_COPY = 31     // memcpy(a, b, imm)
const OP_ZERO = 32     // zero(a, imm)
const OP_RETAGG = 33   // 聚合返回：memcpy([sret], a, imm)；rax = sret
const OP_RETSRET = 34  // 兜底返回：只把 rax = sret
const OP_ZERON = 35    // zero(a, b)：按 b 给的**字节数**清零（动态长度）
const OP_CALLIAT = 36  // dst = call [rip+iat[imm]]（@ffi）
const OP_LEAFN = 37    // dst = &函数 imm（取函数地址，给闭包用）
const OP_CALLR = 38    // dst = call [a]（a = 闭包值地址，间接调用）
// memcpy(a, b, dst)：**运行时**字节数版本。Ir 只有 4 个操作数槽，只好把
// 字节数塞进 dst（dst 这个字段对 memcpy 没有别的含义）。vec 扩容要用。
const OP_MEMCPYN = 39
// 位运算与移位（v2.28）
const OP_AND = 40      // dst = a & b
const OP_OR = 41       // dst = a | b
const OP_XOR = 42      // dst = a ^ b
const OP_SHL = 43      // dst = a << b
const OP_SAR = 44      // dst = a >> b（算术右移，符号位扩展）
const OP_SHR = 45      // dst = a >>> b（逻辑右移，高位补 0）
const OP_BNOT = 46     // dst = ~a
// 栈参数（v2.29）：第 5 个起走栈
const OP_PARAMSTK = 47 // dst = [rbp + imm]（被调方取栈上的形参）
const OP_STKALLOC = 48 // sub rsp, imm（调用点开 shadow space + 栈实参）
const OP_STKARG = 49   // [rsp + imm] = a（写栈实参）
const OP_STKFREE = 50  // add rsp, imm
// dst = a + b*imm（imm = 元素字节步长）。vec 元素是聚合时步长不是 8，
// OP_ADDRX 的 `shl 3` 就不够用了（v2.31）。
const OP_ADDRXN = 51
// dst = &运行库例程 imm（FK_RT）。spawn 要把线程入口地址交给 CreateThread
const OP_RTADDR = 52
// 单字节访存（v2.33）：mem_load8 / mem_store8 / chr / mem_str 的收尾要用
const OP_LOAD8 = 53     // dst = 零扩展的 [a] 低字节
const OP_STORE8 = 54    // [a] = b 的低字节
// f64 比较（v2.38）：dst(int) = (a <cc> b)，a/b 都是 f64 槽的地址，imm = setcc 操作码
const OP_FCMP = 55
// v2.46 强度削减与立即数：优化层把「二元运算 + 常量临时值」压成一条带立即数的指令。
// `b` 槽放**子操作码**（OP_ADD/OP_SUB/OP_MUL/OP_AND/OP_OR/OP_XOR/OP_SHL/OP_SAR/OP_SHR），
// `imm` 放常量值。注意 `b` 因此**不是 vreg** —— `_opt_mark` 里要跳过它。
const OP_BINI = 57     // dst = a <sub> imm
const OP_CMPI = 58     // dst = (a <cc>) ? 1 : 0；b = cc，imm = 常量
// v2.46 地址计算与访存融合：`ADDRF/ADDRX` + `LOAD/STORE` 压成一条带位移/SIB 的访存。
// `vec.get(i)` / `s[i]` 原来要 6 条指令算地址，融合后 0 条 —— 这是 b4/b7/b9 那
// 3~7 倍差距的主因。
// **注意 STORE* 系列把"值"放在 dst 槽**（它们不写寄存器），所以 `_opt_writes`
// 对这四个返回 0、`_opt_mark` 要把 dst 记成"被读"。
const OP_LOADD = 59    // dst = [a + imm]
const OP_LOADX = 60    // dst = [a + b*8]
const OP_STORED = 61   // [a + imm] = dst
const OP_STOREX = 62   // [a + b*8] = dst
const OP_LOAD8D = 63   // dst = 零扩展 [a + imm] 的低字节
const OP_LOAD8X = 64   // dst = 零扩展 [a + b*8] 的低字节
const OP_STORE8D = 65  // [a + imm] = dst 的低字节
const OP_STORE8X = 66  // [a + b*8] = dst 的低字节
// v2.47：f64 二元运算内联。`dst`/`a`/`b` 都是 f64 槽的**地址**，`imm` 选子操作
// （0=add 1=sub 2=mul 3=div）。以前是 `ADDRV + 3×ARG + CALLRT(__fadd)` ——
// 一次调用 + 运行库里 6 条指令；现在是 3 条 SSE 指令。f64 仍然住在帧槽里
// （设计没变），只是去掉了调用开销。
// **注意 `dst` 是被读的**（它是要写入的地址），所以 `_opt_writes` 要返回 0、
// `_opt_mark` 要把 dst 记成"被读"—— 否则 DCE 会把算地址的那条删掉。
const OP_FBIN = 67     // [dst] = [a] <op> [b]
// v2.47：f64 <-> int 转换内联（cvtsi2sd / cvttsd2si），去掉运行库调用。
const OP_ITOF = 68     // [dst] = (f64)a          dst 是 f64 槽地址
const OP_FTOI = 69     // dst = (int)[a]          a 是 f64 槽地址，向零截断
// v2.48：常数除法魔数乘法。`a` = 被除数，`b` = 子操作（OP_DIV / OP_MOD），`imm` = 除数。
// **除数限制 2..2^31-1**（再大 `2^s*r64` 会溢出 int64，那种情况退回 idiv）。
// 算法：无符号魔数 + 显式符号分离（见 _gen_divc 的注释，可证明正确）。
const OP_DIVC = 70     // dst = a <div|mod> imm
// v2.49：字符串下标 `s[p]` 的地址计算（`OP_ADD str,int`）与字节访存融合。
// SIB 的 scale 用 0（×1）。以前是 `mov r9,str; add r9,p; mov rax,r9; movzx r10,[rax]`
// 四条，现在一条 `movzx r10, [str + p]`。
const OP_LOAD8I = 71   // dst = 零扩展 [a + b]
const OP_STORE8I = 72  // [a + b] = dst 的低字节
// v2.53：越界检查里的"取长度 + 比较"合成一条 `cmp r64, [base±8]`。
// 以前是 `mov d, [h+8]` + `cmp a, d` 两条；现在一条。`dst` = jcc 码、
// `a` = 左操作数、`b` = 句柄/字符串、`imm` = 目标标签。
const OP_JCMPVLEN = 73 // cmp a, [b+8]; jcc → imm（vec 头块的长度在 +8）
const OP_JCMPSTR = 74  // cmp a, [b-8]; jcc → imm（str 的长度在 -8）

// ---- v2.55：f64 变成**标量**（8 字节 IEEE 位模式），值住 XMM 寄存器 ----
//
// 以前 f64 按"聚合"处理：变量是帧槽、值 = 槽地址、赋值走 `call __memcpy`。
// b2_float 的主循环因此是 **52 条指令**（含一次 memcpy 调用），C 只要 6 条。
//
// 现在 f64 就是"8 字节标量"，与 int 同构，只是**位置**多一种：XMM 寄存器。
// `vloc` 的编码：
//     loc >= XLOC        → XMM，编号 = loc - XLOC
//     0 < loc < XLOC     → 通用寄存器，编号 = loc - 1
//     loc < 0            → 帧槽，槽号 = -loc - 1
// XMM0-XMM5 在 Win64 里是**易失**的（只给临时值用），XMM6-XMM15 非易失（给变量）。
const XLOC = 64           // vloc >= XLOC → XMM
const XMM_VAR0 = 6        // 变量寄存器池：XMM6..XMM15
const N_XMMVAR = 10
const XMM_TMP0 = 0        // 临时值池：XMM0..XMM3（易失）
const OP_FNEG = 75        // dst(f64) = -a（翻符号位，内联；以前是 CALLRT）
// v2.56：编译期算好的 f64 字面量位模式（imm = 8 字节 IEEE）。以前字面量要
// "开槽 + 标志位 + 每轮一次带分支的 strtod 守卫"，在循环体里是 14 条指令。
const OP_F64IMM = 76      // dst(f64) = imm 的位模式
// v2.57：条件跳转的立即数形式。`cmp r64, imm32` 一条顶"装载常量 + 比较"两条。
// dst = jcc 码、a = 左操作数、b = 常量、imm = 目标标签。
const OP_JCMPI = 77
const OP_BSSADDR = 78  // dst = &bss[imm]（lea rip + FK_BSS 重定位）

struct Ir {
    op: int
    dst: int
    a: int
    b: int
    imm: int
}

struct Fix {
    pos: int        // 待回填的 disp32 位置（函数内相对偏移）
    id: int         // 目标 id（函数 / 标签 / 字符串 / 导入符号 / bss / 运行库）
    kind: int
}

const FK_FN = 0
const FK_LAB = 1
const FK_STR = 2
const FK_IAT = 3
const FK_BSS = 4
const FK_RT = 5

// 顺序段（入口 + 运行库 + 字符串表）用的上下文。
// 函数体不走这里——它由工作线程各自的 `FnCtx` 承担。
struct Ctx {
    code: vec[int]
    labs: vec[int]
    fixes: vec[Fix]
    nodes: vec[Node]
    names: vec[str]
    strs: vec[str]
    fns: vec[Fn]
    fnpos: vec[int]
    rdata: vec[int]
    strpos: vec[int]
    str_true: int
    str_false: int
    nl: vec[int]
    rt_pos: vec[int]
    fdll: vec[str]      // @ffi 的 DLL 名（与 fsym 平行）
    fsym: vec[str]      // @ffi 的符号名
    is_lib: int         // v3.37：1 = 编库（不要求 main、不发入口）
}

// 单个函数的编译状态。结构体按值传，**标量字段改了不会回传**，
// 所以计数器一律放单元素 vec（`st` / `nv` / `ep`）。
struct FnCtx {
    code: vec[int]
    labs: vec[int]
    fixes: vec[Fix]
    ir: vec[Ir]
    nodes: vec[Node]
    names: vec[str]
    fns: vec[Fn]
    vloc: vec[int]      // vreg → 位置：>0 = 寄存器+1，<0 = -(槽号+1)，0 = 未分配
    vty: vec[int]       // vreg → TY_*
    vstart: vec[int]    // vreg → 起始 IR 下标
    vend: vec[int]      // vreg → 最后使用 IR 下标
    vpin: vec[int]      // 1 = 变量（位置固定），0 = 临时值
    vmap: vec[int]      // 名字 id（与 vval 平行）
    vval: vec[int]      // 名字 → vreg
    cells: vec[int]     // 计数器组：C_ST / C_NV / C_EP / C_LD / C_BD / C_ADDRTY
    rt: vec[int]        // 运行库例程位置（顺序段填好后共享）
    stt: vec[int]       // struct 表（只读，跨线程共享）
    df: vec[int]        // defer 栈：登记的被延迟语句节点
    bind: vec[int]      // 臂内绑定栈：(名字 id, vreg) 成对
    loops: vec[int]     // 循环栈：(continue 标签, break 标签) 成对
    cp: vec[int]        // 复用缓冲：调用前缀和
    rend: vec[int]      // 复用缓冲：寄存器占用到的指令
    send: vec[int]      // 复用缓冲：临时槽占用到的指令
}

const C_ST = 0
const C_NV = 1
const C_EP = 2
const C_LD = 3
const C_BD = 4
const C_ADDRTY = 5
const C_SRET = 6        // 聚合返回的隐藏指针（vreg）
const C_DEF = 7         // defer 栈深度
// v2.29：本函数 push 了几个 callee-saved（发射期才知道）。栈形参的偏移要用它：
// 序言是「先 push callee-saved，最后 push rbp」，所以返回地址在
// [rbp + 8 + 8*nsaved]，而不是 [rbp+8]——这个坑让第一版栈形参全读成垃圾。
const C_NSAVED = 8
// 当前正在降级的函数下标（v2.33：帧槽/寄存器耗尽的报错要说是哪个函数）
const C_CFI = 9
// v2.47：f64 字面量的"只解析一次"缓存与标志槽。`cells` 是普通 vec，可以往后长。
//   [10]                = 标志槽个数 nf，标志槽号放在 [11 .. 11+nf)
//   [50]                = 缓存条数 nc，每条占两格（串 id, 地址 vreg）在 [51 .. 51+2*nc)
// 上限 32 条：一个函数里超过 32 个不同的 f64 字面量就 fail-fast。
const C_FNUM_NF = 10
const C_FNUM_FLAG0 = 11
const C_FNUM_NC = 50
const C_FNUM_CACHE0 = 51
// v2.55：f64 的 XMM 变量寄存器用了几个（0..N_XMMVAR）
const C_NXF = 120
// v2.55：每个 XMM 变量寄存器的保存槽（-1 = 没用到）。由 `_alloc` 在**临时池之前**
// 分配 —— 临时池的基址是当时的 C_ST，之后再 `_st_slot` 会撞上池子。
const C_XSAV0 = 121
// v2.56：编译期算出来的 f64 字面量放进**帧里的常量槽**，函数序言写一次，
// 之后 `divsd xmm, [rbp+slot]` 直接用内存操作数 —— 循环体里一条指令都不用。
// 布局：C_F64K_N = 个数，之后每个三格 (串 id, 槽号, 位模式)。
const C_F64K_N = 140
const C_F64K0 = 141
const F64K_MAX = 24
const FNUM_MAX = 32
const FRAME = 4096          // 帧大小（512 个 8 字节槽）
const MAX_VAR = 64          // 变量最多占 64 个寄存器位（其余落槽）
// v2.33：变量/聚合区从 256 提到 384——qlmc 自己的 build_rdata 要 257 格。
// 帧仍是 4 KB（512 格），临时值溢出区剩 128 格（够用：同时活跃的临时值很少 >8）。
// **不要再靠加帧来扩**：帧 > 4 KB 必须做栈探测（§7.17），qlmc 还没做。
//
// v3.42 的教训：`build_rdata` 已经贴着 416 格。加 ws2_32 的 8 个导入时
// 别在那儿摊开写 `dsym.push`（每个 `let`/`push` 语句占一格），搬进
// `_reg_ws2` 这种独立函数里 —— 函数调用不占调用方的局部变量槽。
// 当时先试着把上限 416->424，结果报错数字跟着一起涨（"需要 425"），
// 说明那根本不是容量问题，是函数真的在用 424 格。
const SLOT_TEMP = 416
const MAX_SLOT = 512

// 运行库例程在 rt 里的槽号
const RT_PINT = 0
const RT_PSTR = 1
const RT_MEMCPY = 2
const RT_ALLOC = 3
const RT_CAT = 4
const RT_EQ = 5
const RT_DIE = 6
const RT_PBOOL = 7
const RT_ZERO = 8
const RT_JOIN = 9
const RT_SPAWN = 10
const RT_EPRINT = 11    // 写 stderr + 换行
const RT_MEMCMP = 12    // mem_cmp：返回首个不同字节的差值
const RT_I64FMT = 13    // 整数 -> 十进制文本（写进调用方给的缓冲，返回长度）
const RT_STR2INT = 14   // 十进制文本 -> 整数（非法/溢出 fail-fast）
const RT_FPARSE = 15    // 十进制文本 -> f64（写进目标槽）
const RT_FADD = 16
const RT_FSUB = 17
const RT_FMUL = 18
const RT_FDIV = 19
const RT_ITOF = 20      // int -> f64
const RT_FTOI = 21      // f64 -> int（向零截断）
const RT_FNEG = 22      // f64 取负（翻符号位，不是对地址取负）
const RT_F64FMT = 23    // f64 -> 十进制文本（写进调用方给的缓冲，返回长度）
// v3.37：mem_chr(p, n, byte) -> 下标 / -1（找不到）
// std/ 有 5 个模块用它（http 头解析、str_find、csv 等），是当前最大单项。
const RT_MEMCHR = 24
// v3.38：mem_diff(p1, p2, n) -> 首个不同字节的下标 / n（全等）
// std/ 的 gzip deflate（LZ77 匹配长度）与逐字节 diff 用它。
const RT_MEMDIFF = 25
// v3.38：mem_xchg(addr, val) -> old（原子交换，xchg 隐含 LOCK）
// std/net 的多 io 线程自旋锁靠它。
const RT_MEMXCHG = 26
const RT_COUNT = 27      // 加例程时**只改这里**（下面两个 vec 大小都引用它）

fn _slot_disp(slot: int) -> int {
    return -8 * (slot + 1)
}

fn _newlab(labs: vec[int]) -> int {
    labs.push(0)
    return len(labs) - 1
}

fn _setlab(labs: vec[int], code: vec[int], id: int) {
    labs.set(id, len(code))
}

fn _addfix(fixes: vec[Fix], pos: int, id: int, kind: int) {
    fixes.push(Fix { pos: pos, id: id, kind: kind })
}

/// 顺序段调运行库例程（rel32 回填到 rt_pos[k]）
fn _call_rt(ctx: Ctx, k: int) {
    let p = _call_rel(ctx.code)
    _addfix(ctx.fixes, p, k, FK_RT)
}

fn _name_id_ro(ctx: Ctx, s: str) -> int {
    let mut i = 0
    while i < len(ctx.names) {
        if ctx.names.get(i) == s {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _param_name(fc: FnCtx, f: Fn, k: int) -> int {
    return fc.nodes.get(f.pbase + k).a
}

fn _param_type(fc: FnCtx, f: Fn, k: int) -> int {
    return fc.nodes.get(f.pbase + k).b
}

/// 第 k 个入参落在哪个寄存器（Win64：RCX/RDX/R8/R9）
fn _arg_reg_of(k: int) -> int {
    if k == 0 { return RCX }
    if k == 1 { return RDX }
    if k == 2 { return R8 }
    return R9
}

/// 第 k 个实参寄存器（我们自己的 ABI：RCX/RDX）
fn _out_arg_reg(k: int) -> int {
    if k == 0 { return RCX }
    if k == 1 { return RDX }
    if k == 2 { return R8 }
    return R9
}

/// 变量池：callee-saved，调用不会清（RDI/RSI 不用——运行库例程会踩它们）
/// 变量寄存器表（**全部是 Win64 的 callee-saved**）。
/// v2.51 加了 `RSI`/`RDI` —— 它们在 Win64 ABI 里也是非易失的，以前白放着没用。
/// 加之前必须确认**没有任何运行库例程碰它们**（或者碰了就自己 push/pop）：
/// `__memcpy` 的指针实参改成了 `r8/r9`，`__str_cat` 加了 `push rdi/push rsi`。
const N_VARREG = 7

fn _cs_reg(i: int) -> int {
    if i == 0 { return RBX }
    if i == 1 { return 12 }
    if i == 2 { return 13 }
    if i == 3 { return 14 }
    if i == 4 { return 15 }
    if i == 5 { return RSI }
    return RDI
}

fn _cs_index(r: int) -> int {
    if r == RBX { return 0 }
    if r == 12 { return 1 }
    if r == 13 { return 2 }
    if r == 14 { return 3 }
    if r == 15 { return 4 }
    if r == RSI { return 5 }
    if r == RDI { return 6 }
    return -1
}

/// 临时值池：caller-saved（区间跨调用的临时值不会进这里）
fn _tmp_reg(i: int) -> int {
    if i == 0 { return R8 }
    if i == 1 { return R9 }
    if i == 2 { return R10 }
    return R11
}

// ---------------------------------------------------------------------------
// 编码补充（v2.15 的发射器只有 reg-reg 形态）
// ---------------------------------------------------------------------------

/// op dst, [base+disp32]：03=add 2B=sub 23=and 0B=or 33=xor 3B=cmp
fn _alu_rm(code: vec[int], op: int, dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, op)
    _modrm(code, 2, dst, base)
    _w32(code, disp)
}

/// REX 前缀（含 X 位）。参数是**寄存器编号**（0-15），不是位标志 ——
/// v2.46 第一版把编号直接左移进了 REX 字节（`(r << 2)` 里 r=9），
/// 发出来是 0x7E 而不是 0x4E，CPU 当非法指令跑飞（RIP 到 image 外面）。
fn _rex_full(code: vec[int], w: int, r: int, x: int, b: int) {
    let mut rb = 0
    if r >= 8 {
        rb = 1
    }
    let mut xb = 0
    if x >= 8 {
        xb = 1
    }
    let mut bb = 0
    if b >= 8 {
        bb = 1
    }
    let v = 0x40 | (w << 3) | (rb << 2) | (xb << 1) | bb
    if v != 0x40 {
        _b(code, v)
    }
}

/// `[base + index*scale + disp32]` 的 modrm+SIB。scale 用 0/1/2/3 表示 1/2/4/8。
/// **index 的低 3 位不能是 4**（那是"无 index"的编码），调用方要保证。
fn _modrm_sibidx(code: vec[int], mod: int, reg: int, base: int, index: int, scale: int) {
    _modrm(code, mod, reg, 4)
    _b(code, (scale << 6) | ((index & 7) << 3) | (base & 7))
}

/// `add/sub/and/or/xor r64, imm`。`ext`：add=0 / or=1 / and=4 / sub=5 / xor=6。
/// imm8 装得下就用 `0x83` 形态（3 字节），否则 `0x81` + imm32（7 字节）。
fn _alu_imm(code: vec[int], ext: int, d: int, v: int) {
    _rex2(code, 1, 0, d)
    if v >= -128 && v <= 127 {
        _b(code, 0x83)
        _modrm(code, 3, ext, d)
        _b(code, v)
    } else {
        _b(code, 0x81)
        _modrm(code, 3, ext, d)
        _w32(code, v)
    }
}

/// `cmp r64, imm`（/7）。只用于比较，不写寄存器。
fn _cmp_imm(code: vec[int], d: int, v: int) {
    _alu_imm(code, 7, d, v)
}

/// `shl/sar/shr r64, imm8`。`ext`：shl=4 / shr=5 / sar=7。
fn _shift_imm(code: vec[int], ext: int, d: int, v: int) {
    _rex2(code, 1, 0, d)
    _b(code, 0xC1)
    _modrm(code, 3, ext, d)
    _b(code, v & 63)
}

/// `imul dst, src, imm32`（三操作数形态：reg=dst，rm=src）。
fn _imul_imm(code: vec[int], dst: int, src: int, v: int) {
    _rex2(code, 1, dst, src)
    _b(code, 0x69)
    _modrm(code, 3, dst, src)
    _w32(code, v)
}

/// imul dst, [base+disp32]
fn _imul_rm(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x0F)
    _b(code, 0xAF)
    _modrm(code, 2, dst, base)
    _w32(code, disp)
}

/// idiv [base+disp32]
fn _idiv_rm(code: vec[int], base: int, disp: int) {
    _rex2(code, 1, 0, base)
    _b(code, 0xF7)
    _modrm(code, 2, 7, base)
    _w32(code, disp)
}

/// neg [base+disp32]
fn _neg_rm(code: vec[int], base: int, disp: int) {
    _rex2(code, 1, 0, base)
    _b(code, 0xF7)
    _modrm(code, 2, 3, base)
    _w32(code, disp)
}

/// mov dst, [base-8]（读 str 的长度前缀）
fn _len_of(code: vec[int], dst: int, base: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8B)
    _modrm(code, 1, dst, base)
    _b(code, 0xF8)
}

/// lea dst, [rbp + disp32]
fn _lea_rbp(code: vec[int], dst: int, disp: int) {
    _rex2(code, 1, dst, RBP)
    _b(code, 0x8D)
    _modrm(code, 2, dst, RBP)
    _w32(code, disp)
}

/// lea dst, [base + disp32]
/// `[base + disp]` 的 ModRM。**base 是 RSP/R12 时必须带 SIB 字节**——
/// rm=100 是"SIB 跟在后面"的标记，不发 SIB 的话 disp32 的第一个字节会被
/// 当成 SIB 解析，整条指令连同后面全部错位（v2.32 踩：4 个 pin 让某个基址
/// 落到 R12，编出来的 lea 直接是垃圾）。
fn _modrm_mem(code: vec[int], mod: int, reg: int, base: int) {
    if (base & 7) == 4 {
        _modrm_sib(code, mod, reg)
    } else {
        _modrm(code, mod, reg, base)
    }
}

fn _lea_rm(code: vec[int], dst: int, base: int, disp: int) {
    _rex2(code, 1, dst, base)
    _b(code, 0x8D)
    _modrm_mem(code, 2, dst, base)
    _w32(code, disp)
}

fn _push_r(code: vec[int], r: int) {
    if r >= 8 {
        _b(code, 0x41)
    }
    _b(code, 0x50 + (r & 7))
}

fn _pop_r(code: vec[int], r: int) {
    if r >= 8 {
        _b(code, 0x41)
    }
    _b(code, 0x58 + (r & 7))
}

// ---------------------------------------------------------------------------
// IR 构造
// ---------------------------------------------------------------------------

fn _fc_reset(fc: FnCtx) {
    fc.code.clear()
    fc.labs.clear()
    fc.fixes.clear()
    fc.ir.clear()
    fc.vloc.clear()
    fc.vty.clear()
    fc.vstart.clear()
    fc.vend.clear()
    fc.vpin.clear()
    fc.vmap.clear()
    fc.vval.clear()
    fc.loops.clear()
    fc.cp.clear()
    fc.rend.clear()
    fc.send.clear()
    // vreg 0 = "无"
    fc.vloc.push(0)
    fc.vty.push(TY_INT)
    fc.vstart.push(0)
    fc.vend.push(0)
    fc.vpin.push(0)
    fc.cells.set(C_ST, 0)
    _cell_set(fc, C_FNUM_NF, 0)
    _cell_set(fc, C_FNUM_NC, 0)
    fc.cells.set(C_NV, 0)
    fc.cells.set(C_EP, 0)
    fc.cells.set(C_LD, 0)
    fc.cells.set(C_BD, 0)
    fc.cells.set(C_ADDRTY, 0)
    fc.df.clear()
    fc.bind.clear()
    fc.cells.set(C_BD, 0)
}

/// 一个线程建一次，之后每个函数 `_fc_reset` 复用——并行时堆分配是争用点
fn _new_fc(nodes: vec[Node], names: vec[str], fns: vec[Fn], rt: vec[int],
           stt: vec[int]) -> FnCtx {
    // 10 个计数器/状态单元：C_ST..C_CFI（加新索引时这里和 C_* 常量要一起改）
    let cells = vec[int].new(10)
    let mut ci = 0
    while ci < 10 {
        cells.push(0)
        ci = ci + 1
    }
    let fc = FnCtx { code: vec[int].new(256), labs: vec[int].new(16),
                     fixes: vec[Fix].new(16), ir: vec[Ir].new(64),
                     nodes: nodes, names: names, fns: fns,
                     vloc: vec[int].new(32), vty: vec[int].new(32),
                     vstart: vec[int].new(32), vend: vec[int].new(32),
                     vpin: vec[int].new(32), vmap: vec[int].new(16),
                     vval: vec[int].new(16), cells: cells,
                     rt: rt, stt: stt,
                     df: vec[int].new(16),
                     bind: vec[int].new(16), loops: vec[int].new(16),
                     cp: vec[int].new(64), rend: vec[int].new(4),
                     send: vec[int].new(64) }
    _fc_reset(fc)
    return fc
}

fn _vnew(fc: FnCtx) -> int {
    fc.vloc.push(0)
    fc.vty.push(TY_INT)
    fc.vstart.push(len(fc.ir))
    fc.vend.push(0)
    fc.vpin.push(0)
    return len(fc.vloc) - 1
}

fn _ir_emit(fc: FnCtx, op: int, dst: int, a: int, b: int, imm: int) -> int {
    let i = len(fc.ir)
    fc.ir.push(Ir { op: op, dst: dst, a: a, b: b, imm: imm })
    if a > 0 {
        fc.vend.set(a, i)
    }
    if b > 0 {
        fc.vend.set(b, i)
    }
    // OP_MEMCPYN 把字节数放在 dst 槽里——它是**被读**的，必须算一次使用，
    // 否则分配器会认为它的活跃区间在这条指令之前就结束，把寄存器复用掉。
    if op == OP_MEMCPYN && dst > 0 {
        fc.vend.set(dst, i)
    }
    return i
}

fn _ty_is_agg(ty: int) -> bool {
    // v2.55：**f64 不再是聚合**。它是 8 字节标量，值与 int 同构，只是可以住 XMM。
    // 以前这里有一条 `if ty == TY_F64 { return true }` —— 那是"值住在帧槽里、
    // 按地址传"的老约定，代价是每次赋值一次 memcpy、每次运算两次 movsd 往返。
    // 标量：int/bool/str(0..3)、vec 句柄、map 句柄；其余（struct/enum/array/slice/闭包）都是聚合
    if ty < TY_STRUCT {
        return false
    }
    if ty >= TY_VEC && ty < TY_MAP {
        return false
    }
    if ty >= TY_MAP && ty < TY_SLICE {
        return false
    }
    return true
}

fn _st_nf(fc: FnCtx, si: int) -> int {
    return fc.stt.get(1 + si * ST_STRIDE + 1)
}

fn _st_field_type(fc: FnCtx, si: int, fi: int) -> int {
    return fc.stt.get(1 + si * ST_STRIDE + 2 + fi * 2 + 1)
}

fn _st_field_idx(fc: FnCtx, si: int, nid: int) -> int {
    let nf = _st_nf(fc, si)
    let mut i = 0
    while i < nf {
        if fc.stt.get(1 + si * ST_STRIDE + 2 + i * 2) == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

fn _ent_base(ei: int) -> int {
    return EN_HDR + 1 + ei * EN_STRIDE
}

fn _ent_nvar(fc: FnCtx, ei: int) -> int {
    return fc.stt.get(_ent_base(ei) + 1)
}

fn _ent_ptype(fc: FnCtx, ei: int, vi: int) -> int {
    return fc.stt.get(_ent_base(ei) + 2 + vi * 3 + 2)
}

fn _ty_size(fc: FnCtx, ty: int) -> int {
    if ty >= TY_ARRAY {
        return ((ty - TY_ARRAY) >> 8) * 8
    }
    if ty >= TY_SLICE && ty < TY_ARRAY {
        return 16                       // (ptr, len)
    }
    if ty >= TY_ENUM {
        return 16
    }
    if ty >= TY_STRUCT {
        return _st_nf(fc, ty - TY_STRUCT) * 8
    }
    return 8
}

fn _ty_elem(ty: int) -> int {
    return (ty - TY_ARRAY) & 0xFF
}

fn _st_units(fc: FnCtx, n: int) -> int {
    let s = fc.cells.get(C_ST)
    if s + n > SLOT_TEMP {
        eprint("qlmc: 局部变量/聚合超出帧（" + (SLOT_TEMP).to_str() + " 个 8 字节槽）")
        eprint("  当前函数：" + fc.names.get(fc.fns.get(fc.cells.get(C_CFI)).name))
        eprint("  需要 " + (s + n).to_str() + " 个槽（已用 " + s.to_str() + "，本次要 " + n.to_str() + "）")
        exit(2)
    }
    fc.cells.set(C_ST, s + n)
    return s
}

fn _st_slot(fc: FnCtx) -> int {
    return _st_units(fc, 1)
}

fn _new_var(fc: FnCtx, nid: int, ty: int) -> int {
    let v = _vnew(fc)
    fc.vpin.set(v, 1)
    fc.vty.set(v, ty)
    let isagg = _ty_is_agg(ty)
    if isagg {
        let units = _ty_size(fc, ty) / 8
        let u = _st_units(fc, units)
        fc.vloc.set(v, -(u + units))
        fc.vmap.push(nid)
        fc.vval.push(v)
        return v
    }
    // v2.55：f64 变量进 XMM6..XMM15（Win64 的非易失 XMM），用完才落帧槽
    if ty == TY_F64 {
        let nx = _nxf_get(fc)
        if nx < N_XMMVAR {
            fc.vloc.set(v, XLOC + XMM_VAR0 + nx)
            _cell_set(fc, C_NXF, nx + 1)
        } else {
            fc.vloc.set(v, -(_st_slot(fc)) - 1)
        }
        fc.vmap.push(nid)
        fc.vval.push(v)
        return v
    }
    let n = fc.cells.get(C_NV)
    if n < N_VARREG {
        fc.vloc.set(v, _cs_reg(n) + 1)
        fc.cells.set(C_NV, n + 1)
    } else {
        fc.vloc.set(v, -(_st_slot(fc)) - 1)
    }
    fc.vmap.push(nid)
    fc.vval.push(v)
    return v
}

/// 已经用掉几个 XMM 变量寄存器
fn _nxf_get(fc: FnCtx) -> int {
    if len(fc.cells) <= C_NXF {
        return 0
    }
    return fc.cells.get(C_NXF)
}

fn _bind_push(fc: FnCtx, nid: int, v: int) {
    let d = fc.cells.get(C_BD)
    if len(fc.bind) > d * 2 {
        fc.bind.set(d * 2, nid)
        fc.bind.set(d * 2 + 1, v)
    } else {
        fc.bind.push(nid)
        fc.bind.push(v)
    }
    fc.cells.set(C_BD, d + 1)
}

fn _bind_pop(fc: FnCtx) {
    fc.cells.set(C_BD, fc.cells.get(C_BD) - 1)
}

/// 找变量，找不到返回 -1（`_var_id` 是 fail-fast 版）
fn _try_var(fc: FnCtx, nid: int) -> int {
    let mut b = fc.cells.get(C_BD) - 1
    while b >= 0 {
        if fc.bind.get(b * 2) == nid {
            return fc.bind.get(b * 2 + 1)
        }
        b = b - 1
    }
    let mut i = len(fc.vmap) - 1
    while i >= 0 {
        if fc.vmap.get(i) == nid {
            return fc.vval.get(i)
        }
        i = i - 1
    }
    return -1
}

fn _var_id(fc: FnCtx, nid: int) -> int {
    let mut b = fc.cells.get(C_BD) - 1
    while b >= 0 {
        if fc.bind.get(b * 2) == nid {
            return fc.bind.get(b * 2 + 1)
        }
        b = b - 1
    }
    let mut i = len(fc.vmap) - 1
    while i >= 0 {
        if fc.vmap.get(i) == nid {
            return fc.vval.get(i)
        }
        i = i - 1
    }
    eprint("qlmc: 未定义变量 " + fc.names.get(nid))
    exit(2)
    return -1
}

fn _fn_index(fc: FnCtx, nid: int) -> int {
    let mut i = 0
    while i < len(fc.fns) {
        if fc.fns.get(i).name == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// 降级：AST → IR
//
// 两个「发射到位」的入口，是寄存器分配真正兑现的地方：
//   `_lower_into` —— 赋值 / let 直接把结果算进目标变量，省掉 temp + mov
//                    （`a = a + b` 从 mov/add/mov 三条变成 add 一条）
//   `_lower_cond` —— 条件位置直接发 `cmp + jcc`，不再 setcc/movzx/test/jz
// 其余位置走 `_lower_expr`：值落临时值，交给线性扫描决定寄存器还是帧槽。
// ---------------------------------------------------------------------------

/// 比较运算符 → jcc 机器码（不是比较运算符返回 0）
fn _cmp_cc(op: int) -> int {
    if op == P_EQ { return 0x84 }
    if op == P_NE { return 0x85 }
    if op == P_LT { return 0x8C }
    if op == P_LE { return 0x8E }
    if op == P_GT { return 0x8F }
    if op == P_GE { return 0x8D }
    return 0
}

/// jcc ↔ 取反（setcc 是 jcc + 0x10，见 `_emit_bin`）
fn _cc_inv(cc: int) -> int {
    if cc == 0x84 { return 0x85 }
    if cc == 0x85 { return 0x84 }
    if cc == 0x8C { return 0x8D }
    if cc == 0x8D { return 0x8C }
    if cc == 0x8E { return 0x8F }
    return 0x8E
}

/// 收集一个 E_CALL 的实参节点 id：前 4 个在 b/c/n/slot，第 5 个起挂在 nx 链上
fn _call_args(fc: FnCtx, nd: Node) -> vec[int] {
    let av = vec[int].new(4)
    if nd.b >= 0 { av.push(nd.b) }
    if nd.c >= 0 { av.push(nd.c) }
    if nd.n >= 0 { av.push(nd.n) }
    if nd.slot >= 0 { av.push(nd.slot) }
    let mut x = nd.nx
    while x >= 0 {
        av.push(fc.nodes.get(x).a)
        x = fc.nodes.get(x).nx
    }
    return av
}

/// 摆实参：寄存器部分走 OP_ARG，超出 nreg 的走栈（v2.29）。
/// `argbase` = 1 表示聚合返回占了第 0 个实参寄存器（sret）。
/// 返回为栈实参预留的字节数（0 = 没开栈），调用方在 call 之后要用
/// `_emit_call_free` 收回去。
fn _emit_call_args(fc: FnCtx, vals: vec[int], argbase: int) -> int {
    let nreg = 4 - argbase
    let mut nstk = len(vals) - nreg
    if nstk < 0 {
        nstk = 0
    }
    let mut stk = 0
    if nstk > 0 {
        // shadow space 32 + 每个栈实参 8；再补到 16 的倍数——
        // Win64 要求 `call` 那一刻 rsp ≡ 0 (mod 16)，不然被调方里
        // 用对齐 SSE 存取的 Win32 API 会直接 AV。
        stk = 32 + 8 * nstk
        if stk % 16 != 0 {
            stk = stk + 8
        }
        _ir_emit(fc, OP_STKALLOC, 0, 0, 0, stk)
    }
    // **先写栈实参，再摆寄存器实参**。顺序不能反：栈实参的值可能正躺在
    // R8/R9 里（那正是临时值寄存器），而 OP_ARG 会写 R8/R9 —— 先摆寄存器
    // 就会把还没落栈的值冲掉。v2.33 实测：`ReadFile(h, buf, sz, got, 0)`
    // 的第 5 个实参被写成了 sz，于是 lpOverlapped = 226，进程直接崩。
    // 寄存器实参里下标 2/3 的目标是 R8/R9，而临时值**正好住在 R8-R11**：
    // 把实参 2 搬进 R8 会冲掉还没搬的实参 3（反之亦然）。所以先把这两个位置的
    // 临时值钉进变量（变量在 RBX/R12-R15 或帧槽，不会被 OP_ARG 碰到）。
    // 实测形态：`f(a, b, c, 4)` 的第 4 个实参传成了 c（v2.34，坑表 #33）。
    // 下标 0/1 的目标是 RCX/RDX，临时值不会住那儿，不用管。
    let mut pi = 2
    while pi < 4 {
        if pi < len(vals) {
            if fc.vpin.get(vals.get(pi)) == 0 {
                vals.set(pi, _pin(fc, vals.get(pi)))
            }
        }
        pi = pi + 1
    }
    let mut k = 0
    let mut ai = nreg
    while ai < len(vals) {
        _ir_emit(fc, OP_STKARG, 0, vals.get(ai), 0, 32 + 8 * k)
        k = k + 1
        ai = ai + 1
    }
    ai = 0
    while ai < nreg {
        if ai < len(vals) {
            _ir_emit(fc, OP_ARG, 0, vals.get(ai), 0, argbase + ai)
        }
        ai = ai + 1
    }
    return stk
}

fn _emit_call_free(fc: FnCtx, stk: int) {
    if stk > 0 {
        _ir_emit(fc, OP_STKFREE, 0, 0, 0, stk)
    }
}

/// 两个操作数已经求好，把 `l <op> r` 发进 dst，返回结果类型
/// 这个表达式**可能**是 f64 吗？（只认字面量 / 变量 / 一元 / 二元，绝不 fail-fast）
///
/// 为什么不直接用 `_ty_of_expr`：它内部会走 `_var_id`，变量还没登记时是**硬失败**。
/// 类型推断（`let x = a + b`）会在各种时机被调用，不能因为"还没登记"就退出。
fn _ty_maybe_f64(fc: FnCtx, nid: int) -> bool {
    if nid < 0 {
        return false
    }
    let nd = fc.nodes.get(nid)
    if nd.op == E_FNUM {
        return true
    }
    if nd.op == E_VAR {
        let v = _try_var(fc, nd.a)
        if v >= 0 {
            return fc.vty.get(v) == TY_F64
        }
        return false
    }
    if nd.op == E_UN || nd.op == E_BIN {
        if _ty_maybe_f64(fc, nd.b) {
            return true
        }
        if nd.c >= 0 {
            if _ty_maybe_f64(fc, nd.c) {
                return true
            }
        }
    }
    return false
}

/// 比较运算符 -> f64 用的 setcc 操作码（0 = 不是比较）
fn _fcmp_cc(op: int) -> int {
    if op == P_EQ {
        return 0x94            // sete
    }
    if op == P_NE {
        return 0x95            // setne
    }
    if op == P_LT {
        return 0x92            // setb
    }
    if op == P_LE {
        return 0x96            // setbe
    }
    if op == P_GT {
        return 0x97            // seta
    }
    if op == P_GE {
        return 0x93            // setae
    }
    return 0
}

/// 把 int 值提升成 f64（混合运算时用），返回 f64 槽的地址
fn _to_f64(fc: FnCtx, v: int) -> int {
    // v2.55：f64 是标量，直接产一个 TY_F64 临时值（以前要先开变量槽再取地址）
    let d = _vnew(fc)
    fc.vty.set(d, TY_F64)
    _ir_emit(fc, OP_ITOF, d, v, 0, 0)
    return d
}

/// 把 `cells` 撑到至少 n 格（它是普通 vec，可以往后长）
fn _cell_ensure(fc: FnCtx, n: int) {
    while len(fc.cells) < n {
        fc.cells.push(0)
    }
}

fn _cell_set(fc: FnCtx, idx: int, v: int) {
    _cell_ensure(fc, idx + 1)
    fc.cells.set(idx, v)
}

/// f64 字面量缓存查表：串 id → 已解析好的 f64 槽地址。没查到返回 -1。
fn _fnum_get(fc: FnCtx, sid: int) -> int {
    if len(fc.cells) <= C_FNUM_NC {
        return -1
    }
    let nc = fc.cells.get(C_FNUM_NC)
    let mut i = 0
    while i < nc {
        if fc.cells.get(C_FNUM_CACHE0 + 2 * i) == sid {
            return fc.cells.get(C_FNUM_CACHE0 + 2 * i + 1)
        }
        i = i + 1
    }
    return -1
}

fn _fnum_put(fc: FnCtx, sid: int, ad: int) {
    if len(fc.cells) <= C_FNUM_NC {
        return
    }
    let nc = fc.cells.get(C_FNUM_NC)
    if nc >= FNUM_MAX {
        eprint("qlmc: 一个函数里超过 " + (FNUM_MAX).to_str() + " 个不同的 f64 字面量")
        exit(2)
    }
    _cell_set(fc, C_FNUM_CACHE0 + 2 * nc, sid)
    _cell_set(fc, C_FNUM_CACHE0 + 2 * nc + 1, ad)
    _cell_set(fc, C_FNUM_NC, nc + 1)
}

/// 登记一个"已解析"标志槽（函数序言里要清零）
fn _fnum_flag(fc: FnCtx, slot: int) {
    if len(fc.cells) <= C_FNUM_NF {
        return
    }
    let nf = fc.cells.get(C_FNUM_NF)
    if nf >= FNUM_MAX {
        eprint("qlmc: 一个函数里超过 " + (FNUM_MAX).to_str() + " 个不同的 f64 字面量")
        exit(2)
    }
    _cell_set(fc, C_FNUM_FLAG0 + nf, slot)
    _cell_set(fc, C_FNUM_NF, nf + 1)
}

/// 编译期 f64 字面量的常量槽查表：串 id → 槽号。没查到返回 -1。
fn _f64k_get(fc: FnCtx, sid: int) -> int {
    if len(fc.cells) <= C_F64K_N {
        return -1
    }
    let n = fc.cells.get(C_F64K_N)
    let mut i = 0
    while i < n {
        if fc.cells.get(C_F64K0 + 3 * i) == sid {
            return fc.cells.get(C_F64K0 + 3 * i + 1)
        }
        i = i + 1
    }
    return -1
}

/// 登记一个常量槽（位模式一起存，`_emit_fn` 的序言里要发写槽指令）
fn _f64k_put(fc: FnCtx, sid: int, slot: int, bits: int) {
    let mut n = 0
    if len(fc.cells) > C_F64K_N {
        n = fc.cells.get(C_F64K_N)
    }
    if n >= F64K_MAX {
        eprint("qlmc: 一个函数里超过 " + (F64K_MAX).to_str() + " 个 f64 字面量常量")
        exit(2)
    }
    _cell_set(fc, C_F64K0 + 3 * n, sid)
    _cell_set(fc, C_F64K0 + 3 * n + 1, slot)
    _cell_set(fc, C_F64K0 + 3 * n + 2, bits)
    _cell_set(fc, C_F64K_N, n + 1)
}

fn _emit_bin(fc: FnCtx, op: int, dst: int, l: int, r: int) -> int {
    let tl = fc.vty.get(l)
    let tr = fc.vty.get(r)
    if tl == TY_F64 || tr == TY_F64 {
        // 混合 int/f64 时把 int 一侧提升（与 stage-0 的隐式转换一致）
        let mut lv = l
        let mut rv = r
        if tl != TY_F64 {
            lv = _to_f64(fc, l)
        }
        if tr != TY_F64 {
            rv = _to_f64(fc, r)
        }
        if op == P_PLUS || op == P_MINUS || op == P_STAR || op == P_SLASH {
            // **结果必须写进调用方给的 dst**（`_lower_expr` 用 dst 当返回值，
            // 自己另开一个临时值会让调用方拿到一个从未定义过的 vreg ——
            // 现象是 `let c = a + b` 之后 c 里是别人的地址）。
            // v2.55：dst 本身就是 f64 值（住 XMM / 帧槽），不再开槽取地址
            let mut sub = 0                    // 0=add 1=sub 2=mul 3=div
            if op == P_MINUS {
                sub = 1
            }
            if op == P_STAR {
                sub = 2
            }
            if op == P_SLASH {
                sub = 3
            }
            _ir_emit(fc, OP_FBIN, dst, lv, rv, sub)
            return TY_F64
        }
        let cc = _fcmp_cc(op)
        if cc != 0 {
            _ir_emit(fc, OP_FCMP, dst, lv, rv, cc)
            return TY_INT
        }
        eprint("qlmc: f64 只支持 + - * / 与比较")
        exit(2)
    }
    if tl == TY_STR || tr == TY_STR {
        if op == P_PLUS {
            _ir_emit(fc, OP_ARG, 0, l, 0, 0)
            _ir_emit(fc, OP_ARG, 0, r, 0, 1)
            _ir_emit(fc, OP_CALLRT, dst, 0, 0, RT_CAT)
            return TY_STR
        }
        if op == P_EQ || op == P_NE {
            // stage-0 的口径：str 比较产生 bool（打印 true/false）
            _ir_emit(fc, OP_ARG, 0, l, 0, 0)
            _ir_emit(fc, OP_ARG, 0, r, 0, 1)
            _ir_emit(fc, OP_CALLRT, dst, 0, 0, RT_EQ)
            if op == P_NE {
                _ir_emit(fc, OP_NOT, dst, dst, 0, 0)
            }
            return TY_BOOL
        }
        eprint("qlmc: 字符串只支持 + 与 == / !=")
        exit(2)
    }
    if op == P_PLUS {
        _ir_emit(fc, OP_ADD, dst, l, r, 0)
        return TY_INT
    }
    if op == P_MINUS {
        _ir_emit(fc, OP_SUB, dst, l, r, 0)
        return TY_INT
    }
    if op == P_STAR {
        _ir_emit(fc, OP_MUL, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SLASH {
        _ir_emit(fc, OP_DIV, dst, l, r, 0)
        return TY_INT
    }
    if op == P_PERCENT {
        _ir_emit(fc, OP_MOD, dst, l, r, 0)
        return TY_INT
    }
    // 位运算与移位（v2.28）：只对 int 成立，结果 int。
    // `>>` 是**算术**右移（sar），`>>>` 才是逻辑右移（shr）——与 stage-0 一致。
    if op == P_AMP {
        _ir_emit(fc, OP_AND, dst, l, r, 0)
        return TY_INT
    }
    if op == P_PIPE {
        _ir_emit(fc, OP_OR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_CARET {
        _ir_emit(fc, OP_XOR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SHL {
        _ir_emit(fc, OP_SHL, dst, l, r, 0)
        return TY_INT
    }
    if op == P_SHR {
        _ir_emit(fc, OP_SAR, dst, l, r, 0)
        return TY_INT
    }
    if op == P_USHR {
        _ir_emit(fc, OP_SHR, dst, l, r, 0)
        return TY_INT
    }
    let cc = _cmp_cc(op)
    if cc == 0 {
        eprint("qlmc: 不支持的运算符 " + op.to_str())
        exit(2)
    }
    // 比较结果按 **int** 收（保持 v2.33 之前的口径）。为什么不是 bool：
    // stage-0 会把编译期可折叠的比较（`print(1 < 2)`）折成 int 打 1，而运行期的
    // 比较（`print(i + 1 < n)`）打 true —— 它自己就不一致。qlmc 没有常量折叠，
    // 只能对一头，选 int 这头（夹具 s1_basics 的 `print((1<2) && (3>2))` 依赖它）。
    // 已知差异：运行期比较被直接 print 时 stage-0 打 true、qlmc 打 1（见 07-gaps §7.22）。
    _ir_emit(fc, OP_CMP, dst, l, r, cc + 0x10)
    return TY_INT
}
















/// 左值取地址：变量（聚合）/ 字段 / 下标。结果 vreg 存地址，类型放 fc.addrty
fn _addr_of(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_VAR {
        let v = _var_id(fc, nd.a)
        let loc = fc.vloc.get(v)
        if loc >= 0 {
            eprint("qlmc: 只有聚合变量能取地址：" + fc.names.get(nd.a))
            exit(2)
        }
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADDRV, d, 0, 0, -loc - 1)
        fc.cells.set(C_ADDRTY, fc.vty.get(v))
        return d
    }
    if nd.op == E_FIELD {
        return _addr_field(fc, nd.a, nd.b)
    }
    if nd.op == E_INDEX {
        return _addr_index(fc, nd.a, nd.b)
    }
    // 其余**聚合值**都能直接当基址：按约定"聚合值 = 区域地址"，
    // 调用结果（sret 区域）、结构体字面量（临时区域）、枚举构造、match 结果
    // 返回的都是稳定地址。这是 `nodes.get(i).op` / `mk(...).x` 能编的前提
    // （v2.33 之前直接报"这个表达式不能取地址"，而 qlmc 自己的源码里到处是它）。
    let ty = _ty_of_expr(fc, nid)
    if _ty_is_agg(ty) {
        let a = _lower_expr(fc, nid)
        fc.cells.set(C_ADDRTY, ty)
        return a
    }
    eprint("qlmc: 这个表达式不能取地址")
    exit(2)
    return 0
}

fn _addr_field(fc: FnCtx, base_nid: int, fname: int) -> int {
    let base = _addr_of(fc, base_nid)
    let bty = fc.cells.get(C_ADDRTY)
    if bty < TY_STRUCT || bty >= TY_ARRAY {
        eprint("qlmc: 只有 struct 有字段：" + fc.names.get(fname))
        exit(2)
    }
    let si = bty - TY_STRUCT
    let fi = _st_field_idx(fc, si, fname)
    if fi < 0 {
        eprint("qlmc: struct 没有字段 " + fc.names.get(fname))
        exit(2)
    }
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_ADDRF, d, base, 0, fi * 8)
    fc.cells.set(C_ADDRTY, _st_field_type(fc, si, fi))
    return d
}

fn _addr_index(fc: FnCtx, base_nid: int, ix_nid: int) -> int {
    let bty0 = _ty_of_expr(fc, base_nid)
    // str 下标（v2.33）：值就是数据指针，`s[i]` = 第 i 个字节（0..255）。
    // 返回的地址标成 TY_BYTE，读/写各走 LOAD8/STORE8。越界 fail-fast（同 vec）。
    if bty0 == TY_STR {
        let sv = _lower_expr(fc, base_nid)
        let iv = _lower_expr(fc, ix_nid)
        let lfail = _newlab(fc.labs)
        let lok = _newlab(fc.labs)
        // **条件反过来写**（v2.46）：`jb lok` 让"不越界"直接跳过死路，
        // 比"jae lfail + jmp lok"少一条跳转 —— 数组/字符串下标的热路径上省一条。
        _ir_emit(fc, OP_JCMPSTR, 0x82, iv, sv, lok)  // cmp i, [s-8]; jb → 跳过
        _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
        let a = _vnew(fc)
        fc.vty.set(a, TY_INT)
        _ir_emit(fc, OP_ADD, a, sv, iv, 0)
        fc.cells.set(C_ADDRTY, TY_BYTE)
        return a
    }
    // vec：句柄是头块，数据指针在 [h+0]；数组：区域地址直接当下标基址
    if bty0 >= TY_VEC && bty0 < TY_MAP {
        let h = _lower_expr(fc, base_nid)
        let i = _lower_expr(fc, ix_nid)
        _vec_check(fc, h, i)
        let et0 = bty0 - TY_VEC
        fc.cells.set(C_ADDRTY, et0)
        let data = _vec_field(fc, h, 0)
        return _vec_elem_addr(fc, data, i, _ty_size(fc, et0))
    }
    if bty0 >= TY_SLICE && bty0 < TY_ARRAY {
        // 切片：(ptr, len)，先查边界再用 ptr 当下标基址
        let sv = _lower_expr(fc, base_nid)
        let ptr = _vnew(fc)
        fc.vty.set(ptr, TY_INT)
        _ir_emit(fc, OP_LOAD, ptr, sv, 0, 8)
        let len = _vnew(fc)
        fc.vty.set(len, TY_INT)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
        _ir_emit(fc, OP_LOAD, len, la, 0, 8)
        let i = _lower_expr(fc, ix_nid)
        _slice_check(fc, i, len)
        let d = _vnew(fc)
        fc.vty.set(d, TY_INT)
        _ir_emit(fc, OP_ADDRX, d, ptr, i, 8)
        fc.cells.set(C_ADDRTY, bty0 - TY_SLICE)
        return d
    }
    let base = _addr_of(fc, base_nid)
    let bty = fc.cells.get(C_ADDRTY)
    if bty < TY_ARRAY {
        eprint("qlmc: 只有定长数组能切片下标")
        exit(2)
    }
    let ix = _lower_expr(fc, ix_nid)
    let d = _vnew(fc)
    fc.vty.set(d, TY_INT)
    _ir_emit(fc, OP_ADDRX, d, base, ix, 8)
    fc.cells.set(C_ADDRTY, _ty_elem(bty))
    return d
}

fn _lower_expr(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_NUM {
        let d = _vnew(fc)
        fc.vty.set(d, nd.ty)
        _ir_emit(fc, OP_CONST, d, 0, 0, nd.a)
        return d
    }
    if nd.op == E_FNUM {
        // f64 字面量：开槽 -> OP_LEA 取原文 -> 运行时 strtod 解析进槽（见 _gen_fparse）
        //
        // **v2.47：同一个字面量在一个函数里只解析一次**。以前每次求值都
        // `LEA + 2×ARG + CALLRT(__fparse)`，而 `__fparse` 里是 `strtod` ——
        // 字面量落在循环体里就是**每轮一次 strtod**。实测 b2_float（500 万轮）
        // 有 90% 的时间花在这上面：把 `1.0` 提到循环外，752 ms → 69.8 ms（10.8×）。
        // 现在第一个出现点做一次带标志的解析，之后直接复用那个槽。
        // 标志槽在函数序言里清零（见 `_emit_fn`），所以每次函数调用只解析一次。
        // v2.56：编译期能精确算出来的字面量 → **放进帧里的常量槽**。
        // 序言写一次（`_emit_fn`），之后循环体里零指令：`divsd xmm, [rbp+slot]`
        // 直接吃内存操作数，`_to_xmm` 也只要一条 `movsd`。
        if nd.c == 1 {
            let kslot = _f64k_get(fc, nd.a)
            let mut slot2 = kslot
            if slot2 < 0 {
                slot2 = _st_slot(fc)
                _f64k_put(fc, nd.a, slot2, nd.b)
            }
            let di = _vnew(fc)
            fc.vty.set(di, TY_F64)
            fc.vloc.set(di, -(slot2 + 1))
            return di
        }
        // v2.55：槽里存的是 8 字节位模式（f64 已是标量）。每次求值只要一条
        // `movsd`（以前是"取槽地址 + 当作 f64 值"，地址在寄存器里到处搬）。
        let cached = _fnum_get(fc, nd.a)
        if cached >= 0 {
            let d1 = _vnew(fc)
            fc.vty.set(d1, TY_F64)
            _ir_emit(fc, OP_LOAD, d1, cached, 0, 8)
            return d1
        }
        let vslot = _st_slot(fc)
        let fslot = _st_slot(fc)
        let ad = _vnew(fc)
        fc.vty.set(ad, TY_INT)
        _ir_emit(fc, OP_ADDRV, ad, 0, 0, vslot)
        _fnum_put(fc, nd.a, ad)
        _fnum_flag(fc, fslot)
        let lskip = _newlab(fc.labs)
        let fa = _vnew(fc)
        fc.vty.set(fa, TY_INT)
        _ir_emit(fc, OP_ADDRV, fa, 0, 0, fslot)
        let fv = _vnew(fc)
        fc.vty.set(fv, TY_INT)
        _ir_emit(fc, OP_LOAD, fv, fa, 0, 8)
        let zero = _vnew(fc)
        fc.vty.set(zero, TY_INT)
        _ir_emit(fc, OP_CONST, zero, 0, 0, 0)
        _ir_emit(fc, OP_JCMP, 0x85, fv, zero, lskip)     // jne：已解析过 → 跳过
        let sp = _vnew(fc)
        fc.vty.set(sp, TY_STR)
        _ir_emit(fc, OP_LEA, sp, 0, 0, nd.a)
        _ir_emit(fc, OP_ARG, 0, sp, 0, 0)
        _ir_emit(fc, OP_ARG, 0, ad, 0, 1)
        _ir_emit(fc, OP_CALLRT, 0, 0, 0, RT_FPARSE)
        let fa2 = _vnew(fc)
        fc.vty.set(fa2, TY_INT)
        _ir_emit(fc, OP_ADDRV, fa2, 0, 0, fslot)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_STORE, 0, fa2, one, 8)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lskip)
        let d0 = _vnew(fc)
        fc.vty.set(d0, TY_F64)
        _ir_emit(fc, OP_LOAD, d0, ad, 0, 8)
        return d0
    }
    if nd.op == E_VAR {
        let v = _var_id(fc, nd.a)
        let ty = fc.vty.get(v)
        if _ty_is_agg(ty) {
            // 聚合变量的"值"是它区域的地址
            let d = _vnew(fc)
            fc.vty.set(d, ty)
            _ir_emit(fc, OP_ADDRV, d, 0, 0, -fc.vloc.get(v) - 1)
            return d
        }
        return v
    }
    if nd.op == E_STR {
        let d = _vnew(fc)
        fc.vty.set(d, TY_STR)
        _ir_emit(fc, OP_LEA, d, 0, 0, nd.a)
        return d
    }
    if nd.op == E_UN {
        let a = _lower_expr(fc, nd.b)
        if fc.vty.get(a) == TY_F64 {
            // f64 的一元 `-`：翻符号位（不能走 OP_NEG —— 那是对地址取负）
            if nd.a != P_MINUS {
                eprint("qlmc: f64 只支持一元 -")
                exit(2)
            }
            // v2.55：内联成"翻符号位"（以前是 2×ARG + CALLRT(__f64_neg)）
            let d = _vnew(fc)
            fc.vty.set(d, TY_F64)
            _ir_emit(fc, OP_FNEG, d, a, 0, 0)
            return d
        }
        let d = _vnew(fc)
        // `!` 在 stage-0 里是 int（打印 1/0）
        fc.vty.set(d, TY_INT)
        if nd.a == P_MINUS {
            _ir_emit(fc, OP_NEG, d, a, 0, 0)
        } else if nd.a == P_TILDE {
            _ir_emit(fc, OP_BNOT, d, a, 0, 0)
        } else {
            _ir_emit(fc, OP_NOT, d, a, 0, 0)
        }
        return d
    }
    if nd.op == E_CALL {
        // 内建 assert(cond, msg)
        if fc.names.get(nd.a) == "assert" && nd.b >= 0 {
            let lfail = _newlab(fc.labs)
            let lok = _newlab(fc.labs)
            _lower_cond(fc, nd.b, lok, 0)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lfail)
            let mut m = 0
            if nd.c >= 0 {
                m = _lower_expr(fc, nd.c)
            }
            if m > 0 && fc.vty.get(m) == TY_STR {
                _ir_emit(fc, OP_ARG, 0, m, 0, 0)
                _ir_emit(fc, OP_CALLRT, 0, 0, 0, RT_DIE)
            } else {
                // 没有消息就只退 1（与 stage-0 的退出码一致，不去碰空指针）
                let one = _vnew(fc)
                _ir_emit(fc, OP_CONST, one, 0, 0, 1)
                _ir_emit(fc, OP_EXIT, 0, one, 0, 0)
            }
            _ir_emit(fc, OP_LAB, 0, 0, 0, lok)
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_CONST, d, 0, 0, 0)
            return d
        }
        // 内建 len(s)
        if fc.names.get(nd.a) == "len" && nd.b >= 0 {
            let aty = _ty_of_expr(fc, nd.b)
            if aty >= TY_SLICE && aty < TY_ARRAY {
                let sv = _lower_expr(fc, nd.b)
                let la = _vnew(fc)
                fc.vty.set(la, TY_INT)
                _ir_emit(fc, OP_ADDRF, la, sv, 0, 8)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_LOAD, d, la, 0, 8)
                return d
            }
            if aty >= TY_MAP && aty < TY_ARRAY {
                let h = _lower_expr(fc, nd.b)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
                return d
            }
            if aty >= TY_VEC && aty < TY_ARRAY {
                let h = _lower_expr(fc, nd.b)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_MOV, d, _vec_field(fc, h, 8), 0, 0)
                return d
            }
            let a = _lower_expr(fc, nd.b)
            if fc.vty.get(a) != TY_STR {
                eprint("qlmc: len() 只支持 str 与 vec")
                exit(2)
            }
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_LEN, d, a, 0, 0)
            return d
        }
        // 内建 join(handle)（v2.32）：等线程结束并取返回值。
        // 用户自己定义了 join 就以用户函数为准（与 stage-0 一致）。
        if fc.names.get(nd.a) == "join" && _fn_index(fc, nd.a) < 0 {
            if nd.b < 0 || nd.c >= 0 {
                eprint("qlmc: join(handle) 需要且只需要一个实参")
                exit(2)
            }
            let hv = _lower_expr(fc, nd.b)
            let d = _vnew(fc)
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_ARG, 0, hv, 0, 0)
            _ir_emit(fc, OP_CALLRT, d, 0, 0, RT_JOIN)
            return d
        }
        // 内建（v2.33）：内存原语 / 诊断 / 串。用户自定义同名函数优先。
        if _fn_index(fc, nd.a) < 0 {
            let bv = _lower_builtin(fc, nd)
            if bv >= 0 {
                return bv
            }
        }
        // 普通调用：实参求值后逐个搬到实参寄存器——实参值不跨调用活
        let fi = _fn_index(fc, nd.a)
        if fi < 0 {
            // 不是顶层函数：可能是闭包变量
            let cv = _try_var(fc, nd.a)
            if cv >= 0 && fc.vty.get(cv) == TY_FN {
                let av = _call_args(fc, nd)
                let vals = vec[int].new(2)
                let mut ai = 0
                while ai < len(av) {
                    vals.push(_lower_expr(fc, av.get(ai)))
                    ai = ai + 1
                }
                // 闭包变量的区域地址：先算，再摆实参（见下面的 pin 说明）
                let cl0 = _vnew(fc)
                fc.vty.set(cl0, TY_INT)
                _ir_emit(fc, OP_ADDRV, cl0, 0, 0, -fc.vloc.get(cv) - 1)
                let stk = _emit_call_args(fc, vals, 0)
                // nd.a 是**名字 id**，不是节点 id：直接取闭包变量的区域地址。
                // 必须在摆实参**之前**算好并 pin——OP_ARG 会写 R8/R9，
                // 而闭包地址的临时值很可能就落在那里。
                let cl = _pin(fc, cl0)
                let d = _vnew(fc)
                fc.vty.set(d, TY_INT)
                _ir_emit(fc, OP_CALLR, d, cl, 0, 0)
                _emit_call_free(fc, stk)
                return d
            }
            eprint("qlmc: 未定义函数 " + fc.names.get(nd.a))
            exit(2)
        }
        let fret = fc.fns.get(fi).ret_t
        let mut argbase = 0
        let mut sret = 0
        if _ty_is_agg(fret) {
            // 聚合返回：先给结果开一块区域，地址留到最后再搬进 RCX。
            // **必须 pin**：实参求值里可能还有调用（会把 RCX 冲掉），
            // 而 OP_ARG 本身又写 R8/R9，临时值放寄存器里活不到 call 那一刻。
            let tmp = _new_var(fc, -1, fret)
            let sa = _vnew(fc)
            fc.vty.set(sa, TY_INT)
            _ir_emit(fc, OP_ADDRV, sa, 0, 0, -fc.vloc.get(tmp) - 1)
            sret = _pin(fc, sa)
            argbase = 1
        }
        let av = _call_args(fc, nd)
        let vals = vec[int].new(4)
        let mut ai = 0
        while ai < len(av) {
            vals.push(_lower_expr(fc, av.get(ai)))
            ai = ai + 1
        }
        let stk = _emit_call_args(fc, vals, argbase)
        if sret != 0 {
            // 最后才设 sret：放在这里就不会被实参求值里的任何调用冲掉
            _ir_emit(fc, OP_ARG, 0, sret, 0, 0)
        }
        let d = _vnew(fc)
        fc.vty.set(d, fret)
        if fc.fns.get(fi).body < 0 {
            // @ffi：`call [rip+IAT]`，槽号 = 内置 4 个之后
            _ir_emit(fc, OP_CALLIAT, d, 0, 0, I_USER + fc.fns.get(fi).nlocals)
        } else {
            _ir_emit(fc, OP_CALL, d, 0, 0, fi)
        }
        _emit_call_free(fc, stk)
        if _ty_is_agg(fret) {
            fc.vty.set(sret, fret)   // 聚合结果就是那块区域的地址
            return sret
        }
        return d
    }
    if nd.op == E_SPAWN {
        return _lower_spawn(fc, nd)
    }
    if nd.op == E_BIN {
        if nd.a == P_AND || nd.a == P_OR {
            let lshort = _newlab(fc.labs)
            let lend = _newlab(fc.labs)
            let d = _vnew(fc)
            fc.vty.set(d, TY_BOOL)
            let mut jf = 0
            if nd.a == P_AND {
                jf = 1
            }
            _lower_cond(fc, nd.b, lshort, jf)
            let r = _lower_expr(fc, nd.c)
            let nz = _vnew(fc)
            fc.vty.set(nz, TY_BOOL)
            _ir_emit(fc, OP_NZ, nz, r, 0, 0)
            _ir_emit(fc, OP_MOV, d, nz, 0, 0)
            _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lshort)
            let k = _vnew(fc)
            fc.vty.set(k, TY_BOOL)
            _ir_emit(fc, OP_CONST, k, 0, 0, 0)
            if nd.a == P_OR {
                _ir_emit(fc, OP_CONST, k, 0, 0, 1)
            }
            _ir_emit(fc, OP_MOV, d, k, 0, 0)
            _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
            return d
        }
        // 求值序：先右后左（v2.15 的差分口径，别改）
        let d = _vnew(fc)
        let r = _lower_expr(fc, nd.c)
        let l = _lower_expr(fc, nd.b)
        let t = _emit_bin(fc, nd.a, d, l, r)
        fc.vty.set(d, t)
        return d
    }
    if nd.op == E_VECNEW {
        return _lower_vecnew(fc, nd)
    }
    if nd.op == E_METHOD {
        return _lower_method(fc, nd)
    }
    if nd.op == E_MAPNEW {
        return _map_new(fc, nd)
    }
    if nd.op == E_SLICE {
        return _lower_slice(fc, nd)
    }
    if nd.op == E_CLOSURE {
        // 值 = {code, env}；本版没有捕获，env 恒为 0
        let v = _new_var(fc, -1, TY_FN)
        let va = _vnew(fc)
        fc.vty.set(va, TY_INT)
        _ir_emit(fc, OP_ADDRV, va, 0, 0, -fc.vloc.get(v) - 1)
        let code = _vnew(fc)
        fc.vty.set(code, TY_INT)
        _ir_emit(fc, OP_LEAFN, code, 0, 0, nd.a)
        _ir_emit(fc, OP_STORE, 0, va, code, 8)
        let z = _map_const(fc, 0)
        let la = _vnew(fc)
        fc.vty.set(la, TY_INT)
        _ir_emit(fc, OP_ADDRF, la, va, 0, 8)
        _ir_emit(fc, OP_STORE, 0, la, z, 8)
        fc.vty.set(va, TY_FN)
        return va
    }
    if nd.op == E_ENUMCTOR {
        // 枚举值 = 一个 16 字节区域的地址：[tag][载荷]
        let v = _new_var(fc, -1, TY_ENUM + nd.a)
        let loc = fc.vloc.get(v)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_ENUM + nd.a)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, -loc - 1)
        let t = _vnew(fc)
        fc.vty.set(t, TY_INT)
        _ir_emit(fc, OP_CONST, t, 0, 0, nd.b)
        _ir_emit(fc, OP_STORE, 0, a0, t, 8)
        if nd.c >= 0 {
            let pv = _lower_expr(fc, nd.c)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, 8)
            _ir_emit(fc, OP_STORE, 0, a1, pv, 8)
        }
        return a0
    }
    if nd.op == E_MATCH {
        let ty = _ty_of_expr(fc, fc.nodes.get(nd.b).c)
        let d = _new_var(fc, -1, ty)
        _lower_match(fc, nid, d, fc.cells.get(C_EP))
        return d
    }
    if nd.op == E_FIELD || nd.op == E_INDEX {
        let a = _addr_of(fc, nid)
        let ty = fc.cells.get(C_ADDRTY)
        if _ty_is_agg(ty) {
            // 聚合值 = 它的地址（只用于赋值/初始化拷贝）
            fc.vty.set(a, ty)
            return a
        }
        let d = _vnew(fc)
        if ty == TY_BYTE {
            fc.vty.set(d, TY_INT)
            _ir_emit(fc, OP_LOAD8, d, a, 0, 0)
            return d
        }
        fc.vty.set(d, ty)
        _ir_emit(fc, OP_LOAD, d, a, 0, 8)
        return d
    }
    if nd.op == E_STRUCTLIT {
        // 结构体字面量当**值**用（v2.31）：开一块临时区域逐字段写进去，
        // 值 = 区域地址（与 E_ENUMCTOR / 字段读同一约定）。push / set /
        // 函数实参都靠这条——qlmc 自己的源码里 `nodes.push(Node{...})`
        // 就是这个形状。
        let ty = TY_STRUCT + nd.a
        let d = _new_var(fc, -1, ty)
        _lower_into_agg(fc, nid, d, ty)
        let a = _vnew(fc)
        fc.vty.set(a, ty)
        _ir_emit(fc, OP_ADDRV, a, 0, 0, -fc.vloc.get(d) - 1)
        return a
    }
    if nd.op == E_ARRLIT {
        eprint("qlmc: 数组字面量只能出现在 let / 赋值 / 字段初始化里")
        exit(2)
    }
    eprint("qlmc: 不支持的表达式节点 " + nd.op.to_str())
    exit(2)
    return 0
}

/// match 降级：读 tag → 逐臂比较 → 命中就执行体。
/// `dst > 0` 是表达式模式（体写进 dst），否则是语句模式（体是块）。
fn _lower_match(fc: FnCtx, nid: int, dst: int, ep: int) {
    let nd = fc.nodes.get(nid)
    let scrut = _lower_expr(fc, nd.a)
    let sty = fc.vty.get(scrut)
    if sty < TY_ENUM || sty >= TY_ARRAY {
        eprint("qlmc: match 的被匹配值必须是 enum（实际 " + sty.to_str() + "）")
        exit(2)
    }
    let ei = sty - TY_ENUM
    let lend = _newlab(fc.labs)
    let mut arm = nd.b
    while arm >= 0 {
        let a = fc.nodes.get(arm)
        let lnext = _newlab(fc.labs)
        if a.a >= 0 {
            let addr = _vnew(fc)
            fc.vty.set(addr, TY_INT)
            _ir_emit(fc, OP_ADDRF, addr, scrut, 0, 0)
            let tag = _vnew(fc)
            fc.vty.set(tag, TY_INT)
            _ir_emit(fc, OP_LOAD, tag, addr, 0, 8)
            let k = _vnew(fc)
            fc.vty.set(k, TY_INT)
            _ir_emit(fc, OP_CONST, k, 0, 0, a.a)
            _ir_emit(fc, OP_JCMP, 0x85, tag, k, lnext)   // jne → 下一臂
        }
        if a.b >= 0 {
            let paddr = _vnew(fc)
            fc.vty.set(paddr, TY_INT)
            _ir_emit(fc, OP_ADDRF, paddr, scrut, 0, 8)
            let pv = _vnew(fc)
            fc.vty.set(pv, TY_INT)
            _ir_emit(fc, OP_LOAD, pv, paddr, 0, 8)
            let bv = _new_var(fc, -1, _ent_ptype(fc, ei, a.a))
            _ir_emit(fc, OP_MOV, bv, pv, 0, 0)
            _bind_push(fc, a.b, bv)          // 只在臂体内可见
        }
        if dst > 0 {
            _lower_into(fc, a.c, dst)
        } else {
            _lower_block(fc, a.c, ep)
        }
        if a.b >= 0 {
            _bind_pop(fc)
        }
        _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lnext)
        arm = a.nx
    }
    _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
}

/// 聚合目标：字面量逐字段写，其余按地址整块拷贝
fn _lower_into_agg(fc: FnCtx, nid: int, dst: int, dty: int) {
    let nd = fc.nodes.get(nid)
    let loc = fc.vloc.get(dst)
    let base_imm = -loc - 1
    if nd.op == E_STRUCTLIT {
        let si = dty - TY_STRUCT
        let mut f = nd.b
        while f >= 0 {
            let fd = fc.nodes.get(f)
            let fi = fd.a
            let fty = _st_field_type(fc, si, fi)
            // f64 字段：布局是 8 字节字，但"值"是槽地址 —— 要**拷 8 字节**而不是
            // 把地址存进去（v2.38）。
            if _ty_is_agg(fty) && fty != TY_F64 {
                eprint("qlmc: 嵌套聚合字段本版不支持")
                exit(2)
            }
            let v = _lower_expr(fc, fd.b)
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, fi * 8)
            // v2.55：f64 已是标量 → 与 int 同一条 OP_STORE（发射器按值的类型
            // 选 `mov [mem], reg` 还是 `movsd [mem], xmm`）
            _ir_emit(fc, OP_STORE, 0, a1, v, 8)
            f = fd.nx
        }
        return
    }
    if nd.op == E_ENUMCTOR {
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
        let t = _vnew(fc)
        fc.vty.set(t, TY_INT)
        _ir_emit(fc, OP_CONST, t, 0, 0, nd.b)
        _ir_emit(fc, OP_STORE, 0, a0, t, 8)
        if nd.c >= 0 {
            let pv = _lower_expr(fc, nd.c)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, 8)
            _ir_emit(fc, OP_STORE, 0, a1, pv, 8)
        }
        return
    }
    if nd.op == E_ARRLIT {
        let mut e = nd.a
        let mut i = 0
        while e >= 0 {
            let en = fc.nodes.get(e)
            let v = _lower_expr(fc, en.a)
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
            let a1 = _vnew(fc)
            fc.vty.set(a1, TY_INT)
            _ir_emit(fc, OP_ADDRF, a1, a0, 0, i * 8)
            _ir_emit(fc, OP_STORE, 0, a1, v, 8)
            i = i + 1
            e = en.nx
        }
        return
    }
    // 其余（变量 / 字段 / 下标）：整块拷贝
    let src = _lower_expr(fc, nid)
    let sty = fc.vty.get(src)
    if sty != dty {
        eprint("qlmc: 聚合赋值两侧类型不一致")
        exit(2)
    }
    let a0 = _vnew(fc)
    fc.vty.set(a0, TY_INT)
    _ir_emit(fc, OP_ADDRV, a0, 0, 0, base_imm)
    _ir_emit(fc, OP_COPY, 0, a0, src, _ty_size(fc, dty))
}

/// 把表达式算进一个已存在的位置（变量）。顶层是二元/一元运算时直接发射到位。
/// 只做类型推导（不发指令）：`let q = p` 要按 p 的类型决定 q 是标量还是聚合
fn _ty_of_expr(fc: FnCtx, nid: int) -> int {
    let nd = fc.nodes.get(nid)
    if nd.op == E_FNUM {
        return TY_F64
    }
    if nd.op == E_VAR {
        return fc.vty.get(_var_id(fc, nd.a))
    }
    if nd.op == E_FIELD {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_STRUCT && bty < TY_ARRAY {
            let si = bty - TY_STRUCT
            let fi = _st_field_idx(fc, si, nd.b)
            if fi >= 0 {
                return _st_field_type(fc, si, fi)
            }
        }
        return TY_INT
    }
    if nd.op == E_INDEX {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_VEC && bty < TY_ARRAY {
            return bty - TY_VEC
        }
        if bty >= TY_ARRAY {
            return _ty_elem(bty)
        }
        return TY_INT
    }
    if nd.op == E_STRUCTLIT {
        return TY_STRUCT + nd.a
    }
    if nd.op == E_ENUMCTOR {
        return TY_ENUM + nd.a
    }
    if nd.op == E_VECNEW {
        return TY_VEC + nd.a
    }
    if nd.op == E_MAPNEW {
        return TY_MAP + (nd.a << 8) + nd.c
    }
    if nd.op == E_CLOSURE {
        return TY_FN
    }
    if nd.op == E_SLICE {
        let bty = _ty_of_expr(fc, nd.a)
        if bty >= TY_SLICE && bty < TY_ARRAY {
            return bty
        }
        if bty >= TY_VEC && bty < TY_MAP {
            return TY_SLICE + (bty - TY_VEC)
        }
        if bty >= TY_ARRAY {
            return TY_SLICE + _ty_elem(bty)
        }
        return TY_SLICE + TY_INT
    }
    if nd.op == E_METHOD {
        let rty = _ty_of_expr(fc, nd.a)
        let m = fc.names.get(nd.b)
        if rty >= TY_MAP && rty < TY_ARRAY {
            if m == "get" {
                return (rty - TY_MAP) & 0xFF
            }
            if m == "has" {
                return TY_BOOL
            }
            return TY_INT
        }
        if rty >= TY_VEC && rty < TY_ARRAY {
            if m == "get" {
                return rty - TY_VEC
            }
        }
        return TY_INT
    }
    if nd.op == E_MATCH {
        return _ty_of_expr(fc, fc.nodes.get(nd.b).c)
    }
    if nd.op == E_ARRLIT {
        return TY_ARRAY + (nd.b << 8) + TY_INT
    }
    if nd.op == E_STR {
        return TY_STR
    }
    if nd.op == E_CALL {
        let fi = _fn_index(fc, nd.a)
        if fi >= 0 {
            return fc.fns.get(fi).ret_t
        }
    }
    if nd.op == E_BIN {
        // v2.38：算术里有一边是 f64 就整体是 f64（比较仍返回 int）。
        // 只加这一条，不动原有的 int/str 口径（避免波及既有行为）。
        // 用 `_ty_maybe_f64` 而不是 `_ty_of_expr`：后者对未登记的变量是硬失败。
        if nd.a != P_AND && nd.a != P_OR {
            if _fcmp_cc(nd.a) == 0 {
                if _ty_maybe_f64(fc, nd.b) || _ty_maybe_f64(fc, nd.c) {
                    return TY_F64
                }
            }
        }
    }
    return TY_INT
}

fn _lower_into(fc: FnCtx, nid: int, dst: int) {
    let dty = fc.vty.get(dst)
    if _ty_is_agg(dty) {
        _lower_into_agg(fc, nid, dst, dty)
        return
    }
    let nd = fc.nodes.get(nid)
    if nd.op == E_BIN && nd.a != P_AND && nd.a != P_OR {
        let r = _lower_expr(fc, nd.c)
        let l = _lower_expr(fc, nd.b)
        let t = _emit_bin(fc, nd.a, dst, l, r)
        fc.vty.set(dst, t)
        return
    }
    if nd.op == E_UN {
        let a = _lower_expr(fc, nd.b)
        if fc.vty.get(a) == TY_F64 {
            // v2.55：f64 的 `-x` 是翻符号位（以前走运行库调用）
            if nd.a != P_MINUS {
                eprint("qlmc: f64 只支持一元 -")
                exit(2)
            }
            _ir_emit(fc, OP_FNEG, dst, a, 0, 0)
            return
        }
        fc.vty.set(dst, TY_INT)
        if nd.a == P_MINUS {
            _ir_emit(fc, OP_NEG, dst, a, 0, 0)
        } else if nd.a == P_TILDE {
            _ir_emit(fc, OP_BNOT, dst, a, 0, 0)
        } else {
            _ir_emit(fc, OP_NOT, dst, a, 0, 0)
        }
        return
    }
    let t = _lower_expr(fc, nid)
    fc.vty.set(dst, fc.vty.get(t))
    _ir_emit(fc, OP_MOV, dst, t, 0, 0)
}

/// 条件跳转：`if_false = 1` 表示"条件不成立时跳到 lab"。
/// 顶层是比较时直接 `cmp + jcc`，否则求值后 `jz/jnz`。
fn _lower_cond(fc: FnCtx, nid: int, lab: int, if_false: int) {
    let nd = fc.nodes.get(nid)
    if nd.op == E_BIN {
        // v2.49：短路 `&&` / `||` **直接发跳转**，不要先算成 0/1 再 JZ/JNZ。
        //
        // 以前条件落到 `_lower_expr`，每个比较都要
        // `sete al; movzx rax,al; mov r9,rax; mov rax,r9; cmp rax,0; setne al; movzx rax,al`
        // —— **六条"规范化"**。实测 `jws` 里
        // `if c == 32 || c == 9 || c == 10 || c == 13 { p = p + 1 }`
        // 编成了 **93 条指令**（一个字节的空白判断！），这是 b9_json 6.6 倍的主因。
        // 短路顺序与求值序和 `_lower_expr` 那版完全一致（左先右后），只是不再
        // 把布尔值物化出来。
        if nd.a == P_AND {
            if if_false == 1 {
                _lower_cond(fc, nd.b, lab, 1)
                _lower_cond(fc, nd.c, lab, 1)
            } else {
                let lend = _newlab(fc.labs)
                _lower_cond(fc, nd.b, lend, 1)
                _lower_cond(fc, nd.c, lab, 0)
                _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
            }
            return
        }
        if nd.a == P_OR {
            if if_false == 0 {
                _lower_cond(fc, nd.b, lab, 0)
                _lower_cond(fc, nd.c, lab, 0)
            } else {
                let lend = _newlab(fc.labs)
                _lower_cond(fc, nd.b, lend, 0)
                _lower_cond(fc, nd.c, lab, 1)
                _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
            }
            return
        }
        let cc0 = _cmp_cc(nd.a)
        // f64 比较**不能**走 JCMP：那比的是两个槽的地址。走 ucomisd（OP_FCMP）
        // 再按结果 JZ/JNZ。求值序仍是"先右后左"（与差分口径一致）。
        if cc0 != 0 {
            if _ty_maybe_f64(fc, nd.b) || _ty_maybe_f64(fc, nd.c) {
                let r0 = _lower_expr(fc, nd.c)
                let l0 = _lower_expr(fc, nd.b)
                let mut lv = l0
                let mut rv = r0
                if fc.vty.get(lv) != TY_F64 {
                    lv = _to_f64(fc, lv)
                }
                if fc.vty.get(rv) != TY_F64 {
                    rv = _to_f64(fc, rv)
                }
                let d0 = _vnew(fc)
                fc.vty.set(d0, TY_INT)
                _ir_emit(fc, OP_FCMP, d0, lv, rv, _fcmp_cc(nd.a))
                if if_false == 1 {
                    _ir_emit(fc, OP_JZ, 0, d0, 0, lab)
                } else {
                    _ir_emit(fc, OP_JNZ, 0, d0, 0, lab)
                }
                return
            }
        }
        if cc0 != 0 {
            let r = _lower_expr(fc, nd.c)
            let l = _lower_expr(fc, nd.b)
            if fc.vty.get(l) != TY_STR && fc.vty.get(r) != TY_STR {
                let mut cc = cc0
                if if_false == 1 {
                    cc = _cc_inv(cc)
                }
                _ir_emit(fc, OP_JCMP, cc, l, r, lab)
                return
            }
            let d = _vnew(fc)
            let t = _emit_bin(fc, nd.a, d, l, r)
            fc.vty.set(d, t)
            if if_false == 1 {
                _ir_emit(fc, OP_JZ, 0, d, 0, lab)
            } else {
                _ir_emit(fc, OP_JNZ, 0, d, 0, lab)
            }
            return
        }
    }
    let v = _lower_expr(fc, nid)
    if if_false == 1 {
        _ir_emit(fc, OP_JZ, 0, v, 0, lab)
    } else {
        _ir_emit(fc, OP_JNZ, 0, v, 0, lab)
    }
}

fn _loop_push(fc: FnCtx, cont: int, brk: int) {
    let d = fc.cells.get(C_LD)
    if len(fc.loops) > d * 2 {
        fc.loops.set(d * 2, cont)
        fc.loops.set(d * 2 + 1, brk)
    } else {
        fc.loops.push(cont)
        fc.loops.push(brk)
    }
    fc.cells.set(C_LD, d + 1)
}

fn _loop_pop(fc: FnCtx) {
    fc.cells.set(C_LD, fc.cells.get(C_LD) - 1)
}

/// 逆序执行 [base, C_DEF) 里登记的 defer（块退出 / return / break / continue）
fn _emit_defers(fc: FnCtx, base: int, ep: int) {
    let mut i = fc.cells.get(C_DEF) - 1
    while i >= base {
        let inner = fc.df.get(i)
        fc.cells.set(C_DEF, i)          // 防递归重复登记
        _lower_stmt(fc, inner, ep)
        i = i - 1
    }
    fc.cells.set(C_DEF, base)
}

fn _lower_block(fc: FnCtx, head: int, ep: int) {
    let base = fc.cells.get(C_DEF)
    let mut cur = head
    while cur >= 0 {
        _lower_stmt(fc, cur, ep)
        cur = fc.nodes.get(cur).nx
    }
    // 块退出：本块登记的 defer 逆序执行（LIFO）
    _emit_defers(fc, base, ep)
}

fn _lower_stmt(fc: FnCtx, id: int, ep: int) {
    let nd = fc.nodes.get(id)
    if nd.op == S_LET {
        let mut ty = nd.ty
        if nd.b >= 0 && nd.slot == 0 {
            // 无类型标注：按初值推类型（聚合要据此决定"区域"还是"寄存器"）
            ty = _ty_of_expr(fc, nd.b)
        }
        let d = _new_var(fc, nd.a, ty)
        if nd.b >= 0 {
            _lower_into(fc, nd.b, d)
        } else if _ty_is_agg(ty) {
            // 无初始化：整块清零
            let a0 = _vnew(fc)
            fc.vty.set(a0, TY_INT)
            _ir_emit(fc, OP_ADDRV, a0, 0, 0, -fc.vloc.get(d) - 1)
            _ir_emit(fc, OP_ZERO, 0, a0, 0, _ty_size(fc, ty))
        } else {
            let z = _vnew(fc)
            fc.vty.set(z, TY_INT)
            _ir_emit(fc, OP_CONST, z, 0, 0, 0)
            _ir_emit(fc, OP_MOV, d, z, 0, 0)
        }
        return
    }
    if nd.op == S_ASG_FIELD {
        let a = _addr_field(fc, nd.a, nd.b)
        let fty = fc.cells.get(C_ADDRTY)
        let v = _lower_expr(fc, nd.c)
        if _ty_is_agg(fty) {
            _ir_emit(fc, OP_COPY, 0, a, v, _ty_size(fc, fty))
        } else {
            _ir_emit(fc, OP_STORE, 0, a, v, 8)
        }
        return
    }
    if nd.op == S_ASG_INDEX {
        let a = _addr_index(fc, nd.a, nd.b)
        let ety = fc.cells.get(C_ADDRTY)      // 先取走：_lower_expr 会覆盖它
        let v = _lower_expr(fc, nd.c)
        if _ty_is_agg(ety) {
            _ir_emit(fc, OP_COPY, 0, a, v, _ty_size(fc, ety))
        } else if ety == TY_BYTE {
            _ir_emit(fc, OP_STORE8, 0, a, v, 0)
        } else {
            _ir_emit(fc, OP_STORE, 0, a, v, 8)
        }
        return
    }
    if nd.op == S_ASSIGN {
        let d = _var_id(fc, nd.a)
        _lower_into(fc, nd.b, d)
        return
    }
    if nd.op == S_IF {
        let lelse = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _lower_cond(fc, nd.a, lelse, 1)
        _lower_block(fc, nd.b, ep)
        _ir_emit(fc, OP_JMP, 0, 0, 0, lend)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lelse)
        _lower_block(fc, nd.n, ep)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_WHILE {
        let ltop = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
        _lower_cond(fc, nd.a, lend, 1)
        _loop_push(fc, ltop, lend)
        _lower_block(fc, nd.b, ep)
        _loop_pop(fc)
        _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_DEFER {
        let d = fc.cells.get(C_DEF)
        if len(fc.df) > d {
            fc.df.set(d, nd.a)
        } else {
            fc.df.push(nd.a)
        }
        fc.cells.set(C_DEF, d + 1)
        return
    }
    if nd.op == S_MATCH {
        _lower_match(fc, id, 0, ep)
        return
    }
    if nd.op == S_FOR {
        // 与 stage-0 同口径：上下界各求值**一次**，循环变量是隐藏的 int 变量
        let lo = _lower_expr(fc, nd.b)
        let hi = _lower_expr(fc, nd.c)
        // **上界必须钉进变量**：临时值的活跃区间不跨循环回边，下一轮比较会读到
        // 被别的临时值覆盖的寄存器（v2.17 实测：`for k in 0..3` 死循环）。
        let hiv = _new_var(fc, -1, TY_INT)
        _ir_emit(fc, OP_MOV, hiv, hi, 0, 0)
        let iv = _new_var(fc, nd.a, TY_INT)
        _ir_emit(fc, OP_MOV, iv, lo, 0, 0)
        let ltop = _newlab(fc.labs)
        let lcont = _newlab(fc.labs)
        let lend = _newlab(fc.labs)
        _ir_emit(fc, OP_LAB, 0, 0, 0, ltop)
        _ir_emit(fc, OP_JCMP, 0x8D, iv, hiv, lend)    // jge：i >= hi 就退出
        _loop_push(fc, lcont, lend)
        _lower_block(fc, nd.n, ep)
        _loop_pop(fc)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lcont)
        let one = _vnew(fc)
        fc.vty.set(one, TY_INT)
        _ir_emit(fc, OP_CONST, one, 0, 0, 1)
        _ir_emit(fc, OP_ADD, iv, iv, one, 0)
        _ir_emit(fc, OP_JMP, 0, 0, 0, ltop)
        _ir_emit(fc, OP_LAB, 0, 0, 0, lend)
        return
    }
    if nd.op == S_BREAK || nd.op == S_CONTINUE {
        let d = fc.cells.get(C_LD)
        if d < 1 {
            eprint("qlmc: break / continue 不在循环里")
            exit(2)
        }
        let mut l = fc.loops.get((d - 1) * 2 + 1)
        if nd.op == S_CONTINUE {
            l = fc.loops.get((d - 1) * 2)
        }
        _ir_emit(fc, OP_JMP, 0, 0, 0, l)
        return
    }
    if nd.op == S_RETURN {
        // 口径：**先定下返回值，再跑 defer**（stage-0 就是这么做的）。
        // 所以先求值并钉进变量，再 _emit_defers，最后才 RET。
        let mut v = 0
        let mut vty = TY_INT
        if nd.a >= 0 {
            let inz = fc.nodes.get(nd.a)
            if inz.op == E_STRUCTLIT || inz.op == E_ARRLIT {
                let ty = _ty_of_expr(fc, nd.a)
                let tmp = _new_var(fc, -1, ty)
                _lower_into(fc, nd.a, tmp)
                let av0 = _vnew(fc)
                fc.vty.set(av0, TY_INT)
                _ir_emit(fc, OP_ADDRV, av0, 0, 0, -fc.vloc.get(tmp) - 1)
                let av = _pin(fc, av0)
                fc.vty.set(av, ty)
                v = av
                vty = ty
            } else {
                let t = _lower_expr(fc, nd.a)
                vty = fc.vty.get(t)
                v = _pin(fc, t)
                fc.vty.set(v, vty)
            }
        }
        _emit_defers(fc, 0, ep)
        if v > 0 && _ty_is_agg(vty) {
            _ir_emit(fc, OP_RETAGG, 0, v, 0, _ty_size(fc, vty))
            return
        }
        _ir_emit(fc, OP_RET, 0, v, 0, 0)
        return
    }
    if nd.op == S_PRINT {
        let v = _lower_expr(fc, nd.a)
        if fc.vty.get(v) == TY_F64 {
            // f64：手写格式化（__f64_fmt）再按 str 打印（v2.42）
            // v2.55：值住 XMM，而 __f64_fmt 要的是**地址** —— 先落进一个槽。
            let pslot = _st_slot(fc)
            let pa = _vnew(fc)
            fc.vty.set(pa, TY_INT)
            _ir_emit(fc, OP_ADDRV, pa, 0, 0, pslot)
            _ir_emit(fc, OP_STORE, 0, pa, v, 8)
            let sz = _vnew(fc)
            fc.vty.set(sz, TY_INT)
            _ir_emit(fc, OP_CONST, sz, 0, 0, 96)
            _ir_emit(fc, OP_ARG, 0, sz, 0, 0)
            let buf = _vnew(fc)
            fc.vty.set(buf, TY_INT)
            _ir_emit(fc, OP_CALLRT, buf, 0, 0, RT_ALLOC)
            _ir_emit(fc, OP_ARG, 0, buf, 0, 0)
            _ir_emit(fc, OP_ARG, 0, pa, 0, 1)
            let n = _vnew(fc)
            fc.vty.set(n, TY_INT)
            _ir_emit(fc, OP_CALLRT, n, 0, 0, RT_F64FMT)
            let sv = _bi_mem_str(fc, buf, n)
            _ir_emit(fc, OP_PRINT, 0, sv, 0, TY_STR)
            return
        }
        if _ty_is_agg(fc.vty.get(v)) {
            eprint("qlmc: print 只支持 int / bool / str")
            exit(2)
        }
        _ir_emit(fc, OP_PRINT, 0, v, 0, fc.vty.get(v))
        return
    }
    if nd.op == S_EXIT {
        let v = _lower_expr(fc, nd.a)
        _ir_emit(fc, OP_EXIT, 0, v, 0, 0)
        return
    }
    if nd.op == S_EXPR {
        _lower_expr(fc, nd.a)
        return
    }
    eprint("qlmc: 不支持的语句节点 " + nd.op.to_str())
    exit(2)
}

fn _lower_fn(fc: FnCtx, fi: int) {
    let f = fc.fns.get(fi)
    fc.cells.set(C_CFI, fi)
    if f.body < 0 {
        return                  // @ffi 声明：没有函数体，只占一个 IAT 槽
    }
    let ep = _newlab(fc.labs)
    fc.cells.set(C_EP, ep)
    // 聚合返回走隐藏的 sret 指针（占第 0 个实参寄存器），其余实参顺延
    let mut argbase = 0
    if _ty_is_agg(f.ret_t) {
        let sv = _new_var(fc, -1, TY_INT)
        _ir_emit(fc, OP_PARAM, sv, 0, 0, 0)
        fc.cells.set(C_SRET, sv)
        argbase = 1
    }
    // 第一遍：把**所有**入参寄存器先落到变量里。这一步必须在任何拷贝之前——
    // 按值拷贝要用 ADDRV/COPY，而 ADDRV 的临时值会落在 R8-R11，正好是第 3/4 个
    // 实参寄存器；先拷贝就会把还没读的实参覆盖掉（v2.20 实测：两个聚合形参
    // 加 sret 时，第二个形参读成了第一个）。
    let pvs = vec[int].new(12)
    let mut k = 0
    while k < f.np {
        let pty = _param_type(fc, f, k)
        let ai = k + argbase
        if ai > 3 {
            // 第 5 个起走栈（v2.29）。imm 只记"第几个栈实参"，真正的
            // 字节偏移由发射器算（要加 8*nsaved，发射期才知道）。
            let si = ai - 4
            if _ty_is_agg(pty) {
                let p = _new_var(fc, -1, TY_INT)
                _ir_emit(fc, OP_PARAMSTK, p, 0, 0, si)
                pvs.push(k)
                pvs.push(p)
                pvs.push(pty)
            } else {
                let v = _new_var(fc, _param_name(fc, f, k), pty)
                _ir_emit(fc, OP_PARAMSTK, v, 0, 0, si)
            }
            k = k + 1
            continue
        }
        if _ty_is_agg(pty) {
            let p = _new_var(fc, -1, TY_INT)
            _ir_emit(fc, OP_PARAM, p, 0, 0, ai)
            pvs.push(k)
            pvs.push(p)
            pvs.push(pty)
        } else {
            let v = _new_var(fc, _param_name(fc, f, k), pty)
            _ir_emit(fc, OP_PARAM, v, 0, 0, ai)
        }
        k = k + 1
    }
    // 第二遍：聚合形参按值拷进自己的帧区域
    let mut pi = 0
    while pi < len(pvs) {
        let pk = pvs.get(pi)
        let pp = pvs.get(pi + 1)
        let pty = pvs.get(pi + 2)
        let v = _new_var(fc, _param_name(fc, f, pk), pty)
        let a0 = _vnew(fc)
        fc.vty.set(a0, TY_INT)
        _ir_emit(fc, OP_ADDRV, a0, 0, 0, -fc.vloc.get(v) - 1)
        _ir_emit(fc, OP_COPY, 0, a0, pp, _ty_size(fc, pty))
        pi = pi + 3
    }
    _lower_block(fc, f.body, ep)
    if _ty_is_agg(f.ret_t) {
        _ir_emit(fc, OP_RETSRET, 0, 0, 0, 0)
    } else {
        let z = _vnew(fc)
        fc.vty.set(z, TY_INT)
        _ir_emit(fc, OP_CONST, z, 0, 0, 0)
        _ir_emit(fc, OP_RET, 0, z, 0, 0)
    }
    _ir_emit(fc, OP_LAB, 0, 0, 0, ep)
}

// ---------------------------------------------------------------------------
// 优化层（v2.44）：降级之后、分配之前跑，只看 IR，不认识 AST
// ---------------------------------------------------------------------------
//
// 为什么卡在这个位置：分配看活跃区间（`vstart`/`vend`），发射看位置（`vloc`）。
// 所以优化**只改"哪条指令还在"，不改指令的下标** —— 被消掉的指令写成
// `OP_NOP`，发射时一条字节都不发。这样 `vstart`/`vend`/标签位置全部保持有效，
// 不需要重建任何索引（重建过一遍就会踩 §7.17 那类布局敏感问题）。
//
// 三条 pass，都只做"局部可证"的变换：
//   1. 常量折叠：`OP_CONST` 定义的临时值参与算术/位运算就当场算掉。
//      临时值是**单赋值**的（`_vnew` 每次给新号），所以"这个临时值等于常数"
//      在整个函数里都成立，不需要支配树、也不需要 SSA 重命名。
//   2. 常量进变量：`MOV 变量, 常量临时值` → `CONST 变量, v`（省一次寄存器搬运）。
//   3. 空跳删除：`jmp L` 而 L 就在下一条（中间只隔着 `OP_LAB`）。
//
// **不做的**（留个记号，免得下次又"顺手"加进来）：
//   · 拷贝传播 / 临时值合并：v2.43 的 `_map_set` 段错误就是这类"合并两个定义"
//     引起的，变量不是 SSA，别碰。
//   · 死代码删除：得先把"哪些操作数是被读的"逐条列清楚（`OP_MEMCPYN` 的字节数
//     在 dst 槽、`OP_JCMP` 的 cc 在 dst 槽），列错一条就是静默删掉活代码。
//   · 强度削减 / CSE / LICM：都要循环信息与支配关系，是另一个量级的工程。
const OP_NOP = 56      // 优化掉的位置：发射时什么都不发

/// 二元运算能不能折、折成多少。返回 1 表示能折，值写进 `out.get(0)`。
///
/// 用 vec 当出参是刻意的：写成"返回 (ok, v) 两元组"要加结构体，
/// 而写成 `let mut fok/fv` + if 链会在分支里重赋值再跨 join 用 —— 那正是
/// 坑表 #45 的形状。这里干脆让每个分支自己把结果写进 out。
fn _fold_bin(op: int, x: int, y: int, out: vec[int]) -> int {
    if op == OP_ADD {
        out.set(0, x + y)
        return 1
    }
    if op == OP_SUB {
        out.set(0, x - y)
        return 1
    }
    if op == OP_MUL {
        out.set(0, x * y)
        return 1
    }
    if op == OP_DIV {
        // 除以 0 留着让运行期 idiv 抛（口径不变）；-1 也跳过：INT64_MIN/-1 会 #DE，
        // 编译器自己算也会溢出，两边都不该"折"。
        if y != 0 && y != -1 {
            out.set(0, x / y)
            return 1
        }
        return 0
    }
    if op == OP_MOD {
        if y != 0 && y != -1 {
            out.set(0, x % y)
            return 1
        }
        return 0
    }
    if op == OP_AND {
        out.set(0, x & y)
        return 1
    }
    if op == OP_OR {
        out.set(0, x | y)
        return 1
    }
    if op == OP_XOR {
        out.set(0, x ^ y)
        return 1
    }
    // 移位：x86 把计数掩到 63，语言层对 >= 64 是未定义。**只在 [0,63] 内折**，
    // 免得把"未定义"折成某个具体值。
    if y >= 0 && y < 64 {
        if op == OP_SHL {
            out.set(0, x << y)
            return 1
        }
        if op == OP_SAR {
            out.set(0, x >> y)
            return 1
        }
        if op == OP_SHR {
            out.set(0, x >>> y)
            return 1
        }
    }
    return 0
}

/// 一元运算同理
fn _fold_un(op: int, x: int, out: vec[int]) -> int {
    if op == OP_NEG {
        out.set(0, 0 - x)
        return 1
    }
    if op == OP_BNOT {
        out.set(0, 0 - x - 1)          // ~x = -x-1（64 位补码）
        return 1
    }
    if op == OP_NOT {
        if x == 0 {
            out.set(0, 1)
        } else {
            out.set(0, 0)
        }
        return 1
    }
    if op == OP_NZ {
        if x != 0 {
            out.set(0, 1)
        } else {
            out.set(0, 0)
        }
        return 1
    }
    return 0
}

/// 这个操作码的 `dst` 槽是"写一个 vreg"吗？
///
/// 不是的情况分两类：① dst 槽里放的是别的东西（`OP_JCMP` 放 setcc 机器码、
/// `OP_MEMCPYN` 放字节数、`OP_LAB`/`OP_JMP`/`OP_STKALLOC`/`OP_STKFREE` 用 imm）；
/// ② 根本没有 dst（`OP_STORE`/`OP_COPY`/`OP_ZERO`/`OP_ZERON`/`OP_RETAGG`/
/// `OP_RET`/`OP_PRINT`/`OP_EXIT`/`OP_ARG`/`OP_STKARG`/`OP_JZ`/`OP_JNZ`）。
fn _opt_writes(op: int) -> int {
    if op == OP_LAB || op == OP_JMP || op == OP_JCMP || op == OP_JCMPI { return 0 }
    if op == OP_JCMPVLEN || op == OP_JCMPSTR { return 0 }
    if op == OP_MEMCPYN || op == OP_STKALLOC || op == OP_STKFREE { return 0 }
    if op == OP_STORE || op == OP_COPY || op == OP_ZERO || op == OP_ZERON { return 0 }
    if op == OP_RETAGG || op == OP_RETSRET || op == OP_RET { return 0 }
    if op == OP_PRINT || op == OP_EXIT || op == OP_ARG || op == OP_STKARG { return 0 }
    if op == OP_JZ || op == OP_JNZ || op == OP_NOP { return 0 }
    // STORE* 系列不写寄存器，dst 槽里放的是"要存的值"
    if op == OP_STORED || op == OP_STOREX { return 0 }
    if op == OP_STORE8D || op == OP_STORE8X || op == OP_STORE8I { return 0 }
    // v2.55：FBIN/ITOF 的 dst 不再是"要写入的地址"，而是**被写的寄存器/槽**
    return 1
}

/// 每个 vreg 被定义几次。
///
/// **这一步不能省**：qlmc 的"临时值"并不是严格单赋值的。`_map_get` 就是
/// 先 `CONST d, 0`（未命中时的默认值）、命中后再 `LOAD d, va` —— 同一个 vreg
/// 两个定义。要是照"临时值单赋值"去传播常量，就会把 `return m.get(k)`
/// 折成 `return 0`（v2.44 实测：s23_map_grow 的 get 全变 0）。
fn _opt_ndef(ir: vec[Ir], ndef: vec[int]) {
    let n = len(ir)
    let mut i = 0
    while i < n {
        let ins = ir.get(i)
        if ins.dst > 0 && ins.dst < len(ndef) && _opt_writes(ins.op) == 1 {
            ndef.set(ins.dst, ndef.get(ins.dst) + 1)
        }
        i = i + 1
    }
}

/// 这个操作码"算出 dst 之外没有任何副作用"吗？
///
/// **只列真正安全的那些**：不碰内存、不调用、不跳转。`OP_LOAD`/`OP_LOAD8`
/// 虽然也是"纯"的，但删掉它就少一次可能 AV 的访存，口径会变 —— 不列。
fn _opt_pure(op: int) -> int {
    if op == OP_CONST || op == OP_MOV { return 1 }
    if op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD {
        return 1
    }
    if op == OP_AND || op == OP_OR || op == OP_XOR { return 1 }
    if op == OP_SHL || op == OP_SAR || op == OP_SHR { return 1 }
    if op == OP_NEG || op == OP_NOT || op == OP_NZ || op == OP_BNOT { return 1 }
    if op == OP_CMP || op == OP_FCMP { return 1 }
    if op == OP_DIVC { return 1 }
    // v2.81：`OP_BINI`（dst = a <sub> imm）也是纯运算。以前没列进来，导致
    // 归纳削减把 `t = i*C` 变成死代码之后删不掉，热循环里白留一条 `imul`。
    if op == OP_BINI { return 1 }
    return 0
}

/// 统计一条指令读了哪些 vreg。
///
/// 规则：`a` 和 `b` 非 0 就是被读（对所有操作码都成立）；`dst` 绝大多数是**写**，
/// 只有 `OP_MEMCPYN` 例外（字节数塞在 dst 槽里，是被读的）。
/// `OP_JCMP` 的 dst 是 setcc 机器码（不是 vreg），所以不碰它 —— 漏了会把一个
/// 机器码当成"用了某个 vreg"，无害但会白白保住一条死指令。
fn _opt_mark(ins: Ir, use: vec[int]) {
    if ins.a > 0 && ins.a < len(use) {
        use.set(ins.a, use.get(ins.a) + 1)
    }
    // OP_BINI / OP_CMPI 的 `b` 槽放的是子操作码 / setcc 机器码，不是 vreg
    if ins.op != OP_BINI && ins.op != OP_CMPI && ins.op != OP_DIVC &&
       ins.op != OP_JCMPI {
        if ins.b > 0 && ins.b < len(use) {
            use.set(ins.b, use.get(ins.b) + 1)
        }
    }
    if ins.op == OP_MEMCPYN && ins.dst > 0 && ins.dst < len(use) {
        use.set(ins.dst, use.get(ins.dst) + 1)
    }
    // STORE* 系列把"值"放在 dst 槽 —— 那是被读的。
    // （v2.55：FBIN/ITOF 的 dst 已改成真正的"被写"，从这里移除了）
    if ins.op == OP_STORED || ins.op == OP_STOREX ||
       ins.op == OP_STORE8D || ins.op == OP_STORE8X || ins.op == OP_STORE8I {
        if ins.dst > 0 && ins.dst < len(use) {
            use.set(ins.dst, use.get(ins.dst) + 1)
        }
    }
}

/// 相邻拷贝传播（v2.57）：`OP_MOV d, a` 后面紧跟**唯一**读 `d` 的那条指令时，
/// 把那条指令的读操作数换成 `a`，MOV 消成 NOP。
///
/// 为什么值得专门做一次：qlmc 的降级期"每个值都先落一个临时 vreg"（`_lower_into`
/// 会先 `_lower_expr` 再 `OP_MOV`），于是到处是纯搬运 —— fib 的 25 条里 6 条是
/// `mov rax, r8` / `mov r12, rbx; mov rax, r12` 这种。这不是某个既有 pass 顺手
/// 能消掉的，得单独一趟。
///
/// 安全边界（三条都不能省）：
///   ① `d` 必须是**单定义、单使用**的临时值（不是变量、不是聚合）；
///   ② 只换 `a` / `b` 这两个**只读**操作数 —— **`dst` 绝不能动**：`x = x op y`
///      这种形状里 dst 也是被读的，换了就错；
///   ③ 读 `d` 的那条指令不能同时写 `d`（否则它既读又写，换掉 dst 就错）。
fn _opt_copy(fc: FnCtx, ir: vec[Ir], use: vec[int], ndef: vec[int]) {
    let n = len(ir)
    let mut i = 0
    while i + 1 < n {
        let ins = ir.get(i)
        if ins.op == OP_MOV && ins.dst > 0 && ins.a > 0 && ins.dst != ins.a {
            let d = ins.dst
            let a = ins.a
            if fc.vpin.get(d) == 0 && use.get(d) == 1 && ndef.get(d) == 1 &&
               _ty_is_agg(fc.vty.get(d)) == 0 && _ty_is_agg(fc.vty.get(a)) == 0 {
                let nx = ir.get(i + 1)
                let mut hit = 0
                if nx.a == d && nx.b != d {
                    hit = 1
                }
                if nx.b == d && nx.a != d {
                    hit = 2
                }
                if hit > 0 && nx.dst != d {
                    let mut na = nx.a
                    let mut nb = nx.b
                    if hit == 1 {
                        na = a
                    } else {
                        nb = a
                    }
                    ir.set(i + 1, Ir { op: nx.op, dst: nx.dst, a: na, b: nb, imm: nx.imm })
                    ir.set(i, Ir { op: OP_NOP, dst: 0, a: 0, b: 0, imm: 0 })
                    use.set(d, 0)
                }
            }
        }
        i = i + 1
    }
}

/// 强度削减 / 立即数压平：把 `dst = a <op> C`（C 是编译期已知常量）换成更省的形状。
///
/// 三条原则：
///   ① **只在数学上等价时才改**。`x * 2^k` 与 `x << k` 对负数、对溢出都逐位一致
///      （64 位补码），所以安全；`x / 2^k` 与 `x >> k` **不等价**（负数时一个向零
///      截断、一个向负无穷取整），那个要走下面单独的有符号序列，这里不动。
///   ② 常量装不进 imm32 就原样留着（`x & 0xFFFF000000000000` 这种）。
///   ③ 每个分支自己 `ir.set` 然后 `return` —— 不做"先算标志位、跨 join 再判断"，
///      那是坑表 #45 的形状。
fn _opt_strength(fc: FnCtx, ir: vec[Ir], i: int, op: int, ins: Ir,
                 cv: int, cok: vec[int], cval: vec[int], ndef: vec[int]) {
    // ---- 化成空操作（MOV）----
    if op == OP_ADD || op == OP_SUB || op == OP_OR || op == OP_XOR {
        if cv == 0 {
            ir.set(i, Ir { op: OP_MOV, dst: ins.dst, a: ins.a, b: 0, imm: 0 })
            return
        }
    }
    if op == OP_MUL {
        if cv == 1 {
            ir.set(i, Ir { op: OP_MOV, dst: ins.dst, a: ins.a, b: 0, imm: 0 })
            return
        }
        if cv == -1 {
            ir.set(i, Ir { op: OP_NEG, dst: ins.dst, a: ins.a, b: 0, imm: 0 })
            return
        }
    }
    if op == OP_AND {
        if cv == -1 {
            ir.set(i, Ir { op: OP_MOV, dst: ins.dst, a: ins.a, b: 0, imm: 0 })
            return
        }
    }
    if op == OP_SHL || op == OP_SAR || op == OP_SHR {
        if cv == 0 {
            ir.set(i, Ir { op: OP_MOV, dst: ins.dst, a: ins.a, b: 0, imm: 0 })
            return
        }
    }
    // ---- 化成常数 ----
    if op == OP_MUL && cv == 0 {
        ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0, imm: 0 })
        if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
            cok.set(ins.dst, 1)
            cval.set(ins.dst, 0)
        }
        return
    }
    if op == OP_AND && cv == 0 {
        ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0, imm: 0 })
        if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
            cok.set(ins.dst, 1)
            cval.set(ins.dst, 0)
        }
        return
    }
    if op == OP_OR && cv == -1 {
        ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0, imm: -1 })
        if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
            cok.set(ins.dst, 1)
            cval.set(ins.dst, -1)
        }
        return
    }
    // ---- 乘 2 的幂 → 左移 ----
    if op == OP_MUL && cv > 0 && cv <= 4611686018427387904 {
        if (cv & (cv - 1)) == 0 {
            let mut k = 0
            let mut t = cv
            while t > 1 {
                t = t >> 1
                k = k + 1
            }
            ir.set(i, Ir { op: OP_BINI, dst: ins.dst, a: ins.a, b: OP_SHL, imm: k })
            return
        }
    }
    // ---- 常数除法 → 魔数乘法（v2.48）----
    // 只处理 2 <= d <= 2^31-1：再大 `2^s*r64` 会溢出 int64。
    // d 是 1 的情况上面已经化成 MOV/CONST；d <= 0 保持 idiv（符号要另外处理）。
    if op == OP_DIV || op == OP_MOD {
        if cv >= 2 && cv <= 2147483647 {
            ir.set(i, Ir { op: OP_DIVC, dst: ins.dst, a: ins.a, b: op, imm: cv })
        }
        return
    }
    // ---- 其余能装进 imm32 的 → 带立即数的二元运算 ----
    if op == OP_SHL || op == OP_SAR || op == OP_SHR {
        if cv > 0 && cv < 64 {
            ir.set(i, Ir { op: OP_BINI, dst: ins.dst, a: ins.a, b: op, imm: cv })
        }
        return
    }
    // **只放行发射器真支持的子操作**。`OP_DIV` / `OP_MOD` 不在这里 —— 有符号除法
    // 不能压成一条 ALU 立即数指令（要向零截断），它们走 _opt_divmod 的魔数序列。
    // v2.46 踩过：兜底把 OP_MOD 也收进来，发射器的 ext 链默认落到 add，
    // `(i*7) % 13` 静默变成 `(i*7) + 13`，校验和从 119999988 变成 1400000190000000。
    if op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_AND ||
       op == OP_OR || op == OP_XOR {
        if cv >= -2147483648 && cv <= 2147483647 {
            ir.set(i, Ir { op: OP_BINI, dst: ins.dst, a: ins.a, b: op, imm: cv })
        }
    }
}

/// 地址计算 + 访存能不能融合？返回融合后的操作码，0 = 不能。
fn _fuse_op(addr_op: int, mem_op: int, imm: int) -> int {
    // `OP_ADD str, int` + 字节访存 → 带 SIB 的 [a + b*1]（字符串下标）
    if addr_op == OP_ADD {
        if mem_op == OP_LOAD8 { return OP_LOAD8I }
        if mem_op == OP_STORE8 { return OP_STORE8I }
        return 0
    }
    if addr_op == OP_ADDRF {
        if mem_op == OP_LOAD { return OP_LOADD }
        if mem_op == OP_STORE { return OP_STORED }
        if mem_op == OP_LOAD8 { return OP_LOAD8D }
        if mem_op == OP_STORE8 { return OP_STORE8D }
        return 0
    }
    // ADDRX / ADDRXN：只融合步长 8 的（SIB 的 scale 编码里 3 就是 ×8）
    if imm != 8 {
        return 0
    }
    if mem_op == OP_LOAD { return OP_LOADX }
    if mem_op == OP_STORE { return OP_STOREX }
    if mem_op == OP_LOAD8 { return OP_LOAD8X }
    if mem_op == OP_STORE8 { return OP_STORE8X }
    return 0
}

/// 地址计算与访存融合（v2.46）。这是 `vec.get(i)` / `v[i]` / `s[i]` 热路径上
/// 最大的一块 —— 原来每条访问都要 `lea` + 两条 `mov` 算地址。
///
/// 条件：地址临时值 `t` **单定义、单使用**，且它的唯一使用者就是那条访存。
/// 这样把地址指令换成 `OP_NOP` 不会影响别的使用者。
/// 维护 `use[]`：`t` 少读一次（其余操作数的读数在融合前后一一对应，净不变）。
fn _opt_fuse(fc: FnCtx, ir: vec[Ir], use: vec[int], ndef: vec[int]) {
    let n = len(ir)
    let mut i = 0
    while i < n {
        let ins = ir.get(i)
        let mut isaddr = ins.op == OP_ADDRF || ins.op == OP_ADDRX || ins.op == OP_ADDRXN
        // `OP_ADD` 只在**整数**相加时才当地址用（str 拼接也是 OP_ADD）
        if ins.op == OP_ADD && ins.dst > 0 && fc.vty.get(ins.dst) == TY_INT {
            isaddr = 1
        }
        if isaddr {
            let t = ins.dst
            if t > 0 && t < len(use) && fc.vpin.get(t) == 0 &&
               use.get(t) == 1 && ndef.get(t) == 1 {
                // 往后找唯一的使用者；遇到控制流就放弃（临时值不会跨分支）
                let mut j = i + 1
                let mut hit = -1
                let mut go = 1
                while go == 1 && j < n && j < i + 8 {
                    let nx = ir.get(j)
                    if nx.a == t || nx.b == t || nx.dst == t {
                        hit = j
                        go = 0
                    } else {
                        if nx.op == OP_LAB || nx.op == OP_JMP || nx.op == OP_JCMP ||
                           nx.op == OP_JCMPI ||
                           nx.op == OP_JCMPVLEN || nx.op == OP_JCMPSTR ||
                           nx.op == OP_JZ || nx.op == OP_JNZ {
                            go = 0
                        }
                        j = j + 1
                    }
                }
                if hit >= 0 {
                    let u = ir.get(hit)
                    // v2.55：**f64 不参与访存融合**。融合出来的 LOADD/STORED 是
                    // 整数路径（`mov reg, [mem]`），而 f64 值住 XMM，要发 movsd。
                    // 融合会把 OP_LOAD/OP_STORE 的 f64 分支整个绕过去 ——
                    // 现象是"结构体 f64 字段读出来是 0，且多一条死写"。
                    let mut nofuse = 0
                    if u.op == OP_LOAD || u.op == OP_STORE {
                        if u.dst > 0 && u.dst < len(fc.vty) {
                            if fc.vty.get(u.dst) == TY_F64 {
                                nofuse = 1
                            }
                        }
                        if u.op == OP_STORE && u.b > 0 && u.b < len(fc.vty) {
                            if fc.vty.get(u.b) == TY_F64 {
                                nofuse = 1
                            }
                        }
                    }
                    if nofuse == 1 {
                        // 什么都不做
                    } else if u.a == t {
                        let fop = _fuse_op(ins.op, u.op, ins.imm)
                        if fop == OP_LOADD {
                            ir.set(hit, Ir { op: OP_LOADD, dst: u.dst, a: ins.a, b: 0, imm: ins.imm })
                        } else if fop == OP_LOADX {
                            ir.set(hit, Ir { op: OP_LOADX, dst: u.dst, a: ins.a, b: ins.b, imm: 0 })
                        } else if fop == OP_LOAD8D {
                            ir.set(hit, Ir { op: OP_LOAD8D, dst: u.dst, a: ins.a, b: 0, imm: ins.imm })
                        } else if fop == OP_LOAD8X {
                            ir.set(hit, Ir { op: OP_LOAD8X, dst: u.dst, a: ins.a, b: ins.b, imm: 0 })
                        } else if fop == OP_STORED {
                            ir.set(hit, Ir { op: OP_STORED, dst: u.b, a: ins.a, b: 0, imm: ins.imm })
                        } else if fop == OP_STOREX {
                            ir.set(hit, Ir { op: OP_STOREX, dst: u.b, a: ins.a, b: ins.b, imm: 0 })
                        } else if fop == OP_STORE8D {
                            ir.set(hit, Ir { op: OP_STORE8D, dst: u.b, a: ins.a, b: 0, imm: ins.imm })
                        } else if fop == OP_STORE8X {
                            ir.set(hit, Ir { op: OP_STORE8X, dst: u.b, a: ins.a, b: ins.b, imm: 0 })
                        } else if fop == OP_LOAD8I {
                            ir.set(hit, Ir { op: OP_LOAD8I, dst: u.dst, a: ins.a, b: ins.b, imm: 0 })
                        } else if fop == OP_STORE8I {
                            ir.set(hit, Ir { op: OP_STORE8I, dst: u.b, a: ins.a, b: ins.b, imm: 0 })
                        }
                        if fop > 0 {
                            ir.set(i, Ir { op: OP_NOP, dst: 0, a: 0, b: 0, imm: 0 })
                            use.set(t, use.get(t) - 1)
                            // **必须把基址/索引的活跃区间延到 hit**（v2.46 踩过）：
                            // 它们的最后一次使用从第 i 条搬到了第 hit 条，而
                            // `vend` 还是 `_ir_emit` 当初记的 i。不延的话分配器
                            // 会认为它们在第 i 条就死了，把那个寄存器中途复用掉
                            // —— 现象是数组/切片用例**间歇** AV（取决于周围代码）。
                            if ins.a > 0 && ins.a < len(fc.vend) {
                                if fc.vend.get(ins.a) < hit {
                                    fc.vend.set(ins.a, hit)
                                }
                            }
                            if ins.b > 0 && ins.b < len(fc.vend) {
                                if fc.vend.get(ins.b) < hit {
                                    fc.vend.set(ins.b, hit)
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

/// 死临时值删除：临时值（`vpin == 0`）的定义如果一次都没被读，且操作码是纯的，
/// 就把那条指令换成 `OP_NOP`。**只动临时值** —— 变量不是 SSA，删它的定义会
/// 改变别的路径上看到的值。
///
/// **倒着扫一趟就够**（不用迭代到不动点）：删掉一条指令时把它操作数的使用计数
/// 减掉，而那些操作数定义在更前面 —— 倒序扫描还没走到它们，所以同一条链上的
/// 死定义会在同一趟里被连着删掉。
fn _opt_dce(fc: FnCtx, use: vec[int]) {
    let ir = fc.ir
    let mut i = len(ir) - 1
    while i >= 0 {
        let ins = ir.get(i)
        if ins.dst > 0 && ins.dst < len(use) && _opt_pure(ins.op) == 1 {
            if fc.vpin.get(ins.dst) == 0 && use.get(ins.dst) == 0 {
                if ins.a > 0 && ins.a < len(use) {
                    use.set(ins.a, use.get(ins.a) - 1)
                }
                if ins.b > 0 && ins.b < len(use) {
                    use.set(ins.b, use.get(ins.b) - 1)
                }
                ir.set(i, Ir { op: OP_NOP, dst: 0, a: 0, b: 0, imm: 0 })
            }
        }
        i = i - 1
    }
}

/// 找 label id 对应的 `OP_LAB` 指令下标（-1 = 没有）。
/// 分支指令的 `imm` 存的是**标签 id**（不是位置），所以回边检测要先换成下标。
fn _lab_index(ir: vec[Ir], id: int) -> int {
    let n = len(ir)
    let mut i = 0
    while i < n {
        let ins = ir.get(i)
        if ins.op == OP_LAB && ins.imm == id {
            return i
        }
        i = i + 1
    }
    return -1
}

/// 在 `at` 处插入一条指令（把后面整体右移一格）。
///
/// 为什么可以直接移位：**分支的 `imm` 是标签 id，不是指令下标**，所以移动
/// 指令不会破坏任何跳转。要修的是每个 vreg 的活跃区间（`vstart`/`vend`），
/// 它们存的是下标，`>= at` 的都要 +1。
fn _ir_insert(fc: FnCtx, at: int, op: int, dst: int, a: int, b: int, imm: int) {
    let ir = fc.ir
    ir.push(Ir { op: OP_NOP, dst: 0, a: 0, b: 0, imm: 0 })
    let mut k = len(ir) - 1
    while k > at {
        ir.set(k, ir.get(k - 1))
        k = k - 1
    }
    ir.set(at, Ir { op: op, dst: dst, a: a, b: b, imm: imm })
    let mut v = 0
    while v < len(fc.vstart) {
        if fc.vstart.get(v) >= at {
            fc.vstart.set(v, fc.vstart.get(v) + 1)
        }
        if fc.vend.get(v) >= at {
            fc.vend.set(v, fc.vend.get(v) + 1)
        }
        v = v + 1
    }
}

/// `v` 在 `h` 之前的**最后一次定义**如果是常量，返回该常量；否则返回 -1。
/// 只认 `OP_CONST` —— `let n = 20000000` 这种变量在 IR 里就是一条 CONST。
fn _const_before(ir: vec[Ir], v: int, h: int) -> int {
    let mut at = 0 - 1
    let mut k = 0
    while k < h {
        let x = ir.get(k)
        if x.dst == v && _opt_writes(x.op) == 1 {
            at = k
        }
        k = k + 1
    }
    if at < 0 {
        return -1
    }
    let c = ir.get(at)
    if c.op != OP_CONST {
        return -1
    }
    return c.imm
}

/// 归纳削减（v2.81）：把循环里的 `(i * C) % D` 换成"递增计数器 + 条件回绕"。
///
/// 这是 qlmc 与 stage-0 最大的单点差距：stage-0 的 `opt_mod_inductive` 让
/// b1_int 的热循环只有 9 条指令，qlmc 一直是 21 条（每轮一次 64 位 `mul` 的
/// 魔数除法）。CI 上 b1_int / b8_threads1 对 stage-0 差 1.5×，就是这一条。
///
/// **为什么以前没搬**：stage-0 那版依赖"t 非负"的范围分析（`analyze_nonneg`），
/// qlmc 没有。这里换成一个**窄得多但可判定**的证明：
///
///   `t = i * C`，`i` 在循环外被初始化为常量 `k >= 0`，循环内**唯一**定义是
///   `i = i + s`（`s > 0`）→ 每一轮都有 `i >= k >= 0` → `t >= 0`（`C > 0`）。
///
/// 再要求循环守卫是 `i < N`（常量 `N`）且 `C * N < 2^62`，顺带排掉 `t` 溢出。
/// 两个条件任一不成立就**原样不动** —— 宁可少优化，不能算错。
///
/// 变换（`D` 是模数，`0 < C < D` 保证一次条件减就够）：
///
///   前导（循环头之前）：`v = (k * C) % D`      ← 常量，编译期算好
///   循环体：`r = v`（替换原来的 DIVC）；`i = i + s` 之后 `v += C`，
///           若 `v >= D` 则 `v -= D`
/// 归纳削减的**变换**部分（拆出来只为压帧槽：合在 `_opt_mod_ind` 里要 417 个槽，
/// 上限 416）。参数是已经验证过的形状 + 守卫信息。
fn _mod_ind_apply(fc: FnCtx, h: int, hit: int, di: int, i0: int, c: int, dd: int,
                  k0: int, step: int, guard: int, lim: int, dst: int) {
    let ir = fc.ir
        let r0 = (k0 * c) % dd
        let v = _new_var(fc, -1, TY_INT)
        let lskip = _newlab(fc.labs)
        let mut dbase = di
        if guard == 1 {
            // 守卫版：快路在前（fall-through 不了，所以让"快"的那侧是被跳到的）
            let lfast = _newlab(fc.labs)
            let ldone = _newlab(fc.labs)
            let lv = _new_var(fc, -1, TY_INT)
            _ir_insert(fc, hit + 1, OP_JMP, 0, 0, 0, ldone)
            _ir_insert(fc, hit + 2, OP_LAB, 0, 0, 0, lfast)
            _ir_insert(fc, hit + 3, OP_MOV, dst, v, 0, 0)
            _ir_insert(fc, hit + 4, OP_LAB, 0, 0, 0, ldone)
            _ir_insert(fc, hit, OP_JCMP, 0x8C, i0, lv, lfast)   // i0 < LIMIT → 快路
            dbase = di + 5
            _ir_insert(fc, h, OP_CONST, lv, 0, 0, lim)
        } else {
            // 常量上界版：直接把 DIVC 换成 `r = v`。
            // **下标是 `hit` 不是 `hit+1`** —— 循环头的 CONST 是在最后才插的
            // （v2.86 重构时这里写成 hit+1，把 DIVC 后面那条 `add acc, r`
            // 覆盖掉了：b1 校验和从 119999988 变成 0，静默错）。
            ir.set(hit, Ir { op: OP_MOV, dst: dst, a: v, b: 0, imm: 0 })
        }
        // 1) 循环体尾部的回绕（下标最大，先插不影响前面的下标）
        // 回绕用**条件减**（`if v >= D { v -= D }`），不用无分支序列。
        //
        // v2.88 试过 `t = v-D; m = t>>63; m &= D; v = t+m`（4 条算术、无分支）：
        //   b8_threads1 只快 2~3%，而 **b1_int 慢了 6.6×**（21ms → 138ms）。
        // 原因：它要多两个临时值，b1 的 `main` 里寄存器池（7 个）不够，溢出到
        // 帧槽，热循环里多出访存。**b1 是延迟敏感型，b8 是吞吐型** —— 同一个
        // 变换在两边方向相反，所以保留分支版（分支在 13 周期模式上预测得很好）。
        _ir_insert(fc, dbase + 1, OP_BINI, v, v, OP_ADD, step)
        _ir_insert(fc, dbase + 2, OP_JCMPI, 0x8C, v, dd, lskip)
        _ir_insert(fc, dbase + 3, OP_BINI, v, v, OP_SUB, dd)
        _ir_insert(fc, dbase + 4, OP_LAB, 0, 0, 0, lskip)
        // 2) 循环头之前的常量初始化（h 在最前，最后插）
        _ir_insert(fc, h, OP_CONST, v, 0, 0, r0)
}

fn _vec_has(v: vec[int], x: int) -> bool {
    let n = len(v)
    let mut i = 0
    while i < n {
        if v.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

fn _opt_mod_ind(fc: FnCtx, cok: vec[int], cval: vec[int], use: vec[int],
                ndef: vec[int]) {
    let ir = fc.ir
    let mut n = len(ir)
    let mut i = 0
    // 已变换过的循环（按**头标签 id** 记 —— 插入指令会让下标漂移，标签 id 不会）。
    // 守卫版会把原 DIVC 留在原地（只有快路被换成 MOV），所以不记的话重扫会
    // 一遍遍地对同一个窗口做变换，直到把帧槽吃光（v2.87 实测：work 要 417 个槽）。
    let mut done = vec[int].new(4)
    while i < n {
        let ins = ir.get(i)
        if ins.op != OP_JMP && ins.op != OP_JCMP && ins.op != OP_JCMPI {
            i = i + 1
            continue
        }
        let lid = ins.imm
        let h = _lab_index(ir, lid)
        let e = i
        i = i + 1
        if h < 0 || h >= e {
            continue                     // 不是回边
        }
        if _vec_has(done, lid) {
            continue                     // 这个循环已经变换过
        }
        if DBG_MODIND == 1 {
            eprint("[modind] 回边 h=" + h.to_str() + " e=" + e.to_str())
        }
        // 这个循环里找 `t % D`（OP_DIVC，b 槽是 OP_MOD）
        let mut d = h
        let mut hit = 0 - 1
        while d <= e {
            let w = ir.get(d)
            if w.op == OP_DIVC && w.b == OP_MOD && w.imm >= 2 && w.imm <= 2147483647 {
                hit = d
                d = e + 1
            } else {
                d = d + 1
            }
        }
        if hit < 0 {
            if DBG_MODIND == 1 { eprint("[modind] 循环内没有 DIVC-MOD") }
            continue
        }
        let w = ir.get(hit)
        let t = w.a
        let dd = w.imm
        // t 在循环内必须**只有一处**定义，且是 `t = i0 * C`
        let mut dt = 0 - 1
        let mut ndef_t = 0
        let mut k = h
        while k <= e {
            let x = ir.get(k)
            if x.dst == t && _opt_writes(x.op) == 1 {
                ndef_t = ndef_t + 1
                dt = k
            }
            k = k + 1
        }
        if ndef_t != 1 {
            if DBG_MODIND == 1 { eprint("[modind] t 定义次数 " + ndef_t.to_str()) }
            continue
        }
        let mt = ir.get(dt)
        if mt.op != OP_BINI || mt.b != OP_MUL || mt.a <= 0 {
            if DBG_MODIND == 1 { eprint("[modind] t 的定义 op=" + mt.op.to_str() + " b=" + mt.b.to_str() + " a=" + mt.a.to_str()) }
            continue
        }
        let i0 = mt.a
        let c = mt.imm
        if c < 1 || c >= dd {
            continue
        }
        // i0 在循环内必须只有一处定义，且是 `i0 = i0 + s`（s > 0），且在用之后
        let mut di = 0 - 1
        let mut ndef_i = 0
        k = h
        while k <= e {
            let x = ir.get(k)
            if x.dst == i0 && _opt_writes(x.op) == 1 {
                ndef_i = ndef_i + 1
                di = k
            }
            k = k + 1
        }
        if ndef_i != 1 || di <= hit {
            if DBG_MODIND == 1 { eprint("[modind] i0 定义次数 " + ndef_i.to_str() + " di=" + di.to_str() + " hit=" + hit.to_str()) }
            continue
        }
        let mi = ir.get(di)
        if mi.op != OP_BINI || mi.b != OP_ADD || mi.a != i0 || mi.imm <= 0 {
            if DBG_MODIND == 1 { eprint("[modind] i0 增量 op=" + mi.op.to_str() + " b=" + mi.b.to_str() + " a=" + mi.a.to_str() + " i0=" + i0.to_str() + " imm=" + mi.imm.to_str()) }
            continue
        }
        // **步长要乘上去**：`i = i + s` 时 `t = i*C` 每轮涨 `C*s`，不是 `C`。
        // 只看 `C` 会在 `s != 1` 的循环里算错（一次条件减也兜不住更大的步长）。
        let step = c * mi.imm
        if step <= 0 || step >= dd {
            if DBG_MODIND == 1 { eprint("[modind] 步长 C*s=" + step.to_str() + " 不在 (0,D) 内") }
            continue
        }
        // 循环外最后一次定义 i0 必须是常量 >= 0
        let k0 = _const_before(ir, i0, h)
        if k0 < 0 {
            if DBG_MODIND == 1 { eprint("[modind] i0 循环外不是常量") }
            continue
        }
        // 守卫 `i0 < N`：cc = jge（"到了上界就退出"）。两种形态都要认 ——
        // `while i < 20000000` 折成立即数（JCMPI），`while i < n`（n 是变量）
        // 是 JCMP 两个 vreg，这时去查 n 在循环前的常量值。
        let mut bound = 0 - 1
        k = h
        while k <= e {
            let x = ir.get(k)
            if x.dst == 0x8D && x.a == i0 {
                if x.op == OP_JCMPI && x.b >= 0 {
                    bound = x.b
                } else if x.op == OP_JCMP && x.b > 0 {
                    let nb = _const_before(ir, x.b, h)
                    if nb >= 0 {
                        bound = nb
                    }
                }
            }
            k = k + 1
        }
        // ---- 上界：能证明就用常量上界（无守卫），证不了就用**运行期守卫** ----
        //
        // v2.87：以前上界必须是常量才敢做，因为 `t = i*C` 溢出会让 `t` 变负，
        // 非负前提就没了。但"上界是形参"是**最常见的形状**（`fn work(n)` 里
        // `while i < n`）—— b8_threads1 就是它，一直吃不到这个优化。
        //
        // 换成运行期守卫：`i < LIMIT` 才走快路（LIMIT = 2^62/C，保证 `i*C` 不溢出），
        // 否则走原来的除法。因为 `i` 单调递增，一旦越过 LIMIT 就再也回不到快路，
        // 所以 `v` 变脏也无所谓。代价是每轮一条 `cmp`+`jcc`（永远走同一侧）。
        let mut guard = 0
        let mut lim = 0
        if bound < 0 {
            guard = 1
            lim = 4611686018427387904 / c
        } else if c * bound > 4611686018427387904 {
            guard = 1                    // 常量上界也会溢出：同样用守卫兜住
            lim = 4611686018427387904 / c
        }
        if DBG_MODIND == 1 { eprint("[modind] 命中：D=" + dd.to_str() + " C=" + c.to_str() + " k0=" + k0.to_str() + " N=" + bound.to_str() + " guard=" + guard.to_str()) }
        let dstd = w.dst
        let nv0 = len(fc.vloc)
        _mod_ind_apply(fc, h, hit, di, i0, c, dd, k0, step, guard, lim, dstd)
        // 变换会 `_vnew` 出新临时值，而 `cok/cval/use/ndef` 是按**旧**的 vreg 数
        // 开的 —— `_opt_copy` / `_opt_fuse` 里有几处 `use.get(d)` 没做上界检查，
        // 不补齐就是 "vec index out of bounds"（v2.87 试无分支回绕时踩的）。
        let mut q = nv0
        while q < len(fc.vloc) {
            cok.push(0)
            cval.push(0)
            use.push(0)
            ndef.push(0)
            q = q + 1
        }
        done.push(lid)
        // 这一轮只处理一条：插入已经改了长度，重新扫
        i = 0
        n = len(ir)
    }
}

/// 优化入口。三个缓冲由调用方（`_compile_range`）持有并复用 —— **别在这里
/// `vec.new`**：s3_manyfns 那种 200 个小函数一次编译要开 800 个 vec，光分配
/// 就让编译慢 7%（v2.44 实测）。
///   `cok`/`cval`：常量表，cok[v]=1 表示临时值 v 在所有执行路径上都等于 cval[v]
///   `use`：每个 vreg 被读几次（给 DCE 用）
///   `out`：`_fold_*` 的出参（长度恒为 2）
fn _opt(fc: FnCtx, cok: vec[int], cval: vec[int], use: vec[int],
         ndef: vec[int], out: vec[int]) {
    let ir = fc.ir
    let n = len(ir)
    cok.clear()
    cval.clear()
    use.clear()
    ndef.clear()
    let mut i = 0
    while i < len(fc.vloc) {
        cok.push(0)
        cval.push(0)
        use.push(0)
        ndef.push(0)
        i = i + 1
    }
    _opt_ndef(ir, ndef)
    // ---- 一趟干三件事：常量折叠 / 常量进变量 / 统计使用 ----
    i = 0
    while i < n {
        let ins = ir.get(i)
        let op = ins.op
        if op == OP_CONST {
            // 只有**单定义**的临时值才能当常量源
            if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
                cok.set(ins.dst, 1)
                cval.set(ins.dst, ins.imm)
            }
        } else if op == OP_MOV {
            // 常量临时值搬进变量 → 直接 CONST 变量（聚合变量不能这么干）
            if ins.a > 0 && fc.vpin.get(ins.a) == 0 && cok.get(ins.a) == 1 {
                if fc.vpin.get(ins.dst) == 1 && _ty_is_agg(fc.vty.get(ins.dst)) == 0 {
                    ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0,
                                   imm: cval.get(ins.a) })
                }
            }
        } else if op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV ||
                  op == OP_MOD || op == OP_AND || op == OP_OR || op == OP_XOR ||
                  op == OP_SHL || op == OP_SAR || op == OP_SHR {
            // 两个操作数都得是"已知常量"的临时值
            if ins.a > 0 && ins.b > 0 && fc.vpin.get(ins.a) == 0 && fc.vpin.get(ins.b) == 0 {
                if cok.get(ins.a) == 1 && cok.get(ins.b) == 1 {
                    if _fold_bin(op, cval.get(ins.a), cval.get(ins.b), out) == 1 {
                        let v = out.get(0)
                        ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0, imm: v })
                        if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
                            cok.set(ins.dst, 1)
                            cval.set(ins.dst, v)
                        }
                    }
                }
            }
            // 没被折掉、右操作数是常量 → 强度削减 / 压成立即数
            if ir.get(i).op == op && ins.a > 0 && ins.b > 0 {
                if fc.vpin.get(ins.b) == 0 && cok.get(ins.b) == 1 {
                    _opt_strength(fc, ir, i, op, ins, cval.get(ins.b), cok, cval, ndef)
                }
            }
        } else if op == OP_CMP {
            // 右操作数是常量 → `cmp r64, imm32`（省掉一次常量装载）
            if ins.a > 0 && ins.b > 0 && fc.vpin.get(ins.b) == 0 && cok.get(ins.b) == 1 {
                let cv = cval.get(ins.b)
                if cv >= -2147483648 && cv <= 2147483647 {
                    ir.set(i, Ir { op: OP_CMPI, dst: ins.dst, a: ins.a,
                                   b: ins.imm, imm: cv })
                }
            }
        } else if op == OP_NEG || op == OP_BNOT || op == OP_NOT || op == OP_NZ {
            if ins.a > 0 && fc.vpin.get(ins.a) == 0 && cok.get(ins.a) == 1 {
                if _fold_un(op, cval.get(ins.a), out) == 1 {
                    let v = out.get(0)
                    ir.set(i, Ir { op: OP_CONST, dst: ins.dst, a: 0, b: 0, imm: v })
                    if fc.vpin.get(ins.dst) == 0 && ndef.get(ins.dst) == 1 {
                        cok.set(ins.dst, 1)
                        cval.set(ins.dst, v)
                    }
                }
            }
        }
        // 按**最终形态**统计使用：折成 CONST 之后它就没有操作数了，
        // 于是原来那两个常量定义自然变成死代码，交给 _opt_dce 收走。
        _opt_mark(ir.get(i), use)
        i = i + 1
    }
    // v2.57：`JCMP` 的右操作数是常量 → `JCMPI`（`cmp r64, imm32` 一条顶两条）。
    // 这是 b9_json 里最肥的一处：`jws`/`jnum` 每字节都要比 `' '`/`'\t'`/`'0'`/`'9'`，
    // 以前每个比较都先 `mov r8d, imm` 再 `cmp`。
    i = 0
    while i < n {
        let ins = ir.get(i)
        if ins.op == OP_JCMP && ins.b > 0 && ins.b < len(cok) {
            if fc.vpin.get(ins.b) == 0 && cok.get(ins.b) == 1 && ndef.get(ins.b) == 1 {
                let cv = cval.get(ins.b)
                if cv >= -2147483648 && cv <= 2147483647 {
                    ir.set(i, Ir { op: OP_JCMPI, dst: ins.dst, a: ins.a, b: cv, imm: ins.imm })
                    // **折完要把"用了一次"退回去**（v2.76）：上面的 `_opt_mark` 是按
                    // JCMP 记的（b 是 vreg，算一次读），换成 JCMPI 之后 b 槽放的是
                    // 立即数，那条 `OP_CONST` 就成了死代码。不退计数的话 DCE 不敢删，
                    // 于是每个比较都白留一条 `mov r8d, 0x20`（b9_json 的 jws 每字节 4 条）。
                    use.set(ins.b, use.get(ins.b) - 1)
                }
            }
        }
        i = i + 1
    }
    // 拷贝传播放在融合之前：它先把纯搬运消掉，融合看到的形状更干净
    _opt_copy(fc, ir, use, ndef)
    // 融合要用到完整的 use[]，所以放在标记之后、DCE 之前
    _opt_fuse(fc, ir, use, ndef)
    _opt_dce(fc, use)
    // ---- 空跳：`jmp L` 后面（跳过连续的 LAB）就是 L 本身 → 删掉 ----
    i = 0
    while i < n {
        let ins = ir.get(i)
        if ins.op == OP_JMP {
            let mut j = i + 1
            let mut hit = 0
            let mut go = 1
            while go == 1 && j < n {
                let nx = ir.get(j)
                if nx.op == OP_LAB {
                    if nx.imm == ins.imm {
                        hit = 1
                    }
                    j = j + 1
                } else {
                    go = 0
                }
            }
            if hit == 1 {
                ir.set(i, Ir { op: OP_NOP, dst: 0, a: 0, b: 0, imm: 0 })
            }
        }
        i = i + 1
    }
    // ---- v2.81 归纳削减：`(i*C) % D` → 递增计数器 + 条件回绕 ----
    // 它会插入新指令、改使用关系，所以放在最后，之后重算 use/ndef 再跑一次 DCE
    // （不然被替换掉的 `t = i*C` 会留在循环里当死代码）。
    _opt_mod_ind(fc, cok, cval, use, ndef)
    _opt_ndef(ir, ndef)
    i = 0
    while i < len(use) {
        use.set(i, 0)
        i = i + 1
    }
    i = 0
    while i < len(ir) {
        _opt_mark(ir.get(i), use)
        i = i + 1
    }
    // 再跑一次拷贝传播：归纳削减插的是 `r = v`，让 `add acc, r` 直接用 `v`
    _opt_copy(fc, ir, use, ndef)
    _opt_dce(fc, use)
}

// ---------------------------------------------------------------------------
// 线性扫描分配（只分配临时值；变量在 `_new_var` 里已固定）
// ---------------------------------------------------------------------------

/// 变量寄存器分配（v2.50）：**按使用次数**把寄存器给最热的标量变量。
///
/// 以前是"按创建顺序"：`_new_var` 里前 5 个标量拿 RBX/R12-R15，第 6 个起落帧槽。
/// 于是 `let n/v/i/s/t/t0/t1` 这种 7 个变量的函数里，**热的累加器和循环变量
/// 跟第 6、7 个一起溢出**，热循环每轮多两次内存往返，而且 store→load 形成串行
/// 依赖链 —— 实测 b4_array 每元素 21 个周期（C 只要 5 个）。
///
/// 两条安全边界：
///   ① **只动标量**。聚合变量的"值 = 区域地址"，槽号在降级期就被 `OP_ADDRV`
///      烧进 IR 了，搬了就错。
///   ② 标量也要查：它的槽号有没有被 `OP_ADDRV` 引用过（`baked` 位图）。
///      寄存器里的变量不可能被烧过（它压根没有槽），所以降级永远安全。
///
/// 算法：贪心交换 —— 反复找"使用次数最少的寄存器标量"和"使用次数最多的槽内标量"，
/// 前者比后者少就互换位置，最多 8 轮（每轮至少提一个，够用）。
fn _alloc_vars(fc: FnCtx, ucnt: vec[int], baked: vec[int]) {
    let n = len(fc.vloc)
    ucnt.clear()
    let mut i = 0
    while i < n {
        ucnt.push(0)
        i = i + 1
    }
    baked.clear()
    i = 0
    while i < MAX_SLOT {
        baked.push(0)
        i = i + 1
    }
    // 一遍扫 IR：统计每个 vreg 被读几次 + 记录被 ADDRV 烧过的槽号
    i = 0
    while i < len(fc.ir) {
        let ins = fc.ir.get(i)
        if ins.op == OP_ADDRV {
            if ins.imm >= 0 && ins.imm < MAX_SLOT {
                baked.set(ins.imm, 1)
            }
        }
        if ins.a > 0 && ins.a < n {
            ucnt.set(ins.a, ucnt.get(ins.a) + 1)
        }
        // BINI / CMPI / DIVC / JCMPI 的 `b` 槽不是 vreg
        if ins.b > 0 && ins.b < n && ins.op != OP_BINI &&
           ins.op != OP_CMPI && ins.op != OP_DIVC && ins.op != OP_JCMPI {
            ucnt.set(ins.b, ucnt.get(ins.b) + 1)
        }
        // 这几个操作码的 dst 槽是被读的（"值"/"地址"/"字节数"）
        if ins.dst > 0 && ins.dst < n {
            if ins.op == OP_MEMCPYN || ins.op == OP_STORED || ins.op == OP_STOREX ||
               ins.op == OP_STORE8D || ins.op == OP_STORE8X || ins.op == OP_STORE8I {
                ucnt.set(ins.dst, ucnt.get(ins.dst) + 1)
            }
        }
        i = i + 1
    }
    let mut round = 0
    while round < 8 {
        let mut wr = -1            // 最不值钱的寄存器标量
        let mut wru = 0
        let mut bs = -1            // 最值钱的槽内标量
        let mut bsu = 0
        let mut v = 1
        while v < n {
            if fc.vpin.get(v) == 1 && _ty_is_agg(fc.vty.get(v)) == 0 {
                let loc = fc.vloc.get(v)
                let u = ucnt.get(v)
                if loc > 0 {
                    if _cs_index(loc - 1) >= 0 {
                        if wr < 0 || u < wru {
                            wr = v
                            wru = u
                        }
                    }
                } else if loc < 0 {
                    let slot = 0 - loc - 1
                    if slot < MAX_SLOT && baked.get(slot) == 0 {
                        if bs < 0 || u > bsu {
                            bs = v
                            bsu = u
                        }
                    }
                }
            }
            v = v + 1
        }
        if wr < 0 || bs < 0 || bsu <= wru {
            round = 8                      // 没有值得换的
        } else {
            let rloc = fc.vloc.get(wr)
            let sloc = fc.vloc.get(bs)
            fc.vloc.set(bs, rloc)
            fc.vloc.set(wr, sloc)
            round = round + 1
        }
    }
}

fn _alloc(fc: FnCtx, ucnt: vec[int], baked: vec[int], csb: vec[int], lpm: vec[int]) {
    _alloc_vars(fc, ucnt, baked)
    // v2.55：给"被占用的 XMM 变量寄存器"分配保存槽。**必须在临时池之前** ——
    // 临时池的基址是当时的 `C_ST`，之后再 `_st_slot` 就会落在池子里，互相踩。
    let mut xk = 0
    while xk < N_XMMVAR {
        _cell_set(fc, C_XSAV0 + xk, -1)
        xk = xk + 1
    }
    let mut xv = 1
    while xv < len(fc.vloc) {
        let xl = fc.vloc.get(xv)
        if xl >= XLOC {
            let k2 = xl - XLOC - XMM_VAR0
            if k2 >= 0 && k2 < N_XMMVAR {
                if fc.cells.get(C_XSAV0 + k2) < 0 {
                    _cell_set(fc, C_XSAV0 + k2, _st_slot(fc))
                }
            }
        }
        xv = xv + 1
    }
    let n = len(fc.ir)
    // cp[i] = 下标 < i 的调用指令条数（用来判断区间是否跨调用）
    let cp = fc.cp
    let mut i = 0
    let mut c = 0
    while i <= n {
        cp.push(c)
        if i < n {
            let ins = fc.ir.get(i)
            // **凡是内部真的发 `call` 的指令都要算进来**（坑表 #20 的同类）。
            // 漏一个的后果：跨它存活的临时值不会被溢出到帧槽，留在 R8-R11
            // 里被 __memcpy/__memset 清掉。v2.34 实测：_bi_mem_str 的 dstp
            // 跨 OP_MEMCPYN，于是 mem_str 返回的指针是垃圾 —— 而这个问题
            // 只在"qlmc 编自己"（寄存器压力大）时才暴露。
            if ins.op == OP_CALL || ins.op == OP_CALLRT || ins.op == OP_CALLIAT ||
               ins.op == OP_CALLR || ins.op == OP_MEMCPYN || ins.op == OP_ZERON ||
               ins.op == OP_COPY || ins.op == OP_RETAGG {
                c = c + 1          // 都会清 caller-saved
            }
            // v3.42：**OP_ARG 也是一道屏障**。
            //
            // 实参寄存器是 RCX/RDX/R8/R9，而临时值池是 R8/R9/R10/R11 —— 两者
            // 在 R8/R9 上**重叠**。一条 `OP_ARG k, v` 把 v 搬进实参寄存器之后，
            // v 一直要活到 CALL 为止；但 v 的区间 (st,en] 里没有 CALL，`crosses`
            // 算出来是 0，分配器就敢把它放进 R8。紧接着为第 4 个实参 CONST 的
            // 那个 0 复用了同一个 R8，`mov r8, 0` 把第 3 个实参覆盖掉。
            //
            // 症状（v3.42 实测）：`tcp_send_n(conn, p, 10)` 编成
            // `send(conn, p, 0, 0)`，返回 0 字节、对端收不到东西。用户函数的
            // 三参调用不受影响（那边的实参在 CALL 前就搬完、区间含 CALL），
            // 所以这个坑只在**内建手写 IR**里暴露 —— 而内建恰恰是最容易
            // 把 CONST 写在 ARG 后面的地方。
            //
            // 把 ARG 也算成"跨调用屏障"，这些值就老实溢出到帧槽，不会占着
            // 实参寄存器。
            //
            // 只对 **imm >= 2** 生效：`_out_arg_reg` 把 0/1 映到 RCX/RDX，
            // 那两个不在临时池里，没有冲突，也就没必要付溢出的代价。
            // 3 参以上的调用才会走到这里，而 3 参以上的内建/函数调用本来
            // 就不是内层热路径。
            if ins.op == OP_ARG && ins.imm >= 2 {
                c = c + 1
            }
        }
        i = i + 1
    }
    // v2.57：哪些指令在**循环体内**（差分数组 + 前缀和）。
    //
    // 用途：跨调用的临时值默认溢出到帧槽。若它同时在循环里，溢出就是
    // **每轮两次内存往返**；改用空着的 callee-saved 寄存器只花每函数一次
    // push/pop，明显划算。反过来，**循环外**的跨调用临时值溢出只发生一次，
    // 换寄存器反而白搭一对 push/pop（实测 fib 慢 4.7%）—— 所以要区分。
    lpm.clear()
    i = 0
    while i <= n {
        lpm.push(0)
        i = i + 1
    }
    i = 0
    while i < n {
        let ins = fc.ir.get(i)
        if ins.op == OP_JMP || ins.op == OP_JZ || ins.op == OP_JNZ ||
           ins.op == OP_JCMP || ins.op == OP_JCMPVLEN || ins.op == OP_JCMPSTR {
            let tgt = ins.imm
            if tgt >= 0 && tgt <= i {
                lpm.set(tgt, lpm.get(tgt) + 1)
                if i + 1 <= n {
                    lpm.set(i + 1, lpm.get(i + 1) - 1)
                }
            }
        }
        i = i + 1
    }
    let mut acc0 = 0
    i = 0
    while i <= n {
        acc0 = acc0 + lpm.get(i)
        lpm.set(i, acc0)
        i = i + 1
    }
    // 每个寄存器的"占用到哪条指令为止"
    let rend = fc.rend
    i = 0
    while i < 4 {
        rend.push(-1)
        i = i + 1
    }
    // v2.55：f64 临时值用 XMM0..XMM3（Win64 里易失，跨调用同样要溢出）。
    // **不新增 FnCtx 字段**（字段数敏感，坑见 MEMORY）—— 复用 rend 的第 4..7 格。
    let rendx = fc.rend
    i = 0
    while i < 4 {
        rendx.push(-1)
        i = i + 1
    }
    // 临时槽池：**紧接变量区**（v2.44）。以前从固定的 SLOT_TEMP(384) 起，
    // 于是"3 个局部变量 + 1 个溢出临时值"这种函数也要 385 个槽 → 3 KB 帧。
    // 现在 tbase = 变量区末尾，帧大小才真正反映用量。
    // v2.57：哪些 callee-saved 被**变量**占着（其余空着，可给循环里的临时值）
    csb.clear()
    i = 0
    while i < N_VARREG {
        csb.push(0)
        i = i + 1
    }
    i = 1
    while i < len(fc.vloc) {
        if fc.vpin.get(i) == 1 {
            let l0 = fc.vloc.get(i)
            if l0 > 0 && l0 < XLOC {
                let k0 = _cs_index(l0 - 1)
                if k0 >= 0 {
                    csb.set(k0, 1)
                }
            }
        }
        i = i + 1
    }
    let tbase = fc.cells.get(C_ST)
    let tpool = MAX_SLOT - SLOT_TEMP
    let send = fc.send
    i = 0
    while i < tpool {
        send.push(-1)
        i = i + 1
    }
    let mut v = 1
    while v < len(fc.vloc) {
        if fc.vpin.get(v) == 0 && fc.vloc.get(v) == 0 {
            let st = fc.vstart.get(v)
            let mut en = fc.vend.get(v)
            if en < st {
                en = st
            }
            // 区间 (st, en] 里有调用 → caller-saved 寄存器不能用
            let crosses = cp.get(en + 1) - cp.get(st + 1)
            let mut placed = 0
            // 区间里有循环体（`st` 或 `en` 落在循环内）才值得换 callee-saved
            let mut inloop = 0
            if lpm.get(st) > 0 || lpm.get(en) > 0 {
                inloop = 1
            }
            if crosses > 0 && inloop == 1 && fc.vty.get(v) != TY_F64 {
                // v2.57：**循环里**跨调用的临时值先试空着的 callee-saved 寄存器。
                // 变量没占满 7 个寄存器是常态（`fib` 只有 1 个参数），空着的
                // RBX/R12-R15/RSI/RDI 白放着。溢出是每轮两条内存往返，占用一个
                // callee-saved 只是每函数一次 push/pop。序言/尾声的 push/pop
                // 由 `_emit_fn` 从 vloc 自动推出，不用另记。
                let mut k = 0
                while k < N_VARREG {
                    if csb.get(k) == 0 {
                        csb.set(k, 1)
                        fc.vloc.set(v, _cs_reg(k) + 1)
                        placed = 1
                        k = N_VARREG
                    } else {
                        k = k + 1
                    }
                }
            }
            if crosses == 0 {
                if fc.vty.get(v) == TY_F64 {
                    let mut rx = 0
                    while rx < 4 {
                        if rendx.get(4 + rx) < st {
                            fc.vloc.set(v, XLOC + XMM_TMP0 + rx)
                            rendx.set(4 + rx, en)
                            placed = 1
                            rx = 4
                        } else {
                            rx = rx + 1
                        }
                    }
                } else {
                    let mut r = 0
                    while r < 4 {
                        if rend.get(r) < st {
                            fc.vloc.set(v, _tmp_reg(r) + 1)
                            rend.set(r, en)
                            placed = 1
                            r = 4
                        } else {
                            r = r + 1
                        }
                    }
                }
            }
            if placed == 0 {
                let mut s = 0
                while s < tpool {
                    if send.get(s) < st {
                        fc.vloc.set(v, -(tbase + s + 1))
                        send.set(s, en)
                        placed = 1
                        s = tpool
                    } else {
                        s = s + 1
                    }
                }
            }
            if placed == 0 {
                eprint("qlmc: 活跃临时值超过 " + tpool.to_str() + " 个")
                exit(2)
            }
        }
        v = v + 1
    }
}

// ---------------------------------------------------------------------------
// 发射：IR → 机器码
// ---------------------------------------------------------------------------

/// 取一个能当 SIB index 用的寄存器。低 3 位不能是 4（那是"无 index"的编码，
/// R12 会撞上），所以 R12 / 帧槽里的值都先搬进 RDX。
fn _idx_reg(fc: FnCtx, v: int) -> int {
    let loc = fc.vloc.get(v)
    if loc > 0 {
        let r = loc - 1
        if r != RAX && r != RCX && (r & 7) != 4 {
            return r
        }
    }
    _to_reg(fc, RDX, v)
    return RDX
}

/// `v` 现在**已经**在哪个通用寄存器里？不在寄存器（帧槽 / XMM / 未分配）返回 -1。
/// 只读操作数用它省掉一次 `mov`：`cmp r64, imm` 可以接受任意寄存器，
/// 没必要为了"约定用 RCX"先搬一趟。
fn _reg_hint(fc: FnCtx, v: int) -> int {
    let loc = fc.vloc.get(v)
    if loc > 0 {
        return loc - 1
    }
    return -1
}

/// 把 v 搬进寄存器 r（r 不能是 v 自己已经待着的寄存器之外的分配结果）
fn _to_reg(fc: FnCtx, r: int, v: int) {
    let loc = fc.vloc.get(v)
    // v2.55：f64 值住 XMM。要把它当"8 字节标量"搬进通用寄存器时（返回、实参、
    // 参数绑定），就是 `movq r, xmm` —— 位模式原样过去，语义不变。
    if loc >= XLOC {
        _movq_r_from_x(fc.code, r, loc - XLOC)
        return
    }
    if loc > 0 {
        if loc - 1 != r {
            _mov_rr(fc.code, r, loc - 1)
        }
    } else if loc < 0 {
        _mov_load(fc.code, r, RBP, _slot_disp(-loc - 1))
    } else {
        eprint("qlmc: 内部错误：值 " + v.to_str() + " 未分配位置")
        exit(2)
    }
}

/// 把 `v` 的 f64 值搬进 XMM `x`（已在里面就什么都不发）
fn _to_xmm(fc: FnCtx, x: int, v: int) {
    let code = fc.code
    let loc = fc.vloc.get(v)
    if loc >= XLOC {
        _sse_mov_reg(code, x, loc - XLOC)      // movaps（不用 movsd，见那里的注释）
        return
    }
    if loc < 0 {
        _sse_mem(code, 1, 0x10, x, RBP, _slot_disp(-loc - 1))
        return
    }
    if loc > 0 {
        _movq_x_from_r(code, x, loc - 1)
        return
    }
    eprint("qlmc: 内部错误：f64 值 " + v.to_str() + " 未分配位置")
    exit(2)
}

/// 把 XMM `x` 写进 `v` 的位置
fn _from_xmm(fc: FnCtx, x: int, v: int) {
    let code = fc.code
    let loc = fc.vloc.get(v)
    if loc >= XLOC {
        _sse_mov_reg(code, loc - XLOC, x)      // movaps
        return
    }
    if loc < 0 {
        _sse_mem(code, 1, 0x11, x, RBP, _slot_disp(-loc - 1))
        return
    }
    if loc > 0 {
        _movq_r_from_x(code, loc - 1, x)
        return
    }
    eprint("qlmc: 内部错误：f64 值 " + v.to_str() + " 未分配位置")
    exit(2)
}

/// 若 `v` 的 f64 值在帧槽里，返回槽号；否则 -1（给"内存操作数"快路径用）
fn _f64_slot(fc: FnCtx, v: int) -> int {
    let loc = fc.vloc.get(v)
    if loc < 0 {
        return -loc - 1
    }
    return -1
}

/// 把寄存器 src_reg 的值搬到位置 dloc（用于 OP_PARAM）
fn _from_reg(fc: FnCtx, dloc: int, src_reg: int) {
    if dloc >= XLOC {
        _movq_x_from_r(fc.code, dloc - XLOC, src_reg)
        return
    }
    if dloc > 0 {
        if dloc - 1 != src_reg {
            _mov_rr(fc.code, dloc - 1, src_reg)
        }
    } else {
        _mov_store(fc.code, RBP, _slot_disp(-dloc - 1), src_reg)
    }
}

/// `dst = a <op> b`，且 **dst 与 b 是同一个寄存器**（`x = 0 - x` 的形状）。
///
/// v2.55 踩过：以前直接 `_to_reg(d, a)` 再读 b —— 把 b 覆盖掉了。
/// 后果是 `x = 0 - x` 恒得 0、`x = 5 - x` 恒得 0（乘法会得 a*a）。
/// **stage-0 是对的，所以只有 qlmc 编出来错**；因为很少写"常量在左、变量在右"，
/// 从 v2.16 到 v2.54 一直没暴露 —— 是 `_f64_bits` 里的 `e10 = 0 - e10` 撞出来的。
fn _bin_alias(fc: FnCtx, d: int, a: int, b: int, op_rr: int, op_rm: int) {
    _to_reg(fc, RAX, b)                    // 先把 b 存走（RAX 永不被 vreg 占用）
    _to_reg(fc, d, a)
    _alu_rr(fc.code, op_rr, d, RAX)
}

/// 同上，但用 `imul`（它没有通用的 `_alu_rr` 形式）
fn _mul_alias(fc: FnCtx, d: int, a: int, b: int) {
    _to_reg(fc, RAX, b)
    _to_reg(fc, d, a)
    _imul_rr(fc.code, d, RAX)
}

/// d = d <op> v（d 是寄存器，v 可以是寄存器或帧槽）
fn _bin_into(fc: FnCtx, d: int, v: int, op_rr: int, op_rm: int) {
    let loc = fc.vloc.get(v)
    if loc > 0 {
        _alu_rr(fc.code, op_rr, d, loc - 1)
    } else {
        _alu_rm(fc.code, op_rm, d, RBP, _slot_disp(-loc - 1))
    }
}

fn _store_rax(fc: FnCtx, dloc: int) {
    if dloc >= XLOC {
        _movq_x_from_r(fc.code, dloc - XLOC, RAX)
        return
    }
    if dloc > 0 {
        if dloc - 1 != RAX {
            _mov_rr(fc.code, dloc - 1, RAX)
        }
    } else {
        _mov_store(fc.code, RBP, _slot_disp(-dloc - 1), RAX)
    }
}

/// 寄存器 `r` 在 IR 下标 `i` 处是否被某个值占着（`vstart <= i <= vend`）。
///
/// 常数除法想借 `R11` 存符号位 —— 它是 caller-saved 的临时寄存器，只有**没人用时**
/// 才敢借。变量永远落在 cs 寄存器上，所以这个检查对变量恒为 0，天然安全。
fn _reg_busy_at(fc: FnCtx, r: int, i: int) -> int {
    let mut v = 1
    while v < len(fc.vloc) {
        if fc.vloc.get(v) == r + 1 {
            if fc.vstart.get(v) <= i && fc.vend.get(v) >= i {
                return 1
            }
        }
        v = v + 1
    }
    return 0
}

/// 常数除法：**无符号魔数 + 显式符号分离**（v2.48）。
///
/// 记 d >= 2、l = ceil(log2 d)、s = l-1、m = ceil(2^(64+s)/d)、e = m - 2^(64+s)/d。
/// 对 0 <= u <= 2^63：`floor(u*m / 2^(64+s)) = floor(u/d + u*e/2^(64+s))`，而
/// `u*e/2^(64+s) <= 2^63*e/2^(64+s) = e/2^l < 1/2^l <= 1/d`
/// —— 小数部分的扰动**永远跨不过整数边界**，所以 floor 严格等于 `u/d`。
/// （`e < 1` 严格成立：d 是 2 的幂时 e = 0，否则 e 是分数。）
/// 这一步是**可证明**的，不像有符号魔数那样要靠推导。
///
/// 于是 `x/d`（向零截断）= `sign(x) * floor(|x|/d)`，`x%d = x - (x/d)*d`。
///
/// `m` 在编译期算：`2^64` 装不进 int64，用
///   `floor(2^63/d) = -(INT64_MIN/d)`（有符号除法对负数向零截断，正好等于 -floor）
///   `r63 = INT64_MIN - q63*d`（**利用 int64 回绕**得到正确的正余数）
///   `q64 = 2*q63 + (2*r63)/d`、`r64 = -(q64*d)`
///   `m = (q64<<s) + ((r64<<s) + d - 1)/d`
/// 全程允许回绕（我们要的就是模 2^64 的值）。
fn _emit_divc(fc: FnCtx, code: vec[int], ins: Ir, i: int) {
    let d = ins.imm
    let mut l = 0
    let mut pw = 1
    while pw < d {
        pw = pw << 1
        l = l + 1
    }
    let s = l - 1
    let imin = 0 - 9223372036854775807 - 1
    let q63 = 0 - (imin / d)
    let r63 = imin - q63 * d
    let q64 = 2 * q63 + (2 * r63) / d
    let r64 = 0 - q64 * d
    let m = (q64 << s) + ((r64 << s) + d - 1) / d
    // v2.52：符号位**只算一次**。`mul` 会毁掉 rax/rdx，所以 v2.48 那版在算完 qa
    // 之后又重算了一遍 sign（`mov rdx,rcx; sar rdx,63`）。现在如果 `R11` 在这一点
    // 没被占，就把 sign 存在 R11 里 —— 省两条指令（`%` 18 → 15、`/` 15 → 12）。
    _to_reg(fc, RCX, ins.a)                    // rcx = x（一直保留，取模要用）
    let useR11 = 0
    if _reg_busy_at(fc, R11, i) == 0 {
        useR11 = 1
    }
    if useR11 == 1 {
        // REX 是 **0x49**（W|B），不是 0x4D —— 0x4D 会多置 R 位，把 `mov r11,rcx`
        // 变成 `mov r11,r9`、把 `sar r11,63` 的 ext 从 7 变成 15（非法组）。
        // v2.52 第一版就是这么错的，表现是负数除法的 |x| 算成 0xFFFF…（无符号除）。
        _b(code, 0x49)                         // mov r11, rcx
        _b(code, 0x89)
        _b(code, 0xCB)
        _b(code, 0x49)                         // sar r11, 63      → sign（保留）
        _b(code, 0xC1)
        _b(code, 0xFB)
        _b(code, 63)
        _b(code, 0x48)                         // mov rax, rcx
        _b(code, 0x89)
        _b(code, 0xC8)
        _b(code, 0x4C)                         // xor rax, r11
        _b(code, 0x31)
        _b(code, 0xD8)
        _b(code, 0x4C)                         // sub rax, r11     → rax = |x|
        _b(code, 0x29)
        _b(code, 0xD8)
        _b(code, 0x48)                         // movabs rdx, m
        _b(code, 0xBA)
        _w64(code, m)
        _b(code, 0x48)                         // mul rdx
        _b(code, 0xF7)
        _b(code, 0xE2)
        _b(code, 0x48)                         // mov rax, rdx
        _b(code, 0x89)
        _b(code, 0xD0)
        _b(code, 0x48)                         // shr rax, s
        _b(code, 0xC1)
        _b(code, 0xE8)
        _b(code, s)
        _b(code, 0x4C)                         // xor rax, r11
        _b(code, 0x31)
        _b(code, 0xD8)
        _b(code, 0x4C)                         // sub rax, r11     → rax = q
        _b(code, 0x29)
        _b(code, 0xD8)
    } else {
        _b(code, 0x48)                         // mov rax, rcx
        _b(code, 0x89)
        _b(code, 0xC8)
        _b(code, 0x48)                         // sar rax, 63      → sign
        _b(code, 0xC1)
        _b(code, 0xF8)
        _b(code, 63)
        _b(code, 0x48)                         // mov rdx, rcx
        _b(code, 0x89)
        _b(code, 0xCA)
        _b(code, 0x48)                         // xor rdx, rax
        _b(code, 0x31)
        _b(code, 0xC2)
        _b(code, 0x48)                         // sub rdx, rax     → rdx = |x|
        _b(code, 0x29)
        _b(code, 0xC2)
        _b(code, 0x48)                         // mov rax, rdx
        _b(code, 0x89)
        _b(code, 0xD0)
        _b(code, 0x48)                         // movabs rdx, m
        _b(code, 0xBA)
        _w64(code, m)
        _b(code, 0x48)                         // mul rdx
        _b(code, 0xF7)
        _b(code, 0xE2)
        _b(code, 0x48)                         // mov rax, rdx
        _b(code, 0x89)
        _b(code, 0xD0)
        _b(code, 0x48)                         // shr rax, s
        _b(code, 0xC1)
        _b(code, 0xE8)
        _b(code, s)
        _b(code, 0x48)                         // mov rdx, rcx（重算 sign）
        _b(code, 0x89)
        _b(code, 0xCA)
        _b(code, 0x48)                         // sar rdx, 63
        _b(code, 0xC1)
        _b(code, 0xFA)
        _b(code, 63)
        _b(code, 0x48)                         // xor rax, rdx
        _b(code, 0x31)
        _b(code, 0xD0)
        _b(code, 0x48)                         // sub rax, rdx     → rax = q
        _b(code, 0x29)
        _b(code, 0xD0)
    }
    if ins.b == OP_MOD {
        _b(code, 0x48)                         // imul rax, rax, d
        _b(code, 0x69)
        _b(code, 0xC0)
        _w32(code, d)
        _b(code, 0x48)                         // sub rcx, rax     → r = x - q*d
        _b(code, 0x29)
        _b(code, 0xC1)
        _b(code, 0x48)                         // mov rax, rcx
        _b(code, 0x89)
        _b(code, 0xC8)
    }
    _store_rax(fc, fc.vloc.get(ins.dst))
}

/// f64 相关的发射（v2.55 / v2.56）。
///
/// **单独成函数**不是为了整洁，是为了不给 `_emit_ir` 加局部变量 —— 那个函数
/// 已经贴着 `SLOT_TEMP`(384) 的帧上限，多一个 slot 就编不过自己
/// （v2.55 第一次就踩到：`_emit_ir` 需要 385 个槽）。
fn _emit_f64(fc: FnCtx, i: int) {
    let ins = fc.ir.get(i)
    let code = fc.code
    let op = ins.op
    if op == OP_ITOF {
        // v2.55：dst(f64) = (f64)a(int)。dst 若在 XMM 里就直接写进去（一条指令）。
        let dloc = fc.vloc.get(ins.dst)
        let mut x = XMM0
        if dloc >= XLOC {
            x = dloc - XLOC
        }
        // 源已在通用寄存器里就直接当 cvtsi2sd 的操作数（省一条 `mov rcx, r12`）
        let aloc = fc.vloc.get(ins.a)
        let mut src = RCX
        if aloc > 0 {
            src = aloc - 1
        } else {
            _to_reg(fc, RCX, ins.a)
        }
        _b(code, 0xF2)                         // cvtsi2sd x, src
        _rex2(code, 1, x, src)
        _b(code, 0x0F)
        _b(code, 0x2A)
        _modrm(code, 3, x, src)
        if dloc < XLOC {
            _from_xmm(fc, x, ins.dst)
        }
        return
    }
    if op == OP_FTOI {
        // v2.55：dst(int) = (int)a(f64)。a 住 XMM 时是纯寄存器运算。
        _to_xmm(fc, XMM0, ins.a)
        _b(code, 0xF2)                         // cvttsd2si rax, xmm0
        _rex2(code, 1, RAX, XMM0)
        _b(code, 0x0F)
        _b(code, 0x2C)
        _modrm(code, 3, RAX, XMM0)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_FBIN {
        // v2.55：dst = a <op> b，三个操作数都是 **f64 值**（住 XMM / 通用寄存器 / 帧槽）。
        // 最理想的情况（b2_float 的 `acc = acc + 1.0/t`）只剩一条 `addsd xmm6, xmm0`：
        //   · dst 在 XMM 里 → 直接往 dst 上算，省掉最后的搬运；
        //   · b 在帧槽里 → 当内存操作数，省掉一次装载。
        let mut opc = 0x58                     // addsd
        if ins.imm == 1 {
            opc = 0x5C                         // subsd
        }
        if ins.imm == 2 {
            opc = 0x59                         // mulsd
        }
        if ins.imm == 3 {
            opc = 0x5E                         // divsd
        }
        let dloc = fc.vloc.get(ins.dst)
        let mut x = XMM0
        if dloc >= XLOC {
            x = dloc - XLOC
        }
        let bloc = fc.vloc.get(ins.b)
        // **dst 与 b 是同一个 XMM 时必须换临时**（`v = 0.0 - v` 的形状）：
        // 否则 `_to_xmm(x, a)` 会先把 b 覆盖掉，算出来是 `a op a`。
        if bloc >= XLOC && bloc - XLOC == x {
            x = XMM_SCR
        }
        _to_xmm(fc, x, ins.a)
        let bs = _f64_slot(fc, ins.b)
        if bs >= 0 {
            _sse_mem(code, 1, opc, x, RBP, _slot_disp(bs))
        } else if bloc >= XLOC && bloc - XLOC != x {
            // b 已经在某个 XMM 里 → 直接当第二操作数，别再搬一次
            _sse_rr(code, 1, opc, x, bloc - XLOC)
        } else {
            let mut y = XMM1
            if x == XMM1 {
                y = XMM2
            }
            _to_xmm(fc, y, ins.b)
            _sse_rr(code, 1, opc, x, y)
        }
        // 结果在 x 里：dst 不是那个 XMM 时（dst 在槽/通用寄存器，或者上面
        // 因为别名把 x 换成了 XMM_SCR）要搬回去。
        let mut same = 0
        if dloc >= XLOC && dloc - XLOC == x {
            same = 1
        }
        if same == 0 {
            _from_xmm(fc, x, ins.dst)
        }
        return
    }
    if op == OP_F64IMM {
        // v2.56：编译期算好的 f64 位模式 → `movabs rax, bits` + `movq xmm, rax`
        let dloc = fc.vloc.get(ins.dst)
        _mov_imm(code, RAX, ins.imm)
        if dloc >= XLOC {
            _movq_x_from_r(code, dloc - XLOC, RAX)
        } else {
            _movq_x_from_r(code, XMM0, RAX)
            _from_xmm(fc, XMM0, ins.dst)
        }
        return
    }
    if op == OP_FNEG {
        // dst = -a：翻符号位（`btc rax, 63`），不再走运行库调用。
        _to_xmm(fc, XMM0, ins.a)
        _movq_r_from_x(code, RAX, XMM0)
        _b(code, 0x48)                         // btc rax, 63
        _b(code, 0x0F)
        _b(code, 0xBA)
        _b(code, 0xF8)
        _b(code, 63)
        _movq_x_from_r(code, XMM0, RAX)
        _from_xmm(fc, XMM0, ins.dst)
        return
    }
    if op == OP_FCMP {
        // dst(int) = (a <cc> b)：a/b 是 **f64 值**，imm 是 setcc 操作码。
        // ucomisd 对 NaN 会置 CF=ZF=PF=1，所以 EQ/NE/LT/LE 要用 PF 兜一下，
        // 否则 `NaN == x` 会得到 true（GT/GE 用 seta/setae 天然排除 NaN）。
        // 左操作数放进**专用临时 XMM_SCR**（恒空闲），这样永远不会与 b 撞车
        _to_xmm(fc, XMM_SCR, ins.a)
        let bs = _f64_slot(fc, ins.b)
        let bloc = fc.vloc.get(ins.b)
        if bs >= 0 {
            _sse_mem(code, 0, 0x2E, XMM_SCR, RBP, _slot_disp(bs))
        } else if bloc >= XLOC {
            _sse_rr(code, 0, 0x2E, XMM_SCR, bloc - XLOC)
        } else {
            _to_xmm(fc, XMM1, ins.b)
            _sse_rr(code, 0, 0x2E, XMM_SCR, XMM1)
        }
        _b(code, 0x0F)                         // setcc al
        _b(code, ins.imm)
        _b(code, 0xC0)
        if ins.imm == 0x94 || ins.imm == 0x92 || ins.imm == 0x96 {
            _b(code, 0x0F)                     // setnp cl
            _b(code, 0x9B)
            _b(code, 0xC1)
            _b(code, 0x20)                     // and al, cl
            _b(code, 0xC8)
        }
        if ins.imm == 0x95 {
            _b(code, 0x0F)                     // setp cl
            _b(code, 0x9A)
            _b(code, 0xC1)
            _b(code, 0x08)                     // or al, cl
            _b(code, 0xC8)
        }
        _b(code, 0x0F)                         // movzx eax, al
        _b(code, 0xB6)
        _b(code, 0xC0)
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _mov_rr(code, dloc - 1, RAX)
        } else {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
}

fn _emit_ir(fc: FnCtx, i: int) {
    let ins = fc.ir.get(i)
    let code = fc.code
    let op = ins.op
    if op == OP_NOP {
        return                             // 优化层消掉的位置：一条字节都不发
    }
    // v2.55：f64 的几条指令整体交给 `_emit_f64`（见那里的注释：不能给本函数
    // 加局部变量，帧已经顶到上限）
    if op == OP_F64IMM || op == OP_FNEG || op == OP_ITOF || op == OP_FTOI ||
       op == OP_FBIN || op == OP_FCMP {
        _emit_f64(fc, i)
        return
    }
    if op == OP_BINI {
        // dst = a <sub> imm。子操作码在 ins.b，常量在 ins.imm（由优化层压出来的）
        let sub = ins.b
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        if sub == OP_MUL {
            // 三操作数 imul：reg=dst、rm=源，源在寄存器时一条搞定
            let aloc = fc.vloc.get(ins.a)
            if aloc > 0 {
                _imul_imm(code, d, aloc - 1, ins.imm)
            } else {
                _to_reg(fc, d, ins.a)
                _imul_imm(code, d, d, ins.imm)
            }
        } else if sub == OP_SHL || sub == OP_SAR || sub == OP_SHR {
            _to_reg(fc, d, ins.a)
            let mut ext = 4                       // shl
            if sub == OP_SHR {
                ext = 5                           // shr（逻辑）
            }
            if sub == OP_SAR {
                ext = 7                           // sar（算术）
            }
            _shift_imm(code, ext, d, ins.imm)
        } else {
            // **别用"默认 0 = add"的写法**：不认识的子操作会被静默当成加法。
            // v2.46 就是这样把 `% 13` 变成 `+ 13` 的。这里逐个显式判。
            let mut ext = -1
            if sub == OP_ADD {
                ext = 0
            }
            if sub == OP_OR {
                ext = 1
            }
            if sub == OP_AND {
                ext = 4
            }
            if sub == OP_SUB {
                ext = 5
            }
            if sub == OP_XOR {
                ext = 6
            }
            if ext < 0 {
                eprint("qlmc: 内部错误：OP_BINI 的子操作码 " + sub.to_str() + " 不支持")
                exit(2)
            }
            _to_reg(fc, d, ins.a)
            _alu_imm(code, ext, d, ins.imm)
        }
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_CMPI {
        // dst = (a <cc> imm) ? 1 : 0。cc 在 ins.b（setcc 码），常量在 ins.imm
        if ins.b < 0x90 || ins.b > 0x9F {
            eprint("qlmc: 内部错误：OP_CMPI 的条件码必须是 setcc（0x90..0x9F）")
            exit(2)
        }
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        _cmp_imm(code, ar, ins.imm)
        _setcc_al(code, ins.b)
        _movzx_rax_al(code)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_ADD || op == OP_SUB || op == OP_MUL {
        let mut rr = 0x01
        let mut rm = 0x03
        if op == OP_SUB {
            rr = 0x29
            rm = 0x2B
        }
        if op == OP_MUL {
            rr = 0
            rm = 0
        }
        let dloc = fc.vloc.get(ins.dst)
        if op == OP_MUL {
            if dloc > 0 {
                let d = dloc - 1
                if fc.vloc.get(ins.b) == dloc {
                    _mul_alias(fc, d, ins.a, ins.b)
                } else {
                    _to_reg(fc, d, ins.a)
                    let bloc = fc.vloc.get(ins.b)
                    if bloc > 0 {
                        _imul_rr(code, d, bloc - 1)
                    } else {
                        _imul_rm(code, d, RBP, _slot_disp(-bloc - 1))
                    }
                }
            } else {
                _to_reg(fc, RAX, ins.a)
                let bloc = fc.vloc.get(ins.b)
                if bloc > 0 {
                    _imul_rr(code, RAX, bloc - 1)
                } else {
                    _imul_rm(code, RAX, RBP, _slot_disp(-bloc - 1))
                }
                _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
            }
            return
        }
        if dloc > 0 {
            let d = dloc - 1
            if fc.vloc.get(ins.b) == dloc {
                _bin_alias(fc, d, ins.a, ins.b, rr, rm)
            } else {
                _to_reg(fc, d, ins.a)
                _bin_into(fc, d, ins.b, rr, rm)
            }
        } else {
            _to_reg(fc, RAX, ins.a)
            _bin_into(fc, RAX, ins.b, rr, rm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_DIV || op == OP_MOD {
        _to_reg(fc, RAX, ins.a)
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            if bloc - 1 != RCX {
                _mov_rr(code, RCX, bloc - 1)
            }
            _cqo(code)
            _idiv(code, RCX)
        } else {
            _cqo(code)
            _idiv_rm(code, RBP, _slot_disp(-bloc - 1))
        }
        if op == OP_MOD {
            _mov_rr(code, RAX, RDX)
        }
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_NEG {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _to_reg(fc, dloc - 1, ins.a)
            _neg(code, dloc - 1)
        } else {
            _to_reg(fc, RAX, ins.a)
            _neg(code, RAX)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    // ---- 位运算（v2.28）：and/or/xor 与 add/sub 同形，只是 ALU 操作码不同 ----
    if op == OP_AND || op == OP_OR || op == OP_XOR {
        let mut rr = 0x21            // and
        let mut rm = 0x23
        if op == OP_OR {
            rr = 0x09
            rm = 0x0B
        }
        if op == OP_XOR {
            rr = 0x31
            rm = 0x33
        }
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let d = dloc - 1
            if fc.vloc.get(ins.b) == dloc {
                _bin_alias(fc, d, ins.a, ins.b, rr, rm)
            } else {
                _to_reg(fc, d, ins.a)
                _bin_into(fc, d, ins.b, rr, rm)
            }
        } else {
            _to_reg(fc, RAX, ins.a)
            _bin_into(fc, RAX, ins.b, rr, rm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    // 移位：计数必须在 CL（`D3 /ext`）。x86 的 64 位移位会把 CL 自动掩成 6 位，
    // 所以 `x << 64` 等于 `x << 0`——stage-0 也是这个行为（运行时不做越界检查），
    // 这里保持一致，不要自作聪明加检查。
    if op == OP_SHL || op == OP_SAR || op == OP_SHR {
        let mut ext = 4              // shl
        if op == OP_SHR {
            ext = 5                  // shr（逻辑）
        }
        if op == OP_SAR {
            ext = 7                  // sar（算术）
        }
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        _to_reg(fc, d, ins.a)
        _to_reg(fc, RCX, ins.b)
        _rex2(code, 1, 0, d)
        _b(code, 0xD3)
        _modrm(code, 3, ext, d)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_BNOT {
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        _to_reg(fc, d, ins.a)
        _rex2(code, 1, 0, d)         // F7 /2 = not r64
        _b(code, 0xF7)
        _modrm(code, 3, 2, d)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_NOT || op == OP_NZ {
        _to_reg(fc, RAX, ins.a)
        _cmp_imm0(code, RAX)
        if op == OP_NOT {
            _setcc_al(code, 0x94)
        } else {
            _setcc_al(code, 0x95)
        }
        _movzx_rax_al(code)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_CMP {
        // imm 必须是 setcc 码（0x90..0x9F）。写成 jcc 码（0x8x）会发成
        // `0F 1C` 这种**非法字节**，CPU 当多字节 NOP 执行——不报错，只是
        // 比较结果变成"上一次的 AL"。v2.27 踩过一次，这里必须拦下。
        if ins.imm < 0x90 || ins.imm > 0x9F {
            eprint("qlmc: 内部错误：OP_CMP 的条件码必须是 setcc（0x90..0x9F），拿到 " + ins.imm.to_str())
            exit(2)
        }
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            _alu_rr(code, 0x39, ar, bloc - 1)
        } else {
            _alu_rm(code, 0x3B, ar, RBP, _slot_disp(-bloc - 1))
        }
        _setcc_al(code, ins.imm)
        _movzx_rax_al(code)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_LAB {
        _setlab(fc.labs, code, ins.imm)
        return
    }
    if op == OP_JMP {
        let p = _jmp(code)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JCMPVLEN || op == OP_JCMPSTR {
        // v2.53：`cmp r64, [base±8]` —— 省掉"先把长度装进寄存器"那一条。
        if ins.dst < 0x80 || ins.dst > 0x8F {
            eprint("qlmc: 内部错误：OP_JCMPV/STR 的条件码必须是 jcc（0x80..0x8F）")
            exit(2)
        }
        _to_reg(fc, RAX, ins.a)
        _to_reg(fc, RCX, ins.b)
        let mut disp = 8
        if op == OP_JCMPSTR {
            disp = -8
        }
        _rex2(code, 1, RAX, RCX)
        // **opcode 是 0x3B**（`cmp r64, r/m64`，算 reg - rm），不是 0x39
        // （`cmp r/m64, r64`，算 rm - reg）。写成 0x39 就是 `cmp [rcx+8], rax`
        // = 长度 - 下标，条件整个反过来 —— v2.53 第一版就是这样，表现是
        // **在界内反而走 die 路径**（进程 exit 1）。
        _b(code, 0x3B)                         // cmp rax, [rcx+disp8]
        _modrm(code, 1, RAX, RCX)
        _b(code, disp & 0xFF)
        let p = _jcc(code, ins.dst)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JCMPI {
        // v2.57：`cmp r64, imm32` + jcc。imm32 会被符号扩展到 64 位，
        // 所以只接受 [-2^31, 2^31-1]（优化层已经检查过）。
        if ins.dst < 0x80 || ins.dst > 0x8F {
            eprint("qlmc: 内部错误：OP_JCMPI 的条件码必须是 jcc（0x80..0x8F）")
            exit(2)
        }
        // v2.76：值已经在寄存器里就直接比那个寄存器，别再为"约定 RCX"搬一趟。
        // `cmp r64, imm` 是只读操作数，任意寄存器都行（b9_json 的 jws 每字节省 4 条 mov）。
        let rr = _reg_hint(fc, ins.a)
        if rr >= 0 {
            _cmp_imm(code, rr, ins.b)
        } else {
            _to_reg(fc, RCX, ins.a)
            _cmp_imm(code, RCX, ins.b)
        }
        let p = _jcc(code, ins.dst)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JCMP {
        // 同理：dst 必须是 jcc 码（0x80..0x8F）
        if ins.dst < 0x80 || ins.dst > 0x8F {
            eprint("qlmc: 内部错误：OP_JCMP 的条件码必须是 jcc（0x80..0x8F），拿到 " + ins.dst.to_str())
            exit(2)
        }
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let bloc = fc.vloc.get(ins.b)
        if bloc > 0 {
            _alu_rr(code, 0x39, ar, bloc - 1)
        } else {
            _alu_rm(code, 0x3B, ar, RBP, _slot_disp(-bloc - 1))
        }
        let p = _jcc(code, ins.dst)
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_JZ || op == OP_JNZ {
        _to_reg(fc, RAX, ins.a)
        _cmp_imm0(code, RAX)
        let mut p = 0
        if op == OP_JZ {
            p = _jcc(code, 0x84)
        } else {
            p = _jcc(code, 0x85)
        }
        _addfix(fc.fixes, p, ins.imm, FK_LAB)
        return
    }
    if op == OP_ARG {
        _to_reg(fc, _out_arg_reg(ins.imm), ins.a)
        return
    }
    if op == OP_CALL || op == OP_CALLRT {
        let p = _call_rel(code)
        if op == OP_CALL {
            _addfix(fc.fixes, p, ins.imm, FK_FN)
        } else {
            _addfix(fc.fixes, p, ins.imm, FK_RT)
        }
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_RET {
        if ins.a > 0 {
            _to_reg(fc, RAX, ins.a)
        } else {
            _mov_imm(code, RAX, 0)
        }
        let p = _jmp(code)
        _addfix(fc.fixes, p, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_PRINT {
        if ins.imm == TY_STR {
            _to_reg(fc, RCX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PSTR, FK_RT)
        } else if ins.imm == TY_BOOL {
            _to_reg(fc, RCX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PBOOL, FK_RT)
        } else {
            _to_reg(fc, RAX, ins.a)
            let p = _call_rel(code)
            _addfix(fc.fixes, p, RT_PINT, FK_RT)
        }
        return
    }
    if op == OP_EXIT {
        _to_reg(fc, RCX, ins.a)
        let p = _call_rip(code)
        _addfix(fc.fixes, p, I_EXIT, FK_IAT)
        return
    }
    if op == OP_LEA {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_STR)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_STR)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_BSSADDR {
        // dst = &bss[imm]：与 OP_LEA 同构，只是重定位类型是 FK_BSS
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_BSS)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_BSS)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_LEN {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let d = dloc - 1
            _to_reg(fc, d, ins.a)
            _len_of(code, d, d)
        } else {
            _to_reg(fc, RAX, ins.a)
            _len_of(code, RAX, RAX)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_PARAM {
        _from_reg(fc, fc.vloc.get(ins.dst), _arg_reg_of(ins.imm))
        return
    }
    if op == OP_PARAMSTK {
        // 栈上的形参：dst = [rbp + 48 + 8*nsaved + 8*imm]
        //   返回地址在 [rbp + 8 + 8*nsaved]（序言先 push callee-saved 再 push rbp）
        //   之后是 32 字节 shadow space，再之后才是第 5 个实参
        let off = 48 + 8 * fc.cells.get(C_NSAVED) + 8 * ins.imm
        let dloc = fc.vloc.get(ins.dst)
        if dloc >= XLOC {
            _mov_load(code, RAX, RBP, off)
            _movq_x_from_r(code, dloc - XLOC, RAX)
            return
        }
        if dloc > 0 {
            _mov_load(code, dloc - 1, RBP, off)
        } else {
            _mov_load(code, RAX, RBP, off)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_STKALLOC {
        _sub_rsp(code, ins.imm)
        return
    }
    if op == OP_STKFREE {
        _add_rsp(code, ins.imm)
        return
    }
    if op == OP_STKARG {
        // [rsp + imm] = a。RSP 当基址时 ModRM 的 rm=100 是"SIB 跟在后面"的
        // 标记，必须补一个 SIB 字节（0x24 = 无 index + base=rsp），
        // 否则 disp32 会被当成 SIB 解析，整条指令编码就错位了。
        let aloc = fc.vloc.get(ins.a)
        if aloc > 0 {
            _mov_store_rsp(code, ins.imm, aloc - 1)
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
            _mov_store_rsp(code, ins.imm, RAX)
        }
        return
    }
    if op == OP_LEAFN {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_FN)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_FN)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_CONST {
        let dloc = fc.vloc.get(ins.dst)
        // v2.55：f64 目的 —— imm 是整数值，要转成 double 位模式。
        // 0 用 `xorps`（全零 = +0.0，3 字节），其余走 cvtsi2sd。
        // **不要在这里开局部变量** —— `_emit_ir` 贴着 384 槽的帧上限，
        // 多一个就编不过自己（v2.55 踩过两次）。表达式直接内联。
        if dloc >= XLOC {
            if ins.imm == 0 {
                _sse_rr(code, 0, 0x57, dloc - XLOC, dloc - XLOC)   // xorps x, x
            } else {
                _mov_imm(code, RAX, ins.imm)
                _b(code, 0xF2)                                     // cvtsi2sd x, rax
                _rex2(code, 1, dloc - XLOC, RAX)
                _b(code, 0x0F)
                _b(code, 0x2A)
                _modrm(code, 3, dloc - XLOC, RAX)
            }
            return
        }
        if dloc > 0 {
            _mov_imm(code, dloc - 1, ins.imm)
        } else {
            // v2.44：直接写帧槽（8 字节），不再"先搬 rax 再存"（18 字节）
            _mov_imm_mem(code, RBP, _slot_disp(-dloc - 1), ins.imm)
        }
        return
    }
    if op == OP_MOV {
        let dloc = fc.vloc.get(ins.dst)
        // v2.55：任一侧是 XMM 时走 movsd/movq。位模式复制，语义与 mov 相同。
        if dloc >= XLOC || fc.vloc.get(ins.a) >= XLOC {
            _to_xmm(fc, XMM0, ins.a)
            _from_xmm(fc, XMM0, ins.dst)
            return
        }
        if dloc > 0 {
            _to_reg(fc, dloc - 1, ins.a)
        } else if fc.vloc.get(ins.a) > 0 {
            // v2.44：源已经在寄存器里就直接存，省掉一条 `mov rax, X`
            _mov_store(code, RBP, _slot_disp(-dloc - 1), fc.vloc.get(ins.a) - 1)
        } else {
            _to_reg(fc, RAX, ins.a)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_LOADD || op == OP_LOADX || op == OP_LOAD8D || op == OP_LOAD8X {
        // 一条搞定：`mov d, [base+disp]` / `mov d, [base+idx*8]`
        // （LOAD8* 是 `movzx d, byte [...]`）。原来要 lea+mov+mov 三条算地址。
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        let mut isbyte = 0
        if op == OP_LOAD8D || op == OP_LOAD8X {
            isbyte = 1
        }
        // 基址已经在寄存器里就直接寻址（省掉一条 `mov rax, rXX`）；
        // 在帧槽里才搬进 RAX。`_modrm_mem` 会处理 RSP/R12 需要的 SIB。
        let aloc = fc.vloc.get(ins.a)
        let mut base = RAX
        if aloc > 0 {
            base = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        if op == OP_LOADD || op == OP_LOAD8D {
            _rex2(code, 1, d, base)
            if isbyte == 1 {
                _b(code, 0x0F)
                _b(code, 0xB6)
            } else {
                _b(code, 0x8B)
            }
            _modrm_mem(code, 2, d, base)
            _w32(code, ins.imm)
        } else {
            let idx = _idx_reg(fc, ins.b)
            _rex_full(code, 1, d, idx, base)
            if isbyte == 1 {
                _b(code, 0x0F)
                _b(code, 0xB6)
            } else {
                _b(code, 0x8B)
            }
            _modrm_sibidx(code, 2, d, base, idx, 3)
            _w32(code, 0)
        }
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_LOAD8I {
        // dst = 零扩展 [a + b]（SIB scale=0 即 ×1）
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        let aloc = fc.vloc.get(ins.a)
        let mut base = RAX
        if aloc > 0 {
            base = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let idx = _idx_reg(fc, ins.b)
        _rex_full(code, 1, d, idx, base)
        _b(code, 0x0F)
        _b(code, 0xB6)
        _modrm_sibidx(code, 2, d, base, idx, 0)
        _w32(code, 0)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_STORE8I {
        // [a + b] = dst 的低字节
        let idx = _idx_reg(fc, ins.b)
        let aloc = fc.vloc.get(ins.a)
        let mut base = RAX
        if aloc > 0 {
            base = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        _to_reg(fc, RCX, ins.dst)
        _rex_full(code, 0, RCX, idx, base)
        _b(code, 0x88)
        _modrm_sibidx(code, 2, RCX, base, idx, 0)
        _w32(code, 0)
        return
    }
    if op == OP_STORED || op == OP_STOREX || op == OP_STORE8D || op == OP_STORE8X {
        // 值是 ins.dst（STORE* 不写寄存器，dst 槽空着）；CL 是最稳的 8 位寄存器。
        let mut isbyte = 0
        if op == OP_STORE8D || op == OP_STORE8X {
            isbyte = 1
        }
        let mut idx = 0
        if op == OP_STOREX || op == OP_STORE8X {
            idx = _idx_reg(fc, ins.b)
        }
        // 基址已在寄存器里就直接寻址（同 LOAD*）
        let aloc = fc.vloc.get(ins.a)
        let mut base = RAX
        if aloc > 0 {
            base = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        _to_reg(fc, RCX, ins.dst)
        if op == OP_STORED || op == OP_STORE8D {
            if isbyte == 1 {
                _rex_full(code, 0, RCX, 0, base)
                _b(code, 0x88)
                _modrm_mem(code, 2, RCX, base)
                _w32(code, ins.imm)
            } else {
                _rex_full(code, 1, RCX, 0, base)
                _b(code, 0x89)
                _modrm_mem(code, 2, RCX, base)
                _w32(code, ins.imm)
            }
        } else {
            if isbyte == 1 {
                _rex_full(code, 0, RCX, idx, base)
                _b(code, 0x88)
                _modrm_sibidx(code, 2, RCX, base, idx, 3)
                _w32(code, 0)
            } else {
                _rex_full(code, 1, RCX, idx, base)
                _b(code, 0x89)
                _modrm_sibidx(code, 2, RCX, base, idx, 3)
                _w32(code, 0)
            }
        }
        return
    }
    if op == OP_DIVC {
        _emit_divc(fc, code, ins, i)
        return
    }
    if op == OP_LOAD8 {
        // 与 OP_LOAD 同构：**先把地址搬进寄存器**，再解引用。
        // 早期版本当地址在帧槽时直接发 `movzx d, byte [rbp+disp]` —— 那读的是
        // 槽本身而不是槽里存的那个地址所指的字节（v2.34 踩：str 下标取到的是
        // 栈地址的首字节，于是 `s[i] == 47` 恒为假，三连 && 的注释跳过失效，
        // 整个词法器在 stage-2 里读不了文件）。
        _to_reg(fc, RAX, ins.a)
        let dloc = fc.vloc.get(ins.dst)
        let mut d = RAX
        if dloc > 0 {
            d = dloc - 1
        }
        _rex2(code, 1, d, RAX)
        _b(code, 0x0F)
        _b(code, 0xB6)
        _modrm_mem(code, 2, d, RAX)
        _w32(code, 0)
        if dloc <= 0 {
            _mov_store(code, RBP, _slot_disp(-dloc - 1), d)
        }
        return
    }
    if op == OP_STORE8 {
        // 同上：地址进 RAX、值进 RCX（CL 是最稳的 8 位寄存器，不受 ah/ch/dh/bh 影响）
        _to_reg(fc, RAX, ins.a)
        _to_reg(fc, RCX, ins.b)
        _rex2(code, 0, RCX, RAX)
        _b(code, 0x88)
        _modrm_mem(code, 2, RCX, RAX)
        _w32(code, 0)
        return
    }
    if op == OP_RTADDR {
        // dst = &运行库例程（lea rip 相对 + FK_RT 回填）
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            let at = len(code) + 3
            _lea_rip(code, dloc - 1, 0)
            _addfix(fc.fixes, at, ins.imm, FK_RT)
        } else {
            let at = len(code) + 3
            _lea_rip(code, RAX, 0)
            _addfix(fc.fixes, at, ins.imm, FK_RT)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_CALLR {
        _to_reg(fc, RAX, ins.a)
        _mov_load(code, R11, RAX, 0)       // r11 = [闭包] = code
        _b(code, 0x41)                     // call r11
        _b(code, 0xFF)
        _b(code, 0xD3)
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_CALLIAT {
        let p = _call_rip(code)
        _addfix(fc.fixes, p, ins.imm, FK_IAT)
        if ins.dst > 0 {
            _store_rax(fc, fc.vloc.get(ins.dst))
        }
        return
    }
    if op == OP_RETAGG {
        let sv = fc.cells.get(C_SRET)
        // v2.51：运行库的指针实参改成 r8/r9（rsi/rdi 已是变量寄存器）。
        // **必须先落到 RAX/RDX 再搬** —— 它们发射器保留、永不持有 vreg，
        // 否则"某个操作数本来就在 r8/r9 里"会被提前踩掉。
        _to_reg(fc, RAX, sv)
        _to_reg(fc, RDX, ins.a)
        _mov_rr(code, R8, RAX)
        _mov_rr(code, R9, RDX)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        _to_reg(fc, RAX, sv)
        let p2 = _jmp(code)
        _addfix(fc.fixes, p2, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_RETSRET {
        _to_reg(fc, RAX, fc.cells.get(C_SRET))
        let p2 = _jmp(code)
        _addfix(fc.fixes, p2, fc.cells.get(C_EP), FK_LAB)
        return
    }
    if op == OP_ADDRV {
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _lea_rbp(code, dloc - 1, _slot_disp(ins.imm))
        } else {
            _lea_rbp(code, RAX, _slot_disp(ins.imm))
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_ADDRF {
        let aloc = fc.vloc.get(ins.a)
        let mut ar = RAX
        if aloc > 0 {
            ar = aloc - 1
        } else {
            _mov_load(code, RAX, RBP, _slot_disp(-aloc - 1))
        }
        let dloc = fc.vloc.get(ins.dst)
        if dloc > 0 {
            _lea_rm(code, dloc - 1, ar, ins.imm)
        } else {
            _lea_rm(code, RAX, ar, ins.imm)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_ADDRXN {
        // dst = a + b*imm（imul rcx, rcx, imm32）
        _to_reg(fc, RCX, ins.b)
        _b(code, 0x48)
        _b(code, 0x69)
        _b(code, 0xC9)
        _w32(code, ins.imm)
        _to_reg(fc, RAX, ins.a)
        _alu_rr(code, 0x01, RAX, RCX)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_ADDRX {
        _to_reg(fc, RCX, ins.b)
        _b(code, 0x48)                      // shl rcx, 3
        _b(code, 0xC1)
        _modrm(code, 3, 4, RCX)
        _b(code, 3)
        _to_reg(fc, RAX, ins.a)
        _alu_rr(code, 0x01, RAX, RCX)
        _store_rax(fc, fc.vloc.get(ins.dst))
        return
    }
    if op == OP_LOAD {
        _to_reg(fc, RAX, ins.a)
        let dloc = fc.vloc.get(ins.dst)
        // v2.55：读 f64（结构体字段 / 数组元素 / vec 元素 / 字面量槽）
        if fc.vty.get(ins.dst) == TY_F64 {
            _sse_mem0(code, 1, 0x10, XMM0, RAX)    // movsd xmm0, [rax]
            _from_xmm(fc, XMM0, ins.dst)
            return
        }
        // v3.36：按 imm 给的宽度分派。以前无条件发 8 字节 mov，
        // 于是 mem_load32 会读到 8 字节（高 32 位脏），差分立刻对不上。
        if ins.imm == 4 {
            if dloc > 0 {
                _mov_load32(code, dloc - 1, RAX, 0)
            } else {
                _mov_load32(code, RAX, RAX, 0)
                _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
            }
            return
        }
        if dloc > 0 {
            _mov_load(code, dloc - 1, RAX, 0)
        } else {
            _mov_load(code, RAX, RAX, 0)
            _mov_store(code, RBP, _slot_disp(-dloc - 1), RAX)
        }
        return
    }
    if op == OP_STORE {
        _to_reg(fc, RAX, ins.a)
        // v2.55：f64 值是 8 字节位模式，住 XMM —— `movsd [rax], xmm0`
        if fc.vty.get(ins.b) == TY_F64 {
            _to_xmm(fc, XMM0, ins.b)
            _sse_mem0(code, 1, 0x11, XMM0, RAX)
            return
        }
        _to_reg(fc, RCX, ins.b)
        _mov_store(code, RAX, 0, RCX)
        return
    }
    if op == OP_COPY {
        // v2.51：运行库的指针实参改成 r8/r9（rsi/rdi 已是变量寄存器）。
        // **必须先落到 RAX/RDX 再搬** —— 它们发射器保留、永不持有 vreg，
        // 否则"某个操作数本来就在 r8/r9 里"会被提前踩掉。
        _to_reg(fc, RAX, ins.a)
        _to_reg(fc, RDX, ins.b)
        _mov_rr(code, R8, RAX)
        _mov_rr(code, R9, RDX)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        return
    }
    if op == OP_MEMCPYN {
        // v2.51：运行库的指针实参改成 r8/r9（rsi/rdi 已是变量寄存器）。
        // **必须先落到 RAX/RDX 再搬** —— 它们发射器保留、永不持有 vreg，
        // 否则"某个操作数本来就在 r8/r9 里"会被提前踩掉。
        _to_reg(fc, RCX, ins.dst)          // 字节数（运行时）
        _to_reg(fc, RAX, ins.a)
        _to_reg(fc, RDX, ins.b)
        _mov_rr(code, R8, RAX)
        _mov_rr(code, R9, RDX)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_MEMCPY, FK_RT)
        return
    }
    if op == OP_ZERON {
        _to_reg(fc, RAX, ins.a)            // v2.51：实参改 r8
        _mov_rr(code, R8, RAX)
        _to_reg(fc, RCX, ins.b)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_ZERO, FK_RT)
        return
    }
    if op == OP_ZERO {
        _to_reg(fc, RAX, ins.a)            // v2.51：实参改 r8
        _mov_rr(code, R8, RAX)
        _mov_imm(code, RCX, ins.imm)
        let p = _call_rel(code)
        _addfix(fc.fixes, p, RT_ZERO, FK_RT)
        return
    }
    eprint("qlmc: 内部错误：未知 IR 操作 " + op.to_str())
    exit(2)
}

/// 一个函数实际需要的帧字节数（v2.44）。
///
/// 以前是**固定 4 KB**（`FRAME`），代价不是浪费点内存那么简单：每层递归都吃 4 KB，
/// 而 PE 的 `SizeOfStackReserve` 只有 1 MB → **递归深度上限约 250 层**。实测后果：
/// - qlmc 编自己时，`print(1+1+…+1)` 到 **37 项**就 `0xC00000FD`
///   （STATUS_STACK_OVERFLOW，降级是递归的，一层 AST 要好几帧）；
/// - qlmc 编出来的程序，`fn down(n){ if n<=0 {return 0}; return 1+down(n-1) }`
///   在 `n=400` 时栈溢出（stage-0 的产物跑 1000 没事）。
///
/// 现在按实际用量给：变量/聚合区看 `C_ST`，临时槽看 `vloc` 里最深的那个。
/// 上限仍是 `MAX_SLOT*8 = 4096`（分配器不给更深的槽），所以**永远不需要栈探测**
/// （§7.17 的红线是"帧 > 4 KB"）。
fn _frame_bytes(fc: FnCtx) -> int {
    let mut units = fc.cells.get(C_ST)
    let mut i = 1
    while i < len(fc.vloc) {
        let loc = fc.vloc.get(i)
        if loc < 0 {
            // loc = -(slot+1) → 槽号 +1 = -loc，字节数 = -8*loc
            let u = 0 - loc
            if u > units {
                units = u
            }
        }
        i = i + 1
    }
    // **必须给 Win64 的 32 字节影子空间留位置**（v2.44 踩过）：调用点没有
    // `sub rsp,0x20`（只有 >4 个实参才发 OP_STKALLOC），被调方默认
    // `[rsp .. rsp+0x20)` 可写。以前帧是 4 KB，这块"顺带"兜住了；帧缩到 16 字节
    // 之后影子空间直接压在活跃槽上 —— 现象是 `print(metric(0)+metric(1))`
    // 打出 1921（第二次调用的返回地址/影子区把前一个结果冲掉了）。
    let fb = units * 8 + 32
    // **没有栈探测**（帧一直都很小），所以超 4 KB 会跨过 guard page，Windows
    // 不会自动扩栈 —— 第一次写帧就 AV，而且表现为"换代码就换用例崩"（§7.17）。
    // 与其静默崩，不如在编译期 fail-fast。
    if fb > 4096 {
        eprint("qlmc: 帧超过 4 KB（" + fb.to_str() + " 字节）—— 需要栈探测，本版没有")
        eprint("  当前函数：" + fc.names.get(fc.fns.get(fc.cells.get(C_CFI)).name))
        exit(2)
    }
    return fb
}

/// 一个函数：序言（保存用到的 callee-saved）+ 体 + 尾声
fn _emit_fn(fc: FnCtx) {
    let code = fc.code
    let used = vec[int].new(N_VARREG)
    let mut i = 0
    while i < N_VARREG {
        used.push(0)
        i = i + 1
    }
    // 哪些 callee-saved 被变量占了（位置里出现过的）
    i = 1
    while i < len(fc.vloc) {
        let loc = fc.vloc.get(i)
        if loc > 0 {
            let k = _cs_index(loc - 1)
            if k >= 0 {
                used.set(k, 1)
            }
        }
        i = i + 1
    }
    let mut nsaved = 0
    i = 0
    while i < N_VARREG {
        if used.get(i) == 1 {
            _push_r(code, _cs_reg(i))
            nsaved = nsaved + 1
        }
        i = i + 1
    }
    _push_rbp(code)
    _mov_rbp_rsp(code)
    // 16 字节对齐：入口 rsp ≡ 8 (mod 16)，已 push (nsaved+1) 次。
    // (nsaved+1) 为奇数时 rsp 已 ≡ 0，帧取 16 的倍数；为偶数时要多补 8。
    let mut frame = _frame_bytes(fc)
    if frame < 16 {
        frame = 16
    }
    let rem = frame % 16
    if rem != 0 {
        frame = frame + (16 - rem)
    }
    if (nsaved + 1) % 2 == 0 {
        frame = frame + 8
    }
    // 栈形参的偏移要加 8*nsaved（见 C_NSAVED 的注释）
    fc.cells.set(C_NSAVED, nsaved)
    _sub_rsp(code, frame)
    // v2.55：保存被用到的 XMM 变量寄存器（XMM6-XMM15 在 Win64 里是 callee-saved，
    // 但 qlmc 以前一个都没用）。保存槽由 `_alloc` 在临时池之前分配。
    let mut xk = 0
    while xk < N_XMMVAR {
        let sl = fc.cells.get(C_XSAV0 + xk)
        if sl >= 0 {
            _sse_mem(code, 1, 0x11, XMM_VAR0 + xk, RBP, _slot_disp(sl))
        }
        xk = xk + 1
    }
    // f64 字面量的"已解析"标志槽：函数入口清零，否则第一次判断读的是上一帧的垃圾。
    // **不能走 IR** —— 分配已经跑完了，新开 vreg 会拿到 vloc = 0 而 fail-fast。
    // v2.56：编译期 f64 字面量的常量槽 —— 序言里写一次，之后全用内存操作数。
    // 与上面的标志槽一样**不能走 IR**（分配已跑完）。
    if len(fc.cells) > C_F64K_N {
        let mut fk = 0
        while fk < fc.cells.get(C_F64K_N) {
            _mov_imm(code, RAX, fc.cells.get(C_F64K0 + 3 * fk + 2))
            _mov_store(code, RBP, _slot_disp(fc.cells.get(C_F64K0 + 3 * fk + 1)), RAX)
            fk = fk + 1
        }
    }
    let mut fz = 0
    while fz < fc.cells.get(C_FNUM_NF) {
        _mov_imm_mem(code, RBP, _slot_disp(fc.cells.get(C_FNUM_FLAG0 + fz)), 0)
        fz = fz + 1
    }
    i = 0
    while i < len(fc.ir) {
        _emit_ir(fc, i)
        i = i + 1
    }
    let mut xk2 = N_XMMVAR - 1
    while xk2 >= 0 {
        let sl2 = fc.cells.get(C_XSAV0 + xk2)
        if sl2 >= 0 {
            _sse_mem(code, 1, 0x10, XMM_VAR0 + xk2, RBP, _slot_disp(sl2))
        }
        xk2 = xk2 - 1
    }
    _mov_rsp_rbp(code)
    _pop_rbp(code)
    i = N_VARREG - 1
    while i >= 0 {
        if used.get(i) == 1 {
            _pop_r(code, _cs_reg(i))
        }
        i = i - 1
    }
    _ret(code)
}

/// __zero(r8 = 地址, rcx = 字节数)：逐字节清零
/// v2.51：地址参数从 `rdi` 改成 **`r8`** —— `rdi` 现在是变量寄存器（callee-saved）。
fn _gen_zero(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_ZERO, len(code))
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x48)                         // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)
    _addfix(ctx.fixes, p0, ldone, FK_LAB)
    _setlab(labs, code, ltop)
    _b(code, 0x41)                         // mov byte [r8], 0
    _b(code, 0xC6)
    _b(code, 0x00)
    _b(code, 0)
    _b(code, 0x49)                         // inc r8
    _b(code, 0xFF)
    _b(code, 0xC0)
    _b(code, 0x48)                         // dec rcx
    _b(code, 0xFF)
    _b(code, 0xC9)
    let p1 = _jcc(code, 0x85)
    _addfix(ctx.fixes, p1, ltop, FK_LAB)
    _setlab(labs, code, ldone)
    _ret(code)
}

/// __join(h)：等线程结束并取返回值（v2.32）。h = 0 直接返回 0。
///   rcx = 句柄记录：[0]=线程句柄 [1]=参数块；参数块 [0]=返回值
fn _gen_join(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_JOIN, len(code))
    let lzero = _newlab(labs)
    _b(code, 0x48)                             // test rcx, rcx
    _b(code, 0x85)
    _b(code, 0xC9)
    let p0 = _jcc(code, 0x84)                  // jz .zero
    _addfix(ctx.fixes, p0, lzero, FK_LAB)
    _b(code, 0x53)                             // push rbx（入口 rsp≡8，压完 ≡0）
    // **必须再留 32 字节影子空间**（v2.45 修）：Win64 的 home area 是
    // `[rsp, rsp+0x20)`（rsp = 被调方入口的 rsp），而 `push rbx` 刚好把调用方的
    // rbx 存在那个位置 —— WaitForSingleObject / CloseHandle 一进来就把保存的 rbx
    // 覆盖成自己的 spill，返回后 `pop rbx` 弹回垃圾。现象：**join 之后调用方
    // rbx 里的变量被静默改掉**（实测 `let pad = 11` 变成 0x140003048，
    // 用它做计时起点会算出 6.4e13 ns）。sub/add 0x20 都是 16 的倍数，对齐不变。
    _sub_rsp(code, 0x20)
    _b(code, 0x48)                             // mov rbx, rcx
    _b(code, 0x89)
    _b(code, 0xCB)
    _b(code, 0x48)                             // mov rcx, [rbx]（线程句柄）
    _b(code, 0x8B)
    _b(code, 0x0B)
    _b(code, 0x48)                             // mov rdx, -1（INFINITE）
    _b(code, 0xC7)
    _b(code, 0xC2)
    _w32(code, -1)
    let p1 = _call_rip(code)                   // WaitForSingleObject
    _addfix(ctx.fixes, p1, I_WAIT, FK_IAT)
    _b(code, 0x48)                             // mov rcx, [rbx]
    _b(code, 0x8B)
    _b(code, 0x0B)
    let p2 = _call_rip(code)                   // CloseHandle
    _addfix(ctx.fixes, p2, I_CLOSE, FK_IAT)
    _b(code, 0x48)                             // mov rax, [rbx+8]（参数块）
    _b(code, 0x8B)
    _b(code, 0x43)
    _b(code, 0x08)
    _b(code, 0x48)                             // mov rax, [rax]（返回值）
    _b(code, 0x8B)
    _b(code, 0x00)
    _add_rsp(code, 0x20)                       // 还掉影子空间（见上面 push rbx 处）
    _b(code, 0x5B)                             // pop rbx
    _ret(code)
    _setlab(labs, code, lzero)
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

/// __spawn_entry(rcx = 参数块)：线程入口（ThreadProc）。
/// 块布局：[0]=返回值 [1]=目标函数地址 [2]=实参个数 [3+i]=第 i 个实参。
/// 一个入口吃所有形状——理由见 _lower_spawn 的注释（站点在发射期才知道）。
///
/// 要点：
///   ① 入口没有序言，rsp 进来是 ≡8(mod 16)；先 push rbp 把它抬成 ≡0，
///      后面 `sub rsp, stk`（stk 是 16 的倍数）才能保持对齐。
///   ② 栈实参放 `[rsp + 8*i]`：调用方约定是 `[rsp+32+8*(i-4)]`，两者相等。
///   ③ 用 rbx 存块指针（callee-saved，跨 `call [rbx+8]` 安全），
///      r12 只用来记 stk，收尾直接 `mov rsp, rbp` 更省事。
fn _gen_spawn(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_SPAWN, len(code))
    let lreg = _newlab(labs)
    let lal = _newlab(labs)
    let ltop = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x55)                             // push rbp
    // **必须保存 rbx / r12**：线程回调也是一个"函数"，BaseThreadInitThunk
    // 会依赖非易失寄存器。v2.36 实测：这里直接用 rbx 存块指针、r12 存栈大小
    // 而不保存，线程返回后崩在 thunk 的清理里（fault_probe 报「读 0xFFFF…FFFF」、
    // RIP 在 DLL、R12=-1）—— 只在"编 qlmc 自己"这种重活上暴露，编小文件看不出来。
    _b(code, 0x53)                             // push rbx
    _b(code, 0x41)                             // push r12
    _b(code, 0x54)
    _b(code, 0x48)                             // mov rbp, rsp
    _b(code, 0x89)
    _b(code, 0xE5)
    _b(code, 0x48)                             // mov rbx, rcx
    _b(code, 0x89)
    _b(code, 0xCB)
    _b(code, 0x4C)                             // mov r10, [rbx+16]（实参个数）
    _b(code, 0x8B)
    _b(code, 0x53)
    _b(code, 0x10)
    _b(code, 0x45)                             // xor r12d, r12d
    _b(code, 0x31)
    _b(code, 0xE4)
    _b(code, 0x49)                             // cmp r10, 4
    _b(code, 0x83)
    _b(code, 0xFA)
    _b(code, 0x04)
    let p0 = _jcc(code, 0x86)                  // jbe .noreg
    _addfix(ctx.fixes, p0, lreg, FK_LAB)
    _b(code, 0x4D)                             // mov r12, r10
    _b(code, 0x89)
    _b(code, 0xD4)
    _b(code, 0x49)                             // sub r12, 4
    _b(code, 0x83)
    _b(code, 0xEC)
    _b(code, 0x04)
    _b(code, 0x49)                             // shl r12, 3
    _b(code, 0xC1)
    _b(code, 0xE4)
    _b(code, 0x03)
    _b(code, 0x49)                             // add r12, 32（shadow space）
    _b(code, 0x83)
    _b(code, 0xC4)
    _b(code, 0x20)
    _b(code, 0x41)                             // test r12b, 8
    _b(code, 0xF6)
    _b(code, 0xC4)
    _b(code, 0x08)
    let p1 = _jcc(code, 0x84)                  // jz .aligned
    _addfix(ctx.fixes, p1, lal, FK_LAB)
    _b(code, 0x49)                             // add r12, 8
    _b(code, 0x83)
    _b(code, 0xC4)
    _b(code, 0x08)
    _setlab(labs, code, lal)
    _b(code, 0x4C)                             // sub rsp, r12
    _b(code, 0x29)
    _b(code, 0xE4)
    _b(code, 0x48)                             // mov rcx, 4（从第 5 个实参开始拷）
    _b(code, 0xC7)
    _b(code, 0xC1)
    _w32(code, 4)
    _setlab(labs, code, ltop)
    _b(code, 0x4C)                             // cmp rcx, r10
    _b(code, 0x39)
    _b(code, 0xD1)
    let p2 = _jcc(code, 0x83)                  // jae .done
    _addfix(ctx.fixes, p2, ldone, FK_LAB)
    _b(code, 0x48)                             // mov rax, [rbx+rcx*8+24]
    _b(code, 0x8B)
    _b(code, 0x44)
    _b(code, 0xCB)
    _b(code, 24)
    _b(code, 0x48)                             // mov [rsp+rcx*8], rax
    _b(code, 0x89)
    _b(code, 0x04)
    _b(code, 0xCC)
    _b(code, 0x48)                             // inc rcx
    _b(code, 0xFF)
    _b(code, 0xC1)
    let p3 = _jmp(code)
    _addfix(ctx.fixes, p3, ltop, FK_LAB)
    _setlab(labs, code, ldone)
    _setlab(labs, code, lreg)
    _b(code, 0x48)                             // mov rcx, [rbx+24]
    _b(code, 0x8B)
    _b(code, 0x4B)
    _b(code, 24)
    _b(code, 0x48)                             // mov rdx, [rbx+32]
    _b(code, 0x8B)
    _b(code, 0x53)
    _b(code, 32)
    _b(code, 0x4C)                             // mov r8, [rbx+40]
    _b(code, 0x8B)
    _b(code, 0x43)
    _b(code, 40)
    _b(code, 0x4C)                             // mov r9, [rbx+48]
    _b(code, 0x8B)
    _b(code, 0x4B)
    _b(code, 48)
    _b(code, 0xFF)                             // call [rbx+8]
    _b(code, 0x53)
    _b(code, 0x08)
    _b(code, 0x48)                             // mov [rbx], rax（写回返回值）
    _b(code, 0x89)
    _b(code, 0x03)
    _b(code, 0x48)                             // mov rsp, rbp
    _b(code, 0x89)
    _b(code, 0xEC)
    _b(code, 0x41)                             // pop r12
    _b(code, 0x5C)
    _b(code, 0x5B)                             // pop rbx
    _b(code, 0x5D)                             // pop rbp
    _b(code, 0x31)                             // xor eax, eax（ThreadProc 返回 0）
    _b(code, 0xC0)
    _ret(code)
}

/// __eprint_str(rcx = str)：写 stderr + 换行（v2.33）。与 __print_str 同形，
/// 只把 GetStdHandle 的实参从 -11（stdout）换成 -12（stderr）。
fn _gen_eprint_str(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_EPRINT, len(code))
    _sub_rsp(code, 0x68)
    _mov_rsp_store(code, 0x28, RCX)
    _mov_imm(code, RCX, -12)
    let c1 = _call_rip(code)
    _addfix(ctx.fixes, c1, I_GETSTD, 3)
    _mov_rsp_store(code, 0x30, RAX)
    _mov_rr(code, RCX, RAX)
    _mov_rsp_load(code, RDX, 0x28)
    _mov_rsp_load(code, R8, 0x28)
    _len_of(code, R8, R8)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c2 = _call_rip(code)
    _addfix(ctx.fixes, c2, I_WRITE, 3)
    _mov_rsp_load(code, RCX, 0x30)
    let at = len(code) + 3
    _lea_rip(code, RDX, 0)
    _addfix(ctx.fixes, at, -3, 2)
    _mov_imm(code, R8, 1)
    _lea_rsp(code, R9, 0x50)
    _mov_rsp_imm32(code, 0x20, 0)
    let c3 = _call_rip(code)
    _addfix(ctx.fixes, c3, I_WRITE, 3)
    _add_rsp(code, 0x68)
    _ret(code)
}

/// __fneg(rcx = 目标槽, rdx = 源槽)：dst = -src。翻符号位（XOR 最高位），
/// 不走 `0 - x`：既省一个 0.0 常量槽，也天然保住 -0.0 的符号。
fn _gen_fneg(ctx: Ctx) {
    let code: vec[int] = ctx.code
    ctx.rt_pos.set(RT_FNEG, len(code))
    _b(code, 0x48)                             // mov rax, [rdx]
    _b(code, 0x8B)
    _b(code, 0x02)
    _b(code, 0x49)                             // mov r8, 0x8000000000000000
    _b(code, 0xB8)
    _w64(code, 0x8000000000000000)
    _b(code, 0x4C)                             // xor rax, r8
    _b(code, 0x31)
    _b(code, 0xC0)
    _b(code, 0x48)                             // mov [rcx], rax
    _b(code, 0x89)
    _b(code, 0x01)
    _b(code, 0x31)                             // xor eax, eax
    _b(code, 0xC0)
    _ret(code)
}

/// __f64_fmt(rcx = 缓冲, rdx = f64 源槽) -> rax = 文本长度（不含 NUL）
///
/// **为什么手写**：`wsprintfA`（user32）不支持浮点，msvcrt 的 `sprintf` 在无 CRT
/// 上下文里写不出东西（两条路 v2.39 实测过，见 07-gaps §7.26）。口径对齐 stage-0
/// 的 `__f64_to_str`：
///   `|x| == 0` → `0`；NaN → `nan`；±inf → `inf` / `-inf`
///   `1e-6 <= |x| < 1e12` → 定点：`u=(i64)(|x|*1e6+0.5)`、`ip=u/1e6`、`fp=u%1e6`，
///                          打印 ip，`fp != 0` 时 `.` + 6 位零填充 + 去尾零
///   其余 → 科学计数
///
/// 状态全放栈槽（调 `__i64_fmt` 时所有易失寄存器都不保）：
///   [rsp+0x40]=缓冲  [rsp+0x48]=pos  [rsp+0x50]=fp/rest  [rsp+0x58]=exp
///
/// 小数那 6 位用**只碰低寄存器**的除法循环（rcx/rdx/rax 都是低编号，不需要
/// REX.R/X）—— v2.40 用 r9/r10 做下标，REX 前缀连错三处，白折腾一轮。
fn _gen_f64_fmt(ctx: Ctx) {
    let code: vec[int] = ctx.code
    let labs: vec[int] = ctx.labs
    ctx.rt_pos.set(RT_F64FMT, len(code))
    let lzero = _newlab(labs)
    let lnan = _newlab(labs)
    let linf = _newlab(labs)
    let linfp = _newlab(labs)
    let lsign = _newlab(labs)
    let lsci = _newlab(labs)
    let lemit = _newlab(labs)
    let lhi = _newlab(labs)
    let llo = _newlab(labs)
    let llo2 = _newlab(labs)
    let lnorm = _newlab(labs)
    let lmn = _newlab(labs)
    let lnofrac = _newlab(labs)
    let lepos = _newlab(labs)
    let leout = _newlab(labs)
    let ldl = _newlab(labs)
    let ltr = _newlab(labs)
    let ltrp = _newlab(labs)
    let ltrd = _newlab(labs)
    let lfin = _newlab(labs)
    let ldone = _newlab(labs)
    _b(code, 0x55)                             // push rbp
    _b(code, 0x48)
    _b(code, 0x89)
    _b(code, 0xE5)
    _sub_rsp(code, 0x70)
    _b(code, 0x48)                             // mov [rsp+0x40], rcx（缓冲）
    _b(code, 0x89)
    _b(code, 0x4C)
    _b(code, 0x24)
    _b(code, 0x40)
    _b(code, 0x48)                             // mov qword [rsp+0x48], 0（pos）
    _b(code, 0xC7)
    _b(code, 0x44)
    _b(code, 0x24)
    _b(code, 0x48)
    _w32(code, 0)
    _b(code, 0xF2)                             // movsd xmm0, [rdx]
    _b(code, 0x0F)
    _b(code, 0x10)
    _b(code, 0x02)
    _b(code, 0x66)                             // movq rax, xmm0
    _b(code, 0x48)
    _b(code, 0x0F)
    _b(code, 0x7E)
    _b(code, 0xC0)
    _b(code, 0x49)                             // mov r8, 0x7fff…
    _b(code, 0xB8)
    _w64(code, 0x7FFFFFFFFFFFFFFF)
    _b(code, 0x4C)                             // and rax, r8
    _b(code, 0x21)
    _b(code, 0xC0)
    _b(code, 0x48)                             // test rax, rax
    _b(code, 0x85)
    _b(code, 0xC0)
