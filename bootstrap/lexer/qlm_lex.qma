// bootstrap/lexer/qlm_lex.qma
// Quelmara 自举词法器（stage-1）—— 用 Quelmara 自己写的第一个编译组件。
//
// 用法：qlm_lex <file.qma>
// 输出：每行一个 token，格式 `KIND|RAW|LINE`（协议见 tools/dev/tokfmt.py）
//   KIND ∈ KW / NAME / INT / FLOAT / STR / SYM / EOF
//   RAW  = 源码原文切片（STR 去掉引号；数字保留 `_` 与 `f` 后缀）
//   LINE = token 起始行号（1 起）
//   转义：反斜杠→\\，竖线→\|，换行→\n，制表→\t，回车→\r
//
// 设计约束：流式输出，不建 token 数组（不需要可变长容器）；
// 关键字用 == 链判断；token 文本用 substr 抽取。
module qlm_lex

fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_alpha(c: int) -> bool {
    if c == 95 { return true }                       // _
    if c >= 65 && c <= 90 { return true }            // A-Z
    if c >= 97 && c <= 122 { return true }           // a-z
    return false
}

fn is_alnum(c: int) -> bool {
    return is_alpha(c) || is_digit(c)
}

fn is_hex(c: int) -> bool {
    if is_digit(c) { return true }
    if c >= 97 && c <= 102 { return true }     // a-f
    if c >= 65 && c <= 70 { return true }      // A-F
    return false
}

fn is_bin(c: int) -> bool {
    return c == 48 || c == 49
}

fn is_oct(c: int) -> bool {
    return c >= 48 && c <= 55
}

// 关键字：与 tools/stage0/qlm.py 的 KEYWORDS 逐条对齐
fn is_keyword(w: str) -> bool {
    if w == "fn" { return true }
    if w == "let" { return true }
    if w == "mut" { return true }
    if w == "if" { return true }
    if w == "else" { return true }
    if w == "while" { return true }
    if w == "for" { return true }
    if w == "parfor" { return true }
    if w == "return" { return true }
    if w == "module" { return true }
    if w == "import" { return true }
    if w == "true" { return true }
    if w == "false" { return true }
    if w == "test" { return true }
    if w == "break" { return true }
    if w == "continue" { return true }
    if w == "struct" { return true }
    if w == "enum" { return true }
    if w == "match" { return true }
    if w == "arena" { return true }
    if w == "spawn" { return true }
    if w == "chan" { return true }
    if w == "option" { return true }
    if w == "result" { return true }
    if w == "map" { return true }
    if w == "select" { return true }
    if w == "const" { return true }
    if w == "vec" { return true }
    return false
}

// 单字符运算符：(){}[],:.=<>+-*/%!?@
fn is_one(c: int) -> bool {
    if c == 40 { return true }
    if c == 41 { return true }
    if c == 123 { return true }
    if c == 125 { return true }
    if c == 91 { return true }
    if c == 93 { return true }
    if c == 44 { return true }
    if c == 58 { return true }
    if c == 46 { return true }
    if c == 61 { return true }
    if c == 60 { return true }
    if c == 62 { return true }
    if c == 43 { return true }
    if c == 45 { return true }
    if c == 42 { return true }
    if c == 47 { return true }
    if c == 37 { return true }
    if c == 33 { return true }
    if c == 63 { return true }
    if c == 64 { return true }
    if c == 38 { return true }      // &
    if c == 124 { return true }     // |
    if c == 94 { return true }      // ^
    if c == 126 { return true }     // ~
    return false
}

// 输出转义：让协议保持单行、可 diff
fn esc(s: str) -> str {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let c = s[i]
        if c == 92 {
            out = out + "\\\\"
        } else if c == 124 {
            out = out + "\\|"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 13 {
            out = out + "\\r"
        } else {
            out = out + chr(c)
        }
        i += 1
    }
    return out
}

fn emit(kind: str, raw: str, line: int) {
    print(kind + "|" + esc(raw) + "|" + line.to_str())
}

fn main() {
    let a = args()
    if len(a) != 1 {
        print("ERR|usage: qlm_lex <file.qma>")
        return
    }
    let src = read_text(a[0])
    let n = len(src)
    let mut i = 0
    let mut line = 1

    while i < n {
        let c = src[i]

        // ---- 空白 ----
        if c == 10 {
            line += 1
            i += 1
        } else if c == 32 || c == 9 || c == 13 {
            i += 1

        // ---- 行注释 ----
        } else if c == 47 && i + 1 < n && src[i + 1] == 47 {
            while i < n && src[i] != 10 {
                i += 1
            }

        // ---- 块注释 ----
        } else if c == 47 && i + 1 < n && src[i + 1] == 42 {
            i += 2
            let mut closed = 0
            while i < n && closed == 0 {
                if src[i] == 10 {
                    line += 1
                    i += 1
                } else if src[i] == 42 && i + 1 < n && src[i + 1] == 47 {
                    i += 2
                    closed = 1
                } else {
                    i += 1
                }
            }

        // ---- 0x / 0b / 0o ----
        } else if is_digit(c) && i + 1 < n && c == 48 &&
                   (src[i + 1] == 120 || src[i + 1] == 88 ||
                    src[i + 1] == 98 || src[i + 1] == 66 ||
                    src[i + 1] == 111 || src[i + 1] == 79) {
            let pfx = src[i + 1]
            let mut j = i + 2
            if pfx == 120 || pfx == 88 {
                while j < n && (is_hex(src[j]) || src[j] == 95) {
                    j += 1
                }
            } else if pfx == 98 || pfx == 66 {
                while j < n && (is_bin(src[j]) || src[j] == 95) {
                    j += 1
                }
            } else {
                while j < n && (is_oct(src[j]) || src[j] == 95) {
                    j += 1
                }
            }
            emit("INT", substr(src, i, j - i), line)
            i = j

        // ---- 数字：INT / FLOAT ----
        } else if is_digit(c) {
            let start = i
            let mut is_float = 0
            let mut j = i
            while j < n && (is_digit(src[j]) || src[j] == 95) {
                j += 1
            }
            if j + 1 < n && src[j] == 46 && is_digit(src[j + 1]) {
                is_float = 1
                j += 1
                while j < n && (is_digit(src[j]) || src[j] == 95) {
                    j += 1
                }
            }
            if j < n && (src[j] == 101 || src[j] == 69) {
                let mut k2 = j + 1
                if k2 < n && (src[k2] == 43 || src[k2] == 45) {
                    k2 += 1
                }
                if k2 < n && is_digit(src[k2]) {
                    is_float = 1
                    j = k2
                    while j < n && (is_digit(src[j]) || src[j] == 95) {
                        j += 1
                    }
                }
            }
            // `f` 后缀 = f32；后面紧跟字母数字时不算后缀（如 1f_x）
            if is_float == 1 && j < n && src[j] == 102 && !(j + 1 < n && is_alnum(src[j + 1])) {
                j += 1
            }
            let raw = substr(src, start, j - start)
            if is_float == 1 {
                emit("FLOAT", raw, line)
            } else {
                emit("INT", raw, line)
            }
            i = j

        // ---- 标识符 / 关键字 ----
        } else if is_alpha(c) {
            let start = i
            let mut j = i
            while j < n && is_alnum(src[j]) {
                j += 1
            }
            let w = substr(src, start, j - start)
            if is_keyword(w) {
                emit("KW", w, line)
            } else {
                emit("NAME", w, line)
            }
            i = j

        // ---- 字符串 ----
        } else if c == 34 {
            let startline = line
            let mut j = i + 1
            let mut closed = 0
            while j < n && closed == 0 {
                if src[j] == 92 && j + 1 < n {
                    j += 2
                } else if src[j] == 34 {
                    closed = 1
                } else {
                    if src[j] == 10 {
                        line += 1
                    }
                    j += 1
                }
            }
            if closed == 0 {
                print("ERR|unterminated string")
                return
            }
            emit("STR", substr(src, i + 1, j - i - 1), startline)
            i = j + 1

        // ---- 双字符运算符 ----
        } else if is_one(c) {
            let mut matched = 0
            // 四字符优先（>>>=），再三字符（<<= >>= >>>）
            if i + 3 < n {
                let four = substr(src, i, 4)
                if four == ">>>=" {
                    emit("SYM", four, line)
                    i += 4
                    matched = 1
                }
            }
            if matched == 0 && i + 2 < n {
                let three = substr(src, i, 3)
                if three == "<<=" || three == ">>=" || three == ">>>" {
                    emit("SYM", three, line)
                    i += 3
                    matched = 1
                }
            }
            if matched == 0 && i + 1 < n {
                let two = substr(src, i, 2)
                if two == "->" || two == "==" || two == "!=" || two == "<=" ||
                   two == ">=" || two == "&&" || two == "||" || two == "+=" ||
                   two == "-=" || two == "*=" || two == "/=" || two == ".." ||
                   two == "=>" || two == "<<" || two == ">>" || two == "&=" ||
                   two == "|=" || two == "^=" || two == "%=" {
                    emit("SYM", two, line)
                    i += 2
                    matched = 1
                }
            }
            if matched == 0 {
                if is_one(c) {
                    emit("SYM", chr(c), line)
                    i += 1
                } else {
                    print("ERR|illegal char")
                    return
                }
            }

        // ---- 其它：非法字符 ----
        } else {
            print("ERR|illegal char")
            return
        }
    }

    emit("EOF", "", line)
}
