// traffic_light.ros：红绿灯状态机（游戏/实时系统的 enum + match）
// 自校验：每个转移都带 assert；三条后端输出逐字节一致
module traffic_light

enum Light {
    Red
    Yellow
    Green
    Flashing(rate: int)
}

fn next(l: Light) -> Light {
    return match l {
        Light.Red => Light.Green
        Light.Green => Light.Yellow
        Light.Yellow => Light.Red
        Light.Flashing(rate) => Light.Red
    }
}

fn name(l: Light) -> str {
    return match l {
        Light.Red => "RED"
        Light.Yellow => "YELLOW"
        Light.Green => "GREEN"
        Light.Flashing(rate) => "FLASH@ " + rate.to_str()
    }
}

fn can_go(l: Light) -> bool {
    return match l {
        Light.Green => true
        _ => false
    }
}

fn main() {
    let l0 = Light.Red
    assert(name(l0) == "RED", "start red")
    assert(can_go(l0) == false, "red cannot go")
    print(name(l0))

    // 走 7 步状态机
    let mut l = l0
    let mut steps = 0
    while steps < 7 {
        l = next(l)
        steps += 1
        print("step " + steps.to_str() + " -> " + name(l))
    }

    // 7 步后：红 -> 绿 -> 黄 -> 红 -> 绿 -> 黄 -> 红 -> 绿
    assert(name(l) == "GREEN", "cycle position")
    assert(can_go(l) == true, "green can go")

    // 带载荷的变体 + 通配
    let warn = Light.Flashing(rate: 4)
    assert(name(warn) == "FLASH@ 4", "flashing name")
    assert(can_go(warn) == false, "flashing cannot go")
    print(name(warn))

    // 值语义：拷贝互不影响
    let w2 = warn
    assert(name(w2) == "FLASH@ 4", "copy keeps payload")
    print("ok traffic_light")
}
