// hello.ros — Quelmara 最小程序
module hello

import std.core

fn greet(name: str) -> str {
    return "Hello, " + name
}

fn main() {
    print(greet("Quelmara"))
    print("cores online: " + cores().to_str())

    let mut i = 0
    while i < 3 {
        print("tick " + i.to_str())
        i = i + 1
    }
}
