// echo_server.ros — 原生网络：epoll/io_uring 非阻塞百万连接 echo 服务器
// 资源上限由根目录 Quelmara.toml [net] 节声明，超限 fail-fast。
module echo_server

import std.net
import std.core

fn on_connect(c: net.Conn) {
    print("peer connected: " + c.peer_addr())
}

fn on_data(c: net.Conn, data: []byte) -> net.Action {
    c.write(data)?                 // 零拷贝回写，buffer 用后归还池
    return net.Action.Keep
}

fn on_close(c: net.Conn) {
    print("peer closed")
}

fn main() {
    let server = net.TcpServer {
        addr:         "0.0.0.0:9000"
        backlog:      65535
        max_conns:    1000000
        io_threads:   0              // 0 = 自动（按 [core] 线程数）
        nodelay:      true
        reuse_port:   true
        on_connect:   on_connect
        on_data:      on_data
        on_close:     on_close
    }
    print("echo server listening on :9000")
    server.serve()
}
