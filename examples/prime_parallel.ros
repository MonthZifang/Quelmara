module prime_parallel

// 多核素数统计：parfor 自动分块 + 跨核归约
// [core] multicore = false 时编译期降级为串行，代码零改动、结果不变（SPEC §4 规则 2）

fn is_prime(n: int) -> bool {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let mut d = 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 2
    }
    return true
}

fn main() {
    let mut count = 0
    parfor i in 0..100000 {
        if is_prime(i) {
            count += 1
        }
    }
    print(count)
    print(cores())

    assert(count == 9592, "10 万以内素数个数")
}
