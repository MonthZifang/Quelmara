// examples/https_get.qma —— 用自研 TLS 栈发一次 HTTPS GET（v1.25）
//
// 这是 Quelmara 第一次"自己联网"：tcp_connect（系统 DNS）→ TLS 1.3 握手
// → 应用数据记录。只演示一次请求/响应；证书链与域名校验仍未做。

import std.net
import std.tls13
import std.tls_client
import std.tls_net

fn main() {
    let host = "example.com"
    let r = tls_connect(host, 443)
    if r.ok != 1 {
        eprint("tls handshake failed: " + r.err)
        return
    }
    print("handshake ok (cv=" + r.cv.to_str() + ")")

    let req = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    let n = tls_send_app(r, 0, req)
    print("sent " + n.to_str() + " bytes")

    let resp = tls_read_app(r, 0)
    print("got " + len(resp).to_str() + " bytes")
    print(substr(resp, 0, 15))
    tcp_close(r.fd)
}
