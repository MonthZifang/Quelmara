// bench/sync_bench.qma：并发原语单线程开销（rdtsc 程序内自计时）
// v1.98 起覆盖：普通自增 / atomic_add / mutex / 栈 push+pop（MPMC 安全）/
// 栈 push+pop_single（单消费者快路径）/ chan send+recv / wg_wait 检查成本。
// 测量纪律：本机进程冷启动 ~426ms（Hyper-V/VBS），微基准必须排除它。
module bench_sync

import std.sync

fn spin_atomic(n: int) -> int {
    let p = static_word(5)
    let mut k = 0
    while k < n {
        atomic_add(p, 1)
        k = k + 1
    }
    return mem_load64(p, 0)
}

fn spin_plain(n: int) -> int {
    let mut k = 0
    let mut s = 0
    while k < n {
        s = s + 1
        k = k + 1
    }
    return s
}

fn spin_mutex(n: int) -> int {
    let m = mutex_new()
    let ctr = mem_alloc(8)
    let mut k = 0
    while k < n {
        mutex_lock(m)
        let v = mem_load64(ctr, 0)
        mem_store64(ctr, 0, v + 1)
        mutex_unlock(m)
        k = k + 1
    }
    return mem_load64(ctr, 0)
}

fn spin_stack(n: int) -> int {
    let s = stack_new()
    let mut k = 0
    while k < n {
        stack_push(s, k)
        stack_pop(s)
        k = k + 1
    }
    return stack_pop(s)
}

fn spin_stack_single(n: int) -> int {
    let s = stack_new()
    let mut k = 0
    while k < n {
        stack_push(s, k)
        stack_pop_single(s)
        k = k + 1
    }
    return stack_pop_single(s)
}

fn spin_chan(n: int) -> int {
    let ch = chan[int].open(1)
    let mut k = 0
    let mut acc = 0
    while k < n {
        ch.send(k)
        acc = acc + ch.recv()
        k = k + 1
    }
    ch.close()
    return acc
}

fn spin_wg(n: int) -> int {
    let w = wg_new()
    let mut k = 0
    while k < n {
        wg_wait(w)          // 计数已为 0：只测"检查一次"的成本
        k = k + 1
    }
    return mem_load64(w, 0)
}

fn main() {
    let n = 2000000
    // 预热（缓存/分支预测/内联路径热身）
    let w1 = spin_plain(10000)
    let w2 = spin_atomic(10000)
    let w3 = spin_mutex(10000)
    let w4 = spin_stack(10000)
    let w5 = spin_stack_single(10000)
    let w6 = spin_chan(10000)
    let w7 = spin_wg(10000)

    let t0 = now_cycle()
    let r1 = spin_plain(n)
    let t1 = now_cycle()
    let r2 = spin_atomic(n)
    let t2 = now_cycle()
    let r3 = spin_mutex(n)
    let t3 = now_cycle()
    let r4 = spin_stack(n)
    let t4 = now_cycle()
    let r5 = spin_stack_single(n)
    let t5 = now_cycle()
    let r6 = spin_chan(n)
    let t6 = now_cycle()
    let r7 = spin_wg(n)
    let t7 = now_cycle()

    assert(r1 == n and r2 == n and r3 == n, "bench counter")
    assert(r4 == 0 and r5 == 0, "bench stack drained")
    assert(r7 == 0, "bench wg zero")
    assert(r6 >= 0, "bench chan")

    print("plain  inc :")
    print(t1 - t0)
    print("atomic add:")
    print(t2 - t1)
    print("mutex  RMW :")
    print(t3 - t2)
    print("stack push+pop(MPMC):")
    print(t4 - t3)
    print("stack push+pop(single):")
    print(t5 - t4)
    print("chan send+recv:")
    print(t6 - t5)
    print("wg_wait(no wait):")
    print(t7 - t6)
    print("cycles/iter (n=2e6):")
    print((t1 - t0) / n)
    print((t2 - t1) / n)
    print((t3 - t2) / n)
    print((t4 - t3) / n)
    print((t5 - t4) / n)
    print((t6 - t5) / n)
    print((t7 - t6) / n)
}
