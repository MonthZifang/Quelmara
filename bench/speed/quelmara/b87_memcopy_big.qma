// b87_memcopy_big —— 内存：mem_copy 大块 100MB（直接量三级拷贝：
// 16B movdqu → 8B qword → 尾部；与 b31 的 vec push/get 循环正交）
fn main() {
    let n = 12500000
    let src = mem_alloc(n * 8)
    let dst = mem_alloc(n * 8)
    // 填充 src：槽索引语义（每 8 字节一个 qword）
    let mut i = 0
    while i < n {
        mem_store64(src, i, i * 7 + 1)
        i = i + 1
    }
    let t0 = now_ns()
    mem_copy(dst, src, n * 8)
    let t1 = now_ns()
    // 校验：首/中/尾三点
    let c1 = mem_load64(dst, 0)
    let c2 = mem_load64(dst, 6250000)
    let c3 = mem_load64(dst, n - 1)
    let chk = c1 + c2 + c3
    print(chk)
    print("T")
    print(t1 - t0)
}
