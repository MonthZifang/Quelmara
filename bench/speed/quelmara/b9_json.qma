// b9_json —— JSON 解析：同一份 2590 字节的文档解析 2000 遍，累加所有数字。
// 数字一律按整数解析（不处理小数/指数），字符串/true/false/null 记 0。
// 四个语言用**同一份文档、同一套递归下降算法**，量的是语言而不是库。
fn jws(s: str, p0: int) -> int {
    let n = len(s)
    let mut p = p0
    let mut go = 1
    while go == 1 && p < n {
        let c = s[p]
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p = p + 1
        } else {
            go = 0
        }
    }
    return p
}

fn jstr(s: str, p0: int) -> int {
    let n = len(s)
    let mut p = p0 + 1
    let mut go = 1
    while go == 1 && p < n {
        if s[p] == 34 {
            go = 0
        } else {
            p = p + 1
        }
    }
    return p + 1
}

fn jnum(s: str, p0: int, st: vec[int]) -> int {
    let n = len(s)
    let mut p = p0
    let mut v = 0
    let mut neg = 0
    if p < n && s[p] == 45 {
        neg = 1
        p = p + 1
    }
    let mut go = 1
    while go == 1 && p < n {
        let c = s[p]
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            p = p + 1
        } else {
            go = 0
        }
    }
    if neg == 1 {
        v = 0 - v
    }
    st.set(0, p)
    return v
}

fn jval(s: str, p0: int, st: vec[int]) -> int {
    let n = len(s)
    let p = jws(s, p0)
    if p >= n {
        st.set(0, p)
        return 0
    }
    let c = s[p]
    if c == 123 {
        let mut q = jws(s, p + 1)
        let mut acc = 0
        if q < n && s[q] == 125 {
            st.set(0, q + 1)
            return 0
        }
        let mut go = 1
        while go == 1 {
            q = jws(s, q)
            q = jstr(s, q)
            q = jws(s, q)
            q = q + 1
            acc = acc + jval(s, q, st)
            q = jws(s, st.get(0))
            if q < n && s[q] == 44 {
                q = q + 1
            } else {
                go = 0
            }
        }
        st.set(0, q + 1)
        return acc
    }
    if c == 91 {
        let mut q = jws(s, p + 1)
        let mut acc = 0
        if q < n && s[q] == 93 {
            st.set(0, q + 1)
            return 0
        }
        let mut go = 1
        while go == 1 {
            acc = acc + jval(s, q, st)
            q = jws(s, st.get(0))
            if q < n && s[q] == 44 {
                q = q + 1
            } else {
                go = 0
            }
        }
        st.set(0, q + 1)
        return acc
    }
    if c == 34 {
        st.set(0, jstr(s, p))
        return 0
    }
    if c == 45 || (c >= 48 && c <= 57) {
        return jnum(s, p, st)
    }
    let mut q = p
    let mut go = 1
    while go == 1 && q < n {
        let d = s[q]
        if d >= 97 && d <= 122 {
            q = q + 1
        } else {
            go = 0
        }
    }
    st.set(0, q)
    return 0
}

fn main() {
    let doc = "{\"meta\":{\"version\":3,\"count\":30,\"flags\":[1,0,1]},\"items\":[{\"id\":1,\"name\":\"user_1\",\"score\":37,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n1\"},{\"id\":2,\"name\":\"user_2\",\"score\":74,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n2\"},{\"id\":3,\"name\":\"user_3\",\"score\":11,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n3\"},{\"id\":4,\"name\":\"user_4\",\"score\":48,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n4\"},{\"id\":5,\"name\":\"user_5\",\"score\":85,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":null},{\"id\":6,\"name\":\"user_6\",\"score\":22,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n6\"},{\"id\":7,\"name\":\"user_7\",\"score\":59,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n7\"},{\"id\":8,\"name\":\"user_8\",\"score\":96,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n8\"},{\"id\":9,\"name\":\"user_9\",\"score\":33,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n9\"},{\"id\":10,\"name\":\"user_10\",\"score\":70,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":null},{\"id\":11,\"name\":\"user_11\",\"score\":7,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n11\"},{\"id\":12,\"name\":\"user_12\",\"score\":44,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n12\"},{\"id\":13,\"name\":\"user_13\",\"score\":81,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n13\"},{\"id\":14,\"name\":\"user_14\",\"score\":18,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n14\"},{\"id\":15,\"name\":\"user_15\",\"score\":55,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":null},{\"id\":16,\"name\":\"user_16\",\"score\":92,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n16\"},{\"id\":17,\"name\":\"user_17\",\"score\":29,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n17\"},{\"id\":18,\"name\":\"user_18\",\"score\":66,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n18\"},{\"id\":19,\"name\":\"user_19\",\"score\":3,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n19\"},{\"id\":20,\"name\":\"user_20\",\"score\":40,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":null},{\"id\":21,\"name\":\"user_21\",\"score\":77,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n21\"},{\"id\":22,\"name\":\"user_22\",\"score\":14,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n22\"},{\"id\":23,\"name\":\"user_23\",\"score\":51,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n23\"},{\"id\":24,\"name\":\"user_24\",\"score\":88,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n24\"},{\"id\":25,\"name\":\"user_25\",\"score\":25,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":null},{\"id\":26,\"name\":\"user_26\",\"score\":62,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n26\"},{\"id\":27,\"name\":\"user_27\",\"score\":99,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n27\"},{\"id\":28,\"name\":\"user_28\",\"score\":36,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":\"n28\"},{\"id\":29,\"name\":\"user_29\",\"score\":73,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":true,\"note\":\"n29\"},{\"id\":30,\"name\":\"user_30\",\"score\":10,\"tags\":[\"a\",\"bb\",\"ccc\"],\"ok\":false,\"note\":null}]}"
    let st = vec[int].new(2)
    st.push(0)
    st.push(0)
    let t0 = now_ns()
    let mut total = 0
    let mut r = 0
    while r < 2000 {
        st.set(0, 0)
        total = total + jval(doc, 0, st)
        r = r + 1
    }
    let t1 = now_ns()
    print(total)
    print("T")
    print(t1 - t0)
}
