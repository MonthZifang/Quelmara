// b57_pow_mod —— 数论：快速幂取模 100 万次
fn pow_mod(base: int, exp: int, mod: int) -> int {
    let mut result = 1
    let mut b = base % mod
    let mut e = exp
    while e > 0 {
        if e % 2 == 1 { result = (result * b) % mod }
        b = (b * b) % mod
        e = e / 2
    }
    return result
}
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 1
    while i <= 1000000 {
        acc = (acc + pow_mod(i, i, 1000003)) % 1000003
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
