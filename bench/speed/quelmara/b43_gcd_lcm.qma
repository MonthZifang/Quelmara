// b43_gcd_lcm —— 数论：GCD/LCM 100 万次
fn gcd(a: int, b: int) -> int {
    let mut x = a
    let mut y = b
    while y != 0 { let t = y  y = x % y  x = t }
    return x
}
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 1
    while i <= 1000000 {
        acc = acc + gcd(i, 1000000 - i + 1)
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
