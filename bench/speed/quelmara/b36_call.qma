// b36_call —— 微基准：函数调用 1000 万次
fn add3(a: int, b: int, c: int) -> int { return a + b + c }
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 0
    while i < 10000000 {
        acc = add3(acc, i, 1)
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
