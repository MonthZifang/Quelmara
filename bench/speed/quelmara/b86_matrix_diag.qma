// b86_matrix_diag —— 数值：矩阵对角线求和 1000x1000
fn main() {
    let n = 1000
    let sz = n * n
    let a = vec[int].new(sz)
    let mut i = 0
    while i < sz { a.push((i * 7 + 3) % 100)  i = i + 1 }
    let t0 = now_ns()
    let mut sum = 0
    let mut r = 0
    while r < n {
        sum = sum + a.get(r * n + r)
        r = r + 1
    }
    let t1 = now_ns()
    print(sum)
    print("T")
    print(t1 - t0)
}
