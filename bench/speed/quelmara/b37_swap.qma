// b37_swap —— 算法：100 万次交换排序
fn main() {
    let n = 10000
    let a = vec[int].new(n)
    let mut seed = 42
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed % 100000)
        i = i + 1
    }
    let t0 = now_ns()
    let mut round = 0
    while round < 100 {
        let mut j = 0
        while j < n - 1 {
            if a.get(j) > a.get(j + 1) {
                let tmp = a.get(j)
                a.set(j, a.get(j + 1))
                a.set(j + 1, tmp)
            }
            j = j + 1
        }
        round = round + 1
    }
    let t1 = now_ns()
    print(a.get(0))
    print("T")
    print(t1 - t0)
}
