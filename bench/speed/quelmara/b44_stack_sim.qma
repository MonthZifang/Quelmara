// b44_stack_sim —— 数据结构：栈模拟 100 万次
fn main() {
    let st = vec[int].new(1000)
    let t0 = now_ns()
    let mut i = 0
    while i < 1000000 {
        st.push(i)
        if i % 3 == 0 && len(st) > 0 { let x = st.get(len(st) - 1)  st.set(len(st) - 1, x + 1) }
        i = i + 1
    }
    let t1 = now_ns()
    print(st.get(len(st) - 1))
    print("T")
    print(t1 - t0)
}
