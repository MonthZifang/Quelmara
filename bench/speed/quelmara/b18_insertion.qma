// b18_insertion —— 排序：插入排序 8 万元素
fn main() {
    let n = 80000
    let a = vec[int].new(n)
    let mut seed = 12345
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed % 100000)
        i = i + 1
    }
    let t0 = now_ns()
    let mut x = 1
    while x < n {
        let key = a.get(x)
        let mut y = x - 1
        let mut go = 1
        while go == 1 && y >= 0 {
            if a.get(y) > key {
                a.set(y + 1, a.get(y))
                y = y - 1
            } else {
                go = 0
            }
        }
        a.set(y + 1, key)
        x = x + 1
    }
    let t1 = now_ns()
    let mut chk = 0
    i = 0
    while i < n { chk = (chk + a.get(i) * (i + 1)) % 1000000007  i = i + 1 }
    print(chk)
    print("T")
    print(t1 - t0)
}
