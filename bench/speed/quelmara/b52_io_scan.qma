// b52_io_scan —— IO：顺序扫描 100 万个整数
fn main() {
    let n = 1000000
    let buf = vec[int].new(n)
    let mut i = 0
    while i < n { buf.push(i * 3 + 1)  i = i + 1 }
    let t0 = now_ns()
    let mut sum = 0
    let mut j = 0
    while j < n {
        sum = sum + buf.get(j)
        j = j + 1
    }
    let t1 = now_ns()
    print(sum)
    print("T")
    print(t1 - t0)
}
