// b67_bubble_opt —— 排序：冒泡排序 5000
fn main() {
    let n = 5000
    let a = vec[int].new(n)
    let mut seed = 99
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed % 100000)
        i = i + 1
    }
    let t0 = now_ns()
    let mut swapped = true
    while swapped {
        swapped = false
        let mut j = 0
        while j < n - 1 {
            if a.get(j) > a.get(j + 1) {
                let tmp = a.get(j)
                a.set(j, a.get(j + 1))
                a.set(j + 1, tmp)
                swapped = true
            }
            j = j + 1
        }
    }
    let t1 = now_ns()
    print(a.get(0))
    print("T")
    print(t1 - t0)
}
