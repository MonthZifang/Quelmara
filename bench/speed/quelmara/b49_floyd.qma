// b49_floyd —— 图算法：Floyd-Warshall 100 节点
fn main() {
    let n = 100
    let sz = n * n
    let dist = vec[int].new(sz)
    let mut i = 0
    while i < sz { dist.push(999999)  i = i + 1 }
    let mut k = 0
    while k < n { dist.set(k * n + k, 0)  k = k + 1 }
    let mut seed = 7
    let mut e = 0
    while e < 300 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let u = seed % n
        seed = (seed * 1103515245 + 12345) % 2147483648
        let v = seed % n
        seed = (seed * 1103515245 + 12345) % 2147483648
        let w = seed % 100 + 1
        dist.set(u * n + v, w)
        e = e + 1
    }
    let t0 = now_ns()
    let mut a = 0
    while a < n {
        let mut b = 0
        while b < n {
            let mut c = 0
            while c < n {
                let d1 = dist.get(b * n + c)
                let d2 = dist.get(b * n + a) + dist.get(a * n + c)
                if d2 < d1 { dist.set(b * n + c, d2) }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    let t1 = now_ns()
    print(dist.get(1))
    print("T")
    print(t1 - t0)
}
