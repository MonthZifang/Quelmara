// b22_knapsack —— 0/1 背包 DP（800 件 × 800 容量）
fn main() {
    let n = 800
    let cap = 800
    let wt = vec[int].new(n)
    let vl = vec[int].new(n)
    let mut seed = 999
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        wt.push(seed % 50 + 1)
        seed = (seed * 1103515245 + 12345) % 2147483648
        vl.push(seed % 100 + 1)
        i = i + 1
    }
    let t0 = now_ns()
    let dp = vec[int].new(cap + 1)
    i = 0
    while i <= cap { dp.push(0)  i = i + 1 }
    let mut it = 0
    while it < n {
        let mut c = cap
        while c >= wt.get(it) {
            let cand = dp.get(c - wt.get(it)) + vl.get(it)
            if cand > dp.get(c) { dp.set(c, cand) }
            c = c - 1
        }
        it = it + 1
    }
    let t1 = now_ns()
    print(dp.get(cap))
    print("T")
    print(t1 - t0)
}
