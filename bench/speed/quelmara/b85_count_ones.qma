// b85_count_ones —— 微基准：popcount 500 万
fn popcount(x: int) -> int {
    let mut n = x
    let mut c = 0
    while n != 0 {
        c = c + (n & 1)
        n = n >> 1
    }
    return c
}
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 0
    while i < 5000000 {
        acc = acc + popcount(i)
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
