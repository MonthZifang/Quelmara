// b76_io_line —— IO：逐行扫描 100 万行
fn main() {
    let n = 1000000
    let lines = vec[int].new(n)
    let mut i = 0
    while i < n { lines.push(i * 7 + 3)  i = i + 1 }
    let t0 = now_ns()
    let mut sum = 0
    let mut j = 0
    while j < n {
        let line = lines.get(j)
        sum = sum + line % 100
        j = j + 1
    }
    let t1 = now_ns()
    print(sum)
    print("T")
    print(t1 - t0)
}
