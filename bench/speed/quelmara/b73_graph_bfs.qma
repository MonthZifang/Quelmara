// b73_graph_bfs —— 图算法：BFS 1000 节点
fn main() {
    let n = 1000
    let adj = vec[int].new(n * n)
    let mut i = 0
    while i < n * n { adj.push(0)  i = i + 1 }
    let mut seed = 55
    let mut e = 0
    while e < 5000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let u = seed % n
        seed = (seed * 1103515245 + 12345) % 2147483648
        let v = seed % n
        adj.set(u * n + v, 1)
        e = e + 1
    }
    let t0 = now_ns()
    let visited = vec[int].new(n)
    let mut j = 0
    while j < n { visited.push(0)  j = j + 1 }
    let queue = vec[int].new(0)
    queue.push(0)
    visited.set(0, 1)
    let mut cnt = 0
    while len(queue) > 0 {
        let u = queue.get(0)
        let mut newq = vec[int].new(0)
        let mut k = 1
        while k < len(queue) { newq.push(queue.get(k))  k = k + 1 }
        queue = newq
        cnt = cnt + 1
        let mut v = 0
        while v < n {
            if adj.get(u * n + v) == 1 && visited.get(v) == 0 {
                visited.set(v, 1)
                queue.push(v)
            }
            v = v + 1
        }
    }
    let t1 = now_ns()
    print(cnt)
    print("T")
    print(t1 - t0)
}
