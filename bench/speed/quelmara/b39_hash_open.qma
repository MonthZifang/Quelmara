// b39_hash_open —— 哈希表：开放寻址 50 万插入+查找
fn main() {
    let cap = 1048576
    let keys = vec[int].new(cap)
    let vals = vec[int].new(cap)
    let mut i = 0
    while i < cap { keys.push(0)  vals.push(0)  i = i + 1 }
    let t0 = now_ns()
    let mut j = 0
    while j < 500000 {
        let h = (j * 2654435761) % cap
        keys.set(h, j)
        vals.set(h, j * 2)
        j = j + 1
    }
    let mut found = 0
    let mut k = 0
    while k < 500000 {
        let h = (k * 2654435761) % cap
        if keys.get(h) == k { found = found + 1 }
        k = k + 1
    }
    let t1 = now_ns()
    print(found)
    print("T")
    print(t1 - t0)
}
