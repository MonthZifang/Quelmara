// b23_lcs —— DP：最长公共子序列 1500×1500
fn main() {
    let n = 1500
    let t0 = now_ns()
    let prev = vec[int].new(n + 1)
    let cur = vec[int].new(n + 1)
    let mut i = 0
    while i <= n { prev.push(0)  cur.push(0)  i = i + 1 }
    let mut r = 1
    while r <= n {
        let mut c = 1
        while c <= n {
            let av = (r * 7 + 3) % 4
            let bv = (c * 11 + 5) % 4
            if av == bv {
                cur.set(c, prev.get(c - 1) + 1)
            } else {
                let x = prev.get(c)
                let y = cur.get(c - 1)
                if x > y { cur.set(c, x) } else { cur.set(c, y) }
            }
            c = c + 1
        }
        c = 0
        while c <= n { prev.set(c, cur.get(c))  c = c + 1 }
        r = r + 1
    }
    let t1 = now_ns()
    print(prev.get(n))
    print("T")
    print(t1 - t0)
}
