// b54_merge_sort —— 排序：归并排序 10 万
// v4.115 公平性修正：tmp 与 C/Go/Rust/Zig 版一致，在 main 预分配一次并传入，
// 而不是每次 merge 都 vec.new(0) + push 扩容（那是额外的分配工作量，不是同一道题）。
fn merge(a: vec[int], tmp: vec[int], lo: int, mid: int, hi: int) {
    let mut i = lo
    let mut j = mid
    let mut k = 0
    while i < mid && j < hi {
        if a.get(i) <= a.get(j) { tmp.set(k, a.get(i))  i = i + 1 } else { tmp.set(k, a.get(j))  j = j + 1 }
        k = k + 1
    }
    while i < mid { tmp.set(k, a.get(i))  i = i + 1  k = k + 1 }
    while j < hi { tmp.set(k, a.get(j))  j = j + 1  k = k + 1 }
    let mut x = 0
    while x < k { a.set(lo + x, tmp.get(x))  x = x + 1 }
}
fn msort(a: vec[int], tmp: vec[int], lo: int, hi: int) {
    if hi - lo <= 1 { return }
    let mid = (lo + hi) / 2
    msort(a, tmp, lo, mid)
    msort(a, tmp, mid, hi)
    merge(a, tmp, lo, mid, hi)
}
fn main() {
    let n = 100000
    let a = vec[int].new(n)
    let tmp = vec[int].new(n)
    let mut seed = 12345
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed % 1000000)
        i = i + 1
    }
    i = 0
    while i < n { tmp.push(0)  i = i + 1 }
    let t0 = now_ns()
    msort(a, tmp, 0, n)
    let t1 = now_ns()
    print(a.get(0))
    print("T")
    print(t1 - t0)
}
