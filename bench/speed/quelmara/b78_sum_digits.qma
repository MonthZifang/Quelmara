// b78_sum_digits —— 数值：数位求和 100 万
fn digit_sum(n: int) -> int {
    let mut x = n
    let mut s = 0
    while x > 0 { s = s + x % 10  x = x / 10 }
    return s
}
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 0
    while i < 1000000 {
        acc = acc + digit_sum(i)
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
