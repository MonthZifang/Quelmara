// b83_lcg_random —— 微基准：LCG 随机数 1000 万
fn main() {
    let t0 = now_ns()
    let mut seed = 12345
    let mut acc = 0
    let mut i = 0
    while i < 10000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        acc = acc + seed % 100
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
