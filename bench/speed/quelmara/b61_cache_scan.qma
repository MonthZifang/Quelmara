// b61_cache_scan —— 微基准：缓存扫描 1000 万次
fn main() {
    let n = 1000000
    let a = vec[int].new(n)
    let mut i = 0
    while i < n { a.push(i)  i = i + 1 }
    let t0 = now_ns()
    let mut acc = 0
    let mut j = 0
    while j < 10 {
        let mut k = 0
        while k < n {
            acc = acc + a.get(k)
            k = k + 1
        }
        j = j + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
