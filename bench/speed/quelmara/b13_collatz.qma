// b13_collatz —— Collatz 序列长度累加(1..30万)
fn clen(n0: int) -> int {
    let mut n = n0
    let mut c = 0
    while n != 1 {
        if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
        c = c + 1
    }
    return c
}
fn main() {
    let t0 = now_ns()
    let mut best = 0
    let mut bn = 0
    let mut i = 1
    while i <= 300000 {
        let c = clen(i)
        if c > best { best = c  bn = i }
        i = i + 1
    }
    let t1 = now_ns()
    print(best * 10000000 + bn)
    print("T")
    print(t1 - t0)
}
