// b55_hash_chain —— 哈希表：链地址法 20 万插入
fn main() {
    let cap = 262144
    let buckets = vec[int].new(cap)
    let mut i = 0
    while i < cap { buckets.push(0)  i = i + 1 }
    let t0 = now_ns()
    let mut cnt = 0
    let mut j = 0
    while j < 200000 {
        let h = (j * 2654435761) % cap
        buckets.set(h, buckets.get(h) + 1)
        cnt = cnt + 1
        j = j + 1
    }
    let t1 = now_ns()
    print(cnt)
    print("T")
    print(t1 - t0)
}
