// b26_maxsub —— 经典一维 DP：Kadane 最大子数组 2000 万
fn main() {
    let n = 20000000
    let t0 = now_ns()
    let mut best = 0
    let mut cur = 0
    let mut seed = 42
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let v = seed % 201 - 100
        cur = cur + v
        if cur < 0 { cur = 0 }
        if cur > best { best = cur }
        i = i + 1
    }
    let t1 = now_ns()
    print(best)
    print("T")
    print(t1 - t0)
}
