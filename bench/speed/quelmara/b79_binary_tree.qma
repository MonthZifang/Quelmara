// b79_binary_tree —— 数据结构：BST 插入 5 万
fn main() {
    let t0 = now_ns()
    let keys = vec[int].new(50000)
    let mut seed = 42
    let mut i = 0
    while i < 50000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let key = seed % 100000
        let mut pos = len(keys)
        let mut j = 0
        while j < len(keys) {
            if keys.get(j) > key { pos = j  j = len(keys) }
            j = j + 1
        }
        keys.push(0)
        let mut k = len(keys) - 1
        while k > pos {
            keys.set(k, keys.get(k - 1))
            k = k - 1
        }
        keys.set(pos, key)
        i = i + 1
    }
    let t1 = now_ns()
    print(keys.get(0))
    print("T")
    print(t1 - t0)
}
