// b12_gcd —— GCD 密集：3000 万次辗转相除
fn gcd(a0: int, b0: int) -> int {
    let mut a = a0
    let mut b = b0
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}
fn main() {
    let n = 30000000
    let t0 = now_ns()
    let mut s = 0
    let mut i = 1
    while i <= n {
        s = s + gcd(i, 1000000 - i)
        i = i + 1
    }
    let t1 = now_ns()
    print(s)
    print("T")
    print(t1 - t0)
}
