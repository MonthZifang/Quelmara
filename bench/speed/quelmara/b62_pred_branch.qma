// b62_pred_branch —— 微基准：不可预测分支 500 万次
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 0
    while i < 5000000 {
        if (i * 7 + 3) % 5 < 2 { acc = acc + 1 } else { acc = acc - 1 }
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
