// b46_strcat —— 字符串：10 万次字符串拼接
fn main() {
    let t0 = now_ns()
    let mut acc = 0
    let mut i = 0
    while i < 100000 {
        let s = "hello" + " " + "world" + " " + "12345"
        acc = acc + len(s)
        i = i + 1
    }
    let t1 = now_ns()
    print(acc)
    print("T")
    print(t1 - t0)
}
