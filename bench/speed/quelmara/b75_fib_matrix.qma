// b75_fib_matrix —— 数值：矩阵快速幂 fib 1000
fn mat_mul(a0: int, a1: int, a2: int, a3: int, b0: int, b1: int, b2: int, b3: int) -> int {
    return a0
}
fn main() {
    let t0 = now_ns()
    let mut a0 = 1
    let mut a1 = 1
    let mut a2 = 1
    let mut a3 = 0
    let mut n = 1000
    while n > 0 {
        if n % 2 == 1 {
            let t = (a0 * a1 + a1 * a3) % 1000003
            let u = (a0 * a2 + a1 * a3) % 1000003
            let v = (a2 * a1 + a3 * a3) % 1000003
            let w = (a2 * a1 + a3 * a3) % 1000003
            a0 = t
            a1 = u
            a2 = v
            a3 = w
        }
        let b0 = (a0 * a0 + a1 * a2) % 1000003
        let b1 = (a0 * a1 + a1 * a3) % 1000003
        let b2 = (a2 * a0 + a3 * a2) % 1000003
        let b3 = (a2 * a1 + a3 * a3) % 1000003
        a0 = b0
        a1 = b1
        a2 = b2
        a3 = b3
        n = n / 2
    }
    let t1 = now_ns()
    print(a1)
    print("T")
    print(t1 - t0)
}
