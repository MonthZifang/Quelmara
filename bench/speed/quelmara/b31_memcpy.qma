// b31_memcpy —— IO：大块内存拷贝 100MB
// v4.84：从逐元素 vec push/get 循环改为 bulk mem_copy（与 b87 同路径，0.92x vs C），
// 校验和不变（dst 末元素 == n-1）。
fn main() {
    let n = 12500000
    let src = mem_alloc(n * 8)
    let dst = mem_alloc(n * 8)
    let mut i = 0
    while i < n {
        mem_store64(src, i, i)
        i = i + 1
    }
    let t0 = now_ns()
    mem_copy(dst, src, n * 8)
    let t1 = now_ns()
    print(mem_load64(dst, n - 1))
    print("T")
    print(t1 - t0)
}
