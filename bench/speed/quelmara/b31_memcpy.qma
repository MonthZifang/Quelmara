// b31_memcpy —— IO：大块内存拷贝 100MB
fn main() {
    let n = 12500000
    let src = vec[int].new(n)
    let mut i = 0
    while i < n { src.push(i)  i = i + 1 }
    let dst = vec[int].new(n)
    let t0 = now_ns()
    let mut j = 0
    while j < n { dst.push(src.get(j))  j = j + 1 }
    let t1 = now_ns()
    print(dst.get(n - 1))
    print("T")
    print(t1 - t0)
}
