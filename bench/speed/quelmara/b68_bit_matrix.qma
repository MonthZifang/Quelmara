// b68_bit_matrix —— 数值：位矩阵旋转 256x256
fn main() {
    let n = 256
    let sz = n * n
    let a = vec[int].new(sz)
    let mut i = 0
    while i < sz { a.push(i % 2)  i = i + 1 }
    let b = vec[int].new(sz)
    let t0 = now_ns()
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n {
            b.push(a.get(c * n + (n - 1 - r)))
            c = c + 1
        }
        r = r + 1
    }
    let t1 = now_ns()
    print(b.get(0))
    print("T")
    print(t1 - t0)
}
