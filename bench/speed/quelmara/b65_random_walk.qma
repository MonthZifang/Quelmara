// b65_random_walk —— 模拟：随机游走 200 万步
fn main() {
    let t0 = now_ns()
    let mut x = 0
    let mut y = 0
    let mut seed = 12345
    let mut i = 0
    while i < 2000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let d = seed % 4
        if d == 0 { x = x + 1 }
        if d == 1 { x = x - 1 }
        if d == 2 { y = y + 1 }
        if d == 3 { y = y - 1 }
        i = i + 1
    }
    let t1 = now_ns()
    print(x * 1000000 + y)
    print("T")
    print(t1 - t0)
}
