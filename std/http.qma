// std/http.qma —— HTTP/1.1 服务端库（Quelmara 自实现，零 Python/Node）
//
// 架构：std/net/core.qma 的槽位层 + net_serve 的 IOCP reactor。
// 每个连接一个定长槽位（默认 640 B），请求数据累积在槽位内联缓冲，
// 解析是单遍字节扫描（mem_load8 内联，无 strlen、无 str 拼接热路径）。
// 响应一次性组包，单个 conn_send 发出。
//
// ## 两种用法
//
// 1) 单回调（v1.6 起）：handler 自己比路径
//
//   import std.http
//
//   fn route(fd: int) -> int {
//       let p = http_path(fd)
//       if p == "/" {
//           http_text(fd, 200, "hello")
//           return 1                       // 1 = 按 keep-alive 语义继续
//       }
//       http_not_found(fd)
//       return 1
//   }
//
//   fn main() {
//       http_serve(8080, 512, route)       // 阻塞运行
//   }
//
// 2) 路由表 + 中间件（v2.04）：把 http_dispatch 当 handler 传进去
//
//   fn main() {
//       http_use(log_mw)                   // 注册顺序 = 执行顺序
//       http_use(auth_mw)
//       http_route("GET", "/users/:id", user_get)
//       http_route("GET", "/files/*", files)
//       http_serve(8080, 512, http_dispatch)
//   }
//
//   handler 里用 http_param(fd, 0) 取 `:id`、http_query(fd) 取 query 串。
//
// 支持：keep-alive、流水线（一个缓冲里多个请求依次派发）、
// Content-Length 请求体、**Transfer-Encoding: chunked 请求体（v2.95）**、
// Connection: close、头部增量解析。
// 明确 fail-fast：chunked **流病态** -> 400 并关闭；TE 非 chunked（gzip 等）
// -> 501；头部超限 -> 431；请求行非法 -> 400 并关闭。WebSocket 升级请用 std.ws。
//
// chunked 口径（v2.95）：解码由 std/http_chunk 的纯函数完成（就地压缩，
// 写游标恒落后读游标 ≥6 字节所以安全）。TE 与 Content-Length 同时出现时
// **以 TE 为准、CL 忽略**（RFC 7230 §3.3.3）；chunk-ext 与 trailer 丢弃。
// handler 侧零感知：http_body / http_body_len 读到的就是解包后的体。
//
// 槽位协议私有字（core.qma 的 w6..w15，SLOT_PROTO 起）：
//   w6  状态（低 8 位：0=等头 1=等体；bit8=连接要关；bit9=HTTP/1.0；
//            bit10=chunked 未解包（v2.95））
//   w7/w8   方法偏移/长度       w9/w10 路径偏移/长度
//   w11/w12 头块偏移/长度       w13/w14 体偏移/长度（=Content-Length）
//   w15 头部扫描位置（\r\n\r\n 增量搜索）
//
// 进程级静态字：static_word(0) = 连接状态块，static_word(1) = 解析失败码，
// static_word(2) = 路由/中间件表（见文件末「路由 + 中间件」一节）。

import std.mem
import std.net.core
import std.net.reactor
import std.router
import std.str
import std.gzip
import std.http_chunk

const HP_STATE = 6
const HP_MOFF = 7
const HP_MLEN = 8
const HP_POFF = 9
const HP_PLEN = 10
const HP_HOFF = 11
const HP_HLEN = 12
const HP_BOFF = 13
const HP_BLEN = 14
const HP_SCAN = 15

const HP_ST_HDR = 0
const HP_ST_BODY = 1
const HP_F_CLOSE = 256
const HP_F_HTTP10 = 512
// v2.95：chunked 请求体。协议私有字 w6..w15 已被 HP_* 十个字段占满，这个
// 标志挤进 HP_STATE 高位（state 恒在低字节，flags 在高位——现有代码正是
// `st2 - (st2 & 255) + HP_ST_BODY` 这么切分的）。置位 = 头里声明了
// Transfer-Encoding: chunked 且**尚未解包**；解包成功立刻清位，keep-alive
// 的下一请求不会把已压实的字节再 pack 一遍。
const HP_F_TE = 1024

const HTTP_VER_PREFIX = "HTTP/1."
const HTTP_HDR_CL = "content-length"
const HTTP_HDR_TE = "transfer-encoding"
const HTTP_TE_CHUNKED = "chunked"
const HTTP_HDR_CONN = "connection"

const HTTP_MAX_HDR = 16384        // 请求头（含请求行）上限
const HTTP_DEFAULT_CONNS = 100000 // 十万连接档（可由 http_serve_max 覆盖）

// ---------------------------------------------------------------------------
// 服务入口
// ---------------------------------------------------------------------------

/// 阻塞运行 HTTP 服务：`backlog` 是监听队列长度，`on_request` 是
/// `fn(fd: int) -> int` 的裸函数名（返回 0 = 响应后关连接，1 = 按 keep-alive 继续）。
/// 十万连接档的槽位在启动时一次预分配（640 B/连接）。
pub fn http_serve(port: int, backlog: int, on_request: int) -> int {
    return http_serve_max(port, backlog, on_request, HTTP_DEFAULT_CONNS)
}

/// 可调连接上限版：槽位层按 `max_conns` 预分配定长槽位
/// （640 B/连接 × max_conns，十万连接 = 64 MB 常驻，无 GC、无停顿）。
/// 超过上限的新连接被直接拒绝（fail-fast，不静默膨胀）。
pub fn http_serve_max(port: int, backlog: int, on_request: int,
                      max_conns: int) -> int {
    let st = conn_state_new(max_conns, 80)
    conn_set_h0(st, on_request)                 // 用户 handler
    mem_store64(static_word(0), 0, st)          // 回调通道：进程级状态指针
    return net_serve(port, backlog, http_on_connect, http_on_data,
                     http_on_close)
}

/// 累计 accept 的连接数
pub fn http_accepted() -> int {
    return conn_accepted(_st())
}

/// 累计关闭的连接数
pub fn http_closed() -> int {
    return conn_closed(_st())
}

/// 累计派发给 handler 的请求数
pub fn http_reqs() -> int {
    return conn_msgs(_st())
}

/// 累计收到的字节数
pub fn http_bytes_in() -> int {
    return conn_bytes_in(_st())
}

/// 累计发出的字节数
pub fn http_bytes_out() -> int {
    return conn_bytes_out(_st())
}

fn _st() -> int {
    return mem_load64(static_word(0), 0)
}

// ---------------------------------------------------------------------------
// reactor 回调（net_serve 派发；on_connect 在 acceptor 线程，
// on_data/on_close 在 io 线程，槽位层自旋锁保护共享结构）
// ---------------------------------------------------------------------------

fn http_on_connect(fd: int) -> int {
    let r = conn_open(_st(), fd)
    if r < 0 {
        return 0                                // 超上限：fail-fast，拒绝连接
    }
    return 1
}

fn http_on_close(fd: int) -> int {
    conn_close(_st(), fd)
    return 0
}

fn http_on_data(fd: int, data: str) -> int {
    let st = _st()
    let p = conn_slot(st, fd)
    if p == 0 {
        return 0
    }
    if len(data) > 0 {
        let r = conn_append(st, p, data)
        if r < 0 {
            // 单连接缓冲超 1MB 上限：响应 431 后关闭，绝不静默截断
            http_respond_raw(fd, 431, "", "headers too large\n")
            return 0
        }
    }
    // 解析-派发循环：一次 on_data 可能带 0 个、1 个或多个完整请求（流水线）
    while true {
        let buf = conn_buf_ptr(p)
        let n = conn_recvlen(p)
        let state = mem_load64(p, HP_STATE) & 255
        if state == HP_ST_HDR {
            // 增量搜索 \r\n\r\n（扫描位置跨 on_data 持久，整请求只扫一遍）
            let scan = mem_load64(p, HP_SCAN)
            let k = _find_head_end(buf, scan, n)
            if k < 0 {
                if n > HTTP_MAX_HDR {
                    http_respond_raw(fd, 431, "", "headers too large\n")
                    return 0
                }
                let keep = n - 3
                if keep < 0 {
                    mem_store64(p, HP_SCAN, 0)
                } else {
                    mem_store64(p, HP_SCAN, keep)
                }
                return 1                        // 头未收全，等下一段
            }
            if _parse_head(p, buf, k) < 0 {
                http_respond_raw_parse_fail(fd)
                return 0                        // _parse_head 里已标记失败原因
            }
            // 状态切到等体（保留 flags 位）
            let st2 = mem_load64(p, HP_STATE)
            mem_store64(p, HP_STATE, st2 - (st2 & 255) + HP_ST_BODY)
        }
        // 等请求体收全。Content-Length 是定长；chunked（HP_F_TE）走
        // 「扫描 → 就地解包 → 清位」，v2.95。
        // `need` 是**本请求在当前缓冲里占到的原始字节数**（keep-alive 按它
        // 截断余包）；chunked 路径下它是流的原始长度（含 hex 行与 CRLF），
        // 不是解包后的体长——解包后的体长写进 HP_BLEN 给 handler。
        let state3 = mem_load64(p, HP_STATE)
        let mut need = mem_load64(p, HP_BOFF) + mem_load64(p, HP_BLEN)
        if (state3 & HP_F_TE) != 0 {
            let boff = mem_load64(p, HP_BOFF)
            let endv = chunk_scan(buf, boff, n)
            if endv == -1 {
                return 1                        // 流未收全，等下一段
            }
            if endv == -2 {
                // 病态流：400 + 关闭（绝不"尽力解出前半段"交给 handler）
                http_respond_raw(fd, 400, "", "bad chunked body\n")
                return 0
            }
            let blen = chunk_pack(buf, boff, endv)
            mem_store64(p, HP_BLEN, blen)               // handler 看到解包后的长度
            mem_store64(p, HP_STATE, state3 - HP_F_TE)  // 清位：已压实，不许二次 pack
            need = endv                                 // 搬余包按原始流长度截断
        }
        if n < need {
            return 1
        }
        // 派发：callr 间接调用用户 handler
        conn_msg_inc(st)
        let h = conn_h0(st)
        let code = h(fd)                        // 注意：rc 是关键字（rc[T]），别用作变量名
        let flags = mem_load64(p, HP_STATE)
        if code == 0 || (flags & HP_F_CLOSE) != 0 {
            return 0                            // handler 要求关 / Connection: close
        }
        // keep-alive：把剩余半包搬到缓冲头，继续解析下一个请求
        let rest = conn_shift(p, need)
        mem_store64(p, HP_STATE, HP_ST_HDR)
        mem_store64(p, HP_SCAN, 0)
        if rest == 0 {
            return 1
        }
    }
}

// 解析失败时按 _parse_head 留下的标记发错误响应。
// 失败码放静态字 1（仅解析失败瞬间使用，多线程下每连接各自瞬间写读）。
const HTTP_ERR_W = 1

fn http_respond_raw_parse_fail(fd: int) -> int {
    let code = mem_load64(static_word(HTTP_ERR_W), 0)
    let mut body = "bad request\n"
    if code == 501 {
        // v2.95：chunked 已支持，501 只剩 "TE 是其它编码"（gzip 等）
        body = "unsupported transfer encoding\n"
    }
    if code == 431 {
        body = "headers too large\n"
    }
    let head = "HTTP/1.1 " + (code).to_str() + " " + http_reason(code)
               + "\r\nContent-Type: text/plain; charset=utf-8"
               + "\r\nContent-Length: " + len(body).to_str()
               + "\r\nConnection: close\r\n\r\n"
    conn_send_str(_st(), fd, head + body)
    return 0
}

// 找头块结束标记 \r\n\r\n：[from, n-4] 内扫描，返回标记首字节下标，无则 -1。
// 摊还 O(请求数据量)：from 持久化在 HP_SCAN，跨段不重扫。
fn _find_head_end(buf: int, from: int, n: int) -> int {
    if n < 4 {
        return -1
    }
    let mut i = from
    let lim = n - 4
    while i <= lim {
        if mem_load8(buf, i) == 13 && mem_load8(buf, i + 1) == 10
                && mem_load8(buf, i + 2) == 13 && mem_load8(buf, i + 3) == 10 {
            return i
        }
        i += 1
    }
    return -1
}

// 解析请求行 + 单遍扫描头块。成功填好槽位协议字并返回 0；
// 失败把错误码写进 HTTP_ERR_W 并返回 -1（调用方发响应后关闭连接）。
fn _parse_head(p: int, buf: int, k: int) -> int {
    // 请求行：METHOD SP PATH SP HTTP/1.x
    let mut rl_end = 0
    while rl_end < k && mem_load8(buf, rl_end) != 13 {
        rl_end += 1
    }
    if rl_end + 1 >= k || mem_load8(buf, rl_end + 1) != 10 {
        return _fail(400)
    }
    let mut sp1 = 0
    while sp1 < rl_end && mem_load8(buf, sp1) != 32 {
        sp1 += 1
    }
    let mut sp2 = sp1 + 1
    while sp2 < rl_end && mem_load8(buf, sp2) != 32 {
        sp2 += 1
    }
    // 版本必须是 "HTTP/1.0" 或 "HTTP/1.1"（8 字节）
    let mut ok = sp1 >= 1 && sp2 > sp1 + 1 && rl_end - sp2 - 1 == 8
    let mut vver = 48
    if ok {
        let mut vi = 0
        while vi < 7 && ok {
            if mem_load8(buf, sp2 + 1 + vi) != HTTP_VER_PREFIX[vi] {
                ok = false
            }
            vi += 1
        }
        if ok {
            vver = mem_load8(buf, sp2 + 8)
            if vver != 48 && vver != 49 {
                ok = false
            }
        }
    }
    if !ok {
        return _fail(400)
    }
    mem_store64(p, HP_MOFF, 0)
    mem_store64(p, HP_MLEN, sp1)
    mem_store64(p, HP_POFF, sp1 + 1)
    mem_store64(p, HP_PLEN, sp2 - sp1 - 1)
    mem_store64(p, HP_HOFF, rl_end + 2)
    mem_store64(p, HP_HLEN, k - rl_end - 2)
    mem_store64(p, HP_BOFF, k + 4)
    mem_store64(p, HP_BLEN, 0)
    let mut flags = 0
    if vver == 48 {
        flags = HP_F_HTTP10                     // HTTP/1.0 默认关闭
    }
    // 单遍扫描头块：content-length / connection / transfer-encoding
    let hoff = rl_end + 2
    let hend = k
    let mut i = hoff
    let mut ka_seen = 0
    while i < hend {
        // 行界
        let mut e = i
        while e < hend && mem_load8(buf, e) != 13 {
            e += 1
        }
        let mut c = i
        while c < e && mem_load8(buf, c) != 58 {    // ':'
            c += 1
        }
        if c < e {
            let nl = c - i
            if _ci_bytes(buf, i, nl, HTTP_HDR_CL) == 1 {
                // v2.95：TE: chunked 已置位时**忽略 Content-Length**
                // （RFC 7230 §3.3.3）。这个守卫必须双向：头字段顺序由客户端
                // 决定，`Content-Length` 排在 `Transfer-Encoding` **之后**时，
                // 不判 flags 就会把刚清掉的 HP_BLEN 重新写回去（实测 E2E
                // 用例 "Content-Length: 999\r\nTransfer-Encoding: chunked"
                // 与反序两种都要覆盖）。
                if (flags & HP_F_TE) == 0 {
                    let v = _hdr_num(buf, c + 1, e)
                    if v >= 0 {
                        mem_store64(p, HP_BLEN, v)
                    }
                }
            } else {
                if _ci_bytes(buf, i, nl, HTTP_HDR_TE) == 1 {
                    // v2.95：不再回 501。值里含 "chunked"（大小写无关）就置
                    // HP_F_TE；RFC 7230 §3.3.3：TE 与 Content-Length 同时出现时
                    // **以 TE 为准、CL 必须忽略**，所以这里清掉已存的 HP_BLEN。
                    if _hdr_is_chunked(buf, c + 1, e) == 1 {
                        flags |= HP_F_TE
                        mem_store64(p, HP_BLEN, 0)
                    } else {
                        return _fail(501)       // 其它编码（gzip 等）仍未支持
                    }
                }
                if _ci_bytes(buf, i, nl, HTTP_HDR_CONN) == 1 {
                    let vs = _hdr_val_str(buf, c + 1, e)
                    if vs == "close" {
                        flags |= HP_F_CLOSE
                    } else {
                        if vs == "keep-alive" {
                            ka_seen = 1
                        }
                    }
                }
            }
        }
        i = e + 2                                   // 跳过 \r\n
    }
    if (flags & HP_F_HTTP10) != 0 && ka_seen == 0 {
        flags |= HP_F_CLOSE                     // HTTP/1.0 且无 keep-alive
    }
    mem_store64(p, HP_STATE, flags)
    return 0
}

fn _fail(code: int) -> int {
    mem_store64(static_word(HTTP_ERR_W), 0, code)
    return -1
}

// TE 值 [from, to) 里是否含 "chunked"（大小写无关）。逗号链里出现即认
// （`gzip, chunked` 的 gzip 解码仍不支持，但那是响应体侧的事；请求体链
// 带 chunked 时按 chunked 框架解，v2.95 口径记入 docs/03-stdlib.md）。
fn _hdr_is_chunked(buf: int, from: int, to: int) -> int {
    let nl = 7                                  // len("chunked")
    let mut i = from
    while i + nl <= to {
        let mut j = 0
        let mut hit = 1
        while j < nl {
            let mut b = mem_load8(buf, i + j)
            if b >= 65 && b <= 90 {
                b += 32
            }
            if b != HTTP_TE_CHUNKED[j] {
                hit = 0
                j = nl                          // 借边界条件跳出
            } else {
                j += 1
            }
        }
        if hit == 1 {
            return 1
        }
        i += 1
    }
    return 0
}

// 头块 [i, e) 区间的名字与 name（小写）做大小写无关比较：1 = 相等
fn _ci_bytes(buf: int, from: int, n: int, name: str) -> int {
    if len(name) != n {
        return 0
    }
    let mut i = 0
    while i < n {
        let mut b = mem_load8(buf, from + i)
        if b >= 65 && b <= 90 {
            b += 32
        }
        if b != name[i] {
            return 0
        }
        i += 1
    }
    return 1
}

// 头块值区解析无符号十进制（容忍前后空格）；非法返回 -1
fn _hdr_num(buf: int, from: int, to: int) -> int {
    let mut a = from
    while a < to && (mem_load8(buf, a) == 32 || mem_load8(buf, a) == 9) {
        a += 1
    }
    let mut b = to
    while b > a && (mem_load8(buf, b - 1) == 32 || mem_load8(buf, b - 1) == 9) {
        b -= 1
    }
    if a == b {
        return -1
    }
    let mut v = 0
    let mut i = a
    while i < b {
        let d = mem_load8(buf, i) - 48
        if d < 0 || d > 9 {
            return -1
        }
        v = v * 10 + d
        i += 1
    }
    return v
}

// 头块值区取原样字符串（只去首尾空格；http_header 用这个，值的大小写有意义：
// Authorization / Cookie / ETag 都不能被折叠）
fn _hdr_val_raw(buf: int, from: int, to: int) -> str {
    let mut a = from
    while a < to && (mem_load8(buf, a) == 32 || mem_load8(buf, a) == 9) {
        a += 1
    }
    let mut b = to
    while b > a && (mem_load8(buf, b - 1) == 32 || mem_load8(buf, b - 1) == 9) {
        b -= 1
    }
    if a == b {
        return ""
    }
    let tmp = mem_alloc(b - a + 1)
    let mut i = a
    while i < b {
        mem_store8(tmp, i - a, mem_load8(buf, i))
        i += 1
    }
    return mem_str(tmp, b - a)
}

// 头块值区取小写字符串（connection 值比较用）
fn _hdr_val_str(buf: int, from: int, to: int) -> str {
    let mut a = from
    while a < to && (mem_load8(buf, a) == 32 || mem_load8(buf, a) == 9) {
        a += 1
    }
    let mut b = to
    while b > a && (mem_load8(buf, b - 1) == 32 || mem_load8(buf, b - 1) == 9) {
        b -= 1
    }
    let tmp = mem_alloc(b - a + 1)
    let mut i = a
    while i < b {
        let mut c = mem_load8(buf, i)
        if c >= 65 && c <= 90 {
            c += 32
        }
        mem_store8(tmp, i - a, c)
        i += 1
    }
    return mem_str(tmp, b - a)
}

// ---------------------------------------------------------------------------
// 请求访问器（handler 内用；数据就在连接槽位里，mem_str 只拷一次）
// ---------------------------------------------------------------------------

/// 请求方法（"GET" / "POST" …）
pub fn http_method(fd: int) -> str {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return ""
    }
    let buf = conn_buf_ptr(p)
    return mem_str(buf + mem_load64(p, HP_MOFF), mem_load64(p, HP_MLEN))
}

/// 请求目标原样（含 query 串；归一化请用 std.router 的 route_norm）
pub fn http_path(fd: int) -> str {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return ""
    }
    let buf = conn_buf_ptr(p)
    return mem_str(buf + mem_load64(p, HP_POFF), mem_load64(p, HP_PLEN))
}

/// `?` 之后的 query 串（到 `#` 或行尾为止；没有 query 返回 ""）
pub fn http_query(fd: int) -> str {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return ""
    }
    let buf = conn_buf_ptr(p)
    let xp = buf + mem_load64(p, HP_POFF)
    let xl = mem_load64(p, HP_PLEN)
    let mut i = 0
    while i < xl {
        let c = mem_load8(xp, i)
        if c == 63 {                            // '?'
            let mut e = i + 1
            while e < xl && mem_load8(xp, e) != 35 {    // '#'
                e += 1
            }
            return mem_str(xp + i + 1, e - i - 1)
        }
        if c == 35 {
            return ""
        }
        i += 1
    }
    return ""
}

/// 零拷贝体访问（大请求体：拿到指针直接读，不构造 str）
pub fn http_body_ptr(fd: int) -> int {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return 0
    }
    return conn_buf_ptr(p) + mem_load64(p, HP_BOFF)
}

/// 请求体长度。Content-Length 请求 = 头里声明的字节数；**chunked 请求
/// （v2.95）= 解包后的真实体长**（不含 hex 行/CRLF，ext 与 trailer 已丢弃）；
/// 无体为 0。
pub fn http_body_len(fd: int) -> int {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return 0
    }
    return mem_load64(p, HP_BLEN)
}

/// 请求体（拷成一个 str；大请求体用 http_body_ptr + http_body_len）
pub fn http_body(fd: int) -> str {
    let n = http_body_len(fd)
    if n == 0 {
        return ""
    }
    return mem_str(http_body_ptr(fd), n)
}

/// 按名找请求头（name 传小写；比较大小写无关）。没有返回 ""。
pub fn http_header(fd: int, name: str) -> str {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return ""
    }
    let buf = conn_buf_ptr(p)
    let hoff = mem_load64(p, HP_HOFF)
    let hend = hoff + mem_load64(p, HP_HLEN)
    let mut i = hoff
    while i < hend {
        let mut e = i
        while e < hend && mem_load8(buf, e) != 13 {
            e += 1
        }
        let mut c = i
        while c < e && mem_load8(buf, c) != 58 {
            c += 1
        }
        if c < e && _ci_bytes(buf, i, c - i, name) == 1 {
            return _hdr_val_raw(buf, c + 1, e)
        }
        i = e + 2
    }
    return ""
}

/// 强制本连接在本次响应后关闭（不等对端 Connection 头）
pub fn http_set_close(fd: int) -> int {
    let p = conn_slot(_st(), fd)
    if p == 0 {
        return 0
    }
    let f = mem_load64(p, HP_STATE)
    mem_store64(p, HP_STATE, f | HP_F_CLOSE)
    return 0
}

// ---------------------------------------------------------------------------
// 响应构造
// ---------------------------------------------------------------------------

/// 状态码 → 原因短语（未收录的返回 "Unknown"）
pub fn http_reason(status: int) -> str {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 204 {
        return "No Content"
    }
    if status == 301 {
        return "Moved Permanently"
    }
    if status == 302 {
        return "Found"
    }
    if status == 304 {
        return "Not Modified"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 401 {
        return "Unauthorized"
    }
    if status == 403 {
        return "Forbidden"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 413 {
        return "Payload Too Large"
    }
    if status == 426 {
        return "Upgrade Required"
    }
    if status == 429 {
        return "Too Many Requests"
    }
    if status == 431 {
        return "Request Header Fields Too Large"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    if status == 501 {
        return "Not Implemented"
    }
    if status == 503 {
        return "Service Unavailable"
    }
    return "Unknown"
}

/// 标准响应：状态行 + Content-Type/Length + Connection + 体，一次组包一次 send。
/// `extra` 传 "" 表示没有附加头；要附加时每行自带 \r\n。
pub fn http_respond_ext(fd: int, status: int, ctype: str, extra: str,
                        body: str) -> int {
    let st = _st()
    let mut conn = "keep-alive"
    let p = conn_slot(st, fd)
    if p != 0 && (mem_load64(p, HP_STATE) & HP_F_CLOSE) != 0 {
        conn = "close"
    }
    let head = "HTTP/1.1 " + (status).to_str() + " " + http_reason(status)
               + "\r\nContent-Type: " + ctype
               + "\r\nContent-Length: " + len(body).to_str()
               + "\r\nConnection: " + conn + "\r\n"
    let all = head + extra + "\r\n" + body
    conn_send_str(st, fd, all)
    return 0
}

/// 标准响应（无附加头）
pub fn http_respond(fd: int, status: int, ctype: str, body: str) -> int {
    return http_respond_ext(fd, status, ctype, "", body)
}

/// 响应后立即关闭（force close 不看对端头）
pub fn http_respond_close(fd: int, status: int, ctype: str, body: str) -> int {
    http_set_close(fd)
    return http_respond(fd, status, ctype, body)
}

/// text/plain; charset=utf-8 响应
pub fn http_text(fd: int, status: int, body: str) -> int {
    return http_respond(fd, status, "text/plain; charset=utf-8", body)
}

/// text/html; charset=utf-8 响应
pub fn http_html(fd: int, status: int, body: str) -> int {
    return http_respond(fd, status, "text/html; charset=utf-8", body)
}

/// application/json 响应
pub fn http_json(fd: int, status: int, body: str) -> int {
    return http_respond(fd, status, "application/json", body)
}

/// 供库内解析失败路径用（此时槽位协议字未就绪，直接组包发送并关连接）
pub fn http_respond_raw(fd: int, status: int, extra: str, body: str) -> int {
    let head = "HTTP/1.1 " + (status).to_str() + " " + http_reason(status)
               + "\r\nContent-Type: text/plain; charset=utf-8"
               + "\r\nContent-Length: " + len(body).to_str()
               + "\r\nConnection: close\r\n"
    conn_send_str(_st(), fd, head + extra + "\r\n" + body)
    return 0
}

// ---------------------------------------------------------------------------
// Content-Encoding: gzip（v1.6）
//   * 客户端接受才压缩（Accept-Encoding 含 gzip）；
//   * 小于 256 字节不压——固定 Huffman 头开销会让小响应反而变大；
//   * Vary: Accept-Encoding 必须带，缓存/CDN 才不会串味。
// ---------------------------------------------------------------------------

/// 客户端是否接受 gzip（看 Accept-Encoding）
pub fn http_accepts_gzip(fd: int) -> bool {
    let v = http_header(fd, "accept-encoding")
    if len(v) == 0 {
        return false
    }
    return str_contains(str_lower(v), "gzip")
}

/// 强制 gzip 响应（带 Content-Encoding 与 Vary）
pub fn http_respond_gzip(fd: int, status: int, ctype: str, body: str) -> int {
    let gz = gzip_encode(body)
    return http_respond_ext(fd, status, ctype,
                            "Content-Encoding: gzip\r\nVary: Accept-Encoding\r\n",
                            gz)
}

/// 自动协商：客户端支持且体 ≥256 字节才压，否则原样发
pub fn http_respond_auto(fd: int, status: int, ctype: str, body: str) -> int {
    if len(body) >= 256 && http_accepts_gzip(fd) {
        return http_respond_gzip(fd, status, ctype, body)
    }
    return http_respond(fd, status, ctype, body)
}

/// JSON + 自动 gzip 协商
pub fn http_json_auto(fd: int, status: int, body: str) -> int {
    return http_respond_auto(fd, status, "application/json", body)
}

/// HTML + 自动 gzip 协商
pub fn http_html_auto(fd: int, status: int, body: str) -> int {
    return http_respond_auto(fd, status, "text/html; charset=utf-8", body)
}

/// 404 响应（text/plain）
pub fn http_not_found(fd: int) -> int {
    return http_text(fd, 404, "not found\n")
}

/// 405 响应（text/plain）
pub fn http_method_not_allowed(fd: int) -> int {
    return http_text(fd, 405, "method not allowed\n")
}

// ---------------------------------------------------------------------------
// 路由 + 中间件（v2.04）
//
// 约束：reactor 的回调只传 (fd, data)，没有 user-data 通道；handler 必须是
// **裸函数名**（`callr` 间接调用），闭包（两字聚合）传不进去。所以路由表与
// 中间件链放在进程级静态字 static_word(2) 指向的预分配表里，注册在
// `http_serve` **之前**完成（单线程，不加锁）。
//
// 表布局（字）：
//   w0 路由条数 n        w1 条目容量（RT_MAX = 64，固定）
//   w2 中间件条数 m      w3 中间件容量（RT_MW_MAX = 16，固定）
//   w4 条目区指针        w5 字节区指针
//   w6..w21 中间件槽（每槽 1 字 = 函数地址）
// 条目（8 字 = 64 B）：[方法指针][方法长度][模板指针][模板长度][handler][0][0][0]
// 字节区（每条目 144 B）：方法 ≤15 字节 + 模板 ≤127 字节。注册时把字节**拷进
//   表里**（调用方的 str 随作用域释放，只存指针会读到野内存）。
//
// 匹配零拷贝：路径字节还在连接缓冲里，直接喂 std.router 的 route_match_bytes；
// `:id` 的值由 http_param(fd, i) 现取（重匹配一次，不占槽位、不存每连接状态）。
//
// 返回约定：
//   * 中间件 `fn(fd) -> int`：1 = 继续下一个，0 = 终止链路（视为已响应）。
//   * handler `fn(fd) -> int`：返回值**忽略**；要关连接就调 http_set_close。
//     （单回调模式 http_serve 的 1/0 语义不变，那是另一条路径。）
// ---------------------------------------------------------------------------

const RT_W = 2                  // static_word(2) = 路由/中间件表
const RT_N = 0
const RT_CAP = 1
const RT_MWN = 2
const RT_MWMAX = 3
const RT_ENT = 4
const RT_BYT = 5
const RT_MW = 6
const RT_HDR_B = 176            // 表头 22 字
const RT_ENTRY_B = 64           // 每条目 8 字
const RT_BYTES_PER = 144        // 方法 16 B + 模板 128 B
const RT_MAX = 64
const RT_MW_MAX = 16
const RT_METHOD_MAX = 15
const RT_PATTERN_MAX = 127

// 取（必要时建）路由表块；create=0 时不建，返回 0 表示还没注册过
fn _rt(create: int) -> int {
    let w = static_word(RT_W)
    let t = mem_load64(w, 0)
    if t != 0 || create == 0 {
        return t
    }
    let t2 = mem_alloc(RT_HDR_B)
    mem_zero(t2, RT_HDR_B)
    let ent = mem_alloc(RT_MAX * RT_ENTRY_B)
    mem_zero(ent, RT_MAX * RT_ENTRY_B)
    let byt = mem_alloc(RT_MAX * RT_BYTES_PER)
    mem_zero(byt, RT_MAX * RT_BYTES_PER)
    mem_store64(t2, RT_CAP, RT_MAX)
    mem_store64(t2, RT_MWMAX, RT_MW_MAX)
    mem_store64(t2, RT_ENT, ent)
    mem_store64(t2, RT_BYT, byt)
    mem_store64(w, 0, t2)
    return t2
}

/// 清空路由表与中间件链（只清计数，不释放内存；测试与「重载配置」用）
pub fn http_routes_reset() -> int {
    let t = _rt(1)
    mem_store64(t, RT_N, 0)
    mem_store64(t, RT_MWN, 0)
    return 0
}

/// 注册一条路由：`method` 传 "GET"/"POST"…，`"*"` 或 "" 表示任意方法；
/// `pattern` 见 std.router（`/users/:id`、尾部 `*`）；`handler` 是裸函数名。
/// 返回条目下标；表满返回 -1，方法/模板超长返回 -2（模板 ≤127 字节）。
pub fn http_route(method: str, pattern: str, handler: int) -> int {
    let t = _rt(1)
    let n = mem_load64(t, RT_N)
    if n >= mem_load64(t, RT_CAP) {
        return -1
    }
    let ml = len(method)
    let pl = len(pattern)
    if ml > RT_METHOD_MAX || pl > RT_PATTERN_MAX {
        return -2
    }
    let ent = mem_load64(t, RT_ENT) + n * RT_ENTRY_B
    let byt = mem_load64(t, RT_BYT) + n * RT_BYTES_PER
    if ml > 0 {
        mem_copy(byt, mem_ptr(method, 0), ml)
    }
    mem_store8(byt, ml, 0)
    if pl > 0 {
        mem_copy(byt + 16, mem_ptr(pattern, 0), pl)
    }
    mem_store8(byt, 16 + pl, 0)
    // 模板按**归一化形态**入库（去 query/尾斜杠/首个 '/'）：字面段路由在派发期
    // 只需一次长度比较 + mem_diff，不必走逐段扫描。
    let pn = route_eff_len(mem_ptr(pattern, 0), pl)
    let mut ps = 0
    if pn > 0 && mem_load8(mem_ptr(pattern, 0), 0) == 47 {
        ps = 1
    }
    let norm_len = pn - ps
    let pptr = byt + 16 + ps
    // 特征位：bit0 = 含 ':' 段，bit1 = 含 '*'；顺带数出段数（段数不符可提前排除）
    let mut flags = 0
    let mut segs = 1
    let mut i = 0
    while i < norm_len {
        let c = mem_load8(pptr, i)
        if c == 58 {
            flags |= 1
        }
        if c == 42 {
            flags |= 2
        }
        if c == 47 {
            segs += 1
        }
        i += 1
    }
    if norm_len == 0 {
        segs = 0
    }
    // 字面前缀长度（到第一个 ':' 或 '*' 为止）：派发期先用 mem_diff 过滤，
    // 大多数不匹配的路由一次比较就被排除。含 '*' 时不用它（'*' 能吃零段）。
    let mut prefix = norm_len
    let mut j = 0
    while j < norm_len {
        let c = mem_load8(pptr, j)
        if c == 58 || c == 42 {
            prefix = j
            break
        }
        j += 1
    }
    mem_store64(ent, 0, byt)
    mem_store64(ent, 1, ml)
    mem_store64(ent, 2, pptr)
    mem_store64(ent, 3, norm_len)
    mem_store64(ent, 4, handler)
    mem_store64(ent, 5, flags)
    mem_store64(ent, 6, segs)
    mem_store64(ent, 7, prefix)
    mem_store64(t, RT_N, n + 1)
    return n
}

/// 注册一个中间件（`fn(fd: int) -> int`：1 = 继续，0 = 终止链路）。
/// 执行顺序 = 注册顺序；返回槽位下标，满返回 -1。
pub fn http_use(mw: int) -> int {
    let t = _rt(1)
    let m = mem_load64(t, RT_MWN)
    if m >= mem_load64(t, RT_MWMAX) {
        return -1
    }
    mem_store64(t, RT_MW + m, mw)
    mem_store64(t, RT_MWN, m + 1)
    return m
}

/// 已注册路由条数
pub fn http_route_count() -> int {
    let t = _rt(0)
    if t == 0 {
        return 0
    }
    return mem_load64(t, RT_N)
}

/// 已注册中间件条数
pub fn http_mw_count() -> int {
    let t = _rt(0)
    if t == 0 {
        return 0
    }
    return mem_load64(t, RT_MWN)
}

// 方法字节相等（通配 "*" 或空方法 = 任意）；1 = 相等
fn _m_eq(a: int, an: int, b: int, bn: int) -> int {
    if an == 0 {
        return 1
    }
    if an == 1 && mem_load8(a, 0) == 42 {       // '*'
        return 1
    }
    if an != bn {
        return 0
    }
    if mem_diff(a, b, an) == an {               // 全等返回 n（8 字节字比较）
        return 1
    }
    return 0
}

// 查表：返回条目下标；-1 = 没有路径匹配（404）；-2 = 路径匹配但方法不符（405）
fn _route_find(mp: int, ml: int, xp: int, xl: int) -> int {
    let t = _rt(0)
    if t == 0 {
        return -1
    }
    let n = mem_load64(t, RT_N)
    // 路径归一化整条请求只算一次（去 query/fragment、去首尾 '/'）
    let xl2 = route_eff_len(xp, xl)
    let mut xs = 0
    if xl2 > 0 && mem_load8(xp, 0) == 47 {
        xs = 1
    }
    let xn = xl2 - xs
    let xsegs = route_seg_count(xp + xs, xn)
    let mut i = 0
    let mut path_hit = 0
    while i < n {
        let ent = mem_load64(t, RT_ENT) + i * RT_ENTRY_B
        let pptr = mem_load64(ent, 2)
        let plen = mem_load64(ent, 3)
        let flags = mem_load64(ent, 5)
        let mut pm = false
        if (flags & 3) == 0 {
            // 纯字面段：长度相等 + 一次 mem_diff（8 字节字比较）
            if plen == xn && mem_diff(pptr, xp + xs, xn) == xn {
                pm = true
            }
        } else {
            let mut cand = true
            if (flags & 2) == 0 {                  // 没有 '*' 才能用段数/前缀过滤
                if mem_load64(ent, 6) != xsegs {
                    cand = false                   // 段数不符：直接排除
                } else {
                    let pf = mem_load64(ent, 7)
                    if pf > 0 && (xn < pf || mem_diff(pptr, xp + xs, pf) != pf) {
                        cand = false               // 字面前缀不符：一次比较排除
                    }
                }
            }
            if cand {
                pm = route_match_norm(pptr, plen, xp + xs, xn)
            }
        }
        if pm {
            if _m_eq(mem_load64(ent, 0), mem_load64(ent, 1), mp, ml) == 1 {
                return i
            }
            path_hit = 1
        }
        i += 1
    }
    if path_hit == 1 {
        return -2
    }
    return -1
}

/// 纯查询版路由匹配（不碰连接、不发送）：返回条目下标 / -1 未匹配 / -2 方法不符。
/// 用于单测与「先查再处理」的自定义派发。
pub fn http_route_index(method: str, path: str) -> int {
    return _route_find(mem_ptr(method, 0), len(method),
                       mem_ptr(path, 0), len(path))
}

/// 当前请求命中的第 `i` 个 `:参数`（从 0 起；不匹配/越界返回 ""）
pub fn http_param(fd: int, i: int) -> str {
    let t = _rt(0)
    if t == 0 {
        return ""
    }
    let sp = conn_slot(_st(), fd)
    if sp == 0 {
        return ""
    }
    let buf = conn_buf_ptr(sp)
    let xp = buf + mem_load64(sp, HP_POFF)
    let xl = mem_load64(sp, HP_PLEN)
    let idx = _route_find(buf + mem_load64(sp, HP_MOFF), mem_load64(sp, HP_MLEN),
                          xp, xl)
    if idx < 0 {
        return ""
    }
    let ent = mem_load64(t, RT_ENT) + idx * RT_ENTRY_B
    return route_param_at(mem_load64(ent, 2), mem_load64(ent, 3), xp, xl, i)
}

/// 当前请求命中的 `:参数` 个数（没命中返回 0）
pub fn http_param_count(fd: int) -> int {
    let t = _rt(0)
    if t == 0 {
        return 0
    }
    let sp = conn_slot(_st(), fd)
    if sp == 0 {
        return 0
    }
    let buf = conn_buf_ptr(sp)
    let xp = buf + mem_load64(sp, HP_POFF)
    let xl = mem_load64(sp, HP_PLEN)
    let idx = _route_find(buf + mem_load64(sp, HP_MOFF), mem_load64(sp, HP_MLEN),
                          xp, xl)
    if idx < 0 {
        return 0
    }
    let ent = mem_load64(t, RT_ENT) + idx * RT_ENTRY_B
    return route_param_count(mem_load64(ent, 2), mem_load64(ent, 3), xp, xl)
}

/// 内置派发器：中间件链 → 路由表 → handler；未命中回 404、方法不符回 405。
/// 当 `http_serve(port, backlog, http_dispatch)` 的 handler 用。
/// 永远返回 1（连接按 keep-alive 走），要关连接在 handler/中间件里调
/// http_set_close。
pub fn http_dispatch(fd: int) -> int {
    let t = _rt(0)
    if t != 0 {
        let m = mem_load64(t, RT_MWN)
        let mut i = 0
        while i < m {
            let h = mem_load64(t, RT_MW + i)
            if h != 0 {
                if h(fd) == 0 {
                    return 1                    // 中间件已响应，终止链路
                }
            }
            i += 1
        }
    }
    let sp = conn_slot(_st(), fd)
    if sp == 0 {
        return 0
    }
    let buf = conn_buf_ptr(sp)
    let idx = _route_find(buf + mem_load64(sp, HP_MOFF), mem_load64(sp, HP_MLEN),
                          buf + mem_load64(sp, HP_POFF), mem_load64(sp, HP_PLEN))
    if idx == -2 {
        http_method_not_allowed(fd)
        return 1
    }
    if idx < 0 {
        http_not_found(fd)
        return 1
    }
    let ent = mem_load64(t, RT_ENT) + idx * RT_ENTRY_B
    let h = mem_load64(ent, 4)
    h(fd)
    return 1
}
