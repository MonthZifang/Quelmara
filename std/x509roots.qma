// std/x509roots.qma —— 内置 TLS 根证书库（v2.97）
//
// 为什么需要它：`x509_verify_chain` 一直要求调用方**自己把信任锚喂进来**
// （anchor: str 参数）——语言能验链，却"不知道该信谁"。本模块把信任锚变成
// 库的一部分：12 个主流根（Let Encrypt / Amazon / DigiCert / GlobalSign /
// Sectigo+USERTrust / Google / SSL.com / Certum），按**主题 DN 配对**给
// std/x509 的链验证提供锚。gaps §2 TLS 行的"根证书库（信任锚管理）"自此收口。
//
// 数据：2026-10-28 从 Debian bookworm 的 ca-certificates 系统包提取
// （openssl 信任库同源），DER 原样十六进制内联——**不读磁盘、不读环境变量**，
// 产物里带的就是这些字节；换根 = 改这个文件重编译。
//
// 诚实边界：
//   * 当前验证栈（std/x509 + std/p256 + std/rsa）只支持 SHA-256 两条路：
//     RSA-SHA256 与 ECDSA P-256-SHA256。12 个根里 5 个能**自验证**
//     （ISRG X1 / Amazon 1 / Amazon 3 / DigiCert G2 / GlobalSign R3），
//     其余 7 个的自我签名是 P-384/SHA-384 或 SHA-1——存着但不自检，
//     `x509_root_selfcheck(i)` 对它们返回 0（不是"不可信"，是"当前栈
//     验不动这种算法"；算法补齐登记在 07-gaps §2 TLS 行）。
//   * DN 配对是**逐字节**比较 issuer/subject 的 DER（与 std/x509 现有口径
//     一致），不做 RFC 4514 规范化；跨签名桥证书应由调用方放进 intermediates。
//   * 12 个是"演示级信任集"，不是完整 Mozilla bundle（140+）；导入策略、
//     更新通道不做——那是包管理（qpm）的活，不是运行时根的活。

import std.hex
import std.x509

const X509ROOTS_N = 12

// 根证书 DER（十六进制）。**下标不当身份用**——测试与调用方都按名/DN 查
// （x509_root_find），插拔根会动下标。
fn _x509roots_der() -> vec[str] {
    let t = vec[str].new(X509ROOTS_N)
    // [0] ISRG Root X1
    t.push("")
    // [1] ISRG Root X2
    t.push("")
    // [2] Amazon Root CA 1
    t.push("")
    // [3] Amazon Root CA 3
    t.push("")
    // [4] DigiCert Global Root G2
    t.push("")
    // [5] GlobalSign Root CA - R3
    t.push("")
    // [6] USERTrust RSA Certification Authority
    t.push("")
    // [7] USERTrust ECC Certification Authority
    t.push("")
    // [8] GTS Root R4
    t.push("")
    // [9] SSL.com TLS ECC Root CA 2022
    t.push("")
    // [10] Sectigo Public Server Authentication Root E46
    t.push("")
    // [11] Certum Trusted Network CA
    t.push("")
    return t
}

/// 表内根证书数量。
pub fn x509_roots_count() -> int {
    return X509ROOTS_N
}

/// 第 i 个根的 DER（原始字节）。越界返回 ""。
pub fn x509_root_at(i: int) -> str {
    if i < 0 || i >= X509ROOTS_N {
        return ""
    }
    return hex_decode(_x509roots_der().get(i))
}

/// 按主题 DN（`x509_subject` 的原始 DER）查根；没有返回 -1。
pub fn x509_root_find(subject_dn: str) -> int {
    let t = _x509roots_der()
    let mut i = 0
    while i < X509ROOTS_N {
        if x509_subject(hex_decode(t.get(i))) == subject_dn {
            return i
        }
        i = i + 1
    }
    return -1
}

/// 离 `cert` 最近的受信锚：按 issuer DN 查表命中（跨签名桥不在这里找，
/// 桥证书应由调用方放进 intermediates）。没有返回 ""。
pub fn x509_trusted_anchor(cert: str) -> str {
    let i = x509_root_find(x509_issuer(cert))
    if i < 0 {
        return ""
    }
    return x509_root_at(i)
}

/// 一键验证：leaf + intermediates（leaf→根方向排序，不含根），锚**自动查表**
/// ——查"链尾证书的 issuer"：表里没有链上中间 CA 的根时，链尾的 issuer 才是
/// 真锚。host/now 语义同 x509_verify_chain。
/// 返回 1 = 通过；0 = 不通过（含"锚在表里但签名算法当前栈验不动"）。
pub fn x509_verify_stored(leaf: str, inter: vec[str], host: str, now: int) -> int {
    let mut cur = leaf
    let mut i = 0
    while i < len(inter) {
        if len(inter.get(i)) > 0 {
            cur = inter.get(i)
        }
        i = i + 1
    }
    let a = x509_trusted_anchor(cur)
    if len(a) == 0 {
        return 0
    }
    return x509_verify_chain(leaf, inter, a, host, now)
}

/// 根自验证：用**自己的公钥验自己的签名**。信任锚的"可信"本质是人工契约
/// （这张表被审过），密码学上能做的只有自证签名闭合——这就是那个闭合检查。
/// 1 = 通过；0 = 失败或当前栈不支持该根的签名算法（见文件头边界）。
pub fn x509_root_selfcheck(i: int) -> int {
    let r = x509_root_at(i)
    if len(r) == 0 {
        return 0
    }
    let none = vec[str].new(0)
    return x509_verify_chain(r, none, r, "", 1764000000)
}

