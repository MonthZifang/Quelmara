// std/session.qma —— 内存会话存储（v1.71）
//
// 为什么需要：cookie 有了（v1.70），但"登录态"还差一层：把 sid 映射到一组键值，
// 带过期时间。§2 的 session 一直缺，示例只能用全局 map 手搓。
//
// 语义：
//   * SessionStore 是**值类型**（两个 map 句柄 + 一个计数器），按值传参即可，
//     内部 map 是句柄语义——函数里 set 的改动对调用方可见；
//   * 键用 `sid + 0x1f + key` 拼成扁平 map（语言没有嵌套 map，也没有 map 迭代）；
//   * 过期是**惰性**的：读取时比对 `exp[sid] <= now`；没有后台清理线程，
//     也没有全表扫描（map 不支持遍历），所以删除只能打墓碑；
//   * sid 由自增计数器生成（`s1`、`s2`…）——**可预测，只用于测试/单机**；
//     线上需要随机源，见 07-gaps。
//
// 边界：进程内内存，重启即失；不做签名/加密；不做 LRU 淘汰；不做并发保护
// （多线程共享同一个 store 需调用方自己加锁）。

struct SessionStore {
    data: map[str]str
    exp: map[str]int
}

pub fn session_new() -> SessionStore {
    return SessionStore {
        data: map[str]str.new(),
        exp: map[str]int.new()
    }
}

fn session_key(sid: str, key: str) -> str {
    return sid + "\x1f" + key
}

// 新建会话，返回 sid；ttl 单位秒（<=0 表示永不过期）
pub fn session_create(st: SessionStore, ttl: int, now: int) -> str {
    // sid 用 exp 表的条目数 +1：exp 从不删条目（销毁只打墓碑），所以单调递增。
    // 注意不能把计数器放在 struct 里——struct 是值类型，按值传参改了不生效
    // （v1.71 踩过：两个会话都拿到 s1）。
    let sid = "s" + (len(st.exp) + 1).to_str()
    if ttl > 0 {
        st.exp.set(sid, now + ttl)
    } else {
        st.exp.set(sid, 0)
    }
    return sid
}

pub fn session_alive(st: SessionStore, sid: str, now: int) -> bool {
    if len(sid) == 0 {
        return false
    }
    if !st.exp.has(sid) {
        return false
    }
    let e = st.exp.get(sid)
    if e == 0 {
        return true                 // 0 = 永不过期
    }
    return e > now
}

pub fn session_get(st: SessionStore, sid: str, key: str, now: int) -> str {
    if !session_alive(st, sid, now) {
        return ""
    }
    let k = session_key(sid, key)
    if !st.data.has(k) {
        return ""
    }
    return st.data.get(k)
}

// 写入；会话不存在或已过期返回 false
pub fn session_set(st: SessionStore, sid: str, key: str, value: str,
                   now: int) -> bool {
    if !session_alive(st, sid, now) {
        return false
    }
    st.data.set(session_key(sid, key), value)
    return true
}

// 续期（滑动过期）；会话已死返回 false
pub fn session_touch(st: SessionStore, sid: str, ttl: int, now: int) -> bool {
    if !session_alive(st, sid, now) {
        return false
    }
    if ttl > 0 {
        st.exp.set(sid, now + ttl)
    }
    return true
}

// 销毁：打墓碑（exp = -1），data 里的键无法枚举所以留在表里（见模块头注释）
pub fn session_destroy(st: SessionStore, sid: str) {
    if st.exp.has(sid) {
        st.exp.set(sid, -1)
    }
}

// 已创建的会话总数（含已销毁的墓碑）
pub fn session_count(st: SessionStore) -> int {
    return len(st.exp)
}
