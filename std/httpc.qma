// std/httpc.qma —— HTTP/1.1 客户端核心（v1.48）：URL 拆分 + 请求构造 +
// 响应解析（content-length / chunked / 读到底）+ 重定向判定。
//
// 为什么需要：07-gaps §2「HTTP 客户端」——TLS 通道已通（v1.25），缺 HTTP 封装，
// 调用第三方 API 只能手写 socket。本模块把「URL → 字节流 → 结构化响应」闭环，
// 且**解析核心是纯函数**（不碰 socket）：离线可测、跨平台可编译。
//
// 设计约束：
//   * 传输层不在这里——见 std/httpc_net.qma（httpc_get / httpc_get_tls，
//     依赖 tcp_connect 的 getaddrinfo，只编译于 Windows PE）。本模块零 socket
//     依赖，Linux/CI 可完整构建与测试；
//   * 一次连接一个响应（Connection: close 语义）——不做连接池/流水线；
//   * 不自动解压 Content-Encoding（gzip 解码在 std/gzip，调用方自选）；
//   * 重定向只做「判定 + URL 解析」（httpc_redirect），自动跟随在
//     httpc_net.httpc_get_follow（有深度上限）；
//   * 端口段非十进制 / 状态码非三位数字会 fail-fast（与 str.to_int 一致）。
//
// 精度/边界：
//   * chunked 支持 chunk 扩展（size;ext）与多块拼接；trailer 忽略；
//   * 相对 Location 不解析 "../（登记 07-gaps，简化实现）；
//   * 无 Content-Length 且非 chunked 的响应按「读到底」语义：complete=0，
//     只有对端关闭后才由传输层补全（httpc_net 读到空串即止）。

import std.str
import std.url

// ---------------------------------------------------------------------------
// URL 拆分
// ---------------------------------------------------------------------------

/// URL 拆分的产物：scheme / host / port / path（含 query）+ ok。
/// ok=1 表示 host 非空、可以发起连接；缺省 scheme=http、port=80/443、path="/"。
pub struct HttpUrl {
    scheme: str          // "http" / "https"（小写；缺省 http）
    host: str
    port: int            // 缺省 80 / 443
    path: str            // 含 query；缺省 "/"
    ok: int              // 1 = host 非空、可连接
}

/// 拆分 URL 为 scheme/host/port/path。无 scheme 前缀时按 http 处理。
pub fn httpc_split_url(u: str) -> HttpUrl {
    let mut r = HttpUrl { scheme: "http", host: "", port: 0, path: "/", ok: 0 }
    let p = str_find(u, "://")
    let mut rest = u
    if p >= 0 {
        r.scheme = str_lower(str_slice(u, 0, p))
        rest = str_slice(u, p + 3, len(u))
    }
    // rest = host[:port][/path]
    let slash = str_find(rest, "/")
    let mut hostport = rest
    if slash >= 0 {
        hostport = str_slice(rest, 0, slash)
        r.path = str_slice(rest, slash, len(rest))
    }
    let colon = str_find(hostport, ":")
    if colon >= 0 {
        r.host = str_slice(hostport, 0, colon)
        let ps = str_slice(hostport, colon + 1, len(hostport))
        r.port = ps.to_int()
    } else {
        r.host = hostport
    }
    if r.port <= 0 {
        if r.scheme == "https" {
            r.port = 443
        } else {
            r.port = 80
        }
    }
    if len(r.host) > 0 {
        r.ok = 1
    }
    return r
}

// ---------------------------------------------------------------------------
// 请求构造
// ---------------------------------------------------------------------------

/// 构造完整请求字节（方法 + URL + 附加头 + 体）。hdrs 每行一条完整
/// "Name: Value"（自带 \r\n 由本函数补）。URL 非法返回 ""。
pub fn httpc_build_request(method: str, url: str, hdrs: vec[str], body: str) -> str {
    let u = httpc_split_url(url)
    if u.ok == 0 {
        return ""
    }
    let mut req = method + " " + u.path + " HTTP/1.1\r\n"
    req = req + "Host: " + u.host + "\r\n"
    req = req + "User-Agent: Quelmara-httpc/1.50\r\n"
    req = req + "Accept: */*\r\n"
    req = req + "Connection: close\r\n"
    let mut i = 0
    while i < len(hdrs) {
        req = req + hdrs.get(i) + "\r\n"
        i = i + 1
    }
    let bl = len(body)
    if bl > 0 {
        req = req + "Content-Length: " + bl.to_str() + "\r\n"
    }
    req = req + "\r\n"
    req = req + body
    return req
}

// ---------------------------------------------------------------------------
// 响应解析
// ---------------------------------------------------------------------------

/// 响应解析的产物：status（-1=解析失败或头未收全）/ reason / head / body / complete / chunked。
/// body 是解码后的（chunked 已拼合）；complete=1 才说明 body 完整。
pub struct HttpResponse {
    status: int          // -1 = 解析失败 / 头未收全
    reason: str
    head: str            // 头块（status line + 头行，不含空行）
    body: str            // 解码后的 body（chunked 已拼合）
    complete: int        // 1 = body 完整（content-length 够 / chunked 见到 0 块）
    chunked: int         // 1 = Transfer-Encoding: chunked
}

fn _bad_resp() -> HttpResponse {
    return HttpResponse { status: -1, reason: "", head: "", body: "", complete: 0, chunked: 0 }
}

/// 失败响应（URL 非法 / 连接失败时由传输层返回）
pub fn httpc_bad_response() -> HttpResponse {
    return _bad_resp()
}

/// 由传输层组装一条已解析的响应（v3.12）。
///
/// 为什么需要这个工厂：**限定 struct 字面量不做**（`02-language.md` §1），
/// 所以 `std/httpc_net` 没法写 `HttpResponse { ... }`。v3.12 起传输层不再
/// 每轮把整个缓冲区重新喂给 `httpc_parse_response`（那是 O(n²)），改成
/// "头块解析一次 + body 增量累积"，最后由这里按部件拼出结果。
///
/// `chunked` 由 `framing == 2` 决定，调用方不必重复判断。
pub fn httpc_make_response(status: int, reason: str, head: str, body: str,
                           complete: int, chunked: int) -> HttpResponse {
    return HttpResponse {
        status: status,
        reason: reason,
        head: head,
        body: body,
        complete: complete,
        chunked: chunked,
    }
}

// 内部：chunked 解码结果
struct _ChunkRes {
    body: str
    complete: int
}

// 十六进制字符 → 值；非法返回 -1
fn _hexval(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 0 - 1
}

// ---------------------------------------------------------------------------
// 增量 chunked 解码器（v3.12）
// ---------------------------------------------------------------------------
//
// v3.11 及以前的 `_dechunk(s)` 是「对整段缓冲区做纯函数解析」，每次续收都
// **从头重解一遍**，而且每块都 `r.body = r.body + slice` 复制已累计的全部数据。
// 两层叠加是 O(n²)：2 MB 响应（256 块）实测直接撞 `heap_limit_mb`。
//
// 现在拆成「状态机 + 输出缓冲」：
//   * `_Ck` 记住扫描游标 `pos`，续收后从断点继续，不重扫已消费的字节；
//   * 块数据 `mem_copy` 进一块按倍数扩容的原始内存，末尾一次成串；
//   * 总拷贝量 O(n)，峰值内存 ≤ 2n（扩容瞬间新旧缓冲并存）。
//
// 契约与旧实现一致：数据不完整时返回 `complete=0` 且 `body` 是**已解出的部分**。
// 唯一的语义差别是"未收全的块只交出完整部分"——旧实现会把半块数据也塞进
// body，那本来就无法被调用方正确使用（长度未知），收紧后反而更好用。

struct _Ck {
    pos: int        // 扫描游标（下一个 size 行的起点）
    complete: int   // 1 = 见到 0 长度块
    bad: int        // 1 = 病态流（非法 hex / 缺 CRLF）
}

// 一个 size 行的解析结果：sz >= 0 是块长度；-1 = 行未收全；-2 = 非法。
struct _SzLine {
    sz: int
    pos: int
}

fn _ck_new() -> _Ck {
    return _Ck { pos: 0, complete: 0, bad: 0 }
}

// 从 s[pos] 读一个 size 行。
fn _ck_size_line(s: str, pos: int) -> _SzLine {
    let n = len(s)
    let mut i = pos
    let mut v = 0
    let mut ndig = 0
    let mut ext = 0
    while i < n {
        let c = s[i]
        if c == 59 {
            ext = 1                  // ';' = chunk-ext 起点，整段丢到行尾
        } else {
            if c == 13 {
                if i + 1 >= n {
                    return _SzLine { sz: 0 - 1, pos: pos }
                }
                if s[i + 1] != 10 {
                    return _SzLine { sz: 0 - 2, pos: pos }
                }
                if ndig == 0 {
                    return _SzLine { sz: 0 - 2, pos: pos }   // 空 size 行
                }
                return _SzLine { sz: v, pos: i + 2 }
            }
            if ext == 0 {
                let d = _hexval(c)
                if d < 0 {
                    return _SzLine { sz: 0 - 2, pos: pos }
                }
                ndig = ndig + 1
                if ndig > 8 {
                    return _SzLine { sz: 0 - 2, pos: pos }   // 超 8 位：防溢出
                }
                v = v * 16 + d
            }
        }
        i = i + 1
    }
    return _SzLine { sz: 0 - 1, pos: pos }                   // 行还没收全
}

// 把 [from, from+n) 追加到增长缓冲（mem 块 3 字 {ptr, cap, len}）。
fn _buf_reserve(h: int, need: int) {
    let cap = mem_load64(h, 1)
    if need <= cap {
        return
    }
    let mut ncap = cap * 2
    if ncap < need {
        ncap = need
    }
    let np = mem_alloc(ncap)
    let used = mem_load64(h, 2)
    if used > 0 {
        mem_copy(np, mem_load64(h, 0), used)
    }
    mem_free(mem_load64(h, 0), cap)
    mem_store64(h, 0, np)
    mem_store64(h, 1, ncap)
}

fn _buf_append(h: int, src: int, n: int) {
    if n <= 0 {
        return
    }
    let used = mem_load64(h, 2)
    _buf_reserve(h, used + n)
    mem_copy(mem_load64(h, 0) + used, src, n)
    mem_store64(h, 2, used + n)
}

// 增量解码：把 s 里从 st.pos 起的完整块全部搬进 h，返回推进后的状态。
// Quelmara 的 struct 是**值语义**，所以状态必须由返回值带出，不能靠形参回写。
fn _ck_feed(s: str, st0: _Ck, h: int) -> _Ck {
    let mut st = st0
    let n = len(s)
    while st.complete == 0 && st.bad == 0 {
        let r = _ck_size_line(s, st.pos)
        let sz = r.sz
        if sz == 0 - 1 {
            return st                // size 行未收全，等下一段
        }
        if sz == 0 - 2 {
            st.bad = 1
            return st
        }
        st.pos = r.pos
        if sz == 0 {
            st.complete = 1          // 结尾块；trailer 忽略
            return st
        }
        let ds = st.pos
        let de = ds + sz
        if de + 2 > n {
            // 数据段（含尾 CRLF）未收全：把**已到的那部分数据**交出去，
            // 保持 v1.48 起的对外语义（t92 的 `chunked-short partial` 依赖它）。
            // 只交数据、不交 CRLF：老实现是 `slice(ds, len(s))`，在"数据齐、
            // CRLF 只到一半"时会把 \r 混进 body——那条路径当时没有用例覆盖。
            let mut have = n
            if have > de {
                have = de
            }
            if have > ds {
                _buf_append(h, str_ptr(s) + ds, have - ds)
            }
            return st
        }
        // 尾 CRLF 必须是 \r\n，否则是病态流
        if s[de] != 13 || s[de + 1] != 10 {
            st.bad = 1
            return st
        }
        _buf_append(h, str_ptr(s) + ds, sz)
        st.pos = de + 2
    }
    return st
}

/// chunked 解码：拼合各块数据；见到 0 长度块 = complete。数据不完整时
/// 返回已拼部分且 complete=0。
///
/// v3.12 起内部走增量状态机（见 `_ck_feed`）：整段重解与逐块 `+` 拼接都去掉了，
/// 成本从 O(n²) 降到 O(n)。对外语义不变（纯函数、无副作用）。
fn _dechunk(s: str) -> _ChunkRes {
    let mut r = _ChunkRes { body: "", complete: 0 }
    let h = mem_alloc(24)
    mem_store64(h, 0, mem_alloc(1024))
    mem_store64(h, 1, 1024)
    mem_store64(h, 2, 0)
    let st = _ck_feed(s, _ck_new(), h)
    let used = mem_load64(h, 2)
    if used > 0 {
        r.body = mem_str(mem_load64(h, 0), used)
    }
    r.complete = st.complete
    mem_free(mem_load64(h, 0), mem_load64(h, 1))
    mem_free(h, 24)
    return r
}
/// 解析完整响应字节。buf 可以只含部分响应（complete=0）；传输层应持续
/// 拼接后再次调用。头未收全（无 \r\n\r\n）返回 status=-1。
pub fn httpc_parse_response(buf: str) -> HttpResponse {
    let mut r = _bad_resp()
    let he = str_find(buf, "\r\n\r\n")
    if he < 0 {
        return r
    }
    r.head = str_slice(buf, 0, he)
    let rest = str_slice(buf, he + 4, len(buf))
    let lines = str_lines(r.head)
    if len(lines) == 0 {
        return r
    }
    // status line："HTTP/1.1 200 OK"——第一空格后三位状态码
    let sl = lines.get(0)
    let sp1 = str_find(sl, " ")
    if sp1 < 0 {
        return r
    }
    let scode = str_slice(sl, sp1 + 1, sp1 + 4)
    r.status = scode.to_int()
    let sp2 = str_find_from(sl, sp1 + 4, " ")
    if sp2 >= 0 {
        r.reason = str_slice(sl, sp2 + 1, len(sl))
    }
    // 定长 / 分块判定（头名大小写不敏感）
    let cl = httpc_header_raw(r.head, "Content-Length")
    let te = httpc_header_raw(r.head, "Transfer-Encoding")
    if str_find(str_lower(te), "chunked") >= 0 {
        r.chunked = 1
        let cr = _dechunk(rest)
        r.body = cr.body
        r.complete = cr.complete
        return r
    }
    if len(cl) > 0 {
        let n = cl.to_int()
        if n >= 0 && len(rest) >= n {
            r.body = str_slice(rest, 0, n)
            r.complete = 1
        } else {
            r.body = rest
            r.complete = 0
        }
        return r
    }
    // 无定长无分块：读到底（对端关闭后 complete 仍为 0，语义即"长度未知"）
    r.body = rest
    r.complete = 0
    return r
}

/// 头块内按名取值（大小写不敏感；跳过 status line）。
///
/// v3.12 起公开：传输层 `std/httpc_net` 的接收循环要自己判 framing
/// （content-length / chunked），而它只拿到头块文本、拿不到 HttpResponse。
pub fn httpc_header_raw(head: str, name: str) -> str {
    let lines = str_lines(head)
    let mut i = 1
    while i < len(lines) {
        let ln = lines.get(i)
        let c = str_find(ln, ":")
        if c > 0 {
            let nm = str_slice(ln, 0, c)
            if str_eq_ci(nm, name) {
                return str_trim(str_slice(ln, c + 1, len(ln)))
            }
        }
        i = i + 1
    }
    return ""
}

/// 响应头取值（大小写不敏感；无此头返回 ""）
pub fn httpc_header(resp: HttpResponse, name: str) -> str {
    return httpc_header_raw(resp.head, name)
}

// ---------------------------------------------------------------------------
// 重定向
// ---------------------------------------------------------------------------

/// 重定向目标解析：3xx 且有 Location 返回目标 URL（绝对 Location 原样，
/// 绝对路径拼 base 的 scheme://host，相对路径简化拼接），否则返回 ""。
/// 只解析不跟随（跟随见 httpc_net.httpc_get_follow）。
pub fn httpc_redirect(resp: HttpResponse, base: str) -> str {
    if resp.status != 301 && resp.status != 302 && resp.status != 303 {
        if resp.status != 307 && resp.status != 308 {
            return ""
        }
    }
    let loc = httpc_header(resp, "Location")
    if len(loc) == 0 {
        return ""
    }
    if str_find(loc, "http://") == 0 || str_find(loc, "https://") == 0 {
        return loc
    }
    let b = httpc_split_url(base)
    if str_find(loc, "/") == 0 {
        return b.scheme + "://" + b.host + loc
    }
    // 相对路径（简化）：拼 base host，不解析 "../"（登记 07-gaps）
    return b.scheme + "://" + b.host + "/" + loc
}
