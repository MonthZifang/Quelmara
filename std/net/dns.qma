import std.net.udp

// std/net/dns.qma —— 自研 DNS 解析器（v3.03）
//
// 为什么需要：Linux 上 `tcp_connect` 一直只能吃 IPv4 点分字面量，域名会
// fail-fast（v2.92 的边界）。要补 DNS，有两条路：
//
//   1. 在 stage-0 的 IR 里拼 glibc 的 getaddrinfo —— 走 nsswitch → dlopen
//      插件，等于把动态链接世界搬进"无 libc 静态可执行文件"的后端；
//   2. **用 Quelmara 实现 DNS 协议本身**（RFC 1035 的最小子集），跑在已有的
//      UDP 内建上。
//
// 本模块选 2。理由不只是"更自研"：DNS 是个**纯协议**问题（拼报文、解报文），
// 与 libc 无关；而 nsswitch 是**平台策略**（hosts 文件、mDNS、systemd-resolved、
// NSS 插件顺序），那才是真正抄不动的东西。把协议留在我们这边，平台策略交给
// 调用方（读 resolv.conf 已经覆盖 99% 的场景）。
//
// 实现范围（刻意最小）：
//   * A 记录（IPv4）查询；AAAA 未做（见 docs/07-gaps.md §2 DNS 行）
//   * 单 nameserver、单次重试、无 EDNS(0)、无 TCP 回退、无 DNSSEC
//   * 无 search domain / ndots：传入的必须是完整 FQDN
//   * 名字压缩指针只跟一跳（应答 Answer 段的 name 通常是 0xC00C 指回 Question）
//
// 安全：所有长度都按报文里的实际值校验，越界一律返回 0（解析失败），
// 不信任报文里的任何长度字段。

// ---------------------------------------------------------------------------
// 报文构造
// ---------------------------------------------------------------------------

/// dns_build_query(name) -> str：拼一个 A 记录的查询报文（12 字节头 + QNAME
/// + 4 字节 QTYPE/QCLASS）。name 必须是 FQDN（如 "example.com"）。
///
/// 头：id=0x1234 | flags=0x0100（RD） | qd=1 | an=0 | ns=0 | ar=0
/// QNAME 用标签格式：每段前置长度字节，以 0 结尾。
/// 返回空串表示名字非法（空段 / 段长 > 63 / 总长 > 255 / 非法字符）。
pub fn dns_build_query(name: str) -> str {
    let n = len(name)
    if n == 0 || n > 253 {
        return ""
    }
    // 先算 QNAME 长度并校验，再一次性分配
    let mut qn = 1                       // 结尾的 0
    let mut lab = 0
    let mut i = 0
    while i < n {
        let c = name[i]
        if c == 46 {                     // '.'
            if lab == 0 || lab > 63 {    // 空段（连续点 / 开头点）
                return ""
            }
            qn = qn + lab + 1
            lab = 0
        } else {
            lab = lab + 1
            if lab > 63 {
                return ""
            }
        }
        i = i + 1
    }
    if lab == 0 {                        // 结尾是点（"a.b." 也接受，尾点不产生空段）
        // 尾点形态合法：QNAME 已经在循环里收完
    } else {
        qn = qn + lab + 1
    }
    let total = 12 + qn + 4
    let out = mem_alloc(total)
    // ---- 头 ----
    mem_store8(out, 0, 0x12)             // ID 高字节
    mem_store8(out, 1, 0x34)             // ID 低字节
    mem_store8(out, 2, 0x01)             // flags: RD
    mem_store8(out, 3, 0x00)
    mem_store8(out, 4, 0x00)             // QDCOUNT = 1
    mem_store8(out, 5, 0x01)
    mem_store8(out, 6, 0x00)             // ANCOUNT = 0
    mem_store8(out, 7, 0x00)
    mem_store8(out, 8, 0x00)             // NSCOUNT = 0
    mem_store8(out, 9, 0x00)
    mem_store8(out, 10, 0x00)            // ARCOUNT = 0
    mem_store8(out, 11, 0x00)
    // ---- QNAME ----
    let mut p = 12
    lab = 0
    let mut start = 0
    i = 0
    while i < n {
        let c = name[i]
        if c == 46 {
            mem_store8(out, p, lab)
            p = p + 1
            let mut k = 0
            while k < lab {
                mem_store8(out, p + k, name[start + k])
                k = k + 1
            }
            p = p + lab
            start = i + 1
            lab = 0
        } else {
            lab = lab + 1
        }
        i = i + 1
    }
    if lab > 0 {
        mem_store8(out, p, lab)
        p = p + 1
        let mut k = 0
        while k < lab {
            mem_store8(out, p + k, name[start + k])
            k = k + 1
        }
        p = p + lab
    }
    mem_store8(out, p, 0)                // QNAME 结束
    p = p + 1
    // ---- QTYPE = A(1), QCLASS = IN(1) ----
    mem_store8(out, p, 0)
    mem_store8(out, p + 1, 1)
    mem_store8(out, p + 2, 0)
    mem_store8(out, p + 3, 1)
    return mem_str(out, total)
}

// ---------------------------------------------------------------------------
// 应答解析
// ---------------------------------------------------------------------------

/// dns_skip_name(msg, off, len) -> int：跳过 off 处的一个名字（可能是压缩
/// 指针），返回**指针之后**的偏移；越界返回 -1。
///
/// 压缩指针（0xC0 前缀）只跟一跳：目标偏移处若仍是名字（非指针），本函数
/// 不追进去，直接返回。对 A 记录解析这足够——我们要的是 Answer 段里的
/// RDATA，而 Answer 的 name 通常就是 0xC00C 指回 Question。
fn dns_skip_name(msg: str, off: int, len: int) -> int {
    let mut p = off
    let mut guard = 0
    while p < len && guard < 128 {
        let c = msg[p]
        if c == 0 {
            return p + 1
        }
        if c >= 192 {                    // 0xC0：压缩指针，占 2 字节，名字结束
            if p + 1 >= len {
                return 0 - 1
            }
            return p + 2
        }
        p = p + c + 1                    // 跳过这个标签
        guard = guard + 1
    }
    return 0 - 1
}

/// dns_parse_a(msg) -> int：从应答里取出**第一条 A 记录**的 IPv4 地址，
/// 返回网络序 u32（与 udp_parse_ip 同口径）；没有 A 记录 / 报文非法返回 0。
///
/// 校验：ID 必须回显 0x1234、QR 必须为 1（应答）、RCODE 必须为 0（NOERROR）、
/// ANCOUNT > 0。任何长度越界都返回 0，不信任报文里的长度字段。
pub fn dns_parse_a(msg: str) -> int {
    let len = len(msg)
    if len < 12 {
        return 0
    }
    if msg[0] != 0x12 || msg[1] != 0x34 {
        return 0                       // ID 不匹配：不是我们的应答
    }
    if (msg[2] & 0x80) == 0 {
        return 0                       // QR = 0：这是查询不是应答
    }
    if (msg[3] & 0x0F) != 0 {
        return 0                       // RCODE != NOERROR
    }
    let qd = (msg[4] << 8) | msg[5]
    let an = (msg[6] << 8) | msg[7]
    if an == 0 {
        return 0
    }
    // 跳过 Question 段
    let mut p = 12
    let mut qi = 0
    while qi < qd {
        p = dns_skip_name(msg, p, len)
        if p < 0 || p + 4 > len {
            return 0
        }
        p = p + 4                      // QTYPE + QCLASS
        qi = qi + 1
    }
    // 扫 Answer 段，找 TYPE=1(CLASS=IN) 且 RDLENGTH=4 的记录
    let mut ai = 0
    while ai < an {
        p = dns_skip_name(msg, p, len)
        if p < 0 || p + 10 > len {
            return 0
        }
        let rtype = (msg[p] << 8) | msg[p + 1]
        let rclass = (msg[p + 2] << 8) | msg[p + 3]
        let rdlen = (msg[p + 8] << 8) | msg[p + 9]
        let rd = p + 10
        if rtype == 1 && rclass == 1 && rdlen == 4 {
            if rd + 4 > len {
                return 0
            }
            // RDATA 是 4 字节网络序 -> 与 udp_parse_ip 同口径（a | b<<8 | ...）
            let a0 = msg[rd]
            let a1 = msg[rd + 1]
            let a2 = msg[rd + 2]
            let a3 = msg[rd + 3]
            return a0 | (a1 << 8) | (a2 << 16) | (a3 << 24)
        }
        if rd + rdlen > len {
            return 0
        }
        p = rd + rdlen
        ai = ai + 1
    }
    return 0
}

/// dns_ip4_str(ip) -> str：网络序 u32 -> 点分字符串（A 记录的可读形式）。
pub fn dns_ip4_str(ip: int) -> str {
    let a = ip & 0xFF
    let b = (ip >> 8) & 0xFF
    let c = (ip >> 16) & 0xFF
    let d = (ip >> 24) & 0xFF
    return a.to_str() + "." + b.to_str() + "." + c.to_str() + "." + d.to_str()
}

// ---------------------------------------------------------------------------
// /etc/resolv.conf
// ---------------------------------------------------------------------------

/// dns_resolv_ns(text) -> str：从 resolv.conf 的**内容**里取出第一个
/// `nameserver` 的 IPv4 地址；没有则返回空串。
///
/// 做成"吃文本"而不是"自己读文件"，是为了能在测试里喂固定夹具
/// （文件读取在 ELF 后端要走 openat+read，属于调用方的事）。
pub fn dns_resolv_ns(text: str) -> str {
    let n = len(text)
    let mut i = 0
    while i < n {
        // 跳过行首空白
        while i < n && (text[i] == 32 || text[i] == 9) {
            i = i + 1
        }
        // 注释行 / 空行
        if i >= n {
            break
        }
        if text[i] == 35 {                 // '#'
            while i < n && text[i] != 10 {
                i = i + 1
            }
            i = i + 1
            continue
        }
        // 是否以 "nameserver" 开头
        if i + 10 <= n && text[i] == 110 && text[i + 1] == 97 && text[i + 2] == 109
            && text[i + 3] == 101 && text[i + 4] == 115 && text[i + 5] == 101
            && text[i + 6] == 114 && text[i + 7] == 118 && text[i + 8] == 101
            && text[i + 9] == 114 {
            i = i + 10
            while i < n && (text[i] == 32 || text[i] == 9) {
                i = i + 1
            }
            let s = i
            while i < n && text[i] != 10 && text[i] != 32 && text[i] != 9
                && text[i] != 35 {
                i = i + 1
            }
            if i > s {
                return substr(text, s, i - s)
            }
        }
        // 跳到下一行
        while i < n && text[i] != 10 {
            i = i + 1
        }
        i = i + 1
    }
    return ""
}

// ---------------------------------------------------------------------------
// 端到端：读 resolv.conf + UDP 查询
/// dns_resolve(name) -> str：把域名解析成点分 IPv4 字符串；失败返回空串。
///
/// 这是调用方真正要用的入口。流程：
///   1. 先当 IPv4 字面量试（"1.2.3.4" 直接返回，不查网）；
///   2. 读 /etc/resolv.conf 取**全部** nameserver（没有则用 8.8.8.8 兜底）；
///   3. 依次向每个 nameserver 发 A 查询（每个 3 s 超时），第一个成功的胜出。
///
/// 失败一律返回空串（不 exit）——DNS 不可用是可恢复错误，调用方可以选择
/// 回退到字面量或报自己的错。这与库里"能返回就返回、不能返回才 fail-fast"
/// 的口径一致。
///
/// 需要自定义超时用 `dns_resolve_ex(name, ms_per_ns)`。
pub fn dns_resolve(name: str) -> str {
    return dns_resolve_ex(name, 3000)
}
// ---------------------------------------------------------------------------
// 多 nameserver 轮询（v3.05）
// ---------------------------------------------------------------------------

/// dns_resolv_all(text) -> vec[str]：从 resolv.conf 内容里取出**全部**
/// `nameserver` 地址（按出现顺序）。没有则返回空 vec。
///
/// 与 `dns_resolv_ns` 的关系：后者只取第一个（保留给"只要一个"的调用方），
/// 前者给轮询用。两者共用同一套行扫描规则（注释 / 空白 / 行尾注释）。
pub fn dns_resolv_all(text: str) -> vec[str] {
    let out = vec[str].new(4)
    let n = len(text)
    let mut i = 0
    while i < n {
        while i < n && (text[i] == 32 || text[i] == 9) {
            i = i + 1
        }
        if i >= n {
            break
        }
        if text[i] == 35 {
            while i < n && text[i] != 10 {
                i = i + 1
            }
            i = i + 1
            continue
        }
        if i + 10 <= n && text[i] == 110 && text[i + 1] == 97 && text[i + 2] == 109
            && text[i + 3] == 101 && text[i + 4] == 115 && text[i + 5] == 101
            && text[i + 6] == 114 && text[i + 7] == 118 && text[i + 8] == 101
            && text[i + 9] == 114 {
            i = i + 10
            while i < n && (text[i] == 32 || text[i] == 9) {
                i = i + 1
            }
            let s = i
            while i < n && text[i] != 10 && text[i] != 32 && text[i] != 9
                && text[i] != 35 {
                i = i + 1
            }
            if i > s {
                out.push(substr(text, s, i - s))
            }
        }
        while i < n && text[i] != 10 {
            i = i + 1
        }
        i = i + 1
    }
    return out
}

/// dns_query_ns(ns, q, ms) -> int：向**一个** nameserver 发查询并解析，
/// 返回网络序 u32；超时/失败返回 0。
///
/// 每次调用都新开一个 socket 并在结束时关闭：DNS 查询是低频操作，
/// 复用 fd 省下的那点开销抵不上"超时设置会串到下一次查询"的风险。
pub fn dns_query_ns(ns: str, q: str, ms: int) -> int {
    let fd = udp_open()
    if fd < 0 {
        return 0
    }
    let sent = udp_send_str(fd, ns, 53, q)
    if sent <= 0 {
        return 0
    }
    let resp = udp_recvfrom_to(fd, 2048, ms)
    if len(resp) < 12 {
        return 0
    }
    return dns_parse_a(resp)
}

/// dns_resolve_ex(name, ms_per_ns) -> str：多 nameserver 轮询版解析。
///
/// 依次向 resolv.conf 里的每个 nameserver 发同一个查询，**第一个成功的胜出**；
/// 全部失败返回空串。`ms_per_ns` 是**每个** nameserver 的超时（不是总预算）——
/// 这样 3 个 nameserver 各 1 s 的最坏情况是 3 s，而不是把 1 s 摊给三个
/// （摊薄会让每个都必然超时，等于没轮询）。
///
/// 为什么要轮询：resolv.conf 里第一个 nameserver 常常是本地 stub
/// （127.0.0.53 / 127.0.0.1），它自己再往上游转发；stub 挂了或没起来时，
/// 只认第一个就等于整个解析不可用。轮询是 glibc 的默认行为，这里对齐它。
pub fn dns_resolve_ex(name: str, ms_per_ns: int) -> str {
    let lit = udp_parse_ip(name)
    if lit != 0 {
        return name
    }
    if len(name) == 0 {
        return ""
    }
    let q = dns_build_query(name)
    if len(q) == 0 {
        return ""
    }
    let nss = dns_resolv_all(read_text("/etc/resolv.conf"))
    if len(nss) == 0 {
        nss.push("8.8.8.8")
    }
    let mut k = 0
    while k < len(nss) {
        let ip = dns_query_ns(nss.get(k), q, ms_per_ns)
        if ip != 0 {
            return dns_ip4_str(ip)
        }
        k = k + 1
    }
    return ""
}
