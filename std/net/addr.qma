// std/net/addr.qma —— 地址文本层（v2.07，IPv6 全链路的库侧一半）
//
// 为什么单独一层：内核/运行库只认字节（sockaddr_in 4B 地址、sockaddr_in6 16B
// 地址），而日志、路由、配置、URL 里要的是文本。把"字节 <-> 文本"放在库层，
// 发射器里就不必写 8 组十六进制 + "::" 压缩的汇编，运行时体积不涨。
//
// 分工：
//   * 家族判定与解析（文本 -> 字节）：ip_family / ip6_parse / a_v4_val
//   * 格式化（字节 -> 文本）：ip4_format / ip6_format / addr_text
//   * 对端地址（fd -> 文本）：peer_ip / peer_port（走 tcp_peer_raw 内建）
//
// 语义边界（写进文档，别指望它做更多）：
//   * 只认**字面量**，不做 DNS（域名一律 ip_family == 0，解析交给 tcp_connect）；
//   * IPv6 文本按 RFC 5952 输出：小写、无前导零、最长一段连续 0 压成 "::"
//     （长度 >= 2 才压，多段等长取最左）；
//   * IPv4 映射地址（::ffff:a.b.c.d）在 addr_text 里还原成点分四段——
//     双栈 socket 上 v4 客户端看到的就是这个形态，日志里没人想看 ::ffff:；
//   * 不处理 zone id（%eth0）、不做 IPv4 兼容地址（::a.b.c.d）的归一。
import std.str

// ---------------------------------------------------------------------------
// 内部：十六进制 / 点分四段
// ---------------------------------------------------------------------------

fn a_hexval(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0 - 1
}

fn a_hexchar(v: int) -> int {
    if v < 10 { return 48 + v }
    return 87 + v
}

// 点分四段 [lo, hi) -> 32 位值（a<<24 | b<<16 | c<<8 | d）；非法 -1。
// 严格口径：必须恰好 4 段、每段 1-3 位数字、值 <= 255。
fn a_v4_val(s: str, lo: int, hi: int) -> int {
    let mut v = 0
    let mut cur = 0
    let mut oct = 0
    let mut digits = 0
    let mut i = lo
    while i < hi {
        let c = s[i]
        if c == 46 {
            if digits == 0 { return 0 - 1 }
            if digits > 3 { return 0 - 1 }
            if cur > 255 { return 0 - 1 }
            v = (v << 8) | cur
            oct = oct + 1
            cur = 0
            digits = 0
        } else {
            if c < 48 || c > 57 { return 0 - 1 }
            cur = cur * 10 + (c - 48)
            digits = digits + 1
        }
        i = i + 1
    }
    if digits == 0 { return 0 - 1 }
    if digits > 3 { return 0 - 1 }
    if cur > 255 { return 0 - 1 }
    v = (v << 8) | cur
    oct = oct + 1
    if oct != 4 { return 0 - 1 }
    return v
}

// 冒号分隔的一组 16 位段 [lo, hi)，追加到 out，返回段数；非法 -1。
// allow_v4 = 1 时允许最后一项写成点分四段（::ffff:127.0.0.1 的写法）。
fn a_groups(s: str, lo: int, hi: int, allow_v4: int, out: vec[int]) -> int {
    if lo >= hi { return 0 }
    let mut cnt = 0
    let mut start = lo
    let mut i = lo
    while i <= hi {
        let mut sep = 0
        if i == hi {
            sep = 1
        } else {
            if s[i] == 58 { sep = 1 }
        }
        if sep == 1 {
            let gl = i - start
            if gl == 0 { return 0 - 1 }
            let dot = str_find_from(s, start, ".")
            if dot >= 0 && dot < i {
                // 点分四段只允许作为整串最后一项
                if i != hi || allow_v4 == 0 { return 0 - 1 }
                let q = a_v4_val(s, start, i)
                if q < 0 { return 0 - 1 }
                out.push((q >> 16) & 65535)
                out.push(q & 65535)
                cnt = cnt + 2
            } else {
                if gl > 4 { return 0 - 1 }
                let mut v = 0
                let mut k = start
                while k < i {
                    let h = a_hexval(s[k])
                    if h < 0 { return 0 - 1 }
                    v = v * 16 + h
                    k = k + 1
                }
                out.push(v)
                cnt = cnt + 1
            }
            start = i + 1
        }
        i = i + 1
    }
    return cnt
}

// ---------------------------------------------------------------------------
// 文本 -> 字节
// ---------------------------------------------------------------------------

/// ip_family(s) -> int：字面量家族判定。4 = 点分 IPv4，6 = IPv6，0 = 不是字面量。
/// 只看字面量不做解析：域名（含 "localhost"）一律 0，那是 tcp_connect 的活。
pub fn ip_family(s: str) -> int {
    let n = len(s)
    if n == 0 { return 0 }
    if str_find(s, ":") >= 0 {
        if len(ip6_parse(s)) == 16 { return 6 }
        return 0
    }
    if a_v4_val(s, 0, n) < 0 { return 0 }
    return 4
}

/// ip6_parse(s) -> str：IPv6 字面量 -> 16 字节网络序原始串；非法返回空串。
/// 支持 "::" 压缩（最多一处）与末尾点分四段（::ffff:1.2.3.4）。
pub fn ip6_parse(s: str) -> str {
    let n = len(s)
    if n < 2 { return "" }
    if str_find(s, ":") < 0 { return "" }
    // 定位 "::"（出现两处即非法）
    let mut dbl = 0 - 1
    let mut i = 0
    while i < n {
        if s[i] == 58 && i + 1 < n && s[i + 1] == 58 {
            if dbl >= 0 { return "" }
            dbl = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    let left = vec[int].new(10)
    let right = vec[int].new(10)
    let mut cl = 0
    let mut cr = 0
    if dbl < 0 {
        cl = a_groups(s, 0, n, 1, left)
        if cl != 8 { return "" }
    } else {
        cl = a_groups(s, 0, dbl, 0, left)
        if cl < 0 { return "" }
        cr = a_groups(s, dbl + 2, n, 1, right)
        if cr < 0 { return "" }
        // "::" 至少顶掉一组，否则就是 8 组写全的地址不该用 "::"
        if cl + cr > 7 { return "" }
    }
    let all = vec[int].new(8)
    let mut k = 0
    while k < cl {
        all.push(left.get(k))
        k = k + 1
    }
    let mut z = 8 - cl - cr
    while z > 0 {
        all.push(0)
        z = z - 1
    }
    k = 0
    while k < cr {
        all.push(right.get(k))
        k = k + 1
    }
    let out = vec[int].new(16)
    k = 0
    while k < 8 {
        out.push((all.get(k) >> 8) & 255)
        out.push(all.get(k) & 255)
        k = k + 1
    }
    return str_from_bytes(out)
}

/// strip_brackets(host) -> str：URL 的 IPv6 host 是 "[::1]" 形态，去掉方括号；
/// 没有方括号原样返回（IPv4 / 域名不受影响）。
pub fn strip_brackets(host: str) -> str {
    let n = len(host)
    if n >= 2 && host[0] == 91 && host[n - 1] == 93 {
        return str_slice(host, 1, n - 1)
    }
    return host
}

// ---------------------------------------------------------------------------
// 字节 -> 文本
// ---------------------------------------------------------------------------

/// ip4_format(b) -> str：4 字节网络序 -> 点分四段。
pub fn ip4_format(b: str) -> str {
    if len(b) < 4 { return "" }
    return b[0].to_str() + "." + b[1].to_str() + "."
        + b[2].to_str() + "." + b[3].to_str()
}

/// ip6_format(b) -> str：16 字节网络序 -> RFC 5952 文本
/// （小写、无前导零、最长连续 0 段压成 "::"，等长取最左）。
pub fn ip6_format(b: str) -> str {
    if len(b) != 16 { return "" }
    let g = vec[int].new(8)
    let mut i = 0
    while i < 16 {
        g.push(b[i] * 256 + b[i + 1])
        i = i + 2
    }
    // 最长连续 0 段（长度 >= 2 才压）
    let mut best_s = 0 - 1
    let mut best_l = 0
    i = 0
    while i < 8 {
        if g.get(i) == 0 {
            let mut j = i
            while j < 8 && g.get(j) == 0 {
                j = j + 1
            }
            let l = j - i
            if l >= 2 && l > best_l {
                best_s = i
                best_l = l
            }
            i = j
        } else {
            i = i + 1
        }
    }
    let out = vec[int].new(48)
    let mut need = 0
    i = 0
    while i < 8 {
        if i == best_s {
            out.push(58)
            out.push(58)
            need = 0
            i = i + best_l
        } else {
            if need == 1 { out.push(58) }
            let v = g.get(i)
            if v == 0 {
                out.push(48)
            } else {
                let mut sh = 12
                let mut started = 0
                while sh >= 0 {
                    let d = (v >> sh) & 15
                    if d != 0 { started = 1 }
                    if started == 1 { out.push(a_hexchar(d)) }
                    sh = sh - 4
                }
            }
            need = 1
            i = i + 1
        }
    }
    return str_from_bytes(out)
}

// ---------------------------------------------------------------------------
// 对端地址（tcp_peer_raw 的 20 字节视图解码）
//   布局：[0..1] 端口网络序 | [2] family（2/23/0）| [3] 0 | [4..19] 地址
// ---------------------------------------------------------------------------

/// addr_family(raw) -> int：2 = IPv4，23 = IPv6，0 = 未知（fd 已关闭）。
pub fn addr_family(raw: str) -> int {
    if len(raw) < 20 { return 0 }
    return raw[2]
}

/// addr_port(raw) -> int：对端端口（主机序）；raw 不合法返回 -1。
pub fn addr_port(raw: str) -> int {
    if len(raw) < 20 { return 0 - 1 }
    return raw[0] * 256 + raw[1]
}

/// addr_text(raw) -> str：对端地址文本。IPv6 里 ::ffff:a.b.c.d（双栈 socket
/// 上 IPv4 客户端的形态）还原成点分四段，其余走 ip6_format。
pub fn addr_text(raw: str) -> str {
    if len(raw) < 20 { return "" }
    let fam = raw[2]
    if fam == 23 {
        let mut zero = 1
        let mut i = 4
        while i < 14 {
            if raw[i] != 0 { zero = 0 }
            i = i + 1
        }
        if zero == 1 && raw[14] == 255 && raw[15] == 255 {
            return ip4_format(str_slice(raw, 16, 20))
        }
        return ip6_format(str_slice(raw, 4, 20))
    }
    if fam == 2 {
        return ip4_format(str_slice(raw, 4, 8))
    }
    return ""
}

/// peer_raw(fd) -> str：对端地址的 20 字节原始视图（见本文件末尾布局说明）。
pub fn peer_raw(fd: int) -> str {
    return tcp_peer_raw(fd)
}

/// peer_ip(fd) -> str：对端 IP 文本（IPv4 点分 / IPv6 压缩格式）。
pub fn peer_ip(fd: int) -> str {
    return addr_text(tcp_peer_raw(fd))
}

/// peer_port(fd) -> int：对端端口（主机序）。
pub fn peer_port(fd: int) -> int {
    return addr_port(tcp_peer_raw(fd))
}
