// std/fs.qma —— 文件读写（Windows PE，v1.101）
//
// 为什么需要这个模块：语言内建只有 `file_exists` / `file_size` / `fs_mkdir` /
// `fs_remove` 这类**元数据**操作，没有"打开—读—写—刷盘"这条链路。于是任何
// 要落盘的东西（KV / 日志 / 配置 / 缓存）都写不了——这正是 `07-gaps.md` §2
// 「持久化」那一行的根因。
//
// 实现走 `@ffi`（v1.87）直调 kernel32，所以本模块**只能编译到 Windows PE**：
// `--target native/arm64` 会在编译期报 "@ffi 只支持 Windows"，与
// `std/httpc_net` / `std/tls_net` 同一口径（显式失败，不是静默降级）。
//
// 约定（写代码时别猜）：
//   * 句柄就是 Win32 HANDLE 的整数值；**-1 = 失败**（INVALID_HANDLE_VALUE）。
//   * 所有函数不抛异常、不退出进程：失败返回 -1（读返回空串）。
//   * str 的值是指向**数据**的指针，长度另有 8 字节前缀，所以传裸缓冲区时用
//     `mem_ptr(s, 0)`（去掉 str 标记的纯 int），长度用 `len(s)`；
//     Win32 需要 NUL 结尾时用 `cstr(s)`（另分配一块）。
//   * `cstr` 分配的块不回收：它返回的是块内数据指针，`mem_free` 要的是块首地址。
//     每个 `fs_open`/`fs_rename` 泄漏 len(path) 量级字节——打开是低频操作，
//     刻意不为它引入一条"记录块首地址"的簿记路径。

const _GEN_READ = -2147483648        // 0x80000000 GENERIC_READ
const _GEN_WRITE = 1073741824        // 0x40000000 GENERIC_WRITE
const _OPEN_EXISTING = 3
const _CREATE_ALWAYS = 2
const _OPEN_ALWAYS = 4
const _ATTR_NORMAL = 128
const _MOVEFILE_REPLACE = 1

@ffi("kernel32.dll", "CreateFileA")
fn _CreateFileA(name: int, access: int, share: int, sec: int, disp: int,
                flags: int, tmpl: int) -> int

@ffi("kernel32.dll", "ReadFile")
fn _ReadFile(h: int, buf: int, n: int, got: int, ov: int) -> bool

@ffi("kernel32.dll", "WriteFile")
fn _WriteFile(h: int, buf: int, n: int, wrote: int, ov: int) -> bool

@ffi("kernel32.dll", "SetFilePointerEx")
fn _SetFilePointerEx(h: int, dist: int, out: int, method: int) -> bool

@ffi("kernel32.dll", "GetFileSizeEx")
fn _GetFileSizeEx(h: int, out: int) -> bool

@ffi("kernel32.dll", "FlushFileBuffers")
fn _FlushFileBuffers(h: int) -> bool

@ffi("kernel32.dll", "CloseHandle")
fn _CloseHandle(h: int) -> bool

@ffi("kernel32.dll", "MoveFileExA")
fn _MoveFileExA(from: int, to: int, flags: int) -> bool

// ---------------------------------------------------------------------------
// 打开 / 关闭
// ---------------------------------------------------------------------------

/// 打开文件，返回句柄；失败返回 -1。
/// `mode`：`"r"` 只读（必须存在）/ `"w"` 读写并截断 / `"a"` 读写并定位到末尾
/// （不存在则新建）。
pub fn fs_open(path: str, mode: str) -> int {
    return _open_share(path, mode, 0)
}

/// 与 `fs_open` 同形，但**允许别人同时读**（`FILE_SHARE_READ|FILE_SHARE_WRITE`）。
/// 给"边写边 tail"的场景用（`std/logfile` 就是它）：独占打开的日志文件
/// 没法被 `tail -f` 或另一个进程读到刚写进去的内容。
/// 代价是并发写不设防——两个进程往同一个文件写会交错，要独占安全就用 `fs_open`。
pub fn fs_open_shared(path: str, mode: str) -> int {
    return _open_share(path, mode, 3)
}

fn _open_share(path: str, mode: str, share: int) -> int {
    let mut access = _GEN_READ
    let mut disp = _OPEN_EXISTING
    let mut at_end = 0
    if mode == "w" {
        access = _GEN_READ + _GEN_WRITE
        disp = _CREATE_ALWAYS
    } else if mode == "a" {
        access = _GEN_READ + _GEN_WRITE
        disp = _OPEN_ALWAYS
        at_end = 1
    }
    let h = _CreateFileA(cstr(path), access, share, 0, disp, _ATTR_NORMAL, 0)
    if h == -1 {
        return -1
    }
    if at_end == 1 {
        fs_seek(h, fs_size(h))
    }
    return h
}

/// 关闭句柄：0 成功 / -1 失败。
pub fn fs_close(h: int) -> int {
    if h == -1 {
        return -1
    }
    let ok = _CloseHandle(h)
    if ok {
        return 0
    }
    return -1
}

// ---------------------------------------------------------------------------
// 读 / 写 / 定位
// ---------------------------------------------------------------------------

/// 从当前偏移读最多 `n` 字节，返回读到的内容。
/// EOF 或出错都返回空串（长度就是判断依据，没有单独的 errno）。
pub fn fs_read(h: int, n: int) -> str {
    if h == -1 || n <= 0 {
        return ""
    }
    let buf = mem_alloc(n)
    let got = mem_alloc(8)
    let ok = _ReadFile(h, buf, n, got, 0)
    let cnt = mem_load32(got, 0)
    let mut out = ""
    if ok && cnt > 0 {
        out = mem_str(buf, cnt)
    }
    mem_free(buf, n)
    mem_free(got, 8)
    return out
}

/// 从当前偏移写入整个字符串，返回写入字节数；失败返回 -1。
pub fn fs_write(h: int, data: str) -> int {
    if h == -1 {
        return -1
    }
    let n = len(data)
    if n == 0 {
        return 0
    }
    let got = mem_alloc(8)
    let ok = _WriteFile(h, mem_ptr(data, 0), n, got, 0)
    let cnt = mem_load32(got, 0)
    mem_free(got, 8)
    if !ok {
        return -1
    }
    return cnt
}

/// 定位到绝对偏移（从文件头算），返回 0 成功 / -1 失败。
pub fn fs_seek(h: int, off: int) -> int {
    if h == -1 {
        return -1
    }
    if _SetFilePointerEx(h, off, 0, 0) {
        return 0
    }
    return -1
}

/// 文件当前大小（字节）；失败返回 -1。
pub fn fs_size(h: int) -> int {
    if h == -1 {
        return -1
    }
    let out = mem_alloc(8)
    let ok = _GetFileSizeEx(h, out)
    let n = mem_load64(out, 0)
    mem_free(out, 8)
    if !ok {
        return -1
    }
    return n
}

/// 把内核缓冲刷到磁盘（FlushFileBuffers）：0 成功 / -1 失败。
/// 只对**可写**句柄有意义——只读句柄上 Win32 会拒绝（返回 -1）。
/// 不调用它时，进程崩溃数据仍在（WriteFile 已进内核），**掉电才会丢**。
pub fn fs_sync(h: int) -> int {
    if h == -1 {
        return -1
    }
    if _FlushFileBuffers(h) {
        return 0
    }
    return -1
}

/// 改名/覆盖目标文件（MoveFileEx + REPLACE_EXISTING）：0 成功 / -1 失败。
pub fn fs_rename(from: str, to: str) -> int {
    if _MoveFileExA(cstr(from), cstr(to), _MOVEFILE_REPLACE) {
        return 0
    }
    return -1
}

// ---------------------------------------------------------------------------
// 一次性便捷函数
// ---------------------------------------------------------------------------

/// 整文件读入内存；文件不存在或读失败返回空串。
pub fn fs_read_all(path: str) -> str {
    let h = fs_open(path, "r")
    if h == -1 {
        return ""
    }
    let n = fs_size(h)
    let mut out = ""
    if n > 0 {
        out = fs_read(h, n)
    }
    fs_close(h)
    return out
}

/// 整文件覆盖写（截断后写入），0 成功 / -1 失败。
pub fn fs_write_all(path: str, data: str) -> int {
    let h = fs_open(path, "w")
    if h == -1 {
        return -1
    }
    let n = fs_write(h, data)
    fs_close(h)
    if n < 0 {
        return -1
    }
    return 0
}
