// std/gen.qma —— 泛型算法库（v1.36）
//
// 为什么需要它：min/max/clamp/contains 这类算法在每种标量上都要写一遍，
// 过去要么复制粘贴要么退化成 int 专用。用户泛型（v1.11）+ 多类型参数与
// 调用点推导（v1.36）之后，一套模板按实参类型单态化，零运行时分发。
//
// 语义纪律：
//   * 单态化产物是普通函数（gen_min__int / gen_min__float ...），
//     调用点写 gen_min(a, b) 即可，类型由实参推导；推不出会编译期报错
//     并提示显式实例化 gen_min[int](a, b)；
//   * gen_min/gen_max/gen_clamp/gen_dist 要求 T 支持 < 比较（数值类型）；
//     str 实例化会在降级期报错（str 暂无序）；
//   * gen_contains/gen_index_of 要求 T 支持 == 比较；
//   * gen_first/gen_last 要求 vec 非空（空 vec 行为未定义，调用方保证）；
//   * gen_reverse 原地交换，不分配。
//
// 边界（07-gaps §1）：无类型约束声明（trait bound），上述"要求"是文档性
// 的——违反它在编译期以 Lower 类型错误的形式出现，不是静默错。

fn gen_min[T](a: T, b: T) -> T {
    if a < b {
        return a
    }
    return b
}

fn gen_max[T](a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

fn gen_clamp[T](v: T, lo: T, hi: T) -> T {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// |a - b|：数值型通用（int / float）
fn gen_dist[T](a: T, b: T) -> T {
    if a < b {
        return b - a
    }
    return a - b
}

// vec[T] 算法族：T 从 vec 元素类型一元化推出
fn gen_first[T](xs: vec[T]) -> T {
    return xs.get(0)
}

fn gen_last[T](xs: vec[T]) -> T {
    return xs.get(len(xs) - 1)
}

fn gen_contains[T](xs: vec[T], v: T) -> bool {
    let mut i = 0
    while i < len(xs) {
        if xs.get(i) == v {
            return true
        }
        i = i + 1
    }
    return false
}

fn gen_index_of[T](xs: vec[T], v: T) -> int {
    let mut i = 0
    while i < len(xs) {
        if xs.get(i) == v {
            return i
        }
        i = i + 1
    }
    return -1
}

// 原地反转：两端向中间交换（vec.set 写入）
fn gen_reverse[T](xs: vec[T]) {
    let mut i = 0
    let mut j = len(xs) - 1
    while i < j {
        let t = xs.get(i)
        xs.set(i, xs.get(j))
        xs.set(j, t)
        i = i + 1
        j = j - 1
    }
}
