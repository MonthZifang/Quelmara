// std/sha256.qma —— SHA-256 + HMAC-SHA256（FIPS 180-4 / RFC 2104），Quelmara 自实现
//
// 为什么需要它：TLS 1.2/1.3 的 PRF、HTTP ETag、接口签名、JWT(HS256) 都靠它。
// 这是 docs/TLS.md Phase A 的第一块地基，也可独立使用。
//
// 实现要点（与 std/sha1.qma 同一套纪律）：
//   * int 是 64 位，所有 32 位运算后必须 & 0xFFFFFFFF 截断，否则高位串位；
//   * 右移用 >>（值恒为非负，等价逻辑右移），循环右移 = (x>>n | x<<(32-n)) 截断；
//   * 消息调度表 64 字、填充缓冲、状态区全部堆上分配，返回前归还（高频路径不泄漏）；
//   * 摘要缓冲区含 0 字节，不能当 str 用——要字符串走 *_hex。

// 64 个轮常量（前 32 位小数部分）
const K0  = 0x428A2F98
const K1  = 0x71374491
const K2  = 0xB5C0FBCF
const K3  = 0xE9B5DBA5
const K4  = 0x3956C25B
const K5  = 0x59F111F1
const K6  = 0x923F82A4
const K7  = 0xAB1C5ED5
const K8  = 0xD807AA98
const K9  = 0x12835B01
const K10 = 0x243185BE
const K11 = 0x550C7DC3
const K12 = 0x72BE5D74
const K13 = 0x80DEB1FE
const K14 = 0x9BDC06A7
const K15 = 0xC19BF174
const K16 = 0xE49B69C1
const K17 = 0xEFBE4786
const K18 = 0x0FC19DC6
const K19 = 0x240CA1CC
const K20 = 0x2DE92C6F
const K21 = 0x4A7484AA
const K22 = 0x5CB0A9DC
const K23 = 0x76F988DA
const K24 = 0x983E5152
const K25 = 0xA831C66D
const K26 = 0xB00327C8
const K27 = 0xBF597FC7
const K28 = 0xC6E00BF3
const K29 = 0xD5A79147
const K30 = 0x06CA6351
const K31 = 0x14292967
const K32 = 0x27B70A85
const K33 = 0x2E1B2138
const K34 = 0x4D2C6DFC
const K35 = 0x53380D13
const K36 = 0x650A7354
const K37 = 0x766A0ABB
const K38 = 0x81C2C92E
const K39 = 0x92722C85
const K40 = 0xA2BFE8A1
const K41 = 0xA81A664B
const K42 = 0xC24B8B70
const K43 = 0xC76C51A3
const K44 = 0xD192E819
const K45 = 0xD6990624
const K46 = 0xF40E3585
const K47 = 0x106AA070
const K48 = 0x19A4C116
const K49 = 0x1E376C08
const K50 = 0x2748774C
const K51 = 0x34B0BCB5
const K52 = 0x391C0CB3
const K53 = 0x4ED8AA4A
const K54 = 0x5B9CCA4F
const K55 = 0x682E6FF3
const K56 = 0x748F82EE
const K57 = 0x78A5636F
const K58 = 0x84C87814
const K59 = 0x8CC70208
const K60 = 0x90BEFFFA
const K61 = 0xA4506CEB
const K62 = 0xBEF9A3F7
const K63 = 0xC67178F2

fn sha256_rotr(x: int, n: int) -> int {
    let hi = (x >> n) & 0xFFFFFFFF
    let lo = (x << (32 - n)) & 0xFFFFFFFF
    return (hi | lo) & 0xFFFFFFFF
}

// 读 16 个大端字，并扩展到 64 字调度表
fn sha256_load_block(block: int, w: int) -> int {
    let mut i = 0
    while i < 16 {
        let b0 = mem_load8(block, i * 4)
        let b1 = mem_load8(block, i * 4 + 1)
        let b2 = mem_load8(block, i * 4 + 2)
        let b3 = mem_load8(block, i * 4 + 3)
        mem_store64(w, i, ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xFFFFFFFF)
        i = i + 1
    }
    let mut j = 16
    while j < 64 {
        let x = mem_load64(w, j - 15)
        let y = mem_load64(w, j - 2)
        // v1.34：同样内联成常量位移（原来每轮 4 次调用）
        // s0 = rotr(x,7) ^ rotr(x,18) ^ (x >> 3)
        let s0 = (((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)) & 0xFFFFFFFF
        // s1 = rotr(y,17) ^ rotr(y,19) ^ (y >> 10)
        let s1 = (((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10)) & 0xFFFFFFFF
        let v = (mem_load64(w, j - 16) + s0 + mem_load64(w, j - 7) + s1) & 0xFFFFFFFF
        mem_store64(w, j, v)
        j = j + 1
    }
    return 0
}

// v1.34：把 64 个 K 常量摊到内存表里。每次哈希建一次，之后每轮一次
// mem_load64，替代 sha256_k(i) 的"调用 + 6 层判定树"（每块 64 次）。
fn _sha256_ktab(t: int) -> int {
    mem_store64(t, 0, K0)
    mem_store64(t, 1, K1)
    mem_store64(t, 2, K2)
    mem_store64(t, 3, K3)
    mem_store64(t, 4, K4)
    mem_store64(t, 5, K5)
    mem_store64(t, 6, K6)
    mem_store64(t, 7, K7)
    mem_store64(t, 8, K8)
    mem_store64(t, 9, K9)
    mem_store64(t, 10, K10)
    mem_store64(t, 11, K11)
    mem_store64(t, 12, K12)
    mem_store64(t, 13, K13)
    mem_store64(t, 14, K14)
    mem_store64(t, 15, K15)
    mem_store64(t, 16, K16)
    mem_store64(t, 17, K17)
    mem_store64(t, 18, K18)
    mem_store64(t, 19, K19)
    mem_store64(t, 20, K20)
    mem_store64(t, 21, K21)
    mem_store64(t, 22, K22)
    mem_store64(t, 23, K23)
    mem_store64(t, 24, K24)
    mem_store64(t, 25, K25)
    mem_store64(t, 26, K26)
    mem_store64(t, 27, K27)
    mem_store64(t, 28, K28)
    mem_store64(t, 29, K29)
    mem_store64(t, 30, K30)
    mem_store64(t, 31, K31)
    mem_store64(t, 32, K32)
    mem_store64(t, 33, K33)
    mem_store64(t, 34, K34)
    mem_store64(t, 35, K35)
    mem_store64(t, 36, K36)
    mem_store64(t, 37, K37)
    mem_store64(t, 38, K38)
    mem_store64(t, 39, K39)
    mem_store64(t, 40, K40)
    mem_store64(t, 41, K41)
    mem_store64(t, 42, K42)
    mem_store64(t, 43, K43)
    mem_store64(t, 44, K44)
    mem_store64(t, 45, K45)
    mem_store64(t, 46, K46)
    mem_store64(t, 47, K47)
    mem_store64(t, 48, K48)
    mem_store64(t, 49, K49)
    mem_store64(t, 50, K50)
    mem_store64(t, 51, K51)
    mem_store64(t, 52, K52)
    mem_store64(t, 53, K53)
    mem_store64(t, 54, K54)
    mem_store64(t, 55, K55)
    mem_store64(t, 56, K56)
    mem_store64(t, 57, K57)
    mem_store64(t, 58, K58)
    mem_store64(t, 59, K59)
    mem_store64(t, 60, K60)
    mem_store64(t, 61, K61)
    mem_store64(t, 62, K62)
    mem_store64(t, 63, K63)
    return 0
}

// 常量查表：6 层判定树（线性 64 个 if 会让每块多 4000 次比较）
// v1.34 起热路径不再走它（改用 _sha256_ktab + mem_load64），保留作公开 API。
fn sha256_k(i: int) -> int {
    if i < 32 {
        if i < 16 {
            if i < 8 {
                if i < 4 {
                    if i < 2 {
                        if i < 1 {
                            return K0
                        } else {
                            return K1
                        }
                    } else {
                        if i < 3 {
                            return K2
                        } else {
                            return K3
                        }
                    }
                } else {
                    if i < 6 {
                        if i < 5 {
                            return K4
                        } else {
                            return K5
                        }
                    } else {
                        if i < 7 {
                            return K6
                        } else {
                            return K7
                        }
                    }
                }
            } else {
                if i < 12 {
                    if i < 10 {
                        if i < 9 {
                            return K8
                        } else {
                            return K9
                        }
                    } else {
                        if i < 11 {
                            return K10
                        } else {
                            return K11
                        }
                    }
                } else {
                    if i < 14 {
                        if i < 13 {
                            return K12
                        } else {
                            return K13
                        }
                    } else {
                        if i < 15 {
                            return K14
                        } else {
                            return K15
                        }
                    }
                }
            }
        } else {
            if i < 24 {
                if i < 20 {
                    if i < 18 {
                        if i < 17 {
                            return K16
                        } else {
                            return K17
                        }
                    } else {
                        if i < 19 {
                            return K18
                        } else {
                            return K19
                        }
                    }
                } else {
                    if i < 22 {
                        if i < 21 {
                            return K20
                        } else {
                            return K21
                        }
                    } else {
                        if i < 23 {
                            return K22
                        } else {
                            return K23
                        }
                    }
                }
            } else {
                if i < 28 {
                    if i < 26 {
                        if i < 25 {
                            return K24
                        } else {
                            return K25
                        }
                    } else {
                        if i < 27 {
                            return K26
                        } else {
                            return K27
                        }
                    }
                } else {
                    if i < 30 {
                        if i < 29 {
                            return K28
                        } else {
                            return K29
                        }
                    } else {
                        if i < 31 {
                            return K30
                        } else {
                            return K31
                        }
                    }
                }
            }
        }
    } else {
        if i < 48 {
            if i < 40 {
                if i < 36 {
                    if i < 34 {
                        if i < 33 {
                            return K32
                        } else {
                            return K33
                        }
                    } else {
                        if i < 35 {
                            return K34
                        } else {
                            return K35
                        }
                    }
                } else {
                    if i < 38 {
                        if i < 37 {
                            return K36
                        } else {
                            return K37
                        }
                    } else {
                        if i < 39 {
                            return K38
                        } else {
                            return K39
                        }
                    }
                }
            } else {
                if i < 44 {
                    if i < 42 {
                        if i < 41 {
                            return K40
                        } else {
                            return K41
                        }
                    } else {
                        if i < 43 {
                            return K42
                        } else {
                            return K43
                        }
                    }
                } else {
                    if i < 46 {
                        if i < 45 {
                            return K44
                        } else {
                            return K45
                        }
                    } else {
                        if i < 47 {
                            return K46
                        } else {
                            return K47
                        }
                    }
                }
            }
        } else {
            if i < 56 {
                if i < 52 {
                    if i < 50 {
                        if i < 49 {
                            return K48
                        } else {
                            return K49
                        }
                    } else {
                        if i < 51 {
                            return K50
                        } else {
                            return K51
                        }
                    }
                } else {
                    if i < 54 {
                        if i < 53 {
                            return K52
                        } else {
                            return K53
                        }
                    } else {
                        if i < 55 {
                            return K54
                        } else {
                            return K55
                        }
                    }
                }
            } else {
                if i < 60 {
                    if i < 58 {
                        if i < 57 {
                            return K56
                        } else {
                            return K57
                        }
                    } else {
                        if i < 59 {
                            return K58
                        } else {
                            return K59
                        }
                    }
                } else {
                    if i < 62 {
                        if i < 61 {
                            return K60
                        } else {
                            return K61
                        }
                    } else {
                        if i < 63 {
                            return K62
                        } else {
                            return K63
                        }
                    }
                }
            }
        }
    }
}

fn sha256_block(state: int, block: int, w: int) -> int {
    let kt = mem_alloc(64 * 8)
    _sha256_ktab(kt)
    _sha256_block_kt(state, block, w, kt)
    mem_free(kt, 64 * 8)
    return 0
}

fn _sha256_block_kt(state: int, block: int, w: int, kt: int) -> int {
    sha256_load_block(block, w)
    let mut a = mem_load64(state, 0)
    let mut b = mem_load64(state, 1)
    let mut c = mem_load64(state, 2)
    let mut d = mem_load64(state, 3)
    let mut e = mem_load64(state, 4)
    let mut f = mem_load64(state, 5)
    let mut g = mem_load64(state, 6)
    let mut h = mem_load64(state, 7)
    let mut i = 0
    while i < 64 {
        // v1.34：旋转改成**按常量位移内联**，不再每轮调 6 次 sha256_rotr。
        // 旧实现一块 64 轮 × 7 次函数调用 ≈ 450 次调用，调用开销就是全部成本
        // （1 MiB 要 737 万次调用）；内联后位移量变成立即数，乘加也能少几次搬运。
        // S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25)
        let s1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^
                  ((e >> 25) | (e << 7))) & 0xFFFFFFFF
        let ch = ((e & f) ^ ((e ^ 0xFFFFFFFF) & g)) & 0xFFFFFFFF
        let t1 = (h + s1 + ch + mem_load64(kt, i) + mem_load64(w, i)) & 0xFFFFFFFF
        // S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22)
        let s0 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^
                  ((a >> 22) | (a << 10))) & 0xFFFFFFFF
        let maj = ((a & b) ^ (a & c) ^ (b & c)) & 0xFFFFFFFF
        let t2 = (s0 + maj) & 0xFFFFFFFF
        h = g
        g = f
        f = e
        e = (d + t1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (t1 + t2) & 0xFFFFFFFF
        i = i + 1
    }
    mem_store64(state, 0, (mem_load64(state, 0) + a) & 0xFFFFFFFF)
    mem_store64(state, 1, (mem_load64(state, 1) + b) & 0xFFFFFFFF)
    mem_store64(state, 2, (mem_load64(state, 2) + c) & 0xFFFFFFFF)
    mem_store64(state, 3, (mem_load64(state, 3) + d) & 0xFFFFFFFF)
    mem_store64(state, 4, (mem_load64(state, 4) + e) & 0xFFFFFFFF)
    mem_store64(state, 5, (mem_load64(state, 5) + f) & 0xFFFFFFFF)
    mem_store64(state, 6, (mem_load64(state, 6) + g) & 0xFFFFFFFF)
    mem_store64(state, 7, (mem_load64(state, 7) + h) & 0xFFFFFFFF)
    return 0
}

fn sha256_init(state: int) -> int {
    mem_store64(state, 0, 0x6A09E667)
    mem_store64(state, 1, 0xBB67AE85)
    mem_store64(state, 2, 0x3C6EF372)
    mem_store64(state, 3, 0xA54FF53A)
    mem_store64(state, 4, 0x510E527F)
    mem_store64(state, 5, 0x9B05688C)
    mem_store64(state, 6, 0x1F83D9AB)
    mem_store64(state, 7, 0x5BE0CD19)
    return 0
}

// 内部：对已分配好的 total 字节缓冲（消息 + 0x80 + 0 + 长度）做摘要
fn sha256_pad_and_hash(s: str) -> int {
    let n = len(s)
    let total = ((n + 9 + 63) / 64) * 64
    let buf = mem_alloc(total)
    // 整段拷贝/清零走运行时块操作：逐字节循环在 1MiB 输入上是主要成本
    mem_copy(buf, s, n)
    mem_store8(buf, n, 0x80)
    mem_zero(buf + n + 1, total - n - 1)
    let bits = n * 8
    let mut b = 0
    while b < 8 {
        mem_store8(buf, total - 8 + b, (bits >> (56 - b * 8)) & 0xFF)
        b = b + 1
    }
    let state = mem_alloc(64)
    sha256_init(state)
    let w = mem_alloc(64 * 8)
    let kt = mem_alloc(64 * 8)
    _sha256_ktab(kt)                 // v1.34：整个消息只建一次
    let mut off = 0
    while off < total {
        _sha256_block_kt(state, buf + off, w, kt)
        off = off + 64
    }
    mem_free(kt, 64 * 8)
    let out = mem_alloc(32)
    let mut k = 0
    while k < 8 {
        let v = mem_load64(state, k)
        mem_store8(out, k * 4, (v >> 24) & 0xFF)
        mem_store8(out, k * 4 + 1, (v >> 16) & 0xFF)
        mem_store8(out, k * 4 + 2, (v >> 8) & 0xFF)
        mem_store8(out, k * 4 + 3, v & 0xFF)
        k = k + 1
    }
    mem_free(buf, total)
    mem_free(w, 64 * 8)
    mem_free(state, 64)
    return out
}

/// sha256_str(s) -> int：32 字节摘要缓冲区指针（大端序，含 0 字节，不能当 str）。
/// 调用方用完后 mem_free(dig, 32)。
pub fn sha256_str(s: str) -> int {
    return sha256_pad_and_hash(s)
}

/// sha256_hex(s) -> str：64 位小写十六进制
pub fn sha256_hex(s: str) -> str {
    let dig = sha256_str(s)
    let out = mem_alloc(65)
    let mut i = 0
    while i < 32 {
        let v = mem_load8(dig, i)
        let hi = v >> 4
        let lo = v & 15
        if hi < 10 {
            mem_store8(out, i * 2, 48 + hi)
        } else {
            mem_store8(out, i * 2, 87 + hi)
        }
        if lo < 10 {
            mem_store8(out, i * 2 + 1, 48 + lo)
        } else {
            mem_store8(out, i * 2 + 1, 87 + lo)
        }
        i = i + 1
    }
    mem_store8(out, 64, 0)
    let hex = mem_str(out, 64)
    mem_free(out, 65)
    mem_free(dig, 32)
    return hex
}

// ---------------------------------------------------------------------------
// HMAC-SHA256（RFC 2104：H((K^opad) || H((K^ipad) || m))，块长 64）
// ---------------------------------------------------------------------------

// 把 key 规整成 64 字节块：超过 64 字节先取摘要，其余补零
fn hmac_key_block(key: str, blk: int) -> int {
    let n = len(key)
    let mut used = 0
    if n > 64 {
        // 长 key：先用 SHA-256 压成 32 字节
        let dig = sha256_str(key)
        let mut i = 0
        while i < 32 {
            mem_store8(blk, i, mem_load8(dig, i))
            i = i + 1
        }
        mem_free(dig, 32)
        used = 32
    } else {
        let mut i = 0
        while i < n {
            mem_store8(blk, i, key[i])
            i = i + 1
        }
        used = n
    }
    let mut j = used
    while j < 64 {
        mem_store8(blk, j, 0)
        j = j + 1
    }
    return 0
}

/// hmac_sha256_str(key, msg) -> int：32 字节摘要缓冲区（用完 mem_free(d, 32)）
pub fn hmac_sha256_str(key: str, msg: str) -> int {
    let kb = mem_alloc(64)
    hmac_key_block(key, kb)

    // inner = SHA256((K^ipad) || msg)
    let mn = len(msg)
    let inner_total = ((64 + mn + 9 + 63) / 64) * 64
    let ibuf = mem_alloc(inner_total)
    let mut i = 0
    while i < 64 {
        mem_store8(ibuf, i, mem_load8(kb, i) ^ 0x36)
        i = i + 1
    }
    let mut j = 0
    while j < mn {
        mem_store8(ibuf, 64 + j, msg[j])
        j = j + 1
    }
    // 手工补位（复用 sha256_pad_and_hash 的规则，但消息起点在 64）
    let n = 64 + mn
    mem_store8(ibuf, n, 0x80)
    let mut z = n + 1
    while z < inner_total {
        mem_store8(ibuf, z, 0)
        z = z + 1
    }
    let bits = n * 8
    let mut b = 0
    while b < 8 {
        mem_store8(ibuf, inner_total - 8 + b, (bits >> (56 - b * 8)) & 0xFF)
        b = b + 1
    }
    let st = mem_alloc(64)
    sha256_init(st)
    let w = mem_alloc(64 * 8)
    let mut off = 0
    while off < inner_total {
        sha256_block(st, ibuf + off, w)
        off = off + 64
    }
    // 取出 inner 摘要
    let inner = mem_alloc(32)
    let mut k = 0
    while k < 8 {
        let v = mem_load64(st, k)
        mem_store8(inner, k * 4, (v >> 24) & 0xFF)
        mem_store8(inner, k * 4 + 1, (v >> 16) & 0xFF)
        mem_store8(inner, k * 4 + 2, (v >> 8) & 0xFF)
        mem_store8(inner, k * 4 + 3, v & 0xFF)
        k = k + 1
    }

    // outer = SHA256((K^opad) || inner)
    let obuf = mem_alloc(128)
    let mut p = 0
    while p < 64 {
        mem_store8(obuf, p, mem_load8(kb, p) ^ 0x5C)
        p = p + 1
    }
    let mut q = 0
    while q < 32 {
        mem_store8(obuf, 64 + q, mem_load8(inner, q))
        q = q + 1
    }
    mem_store8(obuf, 96, 0x80)
    let mut zz = 97
    while zz < 128 {
        mem_store8(obuf, zz, 0)
        zz = zz + 1
    }
    // 96 字节 = 768 bit，最后一个块的后 8 字节写长度
    mem_store8(obuf, 120, 0)
    mem_store8(obuf, 121, 0)
    mem_store8(obuf, 122, 0)
    mem_store8(obuf, 123, 0)
    mem_store8(obuf, 124, 0)
    mem_store8(obuf, 125, 0)
    mem_store8(obuf, 126, 3)
    mem_store8(obuf, 127, 0)

    let st2 = mem_alloc(64)
    sha256_init(st2)
    let mut off2 = 0
    while off2 < 128 {
        sha256_block(st2, obuf + off2, w)
        off2 = off2 + 64
    }
    let out = mem_alloc(32)
    let mut m = 0
    while m < 8 {
        let v2 = mem_load64(st2, m)
        mem_store8(out, m * 4, (v2 >> 24) & 0xFF)
        mem_store8(out, m * 4 + 1, (v2 >> 16) & 0xFF)
        mem_store8(out, m * 4 + 2, (v2 >> 8) & 0xFF)
        mem_store8(out, m * 4 + 3, v2 & 0xFF)
        m = m + 1
    }

    mem_free(kb, 64)
    mem_free(ibuf, inner_total)
    mem_free(inner, 32)
    mem_free(obuf, 128)
    mem_free(st, 64)
    mem_free(st2, 64)
    mem_free(w, 64 * 8)
    return out
}

/// HMAC-SHA256 的十六进制形式（RFC 2104：ipad/opad 各 64 字节，密钥超长先哈希）。
/// 返回 64 位小写十六进制；key 与 msg 都按字节处理。
pub fn hmac_sha256_hex(key: str, msg: str) -> str {
    let dig = hmac_sha256_str(key, msg)
    let out = mem_alloc(65)
    let mut i = 0
    while i < 32 {
        let v = mem_load8(dig, i)
        let hi = v >> 4
        let lo = v & 15
        if hi < 10 {
            mem_store8(out, i * 2, 48 + hi)
        } else {
            mem_store8(out, i * 2, 87 + hi)
        }
        if lo < 10 {
            mem_store8(out, i * 2 + 1, 48 + lo)
        } else {
            mem_store8(out, i * 2 + 1, 87 + lo)
        }
        i = i + 1
    }
    mem_store8(out, 64, 0)
    let hex = mem_str(out, 64)
    mem_free(out, 65)
    mem_free(dig, 32)
    return hex
}
