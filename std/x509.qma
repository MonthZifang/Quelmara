// std/x509.qma —— X.509 证书最小解析（DER / ASN.1）—— v1.23
//
// 为什么需要它：TLS 握手里服务器发来的是 DER 编码的证书。要验签，必须先
// 从里面取出三样东西：TBSCertificate 原始字节、签名算法、签名值（r,s），
// 以及签发者公钥（链式验证时用上一层证书的 SPKI）。
//
// 本模块只做**解析**，不做策略判断（有效期、域名、用途、链构建都不管）：
//   * DER TLV 解析（tag / 长度 / 值），支持长格式长度
//   * 取 TBSCertificate 原始字节（验签要对它做哈希）
//   * 取 SubjectPublicKeyInfo 里的 P-256 公钥（未压缩点 04 || X || Y）
//   * 取 signatureValue 里的 (r, s)，自动去掉 DER INTEGER 的前导 0 并左补到 32 字节
//   * x509_verify_self_p256：自签证书验证（根证书 / 测试用）
//
// 边界：只认 ECDSA-P256（id-ecPublicKey + prime256v1）；不支持 RSA、Ed25519、
// 压缩点；不校验有效期/域名/用途/链；不做 CRL/OCSP。

import std.sha256
import std.p256
import std.rsa

// DER 标签
const X509_TAG_INTEGER = 0x02
const X509_TAG_BIT_STRING = 0x03
const X509_TAG_OID = 0x06
const X509_TAG_SEQUENCE = 0x30
const X509_TAG_CTX0 = 0xA0

// ---------------------------------------------------------------------------
// DER TLV
// ---------------------------------------------------------------------------

// 解析 pos 处的 TLV。返回 [tag, hdr_len, val_off, val_len, next_off]；
// 非法返回空 vec。
fn x509_tlv(s: str, pos: int) -> vec[int] {
    let out = vec[int].new(6)
    let n = len(s)
    if pos < 0 || pos >= n {
        return out
    }
    let tag = s[pos]
    let mut p = pos + 1
    if p >= n {
        return out
    }
    let b0 = s[p]
    let mut vlen = 0
    if b0 < 0x80 {
        vlen = b0
        p = p + 1
    } else if b0 == 0x81 {
        if p + 1 >= n {
            return out
        }
        vlen = s[p + 1]
        p = p + 2
    } else if b0 == 0x82 {
        if p + 2 >= n {
            return out
        }
        vlen = (s[p + 1] << 8) | s[p + 2]
        p = p + 3
    } else if b0 == 0x83 {
        if p + 3 >= n {
            return out
        }
        vlen = (s[p + 1] << 16) | (s[p + 2] << 8) | s[p + 3]
        p = p + 4
    } else {
        return out                     // 不支持 >3 字节长度
    }
    let val_off = p
    let next = p + vlen
    if next > n {
        return out
    }
    out.push(tag)
    out.push(val_off - pos)            // 头部长度
    out.push(val_off)
    out.push(vlen)
    out.push(next)
    return out
}

fn x509_ok(t: vec[int]) -> int {
    if len(t) == 5 {
        return 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 证书结构
// ---------------------------------------------------------------------------

// Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
fn x509_root(cert: str) -> vec[int] {
    let t = x509_tlv(cert, 0)
    if x509_ok(t) == 0 || t.get(0) != X509_TAG_SEQUENCE {
        return vec[int].new(0)
    }
    return t
}

// TBSCertificate 的原始 DER 字节（验签时对它做哈希）
fn x509_tbs(cert: str) -> str {
    let root = x509_root(cert)
    if len(root) == 0 {
        return ""
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 || tbs.get(0) != X509_TAG_SEQUENCE {
        return ""
    }
    let start = tbs.get(2) - tbs.get(1)
    return substr(cert, start, tbs.get(4) - start)
}

// 签名算法 OID（原始字节，如 ecdsa-with-SHA256 = 1.2.840.10045.4.3.2）
fn x509_sig_alg_oid(cert: str) -> str {
    let root = x509_root(cert)
    if len(root) == 0 {
        return ""
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, tbs.get(4))          // TBS 之后的 signatureAlgorithm
    if x509_ok(alg) == 0 || alg.get(0) != X509_TAG_SEQUENCE {
        return ""
    }
    let oid = x509_tlv(cert, alg.get(2))
    if x509_ok(oid) == 0 || oid.get(0) != X509_TAG_OID {
        return ""
    }
    return substr(cert, oid.get(2), oid.get(3))
}

// SPKI 里的公钥算法 OID（第二个 OID，如 prime256v1）
fn x509_curve_oid(cert: str) -> str {
    let spki = x509_spki_tlv(cert)
    if len(spki) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, spki.get(2))
    if x509_ok(alg) == 0 {
        return ""
    }
    let oid1 = x509_tlv(cert, alg.get(2))
    if x509_ok(oid1) == 0 {
        return ""
    }
    let oid2 = x509_tlv(cert, oid1.get(4))
    if x509_ok(oid2) == 0 || oid2.get(0) != X509_TAG_OID {
        return ""
    }
    return substr(cert, oid2.get(2), oid2.get(3))
}

// 找到 SubjectPublicKeyInfo 这个 SEQUENCE 的 TLV
fn x509_spki_tlv(cert: str) -> vec[int] {
    let root = x509_root(cert)
    if len(root) == 0 {
        return vec[int].new(0)
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 {
        return vec[int].new(0)
    }
    let mut p = tbs.get(2)
    // 可选 version [0]
    let first = x509_tlv(cert, p)
    if x509_ok(first) == 0 {
        return vec[int].new(0)
    }
    if first.get(0) == X509_TAG_CTX0 {
        p = first.get(4)
    }
    // serialNumber
    let serial = x509_tlv(cert, p)
    if x509_ok(serial) == 0 {
        return vec[int].new(0)
    }
    p = serial.get(4)
    // 依次跳过 signature / issuer / validity / subject 四个 SEQUENCE
    let mut k = 0
    while k < 4 {
        let t = x509_tlv(cert, p)
        if x509_ok(t) == 0 || t.get(0) != X509_TAG_SEQUENCE {
            return vec[int].new(0)
        }
        p = t.get(4)
        k = k + 1
    }
    let spki = x509_tlv(cert, p)
    if x509_ok(spki) == 0 || spki.get(0) != X509_TAG_SEQUENCE {
        return vec[int].new(0)
    }
    return spki
}

// P-256 公钥：返回 64 字节 X||Y；非 P-256 或格式不对返回 ""
fn x509_pubkey(cert: str) -> str {
    let spki = x509_spki_tlv(cert)
    if len(spki) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, spki.get(2))
    if x509_ok(alg) == 0 {
        return ""
    }
    let bits = x509_tlv(cert, alg.get(4))
    if x509_ok(bits) == 0 || bits.get(0) != X509_TAG_BIT_STRING {
        return ""
    }
    // BIT STRING 值：1 字节 unused bits + 04 || X || Y
    if bits.get(3) < 66 {
        return ""
    }
    let v = bits.get(2)
    if cert[v] != 0 {
        return ""
    }
    if cert[v + 1] != 0x04 {
        return ""                      // 只支持未压缩点
    }
    if x509_curve_oid(cert) != "\x2a\x86\x48\xce\x3d\x03\x01\x07" {
        return ""                      // 只认 prime256v1
    }
    return substr(cert, v + 2, 64)
}

// 签名值：返回 64 字节 r||s（各左补到 32 字节）；格式不对返回 ""
fn x509_sig(cert: str) -> str {
    let root = x509_root(cert)
    if len(root) == 0 {
        return ""
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, tbs.get(4))
    if x509_ok(alg) == 0 {
        return ""
    }
    let bits = x509_tlv(cert, alg.get(4))
    if x509_ok(bits) == 0 || bits.get(0) != X509_TAG_BIT_STRING {
        return ""
    }
    if bits.get(3) < 2 {
        return ""
    }
    let v = bits.get(2)
    if cert[v] != 0 {
        return ""
    }
    let seq = x509_tlv(cert, v + 1)
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return ""
    }
    let ri = x509_tlv(cert, seq.get(2))
    if x509_ok(ri) == 0 || ri.get(0) != X509_TAG_INTEGER {
        return ""
    }
    let si = x509_tlv(cert, ri.get(4))
    if x509_ok(si) == 0 || si.get(0) != X509_TAG_INTEGER {
        return ""
    }
    let out = vec[int].new(65)
    _x509_pad_int(cert, ri, out)
    _x509_pad_int(cert, si, out)
    return str_from_bytes(out)
}

// 把 DER INTEGER 的值右对齐写进 32 字节（去掉前导 0，左补 0）
fn _x509_pad_int(cert: str, t: vec[int], out: vec[int]) {
    let off = t.get(2)
    let n = t.get(3)
    let mut start = off
    let mut cnt = n
    while cnt > 1 && cert[start] == 0 {
        start = start + 1
        cnt = cnt - 1
    }
    if cnt > 32 {
        // 超长（负数或异常）——填 0，验签必然失败
        let mut i = 0
        while i < 32 {
            out.push(0)
            i = i + 1
        }
        return
    }
    let pad = 32 - cnt
    let mut i = 0
    while i < pad {
        out.push(0)
        i = i + 1
    }
    i = 0
    while i < cnt {
        out.push(cert[start + i])
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// 组合：自签验证
// ---------------------------------------------------------------------------

// 用证书自己的公钥验证它自己的签名（根证书 / 自签测试）。
// 返回 1 = 签名有效且是 P-256 证书。
fn x509_verify_self_p256(cert: str) -> int {
    let pub = x509_pubkey(cert)
    let tbs = x509_tbs(cert)
    let sig = x509_sig(cert)
    if len(pub) != 64 || len(sig) != 64 || len(tbs) == 0 {
        return 0
    }
    let h = mem_str(sha256_str(tbs), 32)
    return ecdsa_p256_verify(substr(pub, 0, 32), substr(pub, 32, 32), h,
                             substr(sig, 0, 32), substr(sig, 32, 32))
}

// 用外部公钥验证证书签名（链式验证用：issuer_pub 是 64 字节 X||Y）
fn x509_verify_with_p256(cert: str, issuer_pub: str) -> int {
    if len(issuer_pub) != 64 {
        return 0
    }
    let tbs = x509_tbs(cert)
    let sig = x509_sig(cert)
    if len(sig) != 64 || len(tbs) == 0 {
        return 0
    }
    let h = mem_str(sha256_str(tbs), 32)
    return ecdsa_p256_verify(substr(issuer_pub, 0, 32), substr(issuer_pub, 32, 32), h,
                             substr(sig, 0, 32), substr(sig, 32, 32))
}

// ---------------------------------------------------------------------------
// 链验证（v1.26）：字段提取 + 有效期 + SAN + 签名链
// ---------------------------------------------------------------------------

// TBS 里 serial 之后的起始偏移（0 = 解析失败）
fn _x509_fields_start(cert: str) -> int {
    let root = x509_root(cert)
    if len(root) == 0 {
        return 0
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 {
        return 0
    }
    let mut p = tbs.get(2)
    let first = x509_tlv(cert, p)
    if x509_ok(first) == 0 {
        return 0
    }
    if first.get(0) == X509_TAG_CTX0 {
        p = first.get(4)
    }
    let serial = x509_tlv(cert, p)
    if x509_ok(serial) == 0 {
        return 0
    }
    return serial.get(4)
}

// 从 serial 之后跳过 n 个字段，返回第 n 个 TLV（空 = 失败）
fn _x509_skip(cert: str, n: int) -> vec[int] {
    let mut p = _x509_fields_start(cert)
    if p == 0 {
        return vec[int].new(0)
    }
    let mut k = 0
    while k < n {
        let t = x509_tlv(cert, p)
        if x509_ok(t) == 0 {
            return vec[int].new(0)
        }
        p = t.get(4)
        k = k + 1
    }
    return x509_tlv(cert, p)
}

// 取 TLV 的完整 DER（含 tag/len）
fn _x509_der(cert: str, t: vec[int]) -> str {
    if x509_ok(t) == 0 {
        return ""
    }
    let start = t.get(2) - t.get(1)
    return substr(cert, start, t.get(4) - start)
}

fn x509_issuer(cert: str) -> str {
    return _x509_der(cert, _x509_skip(cert, 1))
}

fn x509_subject(cert: str) -> str {
    return _x509_der(cert, _x509_skip(cert, 3))
}

fn x509_validity_raw(cert: str) -> str {
    return _x509_der(cert, _x509_skip(cert, 2))
}

// 十进制数字串 → 整数
fn _x509_num(s: str, off: int, n: int) -> int {
    let mut v = 0
    let mut i = 0
    while i < n {
        v = v * 10 + (s[off + i] - 48)
        i = i + 1
    }
    return v
}

// 公历日期 → Unix 天数（Howard Hinnant 算法）
fn _x509_days(y: int, m: int, d: int) -> int {
    let mut yy = y
    if m <= 2 {
        yy = y - 1
    }
    let era = yy / 400
    let yoe = yy - era * 400
    let mut mp = m + 9
    if m > 2 {
        mp = m - 3
    }
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// 证书有效期：[not_before, not_after]（Unix 秒）；失败返回空 vec
fn x509_validity(cert: str) -> vec[int] {
    let out = vec[int].new(3)
    let v = _x509_skip(cert, 2)
    if x509_ok(v) == 0 || v.get(0) != X509_TAG_SEQUENCE {
        return out
    }
    let a = x509_tlv(cert, v.get(2))
    if x509_ok(a) == 0 {
        return out
    }
    let b = x509_tlv(cert, a.get(4))
    if x509_ok(b) == 0 {
        return out
    }
    out.push(_x509_parse_time(cert, a))
    out.push(_x509_parse_time(cert, b))
    return out
}

fn _x509_parse_time(cert: str, t: vec[int]) -> int {
    let off = t.get(2)
    let n = t.get(3)
    let mut y = 0
    let mut mo = 0
    let mut d = 0
    let mut hh = 0
    let mut mm = 0
    let mut ss = 0
    if t.get(0) == 0x17 && n >= 13 {
        let yy = _x509_num(cert, off, 2)
        if yy < 50 {
            y = 2000 + yy
        } else {
            y = 1900 + yy
        }
        mo = _x509_num(cert, off + 2, 2)
        d = _x509_num(cert, off + 4, 2)
        hh = _x509_num(cert, off + 6, 2)
        mm = _x509_num(cert, off + 8, 2)
        ss = _x509_num(cert, off + 10, 2)
    } else if t.get(0) == 0x18 && n >= 15 {
        y = _x509_num(cert, off, 4)
        mo = _x509_num(cert, off + 4, 2)
        d = _x509_num(cert, off + 6, 2)
        hh = _x509_num(cert, off + 8, 2)
        mm = _x509_num(cert, off + 10, 2)
        ss = _x509_num(cert, off + 12, 2)
    } else {
        return 0
    }
    return _x509_days(y, mo, d) * 86400 + hh * 3600 + mm * 60 + ss
}

// 在 [not_before, not_after] 内返回 1
fn x509_time_valid(cert: str, now: int) -> int {
    let v = x509_validity(cert)
    if len(v) != 2 {
        return 0
    }
    if now < v.get(0) || now > v.get(1) {
        return 0
    }
    return 1
}

// 取扩展值（OID 匹配，返回 OCTET STRING 的内容）；没有返回 ""
fn _x509_ext_value(cert: str, oid: str) -> str {
    let e = _x509_skip(cert, 5)
    if x509_ok(e) == 0 || e.get(0) != 0xA3 {
        return ""
    }
    let seq = x509_tlv(cert, e.get(2))
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return ""
    }
    let mut p = seq.get(2)
    let end = seq.get(4)
    while p < end {
        let ex = x509_tlv(cert, p)
        if x509_ok(ex) == 0 || ex.get(0) != X509_TAG_SEQUENCE {
            return ""
        }
        let o = x509_tlv(cert, ex.get(2))
        if x509_ok(o) == 0 || o.get(0) != X509_TAG_OID {
            return ""
        }
        let oidv = substr(cert, o.get(2), o.get(3))
        let mut q = o.get(4)
        let nx = x509_tlv(cert, q)
        if x509_ok(nx) == 0 {
            return ""
        }
        if nx.get(0) == 0x01 {
            q = nx.get(4)
        }
        let val = x509_tlv(cert, q)
        if x509_ok(val) == 0 || val.get(0) != 0x04 {
            return ""
        }
        if oidv == oid {
            return substr(cert, val.get(2), val.get(3))
        }
        p = ex.get(4)
    }
    return ""
}

// basicConstraints（2.5.29.19）→ CA 位
fn x509_is_ca(cert: str) -> int {
    let v = _x509_ext_value(cert, "\x55\x1d\x13")
    if len(v) == 0 {
        return 0
    }
    let seq = x509_tlv(v, 0)
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return 0
    }
    let b = x509_tlv(v, seq.get(2))
    if x509_ok(b) == 0 || b.get(0) != 0x01 {
        return 0
    }
    if v[b.get(2)] != 0 {
        return 1
    }
    return 0
}

// subjectAltName（2.5.29.17）→ DNS 名列表
fn x509_san(cert: str) -> vec[str] {
    let out = vec[str].new(4)
    let v = _x509_ext_value(cert, "\x55\x1d\x11")
    if len(v) == 0 {
        return out
    }
    let seq = x509_tlv(v, 0)
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return out
    }
    let mut p = seq.get(2)
    let end = seq.get(4)
    while p < end {
        let g = x509_tlv(v, p)
        if x509_ok(g) == 0 {
            break
        }
        if g.get(0) == 0x82 {
            out.push(substr(v, g.get(2), g.get(3)))
        }
        p = g.get(4)
    }
    return out
}

// ASCII 小写
fn _x509_lower(s: str) -> str {
    let v = vec[int].new(len(s) + 1)
    let mut i = 0
    while i < len(s) {
        let c = s[i]
        if c >= 65 && c <= 90 {
            v.push(c + 32)
        } else {
            v.push(c)
        }
        i = i + 1
    }
    return str_from_bytes(v)
}

// 通配符只匹配一级标签
fn _x509_host_match(pat: str, host: str) -> int {
    let p = _x509_lower(pat)
    let h = _x509_lower(host)
    if len(p) == 0 || len(h) == 0 {
        return 0
    }
    if p[0] != 42 {
        if p == h {
            return 1
        }
        return 0
    }
    if len(p) < 3 || p[1] != 46 {
        return 0
    }
    let suffix = substr(p, 1, len(p) - 1)          // ".example.com"
    if len(h) <= len(suffix) {
        return 0
    }
    if substr(h, len(h) - len(suffix), len(suffix)) != suffix {
        return 0
    }
    let label = substr(h, 0, len(h) - len(suffix))
    let mut i = 0
    while i < len(label) {
        if label[i] == 46 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn x509_host_ok(cert: str, host: str) -> int {
    let names = x509_san(cert)
    let mut i = 0
    while i < len(names) {
        if _x509_host_match(names.get(i), host) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// 一条链节：child 由 issuer 签发
fn _x509_link(child: str, issuer: str, now: int) -> int {
    if x509_is_ca(issuer) != 1 {
        return 0
    }
    if x509_issuer(child) != x509_subject(issuer) {
        return 0
    }
    if x509_time_valid(child, now) == 0 {
        return 0
    }
    let pub = x509_pubkey(issuer)
    if len(pub) == 64 {
        return x509_verify_with_p256(child, pub)
    }
    // RSA 颁发者：PKCS#1 v1.5（证书链签名主流）
    let n = x509_rsa_pub(issuer)
    if len(n) > 0 {
        let sig = x509_sig_bits(child)
        if len(sig) == 0 {
            return 0
        }
        let h = mem_str(sha256_str(x509_tbs(child)), 32)
        return rsa_verify_pkcs1_sha256(n, x509_rsa_exp(issuer), sig, h)
    }
    return 0
}

// 验证 leaf（可选 intermediates，按 leaf→root 顺序）到 anchor。
// host 非空时额外校验 SAN；now 是 Unix 秒。
// 返回 1 = 通过，0 = 失败。
fn x509_verify_chain(leaf: str, inter: vec[str], anchor: str, host: str, now: int) -> int {
    if x509_is_ca(anchor) != 1 {
        return 0
    }
    let mut cur = leaf
    let mut i = 0
    while i < len(inter) {
        let up = inter.get(i)
        if _x509_link(cur, up, now) == 0 {
            return 0
        }
        cur = up
        i = i + 1
    }
    if _x509_link(cur, anchor, now) == 0 {
        return 0
    }
    if len(host) > 0 {
        if x509_host_ok(leaf, host) == 0 {
            return 0
        }
    }
    return 1
}


// ---------------------------------------------------------------------------
// RSA（v1.27）：SPKI 公钥与原始签名
// ---------------------------------------------------------------------------

// 签名值原始字节（BIT STRING 去掉 unused-bits 字节；RSA 用）
fn x509_sig_bits(cert: str) -> str {
    let root = x509_root(cert)
    if len(root) == 0 {
        return ""
    }
    let tbs = x509_tlv(cert, root.get(2))
    if x509_ok(tbs) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, tbs.get(4))
    if x509_ok(alg) == 0 {
        return ""
    }
    let bits = x509_tlv(cert, alg.get(4))
    if x509_ok(bits) == 0 || bits.get(0) != X509_TAG_BIT_STRING {
        return ""
    }
    if bits.get(3) < 2 {
        return ""
    }
    let v = bits.get(2)
    if cert[v] != 0 {
        return ""
    }
    return substr(cert, v + 1, bits.get(3) - 1)
}

// RSA 模数（大端、去前导 0）；非 RSA 返回 ""
fn x509_rsa_pub(cert: str) -> str {
    let spki = x509_spki_tlv(cert)
    if len(spki) == 0 {
        return ""
    }
    let alg = x509_tlv(cert, spki.get(2))
    if x509_ok(alg) == 0 {
        return ""
    }
    let bits = x509_tlv(cert, alg.get(4))
    if x509_ok(bits) == 0 || bits.get(0) != X509_TAG_BIT_STRING {
        return ""
    }
    if bits.get(3) < 4 {
        return ""
    }
    let v = bits.get(2)
    if cert[v] != 0 {
        return ""
    }
    let seq = x509_tlv(cert, v + 1)
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return ""
    }
    let n = x509_tlv(cert, seq.get(2))
    if x509_ok(n) == 0 || n.get(0) != X509_TAG_INTEGER {
        return ""
    }
    let raw = substr(cert, n.get(2), n.get(3))
    let mut off = 0
    while off < len(raw) - 1 && raw[off] == 0 {
        off = off + 1
    }
    return substr(raw, off, len(raw) - off)
}

// RSA 公钥指数（通常 65537）
fn x509_rsa_exp(cert: str) -> int {
    let spki = x509_spki_tlv(cert)
    if len(spki) == 0 {
        return 0
    }
    let alg = x509_tlv(cert, spki.get(2))
    if x509_ok(alg) == 0 {
        return 0
    }
    let bits = x509_tlv(cert, alg.get(4))
    if x509_ok(bits) == 0 || bits.get(0) != X509_TAG_BIT_STRING {
        return 0
    }
    if bits.get(3) < 4 {
        return 0
    }
    let v = bits.get(2)
    if cert[v] != 0 {
        return 0
    }
    let seq = x509_tlv(cert, v + 1)
    if x509_ok(seq) == 0 || seq.get(0) != X509_TAG_SEQUENCE {
        return 0
    }
    let n = x509_tlv(cert, seq.get(2))
    if x509_ok(n) == 0 {
        return 0
    }
    let e = x509_tlv(cert, n.get(4))
    if x509_ok(e) == 0 || e.get(0) != X509_TAG_INTEGER {
        return 0
    }
    let mut val = 0
    let mut i = 0
    while i < e.get(3) {
        val = val * 256 + cert[e.get(2) + i]
        i = i + 1
    }
    return val
}
