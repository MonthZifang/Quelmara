// std/blake2b.qma —— BLAKE2b（RFC 7693）密码学哈希，Quelmara 自实现
//
// 为什么需要：07-gaps §2「哈希」行最后空缺（v1.53 补了 SHA-512/CRC-64 后
// 仅剩 BLAKE2）——现代 KDF/签名/MAC 的事实标准之一，比 SHA-2 快且原生支持
// keyed 与变长输出。
//
// 实现要点：
//   * 顺序模式（fanout=1, depth=1, 无树）——树模式留空（node 参数未用）；
//   * 参数块：h[0] ^= 0x01010000 ^ (keylen << 8) ^ outlen；
//   * IV 与 SHA-512 同源（前 8 个素数平方根小数）；字宽 64 位；
//   * **右移一律 >>>**：64 位值可负（全 1 掩码、IV 高位），>> 会灌符号位；
//   * G 函数拆两个 6 参半边（_g1 前半 + _g2 后半）——Quelmara 函数形参上限
//     6 个，完整 G 要 7 参（v,a,b,c,d,x,y）过线；
//   * σ 置换表 160 字节堆上建一次（每次哈希），12 轮取 r % 10；
//   * t 计数器语义（对齐参考实现）：整块压缩前 t += 128；**末块 t = 已处理
//     总量（含本块实际字节数，空消息 t=0）**——不是 +128。

// BLAKE2b IV：前 8 个素数的平方根小数部分（与 SHA-512 相同）
const B2B_IV0 = 0x6A09E667F3BCC908
const B2B_IV1 = 0xBB67AE8584CAA73B
const B2B_IV2 = 0x3C6EF372FE94F82B
const B2B_IV3 = 0xA54FF53A5F1D36F1
const B2B_IV4 = 0x510E527FADE682D1
const B2B_IV5 = 0x9B05688C2B3E6C1F
const B2B_IV6 = 0x1F83D9ABFB41BD6B
const B2B_IV7 = 0x5BE0CD19137E2179

// σ 置换表（RFC 7693 §2.7）：10 个 16 项行，160 字节
fn _b2b_sigma_tab(t: int) -> int {
    // σ0
    mem_store8(t, 0, 0)
    mem_store8(t, 1, 1)
    mem_store8(t, 2, 2)
    mem_store8(t, 3, 3)
    mem_store8(t, 4, 4)
    mem_store8(t, 5, 5)
    mem_store8(t, 6, 6)
    mem_store8(t, 7, 7)
    mem_store8(t, 8, 8)
    mem_store8(t, 9, 9)
    mem_store8(t, 10, 10)
    mem_store8(t, 11, 11)
    mem_store8(t, 12, 12)
    mem_store8(t, 13, 13)
    mem_store8(t, 14, 14)
    mem_store8(t, 15, 15)
    // σ1
    mem_store8(t, 16, 14)
    mem_store8(t, 17, 10)
    mem_store8(t, 18, 4)
    mem_store8(t, 19, 8)
    mem_store8(t, 20, 9)
    mem_store8(t, 21, 15)
    mem_store8(t, 22, 13)
    mem_store8(t, 23, 6)
    mem_store8(t, 24, 1)
    mem_store8(t, 25, 12)
    mem_store8(t, 26, 0)
    mem_store8(t, 27, 2)
    mem_store8(t, 28, 11)
    mem_store8(t, 29, 7)
    mem_store8(t, 30, 5)
    mem_store8(t, 31, 3)
    // σ2
    mem_store8(t, 32, 11)
    mem_store8(t, 33, 8)
    mem_store8(t, 34, 12)
    mem_store8(t, 35, 0)
    mem_store8(t, 36, 5)
    mem_store8(t, 37, 2)
    mem_store8(t, 38, 15)
    mem_store8(t, 39, 13)
    mem_store8(t, 40, 10)
    mem_store8(t, 41, 14)
    mem_store8(t, 42, 3)
    mem_store8(t, 43, 6)
    mem_store8(t, 44, 7)
    mem_store8(t, 45, 1)
    mem_store8(t, 46, 9)
    mem_store8(t, 47, 4)
    // σ3
    mem_store8(t, 48, 7)
    mem_store8(t, 49, 9)
    mem_store8(t, 50, 3)
    mem_store8(t, 51, 1)
    mem_store8(t, 52, 13)
    mem_store8(t, 53, 12)
    mem_store8(t, 54, 11)
    mem_store8(t, 55, 14)
    mem_store8(t, 56, 2)
    mem_store8(t, 57, 6)
    mem_store8(t, 58, 5)
    mem_store8(t, 59, 10)
    mem_store8(t, 60, 4)
    mem_store8(t, 61, 0)
    mem_store8(t, 62, 15)
    mem_store8(t, 63, 8)
    // σ4
    mem_store8(t, 64, 9)
    mem_store8(t, 65, 0)
    mem_store8(t, 66, 5)
    mem_store8(t, 67, 7)
    mem_store8(t, 68, 2)
    mem_store8(t, 69, 4)
    mem_store8(t, 70, 10)
    mem_store8(t, 71, 15)
    mem_store8(t, 72, 14)
    mem_store8(t, 73, 1)
    mem_store8(t, 74, 11)
    mem_store8(t, 75, 12)
    mem_store8(t, 76, 6)
    mem_store8(t, 77, 8)
    mem_store8(t, 78, 3)
    mem_store8(t, 79, 13)
    // σ5
    mem_store8(t, 80, 2)
    mem_store8(t, 81, 12)
    mem_store8(t, 82, 6)
    mem_store8(t, 83, 10)
    mem_store8(t, 84, 0)
    mem_store8(t, 85, 11)
    mem_store8(t, 86, 8)
    mem_store8(t, 87, 3)
    mem_store8(t, 88, 4)
    mem_store8(t, 89, 13)
    mem_store8(t, 90, 7)
    mem_store8(t, 91, 5)
    mem_store8(t, 92, 15)
    mem_store8(t, 93, 14)
    mem_store8(t, 94, 1)
    mem_store8(t, 95, 9)
    // σ6
    mem_store8(t, 96, 12)
    mem_store8(t, 97, 5)
    mem_store8(t, 98, 1)
    mem_store8(t, 99, 15)
    mem_store8(t, 100, 14)
    mem_store8(t, 101, 13)
    mem_store8(t, 102, 4)
    mem_store8(t, 103, 10)
    mem_store8(t, 104, 0)
    mem_store8(t, 105, 7)
    mem_store8(t, 106, 6)
    mem_store8(t, 107, 3)
    mem_store8(t, 108, 9)
    mem_store8(t, 109, 2)
    mem_store8(t, 110, 8)
    mem_store8(t, 111, 11)
    // σ7
    mem_store8(t, 112, 13)
    mem_store8(t, 113, 11)
    mem_store8(t, 114, 7)
    mem_store8(t, 115, 14)
    mem_store8(t, 116, 12)
    mem_store8(t, 117, 1)
    mem_store8(t, 118, 3)
    mem_store8(t, 119, 9)
    mem_store8(t, 120, 5)
    mem_store8(t, 121, 0)
    mem_store8(t, 122, 15)
    mem_store8(t, 123, 4)
    mem_store8(t, 124, 8)
    mem_store8(t, 125, 6)
    mem_store8(t, 126, 2)
    mem_store8(t, 127, 10)
    // σ8
    mem_store8(t, 128, 6)
    mem_store8(t, 129, 15)
    mem_store8(t, 130, 14)
    mem_store8(t, 131, 9)
    mem_store8(t, 132, 11)
    mem_store8(t, 133, 3)
    mem_store8(t, 134, 0)
    mem_store8(t, 135, 8)
    mem_store8(t, 136, 12)
    mem_store8(t, 137, 2)
    mem_store8(t, 138, 13)
    mem_store8(t, 139, 7)
    mem_store8(t, 140, 1)
    mem_store8(t, 141, 4)
    mem_store8(t, 142, 10)
    mem_store8(t, 143, 5)
    // σ9
    mem_store8(t, 144, 10)
    mem_store8(t, 145, 2)
    mem_store8(t, 146, 8)
    mem_store8(t, 147, 4)
    mem_store8(t, 148, 7)
    mem_store8(t, 149, 6)
    mem_store8(t, 150, 1)
    mem_store8(t, 151, 5)
    mem_store8(t, 152, 15)
    mem_store8(t, 153, 11)
    mem_store8(t, 154, 9)
    mem_store8(t, 155, 14)
    mem_store8(t, 156, 3)
    mem_store8(t, 157, 12)
    mem_store8(t, 158, 13)
    mem_store8(t, 159, 0)
    return 0
}

// G 前半：a += b + x；d = rotr(d^a, 32)；c += d；b = rotr(b^c, 24)
fn _b2b_g1(v: int, a: int, b: int, c: int, d: int, x: int) -> int {
    let va = mem_load64(v, a) + mem_load64(v, b) + x
    mem_store64(v, a, va)
    let za = mem_load64(v, d) ^ va
    mem_store64(v, d, (za >>> 32) | (za << 32))
    let vc = mem_load64(v, c) + mem_load64(v, d)
    mem_store64(v, c, vc)
    let zb = mem_load64(v, b) ^ vc
    mem_store64(v, b, (zb >>> 24) | (zb << 40))
    return 0
}

// G 后半：a += b + y；d = rotr(d^a, 16)；c += d；b = rotr(b^c, 63)
fn _b2b_g2(v: int, a: int, b: int, c: int, d: int, y: int) -> int {
    let va = mem_load64(v, a) + mem_load64(v, b) + y
    mem_store64(v, a, va)
    let za = mem_load64(v, d) ^ va
    mem_store64(v, d, (za >>> 16) | (za << 48))
    let vc = mem_load64(v, c) + mem_load64(v, d)
    mem_store64(v, c, vc)
    let zb = mem_load64(v, b) ^ vc
    mem_store64(v, b, (zb >>> 63) | (zb << 1))
    return 0
}

// 压缩一个 128 字节块：t = 已处理总量（含本块），last = 1 置终止标记
fn _b2b_compress(h: int, m: int, t: int, last: int, st: int) -> int {
    let v = mem_alloc(16 * 8)
    let mut i = 0
    while i < 8 {
        mem_store64(v, i, mem_load64(h, i))
        i = i + 1
    }
    mem_store64(v, 8, B2B_IV0)
    mem_store64(v, 9, B2B_IV1)
    mem_store64(v, 10, B2B_IV2)
    mem_store64(v, 11, B2B_IV3)
    mem_store64(v, 12, B2B_IV4 ^ t)
    mem_store64(v, 13, B2B_IV5)                       // t 高位（顺序模式 64 位够）
    mem_store64(v, 14, B2B_IV6)
    mem_store64(v, 15, B2B_IV7)
    if last == 1 {
        mem_store64(v, 14, mem_load64(v, 14) ^ 0xFFFFFFFFFFFFFFFF)
    }
    let mut r = 0
    while r < 12 {
        let so = (r % 10) * 16
        // 列步
        _b2b_g1(v, 0, 4, 8, 12, mem_load64(m, mem_load8(st, so)))
        _b2b_g2(v, 0, 4, 8, 12, mem_load64(m, mem_load8(st, so + 1)))
        _b2b_g1(v, 1, 5, 9, 13, mem_load64(m, mem_load8(st, so + 2)))
        _b2b_g2(v, 1, 5, 9, 13, mem_load64(m, mem_load8(st, so + 3)))
        _b2b_g1(v, 2, 6, 10, 14, mem_load64(m, mem_load8(st, so + 4)))
        _b2b_g2(v, 2, 6, 10, 14, mem_load64(m, mem_load8(st, so + 5)))
        _b2b_g1(v, 3, 7, 11, 15, mem_load64(m, mem_load8(st, so + 6)))
        _b2b_g2(v, 3, 7, 11, 15, mem_load64(m, mem_load8(st, so + 7)))
        // 对角步
        _b2b_g1(v, 0, 5, 10, 15, mem_load64(m, mem_load8(st, so + 8)))
        _b2b_g2(v, 0, 5, 10, 15, mem_load64(m, mem_load8(st, so + 9)))
        _b2b_g1(v, 1, 6, 11, 12, mem_load64(m, mem_load8(st, so + 10)))
        _b2b_g2(v, 1, 6, 11, 12, mem_load64(m, mem_load8(st, so + 11)))
        _b2b_g1(v, 2, 7, 8, 13, mem_load64(m, mem_load8(st, so + 12)))
        _b2b_g2(v, 2, 7, 8, 13, mem_load64(m, mem_load8(st, so + 13)))
        _b2b_g1(v, 3, 4, 9, 14, mem_load64(m, mem_load8(st, so + 14)))
        _b2b_g2(v, 3, 4, 9, 14, mem_load64(m, mem_load8(st, so + 15)))
        r = r + 1
    }
    let mut j = 0
    while j < 8 {
        mem_store64(h, j, mem_load64(h, j) ^ mem_load64(v, j) ^ mem_load64(v, j + 8))
        j = j + 1
    }
    mem_free(v, 16 * 8)
    return 0
}

// 内部：data 起 n 字节 + key（≤64B）+ outlen → 摘要缓冲（调用方 free(outlen)）
fn _b2b_hash(data: int, n: int, key: int, keylen: int, outlen: int) -> int {
    let h = mem_alloc(64)
    mem_store64(h, 0, B2B_IV0)
    mem_store64(h, 1, B2B_IV1)
    mem_store64(h, 2, B2B_IV2)
    mem_store64(h, 3, B2B_IV3)
    mem_store64(h, 4, B2B_IV4)
    mem_store64(h, 5, B2B_IV5)
    mem_store64(h, 6, B2B_IV6)
    mem_store64(h, 7, B2B_IV7)
    // 参数块：digest_length | key_length<<8 | fanout=1<<16 | depth=1<<24
    mem_store64(h, 0, mem_load64(h, 0) ^ (0x01010000 ^ (keylen << 8) ^ outlen))
    let st = mem_alloc(160)
    _b2b_sigma_tab(st)
    let mut t = 0
    if keylen > 0 {
        let kb = mem_alloc(128)
        mem_zero(kb, 128)
        mem_copy(kb, key, keylen)
        if n == 0 {
            // keyed 空消息：key 块即最后一块（参考实现的 update 缓冲语义）
            t = 128
            _b2b_compress(h, kb, t, 1, st)
            mem_free(kb, 128)
            mem_free(st, 160)
            let out = mem_alloc(outlen)
            mem_copy(out, h, outlen)
            mem_free(h, 64)
            return out
        }
        t = 128
        _b2b_compress(h, kb, t, 0, st)
        mem_free(kb, 128)
    }
    let mut off = 0
    let mut rem = n
    while rem > 128 {
        t = t + 128
        _b2b_compress(h, data + off, t, 0, st)
        off = off + 128
        rem = rem - 128
    }
    let last = mem_alloc(128)
    mem_zero(last, 128)
    mem_copy(last, data + off, rem)
    t = t + rem
    _b2b_compress(h, last, t, 1, st)
    mem_free(last, 128)
    mem_free(st, 160)
    let out = mem_alloc(outlen)
    mem_copy(out, h, outlen)
    mem_free(h, 64)
    return out
}

/// BLAKE2b 摘要缓冲区（outlen 字节，大端，含 0 字节不能当 str；用完 mem_free(d, outlen)）
pub fn blake2b_str(s: str, outlen: int) -> int {
    return _b2b_hash(s, len(s), s, 0, outlen)
}

/// BLAKE2b-512 十六进制（128 位小写）
pub fn blake2b_hex(s: str) -> str {
    return _b2b_hex_out(s, 64)
}

/// BLAKE2b 变长输出十六进制（outlen 1..64）
pub fn blake2b_hex_n(s: str, outlen: int) -> str {
    return _b2b_hex_out(s, outlen)
}

/// keyed BLAKE2b-512 十六进制（key ≤ 64 字节）
pub fn blake2b_keyed_hex(s: str, key: str) -> str {
    let dig = _b2b_hash(s, len(s), key, len(key), 64)
    let out = mem_alloc(129)
    let mut i = 0
    while i < 64 {
        let v = mem_load8(dig, i)
        let hi = v >> 4
        let lo = v & 15
        if hi < 10 {
            mem_store8(out, i * 2, 48 + hi)
        } else {
            mem_store8(out, i * 2, 87 + hi)
        }
        if lo < 10 {
            mem_store8(out, i * 2 + 1, 48 + lo)
        } else {
            mem_store8(out, i * 2 + 1, 87 + lo)
        }
        i = i + 1
    }
    mem_store8(out, 128, 0)
    let hex = mem_str(out, 128)
    mem_free(out, 129)
    mem_free(dig, 64)
    return hex
}

// 内部：无 key 变长输出 → 十六进制
fn _b2b_hex_out(s: str, outlen: int) -> str {
    let dig = _b2b_hash(s, len(s), s, 0, outlen)
    let out = mem_alloc(outlen * 2 + 1)
    let mut i = 0
    while i < outlen {
        let v = mem_load8(dig, i)
        let hi = v >> 4
        let lo = v & 15
        if hi < 10 {
            mem_store8(out, i * 2, 48 + hi)
        } else {
            mem_store8(out, i * 2, 87 + hi)
        }
        if lo < 10 {
            mem_store8(out, i * 2 + 1, 48 + lo)
        } else {
            mem_store8(out, i * 2 + 1, 87 + lo)
        }
        i = i + 1
    }
    mem_store8(out, outlen * 2, 0)
    let hex = mem_str(out, outlen * 2)
    mem_free(out, outlen * 2 + 1)
    mem_free(dig, outlen)
    return hex
}
