// std/url.qma —— URL 解析 / 百分号编解码（RFC 3986 子集），Quelmara 自实现
//
// 为什么需要它：HTTP 服务端的路由、query 取值、Location 拼接、出站请求构造，
// 全都绕不开 URL。没有它，每个业务函数都要手写一遍字符扫描。
//
import std.str

// 语义边界（写进文档）：
//   * 只解析绝对/相对 URL，不做 IDN（国际化域名）与 punycode；
//   * IPv6 字面量 host 用方括号形式 `[::1]:8080` 原样返回（不去括号）；
//   * url_decode 把 '+' 解成空格（表单语义）；url_decode_path 不处理 '+'；
//   * 编码只保留 unreserved（A-Za-z0-9 - . _ ~），其余按大写 %XX。

// ---------------------------------------------------------------------------
// 百分号解码
// ---------------------------------------------------------------------------

fn _hex_val(b: int) -> int {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    return -1
}

fn _decode(s: str, plus_as_space: int) -> str {
    let n = len(s)
    // v1.14 快路径：无 %XX 且（不需要 + 转换或无 +）→ 原串零拷贝返回。
    // query_get 每个_kv 都调 decode，绝大多数 key/value 无编码——
    // 这个快路径吃掉 url 基准的大头。
    let mut has_esc = 0
    let mut i = 0
    while i < n {
        let c = s[i]
        if c == 37 {
            has_esc = 1
        }
        if c == 43 && plus_as_space == 1 {
            has_esc = 1
        }
        i = i + 1
    }
    if has_esc == 0 {
        return s
    }
    // v1.14 慢路径：先数输出长度，str_alloc 一次分配 + store8 填充
    // （替代 vec push 的每字节 call）
    let mut on = 0
    let mut i = 0
    while i < n {
        let c = s[i]
        if c == 37 && i + 2 < n {
            let hi = _hex_val(s[i + 1])
            let lo = _hex_val(s[i + 2])
            if hi >= 0 && lo >= 0 {
                on = on + 1
                i = i + 3
            } else {
                on = on + 1
                i = i + 1
            }
        } else {
            on = on + 1
            i = i + 1
        }
    }
    let w = str_alloc(on)
    let mut wi = 0
    let mut i = 0
    while i < n {
        let c = s[i]
        if c == 37 && i + 2 < n {
            let hi = _hex_val(s[i + 1])
            let lo = _hex_val(s[i + 2])
            if hi >= 0 && lo >= 0 {
                mem_store8(w, wi, hi * 16 + lo)
                wi = wi + 1
                i = i + 3
            } else {
                mem_store8(w, wi, c)
                wi = wi + 1
                i = i + 1
            }
        } else if c == 43 && plus_as_space == 1 {
            mem_store8(w, wi, 32)
            wi = wi + 1
            i = i + 1
        } else {
            mem_store8(w, wi, c)
            wi = wi + 1
            i = i + 1
        }
    }
    return w
}

/// url_decode(s)：%XX 解码 + '+' -> 空格（application/x-www-form-urlencoded）
pub fn url_decode(s: str) -> str {
    return _decode(s, 1)
}

/// url_decode_path(s)：只解 %XX，保留 '+'（路径语义）
pub fn url_decode_path(s: str) -> str {
    return _decode(s, 0)
}

// ---------------------------------------------------------------------------
// 百分号编码
// ---------------------------------------------------------------------------

fn _is_unreserved(b: int) -> bool {
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b >= 48 && b <= 57 { return true }
    if b == 45 { return true }    // -
    if b == 46 { return true }    // .
    if b == 95 { return true }    // _
    if b == 126 { return true }   // ~
    return false
}

fn _hex_push(out: vec[int], b: int) -> int {
    let hi = b >> 4
    let lo = b & 15
    out.push(37)
    if hi < 10 {
        out.push(48 + hi)
    } else {
        out.push(55 + hi)
    }
    if lo < 10 {
        out.push(48 + lo)
    } else {
        out.push(55 + lo)
    }
    return 0
}

/// url_encode(s)：保留 unreserved，其余 %XX（空格 -> %20，不是 +）
pub fn url_encode(s: str) -> str {
    let n = len(s)
    let out = vec[int].new(n * 3 + 1)
    let mut i = 0
    while i < n {
        let b = s[i]
        if _is_unreserved(b) {
            out.push(b)
        } else {
            _hex_push(out, b)
        }
        i = i + 1
    }
    return str_from_bytes(out)
}

/// url_encode_query(s)：同 url_encode，但空格编成 '+'（表单提交语义）
pub fn url_encode_query(s: str) -> str {
    let n = len(s)
    let out = vec[int].new(n * 3 + 1)
    let mut i = 0
    while i < n {
        let b = s[i]
        if b == 32 {
            out.push(43)
        } else if _is_unreserved(b) {
            out.push(b)
        } else {
            _hex_push(out, b)
        }
        i = i + 1
    }
    return str_from_bytes(out)
}

// ---------------------------------------------------------------------------
// 分段解析：每个函数独立扫描，返回对应片段（找不到返回 ""）
//   例：https://user@example.com:8443/a/b?q=1#top
// ---------------------------------------------------------------------------

/// scheme（小写化，: 之前）；无 scheme 返回 ""
pub fn url_scheme(u: str) -> str {
    let n = len(u)
    let mut i = 0
    while i < n {
        let c = u[i]
        if c == 58 {
            // ':' 前面必须是合法 scheme 字符，否则视为相对路径
            if i == 0 {
                return ""
            }
            return str_lower(substr(u, 0, i))
        }
        if c == 47 || c == 63 || c == 35 {
            return ""
        }
        if c == 46 && i == 0 {
            return ""          // "./a" 这类相对路径没有 scheme
        }
        i = i + 1
    }
    return ""
}

// scheme 之后的起点（"://" 或 ":" 之后）
fn _after_scheme(u: str) -> int {
    let n = len(u)
    let mut i = 0
    while i < n {
        if u[i] == 58 {
            if i + 2 < n && u[i + 1] == 47 && u[i + 2] == 47 {
                return i + 3
            }
            return i + 1
        }
        if u[i] == 47 || u[i] == 63 || u[i] == 35 {
            return 0
        }
        i = i + 1
    }
    return 0
}

// authority 结束位置（'/' '?' '#' 或串尾）
fn _authority_end(u: str, from: int) -> int {
    let n = len(u)
    let mut i = from
    while i < n {
        let c = u[i]
        if c == 47 || c == 63 || c == 35 {
            return i
        }
        i = i + 1
    }
    return n
}

/// host（去掉 userinfo 与端口；IPv6 保留方括号）
pub fn url_host(u: str) -> str {
    let start = _after_scheme(u)
    let end = _authority_end(u, start)
    if end <= start {
        return ""
    }
    // 跳过 userinfo@
    let mut at = -1
    let mut i = start
    while i < end {
        if u[i] == 64 {
            at = i
        }
        i = i + 1
    }
    let mut hs = start
    if at >= 0 {
        hs = at + 1
    }
    // IPv6：[...]
    if hs < end && u[hs] == 91 {
        let mut j = hs
        while j < end {
            if u[j] == 93 {
                return substr(u, hs, j - hs + 1)
            }
            j = j + 1
        }
        return substr(u, hs, end - hs)
    }
    // host:port
    let mut colon = -1
    let mut k = hs
    while k < end {
        if u[k] == 58 {
            colon = k
        }
        k = k + 1
    }
    if colon >= 0 {
        return substr(u, hs, colon - hs)
    }
    return substr(u, hs, end - hs)
}

/// 端口；缺省返回 -1
pub fn url_port(u: str) -> int {
    // v2.02：authority 一遍扫完（原来 _after_scheme + _authority_end + 找 '@' +
    // 找 ']' + 找 ':' 共 5 遍），端口数字就地解析（不再 substr + to_int）。
    let start = _after_scheme(u)
    let n = len(u)
    let mut end = n
    let mut at = -1
    let mut colon = -1
    let mut br = 0
    let mut i = start
    while i < n {
        let c = u[i]
        if c == 47 || c == 63 || c == 35 {
            end = i
            i = n
        } else {
            if c == 64 {
                at = i
                colon = -1        // userinfo 里的 ':' 不算端口
            } else if c == 91 {
                br = 1            // IPv6 字面量起点
            } else if c == 93 {
                br = 0
            } else if c == 58 && br == 0 {
                colon = i
            }
            i = i + 1
        }
    }
    if at >= 0 && colon >= 0 && colon < at {
        colon = -1
    }
    if colon < 0 || colon + 1 >= end {
        return -1
    }
    let mut d = colon + 1
    let mut port = 0
    while d < end {
        let c = u[d]
        if c < 48 || c > 57 {
            return -1         // 非法端口不 fail-fast，按"未指定"处理
        }
        port = port * 10 + (c - 48)
        d = d + 1
    }
    if d == colon + 1 {
        return -1
    }
    return port
}

/// path（不含 query/fragment）；没有 path 返回 "/" 之外的空串
pub fn url_path(u: str) -> str {
    let n = len(u)
    let start = _after_scheme(u)
    let mut i = start
    // 跳到 path 起点
    while i < n {
        if u[i] == 47 || u[i] == 63 || u[i] == 35 {
            break
        }
        i = i + 1
    }
    if i >= n || u[i] != 47 {
        return ""
    }
    let ps = i
    while i < n {
        if u[i] == 63 || u[i] == 35 {
            break
        }
        i = i + 1
    }
    return substr(u, ps, i - ps)
}

/// 原始 query（不含 '?' 与 '#')
pub fn url_query(u: str) -> str {
    let n = len(u)
    let mut i = 0
    while i < n {
        if u[i] == 63 {
            let qs = i + 1
            let mut j = qs
            while j < n {
                if u[j] == 35 {
                    break
                }
                j = j + 1
            }
            return substr(u, qs, j - qs)
        }
        i = i + 1
    }
    return ""
}

/// 取 '#' 之后的片段（不含 '#'）；没有 '#' 返回空串。
pub fn url_fragment(u: str) -> str {
    let n = len(u)
    let mut i = 0
    while i < n {
        if u[i] == 35 {
            return substr(u, i + 1, n - i - 1)
        }
        i = i + 1
    }
    return ""
}

/// 区间 [from, from+count) 里有没有 '%'——决定要不要走 decode（v2.02）
fn _has_pct(s: str, from: int, count: int) -> int {
    let mut i = from
    let end = from + count
    while i < end {
        if s[i] == 37 {
            return 1
        }
        i = i + 1
    }
    return 0
}

/// query 里取某个键（解码后返回）；不存在返回 ""
/// 语义：同名键取第一个；键值以 '&' 分隔，'=' 可省略（值按 ""）
pub fn url_query_get(u: str, key: str) -> str {
    // v2.02：直接在 u 上扫（不再先 url_query 分配一份 query 子串），
    // 且只有区间里真的含 '%' 才走 decode 比较——绝大多数 key/value 无编码，
    // 这一条把"每个 _kv 都 substr + decode"的两份分配全省掉。
    let n = len(u)
    let kn = len(key)
    let mut qpos = -1
    let mut i = 0
    while i < n {
        if u[i] == 63 {
            qpos = i
            break
        }
        i = i + 1
    }
    if qpos < 0 {
        return ""
    }
    let qs = qpos + 1
    let mut qe = n
    let mut k = qs
    while k < n {
        if u[k] == 35 {
            qe = k
            break
        }
        k = k + 1
    }
    let mut start = qs
    let mut j = qs
    while j <= qe {
        if j == qe || u[j] == 38 {
            let mut eq = -1
            let mut k = start
            while k < j {
                if u[k] == 61 {
                    eq = k
                    k = j
                } else {
                    k = k + 1
                }
            }
            let mut has_eq = 0
            if eq >= 0 {
                has_eq = 1
            }
            let mut klen = j - start
            if has_eq == 1 {
                klen = eq - start
            }
            let mut hit = 0
            if klen == kn {
                if mem_cmp(mem_ptr(u, start), key, kn) == 0 {
                    hit = 1
                }
            }
            if hit == 0 && _has_pct(u, start, klen) == 1 {
                if url_decode(substr(u, start, klen)) == key {
                    hit = 1
                }
            }
            if hit == 1 {
                if has_eq == 0 {
                    return ""
                }
                let vs = eq + 1
                let vn = j - vs
                if _has_pct(u, vs, vn) == 1 {
                    return url_decode(substr(u, vs, vn))
                }
                return substr(u, vs, vn)
            }
            start = j + 1
        }
        j = j + 1
    }
    return ""
}

/// 便捷：拼 query（已编码的 key/value）
pub fn url_join_query(base: str, key: str, val: str) -> str {
    let mut sep = "?"
    let n = len(base)
    let mut i = 0
    while i < n {
        if base[i] == 63 {
            sep = "&"
            i = n
        } else {
            i = i + 1
        }
    }
    return base + sep + url_encode(key) + "=" + url_encode(val)
}
