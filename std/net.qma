// std/net.qma —— 网络第一格：tcp_* 内建的过程式包装（v1.3）
// SPEC 的 net.TcpServer reactor（回调结构体 + epoll/IOCP）仍是目标模型；
// 这一层先给阻塞式过程式 API，echo 类服务十行内可写。
//
// v2.07：IPv6 接入。listen6 建 AF_INET6 监听（IPV6_V6ONLY=0，同一端口同时接
// IPv4 映射连接）；connect 的 family 放宽到 AF_UNSPEC，IPv6 字面量与 AAAA 记录
// 直接可用，失败沿 getaddrinfo 链表回退（"localhost" 先给 ::1 时 v4 服务端仍可连）。
// 对端地址文本在 std/net/addr.qma（peer_ip / peer_port，需单独 import）。

/// 在 port 上建监听 socket（tcp_listen 内建），返回监听 fd；失败直接 fail-fast。
/// 只接 IPv4（绑 0.0.0.0）；要双栈用 listen6。
pub fn listen(port: int) -> int {
    return tcp_listen(port)
}

/// 在 port 上建 **IPv6 双栈**监听（tcp_listen6 内建，AF_INET6 + IPV6_V6ONLY=0），
/// 返回监听 fd；同一个 socket 同时接 IPv6 与 IPv4（映射成 ::ffff:a.b.c.d）连接。
/// 失败直接 fail-fast（与 listen 同口径）。仅 Windows PE。
pub fn listen6(port: int) -> int {
    return tcp_listen6(port)
}

/// 阻塞接受一个连接，返回连接 fd。
pub fn accept(fd: int) -> int {
    return tcp_accept(fd)
}

/// 客户端连接（v1.25 / v2.07）：host 可以是域名、IPv4 字面量或 IPv6 字面量
/// （"::1"，不带方括号）。Windows 走系统 DNS（getaddrinfo + hosts）并按返回的
/// 地址家族逐个尝试；Linux 暂未实现（编译期报错）。失败 fail-fast。
pub fn connect(host: str, port: int) -> int {
    return tcp_connect(host, port)
}

/// 把 str 的全部字节写到连接上，返回写入字节数（短写要自己续写）。
pub fn send(conn: int, data: str) -> int {
    return tcp_send(conn, data)
}

/// 把 `data` **全部**写出，返回实际写出的字节数（v3.07）。
///
/// 为什么需要它：`send(conn, data)` 是**一次** `send()` 系统调用，返回值是
/// "这次写进去多少"，**可能小于 `len(data)`**（短写）。短写不是错误，是 TCP
/// 的正常行为：内核发送缓冲区快满时只接受一部分；大块数据（> 64 KB）几乎
/// 一定分多次。拿 `send` 当"发完了"用，会在高吞吐或大包场景丢尾巴。
///
/// **实现：零拷贝指针推进**。第一版用 `substr(data, sent, ...)` 切尾巴，
/// 每轮把剩余数据**复制一遍** —— 4 MB 负载直接 O(n²)、堆爆 512 MB 上限
/// （实测 `heap_limit_mb exceeded`）。现在改用 `tcp_send_n(fd, ptr+off, n)`：
/// 裸指针 + 长度，不构造新 str、不扫 strlen。`str_ptr` 取数据指针是零成本的
/// （str 的值本身就是数据指针，长度在 ptr-8）。
///
/// **返回值语义**：成功返回 `len(data)`；中途出错返回已写出的字节数。
/// 调用方用 `== len(data)` 判断是否发全。
///
/// 边界：无超时（`tcp_send_n` 阻塞）；对端一直不收且缓冲区满时会一直等
/// （这是 TCP 的背压语义，不是 bug）。
pub fn send_all(conn: int, data: str) -> int {
    let total = len(data)
    if total == 0 {
        return 0
    }
    let base = str_ptr(data)
    let mut sent = 0
    while sent < total {
        let n = tcp_send_n(conn, mem_ptr(base, sent), total - sent)
        if n <= 0 {
            break
        }
        sent = sent + n
    }
    return sent
}

// 带超时的批量接收三件套（v3.08）：recv_all_to / recv_all_max_to / recv_exact_to。
//
// 与 recv_all / recv_all_max / recv_exact 的语义一一对应，唯一区别是每次
// tcp_recv_to 都带 ms 毫秒超时：收到就继续，超时就当"对端不再发"，立即停止
// 并返回已读到的内容。
//
// 为什么必须加：recv_all 会一直读到对端 FIN。对端发了一半就挂住不关（半开
// 连接、慢客户端、恶意对端）时它永久阻塞——v3.08 实测 12 s 未返回。TCP 上
// 没有"对方还在不在"的心跳，只有超时。

/// 读到对端关闭**或超时**，返回已读到的全部（v3.08）。
///
/// 与 `recv_all` 的唯一区别是每次 `tcp_recv_to` 都有 `ms` 毫秒超时：超时后
/// 把它当作"对端不再发"，**立即停止**并返回已读到的部分（可能为空串）。
///
/// 返回值语义与 `recv_exact` 的短读一致：调用方用 `len(result) == n` 判断
/// 是否读满，不要假定"返回了就是收全了"。
pub fn recv_all_to(conn: int, chunk: int, ms: int) -> str {
    if chunk <= 0 {
        chunk = 4096
    }
    let out = ""
    while true {
        let part = tcp_recv_to(conn, chunk, ms)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 读到关闭或超时，最多 `maxbytes` 字节（v3.08）。
pub fn recv_all_max_to(conn: int, chunk: int, maxbytes: int, ms: int) -> str {
    if chunk <= 0 {
        chunk = 4096
    }
    if maxbytes <= 0 {
        return ""
    }
    let out = ""
    while len(out) < maxbytes {
        let want = maxbytes - len(out)
        let cap = chunk
        if want < cap {
            cap = want
        }
        let part = tcp_recv_to(conn, cap, ms)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 精确读 `n` 字节，超时即停并返回已读到的部分（v3.08）。
pub fn recv_exact_to(conn: int, n: int, chunk: int, ms: int) -> str {
    if n <= 0 {
        return ""
    }
    if chunk <= 0 {
        chunk = 4096
    }
    let out = ""
    while len(out) < n {
        let want = n - len(out)
        let cap = chunk
        if want < cap {
            cap = want
        }
        let part = tcp_recv_to(conn, cap, ms)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 从连接读最多 cap 字节并返回 str；对端关闭时返回空串。
pub fn recv(conn: int, cap: int) -> str {
    return tcp_recv(conn, cap)
}

/// 读到**对端关闭**为止，返回全部字节（v3.06）。
///
/// `chunk` 是每次 `tcp_recv` 的上限（建议 4096–65536）。为什么需要它：
/// `recv(conn, cap)` 是**单次** `recv()`，内核缓冲区里有多少就返回多少，
/// 可能远少于 `cap`——拿它当"读完"用，在慢链路或大数据包上会截断。
/// 这里循环读到返回空串（对端 FIN）为止。
///
/// 边界：**没有总长度上限**——对端一直发就会一直读。需要上限的调用方
/// 用 `recv_until_close_max`。也没有超时（`tcp_recv` 是阻塞的）。
pub fn recv_all(conn: int, chunk: int) -> str {
    if chunk <= 0 {
        chunk = 4096
    }
    let out = ""
    while true {
        let part = tcp_recv(conn, chunk)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 读到对端关闭，但最多读 `maxbytes` 字节（v3.06）。
///
/// 与 `recv_all` 的区别：**有上限**，到上限就返回，不会因为对端一直发而
/// 无限增长内存。适合"读 HTTP 响应体但有 Content-Length 上限"这类场景。
pub fn recv_all_max(conn: int, chunk: int, maxbytes: int) -> str {
    if chunk <= 0 {
        chunk = 4096
    }
    if maxbytes <= 0 {
        return ""
    }
    let out = ""
    while len(out) < maxbytes {
        let want = maxbytes - len(out)
        let cap = chunk
        if want < cap {
            cap = want
        }
        let part = tcp_recv(conn, cap)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 精确读 `n` 字节；对端提前关闭时返回**已读到的部分**（v3.06）。
///
/// 这是 HTTP/1.1 的 `Content-Length` 与 TLS 记录层都要的语义：
/// "我知道正好要 n 字节，给我读满"。用 `len(result) == n` 判断是否读满。
pub fn recv_exact(conn: int, n: int, chunk: int) -> str {
    if n <= 0 {
        return ""
    }
    if chunk <= 0 {
        chunk = 4096
    }
    let out = ""
    while len(out) < n {
        let want = n - len(out)
        let cap = chunk
        if want < cap {
            cap = want
        }
        let part = tcp_recv(conn, cap)
        if len(part) == 0 {
            break
        }
        out = out + part
    }
    return out
}

/// 关闭连接 fd（不返回值）。
pub fn close_conn(fd: int) {
    tcp_close(fd)
}

// 高并发 reactor 不在本模块：v2.12 起它在 `std/net/reactor.qma`
// （`import std.net.reactor` 拿 `serve` / `net_serve`）。
// 分开的理由是**别把 IOCP 绑定钉进 net 模块**：reactor 的 `@ffi` 声明在非 Windows
// 目标是**声明期**硬失败，一旦并进来，将来 Linux 侧接上 epoll 也永远编不过。
// 如实说明：`tcp_*` 内建目前**也只有 Windows 实现**（`tcp_listen` 在 native 上
// 会报"无法发射指令 ('winapi', … 'WSAStartup')"），所以 `import std.net` 现在编
// native 一样失败——但失败点是"调用内建的发射期"，不是模块声明，Linux 侧补上
// epoll 之后本模块立刻可用。与 `std/log` / `std/logfile` 的拆法同源。
