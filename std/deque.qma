// std/deque.qma —— 双端队列（v1.29）
//
// 为什么需要它：RingBuf（std/ds）是**定容**的，满了 push 返回 -1；
// 任务队列 / 滑动窗口 / BFS 前沿这三种形状都要求"两端进出 + 自动扩容"，
// 用 RingBuf 写出来的代码每处都要处理"满了怎么办"。
//
// 布局：状态块 = 4 字头（cap / len / head / 保留）+ cap 个 8 字节槽
//   逻辑下标 i 的物理位置 = (head + i) % cap
//   push_front 只动 head，push_back 只动 len —— 两端都是 O(1)
//   扩容时按逻辑顺序重排到新块（head 归 0），旧块 mem_free 归还
//
// 句柄为什么是"盒子"：扩容后状态块地址会变，而调用方手里只有句柄。
// 所以 dq_new 返回一个 8 字节的**指针盒**，扩容时只更新盒子里的指针，
// 句柄值永远不变（调用方不用写 `d = dq_push(d, v)`）。
//
// 语义纪律：
//   * pop_* 空队列返回 -1（调用方先用 dq_len 判别）；
//   * dq_get 越界返回 -1（不做 fail-fast：队列长度是运行期数据，不是编程错误）；
//   * dq_clear 只把 len 归零，不释放内存（复用容量）。

fn _dq_cap_at(st: int) -> int {
    return mem_load64(st, 0)
}

fn _dq_len_at(st: int) -> int {
    return mem_load64(st, 1)
}

fn _dq_head_at(st: int) -> int {
    return mem_load64(st, 2)
}

fn _dq_state(cell: int) -> int {
    return mem_load64(cell, 0)
}

fn _dq_block(cap: int) -> int {
    let st = mem_alloc(32 + cap * 8)
    mem_store64(st, 0, cap)
    mem_store64(st, 1, 0)
    mem_store64(st, 2, 0)
    return st
}

/// dq_new(cap) -> int：cap 是最小初始容量（<4 按 4 算）
pub fn dq_new(cap: int) -> int {
    if cap < 4 {
        cap = 4
    }
    let st = _dq_block(cap)
    let cell = mem_alloc(8)
    mem_store64(cell, 0, st)
    return cell
}

/// 当前元素个数（逻辑长度，不含空洞）。
pub fn dq_len(d: int) -> int {
    return _dq_len_at(_dq_state(d))
}

/// 当前容量（槽数，不是字节）；扩容后翻倍，dq_free 才归还。
pub fn dq_cap(d: int) -> int {
    return _dq_cap_at(_dq_state(d))
}

fn _dq_slot(st: int, phys: int) -> int {
    return 4 + phys
}

fn _dq_phys(st: int, i: int) -> int {
    let cap = _dq_cap_at(st)
    return (_dq_head_at(st) + i) % cap
}

// _dq_grow(st) -> int：容量翻倍，按逻辑顺序重排，返回新块（旧块已释放）
fn _dq_grow(st: int) -> int {
    let cap = _dq_cap_at(st)
    let n = _dq_len_at(st)
    let ncap = cap * 2
    let ns = _dq_block(ncap)
    let mut i = 0
    while i < n {
        let v = mem_load64(st, _dq_slot(st, _dq_phys(st, i)))
        mem_store64(ns, _dq_slot(ns, i), v)
        i = i + 1
    }
    mem_store64(ns, 1, n)
    mem_store64(ns, 2, 0)
    mem_free(st, 32 + cap * 8)
    return ns
}

/// 尾部入队；满则 2 倍扩容并重排（句柄不变，不需要 `d = ...` 回写）。
/// 恒返回 0（失败只可能是内存不足，直接崩）。
pub fn dq_push_back(d: int, v: int) -> int {
    let mut st = _dq_state(d)
    let cap = _dq_cap_at(st)
    if _dq_len_at(st) >= cap {
        st = _dq_grow(st)
        mem_store64(d, 0, st)
    }
    let n = _dq_len_at(st)
    mem_store64(st, _dq_slot(st, _dq_phys(st, n)), v)
    mem_store64(st, 1, n + 1)
    return 0
}

/// 头部入队；满则扩容。只改 head，两端都是 O(1)。
/// 恒返回 0。
pub fn dq_push_front(d: int, v: int) -> int {
    let mut st = _dq_state(d)
    let cap = _dq_cap_at(st)
    if _dq_len_at(st) >= cap {
        st = _dq_grow(st)
        mem_store64(d, 0, st)
    }
    let cap2 = _dq_cap_at(st)
    let head = _dq_head_at(st)
    let nh = (head + cap2 - 1) % cap2
    mem_store64(st, 2, nh)
    mem_store64(st, _dq_slot(st, nh), v)
    mem_store64(st, 1, _dq_len_at(st) + 1)
    return 0
}

/// 头部出队并返回该值；空队列返回 -1（先用 dq_len 判别）。
pub fn dq_pop_front(d: int) -> int {
    let st = _dq_state(d)
    let n = _dq_len_at(st)
    if n == 0 {
        return -1
    }
    let cap = _dq_cap_at(st)
    let head = _dq_head_at(st)
    let v = mem_load64(st, _dq_slot(st, head))
    mem_store64(st, 2, (head + 1) % cap)
    mem_store64(st, 1, n - 1)
    return v
}

/// 尾部出队并返回该值；空队列返回 -1。
pub fn dq_pop_back(d: int) -> int {
    let st = _dq_state(d)
    let n = _dq_len_at(st)
    if n == 0 {
        return -1
    }
    let v = mem_load64(st, _dq_slot(st, _dq_phys(st, n - 1)))
    mem_store64(st, 1, n - 1)
    return v
}

/// dq_peek_front / dq_peek_back：看但不弹（空返回 -1）
pub fn dq_peek_front(d: int) -> int {
    let st = _dq_state(d)
    if _dq_len_at(st) == 0 {
        return -1
    }
    return mem_load64(st, _dq_slot(st, _dq_head_at(st)))
}

/// 看尾部元素但不弹出；空队列返回 -1。
pub fn dq_peek_back(d: int) -> int {
    let st = _dq_state(d)
    let n = _dq_len_at(st)
    if n == 0 {
        return -1
    }
    return mem_load64(st, _dq_slot(st, _dq_phys(st, n - 1)))
}

/// 按逻辑下标 i（0 = 队头）取值；i<0 或 i>=len 返回 -1，不做 fail-fast。
pub fn dq_get(d: int, i: int) -> int {
    let st = _dq_state(d)
    let n = _dq_len_at(st)
    if i < 0 || i >= n {
        return -1
    }
    return mem_load64(st, _dq_slot(st, _dq_phys(st, i)))
}

/// 按逻辑下标 i 赋值；越界返回 -1，成功返回 0。
pub fn dq_set(d: int, i: int, v: int) -> int {
    let st = _dq_state(d)
    let n = _dq_len_at(st)
    if i < 0 || i >= n {
        return -1
    }
    mem_store64(st, _dq_slot(st, _dq_phys(st, i)), v)
    return 0
}

/// 清空（len 与 head 归零），**不释放内存**——容量留给下次复用。
pub fn dq_clear(d: int) -> int {
    let st = _dq_state(d)
    mem_store64(st, 1, 0)
    mem_store64(st, 2, 0)
    return 0
}

/// dq_free(d)：释放状态块与句柄盒（句柄之后不可再用）
pub fn dq_free(d: int) -> int {
    let st = _dq_state(d)
    mem_free(st, 32 + _dq_cap_at(st) * 8)
    mem_free(d, 8)
    return 0
}
