// std/p256.qma —— NIST P-256（secp256r1）ECDSA 验签 —— v1.22
//
// 为什么需要它：TLS 1.3 里最常见的证书签名算法是 ecdsa_secp256r1_sha256。
// X25519 只解决密钥交换；证书验签必须靠 ECDSA，这是 https 客户端最后一块密码学。
//
// 表示：8×32 位 limb（小端）。64 位乘法的位模式精确，lo/hi 用 `& M` / `>>> 32` 取。
// 域运算：Montgomery 乘法（SOS 形式），R = 2^256。
//   p = 2^256 - 2^224 + 2^192 + 2^96 - 1
//   n = FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
//   选 Montgomery 而不是特殊折约：p 的形状不适合逐位折，通用算法更不容易写错。
//
// 点表示：**扁平 vec[int]（24 limb）**：X=0..7，Y=8..15，Z=16..23（Jacobian）。
//   不用 vec[vec[int]] 是为了避开嵌套句柄的类型标签问题，也更快。
//
// 边界：只做验签（不做签名/密钥生成）；只支持 SHA-256 摘要；未压缩点。

// ---------------------------------------------------------------------------
// 常量
// ---------------------------------------------------------------------------

const P_N0INV = 0x00000001        // -p^-1 mod 2^32
const P_N0INV_N = 0xEE00BC4F      // -n^-1 mod 2^32

fn _p_limb_p(i: int) -> int {
    if i == 0 { return 0xFFFFFFFF }
    if i == 1 { return 0xFFFFFFFF }
    if i == 2 { return 0xFFFFFFFF }
    if i == 3 { return 0x00000000 }
    if i == 4 { return 0x00000000 }
    if i == 5 { return 0x00000000 }
    if i == 6 { return 0x00000001 }
    if i == 7 { return 0xFFFFFFFF }
    return 0
}

fn _p_limb_n(i: int) -> int {
    if i == 0 { return 0xFC632551 }
    if i == 1 { return 0xF3B9CAC2 }
    if i == 2 { return 0xA7179E84 }
    if i == 3 { return 0xBCE6FAAD }
    if i == 4 { return 0xFFFFFFFF }
    if i == 5 { return 0xFFFFFFFF }
    if i == 6 { return 0x00000000 }
    if i == 7 { return 0xFFFFFFFF }
    return 0
}

fn _p_limb_b(i: int) -> int {
    if i == 0 { return 0x27D2604B }
    if i == 1 { return 0x3BCE3C3E }
    if i == 2 { return 0xCC53B0F6 }
    if i == 3 { return 0x651D06B0 }
    if i == 4 { return 0x769886BC }
    if i == 5 { return 0xB3EBBD55 }
    if i == 6 { return 0xAA3A93E7 }
    if i == 7 { return 0x5AC635D8 }
    return 0
}

fn _p_limb_gx(i: int) -> int {
    if i == 0 { return 0xD898C296 }
    if i == 1 { return 0xF4A13945 }
    if i == 2 { return 0x2DEB33A0 }
    if i == 3 { return 0x77037D81 }
    if i == 4 { return 0x63A440F2 }
    if i == 5 { return 0xF8BCE6E5 }
    if i == 6 { return 0xE12C4247 }
    if i == 7 { return 0x6B17D1F2 }
    return 0
}

fn _p_limb_gy(i: int) -> int {
    if i == 0 { return 0x37BF51F5 }
    if i == 1 { return 0xCBB64068 }
    if i == 2 { return 0x6B315ECE }
    if i == 3 { return 0x2BCE3357 }
    if i == 4 { return 0x7C0F9E16 }
    if i == 5 { return 0x8EE7EB4A }
    if i == 6 { return 0xFE1A7F9B }
    if i == 7 { return 0x4FE342E2 }
    return 0
}

// R2 = 2^512 mod p
fn _p_limb_r2(i: int) -> int {
    if i == 0 { return 0x00000003 }
    if i == 1 { return 0x00000000 }
    if i == 2 { return 0xFFFFFFFF }
    if i == 3 { return 0xFFFFFFFB }
    if i == 4 { return 0xFFFFFFFE }
    if i == 5 { return 0xFFFFFFFF }
    if i == 6 { return 0xFFFFFFFD }
    if i == 7 { return 0x00000004 }
    return 0
}

// R2 = 2^512 mod n
fn _p_limb_r2n(i: int) -> int {
    if i == 0 { return 0xBE79EEA2 }
    if i == 1 { return 0x83244C95 }
    if i == 2 { return 0x49BD6FA6 }
    if i == 3 { return 0x4699799C }
    if i == 4 { return 0x2B6BEC59 }
    if i == 5 { return 0x2845B239 }
    if i == 6 { return 0xF3D95620 }
    if i == 7 { return 0x66E12D94 }
    return 0
}

fn _p_vec_p() -> vec[int] {
    let v = vec[int].new(9)
    let mut i = 0
    while i < 8 {
        v.push(_p_limb_p(i))
        i = i + 1
    }
    return v
}

fn _p_vec_n() -> vec[int] {
    let v = vec[int].new(9)
    let mut i = 0
    while i < 8 {
        v.push(_p_limb_n(i))
        i = i + 1
    }
    return v
}

fn _p_vec_r2(is_n: int) -> vec[int] {
    let v = vec[int].new(9)
    let mut i = 0
    while i < 8 {
        if is_n == 1 {
            v.push(_p_limb_r2n(i))
        } else {
            v.push(_p_limb_r2(i))
        }
        i = i + 1
    }
    return v
}

// ---------------------------------------------------------------------------
// 基础工具
// ---------------------------------------------------------------------------

fn _p_zeros(n: int) -> vec[int] {
    let v = vec[int].new(n + 1)
    let mut i = 0
    while i < n {
        v.push(0)
        i = i + 1
    }
    return v
}

fn _p_copy(a: vec[int]) -> vec[int] {
    let r = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        r.set(i, a.get(i))
        i = i + 1
    }
    return r
}

fn _p_is_zero(a: vec[int]) -> int {
    let mut i = 0
    while i < 8 {
        if a.get(i) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn _p_cmp(a: vec[int], b: vec[int]) -> int {
    let mut i = 7
    while i >= 0 {
        if a.get(i) < b.get(i) {
            return -1
        }
        if a.get(i) > b.get(i) {
            return 1
        }
        i = i - 1
    }
    return 0
}

// t[start..start+8] += a * bi，返回进位
fn _p_mac(t: vec[int], a: vec[int], bi: int, start: int) -> int {
    let mut carry = 0
    let mut j = 0
    while j < 8 {
        let prod = a.get(j) * bi
        let lo = prod & 0xFFFFFFFF
        let hi = (prod >>> 32) & 0xFFFFFFFF
        let idx = start + j
        let s1 = t.get(idx) + lo
        let c1 = s1 >>> 32
        let s2 = (s1 & 0xFFFFFFFF) + carry
        let c2 = s2 >>> 32
        t.set(idx, s2 & 0xFFFFFFFF)
        carry = hi + c1 + c2
        j = j + 1
    }
    return carry
}

fn _p_addcarry(t: vec[int], start: int, c0: int) {
    let mut c = c0
    let mut k = start
    while c != 0 {
        let s = t.get(k) + c
        t.set(k, s & 0xFFFFFFFF)
        c = s >>> 32
        k = k + 1
    }
}

// 若 t[start..start+8]（含第 9 limb 高位）>= m 则减 m
fn _p_cond_sub(t: vec[int], start: int, m: vec[int]) {
    let d = _p_zeros(8)
    let mut borrow = 0
    let mut j = 0
    while j < 8 {
        let mut x = t.get(start + j) - m.get(j) - borrow
        if x < 0 {
            x = x + 0x100000000
            borrow = 1
        } else {
            borrow = 0
        }
        d.set(j, x)
        j = j + 1
    }
    let hi = t.get(start + 8) - borrow
    if hi < 0 {
        return
    }
    j = 0
    while j < 8 {
        t.set(start + j, d.get(j))
        j = j + 1
    }
    t.set(start + 8, hi)
}

// ---------------------------------------------------------------------------
// Montgomery 乘法（SOS）：a*b*R^-1 mod m
// ---------------------------------------------------------------------------

fn _p_mont(a: vec[int], b: vec[int], m: vec[int], n0inv: int) -> vec[int] {
    let t = _p_zeros(18)
    let mut i = 0
    while i < 8 {
        let c = _p_mac(t, a, b.get(i), i)
        _p_addcarry(t, i + 8, c)
        i = i + 1
    }
    i = 0
    while i < 8 {
        let mm = (t.get(i) * n0inv) & 0xFFFFFFFF
        if mm != 0 {
            let c = _p_mac(t, m, mm, i)
            _p_addcarry(t, i + 8, c)
        }
        i = i + 1
    }
    _p_cond_sub(t, 8, m)
    let r = _p_zeros(8)
    i = 0
    while i < 8 {
        r.set(i, t.get(8 + i))
        i = i + 1
    }
    return r
}

fn _p_add(a: vec[int], b: vec[int], m: vec[int]) -> vec[int] {
    let t = _p_zeros(9)
    let mut carry = 0
    let mut i = 0
    while i < 8 {
        let s = a.get(i) + b.get(i) + carry
        t.set(i, s & 0xFFFFFFFF)
        carry = s >>> 32
        i = i + 1
    }
    t.set(8, carry)
    _p_cond_sub(t, 0, m)
    let r = _p_zeros(8)
    i = 0
    while i < 8 {
        r.set(i, t.get(i))
        i = i + 1
    }
    return r
}

// a - b mod m（a,b < m）
fn _p_sub(a: vec[int], b: vec[int], m: vec[int]) -> vec[int] {
    let r = _p_zeros(8)
    let mut borrow = 0
    let mut i = 0
    while i < 8 {
        let mut x = a.get(i) - b.get(i) - borrow
        if x < 0 {
            x = x + 0x100000000
            borrow = 1
        } else {
            borrow = 0
        }
        r.set(i, x)
        i = i + 1
    }
    if borrow == 1 {
        let mut carry = 0
        i = 0
        while i < 8 {
            let s = r.get(i) + m.get(i) + carry
            r.set(i, s & 0xFFFFFFFF)
            carry = s >>> 32
            i = i + 1
        }
    }
    return r
}

fn _p_mul2(a: vec[int], m: vec[int]) -> vec[int] {
    return _p_add(a, a, m)
}

fn _p_mul4(a: vec[int], m: vec[int]) -> vec[int] {
    return _p_mul2(_p_mul2(a, m), m)
}

fn _p_mul8(a: vec[int], m: vec[int]) -> vec[int] {
    return _p_mul2(_p_mul4(a, m), m)
}

fn _p_mul3(a: vec[int], m: vec[int]) -> vec[int] {
    return _p_add(_p_mul2(a, m), a, m)
}

fn _p_one_raw() -> vec[int] {
    let v = _p_zeros(8)
    v.set(0, 1)
    return v
}

// 普通值 → Montgomery 域
fn _p_to_mont(x: vec[int], is_n: int, m: vec[int], n0inv: int) -> vec[int] {
    return _p_mont(x, _p_vec_r2(is_n), m, n0inv)
}

// Montgomery 域 → 普通值
fn _p_from_mont(x: vec[int], m: vec[int], n0inv: int) -> vec[int] {
    return _p_mont(x, _p_one_raw(), m, n0inv)
}

// 求逆：a^(m-2)（Montgomery 域内自洽）
fn _p_inv(a: vec[int], is_n: int, m: vec[int], n0inv: int) -> vec[int] {
    let e = _p_copy(m)
    let mut d0 = e.get(0) - 2
    if d0 < 0 {
        d0 = d0 + 0x100000000
        let mut k = 1
        let mut borrow = 1
        while borrow == 1 && k < 8 {
            let mut x = e.get(k) - borrow
            if x < 0 {
                x = x + 0x100000000
                borrow = 1
            } else {
                borrow = 0
            }
            e.set(k, x)
            k = k + 1
        }
    }
    e.set(0, d0)
    let mut r = _p_to_mont(_p_one_raw(), is_n, m, n0inv)
    let mut t = 255
    while t >= 0 {
        r = _p_mont(r, r, m, n0inv)
        if ((e.get(t >> 5) >> (t & 31)) & 1) == 1 {
            r = _p_mont(r, a, m, n0inv)
        }
        t = t - 1
    }
    return r
}

// ---------------------------------------------------------------------------
// 字节编解码（32 字节大端）
// ---------------------------------------------------------------------------

fn _p_from_bytes(s: str) -> vec[int] {
    let r = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        let base = 28 - i * 4
        let mut v = 0
        let mut j = 0
        while j < 4 {
            v = (v << 8) | s[base + j]
            j = j + 1
        }
        r.set(i, v)
        i = i + 1
    }
    return r
}

fn _p_to_bytes(a: vec[int]) -> str {
    let out = vec[int].new(33)
    let mut i = 7
    while i >= 0 {
        let v = a.get(i)
        out.push((v >>> 24) & 0xFF)
        out.push((v >>> 16) & 0xFF)
        out.push((v >>> 8) & 0xFF)
        out.push(v & 0xFF)
        i = i - 1
    }
    return str_from_bytes(out)
}

// ---------------------------------------------------------------------------
// 曲线点（扁平 24 limb：X 0..7, Y 8..15, Z 16..23）
// ---------------------------------------------------------------------------

fn _p_pt_new() -> vec[int] {
    return _p_zeros(24)
}

fn _p_pt_inf() -> vec[int] {
    return _p_zeros(24)
}

fn _p_pt_x(p: vec[int]) -> vec[int] {
    let r = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        r.set(i, p.get(i))
        i = i + 1
    }
    return r
}

fn _p_pt_y(p: vec[int]) -> vec[int] {
    let r = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        r.set(i, p.get(8 + i))
        i = i + 1
    }
    return r
}

fn _p_pt_z(p: vec[int]) -> vec[int] {
    let r = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        r.set(i, p.get(16 + i))
        i = i + 1
    }
    return r
}

fn _p_pt_set(p: vec[int], off: int, v: vec[int]) {
    let mut i = 0
    while i < 8 {
        p.set(off + i, v.get(i))
        i = i + 1
    }
}

fn _p_pt_is_inf(p: vec[int]) -> int {
    return _p_is_zero(_p_pt_z(p))
}

// 倍点（a = -3）：dbl-2001-b
fn _p_double(p: vec[int], m: vec[int], n0inv: int) -> vec[int] {
    if _p_pt_is_inf(p) == 1 {
        return _p_pt_inf()
    }
    let x = _p_pt_x(p)
    let y = _p_pt_y(p)
    let z = _p_pt_z(p)
    if _p_is_zero(y) == 1 {
        return _p_pt_inf()
    }
    let delta = _p_mont(z, z, m, n0inv)
    let gamma = _p_mont(y, y, m, n0inv)
    let beta = _p_mont(x, gamma, m, n0inv)
    let alpha = _p_mul3(_p_mont(_p_sub(x, delta, m), _p_add(x, delta, m), m, n0inv), m)
    let x3 = _p_sub(_p_mont(alpha, alpha, m, n0inv), _p_mul8(beta, m), m)
    let z3 = _p_sub(_p_sub(_p_mont(_p_add(y, z, m), _p_add(y, z, m), m, n0inv), gamma, m),
                    delta, m)
    let y3 = _p_sub(_p_mont(alpha, _p_sub(_p_mul4(beta, m), x3, m), m, n0inv),
                    _p_mul8(_p_mont(gamma, gamma, m, n0inv), m), m)
    let r = _p_pt_new()
    _p_pt_set(r, 0, x3)
    _p_pt_set(r, 8, y3)
    _p_pt_set(r, 16, z3)
    return r
}

// 点加：add-2007-bl
fn _p_add_pt(p: vec[int], q: vec[int], m: vec[int], n0inv: int) -> vec[int] {
    if _p_pt_is_inf(p) == 1 {
        return _p_copy_pt(q)
    }
    if _p_pt_is_inf(q) == 1 {
        return _p_copy_pt(p)
    }
    let x1 = _p_pt_x(p)
    let y1 = _p_pt_y(p)
    let z1 = _p_pt_z(p)
    let x2 = _p_pt_x(q)
    let y2 = _p_pt_y(q)
    let z2 = _p_pt_z(q)
    let z1z1 = _p_mont(z1, z1, m, n0inv)
    let z2z2 = _p_mont(z2, z2, m, n0inv)
    let u1 = _p_mont(x1, z2z2, m, n0inv)
    let u2 = _p_mont(x2, z1z1, m, n0inv)
    let s1 = _p_mont(y1, _p_mont(z2, z2z2, m, n0inv), m, n0inv)
    let s2 = _p_mont(y2, _p_mont(z1, z1z1, m, n0inv), m, n0inv)
    if _p_cmp(u1, u2) == 0 {
        if _p_cmp(s1, s2) == 0 {
            return _p_double(p, m, n0inv)
        }
        return _p_pt_inf()
    }
    let h = _p_sub(u2, u1, m)
    let i2 = _p_mul2(h, m)
    let i = _p_mont(i2, i2, m, n0inv)
    let j = _p_mont(h, i, m, n0inv)
    let r = _p_mul2(_p_sub(s2, s1, m), m)
    let v = _p_mont(u1, i, m, n0inv)
    let x3 = _p_sub(_p_sub(_p_mont(r, r, m, n0inv), j, m), _p_mul2(v, m), m)
    let y3 = _p_sub(_p_mont(r, _p_sub(v, x3, m), m, n0inv), _p_mul2(_p_mont(s1, j, m, n0inv), m), m)
    let z3 = _p_mont(_p_sub(_p_sub(_p_mont(_p_add(z1, z2, m), _p_add(z1, z2, m), m, n0inv),
                                   z1z1, m), z2z2, m), h, m, n0inv)
    let out = _p_pt_new()
    _p_pt_set(out, 0, x3)
    _p_pt_set(out, 8, y3)
    _p_pt_set(out, 16, z3)
    return out
}

fn _p_copy_pt(p: vec[int]) -> vec[int] {
    let r = _p_pt_new()
    let mut i = 0
    while i < 24 {
        r.set(i, p.get(i))
        i = i + 1
    }
    return r
}

// 标量乘（k 为普通 8 limb）
fn _p_mul_pt(p: vec[int], k: vec[int], m: vec[int], n0inv: int) -> vec[int] {
    let mut r = _p_pt_inf()
    let mut t = 255
    while t >= 0 {
        r = _p_double(r, m, n0inv)
        if ((k.get(t >> 5) >> (t & 31)) & 1) == 1 {
            r = _p_add_pt(r, p, m, n0inv)
        }
        t = t - 1
    }
    return r
}

// ---------------------------------------------------------------------------
// 公开 API
// ---------------------------------------------------------------------------

// 公钥是否在曲线上：y^2 == x^3 - 3x + b
pub fn p256_on_curve(pub_x: str, pub_y: str) -> int {
    let m = _p_vec_p()
    let x = _p_to_mont(_p_from_bytes(pub_x), 0, m, P_N0INV)
    let y = _p_to_mont(_p_from_bytes(pub_y), 0, m, P_N0INV)
    let b = _p_to_mont(_p_vec_b(), 0, m, P_N0INV)
    let lhs = _p_mont(y, y, m, P_N0INV)
    let x3 = _p_mont(_p_mont(x, x, m, P_N0INV), x, m, P_N0INV)
    let rhs = _p_add(_p_sub(x3, _p_mul3(x, m), m), b, m)
    if _p_cmp(lhs, rhs) == 0 {
        return 1
    }
    return 0
}

fn _p_vec_b() -> vec[int] {
    let v = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        v.set(i, _p_limb_b(i))
        i = i + 1
    }
    return v
}

// ECDSA P-256 验签：输入均 32 字节大端；返回 1 = 有效
pub fn ecdsa_p256_verify(pub_x: str, pub_y: str, hash: str, r_sig: str, s_sig: str) -> int {
    if len(pub_x) != 32 || len(pub_y) != 32 || len(hash) != 32 ||
       len(r_sig) != 32 || len(s_sig) != 32 {
        assert(false, "ecdsa_p256_verify: 参数必须都是 32 字节")
    }
    let m = _p_vec_p()
    let mn = _p_vec_n()
    let r_raw = _p_from_bytes(r_sig)
    let s_raw = _p_from_bytes(s_sig)
    if _p_is_zero(r_raw) == 1 || _p_is_zero(s_raw) == 1 {
        return 0
    }
    if _p_cmp(r_raw, mn) >= 0 || _p_cmp(s_raw, mn) >= 0 {
        return 0
    }
    if p256_on_curve(pub_x, pub_y) == 0 {
        return 0
    }
    let qx = _p_to_mont(_p_from_bytes(pub_x), 0, m, P_N0INV)
    let qy = _p_to_mont(_p_from_bytes(pub_y), 0, m, P_N0INV)
    // w = s^-1 mod n
    let s_m = _p_to_mont(s_raw, 1, mn, P_N0INV_N)
    let w = _p_inv(s_m, 1, mn, P_N0INV_N)
    let e_m = _p_to_mont(_p_from_bytes(hash), 1, mn, P_N0INV_N)
    let r_m = _p_to_mont(r_raw, 1, mn, P_N0INV_N)
    let u1 = _p_from_mont(_p_mont(e_m, w, mn, P_N0INV_N), mn, P_N0INV_N)
    let u2 = _p_from_mont(_p_mont(r_m, w, mn, P_N0INV_N), mn, P_N0INV_N)
    // G 与 Q
    let g = _p_pt_new()
    _p_pt_set(g, 0, _p_to_mont(_p_vec_limb(0), 0, m, P_N0INV))
    _p_pt_set(g, 8, _p_to_mont(_p_vec_limb(1), 0, m, P_N0INV))
    _p_pt_set(g, 16, _p_to_mont(_p_one_raw(), 0, m, P_N0INV))
    let q = _p_pt_new()
    _p_pt_set(q, 0, qx)
    _p_pt_set(q, 8, qy)
    _p_pt_set(q, 16, _p_to_mont(_p_one_raw(), 0, m, P_N0INV))
    let p1 = _p_mul_pt(g, u1, m, P_N0INV)
    let p2 = _p_mul_pt(q, u2, m, P_N0INV)
    let rr = _p_add_pt(p1, p2, m, P_N0INV)
    if _p_pt_is_inf(rr) == 1 {
        return 0
    }
    // x = X / Z^2 → 普通值
    let z2 = _p_mont(_p_pt_z(rr), _p_pt_z(rr), m, P_N0INV)
    let z2i = _p_inv(z2, 0, m, P_N0INV)
    let xa = _p_from_mont(_p_mont(_p_pt_x(rr), z2i, m, P_N0INV), m, P_N0INV)
    let mut xm = _p_copy(xa)
    if _p_cmp(xm, mn) >= 0 {
        xm = _p_sub(xm, mn, mn)
    }
    if _p_cmp(xm, r_raw) == 0 {
        return 1
    }
    return 0
}

// G 坐标（0 = Gx, 1 = Gy）
fn _p_vec_limb(which: int) -> vec[int] {
    let v = _p_zeros(8)
    let mut i = 0
    while i < 8 {
        if which == 0 {
            v.set(i, _p_limb_gx(i))
        } else {
            v.set(i, _p_limb_gy(i))
        }
        i = i + 1
    }
    return v
}
