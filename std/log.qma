// std/log.qma —— 极简日志（v1.16，v1.19 补级别过滤）
// 每行：[级别][启动以来毫秒] 消息。输出到 stdout（print 通道，行缓冲）。
// 级别过滤（v1.19）：log_set_level(0..3) 控制输出量，默认 0（全开）。
// stderr 通道、绝对时间戳、轮转——登记 docs/07-gaps.md。
// ---------------------------------------------------------------------------

import std.core
import std.str

const _T0_W = 9          // static_word(9) = 首条日志的 now_ns（相对时间基准）
const _LVL_W = 10        // static_word(10) = 当前级别阈值

// 级别：0=全部  1=只 warn/error  2=只 error  3=静默
pub fn log_set_level(lv: int) -> int {
    mem_store64(static_word(_LVL_W), 0, lv)
    return lv
}

pub fn log_level() -> int {
    return mem_load64(static_word(_LVL_W), 0)
}

fn _log_line(tag: str, msg: str) {
    let st = static_word(_T0_W)
    let mut t0 = mem_load64(st, 0)
    if t0 == 0 {
        t0 = now_ns()
        mem_store64(st, 0, t0)
    }
    let ms = (now_ns() - t0) / 1000000
    // 一行：[tag][ms] msg\n —— str_alloc 批量构造（v1.14 原语）
    let tn = len(tag)
    let mn = len(msg)
    let line = str_alloc(tn + mn + 1)
    let w = mem_ptr(line, 0)
    mem_copy(w, tag, tn)
    w = mem_ptr(w, tn)
    // [ms] 数字：手写 itoa（reverse 顺序写入缓冲尾部再拷）——用 to_str()
    let ms_s = ms.to_str()
    mem_copy(w, "[", 1)
    w = mem_ptr(w, 1)
    mem_copy(w, ms_s, len(ms_s))
    w = mem_ptr(w, len(ms_s))
    mem_copy(w, "] ", 2)
    w = mem_ptr(w, 2)
    mem_copy(w, msg, mn)
    w = mem_ptr(w, mn)
    mem_store8(w, 0, 10)
    print(line)
}

pub fn log_info(msg: str) {
    if log_level() >= 1 {
        return
    }
    _log_line("[INFO]", msg)
}

pub fn log_warn(msg: str) {
    if log_level() >= 2 {
        return
    }
    _log_line("[WARN]", msg)
}

pub fn log_error(msg: str) {
    if log_level() >= 3 {
        return
    }
    _log_line("[ERROR]", msg)
}

// log_kv(tag, msg, kv)：结构化字段（v1.17g）。
// kv 是**交替**的 key/value 串（k1,v1,k2,v2,...），行格式：
//   [INFO][启动ms] msg k1=v1 k2=v2
// 值非 str 时调用方先 to_str()（与 log_info 同约定）。
pub fn log_kv(tag: str, msg: str, kv: vec[str]) -> int {
    let n = len(kv)
    let tn = len(tag)
    let mn = len(msg)
    let mut kvs = 0
    let mut i = 0
    while i < n {
        kvs = kvs + len(kv.get(i)) + 1   // +1 等号或空格
        i = i + 1
    }
    // [tag][ms] msg + 字段（t0 惰性基准与 _log_line 同款 static_word）
    let st = static_word(_T0_W)
    let mut t0 = mem_load64(st, 0)
    if t0 == 0 {
        t0 = now_ns()
        mem_store64(st, 0, t0)
    }
    let ms = (now_ns() - t0) / 1000000
    let msn = len(ms.to_str())
    let line = str_alloc(tn + 7 + msn + 1 + mn + kvs)
    let w = mem_ptr(line, 0)
    mem_copy(w, "[", 1)
    w = mem_ptr(w, 1)
    mem_copy(w, tag, tn)
    w = mem_ptr(w, tn)
    mem_copy(w, "][", 2)
    w = mem_ptr(w, 2)
    let mstr = ms.to_str()
    mem_copy(w, mstr, msn)
    w = mem_ptr(w, msn)
    mem_copy(w, "] ", 2)
    w = mem_ptr(w, 2)
    mem_copy(w, msg, mn)
    w = mem_ptr(w, mn)
    let mut i = 0
    while i < n {
        if i % 2 == 0 {
            mem_copy(w, " ", 1)
            w = mem_ptr(w, 1)
        } else {
            mem_copy(w, "=", 1)
            w = mem_ptr(w, 1)
        }
        let item = kv.get(i)
        let ln = len(item)
        mem_copy(w, item, ln)
        w = mem_ptr(w, ln)
        i = i + 1
    }
    mem_copy(w, "\n", 1)
    print(line)
    return 0
}
