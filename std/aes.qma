// std/aes.qma —— AES-128 分组密码 + GCM（NIST SP 800-38D），Quelmara 自实现
//
// 为什么需要它：TLS 1.3 唯一强制套件是 TLS_AES_128_GCM_SHA256。没有 AEAD，
// https/wss 无从谈起。这是 docs/TLS.md Phase A 的第二块地基（第一块是 std/sha256）。
//
// 实现要点：
//   * S-box **不写字面量表**（\xNN 高位字节有已知误编译），改为运行时按
//     GF(2^8) 求逆 + 仿射变换生成，缓存到 static_word(12) 指向的 512 字节块；
//   * GF(2^128) 乘法用逐位算法（两个 64 位字 + 0xE1 归约），128 次/块——
//     正确性优先，性能留给后续轮次；
//   * 只做 128 位密钥（TLS 1.3 强制套件），AES-192/256 未做。
//
// static_word 占用：0–11 已归协议库（见 std/net/core.qma），本库用 12。

const AES_TAB_W = 12          // static_word(12) = sbox/inv_sbox 表指针

// ---------------------------------------------------------------------------
// 表生成（GF(2^8)，生成元 3）
// ---------------------------------------------------------------------------

fn _xtime(a: int) -> int {
    let v = (a << 1) & 0xFF
    if (a & 0x80) != 0 {
        v = v ^ 0x1B
    }
    return v
}

fn _rotl8(x: int, n: int) -> int {
    return ((x << n) | (x >> (8 - n))) & 0xFF
}

// 建表：base[0..256) = sbox，base[256..512) = inv_sbox，
// base[512..4608) = Te0..Te3（4 × 256 × 4B，T-table 加密用）
fn _build_tables() -> int {
    let base = mem_alloc(4608)
    let exp = mem_alloc(256)
    let log = mem_alloc(256)
    mem_zero(log, 256)
    let mut x = 1
    let mut i = 0
    while i < 255 {
        mem_store8(exp, i, x)
        mem_store8(log, x, i)
        x = x ^ _xtime(x)          // 乘 3
        i = i + 1
    }
    let mut a = 0
    while a < 256 {
        let mut inv = 0
        if a != 0 {
            let l = mem_load8(log, a)
            let mut idx = 255 - l
            if idx >= 255 {
                idx = idx - 255          // 255 ≡ 0 (mod 255)：a=1 时 log=0
            }
            inv = mem_load8(exp, idx)
        }
        // 仿射：b ^ rotl(b,1) ^ rotl(b,2) ^ rotl(b,3) ^ rotl(b,4) ^ 0x63
        let s = (inv ^ _rotl8(inv, 1) ^ _rotl8(inv, 2) ^ _rotl8(inv, 3)
                 ^ _rotl8(inv, 4) ^ 0x63) & 0xFF
        mem_store8(base, a, s)
        mem_store8(base, 256 + s, a)
        a = a + 1
    }
    mem_free(exp, 256)
    mem_free(log, 256)
    // Te0[x] = [2s, s, s, 3s]（大端语义）；Te1..3 是 Te0 的字节旋转
    a = 0
    while a < 256 {
        let sb = mem_load8(base, a)
        let s2 = _xtime(sb)
        let s3 = s2 ^ sb
        let w = (s2 << 24) | (sb << 16) | (sb << 8) | s3
        let w1 = _ror32(w, 8)
        let w2 = _ror32(w, 16)
        let w3 = _ror32(w, 24)
        _put32(base, 512 + a * 4, w)
        _put32(base, 512 + 1024 + a * 4, w1)
        _put32(base, 512 + 2048 + a * 4, w2)
        _put32(base, 512 + 3072 + a * 4, w3)
        a = a + 1
    }
    return base
}

fn _ror32(v: int, n: int) -> int {
    return ((v >>> n) | (v << (32 - n))) & 0xFFFFFFFF
}

fn _put32(p: int, off: int, v: int) -> int {
    mem_store8(p, off, v & 0xFF)
    mem_store8(p, off + 1, (v >>> 8) & 0xFF)
    mem_store8(p, off + 2, (v >>> 16) & 0xFF)
    mem_store8(p, off + 3, (v >>> 24) & 0xFF)
    return 0
}

fn _bswap32(v: int) -> int {
    return ((v & 0xFF) << 24) | ((v & 0xFF00) << 8) |
           ((v >>> 8) & 0xFF00) | ((v >>> 24) & 0xFF)
}

fn _tables() -> int {
    let p = mem_load64(static_word(AES_TAB_W), 0)
    if p != 0 {
        return p
    }
    let t = _build_tables()
    mem_store64(static_word(AES_TAB_W), 0, t)
    return t
}

fn _sbox(b: int) -> int {
    return mem_load8(_tables(), b)
}

fn _inv_sbox(b: int) -> int {
    return mem_load8(_tables(), 256 + b)
}

// ---------------------------------------------------------------------------
// 密钥扩展：16 字节 key -> 176 字节轮密钥（11 组）
// ---------------------------------------------------------------------------

fn _rcon(i: int) -> int {
    // 1,2,4,8,16,32,64,128,27,54
    let mut v = 1
    let mut k = 1
    while k < i {
        v = _xtime(v)
        k = k + 1
    }
    return v
}

pub fn aes128_expand(key: str, rk: int) -> int {
    let mut i = 0
    while i < 16 {
        mem_store8(rk, i, key[i])
        i = i + 1
    }
    let mut w = 4
    while w < 44 {
        let b0 = mem_load8(rk, (w - 1) * 4)
        let b1 = mem_load8(rk, (w - 1) * 4 + 1)
        let b2 = mem_load8(rk, (w - 1) * 4 + 2)
        let b3 = mem_load8(rk, (w - 1) * 4 + 3)
        let mut t0 = b0
        let mut t1 = b1
        let mut t2 = b2
        let mut t3 = b3
        if (w - (w / 4) * 4) == 0 {
            // rotword + subword + rcon
            t0 = _sbox(b1) ^ _rcon(w / 4)
            t1 = _sbox(b2)
            t2 = _sbox(b3)
            t3 = _sbox(b0)
        }
        mem_store8(rk, w * 4, mem_load8(rk, (w - 4) * 4) ^ t0)
        mem_store8(rk, w * 4 + 1, mem_load8(rk, (w - 4) * 4 + 1) ^ t1)
        mem_store8(rk, w * 4 + 2, mem_load8(rk, (w - 4) * 4 + 2) ^ t2)
        mem_store8(rk, w * 4 + 3, mem_load8(rk, (w - 4) * 4 + 3) ^ t3)
        w = w + 1
    }
    return 0
}

// 状态按列主序：st[4*c + r]（AES 规范输入顺序即字节序）
fn _add_round_key(st: int, rk: int, round: int) -> int {
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, mem_load8(st, i) ^ mem_load8(rk, round * 16 + i))
        i = i + 1
    }
    return 0
}

fn _sub_bytes(st: int) -> int {
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, _sbox(mem_load8(st, i)))
        i = i + 1
    }
    return 0
}

fn _inv_sub_bytes(st: int) -> int {
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, _inv_sbox(mem_load8(st, i)))
        i = i + 1
    }
    return 0
}

fn _shift_rows(st: int) -> int {
    let tmp = mem_alloc(16)
    let mut c = 0
    while c < 4 {
        let mut r = 0
        while r < 4 {
            mem_store8(tmp, 4 * c + r, mem_load8(st, 4 * ((c + r) - ((c + r) / 4) * 4) + r))
            r = r + 1
        }
        c = c + 1
    }
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, mem_load8(tmp, i))
        i = i + 1
    }
    mem_free(tmp, 16)
    return 0
}

fn _inv_shift_rows(st: int) -> int {
    let tmp = mem_alloc(16)
    let mut c = 0
    while c < 4 {
        let mut r = 0
        while r < 4 {
            // 右移 r：源列 = (c - r + 4) % 4
            let mut sc = c - r
            if sc < 0 {
                sc = sc + 4
            }
            mem_store8(tmp, 4 * c + r, mem_load8(st, 4 * sc + r))
            r = r + 1
        }
        c = c + 1
    }
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, mem_load8(tmp, i))
        i = i + 1
    }
    mem_free(tmp, 16)
    return 0
}

fn _gmul(a: int, b: int) -> int {
    let mut p = 0
    let mut x = a
    let mut y = b
    let mut i = 0
    while i < 8 {
        if (y & 1) != 0 {
            p = p ^ x
        }
        x = _xtime(x)
        y = y >> 1
        i = i + 1
    }
    return p & 0xFF
}

fn _mix_columns(st: int) -> int {
    let mut c = 0
    while c < 4 {
        let a0 = mem_load8(st, 4 * c)
        let a1 = mem_load8(st, 4 * c + 1)
        let a2 = mem_load8(st, 4 * c + 2)
        let a3 = mem_load8(st, 4 * c + 3)
        mem_store8(st, 4 * c, _gmul(a0, 2) ^ _gmul(a1, 3) ^ a2 ^ a3)
        mem_store8(st, 4 * c + 1, a0 ^ _gmul(a1, 2) ^ _gmul(a2, 3) ^ a3)
        mem_store8(st, 4 * c + 2, a0 ^ a1 ^ _gmul(a2, 2) ^ _gmul(a3, 3))
        mem_store8(st, 4 * c + 3, _gmul(a0, 3) ^ a1 ^ a2 ^ _gmul(a3, 2))
        c = c + 1
    }
    return 0
}

fn _inv_mix_columns(st: int) -> int {
    let mut c = 0
    while c < 4 {
        let a0 = mem_load8(st, 4 * c)
        let a1 = mem_load8(st, 4 * c + 1)
        let a2 = mem_load8(st, 4 * c + 2)
        let a3 = mem_load8(st, 4 * c + 3)
        mem_store8(st, 4 * c, _gmul(a0, 14) ^ _gmul(a1, 11) ^ _gmul(a2, 13) ^ _gmul(a3, 9))
        mem_store8(st, 4 * c + 1, _gmul(a0, 9) ^ _gmul(a1, 14) ^ _gmul(a2, 11) ^ _gmul(a3, 13))
        mem_store8(st, 4 * c + 2, _gmul(a0, 13) ^ _gmul(a1, 9) ^ _gmul(a2, 14) ^ _gmul(a3, 11))
        mem_store8(st, 4 * c + 3, _gmul(a0, 11) ^ _gmul(a1, 13) ^ _gmul(a2, 9) ^ _gmul(a3, 14))
        c = c + 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 分组加解密：in/out 都是 16 字节缓冲，rk 是 176 字节
// ---------------------------------------------------------------------------

pub fn aes128_encrypt_block(inp: int, out: int, rk: int) -> int {
    let st = mem_alloc(16)
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, mem_load8(inp, i))
        i = i + 1
    }
    _add_round_key(st, rk, 0)
    let mut r = 1
    while r < 10 {
        _sub_bytes(st)
        _shift_rows(st)
        _mix_columns(st)
        _add_round_key(st, rk, r)
        r = r + 1
    }
    _sub_bytes(st)
    _shift_rows(st)
    _add_round_key(st, rk, 10)
    i = 0
    while i < 16 {
        mem_store8(out, i, mem_load8(st, i))
        i = i + 1
    }
    mem_free(st, 16)
    return 0
}

// T-table 加密（v1.28）：每轮 16 次 32 位查表 + 异或，替代逐字节 SubBytes/MixColumns。
// 只用于 GCM 的 CTR 路径；解密仍走逐字节实现（GCM 不需要 AES 解密）。
pub fn _aes128_encrypt_block_fast(inp: int, out: int, rk: int) -> int {
    let t = _tables()
    let mut s0 = _bswap32(mem_load32(inp, 0)) ^ _bswap32(mem_load32(rk, 0))
    let mut s1 = _bswap32(mem_load32(inp, 4)) ^ _bswap32(mem_load32(rk, 4))
    let mut s2 = _bswap32(mem_load32(inp, 8)) ^ _bswap32(mem_load32(rk, 8))
    let mut s3 = _bswap32(mem_load32(inp, 12)) ^ _bswap32(mem_load32(rk, 12))
    let mut r = 1
    while r < 10 {
        let k = r * 16
        let t0 = mem_load32(t, 512 + ((s0 >>> 24) & 0xFF) * 4) ^
                 mem_load32(t, 1536 + ((s1 >>> 16) & 0xFF) * 4) ^
                 mem_load32(t, 2560 + ((s2 >>> 8) & 0xFF) * 4) ^
                 mem_load32(t, 3584 + (s3 & 0xFF) * 4) ^
                 _bswap32(mem_load32(rk, k))
        let t1 = mem_load32(t, 512 + ((s1 >>> 24) & 0xFF) * 4) ^
                 mem_load32(t, 1536 + ((s2 >>> 16) & 0xFF) * 4) ^
                 mem_load32(t, 2560 + ((s3 >>> 8) & 0xFF) * 4) ^
                 mem_load32(t, 3584 + (s0 & 0xFF) * 4) ^
                 _bswap32(mem_load32(rk, k + 4))
        let t2 = mem_load32(t, 512 + ((s2 >>> 24) & 0xFF) * 4) ^
                 mem_load32(t, 1536 + ((s3 >>> 16) & 0xFF) * 4) ^
                 mem_load32(t, 2560 + ((s0 >>> 8) & 0xFF) * 4) ^
                 mem_load32(t, 3584 + (s1 & 0xFF) * 4) ^
                 _bswap32(mem_load32(rk, k + 8))
        let t3 = mem_load32(t, 512 + ((s3 >>> 24) & 0xFF) * 4) ^
                 mem_load32(t, 1536 + ((s0 >>> 16) & 0xFF) * 4) ^
                 mem_load32(t, 2560 + ((s1 >>> 8) & 0xFF) * 4) ^
                 mem_load32(t, 3584 + (s2 & 0xFF) * 4) ^
                 _bswap32(mem_load32(rk, k + 12))
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r = r + 1
    }
    // 最后一轮：SubBytes + ShiftRows + AddRoundKey（无 MixColumns）
    let u0 = (_sbox((s0 >>> 24) & 0xFF) << 24) | (_sbox((s1 >>> 16) & 0xFF) << 16) |
             (_sbox((s2 >>> 8) & 0xFF) << 8) | _sbox(s3 & 0xFF)
    let u1 = (_sbox((s1 >>> 24) & 0xFF) << 24) | (_sbox((s2 >>> 16) & 0xFF) << 16) |
             (_sbox((s3 >>> 8) & 0xFF) << 8) | _sbox(s0 & 0xFF)
    let u2 = (_sbox((s2 >>> 24) & 0xFF) << 24) | (_sbox((s3 >>> 16) & 0xFF) << 16) |
             (_sbox((s0 >>> 8) & 0xFF) << 8) | _sbox(s1 & 0xFF)
    let u3 = (_sbox((s3 >>> 24) & 0xFF) << 24) | (_sbox((s0 >>> 16) & 0xFF) << 16) |
             (_sbox((s1 >>> 8) & 0xFF) << 8) | _sbox(s2 & 0xFF)
    let v0 = u0 ^ _bswap32(mem_load32(rk, 160))
    let v1 = u1 ^ _bswap32(mem_load32(rk, 164))
    let v2 = u2 ^ _bswap32(mem_load32(rk, 168))
    let v3 = u3 ^ _bswap32(mem_load32(rk, 172))
    // 状态字是大端语义；_put32 写小端，故先 bswap 再落字节
    _put32(out, 0, _bswap32(v0))
    _put32(out, 4, _bswap32(v1))
    _put32(out, 8, _bswap32(v2))
    _put32(out, 12, _bswap32(v3))
    return 0
}

// v1.31：AES-NI 单块加密（cpu_aes() == 1 时启用）。
// 10 轮全是硬件指令（AESENC ×9 + AESENCLAST），没有查表——
// 既快（一个块 ~10 个周期级操作）也没有 T-table 的缓存侧信道问题。
// rk 是 aes128_expand 产出的 176 字节标准轮密钥表，AESENC 直接吃这个字节序
// （软件路径要 _bswap32 是因为它按大端字读，硬件按字节读，不需要转换）。
// xmm 槽 0/1 是固定协议：0 = 状态，1 = 轮密钥。
pub fn _aes128_encrypt_block_ni(inp: int, out: int, rk: int) -> int {
    xmm_load(0, inp)
    xmm_load(1, rk)
    xmm_pxor(0, 1)
    let mut r = 1
    while r < 10 {
        xmm_load(1, mem_ptr(rk, r * 16))
        aesenc(0, 1)
        r = r + 1
    }
    xmm_load(1, mem_ptr(rk, 160))
    aesenclast(0, 1)
    xmm_store(out, 0)
    return 0
}

// v1.31：GCM 的 CTR 单块（加密 + 异或 + 落盘，全在 xmm 里）。
// 为什么把异或也放进来：旧 _ctr_xor 每块要做 16 次 mem_load8 + 16 次
// mem_store8 做异或，硬件加密之后这一圈字节操作反而成了瓶颈。
// xmm 槽协议：0 = 计数器/状态，1 = 轮密钥，2 = 明文块。
fn _gcm_ctr_block_ni(inp: int, out: int, ctr: int, rk: int) -> int {
    xmm_load(0, ctr)
    xmm_load(1, rk)
    xmm_pxor(0, 1)
    let mut r = 1
    while r < 10 {
        xmm_load(1, mem_ptr(rk, r * 16))
        aesenc(0, 1)
        r = r + 1
    }
    xmm_load(1, mem_ptr(rk, 160))
    aesenclast(0, 1)
    xmm_load(2, inp)
    xmm_pxor(0, 2)
    xmm_store(out, 0)
    return 0
}

pub fn aes128_decrypt_block(inp: int, out: int, rk: int) -> int {
    let st = mem_alloc(16)
    let mut i = 0
    while i < 16 {
        mem_store8(st, i, mem_load8(inp, i))
        i = i + 1
    }
    _add_round_key(st, rk, 10)
    let mut r = 9
    while r >= 1 {
        _inv_shift_rows(st)
        _inv_sub_bytes(st)
        _add_round_key(st, rk, r)
        _inv_mix_columns(st)
        r = r - 1
    }
    _inv_shift_rows(st)
    _inv_sub_bytes(st)
    _add_round_key(st, rk, 0)
    i = 0
    while i < 16 {
        mem_store8(out, i, mem_load8(st, i))
        i = i + 1
    }
    mem_free(st, 16)
    return 0
}

// ---------------------------------------------------------------------------
// GCM：GHASH（GF(2^128)，两个 64 位字）+ CTR + tag
// ---------------------------------------------------------------------------

// 大端 64 位读写（GCM 的 128 位值按大端解释，不能直接用 mem_load64）
fn _be64(p: int, w: int) -> int {
    let mut v = 0
    let mut i = 0
    while i < 8 {
        v = (v << 8) | mem_load8(p, w * 8 + i)
        i = i + 1
    }
    return v
}

fn _put_be64(p: int, w: int, v: int) -> int {
    let mut i = 0
    while i < 8 {
        mem_store8(p, w * 8 + i, (v >> (56 - i * 8)) & 0xFF)
        i = i + 1
    }
    return 0
}

// GHASH 的 128 位乘法：Z = X * H（X、H 都是 16 字节大端缓冲）
// 逐位算法：Z 累加 V，V 每轮右移并在最低位为 1 时异或 R=0xE1<<120。
pub fn _gf_mul(x: int, h: int, out: int) -> int {
    // 规范算法：V = X，按 H 的位（MSB 优先）决定是否累加；V 每轮右移并归约。
    let hh = _be64(h, 0)
    let hl = _be64(h, 1)
    let mut vh = _be64(x, 0)
    let mut vl = _be64(x, 1)
    let mut zh = 0
    let mut zl = 0
    let mut i = 0
    while i < 128 {
        let mut bit = 0
        if i < 64 {
            bit = (hh >> (63 - i)) & 1
        } else {
            bit = (hl >> (127 - i)) & 1
        }
        if bit != 0 {
            zh = zh ^ vh
            zl = zl ^ vl
        }
        let lsb = vl & 1
        // 128 位值的高位可能为 1，必须用逻辑右移（>>>），否则符号位会灌进来
        let nh = vh >>> 1
        let nl = (vl >>> 1) | ((vh & 1) << 63)
        vh = nh
        vl = nl
        if lsb != 0 {
            vh = vh ^ 0xE100000000000000
        }
        i = i + 1
    }
    _put_be64(out, 0, zh)
    _put_be64(out, 1, zl)
    return 0
}

// ---------------------------------------------------------------------------
// GHASH 4-bit 表（v1.28）：32 个 nibble × 16 项 × 16 字节 = 8 KiB
// T[i][j] = (j·H)·x^(4*(31-i))；X 的 32 个 nibble 直接查表异或。
// ---------------------------------------------------------------------------

// GCM 的 GF(2^128) 以最高位为 x^0：乘 x = 右移一位，最低位为 1 时异或 0xE1
fn _gf_xtime(src: int, dst: int) -> int {
    let lsb = mem_load8(src, 15) & 1
    let mut carry = 0
    let mut i = 0
    while i < 16 {
        let b = mem_load8(src, i)
        mem_store8(dst, i, (b >> 1) | (carry << 7))
        carry = b & 1
        i = i + 1
    }
    if lsb != 0 {
        mem_store8(dst, 0, mem_load8(dst, 0) ^ 0xE1)
    }
    return 0
}

pub fn _ghash_table(h: int, t: int) -> int {
    let hx = mem_alloc(64)
    let mut i = 0
    while i < 16 {
        mem_store8(hx, i, mem_load8(h, i))
        i = i + 1
    }
    _gf_xtime(hx, hx + 16)
    _gf_xtime(hx + 16, hx + 32)
    _gf_xtime(hx + 32, hx + 48)
    // 第 0 列（最高 nibble）：j·H = Σ_{bit b of j} H·x^b
    let mut j = 0
    while j < 16 {
        let e = t + j * 16
        let mut k = 0
        while k < 16 {
            mem_store8(e, k, 0)
            k = k + 1
        }
        // nibble 的位序是大端：j 的 MSB 对应 x^0，需先反转 4 位
        let rj = ((j & 1) << 3) | ((j & 2) << 1) | ((j & 4) >> 1) | ((j & 8) >> 3)
        let mut b = 0
        while b < 4 {
            if ((rj >> b) & 1) != 0 {
                let src = hx + b * 16
                k = 0
                while k < 16 {
                    mem_store8(e, k, mem_load8(e, k) ^ mem_load8(src, k))
                    k = k + 1
                }
            }
            b = b + 1
        }
        j = j + 1
    }
    // 其余列：T[i] = x^4 · T[i-1]
    let tmp = mem_alloc(16)
    let mut col = 1
    while col < 32 {
        j = 0
        while j < 16 {
            let src = t + (col - 1) * 256 + j * 16
            let dst = t + col * 256 + j * 16
            _gf_xtime(src, tmp)
            _gf_xtime(tmp, dst)
            _gf_xtime(dst, tmp)
            _gf_xtime(tmp, dst)
            j = j + 1
        }
        col = col + 1
    }
    mem_free(tmp, 16)
    mem_free(hx, 64)
    return 0
}

// 4-bit 表乘法：Y = X · H。
// v1.32：改成**按 64 位字**累加，并且累加器留在两个局部变量里。
// 旧实现每个 nibble 做 16 次 mem_load8 + 16 次 mem_store8（一块 1024 次
// 字节操作），是 GCM 在 AES-NI 之后唯一的瓶颈；字级之后每 nibble 只剩
// 2 次读 + 2 次异或，且 32 个 nibble 期间不碰内存。
// 字节序不用管：表行就是 16 字节原样，字级异或 + 字级写回与字节级等价。
pub fn _gf_mul_t(x: int, t: int, out: int) -> int {
    let mut lo = 0
    let mut hi = 0
    let mut b = 0
    let mut n = 0
    while b < 16 {
        let byte = mem_load8(x, b)
        let e0 = t + n * 256 + ((byte >> 4) & 0xF) * 16
        lo = lo ^ mem_load64(e0, 0)
        hi = hi ^ mem_load64(e0, 1)
        n = n + 1
        let e1 = t + n * 256 + (byte & 0xF) * 16
        lo = lo ^ mem_load64(e1, 0)
        hi = hi ^ mem_load64(e1, 1)
        n = n + 1
        b = b + 1
    }
    mem_store64(out, 0, lo)
    mem_store64(out, 1, hi)
    return 0
}

// ---------------------------------------------------------------------------
// GHASH 硬件路径（v1.33，PCLMULQDQ）
//
// 数学：GCM 的 128 位乘法在"位反射"表示下定义（bit0 = byte0 的 MSB = x^0）。
// 把 xmm 里的 16 字节看成小端整数 V，则多项式系数整数 = bitrev8each(V)
// ——只需**每字节内位反序**，不需要整段字节反序（这一步很关键，省掉一半工作）。
//
// 序列（与 build/_pclmul_proto.py 的原型逐字节对拍过，NIST 向量 + 200 组随机全一致）：
//   1) A' = bitrev8each(A)；H' 每次调用只算一次，常驻 xmm 槽 3
//   2) 4 × pclmulqdq（0x00/0x11/0x10/0x01）+ 交叉项拼成 256 位 (hi:lo)
//   3) 归约：R = lo ^ hi ^ hi·x ^ hi·x² ^ hi·x⁷，溢出位（≤7 位）再折叠一次
//   4) bitrev8each(R) 写回
//
// xmm 槽协议：0 = 累加器/状态，1 = hi/临时，2/6/7 = 临时，3 = H'，4 = 0x0F 掩码，5 = 半字节反序表
// ---------------------------------------------------------------------------

// _rev0()：槽 0 原地每字节位反序（用 4=0x0F、5=NIB、6=临时）
// 槽号必须是编译期常量（xmm 是固定槽协议，分配器不参与），所以这里写死 0，
// 需要别的槽时由调用方 xmm_mov 进出。
fn _rev0() -> int {
    xmm_mov(6, 0)
    pand(6, 4)                 // 6 = 低半字节（作为 pshufb 的**控制**）
    psrlw(0, 4)
    pand(0, 4)                 // 0 = 高半字节（控制）
    // ⚠ PSHUFB 的语义是 dest[i] = dest[ctrl[i]]：表必须在**目标槽**、
    // 待反转的半字节在**源槽**。所以每次把 NIB 表复制进目标槽再用。
    // （第一版把两个操作数写反了，结果全错——t79 只测了指令本身，没测用法。）
    xmm_mov(2, 5)
    pshufb(2, 6)               // 2 = NIB[低]
    xmm_mov(6, 5)
    pshufb(6, 0)               // 6 = NIB[高]
    psllw(2, 4)
    por(2, 6)
    xmm_mov(0, 2)
    return 0
}

// _gmul_ni(scratch)：槽 0 = 槽 0 × 槽 3（都在反射表示下），结果回槽 0
// scratch 是调用方给的 16 字节暂存（清零溢出累加器用）
fn _gmul_ni(scratch: int) -> int {
    _rev0()
    xmm_mov(1, 0)
    xmm_mov(2, 0)
    xmm_mov(6, 0)
    pclmulqdq(0, 3, 0x00)      // lo = A0·H0
    pclmulqdq(1, 3, 0x11)      // hi = A1·H1
    pclmulqdq(2, 3, 0x10)      // 交叉 1
    pclmulqdq(6, 3, 0x01)      // 交叉 2
    xmm_pxor(2, 6)             // 2 = 交叉项之和
    xmm_mov(6, 2)
    pslldq(6, 8)
    xmm_pxor(0, 6)             // 0 = lo
    psrldq(2, 8)
    xmm_pxor(1, 2)             // 1 = hi
    // ---- 归约 ----
    // 清零用"内存零块 + load"：写成 xmm_pxor(7,7) 会被优化器当死代码删掉
    //（它没有任何 vreg 结果），实测导致 GHASH 全错。见 07-gaps §7.5。
    mem_zero(scratch, 16)
    xmm_load(7, scratch)                  // 7 = 溢出累加器 = 0
    xmm_pxor(0, 1)                        // acc = lo ^ hi
    // hi·x
    xmm_mov(2, 1)
    psllq(2, 1)
    xmm_mov(6, 1)
    psrlq(6, 63)
    xmm_mov(7, 6)          // 暂存：下面要拿它取溢出位
    pslldq(6, 8)
    por(2, 6)
    xmm_pxor(0, 2)
    psrldq(7, 8)           // 7 = 溢出位（k=1）
    // hi·x²
    xmm_mov(2, 1)
    psllq(2, 2)
    xmm_mov(6, 1)
    psrlq(6, 62)
    pslldq(6, 8)
    por(2, 6)
    xmm_pxor(0, 2)
    xmm_mov(6, 1)
    psrlq(6, 62)
    psrldq(6, 8)
    xmm_pxor(7, 6)
    // hi·x⁷
    xmm_mov(2, 1)
    psllq(2, 7)
    xmm_mov(6, 1)
    psrlq(6, 57)
    pslldq(6, 8)
    por(2, 6)
    xmm_pxor(0, 2)
    xmm_mov(6, 1)
    psrlq(6, 57)
    psrldq(6, 8)
    xmm_pxor(7, 6)
    // 溢出位（≤7 位，在 byte0）再乘 x⁷+x²+x+1：不会溢出 128 位
    xmm_mov(2, 7)
    psllq(2, 1)
    xmm_pxor(0, 2)
    xmm_mov(2, 7)
    psllq(2, 2)
    xmm_pxor(0, 2)
    xmm_mov(2, 7)
    psllq(2, 7)
    xmm_pxor(0, 2)
    xmm_pxor(0, 7)
    _rev0()
    return 0
}

// _ghash_ni(h, data, n, out)：硬件 GHASH
fn _ghash_ni(h: int, data: int, n: int, out: int) -> int {
    let c0f = mem_alloc(16)
    let nib = mem_alloc(16)
    let mut i = 0
    while i < 16 {
        mem_store8(c0f, i, 0x0F)
        i = i + 1
    }
    // 半字节位反序表：NIB[i] = bitrev4(i)
    mem_store8(nib, 0, 0)
    mem_store8(nib, 1, 8)
    mem_store8(nib, 2, 4)
    mem_store8(nib, 3, 12)
    mem_store8(nib, 4, 2)
    mem_store8(nib, 5, 10)
    mem_store8(nib, 6, 6)
    mem_store8(nib, 7, 14)
    mem_store8(nib, 8, 1)
    mem_store8(nib, 9, 9)
    mem_store8(nib, 10, 5)
    mem_store8(nib, 11, 13)
    mem_store8(nib, 12, 3)
    mem_store8(nib, 13, 11)
    mem_store8(nib, 14, 7)
    mem_store8(nib, 15, 15)
    xmm_load(4, c0f)
    xmm_load(5, nib)
    // H' = bitrev8each(H)，只算一次（槽 0 中转）
    xmm_load(0, h)
    _rev0()
    xmm_mov(3, 0)
    // Y = 0
    mem_zero(out, 16)
    xmm_load(0, out)
    let scratch = mem_alloc(16)
    let mut p = 0
    while p < n {
        xmm_load(1, mem_ptr(data, p))
        xmm_pxor(0, 1)          // Y ^= block
        _gmul_ni(scratch)       // Y *= H'
        p = p + 16
    }
    xmm_store(out, 0)
    mem_free(scratch, 16)
    mem_free(c0f, 16)
    mem_free(nib, 16)
    return 0
}

// GHASH(Y, H, data)：data 是 16 字节块序列，len 必须是 16 的倍数
fn ghash(h: int, data: int, n: int, out: int) -> int {
    let y = mem_alloc(16)
    mem_zero(y, 16)
    let tmp = mem_alloc(16)
    // v1.33：有 PCLMULQDQ 就走硬件路径（无查表、无侧信道、块内 4 次进位无乘法）
    if cpu_pclmul() == 1 {
        _ghash_ni(h, data, n, out)
        mem_free(y, 16)
        mem_free(tmp, 16)
        return 0
    }
    // 降级：小输入用逐位算法（省 8 KiB 建表）；≥16 块走 4-bit 表
    let mut tbl = 0
    if n >= 256 {
        tbl = mem_alloc(8192)
        _ghash_table(h, tbl)
    }
    let mut p = 0
    while p < n {
        // v1.32：Y ^= 块 用两个字，不再逐字节（每块省 28 次内存操作）
        mem_store64(tmp, 0, mem_load64(y, 0) ^ mem_load64(data, p / 8))
        mem_store64(tmp, 1, mem_load64(y, 1) ^ mem_load64(data, p / 8 + 1))
        if tbl != 0 {
            _gf_mul_t(tmp, tbl, y)
        } else {
            _gf_mul(tmp, h, y)
        }
        p = p + 16
    }
    let mut k = 0
    while k < 16 {
        mem_store8(out, k, mem_load8(y, k))
        k = k + 1
    }
    mem_free(y, 16)
    mem_free(tmp, 16)
    if tbl != 0 {
        mem_free(tbl, 8192)
    }
    return 0
}

// 大端 32 位自增（GCM 计数器）
fn _inc32(ctr: int) -> int {
    let mut i = 15
    let mut carry = 1
    while i >= 12 && carry == 1 {
        let v = mem_load8(ctr, i) + 1
        if v > 255 {
            mem_store8(ctr, i, 0)
        } else {
            mem_store8(ctr, i, v)
            carry = 0
        }
        i = i - 1
    }
    return 0
}

// CTR 加解密（对称）：in/out 可同缓冲；n 不要求 16 对齐（尾部按流截断）
fn _ctr_xor(inp: int, n: int, out: int, ctr: int, rk: int) -> int {
    let blk = mem_alloc(16)
    // v1.31：硬件能力探测提到循环外（每个 GCM 操作一次，不是每块一次）
    let ni = cpu_aes()
    let mut p = 0
    while p < n {
        if ni == 1 && p + 16 <= n {
            // 整块：加密 + 异或 + 落盘都在 xmm 里，零逐字节操作
            _gcm_ctr_block_ni(mem_ptr(inp, p), mem_ptr(out, p), ctr, rk)
        } else {
            if ni == 1 {
                _aes128_encrypt_block_ni(ctr, blk, rk)
            } else {
                _aes128_encrypt_block_fast(ctr, blk, rk)
            }
            let mut i = 0
            while i < 16 && p + i < n {
                mem_store8(out, p + i, mem_load8(inp, p + i) ^ mem_load8(blk, i))
                i = i + 1
            }
        }
        _inc32(ctr)
        p = p + 16
    }
    mem_free(blk, 16)
    return 0
}

// ---------------------------------------------------------------------------
// 对外：AES-128-GCM
// ---------------------------------------------------------------------------

// gcm_encrypt(key, iv12, aad, plain) -> str
//   返回密文 || 16 字节 tag（TLS 1.3 的 AEAD 布局）
pub fn gcm_encrypt(key: str, iv: str, aad: str, plain: str) -> str {
    let rk = mem_alloc(176)
    aes128_expand(key, rk)

    let h = mem_alloc(16)
    let zero = mem_alloc(16)
    mem_zero(zero, 16)
    aes128_encrypt_block(zero, h, rk)

    // J0 = IV || 0^31 || 1（96 位 IV）
    let j0 = mem_alloc(16)
    let mut i = 0
    while i < 12 {
        mem_store8(j0, i, iv[i])
        i = i + 1
    }
    mem_store8(j0, 12, 0)
    mem_store8(j0, 13, 0)
    mem_store8(j0, 14, 0)
    mem_store8(j0, 15, 1)

    // 密文
    let n = len(plain)
    let ctr = mem_alloc(16)
    let mut k = 0
    while k < 16 {
        mem_store8(ctr, k, mem_load8(j0, k))
        k = k + 1
    }
    _inc32(ctr)
    let pin = mem_alloc(n + 16)
    mem_zero(pin, n + 16)
    k = 0
    while k < n {
        mem_store8(pin, k, plain[k])
        k = k + 1
    }
    let pout = mem_alloc(n + 16)
    _ctr_xor(pin, n, pout, ctr, rk)

    // GHASH 输入：AAD 补齐 + 密文补齐 + [len(AAD)*8]64 || [len(C)*8]64
    let an = len(aad)
    let aad_pad = ((an + 15) / 16) * 16
    let c_pad = ((n + 15) / 16) * 16
    let total = aad_pad + c_pad + 16
    let g = mem_alloc(total)
    mem_zero(g, total)
    k = 0
    while k < an {
        mem_store8(g, k, aad[k])
        k = k + 1
    }
    k = 0
    while k < n {
        mem_store8(g, aad_pad + k, mem_load8(pout, k))
        k = k + 1
    }
    let bits_a = an * 8
    let bits_c = n * 8
    let mut b = 0
    while b < 8 {
        mem_store8(g, total - 16 + b, (bits_a >> (56 - b * 8)) & 0xFF)
        mem_store8(g, total - 8 + b, (bits_c >> (56 - b * 8)) & 0xFF)
        b = b + 1
    }
    let s = mem_alloc(16)
    ghash(h, g, total, s)

    // tag = E(K, J0) ^ S
    let ej0 = mem_alloc(16)
    aes128_encrypt_block(j0, ej0, rk)
    let res = vec[int].new(n + 20)
    k = 0
    while k < n {
        res.push(mem_load8(pout, k))
        k = k + 1
    }
    k = 0
    while k < 16 {
        res.push(mem_load8(ej0, k) ^ mem_load8(s, k))
        k = k + 1
    }

    mem_free(rk, 176)
    mem_free(h, 16)
    mem_free(zero, 16)
    mem_free(j0, 16)
    mem_free(ctr, 16)
    mem_free(pin, n + 16)
    mem_free(pout, n + 16)
    mem_free(g, total)
    mem_free(s, 16)
    mem_free(ej0, 16)
    return str_from_bytes(res)
}

// gcm_decrypt(key, iv, aad, sealed) -> str
//   sealed = 密文 || tag；tag 不匹配返回 ""（调用方必须当作失败处理）
pub fn gcm_decrypt(key: str, iv: str, aad: str, sealed: str) -> str {
    let sn = len(sealed)
    if sn < 16 {
        return ""
    }
    let n = sn - 16
    let rk = mem_alloc(176)
    aes128_expand(key, rk)

    let h = mem_alloc(16)
    let zero = mem_alloc(16)
    mem_zero(zero, 16)
    aes128_encrypt_block(zero, h, rk)

    let j0 = mem_alloc(16)
    let mut i = 0
    while i < 12 {
        mem_store8(j0, i, iv[i])
        i = i + 1
    }
    mem_store8(j0, 12, 0)
    mem_store8(j0, 13, 0)
    mem_store8(j0, 14, 0)
    mem_store8(j0, 15, 1)

    let cin = mem_alloc(n + 16)
    mem_zero(cin, n + 16)
    let mut k = 0
    while k < n {
        mem_store8(cin, k, sealed[k])
        k = k + 1
    }

    // 先验 tag
    let an = len(aad)
    let aad_pad = ((an + 15) / 16) * 16
    let c_pad = ((n + 15) / 16) * 16
    let total = aad_pad + c_pad + 16
    let g = mem_alloc(total)
    mem_zero(g, total)
    k = 0
    while k < an {
        mem_store8(g, k, aad[k])
        k = k + 1
    }
    k = 0
    while k < n {
        mem_store8(g, aad_pad + k, mem_load8(cin, k))
        k = k + 1
    }
    let bits_a = an * 8
    let bits_c = n * 8
    let mut b = 0
    while b < 8 {
        mem_store8(g, total - 16 + b, (bits_a >> (56 - b * 8)) & 0xFF)
        mem_store8(g, total - 8 + b, (bits_c >> (56 - b * 8)) & 0xFF)
        b = b + 1
    }
    let s = mem_alloc(16)
    ghash(h, g, total, s)
    let ej0 = mem_alloc(16)
    aes128_encrypt_block(j0, ej0, rk)
    let mut diff = 0
    k = 0
    while k < 16 {
        diff = diff | ((mem_load8(ej0, k) ^ mem_load8(s, k)) ^ sealed[n + k])
        k = k + 1
    }
    if diff != 0 {
        mem_free(rk, 176)
        mem_free(h, 16)
        mem_free(zero, 16)
        mem_free(j0, 16)
        mem_free(cin, n + 16)
        mem_free(g, total)
        mem_free(s, 16)
        mem_free(ej0, 16)
        return ""
    }

    let ctr = mem_alloc(16)
    k = 0
    while k < 16 {
        mem_store8(ctr, k, mem_load8(j0, k))
        k = k + 1
    }
    _inc32(ctr)
    let pout = mem_alloc(n + 16)
    _ctr_xor(cin, n, pout, ctr, rk)
    let res = vec[int].new(n + 1)
    k = 0
    while k < n {
        res.push(mem_load8(pout, k))
        k = k + 1
    }

    mem_free(rk, 176)
    mem_free(h, 16)
    mem_free(zero, 16)
    mem_free(j0, 16)
    mem_free(cin, n + 16)
    mem_free(g, total)
    mem_free(s, 16)
    mem_free(ej0, 16)
    mem_free(ctr, 16)
    mem_free(pout, n + 16)
    return str_from_bytes(res)
}
