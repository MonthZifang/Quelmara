// 单核降级下的通道 FIFO：容量足够，不触发阻塞。
// 配合 tests/single_core/Rosoto.toml（multicore=false）验证串行路径。
fn main() {
    let c = chan[int].open(4)
    c.send(1)
    c.send(2)
    c.send(3)
    assert(c.recv() == 1, "chan seq 1")
    assert(c.recv() == 2, "chan seq 2")
    assert(c.recv() == 3, "chan seq 3")
    print("chan seq ok")
}
