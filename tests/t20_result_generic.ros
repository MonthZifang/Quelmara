// t20_result_generic.ros：result[T,E] 受控单态化（合成枚举 __res_<T>_<E> + match 解构 + ? 传播）
// 覆盖：result[int,str] ok/err 构造、函数返回（聚合 ABI）、Result.Ok/Err 解构、
//       ? 传播（正常分支 + 错误分支）、result[str,int]（T/E 对调）、result[bool,bool]。
module t20_result_generic

fn parse(n: int) -> result[int, str] {
    if n < 0 {
        return result[int, str].err("negative")
    }
    return result[int, str].ok(n)
}

fn add_one(n: int) -> result[int, str] {
    let value = parse(n)?
    return result[int, str].ok(value + 1)
}

fn label(n: int) -> result[str, int] {
    if n == 0 {
        return result[str, int].err(404)
    }
    return result[str, int].ok("found")
}

fn label_echo(n: int) -> result[str, int] {
    let s = label(n)?
    return result[str, int].ok(s)
}

fn flip(b: bool) -> result[bool, bool] {
    if b {
        return result[bool, bool].err(true)
    }
    return result[bool, bool].ok(true)
}

fn flip_twice(b: bool) -> result[bool, bool] {
    let v = flip(b)?
    return result[bool, bool].ok(!v)
}

fn main() {
    // result[int, str]：构造 + 函数返回 + match 解构（Ok 分支）
    let a = add_one(41)
    match a {
        Result.Ok(v) => assert(v == 42, "int ok propagation")
        Result.Err(e) => assert(false, e)
    }

    // result[int, str]：? 错误分支传播（Err 原样返回）
    let b = add_one(-1)
    match b {
        Result.Ok(v) => assert(false, v.to_str())
        Result.Err(e) => assert(e == "negative", "int err propagation")
    }

    // result[str, int]：T/E 对调，? 正常分支
    let c = label_echo(7)
    match c {
        Result.Ok(v) => assert(v == "found", "str ok propagation")
        Result.Err(e) => assert(false, e.to_str())
    }

    // result[str, int]：? 错误分支
    let d = label_echo(0)
    match d {
        Result.Ok(v) => assert(false, v)
        Result.Err(e) => assert(e == 404, "str err propagation")
    }

    // result[bool, bool]：bool 载荷构造 + 解构
    let e2 = flip(false)
    match e2 {
        Result.Ok(v) => assert(v, "bool ok payload")
        Result.Err(e) => assert(false, e.to_str())
    }

    // result[bool, bool]：? 正常分支
    let f = flip_twice(false)
    match f {
        Result.Ok(v) => assert(!v, "bool ok propagation")
        Result.Err(e) => assert(false, e.to_str())
    }

    // result[bool, bool]：? 错误分支
    let g = flip_twice(true)
    match g {
        Result.Ok(v) => assert(false, v.to_str())
        Result.Err(e) => assert(e, "bool err propagation")
    }

    print("result generic ok")
}
