// 负向夹具：同一底层存储上两个独立视图范围可能重叠且都被写入，必须编译失败
// （所有权检查 v2 的"写别名"检查）。注意：切片拷贝（let t = s）算同一别名组，
// 不报——零拷贝共享是本语言的显式语义；这里两次 slice 是**独立创建**。
module own_alias_write
fn main() {
    let mut a: [8]int = [0, 0, 0, 0, 0, 0, 0, 0]
    let s = slice_of(a)
    let t = a[2..6]
    s[0] = 1
    t[0] = 2
    print((s[0] + t[0]).to_str())
}
