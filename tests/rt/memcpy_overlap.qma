// RT 用例：mem_copy 前向重叠 —— 逐字节前向语义
// store/load 用槽索引（×8），字节级校验用 load8。
fn main() {
    let n = 16
    let a = mem_alloc(n * 2)
    let refb = mem_alloc(n * 2)
    let mut i = 0
    while i < n {
        mem_store64(a, i, i * 3 + 7)
        mem_store64(refb, i, i * 3 + 7)
        i = i + 1
    }
    // dst = a+8字节 = 槽 1；拷 16 字节 = 槽 0..2 的前向重叠
    // mem_copy 语义（前向逐字节）：槽1 <- 槽0旧值，槽2 <- 槽1旧值
    mem_copy(a + 8, a, 16)
    // 在 refb 上手动模拟逐字节前向重叠（字节地址 = 槽*8）
    let src = refb
    let dst = refb + 8
    let mut k = 15
    while k >= 0 {
        mem_store8(dst + k, 0, mem_load8(src + k, 0))
        k = k - 1
    }
    // 逐字节比对 a 与 refb 的前 16 字节
    let mut bad = 0
    let mut j = 0
    while j < 16 {
        if mem_load8(a + 8 + j, 0) != mem_load8(refb + 8 + j, 0) { bad = bad + 1 }
        j = j + 1
    }
    print(bad)
}
