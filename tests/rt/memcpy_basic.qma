// RT 用例：mem_copy 不重叠正确性（mem_copy 的 n 是【字节】）
// 偏移语义：mem_load64/store64 的第 2 参是【槽索引（×8）】（02-language L1261），
// mem_load8/store8 是字节。用 load8 校验字节级结果。
fn main() {
    let a = mem_alloc(64)
    let b = mem_alloc(64)
    let mut i = 0
    while i < 8 {
        mem_store64(a, i, i * 11 + 3)
        i = i + 1
    }
    // 拷 37 字节（4 个 qword + 5 字节尾部）—— 现在是【正确语义】
    mem_copy(b, a, 37)
    // 校验前 4 个 qword（槽 0..3）与源一致
    let mut bad = 0
    let mut j = 0
    while j < 4 {
        if mem_load64(b, j) != mem_load64(a, j) { bad = bad + 1 }
        j = j + 1
    }
    print(bad)
}
