// RT 回归用例：两个 mem_alloc 后第一指针的独立性
// 语义：mem_load64/store64 第 2 参是槽索引（×8），两块独立分配。
// 全部断言应通过（v4.50 实测通过 —— 此前 FAIL 是用例自己按字节写错）。
fn main() {
    let a = mem_alloc(64)
    mem_store64(a, 0, 111)
    mem_store64(a, 1, 222)
    let x = mem_load64(a, 1)
    let b = mem_alloc(64)
    mem_store64(b, 0, 999)
    let bad = 0
    if x != 222 { bad = bad + 1 }
    if mem_load64(a, 1) != 222 { bad = bad + 1 }
    if mem_load64(a, 0) != 111 { bad = bad + 1 }
    if mem_load64(b, 0) != 999 { bad = bad + 1 }
    print(bad)
}
