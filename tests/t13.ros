// t13.ros：enum + match 进阶（三后端交叉验证）
// 覆盖：枚举嵌入结构体字段、嵌套取值、match 嵌在复合表达式、bool/str 载荷、
//       `_` 忽略绑定、字符串内容比较（==）、match 与函数/循环协作、值语义拷贝
module t13

enum Color {
    Red
    Green
    Blue
}

enum Shape {
    Circle(radius: int)
    Rect(w: int, h: int)
    Tagged(name: str, ok: bool)
}

struct Node {
    kind: Shape
    id: int
}

fn shape_code(s: Shape) -> int {
    return match s {
        Shape.Circle(r) => 100 + r
        Shape.Rect(w, h) => 200 + w + h
        Shape.Tagged(name, ok) => 300
    }
}

fn describe(s: Shape) -> str {
    return match s {
        Shape.Circle(r) => "C" + r.to_str()
        Shape.Rect(w, h) => "R" + w.to_str() + "," + h.to_str()
        Shape.Tagged(name, ok) => name + ":" + ok.to_str()
    }
}

fn main() {
    // 枚举嵌在结构体字段里
    let n = Node { kind: Shape.Circle(radius: 2), id: 9 }
    assert(shape_code(n.kind) == 102, "field enum code")
    assert(describe(n.kind) == "C2", "field enum describe")
    print(shape_code(n.kind))
    print(describe(n.kind))

    // 换一个 kind（整体赋值）
    let n2 = Node { kind: Shape.Rect(3, 4), id: 1 }
    assert(describe(n2.kind) == "R3,4", "rect describe")
    print(describe(n2.kind))

    // bool 载荷
    let t = Shape.Tagged(name: "hp", ok: true)
    let f = Shape.Tagged(name: "mp", ok: false)
    assert(describe(t) == "hp:true", "bool payload true")
    assert(describe(f) == "mp:false", "bool payload false")
    print(describe(t))
    print(describe(f))

    // `_` 忽略绑定 + match 嵌在复合表达式里
    print(1000 + shape_code(Shape.Rect(1, 2)))
    print("[" + describe(Shape.Circle(radius: 8)) + "]")

    // 字符串内容比较（== 不是指针比较）
    assert(describe(t) == "hp:true", "str eq content")
    assert(describe(t) != describe(f), "str ne content")
    print(describe(t) == "hp:true")
    print(describe(t) != describe(f))

    // match 语句块臂里做副作用 + 值语义拷贝互不影响
    let a = Shape.Rect(5, 6)
    let b = a
    let mut acc = 0
    match a {
        Shape.Circle(r) => {
            acc += 1
        }
        Shape.Rect(w, h) => {
            acc += w * h
        }
        _ => {
            acc += 1000
        }
    }
    match b {
        Shape.Rect(w, h) => {
            acc += w * h
        }
        _ => {
            acc += 1000
        }
    }
    assert(acc == 60, "value copy both 30")
    print(acc)

    // 通配臂 + 忽略绑定
    let c2 = Color.Blue
    let rank = match c2 {
        Color.Red => 10
        Color.Green => 20
        _ => 30
    }
    assert(rank == 30, "wildcard rank")
    print(rank)

    // match 里 `_` 占位绑定
    let s3 = Shape.Tagged(name: "x", ok: true)
    let only_name = match s3 {
        Shape.Tagged(name, _) => name
        _ => "none"
    }
    assert(only_name == "x", "ignore bind")
    print(only_name)
}
