// s_nonneg_sound —— 非负值域分析的 **soundness** 差分夹具（v4.123）
//
// 背景：stage-0 的 `fn.nnv` 是函数级粘性集合，而 `if` / `while` 降级用
// `dict(env)` 克隆环境却共享 `fn.nnv`，于是分支里写的 `x = 0` 会把另一条
// 路径上的 `x` 也标成非负；再加上 `x % D`（D>0）被无条件记为 `[0, D-1]`，
// 两条 unsoundness 合起来让 `x / D`、`x % D` 在负被除数时走无符号快路径，
// 静默算错。本夹具把每一条已知形态钉死。
//
// 语义基准 = C99（截断除法：`-9 / 4 == -2`，`-9 % 4 == -1`）。
// 必须三个后端（win / native / c）+ qlmc 全一致。
module nonneg_sound

// ---- 1. 条件赋值：分支里写非负值不得泄漏到另一条路径 ----
fn cond_div(flag: int, v: int) -> int {
    let mut x = v
    if flag == 1 { x = 0 }
    return x / 4
}

fn cond_mod(flag: int, v: int) -> int {
    let mut x = v
    if flag == 1 { x = 0 }
    return x % 4
}

fn cond_else(flag: int, v: int) -> int {
    let mut x = v
    if flag == 1 { x = x } else { x = 8 }
    return x / 3
}

// ---- 2. 循环体：while 体可能一次都不执行，体内写入的非负不得外泄 ----
fn loop_leak(n: int, v: int) -> int {
    let mut x = v
    let mut i = 0
    while i < n {
        x = 4
        i = i + 1
    }
    return x / 3
}

// ---- 3. 取模结果：截断余数同号于被除数，负被除数时是负数 ----
fn mod_then_div(x: int) -> int {
    let m = x % 7
    return m / 3
}

fn mod_then_mod(x: int) -> int {
    let m = x % 7
    return m % 3
}

// ---- 4. int64 回绕：溢出后符号位翻转，非负前提失效 ----
fn wrap_then_mod(iters: int) -> int {
    let mut s = 0
    let mut i = 0
    while i < iters {
        s = s * 3 + 1
        i = i + 1
    }
    return s % 1000003
}

// ---- 5. 复合赋值 %= 同样不能把负值标非负 ----
fn pct_then_div(x: int) -> int {
    let mut y = x
    y %= 4
    return y / 2
}

fn main() {
    // 1. 条件赋值
    print(cond_div(0, 0 - 9))      // -2
    print(cond_div(1, 0 - 9))      //  0
    print(cond_mod(0, 0 - 9))      // -1
    print(cond_mod(1, 0 - 9))      //  0
    print(cond_else(0, 0 - 9))     //  2（走 else：x = 8）
    print(cond_else(1, 0 - 9))     // -3（走 then：x 保持 -9）

    // 2. 循环体
    print(loop_leak(0, 0 - 9))     // -3
    print(loop_leak(3, 0 - 9))     //  1

    // 3. 取模结果
    print(mod_then_div(0 - 10))    // -3 / 3 = -1
    print(mod_then_div(10))        //  3 / 3 =  1
    print(mod_then_mod(0 - 10))    // -3 % 3 =  0
    print(mod_then_mod(11))        //  4 % 3 =  1

    // 4. 回绕
    print(wrap_then_mod(50))       // s 回绕成负 → 余数 -138601
    print(wrap_then_mod(5))        // 非负路径：121 % 1000003 = 121

    // 5. 复合赋值
    print(pct_then_div(0 - 7))     // -3 / 2 = -1
    print(pct_then_div(7))         //  3 / 2 =  1
}
