// t65_x25519.qma：X25519 密钥交换（RFC 7748）—— v1.20
// 覆盖：RFC 7748 §5.2 两组标量乘向量、§6.1 Alice/Bob 公钥与共享密钥、
//       钳位规则、u 最高位忽略、基点生成。
module t65

import std.hex
import std.x25519

fn eqh(a: str, h: str) -> int {
    if hex_encode(a) == h {
        return 1
    }
    return 0
}

fn main() {
    // ---- RFC 7748 §5.2 向量 1 ----
    let k1 = hex_decode("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")
    let u1 = hex_decode("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
    assert(eqh(x25519(k1, u1),
               "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552") == 1,
           "rfc7748 vector 1")

    // ---- RFC 7748 §5.2 向量 2 ----
    let k2 = hex_decode("4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d")
    let u2 = hex_decode("e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493")
    assert(eqh(x25519(k2, u2),
               "95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957") == 1,
           "rfc7748 vector 2")

    // ---- RFC 7748 §6.1 Diffie-Hellman ----
    let a_priv = hex_decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let b_priv = hex_decode("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
    let a_pub = x25519_base(a_priv)
    let b_pub = x25519_base(b_priv)
    assert(eqh(a_pub, "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a") == 1,
           "alice public key")
    assert(eqh(b_pub, "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f") == 1,
           "bob public key")
    assert(eqh(x25519(a_priv, b_pub),
               "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742") == 1,
           "shared secret (alice side)")
    assert(eqh(x25519(b_priv, a_pub),
               "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742") == 1,
           "shared secret (bob side)")

    // ---- 钳位：低 3 位清零、bit255 清零、bit254 置 1 ----
    let raw = hex_decode("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    let cl = x25519_clamp(raw)
    assert(hex_encode(cl) == "f8ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f",
           "clamp")

    // ---- u 的最高位必须被忽略：改 bit255 不改变结果 ----
    let u_hi = hex_decode("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
    let mut ub = vec[int].new(33)
    let mut i = 0
    while i < 32 {
        ub.push(u_hi[i])
        i = i + 1
    }
    ub.set(31, ub.get(31) | 0x80)
    let u_hi2 = str_from_bytes(ub)
    assert(eqh(x25519(k1, u_hi2),
               "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552") == 1,
           "ignore top bit of u")

    // ---- 同一私钥两次结果一致（确定性） ----
    assert(eqh(x25519_base(a_priv), hex_encode(a_pub)) == 1, "deterministic")

    print("ok t65_x25519")
}
