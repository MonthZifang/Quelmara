// t30_io.qma：read_text / substr / chr（v1.0）
// 由 run_win_tests.py 传入一个临时文件路径，验证「读文件 + 切片 + 单字节串」闭环。
module t30

fn main() {
    let a = args()
    assert(len(a) == 1, "one path")
    let t = read_text(a[0])
    print(len(t))
    print(substr(t, 0, 5))
    print(substr(t, 6, 2))
    print(chr(65))
    // 空切片
    print(len(substr(t, 0, 0)))
    // 手写回文判断：用 substr + 下标
    let w = substr(t, 0, 5)
    let mut i = 0
    let mut j = 4
    let mut ok = 1
    while i < j {
        if w[i] != w[j] {
            ok = 0
        }
        i += 1
        j -= 1
    }
    print(ok)
}
