// t159_roots.qma —— std/x509roots 内置根库的执行级回归（v2.97）
// 纯内存 + 纯计算（不联网）：12 个根自验证计数、两条真实公网链验证到
// 表内锚、负向（篡改叶证书 / 锚不在表）。时间戳**冻结**在链的有效期内——
// 测的是路径构造与密码学闭合，不是"今天现实时钟下证书是否还活着"
// （过期负向由 tests/x509_chain_test.py 覆盖）。
module t159_roots

import std.x509
import std.x509roots
import std.hex
import std.str

const NOW = 1790820000        // 2026-10-01：四条夹具证书 notBefore/notAfter 的交集中

// 真实链（2026-10-28 抓自 pypi.org / www.apple.com，含 leaf + intermediate）
fn chain_pypi() -> vec[str] {
    let t = vec[str].new(2)
    t.push("")
    t.push("")
    return t
}
fn chain_apple() -> vec[str] {
    let t = vec[str].new(2)
    t.push("")
    t.push("")
    return t
}

fn main() {
    assert(x509_roots_count() == 12, "count")

    // 1. 锚配对：GlobalSign R3 与 DigiCert G2 的 issuer DN 必须查得到（按名查）
    let pypi = chain_pypi()
    let leaf1 = hex_decode(pypi.get(0))
    let inter1 = vec[str].new(1)
    inter1.push(hex_decode(pypi.get(1)))
    let a1 = x509_trusted_anchor(hex_decode(pypi.get(1)))
    assert(len(a1) > 0, "pypi anchor found")
    assert(x509_subject(a1) == x509_issuer(hex_decode(pypi.get(1))), "anchor subject matches issuer")

    // 2. 一键验证：两条真实链都通过，且域名匹配
    assert(x509_verify_stored(leaf1, inter1, "pypi.org", NOW) == 1, "pypi chain verify")
    let apple = chain_apple()
    let leaf2 = hex_decode(apple.get(0))
    let inter2 = vec[str].new(1)
    inter2.push(hex_decode(apple.get(1)))
    assert(x509_verify_stored(leaf2, inter2, "www.apple.com", NOW) == 1, "apple chain verify")

    // 3. 负向：域名不符 -> 0；篡改叶证书签名 -> 0
    assert(x509_verify_stored(leaf1, inter1, "evil.com", NOW) == 0, "host mismatch")
    let bad = hex_decode(pypi.get(0))
    let n = len(bad)
    // 改最后一个字节（签名尾部）：重新 hex -> 翻位 -> 解码
    let hs = _hex(bad)
    let last = substr(hs, n * 2 - 2, 2)
    assert(len(last) == 2, "hex tail")
    let flipped = _flip(last)
    let tampered = hex_decode(_splic(hs, n * 2 - 2, flipped))
    let interb = vec[str].new(1)
    interb.push(hex_decode(pypi.get(1)))
    assert(x509_verify_stored(tampered, interb, "pypi.org", NOW) == 0, "tampered leaf rejected")

    // 4. 根自验证计数。v2.97 时是 5/12（只支持 RSA-SHA256 与 P-256-SHA256）；
    // v2.99 补上 ECDSA P-384 与 RSA-SHA384 后升到 **11/12**——唯一剩下的
    // 是 Certum Trusted Network CA（SHA-1 自签，RFC 9155 已弃用，不实现）。
    // 这个数字随算法覆盖变化，是"能信多少公网"的直观温度计。
    let mut pass = 0
    let mut i = 0
    while i < 12 {
        let r = x509_root_at(i)
        assert(len(r) > 200, "root der")
        assert(x509_is_ca(r) == 1, "is ca")
        if x509_root_selfcheck(i) == 1 {
            pass = pass + 1
        }
        i = i + 1
    }
    print("selfcheck pass=" + pass.to_str())
    assert(pass == 11, "11 self-verifiable roots (P-384 + RSA-SHA384)")

    // 5. 越界与缺失
    assert(len(x509_root_at(99)) == 0, "oob empty")
    assert(x509_root_find("\x30\x00\x00") == -1, "dn miss")

    print("roots ok")
}

// 把一个两位小写 hex 字节对翻转（a?/b? 直接对调低位，否则低 nibble ^1）
fn _flip(hh: str) -> str {
    let c = hh[0]
    if c == 97 { return "b" + substr(hh, 1, 1) }
    if c == 98 { return "a" + substr(hh, 1, 1) }
    let d = hh[1]
    let mut nd = 48
    if d == 48 { nd = 49 } else { nd = 48 }
    return substr(hh, 0, 1) + chr(nd)
}
fn _splic(s: str, at: int, two: str) -> str {
    return substr(s, 0, at) + two + substr(s, at + 2, len(s) - at - 2)
}
fn _hex(b: str) -> str {
    return hex_encode(b)
}

