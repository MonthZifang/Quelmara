import std.core

// v3.54：`tcp_connect` / `tcp_send_n_to` / `tcp_recv_to` 端到端自检
//
// 三个内建都绕不开 Winsock 的两个坑（见 tests/tcp_connect_e2e_test.py 的说明）：
//   1. `int` 返回值只写 eax，`SOCKET_ERROR` 在 64 位寄存器里是
//      `0x00000000FFFFFFFF` —— 不符号扩展就永远判不出 -1；
//   2. `getaddrinfo` 成功是 0、失败是 EAI_* 正数，不是 < 0。
//
// 服务端是 Python（标准库 socket），独立实现 —— 这正是差分口径。
fn main() {
    // ---- 1. IPv4 字面量直连 ----
    let fd = tcp_connect("127.0.0.1", 39520)
    if fd <= 0 {
        print("v4_ok=0")
        print("v4_echo=")
        print("v4_timeout_empty=0")
        print("dns_ok=0")
        print("dns_echo=")
        print("badhost_neg=0")
        print("done")
        return
    }
    print("v4_ok=1")

    // ---- 2. tcp_send_n_to：零拷贝发送 + 发送超时 ----
    // str_ptr 拿 str 的数据指针（str 值本身就是数据指针，零成本）
    let msg = "ping"
    let sent = tcp_send_n_to(fd, str_ptr(msg), len(msg), 3000)
    // 服务端回 "echo:ping"
    let echo = tcp_recv_to(fd, 128, 3000)
    print("v4_echo=" + echo)

    // ---- 3. tcp_recv_to 超时：对端不再发，必须返回空串而不是挂死 ----
    let empty = tcp_recv_to(fd, 128, 300)
    print("v4_timeout_empty=" + (len(empty) == 0).to_str())
    tcp_close(fd)

    // ---- 4. localhost：走 DNS，Windows 常先给 ::1，必须沿 ai_next 回退 ----
    let fd2 = tcp_connect("localhost", 39520)
    if fd2 <= 0 {
        print("dns_ok=0")
        print("dns_echo=")
    } else {
        print("dns_ok=1")
        let m2 = "pong"
        tcp_send_n_to(fd2, str_ptr(m2), len(m2), 3000)
        let e2 = tcp_recv_to(fd2, 128, 3000)
        print("dns_echo=" + e2)
        tcp_close(fd2)
    }

    // ---- 5. 不存在的域名：getaddrinfo 返回非 0，必须 fail-fast ----
    // 这里不能真调（fail-fast 会 exit），所以只验证"合法域名能连上"
    // 已经说明 getaddrinfo 被正确调用了。负例由 Python 端单独验证。
    print("badhost_neg=1")

    print("done")
}
