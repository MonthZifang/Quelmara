// t161_p384chain.qma —— 真实 P-384 / SHA-384 链的执行级回归（v2.99）
//
// 数据：2026-10-28 抓自 deno.com / cloudflare.com（含 leaf + intermediates，
// 服务器不下发根）。这两条链覆盖了本版新增的三条路径：
//   * P-384 密钥 + ecdsa-with-SHA384 签名（deno 的 YE2 / Root YE）
//   * P-256 密钥 + ecdsa-with-SHA384 签名（deno 叶证书、cloudflare WE1）
//     —— 摘要宽度与曲线阶数不同，按 FIPS 186-4 取摘要最左 256 位
//   * P-384 密钥 + sha256WithRSA 的跨签名根（不验到根，只验到链尾）
module t161_p384chain

import std.hex
import std.x509

fn main() {
    let deno = _deno()
    let leaf = hex_decode(deno.get(0))
    let inter = vec[str].new(1)
    inter.push(hex_decode(deno.get(1)))

    // 1. 叶证书公钥是 P-256，但签名算法是 ecdsa-with-SHA384
    assert(len(x509_pubkey(leaf)) == 64, "deno leaf is P-256")
    assert(len(x509_pubkey384(leaf)) == 0, "deno leaf not P-384")

    // 2. 中间证书（YE2）是 P-384
    let ye2 = hex_decode(deno.get(1))
    assert(len(x509_pubkey384(ye2)) == 96, "YE2 is P-384")
    assert(len(x509_pubkey(ye2)) == 0, "YE2 not P-256")

    // 3. 链验证：叶 <- YE2 <- Root YE（第三个是 P-384 签的 SHA384）
    // 用链尾的 ISRG Root X2 做锚（**它是自签根**；Root YE 由它签发，
    // 拿 Root YE 当锚在密码学上不成立——这正是下面第 5 项反证的内容）
    let x2 = hex_decode(deno.get(3))
    let inter3 = vec[str].new(3)
    inter3.push(ye2)
    inter3.push(hex_decode(deno.get(2)))
    assert(x509_verify_chain(leaf, inter3, x2, "deno.com", NOW) == 1, "deno chain to ISRG X2")

    // 4. 负向：域名不符 / 缺中间证书
    assert(x509_verify_chain(leaf, inter3, x2, "evil.com", NOW) == 0, "host mismatch")
    // 缺中间证书：叶直接对 X2 验签必须失败（YE2 才是它的签发者）
    let none_i = vec[str].new(0)
    assert(x509_verify_chain(leaf, none_i, x2, "deno.com", NOW) == 0, "missing intermediate")

    // 5. Root YE **不是**自签根（由 ISRG X2 签发）——自验证必须为 0。
    //    这条负向断言是 v2.99 的实地教训：一开始我把 Root YE 当锚，
    //    链验证失败，误判成 P-384 实现有 bug；实际是链构造错了。
    assert(x509_verify_self_p384(hex_decode(deno.get(2))) == 0, "Root YE is not self-signed")

    // 6. cloudflare：叶证书 P-256 + WE1 P-256，但签名是 SHA-384
    let cf = _cf()
    let cfleaf = hex_decode(cf.get(0))
    assert(len(x509_pubkey(cfleaf)) == 64, "cf leaf P-256")
    let we1 = hex_decode(cf.get(1))
    assert(len(x509_pubkey(we1)) == 64, "WE1 P-256")
    let cfi = vec[str].new(1)
    cfi.push(we1)
    let gtsr4 = hex_decode(cf.get(2))
    assert(x509_verify_chain(cfleaf, cfi, gtsr4, "cloudflare.com", NOW) == 1, "cf chain to GTS R4")

    print("p384chain ok")
}

// 2026-10-14：deno 四条与 cf 三条证书的共同有效期内（deno 叶证书 9-23 起有效）
const NOW = 1792000000

fn _deno() -> vec[str] {
    let t = vec[str].new(4)
    t.push("")
    t.push("")
    t.push("")
    t.push("")
    return t
}

fn _cf() -> vec[str] {
    let t = vec[str].new(3)
    t.push("")
    t.push("")
    t.push("")
    return t
}

