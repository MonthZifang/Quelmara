// t32_bits.qma：位运算与优先级（v1.1）
// 优先级链：|| < && < | < ^ < & < ==/!= < 关系 < << >> < + - < * / %
// 注意：这一层序是 Quelmara 自定的，与 Go（<< >> 在乘法层、| 在加法层）
// 和 Python（& 高于 ^）都不同，见 SPEC §2.4。
module t32

fn main() {
    // 基本运算
    assert((12 & 10) == 8, "and")
    assert((12 | 10) == 14, "or")
    assert((12 ^ 10) == 6, "xor")
    assert((~0) == -1, "not all ones")
    assert((~12) == -13, "not")
    assert((1 << 10) == 1024, "shl")
    assert((1024 >> 3) == 128, "shr")
    assert((-8 >> 1) == -4, ">> 是算术右移")
    assert((-8 >>> 1) == 9223372036854775804, ">>> 是逻辑右移")

    // 优先级：& 高于 |，<< 高于 &，+ 高于 <<
    assert((2 | 1 & 0) == 2, "and above or")
    assert(((1 << 4) & 0xF0) == 16, "shl above and")
    assert((1 << 2 + 1) == 8, "add above shl")
    assert((6 & 3 == 2) == 0, "eq above and")

    // 复合赋值
    let mut x = 1
    x <<= 5
    x |= 3
    x &= 0xFF
    x ^= 1
    x >>= 2
    assert(x == 8, "compound bitwise")
    let mut y = 7
    y %= 4
    assert(y == 3, "compound mod")

    // 典型用法：位掩码与 popcount
    let mut mask = 0
    let mut i = 0
    while i < 8 {
        mask = mask | (1 << i)
        i += 1
    }
    assert(mask == 255, "build mask")
    let mut cnt = 0
    let mut m = mask
    while m != 0 {
        cnt += m & 1
        m >>= 1
    }
    assert(cnt == 8, "popcount")

    print("bits ok")
}
