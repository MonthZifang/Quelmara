// s8_map.qma —— stage-1 编译器（qlmc）子集 S7 的差分夹具（v2.21）
//
// 覆盖：map[int]int（new / set / get / has / len，固定容量线性扫描）、
// 4 个实参的函数调用。与 stage-0 逐字节差分（tests/qlmc_test.py）。
fn mix(a: int, b: int, c: int, d: int) -> int {
    return a * 1000 + b * 100 + c * 10 + d
}

fn main() {
    print(mix(1, 2, 3, 4))

    let m = map[int]int.new(8)
    print(len(m))
    m.set(1, 100)
    m.set(2, 200)
    m.set(3, 300)
    print(len(m))
    print(m.get(1))
    print(m.get(2))
    print(m.get(3))
    print(m.has(2))
    print(m.has(9))

    // 覆盖已有键：长度不变
    m.set(2, 222)
    print(m.get(2))
    print(len(m))

    // 用循环累加
    let mut s = 0
    let mut i = 1
    while i <= 3 {
        s = s + m.get(i)
        i = i + 1
    }
    print(s)
}
