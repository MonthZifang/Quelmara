// s43_boolprint.qma —— 比较 / 逻辑结果一律按 bool 打印（v3.79，收 §7.22）
//
// ## 为什么需要它
//
// stage-0 曾经**自己就不一致**：编译期可折叠的比较折成 int（打 1），
// 运行期的比较是 bool（打 true）。同一个表达式形态两种输出。
//
//     let n = 3
//     let i = 0
//     print(i + 1 < n)   # true（运行期）
//     print(1 < 2)       # 1   （折叠）   <- 不一致
//
// 后来 qlmc 为了对齐选了 int 口径 —— 那是**把一个不一致固化进契约**。
// v3.79 反过来：两边都修成 bool，与语言定义（`02-language.md`：比较产生
// bool）一致。
//
// ## 覆盖的形态
//
//   [1] 折叠的比较（常量两侧）
//   [2] 运行期的比较（变量参与）
//   [3] `!` 一元（折叠 + 运行期）
//   [4] `&&` / `||`（本来就是 bool，钉住别退化）
//   [5] 比较结果存进变量再打印
//   [6] 混合：`!(a == b) && (c < d)`
//   [7] f64 比较
//   [8] str 比较
//  （聚合比较原本也在这里，但它暴露的是**分配器布局敏感**缺陷
//    —— 见 07-gaps §7.5 —— 与本条无关，挪到 s42_aggeq 单独覆盖。）
//
// 语义参照（stage-0）：全部 true / false
fn main() {
    let n = 3
    let i = 0
    let a = 1
    let b = 2
    let c = 2
    let d = 5

    // [1] 折叠
    print(1 < 2)
    print(2 < 1)
    print(1 == 1)
    print(1 != 2)

    // [2] 运行期
    print(i + 1 < n)
    print(a < b)
    print(c == b)

    // [3] 一元 !
    print(!(1 == 2))
    print(!(a == b))
    print(!true)

    // [4] && / ||
    print((1 < 2) && (3 > 2))
    print((1 > 2) || (3 > 2))
    print((a < b) && (d > n))

    // [5] 存进变量
    let t = 1 < 2
    print(t)
    let f = a > b
    print(f)

    // [6] 混合
    print(!(a == b) && (c < d))

    // [7] f64
    let x = 1.5
    let y = 2.5
    print(x < y)
    print(x == y)

    // [8] str
    print("ab" == "ab")
    print("ab" != "ab")
}
