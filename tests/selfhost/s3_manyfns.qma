// gen_big.qma —— 并行编译压测夹具（v2.16）：200 个函数，形状各异
module genbig

fn f0(a: int, b: int) -> int {
    let mut s = a * 3 + b
    let mut k = 0
    while k < 10 {
        s = s + k * 1 - 0
        if s > 100000 {
            s = s - 1000
        }
        k = k + 1
    }
    return s
}

