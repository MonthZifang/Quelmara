// s10_defer.qma —— stage-1 编译器（qlmc）子集 S9 的差分夹具（v2.23）
//
// 覆盖：defer 的四个关键口径——LIFO 顺序、块退出生效、return 前跑但
// **返回值先定**、循环体每次迭代都跑。与 stage-0 逐字节差分。
fn order() -> int {
    let mut x = 0
    defer x = x * 10 + 1
    defer x = x * 10 + 2
    defer x = x * 10 + 3
    return x
}

fn retval() -> int {
    let mut v = 1
    defer v = 999
    return v
}

fn block_scope(n: int) -> int {
    let mut a = 0
    defer a = a + 100
    if n > 0 {
        defer a = a + 7
        a = a + 1
    }
    return a
}

fn main() {
    print(order())
    print(retval())
    print(block_scope(1))
    print(block_scope(0))

    // 循环体里的 defer：每次迭代都执行一次
    let mut sum = 0
    let mut i = 0
    while i < 3 {
        defer sum = sum + i
        i = i + 1
    }
    print(sum)

    // defer 里调函数
    let mut t = 0
    defer t = t + order()
    print(t)
}
