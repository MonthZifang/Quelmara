// s47_flagloop.qma —— 标志位循环的语义（v3.86 建，v3.87 收 §7.47 并登记）
//
// ✅ **v3.87 起已登记进 `tests/qlmc_test.py` 的 CASES**，与 stage-0 逐字节差分。
//
// ## 那次"3 行不一致"到底是什么
//
// v3.86 观察到 qlmc 只跑一轮循环（stage-0 打 3、qlmc 打 1）。v3.87 定位：
// **不是源码缺陷，是本地 `build/qlmc.exe` 陈旧**。那个二进制是 14:05 用一次
// 已完全回退的 `_opt_flag_loop`（"标志位循环 -> break"）实验编出来的，而该
// pass **从未进入任何提交**（`git log -S_opt_flag_loop -- bootstrap/qlmc/qlmc.qma`
// 为空）。从 HEAD 干净重建的 qlmc 对本文件 12 行输出与 stage-0 逐字节一致。
//
// 教训：差分测试必须**每次从源码重建被测编译器**（`tests/qlmc_test.py` 就是
// 这么做的，所以 CI 一直是绿的）；手跑 `wine build/qlmc.exe` 验的是磁盘上
// 那个来历不明的二进制，不是当前源码。
//
// ## 为什么仍然需要它
//
// v3.84 试过把 `while go == 1 && ...` 里的 `go = 0` 直接改写成 `break`
// （"标志位循环 → break"），IR 层看起来完全正确（守卫里的 `cmp go, 1`
// 确实被消掉了），**但运行时校验和错了、程序提前退出**。
//
// 根因：`go` 是 pin 变量，当时只验证了"它只被 CONST 定义"，**没验证
// "循环外没有其他读者"**。`go` 在循环结束后可能还被读到（甚至被再次
// 赋值），把它当纯循环标志是错的。
//
// 所以这个夹具存在的意义是**先把语义钉住**：以后谁再试这个优化，
// 一跑差分就知道有没有破坏行为。
//
// ## 覆盖的形态
//
//   [1] `while go == 1 && ...`，`go = 0` 在 else 分支（jws 的形状）
//   [2] `go` 在循环**结束后**仍被读取
//   [3] `go` 在循环**外**被重新赋值，再进第二个循环
//   [4] 两个标志位循环串联
//   [5] `go` 作为返回值的一部分
//   [6] 标志位在循环内被重新置 1（不能被当成 break）
//
// 语义参照（stage-0）：见下方 print 顺序
fn scan_ws(s: str, p0: int) -> int {
    let n = len(s)
    let mut p = p0
    let mut go = 1
    while go == 1 && p < n {
        let c = s[p]
        if c == 32 || c == 9 {
            p = p + 1
        } else {
            go = 0
        }
    }
    return p
}

fn scan_and_report(s: str) -> int {
    let n = len(s)
    let mut p = 0
    let mut go = 1
    while go == 1 && p < n {
        if s[p] == 88 {          // 'X'
            go = 0
        } else {
            p = p + 1
        }
    }
    // [2] `go` 在循环结束后**仍被读取**
    let r = p * 10
    if go == 0 {
        return r + 1
    }
    return r + 2
}

fn two_loops(s: str) -> int {
    let n = len(s)
    let mut p = 0
    let mut go = 1
    while go == 1 && p < n {
        if s[p] == 65 {          // 'A'
            go = 0
        } else {
            p = p + 1
        }
    }
    let a = p
    // [3] `go` 在循环外**被重新赋值**，再进第二个循环
    go = 1
    while go == 1 && p < n {
        if s[p] == 66 {          // 'B'
            go = 0
        } else {
            p = p + 1
        }
    }
    // [4] 两个循环串联后，go 仍是 0
    return a * 100 + p * 10 + go
}

fn rearm(s: str) -> int {
    let n = len(s)
    let mut p = 0
    let mut go = 1
    let mut hits = 0
    while go == 1 && p < n {
        if s[p] == 67 {          // 'C'
            hits = hits + 1
            go = 1               // [6] 重新置 1：不能当成 break
        } else {
            go = 0
        }
        p = p + 1
    }
    return hits * 1000 + p
}

fn main() {
    // [1] 基本形态
    print(scan_ws("   abc", 0))
    print(scan_ws("abc", 0))
    print(scan_ws("     ", 0))

    // [2] 循环后仍读 go
    print(scan_and_report("abcXdef"))
    print(scan_and_report("abcdef"))

    // [3][4] 两个循环串联
    print(two_loops("xyABz"))
    print(two_loops("AB"))
    print(two_loops("zzz"))

    // [5] go 参与返回值
    let s = "  q"
    let pos = scan_ws(s, 0)
    print(pos * 100 + len(s))

    // [6] 循环内重新置 1
    print(rearm("CCCx"))
    print(rearm("xCCC"))
    print(rearm("CCCCC"))
}
