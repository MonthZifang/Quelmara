// t13_spawn.ros：spawn / join 任务并行（SPEC §4）
// 覆盖：多任务并行、join 取返回值、void 任务、单核降级后结果不变
module t13

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn square(x: int) -> int {
    return x * x
}

fn mark(x: int) {
    assert(x > 0, "mark positive")
}

fn is_abc(s: str) -> int {
    if s == "abc" {
        return 1
    }
    return 0
}

fn main() {
    // 1) 两个独立任务并行，join 按任务取回结果
    let a = spawn fib(20)
    let b = spawn square(9)
    let ra = join(a)
    let rb = join(b)
    assert(ra == 6765, "fib(20) via spawn")
    assert(rb == 81, "square(9) via spawn")
    print(ra)
    print(rb)

    // 2) 同函数多任务 + 结果求和
    let h1 = spawn fib(10)
    let h2 = spawn fib(10)
    let sum = join(h1) + join(h2)
    assert(sum == 110, "two fib(10) via spawn")
    print(sum)

    // 3) void 任务：join 只做同步，返回 0
    let h3 = spawn mark(7)
    assert(join(h3) == 0, "void task join")

    // 4) str 实参跨线程（只读字符串；worker 内的 if 也走内容比较）
    let h4 = spawn is_abc("abc")
    let h5 = spawn is_abc("zzz")
    assert(join(h4) == 1, "str arg task true")
    assert(join(h5) == 0, "str arg task false")

    print("spawn ok")
}
