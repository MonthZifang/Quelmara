module t72

import std.hex
import std.rsa

fn main() {
    let n = hex_decode("")
    let sig = hex_decode("")
    let h = hex_decode("8d39d9203098c48a32cc5bfaa549d4bea4384e5eceee074e0bf5227548f399a3")
    assert(rsa_verify_pkcs1_sha256(n, 65537, sig, h) == 1, "2048 valid")
    print("ok t72_rsa2048")
}
