module t23

// L1 浮点冒烟：字面量/运算/比较/转换/格式化（f64）
fn area(w: float, h: float) -> float {
    return w * h
}

fn main() {
    let a = 1.5
    let b = 2.25
    print(a + b)            // 3.75
    print(a * b)            // 3.375
    print(b / a)            // 1.5
    print(b - a)            // 0.75
    print(a < b)            // true
    print(a == 1.5)         // true
    print(-a)               // -1.5
    let s = area(3.0, 4.5)
    print(s)                // 13.5
    print(to_int(3.99))     // 3
    print(to_int(-3.99))    // -3
    print(to_float(7) / 2.0) // 3.5
    print(0.000001)         // 0.000001
    print(0.0000001)        // 1e-7
    print(1e12)             // 1e+12
    print(123.456)          // 123.456
    print(2.0)              // 2
    print(1.0 / 3.0)        // 0.333333
    let t = 2.5
    print(t.to_str())       // 2.5
}
