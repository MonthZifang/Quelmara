// t146_const_div.qma：常数除法 / 取模的魔数乘法（v2.61）
//
// stage-0 原来对 `a / C` / `a % C` 一律发 `idiv`（20-40 周期）。v2.61 起
// 对"被除数已知非负"的位置换成 `umulhi + shr`（取模再加 `imul + sub`）。
//
// 校验口径：`q*C + r == a` **且** `0 <= r < C` ⇒ q 必是 floor(a/C)（唯一解）。
// 只测等式不测余数范围，会把"q 少 1、r 多 C"也算对。
module t146

fn main() {
    let mut bad = 0
    let mut i = 0
    while i < 4000 {
        let q3 = i / 3
        let r3 = i % 3
        if q3 * 3 + r3 != i || r3 < 0 || r3 >= 3 { bad = bad + 1 }

        let q7 = i / 7
        let r7 = i % 7
        if q7 * 7 + r7 != i || r7 < 0 || r7 >= 7 { bad = bad + 1 }

        let q10 = i / 10
        let r10 = i % 10
        if q10 * 10 + r10 != i || r10 < 0 || r10 >= 10 { bad = bad + 1 }

        let q13 = i / 13
        let r13 = i % 13
        if q13 * 13 + r13 != i || r13 < 0 || r13 >= 13 { bad = bad + 1 }

        let q1k = i / 1000
        let r1k = i % 1000
        if q1k * 1000 + r1k != i || r1k < 0 || r1k >= 1000 { bad = bad + 1 }

        i = i + 1
    }
    assert(bad == 0, "0..3999 的常数除法/取模")

    // 边界：2^k 附近（魔数乘法最容易在这里错一位）
    let b31 = 2147483647
    assert(b31 / 7 * 7 + b31 % 7 == b31 && b31 % 7 < 7, "2^31-1")
    assert(b31 / 10 == 214748364 && b31 % 10 == 7, "2^31-1 / 10")

    let b32 = 4294967296
    assert(b32 / 3 * 3 + b32 % 3 == b32 && b32 % 3 < 3, "2^32")
    assert(b32 / 10 == 429496729 && b32 % 10 == 6, "2^32 / 10")

    let b40 = 1099511627776
    assert(b40 / 13 * 13 + b40 % 13 == b40 && b40 % 13 < 13, "2^40")
    assert(b40 / 1000 == 1099511627 && b40 % 1000 == 776, "2^40 / 1000")

    let b50 = 1125899906842624
    assert(b50 / 7 * 7 + b50 % 7 == b50 && b50 % 7 < 7, "2^50")

    // 商与余数的定义性质：a = q*c + r，且 a 增加 c 时商恰好 +1
    let mut j = 0
    while j < 500 {
        let a = j * 37 + 11
        if (a / 13) + 1 != (a + 13) / 13 { bad = bad + 1 }
        if (a % 13) != ((a + 13) % 13) { bad = bad + 1 }
        j = j + 1
    }
    assert(bad == 0, "商的平移性质")

    print("const div ok")
}
