// t95_hash512.qma：SHA-512 / SHA-384 / HMAC-SHA512 / CRC-64（v1.51）
// 覆盖：FIPS 180-4 标准向量（空/abc/112B/128B/多块 1000B）、RFC 4231 HMAC
// 五例（含长 key）、CRC-64/XZ 公开 check 值锚定。64 位路径专项：全 1 init、
// >2^63 轮常量、>>> 逻辑右移。
module t95

import std.sha512
import std.crc64
import std.str

fn main() {
    assert(sha512_hex("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "sha512 empty")
    assert(sha512_hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512 abc")
    assert(sha512_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") == "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909", "sha512 m112")
    assert(sha512_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstuabcdefghbcdefghicdefghijdefghijkefghijklfghijklmnhijklmnoijklmno") == "049d387a832183025aaabe1af1e34bb4f83bd8591512aa992a404e00e733688f090302120181e61a217fcc132d074f8f66986e317fdfb8d1f6c360c233ac80d5", "sha512 m128")
    assert(sha512_hex("The quick brown fox jumps over the lazy dog") == "07e547d9586f6a73f73fbac0435ed76951218fb7d0c8d788a309d785436bbb642e93a252a954f23912547d1e8a3b5ed6e1bfd7097821233fa0538f3db854fee6", "sha512 quote")
    assert(sha512_hex("") == "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97", "sha512 rep1000")
    assert(sha384_hex("") == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b", "sha384 empty")
    assert(sha384_hex("abc") == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7", "sha384 abc")
    assert(sha384_hex("The quick brown fox jumps over the lazy dog") == "ca737f1014a48f4c0b6dd43cb177b0afd9e5169367544c494011e3317dbf9a509cb1e5dc1e85a941bbee3d7f2afbc9b1", "sha384 quote")
    assert(hmac_sha512_hex("\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", "Hi There") == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854", "hmac512 tc1")
    assert(hmac_sha512_hex("Jefe", "what do ya want for nothing?") == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737", "hmac512 tc2")
    assert(hmac_sha512_hex("\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa", "\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd\xdd") == "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb", "hmac512 tc3")
    assert(hmac_sha512_hex("\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c", "Test With Truncation") == "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b", "hmac512 tc6")
    assert(hmac_sha512_hex("\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f\x80\x81\x82\x83", "Test Using Larger Than Block-Size Key - Hash Key First") == "741d2082f9d5da744bf727e7f37af0debabdf844cadd59ff66a5e850a982b59e7acf26a0fc5912d3bc55e155c54aedbdd0e681813dc44fdb7dc030ef15516063", "hmac512 tc7")
    assert(crc64_hex("123456789") == "995dc9bbdf1939fa", "crc64 xz check anchor")
    assert(crc64_hex("") == "0000000000000000", "crc64 empty")
    assert(crc64_hex("abc") == "2cd8094a1a277627", "crc64 abc")
    assert(crc64_hex("The quick brown fox jumps over the lazy dog") == "5b5eb8c2e54aa1c4", "crc64 quote")
    assert(crc64_hex(str_repeat("a", 1000)) == "7610eeea8be8d96c", "crc64 rep1000")
    let d = sha512_str("abc")
    assert(mem_load8(d, 0) == 0xDD, "digest buf first byte")
    assert(mem_load8(d, 63) == 0x9F, "digest buf last byte")
    mem_free(d, 64)
    print("ok t95_hash512")
}
