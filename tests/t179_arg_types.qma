// t179_arg_types.qma —— 调用点标量类型比对（v3.31，收 §7.14）
//
// 背景：v2.07 在 `std/net/addr` 把 `str_find_from(s, from, needle)` 的
// 实参写反（第 2 个位置给了 str、第 3 个给了 int），编译器**一句都不说**，
// 程序当场 SIGSEGV。因为 str / int / 指针在 IR 里都是一个 8 字节槽。
//
// v3.31 在调用点做**保守**的标量类型比对：字面量与已知返回类型的调用
// 会被检查，变量一律放行（stage-0 没有完整的类型传播，见 §7.28）。
//
// 这个夹具验证的是"检查没有误伤正确代码"——错误路径由 Python 侧的
// `case_arg_types` 编译失败断言覆盖（那需要一个**编不过**的源文件，
// 放进主夹具会让整个文件编不过）。
module t179_arg_types

fn takes_str_int(a: str, b: int) -> int {
    return len(a) + b
}

fn takes_bool(flag: bool) -> int {
    if flag {
        return 1
    }
    return 0
}

fn main() {
    // [1] 正确调用必须编过（回归保护：别把对的拦下来）
    assert(takes_str_int("abc", 5) == 8, "str+int 正确调用")
    assert(takes_str_int("", 0) == 0, "空串")

    // [2] 内建返回值参与调用：len() 是 int，必须能传给 int 形参
    let s = "hello"
    assert(takes_str_int(s, len(s)) == 10, "len() 返回 int")

    // [3] 变量放行（静态不可判，不能误报）
    let v = "var"
    let n = 3
    assert(takes_str_int(v, n) == 6, "变量实参放行")

    // [4] 字面量 bool 传给 bool 形参
    assert(takes_bool(true) == 1, "bool 字面量")
    assert(takes_bool(false) == 0, "bool 字面量 false")

    // [5] int 与 bool 互传不拦（语言允许 0/1 当 bool 用，历史上也这么写）
    assert(takes_bool(1) == 1, "int 传给 bool 形参（允许）")

    // [6] 用户函数返回值参与调用（已知返回类型）
    assert(takes_str_int(concat2("a", "b"), 1) == 3, "用户函数返回 str")

    print("PASS: 调用点标量类型比对没有误伤正确代码")
}

fn concat2(a: str, b: str) -> str {
    return a + b
}
