// t71_rsa.qma：RSA PKCS#1 v1.5 + SHA-256 验签（v1.27）
// 向量由 Python 纯整数生成（1024 位密钥，与 Quelmara 实现完全独立）。
module t71

import std.hex
import std.rsa

fn main() {
    let n = hex_decode("87ab34b8326e4ac38cebe6aa0b2f1e85574e3fd9de51df771c8e01c3337026c6772c2f7c159f789942ee97ac6b4149305df15e5ec74ee40417fb084d9b97d36d74802010b8ce714334d98b30e08a4370dbec68607466337e0d598a5d74ca74065663607535af25ea8562f5c685410226c1f322a37f867a9305d8627426d6fb51")
    let sig = hex_decode("72b11cea360ee1ba7db4162174cf12b472297694f317bcf10ed5f9ded3297a5a1af1ff1255bc7a85de277233beaa7ac695c919d4cc09995697b104757be34883d03a995690fb6c3219fe269332d95802223ab1e58370123a8cb5a96a77fda21e269978703085148d270cf358a9d27698b33b4116c7bdd20323d78787b03f0a1a")
    let h = hex_decode("9ea2c90cc3ce592a84853e5b54f7c89bbc19ccf8206b29ff418cca9891e30774")

    // 1) 合法签名
    assert(rsa_verify_pkcs1_sha256(n, 65537, sig, h) == 1, "valid signature")

    // 2) 篡改签名
    let bad = hex_decode("72b11cea360ee1ba7db4162174cf12b472297694f317bcf10ed5f9ded3297a5a1af1ff1255bc7a85de277233beaa7ac695c919d4cc09995697b104757be34883d03a995690fb6c3219fe269332d95802223ab1e58370123a8cb5a96a77fda21e269978703085148d270cf358a9d27698b33b4116c7bdd20323d78787b03f0a1b")
    assert(rsa_verify_pkcs1_sha256(n, 65537, bad, h) == 0, "tampered sig")

    // 3) 篡改摘要
    let bh = hex_decode("9fa2c90cc3ce592a84853e5b54f7c89bbc19ccf8206b29ff418cca9891e30774")
    assert(rsa_verify_pkcs1_sha256(n, 65537, sig, bh) == 0, "tampered hash")

    // 4) 错误指数
    assert(rsa_verify_pkcs1_sha256(n, 3, sig, h) == 0, "wrong exponent")

    // 5) PSS：合法签名
    let pn = hex_decode("87ab34b8326e4ac38cebe6aa0b2f1e85574e3fd9de51df771c8e01c3337026c6772c2f7c159f789942ee97ac6b4149305df15e5ec74ee40417fb084d9b97d36d74802010b8ce714334d98b30e08a4370dbec68607466337e0d598a5d74ca74065663607535af25ea8562f5c685410226c1f322a37f867a9305d8627426d6fb51")
    let ps = hex_decode("2c4490e3316054248057831e476e414f2cf70c52d6701d4557e62d4729864161682d94431c4113c374ff17f39d93462212e1b58140384cb977506dee2a58594c3196c8ce952bfdd26f4c8d5b00ce153d1b93b67f36a9195093809665c587d8888e1702a10df75caeb9d9b986a750c2360e9716f3fb199cc6ad4ee40d89c1223c")
    let ph = hex_decode("01193b1ea74e71f7b21618d6b079a223cca1969feef26adef064af38db9cf7e5")
    assert(rsa_verify_pss_sha256(pn, 65537, ps, ph, 32) == 1, "pss valid")

    // 6) PSS：篡改签名
    let pbad = hex_decode("2c4490e3316054248057831e476e414f2cf70c52d6701d4557e62d4729864161682d94431c4113c374ff17f39d93462212e1b58140384cb977506dee2a58594c3196c8ce952bfdd26f4c8d5b00ce153d1b93b67f36a9195093809665c587d8888e1702a10df75caeb9d9b986a750c2360e9716f3fb199cc6ad4ee40d89c1223d")
    assert(rsa_verify_pss_sha256(pn, 65537, pbad, ph, 32) == 0, "pss tampered")

    print("ok t71_rsa")
}
