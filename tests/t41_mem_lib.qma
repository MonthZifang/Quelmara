// tests/t41_mem_lib.qma —— std.mem 自校验（slab / fdtab / buf）
module t41_mem_lib

import std.core
import std.mem

fn main() {
    // ---- slab ----
    let h = slab_new(8, 4)                 // 8 槽 × 32 字节
    assert(slab_cap(h) == 8, "slab cap")
    let a = slab_alloc(h)
    let b = slab_alloc(h)
    let c = slab_alloc(h)
    assert(a == 0 and b == 1 and c == 2, "slab 顺序分配")
    let pa = slab_ptr(h, a)
    mem_store64(pa, 1, 1234)
    assert(mem_load64(slab_ptr(h, a), 1) == 1234, "slab ptr 稳定")
    slab_free(h, b)
    let d = slab_alloc(h)
    assert(d == b, "slab 复用刚释放的槽")
    // 分配满（此时已用 3 槽，剩 5 槽：第 6 次必然 -1）
    let mut k = 0
    let mut last = 0
    while k < 6 {
        last = slab_alloc(h)
        k = k + 1
    }
    assert(last == -1, "slab 满返回 -1")
    // 槽位清零（新分配必须干净）
    slab_free(h, a)
    let e = slab_alloc(h)
    assert(e == a, "slab 回收到 a")
    assert(mem_load64(slab_ptr(h, e), 1) == 0, "slab 复用前清零")

    // ---- fdtab ----
    let t = fdtab_new(1024)
    let mut i = 0
    while i < 500 {
        fdtab_put(t, i * 3 + 7, i)         // 故意用非连续 fd
        i = i + 1
    }
    assert(fdtab_len(t) == 500, "fdtab count")
    assert(fdtab_get(t, 7) == 0, "fdtab get 0")
    assert(fdtab_get(t, 7 + 3 * 499) == 499, "fdtab get last")
    assert(fdtab_get(t, 999999) == -1, "fdtab miss")
    // 删除一半后再查剩下的
    let mut j = 0
    while j < 500 {
        if j % 2 == 0 {
            fdtab_del(t, j * 3 + 7)
        }
        j = j + 1
    }
    assert(fdtab_len(t) == 250, "fdtab count after del")
    let mut j2 = 0
    let mut bad = 0
    while j2 < 500 {
        let got = fdtab_get(t, j2 * 3 + 7)
        if j2 % 2 == 0 {
            if got != -1 {
                bad = bad + 1
            }
        } else {
            if got != j2 {
                bad = bad + 1
            }
        }
        j2 = j2 + 1
    }
    assert(bad == 0, "fdtab 删除后探测链完整")

    // ---- buf ----
    let bb = buf_new(64)
    assert(buf_put_str(bb, "GET /x HTTP/1.1\r\n") == 0, "buf put str")
    assert(buf_put_str(bb, "Host: a\r\n\r\n") == 0, "buf put str2")
    assert(buf_len(bb) == 28, "buf len")
    assert(buf_find(bb, 0, "/x") == 4, "buf find")
    assert(buf_find_head_end(bb) == 24, "buf head end")
    assert(buf_find_ci(bb, 0, "host:") == 17, "buf find ci")
    let s = buf_str(bb)
    assert(len(s) == 28, "buf str")

    print("ok t41_mem_lib")
}
