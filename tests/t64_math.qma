// t64_math.qma：std/math + std/log 级别过滤 —— v1.19
// 覆盖：取整四方向、幂/根、整数工具、NaN/inf 判定、日志级别过滤。
module t64

import std.math
import std.log

fn near(a: f64, b: f64, eps: f64) -> int {
    if fabs(a - b) < eps {
        return 1
    }
    return 0
}

fn main() {
    // ---- 绝对值 / 符号 ----
    assert(fabs(-3.5) == 3.5, "fabs")
    assert(fabs(2.25) == 2.25, "fabs pos")
    assert(fsign(-9.0) == -1, "fsign neg")
    assert(fsign(0.0) == 0, "fsign zero")
    assert(fsign(1.5) == 1, "fsign pos")

    // ---- 取整 ----
    assert(floor(2.7) == 2.0, "floor pos")
    assert(floor(-2.1) == -3.0, "floor neg")
    assert(floor(5.0) == 5.0, "floor exact")
    assert(ceil(2.1) == 3.0, "ceil pos")
    assert(ceil(-2.7) == -2.0, "ceil neg")
    assert(ceil(5.0) == 5.0, "ceil exact")
    assert(trunc_f(-2.7) == -2.0, "trunc neg")
    assert(trunc_f(2.7) == 2.0, "trunc pos")
    assert(round(2.4) == 2.0, "round down")
    assert(round(2.5) == 3.0, "round half up")
    assert(round(-2.5) == -3.0, "round neg half")

    // ---- 幂与根 ----
    assert(powi(2.0, 10) == 1024.0, "powi 2^10")
    assert(powi(2.0, 0) == 1.0, "powi 0")
    assert(powi(2.0, -2) == 0.25, "powi neg")
    assert(powi(-2.0, 3) == -8.0, "powi odd neg base")

    assert(sqrt(0.0) == 0.0, "sqrt 0")
    assert(sqrt(1.0) == 1.0, "sqrt 1")
    assert(near(sqrt(4.0), 2.0, 0.000000001) == 1, "sqrt 4")
    assert(near(sqrt(2.0), 1.4142135623730951, 0.000000001) == 1, "sqrt 2")
    assert(near(sqrt(1e12), 1000000.0, 0.001) == 1, "sqrt 1e12")
    assert(near(sqrt(0.0001), 0.01, 0.000000001) == 1, "sqrt 1e-4")

    assert(near(cbrt(27.0), 3.0, 0.000000001) == 1, "cbrt 27")
    assert(near(cbrt(-8.0), -2.0, 0.000000001) == 1, "cbrt -8")

    // ---- 整数 ----
    assert(isqrt(0) == 0, "isqrt 0")
    assert(isqrt(16) == 4, "isqrt 16")
    assert(isqrt(17) == 4, "isqrt 17")
    assert(isqrt(1000000) == 1000, "isqrt 1e6")
    assert(gcd(12, 18) == 6, "gcd")
    assert(gcd(-12, 18) == 6, "gcd neg")
    assert(lcm(4, 6) == 12, "lcm")
    assert(lcm(0, 5) == 0, "lcm zero")
    assert(clamp_int(15, 0, 10) == 10, "clamp hi")
    assert(clamp_int(-3, 0, 10) == 0, "clamp lo")
    assert(clamp_int(5, 0, 10) == 5, "clamp in")
    assert(imin(3, 7) == 3, "imin")
    assert(imax(3, 7) == 7, "imax")
    assert(clamp_f(1.5, 0.0, 1.0) == 1.0, "clamp_f")

    // ---- 特殊值 ----
    assert(is_nan(1.0) == 0, "not nan")
    assert(is_inf(1.0) == 0, "not inf")
    assert(is_finite(1.0) == 1, "finite")
    assert(is_finite(0.0) == 1, "finite zero")

    // ---- 日志级别过滤 ----
    assert(log_level() == 0, "log default level")
    log_set_level(2)
    assert(log_level() == 2, "log set level")
    log_info("这条不该出现")
    log_warn("这条也不该出现")
    log_error("这条应该出现")
    log_set_level(0)
    log_info("级别已恢复")

    print("ok t64_math")
}
