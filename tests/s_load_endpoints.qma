// Scalar loads may overwrite a dying address/index register after computing
// the complete effective address. Retained operands and loop values must live.
module load_endpoints

struct Pair { a: int, b: int }

fn mixed(v: vec[int], w: vec[int], i: int, j: int) -> int {
    // Multiple independent address calculations overlap with live arithmetic.
    return v.get(i + 1) * w.get(j + 2) + v.get(j + 2) - w.get(i + 1)
}

fn retained(v: vec[int], i: int) -> int {
    let j = i + 1
    let x = v.get(j)
    return x + v.get(j + 1) + j
}

fn fields(p: Pair) -> int {
    return p.a * 7 + p.b * 11 + p.a
}

fn bytes(s: str, i: int) -> int {
    return s[i + 1] * 3 + s[i + 2] * 5 + s[i + 3]
}

struct BytePair { a: u8, b: u8 }

fn narrow_fields(p: BytePair) -> int {
    return p.a * 3 + p.b
}

fn byte_array(a: [4]u8, i: int) -> int {
    return a[i + 1] + a[i + 2]
}

fn raw_words(p: int, i: int) -> int {
    // p stays live for both indexed loads; each computed index dies at its load.
    return mem_load64(p, i + 1) * 3 + mem_load64(p, i + 2)
}

fn int_array(a: [4]int, i: int) -> int {
    return a[i + 1] + a[i + 2]
}

fn main() {
    let raw = mem_alloc(64)
    let mut ri = 0
    while ri < 8 {
        mem_store64(raw, ri, ri * 5 + 1)
        ri = ri + 1
    }
    print(raw_words(raw, 0))  // 6*3 + 11 = 29; fused LOADX index dies here

    let arr: [4]int = [3, 5, 7, 9]
    print(int_array(arr, 0))  // 5 + 7 = 12; fixed-array LOADX
    print(narrow_fields(BytePair { a: 7, b: 11 }))  // 7*3 + 11 = 32; LOAD8D
    let barr: [4]u8 = [2, 4, 6, 8]
    print(byte_array(barr, 0))  // 4 + 6 = 10; indexed LOAD8X

    let a = vec[int].new(1)
    let b = vec[int].new(1)
    let alias = a
    let mut i = 0
    while i < 32 {
        a.push(i * 7 - 53)
        b.push(i * 3 + 11)
        i = i + 1
    }
    let mut sum = 0
    i = 0
    while i < 16 {
        sum = sum + mixed(alias, b, i, 15 - i)
        sum = sum + retained(a, i)
        a.set(i, a.get(i) + b.get(i))
        i = i + 1
    }
    print(sum)
    print(a.get(0))
    print(a.get(15))
    print(a.get(31))
    print(fields(Pair { a: -17, b: 23 }))
    print(bytes("0123456789abcdef", 4))

    // Repeated aliased reads/stores, nested loops, and a second loop keep
    // long-lived addresses and accumulators from being reused at endpoints.
    let mut total = 0
    let mut r = 0
    while r < 4 {
        let mut c = 0
        while c < 8 {
            let j = r * 8 + c
            alias.set(j, alias.get(j) + b.get(j) * (r + 1))
            total = total + a.get(j)
            c = c + 1
        }
        r = r + 1
    }
    print(total)
    print(a.get(0))
    print(a.get(31))
}
