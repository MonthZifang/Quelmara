// t90_mathfn.qma：std/math 超越函数（v1.47）—— exp/log/pow/三角/反三角/双曲/hypot
// 覆盖：算法精度（对拍 Python math：exp/log/pow/atan 系 eps 1e-12，
// sin/cos/tan 大角度 eps 1e-9——归约误差随 |x|·1.1e-16 增长是已知边界）、
// 精确路径（整数幂/0 与 1 的特殊值）、特殊值（NaN/inf）、溢出边界
// （exp(710)=inf、exp(-746)=0、sinh(710)/cosh(710) 有限值）。
module t90

import std.math

fn near(a: f64, b: f64, eps: f64) -> int {
    let mut d = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    let mut t = fabs(b)
    if t < 1.0 {
        t = 1.0
    }
    if d <= eps * t {
        return 1
    }
    return 0
}

fn main() {
    assert(pi() == 3.141592653589793, "const pi()")
    assert(e() == 2.718281828459045, "const e()")
    assert(ln2() == 0.6931471805599453, "const ln2()")
    assert(ln10() == 2.302585092994046, "const ln10()")
    assert(sqrt2() == 1.4142135623730951, "const sqrt2()")
    assert(is_nan(nan()) == 1, "nan() is nan")
    assert(is_inf(inf()) == 1, "inf() is inf")
    assert(near(exp(0.0), 1.0, 1e-12) == 1, "exp 0.0")
    assert(near(exp(1.0), 2.718281828459045, 1e-12) == 1, "exp 1.0")
    assert(near(exp(-1.0), 0.36787944117144233, 1e-12) == 1, "exp -1.0")
    assert(near(exp(0.5), 1.6487212707001282, 1e-12) == 1, "exp 0.5")
    assert(near(exp(2.5), 12.182493960703473, 1e-12) == 1, "exp 2.5")
    assert(near(exp(-0.3), 0.7408182206817179, 1e-12) == 1, "exp -0.3")
    assert(near(exp(20.0), 485165195.4097903, 1e-12) == 1, "exp 20.0")
    assert(near(exp(-20.0), 2.061153622438558e-09, 1e-12) == 1, "exp -20.0")
    assert(near(exp(100.0), 2.6881171418161356e43, 1e-12) == 1, "exp 100.0")
    assert(near(exp(-100.0), 3.720075976020836e-44, 1e-12) == 1, "exp -100.0")
    assert(near(exp(700.0), 1.0142320547350045e304, 1e-12) == 1, "exp 700.0")
    assert(near(exp(-700.0), 9.85967654375977e-305, 1e-12) == 1, "exp -700.0")
    assert(near(exp(709.0), 8.218407461554972e307, 1e-12) == 1, "exp 709.0")
    assert(near(exp(-745.0), 5e-324, 1e-12) == 1, "exp -745.0")
    assert(exp(0.0) == 1.0, "exp 0 exact")
    assert(is_inf(exp(1000.0)) == 1, "exp 1000 inf")
    assert(exp(0.0 - 746.0) == 0.0, "exp -746 underflow")
    assert(near(log(e()), 1.0, 1e-12) == 1, "log e")
    assert(near(log(2.0), 0.6931471805599453, 1e-12) == 1, "log 2.0")
    assert(near(log(10.0), 2.302585092994046, 1e-12) == 1, "log 10.0")
    assert(near(log(0.5), -0.6931471805599453, 1e-12) == 1, "log 0.5")
    assert(near(log(100.0), 4.605170185988092, 1e-12) == 1, "log 100.0")
    assert(near(log(1e-300), -690.7755278982137, 1e-12) == 1, "log 1e-300")
    assert(near(log(1e300), 690.7755278982137, 1e-12) == 1, "log 1e+300")
    assert(near(log(1e-10), -23.025850929940457, 1e-12) == 1, "log 1e-10")
    assert(near(log(0.001), -6.907755278982137, 1e-12) == 1, "log 0.001")
    assert(near(log(7.5), 2.0149030205422647, 1e-12) == 1, "log 7.5")
    assert(log(1.0) == 0.0, "log 1 exact")
    assert(is_inf(log(0.0)) == 1, "log 0 = -inf")
    assert(is_nan(log(0.0 - 1.0)) == 1, "log neg = nan")
    assert(near(log2(8.0), 3.0, 1e-12) == 1, "log2 8.0")
    assert(near(log2(1024.0), 10.0, 1e-12) == 1, "log2 1024.0")
    assert(near(log2(0.25), -2.0, 1e-12) == 1, "log2 0.25")
    assert(near(log2(3.0), 1.584962500721156, 1e-12) == 1, "log2 3.0")
    assert(log2(1.0) == 0.0, "log2 1 exact")
    assert(near(log10(1000.0), 3.0, 1e-12) == 1, "log10 1000.0")
    assert(near(log10(0.01), -2.0, 1e-12) == 1, "log10 0.01")
    assert(near(log10(2.5), 0.3979400086720376, 1e-12) == 1, "log10 2.5")
    assert(log10(1.0) == 0.0, "log10 1 exact")
    assert(pow(2.0, 10.0) == 1024.0, "pow 2^10 exact")
    assert(pow(10.0, 3.0) == 1000.0, "pow 10^3 exact")
    assert(pow(2.0, 0.0 - 2.0) == 0.25, "pow 2^-2 exact")
    assert(pow(0.5, 2.0) == 0.25, "pow half squared")
    assert(pow(0.0 - 2.0, 3.0) == -8.0, "pow neg odd")
    assert(pow(0.0 - 2.0, 2.0) == 4.0, "pow neg even")
    assert(pow(7.0, 0.0) == 1.0, "pow y=0")
    assert(pow(0.0, 0.0) == 1.0, "pow 0^0 = 1")
    assert(pow(0.0, 1.0) == 0.0, "pow 0^1 = 0")
    assert(near(pow(2.0, 0.5), 1.4142135623730951, 1e-12) == 1, "pow sqrt")
    assert(near(pow(27.0, 1.0 / 3.0), 3.0, 1e-12) == 1, "pow cbrt")
    assert(near(pow(1.5, 2.5), 2.7556759606310752, 1e-12) == 1, "pow frac")
    assert(near(pow(10.0, 0.0 - 3.0), 0.001, 1e-12) == 1, "pow 10^-3")
    assert(near(pow(0.1, 0.1), 0.7943282347242815, 1e-12) == 1, "pow small")
    assert(is_inf(pow(0.0, 0.0 - 1.0)) == 1, "pow 0^-1 = inf")
    assert(is_inf(pow(2.0, 5000.0)) == 1, "pow 2^5000 = inf")
    assert(pow(1e-300, 2.0) == 0.0, "pow 1e-300^2 underflow")
    assert(is_nan(pow(0.0 - 2.0, 0.5)) == 1, "pow neg frac = nan")
    assert(sin(0.0) == 0.0, "sin 0 exact")
    assert(near(sin(1.0), 0.8414709848078965, 1e-12) == 1, "sin 1.0")
    assert(near(sin(-1.5), -0.9974949866040544, 1e-12) == 1, "sin -1.5")
    assert(near(sin(100.0), -0.5063656411097588, 1e-12) == 1, "sin 100.0")
    assert(near(sin(1000.0), 0.8268795405320025, 1e-12) == 1, "sin 1000.0")
    assert(near(sin(12345.6789), -0.7034419212632563, 1e-12) == 1, "sin 12345.6789")
    assert(near(sin(1e-9), 1e-09, 1e-12) == 1, "sin tiny")
    assert(near(sin(pi() / 6.0), 0.5, 1e-12) == 1, "sin pi/6")
    assert(near(sin(pi() / 2.0), 1.0, 1e-12) == 1, "sin pi/2")
    assert(near(sin(pi()), 0.0, 1e-15) == 1, "sin pi ~ 0")
    assert(near(sin(0.0 - pi() / 2.0), -1.0, 1e-12) == 1, "sin -pi/2")
    assert(near(sin(1000000.0), -0.34999350217129294, 1e-09) == 1, "sin 1e6")
    assert(cos(0.0) == 1.0, "cos 0 exact")
    assert(near(cos(1.0), 0.5403023058681398, 1e-12) == 1, "cos 1.0")
    assert(near(cos(100.0), 0.8623188722876839, 1e-12) == 1, "cos 100.0")
    assert(near(cos(1000.0), 0.5623790762907029, 1e-12) == 1, "cos 1000.0")
    assert(near(cos(-2.5), -0.8011436155469337, 1e-12) == 1, "cos -2.5")
    assert(near(cos(pi() / 3.0), 0.5, 1e-12) == 1, "cos pi/3")
    assert(near(cos(pi() / 2.0), 0.0, 1e-15) == 1, "cos pi/2 ~ 0")
    assert(near(cos(pi()), -1.0, 1e-12) == 1, "cos pi")
    assert(near(cos(pi() * 2.0), 1.0, 1e-12) == 1, "cos 2pi")
    assert(near(cos(1000000.0), 0.9367521275331447, 1e-09) == 1, "cos 1e6")
    assert(near(tan(1.0), 1.5574077246549023, 1e-12) == 1, "tan 1.0")
    assert(near(tan(0.5), 0.5463024898437905, 1e-12) == 1, "tan 0.5")
    assert(near(tan(-1.0), -1.5574077246549023, 1e-12) == 1, "tan -1.0")
    assert(near(tan(2.0), -2.185039863261519, 1e-12) == 1, "tan 2.0")
    assert(near(tan(pi() / 4.0), 1.0, 1e-12) == 1, "tan pi/4")
    assert(asin(0.0) == 0.0, "asin 0 exact")
    assert(near(asin(0.5), 0.5235987755982988, 1e-12) == 1, "asin 1/2")
    assert(near(asin(0.0 - 0.5), -0.5235987755982988, 1e-12) == 1, "asin -1/2")
    assert(near(asin(1.0), 1.5707963267948966, 1e-12) == 1, "asin 1")
    assert(near(asin(0.0 - 1.0), -1.5707963267948966, 1e-12) == 1, "asin -1")
    assert(near(asin(0.7071067811865476), 0.7853981633974484, 1e-12) == 1, "asin r2/2")
    assert(near(asin(0.9999999999), 1.5707821846586878, 1e-12) == 1, "asin near 1")
    assert(is_nan(asin(1.5)) == 1, "asin out of range")
    assert(acos(1.0) == 0.0, "acos 1 exact")
    assert(near(acos(0.5), 1.0471975511965976, 1e-12) == 1, "acos 1/2")
    assert(near(acos(0.0), 1.5707963267948966, 1e-12) == 1, "acos 0")
    assert(near(acos(0.0 - 1.0), 3.141592653589793, 1e-12) == 1, "acos -1")
    assert(is_nan(acos(2.0)) == 1, "acos out of range")
    assert(atan(0.0) == 0.0, "atan 0 exact")
    assert(near(atan(0.5), 0.4636476090008061, 1e-12) == 1, "atan 0.5")
    assert(near(atan(10.0), 1.4711276743037347, 1e-12) == 1, "atan 10.0")
    assert(near(atan(-0.5), -0.4636476090008061, 1e-12) == 1, "atan -0.5")
    assert(near(atan(-10.0), -1.4711276743037347, 1e-12) == 1, "atan -10.0")
    assert(near(atan(1.0), 0.7853981633974483, 1e-12) == 1, "atan 1")
    assert(near(atan(0.0 - 1.0), -0.7853981633974483, 1e-12) == 1, "atan -1")
    assert(near(atan(1e10), 1.5707963266948965, 1e-12) == 1, "atan 1e10")
    assert(near(atan(0.0 - 1e10), -1.5707963266948965, 1e-12) == 1, "atan -1e10")
    assert(atan2(0.0, 1.0) == 0.0, "atan2 0,1 exact")
    assert(near(atan2(1.0, 1.0), 0.7853981633974483, 1e-12) == 1, "atan2 1,1")
    assert(near(atan2(1.0, 0.0), 1.5707963267948966, 1e-12) == 1, "atan2 1,0")
    assert(near(atan2(0.0 - 1.0, 0.0), -1.5707963267948966, 1e-12) == 1, "atan2 -1,0")
    assert(near(atan2(1.0, 0.0 - 1.0), 2.356194490192345, 1e-12) == 1, "atan2 1,-1")
    assert(near(atan2(0.0 - 1.0, 0.0 - 1.0), -2.356194490192345, 1e-12) == 1, "atan2 -1,-1")
    assert(near(atan2(0.0 - 1.0, 1.0), -0.7853981633974483, 1e-12) == 1, "atan2 -1,1")
    assert(near(atan2(5.0, 5.0), 0.7853981633974483, 1e-12) == 1, "atan2 5,5")
    assert(near(atan2(3.0, 0.0 - 4.0), 2.498091544796509, 1e-12) == 1, "atan2 3,-4")
    assert(sinh(0.0) == 0.0, "sinh 0 exact")
    assert(cosh(0.0) == 1.0, "cosh 0 exact")
    assert(tanh(0.0) == 0.0, "tanh 0 exact")
    assert(near(sinh(1.0), 1.1752011936438014, 1e-12) == 1, "sinh 1.0")
    assert(near(cosh(1.0), 1.5430806348152437, 1e-12) == 1, "cosh 1.0")
    assert(near(tanh(1.0), 0.7615941559557649, 1e-12) == 1, "tanh 1.0")
    assert(near(sinh(-1.0), -1.1752011936438014, 1e-12) == 1, "sinh -1.0")
    assert(near(cosh(-1.0), 1.5430806348152437, 1e-12) == 1, "cosh -1.0")
    assert(near(tanh(-1.0), -0.7615941559557649, 1e-12) == 1, "tanh -1.0")
    assert(near(sinh(0.5), 0.5210953054937474, 1e-12) == 1, "sinh 0.5")
    assert(near(cosh(0.5), 1.1276259652063807, 1e-12) == 1, "cosh 0.5")
    assert(near(tanh(0.5), 0.46211715726000974, 1e-12) == 1, "tanh 0.5")
    assert(near(sinh(2.0), 3.6268604078470186, 1e-12) == 1, "sinh 2.0")
    assert(near(cosh(2.0), 3.7621956910836314, 1e-12) == 1, "cosh 2.0")
    assert(near(tanh(2.0), 0.9640275800758169, 1e-12) == 1, "tanh 2.0")
    assert(tanh(100.0) == 1.0, "tanh 100 saturate")
    assert(tanh(0.0 - 100.0) == -1.0, "tanh -100 saturate")
    assert(near(sinh(700.0), 5.0711602736750225e303, 1e-12) == 1, "sinh 700")
    assert(near(cosh(710.0), 1.1169973830808555e308, 1e-12) == 1, "cosh 710 no overflow")
    assert(near(sinh(0.0 - 700.0), -5.0711602736750225e303, 1e-12) == 1, "sinh -700")
    assert(near(hypot(3.0, 4.0), 5.0, 1e-12) == 1, "hypot 3-4-5")
    assert(hypot(0.0, 0.0) == 0.0, "hypot 0")
    assert(near(hypot(0.0 - 3.0, 4.0), 5.0, 1e-12) == 1, "hypot neg")
    assert(near(hypot(1e300, 1e300), 1.4142135623730952e300, 1e-12) == 1, "hypot huge")
    assert(near(to_radians(180.0), 3.141592653589793, 1e-12) == 1, "to_radians 180")
    assert(near(to_degrees(pi()), 180.0, 1e-12) == 1, "to_degrees pi")

    print("ok t90_mathfn")
}
