// t98_regex.qma：正则引擎差分对拍（v1.57）
// 期望值全部由 Python re 现算生成（search / fullmatch / sub / find 四语义）——
// 不手写任何期望值；语法错误用例（Python 直接抛异常的模式）走 -2 通道。
module t98

import std.regex

fn main() {
    assert(regex_match("abc", "xxabcyy") == 1, "search 'abc' on 'xxabcyy'")
    assert(regex_match("abc", "abd") == 0, "search 'abc' on 'abd'")
    assert(regex_match("a.c", "abc") == 1, "search 'a.c' on 'abc'")
    assert(regex_match("a.c", "a\x0ac") == 0, "search 'a.c' on 'a\nc'")
    assert(regex_match("[a-z]+", "ABC def GHI") == 1, "search '[a-z]+' on 'ABC def GHI'")
    assert(regex_match("[^0-9]+", "123abc456") == 1, "search '[^0-9]+' on '123abc456'")
    assert(regex_match("[0-9]{3}", "ab12") == 0, "search '[0-9]{3}' on 'ab12'")
    assert(regex_match("[0-9]{3}", "ab123") == 1, "search '[0-9]{3}' on 'ab123'")
    assert(regex_match("^abc", "abcdef") == 1, "search '^abc' on 'abcdef'")
    assert(regex_match("^abc", "xabc") == 0, "search '^abc' on 'xabc'")
    assert(regex_match("abc$", "xxabc") == 1, "search 'abc$' on 'xxabc'")
    assert(regex_match("abc$", "abcx") == 0, "search 'abc$' on 'abcx'")
    assert(regex_match("a|b", "cab") == 1, "search 'a|b' on 'cab'")
    assert(regex_match("a|b", "xyz") == 0, "search 'a|b' on 'xyz'")
    assert(regex_match("(ab)+", "ababab") == 1, "search '(ab)+' on 'ababab'")
    assert(regex_match("(ab)*c", "ababc") == 1, "search '(ab)*c' on 'ababc'")
    assert(regex_match("colou?r", "color") == 1, "search 'colou?r' on 'color'")
    assert(regex_match("colou?r", "colour") == 1, "search 'colou?r' on 'colour'")
    assert(regex_match("colou?r", "colouur") == 0, "search 'colou?r' on 'colouur'")
    assert(regex_match("\\d+", "abc42def") == 1, "search '\\d+' on 'abc42def'")
    assert(regex_match("\\w+", "  hello_1 ") == 1, "search '\\w+' on '  hello_1 '")
    assert(regex_match("\\s+", "a b") == 1, "search '\\s+' on 'a b'")
    assert(regex_match("\\D+", "123abc") == 1, "search '\\D+' on '123abc'")
    assert(regex_match("a{2,4}", "aaaaa") == 1, "search 'a{2,4}' on 'aaaaa'")
    assert(regex_match("a{2,4}", "a") == 0, "search 'a{2,4}' on 'a'")
    assert(regex_match("a{3,}", "aaaa") == 1, "search 'a{3,}' on 'aaaa'")
    assert(regex_match("a{3,}", "aa") == 0, "search 'a{3,}' on 'aa'")
    assert(regex_match("(foo|bar)baz", "xbarbazy") == 1, "search '(foo|bar)baz' on 'xbarbazy'")
    assert(regex_match("x(y|z)*w", "xw") == 1, "search 'x(y|z)*w' on 'xw'")
    assert(regex_match("x(y|z)*w", "xyzw") == 1, "search 'x(y|z)*w' on 'xyzw'")
    assert(regex_match("(a+)+b", "aaaab") == 1, "search '(a+)+b' on 'aaaab'")
    assert(regex_match("[.]", "a.b") == 1, "search '[.]' on 'a.b'")
    assert(regex_match("[*+]", "a*b") == 1, "search '[*+]' on 'a*b'")
    assert(regex_match("\\*\\+", "a*b+c") == 0, "search '\\*\\+' on 'a*b+c'")
    assert(regex_match("\\*\\+", "x*+y") == 1, "search '\\*\\+' on 'x*+y'")
    assert(regex_match("[a-]", "b-c") == 1, "search '[a-]' on 'b-c'")
    assert(regex_match("[]a]", "]") == 1, "search '[]a]' on ']'")
    assert(regex_match("[\\d]+", "x7") == 1, "search '[\\d]+' on 'x7'")
    assert(regex_match("(?:ab)+", "abab") == 1, "search '(?:ab)+' on 'abab'")
    assert(regex_match("$", "") == 1, "search '$' on ''")
    assert(regex_match("^$", "") == 1, "search '^$' on ''")
    assert(regex_match("^$", "a") == 0, "search '^$' on 'a'")
    assert(regex_match("b|", "xyz") == 1, "search 'b|' on 'xyz'")
    assert(regex_match("(a?)*b", "aaab") == 1, "search '(a?)*b' on 'aaab'")
    assert(regex_match("(a|)*", "aa") == 1, "search '(a|)*' on 'aa'")
    assert(regex_match("a{0}b", "b") == 1, "search 'a{0}b' on 'b'")
    assert(regex_match("a{0}b", "ab") == 1, "search 'a{0}b' on 'ab'")
    assert(regex_match_full("[a-z]+", "abc") == 1, "full '[a-z]+' on 'abc'")
    assert(regex_match_full("[a-z]+", "abc1") == 0, "full '[a-z]+' on 'abc1'")
    assert(regex_match_full("\\d{3}-\\d{4}", "010-1234") == 1, "full '\\d{3}-\\d{4}' on '010-1234'")
    assert(regex_match_full("\\d{3}-\\d{4}", "010-12345") == 0, "full '\\d{3}-\\d{4}' on '010-12345'")
    assert(regex_match_full("(ab|cd)*", "abcdab") == 1, "full '(ab|cd)*' on 'abcdab'")
    assert(regex_match_full("a?", "") == 1, "full 'a?' on ''")
    assert(regex_match_full("a*", "aaa") == 1, "full 'a*' on 'aaa'")
    assert(regex_match_full(".*", "anything") == 1, "full '.*' on 'anything'")
    assert(regex_match_full("x?", "y") == 0, "full 'x?' on 'y'")
    assert(regex_match_full("[\\w.]+", "a_b.c") == 1, "full '[\\w.]+' on 'a_b.c'")
    assert(regex_match_full("(a|b|c){2}", "ab") == 1, "full '(a|b|c){2}' on 'ab'")
    assert(regex_match_full("(a|b|c){2}", "abc") == 0, "full '(a|b|c){2}' on 'abc'")
    assert(regex_match_full("a{0,2}", "") == 1, "full 'a{0,2}' on ''")
    assert(regex_match_full("a{0,2}", "aaa") == 0, "full 'a{0,2}' on 'aaa'")
    assert(regex_match_full("(a?)*", "aaa") == 1, "full '(a?)*' on 'aaa'")
    assert(regex_match_full("(a|b)*", "abba") == 1, "full '(a|b)*' on 'abba'")
    assert(regex_replace_all(regex_compile("[0-9]+"), "a1b22c333", "#") == "a#b#c#", "sub '[0-9]+' on 'a1b22c333'")
    assert(regex_replace_all(regex_compile("\\s+"), "a  b   c", " ") == "a b c", "sub '\\s+' on 'a  b   c'")
    assert(regex_replace_all(regex_compile("ab"), "ababab", "X") == "XXX", "sub 'ab' on 'ababab'")
    assert(regex_replace_all(regex_compile("[a-c]"), "abcabc", "-") == "------", "sub '[a-c]' on 'abcabc'")
    assert(regex_replace_all(regex_compile("o"), "foo", "0") == "f00", "sub 'o' on 'foo'")
    assert(regex_replace_all(regex_compile("z"), "abc", "0") == "abc", "sub 'z' on 'abc'")
    assert(regex_replace_all(regex_compile("\\w+"), "hello world", "x") == "x x", "sub '\\w+' on 'hello world'")
    assert(regex_replace_all(regex_compile("[0-9]{2}"), "123456", "N") == "NNN", "sub '[0-9]{2}' on '123456'")
    assert(regex_replace_all(regex_compile("(ab)+"), "ababcab", "[&]") == "[&]c[&]", "sub '(ab)+' on 'ababcab'")
    assert(regex_replace_all(regex_compile("[aeiou]"), "hello world", "*") == "h*ll* w*rld", "sub '[aeiou]' on 'hello world'")
    assert(regex_find(regex_compile("[0-9]+"), "ab123cd") == 2, "find '[0-9]+' on 'ab123cd'")
    assert(regex_find(regex_compile("[0-9]+"), "abc") == -1, "find '[0-9]+' on 'abc'")
    assert(regex_find(regex_compile("b"), "aaa") == -1, "find 'b' on 'aaa'")
    assert(regex_find(regex_compile("^a"), "abc") == 0, "find '^a' on 'abc'")
    assert(regex_find(regex_compile("c$"), "abc") == 2, "find 'c$' on 'abc'")
    assert(regex_find(regex_compile("[a-z]+"), "123abc456") == 3, "find '[a-z]+' on '123abc456'")
    assert(regex_match("(", "") == -2, "bad '('")
    assert(regex_match("[", "") == -2, "bad '['")
    assert(regex_match("a)", "") == -2, "bad 'a)'")
    assert(regex_match("[a-", "") == -2, "bad '[a-'")
    assert(regex_match("(?:", "") == -2, "bad '(?:'")
    assert(regex_match("\\", "") == -2, "bad '\\'")
    assert(regex_match("a|*", "") == -2, "bad 'a|*'")
    assert(regex_match("(a", "") == -2, "bad '(a'")
    print("ok t98_regex")
}
