// t55_sync.qma：std/sync（v1.10）——atomic 内建 + 无锁同步库
// 覆盖：
//   1) atomic_add 并发计数（4 线程 x 10000 = 40000，无锁无竞争丢失）
//   2) atomic_cas 语义（成功写新 / 失败返回当前值）
//   3) mutex：非原子 load/add/store 在锁保护下不丢更新（mutex 的存在意义）
//   4) 无锁栈：2 线程并发 push 1000 个值，单消费者 pop 求和
//   5) WaitGroup：wg_add/done/wait 屏障
module t55

import std.sync

// 1) 纯 atomic 计数：不需要锁
fn bump(n: int) -> int {
    let p = static_word(3)
    let mut k = 0
    while k < n {
        atomic_add(p, 1)
        k = k + 1
    }
    return 0
}

// 3) mutex 临界区里的非原子读改写（没有锁就会丢更新）
fn locked_bump(m: int, ctr: int, n: int) -> int {
    let mut k = 0
    while k < n {
        mutex_lock(m)
        let v = mem_load64(ctr, 0)
        mem_store64(ctr, 0, v + 1)
        mutex_unlock(m)
        k = k + 1
    }
    return 0
}

// 4) 并发 push：线程 tid 推 tid*1000 + j（1..500 / 1001..1500）
fn pusher(s: int, tid: int) -> int {
    let mut j = 1
    while j <= 500 {
        stack_push(s, tid * 1000 + j)
        j = j + 1
    }
    return 0
}

// 5) wg worker
fn wg_worker(w: int) -> int {
    let mut k = 0
    while k < 100 {
        k = k + 1
    }
    wg_done(w)
    return 0
}

fn main() {
    // ---- 1) atomic_add 并发 ----
    let p = static_word(3)
    mem_store64(p, 0, 0)
    let b1 = spawn bump(10000)
    let b2 = spawn bump(10000)
    let b3 = spawn bump(10000)
    let b4 = spawn bump(10000)
    let j1 = join(b1)
    let j2 = join(b2)
    let j3 = join(b3)
    let j4 = join(b4)
    assert(mem_load64(p, 0) == 40000, "atomic concurrent counter")
    assert(j1 == 0 and j4 == 0, "bump joins")

    // ---- 2) atomic_cas 语义 ----
    mem_store64(p, 0, 50)
    let old = atomic_cas(p, 50, 99)
    assert(old == 50, "cas success returns old")
    assert(mem_load64(p, 0) == 99, "cas success wrote new")
    let old2 = atomic_cas(p, 50, 1)
    assert(old2 == 99, "cas fail returns current")
    assert(mem_load64(p, 0) == 99, "cas fail no write")

    // ---- 3) mutex 防丢更新 ----
    let m = mutex_new()
    let ctr = mem_alloc(8)
    mem_store64(ctr, 0, 0)
    let l1 = spawn locked_bump(m, ctr, 5000)
    let l2 = spawn locked_bump(m, ctr, 5000)
    let jl1 = join(l1)
    let jl2 = join(l2)
    assert(mem_load64(ctr, 0) == 10000, "mutex no lost update")

    // ---- 4) 无锁栈 ----
    let s = stack_new()
    let t1 = spawn pusher(s, 0)
    let t2 = spawn pusher(s, 1)
    let jt1 = join(t1)
    let jt2 = join(t2)
    let mut total = 0
    let mut cnt = 0
    let mut v = stack_pop(s)
    while v != 0 {
        total = total + v
        cnt = cnt + 1
        v = stack_pop(s)
    }
    assert(cnt == 1000, "stack pop count")
    assert(total == 750500, "stack sum")   // sum(1..500) + sum(1001..1500)

    // ---- 5) WaitGroup ----
    let w = wg_new()
    wg_add(w, 3)
    let w1 = spawn wg_worker(w)
    let w2 = spawn wg_worker(w)
    let w3 = spawn wg_worker(w)
    let jw1 = join(w1)
    let jw2 = join(w2)
    let jw3 = join(w3)
    wg_wait(w)
    assert(mem_load64(w, 0) == 0, "wg count zero")

    print("sync ok")
}
