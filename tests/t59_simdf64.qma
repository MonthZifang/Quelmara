    let bs = sum_big(big)
    assert(bs == 1024.0, "big sum")
    let mut best = 0 - 1
    let mut r = 0
    while r < 5 {
        let mut acc = 0.0
        let t0 = now_ns()
        let mut rep = 0
        while rep < 64 {
            acc += sum_big(big)
            rep = rep + 1
        }
        let t1 = now_ns()
        assert(acc == 65536.0, "perf acc")
        let ms = (t1 - t0) / 1000000
        if best < 0 || ms < best {
            best = ms
        }
        r = r + 1
    }
    print("simd f64 65536 elems: " + best.to_str() + " ms (min of 5)")
    print("ok t59_simdf64")
}
