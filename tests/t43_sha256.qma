// tests/t43_sha256.qma —— SHA-256 / HMAC-SHA256 标准向量自校验
// 向量来源：FIPS 180-4 附录 B、RFC 4231 §4（与 Python hashlib/hmac 逐位对齐）
module t43_sha256

import std.sha256

fn rep(unit: str, n: int) -> str {
    let mut s = ""
    let mut i = 0
    while i < n {
        s = s + unit
        i = i + 1
    }
    return s
}

fn main() {
    // --- FIPS 180-4 ---
    assert(sha256_hex("") ==
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty")
    assert(sha256_hex("abc") ==
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc")
    // 448 bit = 56 字节：刚好逼出第二个块（补位跨块边界）
    assert(sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") ==
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "sha256 448bit")
    // 56 字节 ASCII：走同一条跨块路径
    assert(sha256_hex("0123456789abcdef0123456789abcdef0123456789abcdef01234567") ==
        "67e4026bfbe6f1cd3f40518f324bcdf4426ae00faf5a0cddeae67a0e60ecf665", "sha256 56B")
    // 1000 字节：多块循环
    assert(sha256_hex(rep("a", 1000)) ==
        "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3", "sha256 1000B")

    // --- RFC 4231 HMAC-SHA256 ---
    // case 2
    assert(hmac_sha256_hex("Jefe", "what do ya want for nothing?") ==
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "hmac case2")
    // case 1：key = 20 × 0x0b
    assert(hmac_sha256_hex(rep(chr(11), 20), "Hi There") ==
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "hmac case1")
    // case 6：key = 131 × 0xaa（> 块长 64，先取摘要）
    assert(hmac_sha256_hex(rep(chr(170), 131),
        "Test Using Larger Than Block-Size Key - Hash Key First") ==
        "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "hmac case6")

    // 摘要缓冲区位宽 / 十六进制长度
    assert(len(sha256_hex("x")) == 64, "hex len")
    assert(len(hmac_sha256_hex("k", "m")) == 64, "hmac hex len")

    // 内容不同必须摘要不同（防"恒定输出"这类假实现）
    assert(sha256_hex("a") != sha256_hex("b"), "distinct")

    print("ok t43_sha256")
}
